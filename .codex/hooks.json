{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -File .codex/hooks/Write-SessionContext.ps1",
            "commandWindows": "pwsh -NoLogo -NoProfile -File .codex/hooks/Write-SessionContext.ps1",
            "timeout": 10,
            "statusMessage": "Loading CollisionSpike v2 repository context"
          }
        ]
      }
    ]
  }
}
