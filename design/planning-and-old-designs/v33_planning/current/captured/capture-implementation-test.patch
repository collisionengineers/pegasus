+            return;
+        }
+        Directory.CreateDirectory(directory);
+
+        // As the operator's screenshots: Glass's fetched, nothing applied, no presets.
+        {
+            var store = new RecordingCaseDetailsStore { EngineerValue = "9064.00" };
+            var valuation = new RecordingValuationSection(store.CaseId);
+            valuation.AddGuide(ValuationSource.Glasses, 9_064m, 7_347m);
