{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "table",
            "message": "Use <DataTable> from the design system instead of <table>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          },
          {
            "element": "select",
            "message": "Use <Select> from the design system instead of <select>."
          },
          {
            "element": "textarea",
            "message": "Use <Textarea> from the design system instead of <textarea>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/Button/**",
              "components/actions/ButtonRow/**",
              "components/actions/Gated/**",
              "components/actions/PrimaryAction/**",
              "components/actions/SecondaryAction/**",
              "components/actions/SendToClaudeButton/**",
              "components/auth/AuthCard/**",
              "components/auth/AuthCardActions/**",
              "components/auth/AuthShell/**",
              "components/auth/SupportReference/**",
              "components/data/ActionList/**",
              "components/data/DataTable/**",
              "components/data/FilterBar/**",
              "components/data/Pager/**",
              "components/data/PlainList/**",
              "components/data/TableWrap/**",
              "components/forms/Choice/**",
              "components/forms/ChoiceGroup/**",
              "components/forms/Field/**",
              "components/forms/FormGrid/**",
              "components/forms/FormPanel/**",
              "components/forms/Input/**",
              "components/forms/RoleForm/**",
              "components/forms/RowConfirm/**",
              "components/forms/Select/**",
              "components/forms/Textarea/**",
              "components/layout/DashboardGrid/**",
              "components/layout/Eyebrow/**",
              "components/layout/Icon/**",
              "components/layout/Lede/**",
              "components/layout/Panel/**",
              "components/layout/ReviewGrid/**",
              "components/layout/SectionLabel/**",
              "components/layout/SplitMain/**",
              "components/layout/SrOnly/**",
              "components/layout/WorkbenchGrid/**",
              "components/metrics/AdminCard/**",
              "components/metrics/AdminWorkspaces/**",
              "components/metrics/Metric/**",
              "components/metrics/MetricStrip/**",
              "components/metrics/MetricTile/**",
              "components/metrics/QueueCard/**",
              "components/metrics/QueueFilters/**",
              "components/metrics/QueueGrid/**",
              "components/metrics/QueueList/**",
              "components/metrics/QueueListRow/**",
              "components/metrics/TileGrid/**",
              "components/overlay/ReasonDialog/**",
              "components/record/Blockhead/**",
              "components/record/DataRow/**",
              "components/record/DetailList/**",
              "components/record/EvidenceFigure/**",
              "components/record/EvidenceList/**",
              "components/record/Facts/**",
              "components/record/FieldCard/**",
              "components/record/FieldGrid/**",
              "components/record/ProposalDiff/**",
              "components/record/Record/**",
              "components/record/RecordBar/**",
              "components/record/RecordBody/**",
              "components/record/RecordHead/**",
              "components/record/Subtabs/**",
              "components/record/Tabs/**",
              "components/shell/AppNav/**",
              "components/shell/AppShell/**",
              "components/shell/BackLink/**",
              "components/shell/Crumb/**",
              "components/shell/FreshnessBanner/**",
              "components/shell/PageHeading/**",
              "components/shell/Refresh/**",
