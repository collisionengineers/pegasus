        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AcceptanceBoundary'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|className|id|style|key|ref|className|style|children)$/]",
