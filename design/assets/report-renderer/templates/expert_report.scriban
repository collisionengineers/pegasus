{{ if title }}<h1 class="{{ title_class }}">{{ title }}</h1>{{ end }}
{{ if subtitle }}<p class="subtitle">{{ subtitle }}</p>{{ end }}
{{ if salutation }}<p class="salutation{{ if red_intro }} red{{ end }}">{{ salutation }}</p>{{ end }}
{{ if re_line }}<p class="re-line{{ if red_intro }} red{{ end }}">{{ re_line }}</p>{{ end }}
{{ for p in intro }}<p class="doc-p">{{ p }}</p>{{ end }}

{{ for section in sections }}
<section class="section">
  {{ if section.heading }}<h2 class="sec-h">{{ section.heading }}</h2>{{ end }}
  {{ for block in section.blocks }}
    {{ if block.type == "paragraph" }}
      <p class="doc-p">{{ block.text }}</p>
    {{ else if block.type == "bullets" }}
      <ul class="doc-ul">{{ for it in block.items }}<li>{{ it }}</li>{{ end }}</ul>
    {{ else if block.type == "datatable" }}
      <table class="data-table"><tbody>
      {{ for row in block.pairs }}<tr>{{ for c in row.cells }}<td class="k">{{ c.label }}</td><td class="v">{{ c.value }}</td>{{ end }}</tr>{{ end }}
      </tbody></table>
    {{ else if block.type == "keyvalue" }}
      <table class="kv-table"><tbody>
      {{ for row in block.pairs }}<tr>{{ for c in row.cells }}<th>{{ c.label }}</th><td>{{ c.value }}</td>{{ end }}</tr>{{ end }}
      </tbody></table>
    {{ else if block.type == "evidencetable" }}
      <table class="advert-table"><thead><tr>
      {{ for col in block.columns }}<th style="text-align:{{ col.align }}{{ if col.width }};width:{{ col.width }}{{ end }}">{{ col.header }}</th>{{ end }}
      </tr></thead><tbody>
      {{ for row in block.rows }}<tr>{{ for cell in row }}<td style="text-align:{{ block.columns[for.index].align }}">{{ cell }}</td>{{ end }}</tr>{{ end }}
      </tbody></table>
    {{ else if block.type == "valuebox" }}
      <table class="value-box"><tbody><tr><td>{{ block.label }}</td><td class="value">{{ block.value }}</td></tr></tbody></table>
    {{ else if block.type == "mediarow" }}
      <div class="media-row">
      {{ for mi in block.media }}
        <div class="media-col">
          {{ if mi.caption }}<h4>{{ mi.caption }}</h4>{{ end }}
          {{ if mi.image }}<img class="media-img" src="{{ mi.image }}" alt="{{ mi.caption }}">{{ else }}<div class="media-ph">Image slot{{ if mi.caption }} &mdash; {{ mi.caption }}{{ end }}</div>{{ end }}
          {{ if mi.note }}<p class="media-note">{{ mi.note }}</p>{{ end }}
        </div>
      {{ end }}
      </div>
    {{ end }}
  {{ end }}
</section>
{{ end }}

{{ if signature }}
<div class="sig-block">
  <p class="sig-closing">{{ signature.closing }}</p>
  {{ if signature.image }}<img class="sig-img" src="{{ signature.image }}" alt="Signature">{{ end }}
  {{ if signature.name }}<p class="sig-name">{{ signature.name }}</p>{{ end }}
  {{ if signature.role }}<p class="sig-role">{{ signature.role }}{{ if signature.qualifications }}, {{ signature.qualifications }}{{ end }}</p>{{ else if signature.qualifications }}<p class="sig-role">{{ signature.qualifications }}</p>{{ end }}
  {{ if signature.org }}<p class="sig-org">{{ signature.org }}</p>{{ end }}
  {{ if signature.aqp }}<p class="sig-role">AQP No. {{ signature.aqp }}</p>{{ end }}
</div>
{{ end }}
