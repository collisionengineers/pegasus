{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=uksouth}"
    },
    "sqlAdministratorObjectId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "sqlAdministratorLogin": {
      "value": "${AZURE_PRINCIPAL_NAME}"
    },
    "deploymentMode": {
      "value": "${PEGASUS_DEPLOYMENT_MODE}"
    },
    "alertEmailAddress": {
      "value": "${PEGASUS_ALERT_EMAIL}"
    },
    "graphMailboxId": {
      "value": "${GRAPH_MAILBOX_ID}"
    },
    "graphInboxFolderId": {
      "value": "${GRAPH_INBOX_FOLDER_ID}"
    },
    "graphSentFolderId": {
      "value": "${GRAPH_SENT_FOLDER_ID}"
    },
    "boxConfigJsonSecretUri": {
      "value": "${BOX_CONFIG_JSON_SECRET_URI}"
    },
    "boxClientSecretSecretUri": {
      "value": "${BOX_CLIENT_SECRET_SECRET_URI}"
    },
    "dvlaApiKeySecretUri": {
      "value": "${DVLA_API_KEY_SECRET_URI}"
    },
    "dvsaClientIdSecretUri": {
      "value": "${DVSA_CLIENT_ID_SECRET_URI}"
    },
    "dvsaClientSecretSecretUri": {
      "value": "${DVSA_CLIENT_SECRET_SECRET_URI}"
    },
    "dvsaApiKeySecretUri": {
      "value": "${DVSA_API_KEY_SECRET_URI}"
    },
    "dvsaTokenUri": {
      "value": "${DVSA_TOKEN_URI}"
    },
    "dvsaScope": {
      "value": "${DVSA_SCOPE}"
    }
  }
}
