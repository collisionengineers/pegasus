{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${PEGASUS_ENVIRONMENT_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=uksouth}"
    },
    "sqlAdministratorObjectId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "sqlAdministratorLogin": {
      "value": "${AZURE_PRINCIPAL_NAME}"
    },
    "deploymentMode": {
      "value": "${PEGASUS_DEPLOYMENT_MODE}"
    },
    "webActivation": {
      "value": "${PEGASUS_WEB_ACTIVATION=disabled}"
    },
    "workerActivation": {
      "value": "${PEGASUS_WORKER_ACTIVATION=disabled}"
    },
    "webImageDigest": {
      "value": "${PEGASUS_WEB_IMAGE_DIGEST=}"
    },
    "webRevisionSuffix": {
      "value": "${PEGASUS_WEB_REVISION_SUFFIX=}"
    },
    "alertEmailAddress": {
      "value": "${PEGASUS_ALERT_EMAIL}"
    },
    "graphMailboxId": {
      "value": "${GRAPH_MAILBOX_ID}"
    },
    "graphInboxFolderId": {
      "value": "${GRAPH_INBOX_FOLDER_ID}"
    },
    "graphSentFolderId": {
      "value": "${GRAPH_SENT_FOLDER_ID}"
    },
    "graphChangeNotificationClientStateSecretUri": {
      "value": "${GRAPH_CHANGE_NOTIFICATION_CLIENT_STATE_SECRET_URI}"
    },
    "boxConfigJsonSecretUri": {
      "value": "${BOX_CONFIG_JSON_SECRET_URI}"
    },
    "boxClientSecretSecretUri": {
      "value": "${BOX_CLIENT_SECRET_SECRET_URI}"
    },
    "boxHoldingFolderId": {
      "value": "${BOX_HOLDING_FOLDER_ID}"
    },
    "automationMcpClientSecretUri": {
      "value": "${AUTOMATION_MCP_CLIENT_SECRET_URI}"
    },
    "automationMcpSigningCertificateSecretUris": {
      "value": "${AUTOMATION_MCP_SIGNING_CERTIFICATE_SECRET_URIS}"
    },
    "automationMcpEncryptionCertificateSecretUris": {
      "value": "${AUTOMATION_MCP_ENCRYPTION_CERTIFICATE_SECRET_URIS}"
    },
    "automationMcpRedirectUris": {
      "value": "${AUTOMATION_MCP_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback}"
    },
    "dvlaApiKeySecretUri": {
      "value": "${DVLA_API_KEY_SECRET_URI}"
    },
    "dvsaClientIdSecretUri": {
      "value": "${DVSA_CLIENT_ID_SECRET_URI}"
    },
    "dvsaClientSecretSecretUri": {
      "value": "${DVSA_CLIENT_SECRET_SECRET_URI}"
    },
    "evaClientIdSecretUri": {
      "value": "${EVA_CLIENT_ID_SECRET_URI}"
    },
    "evaClientSecretSecretUri": {
      "value": "${EVA_CLIENT_SECRET_SECRET_URI}"
    },
    "evaBaseUri": {
      "value": "${EVA_BASE_URI=https://sentry.evasoftware.co.uk/api/}"
    },
    "evaRequestFrom": {
      "value": "${EVA_REQUEST_FROM}"
    },
    "evaInspectionType": {
      "value": "${EVA_INSPECTION_TYPE=Vehicle Damage Inspection}"
    },
    "evaInstructionEmail": {
      "value": "${EVA_INSTRUCTION_EMAIL}"
    },
    "dvsaApiKeySecretUri": {
      "value": "${DVSA_API_KEY_SECRET_URI}"
    },
    "dvsaTokenUri": {
      "value": "${DVSA_TOKEN_URI}"
    },
    "dvsaScope": {
      "value": "${DVSA_SCOPE}"
    }
  }
}
