<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-only microbenchmarks (R397): run by hand, never by CI. The project is
       outside Pegasus.slnx and nothing references it, so no workflow builds it.
       See Program.cs for the command. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pegasus.Core\Pegasus.Core.csproj" />
  </ItemGroup>

</Project>
