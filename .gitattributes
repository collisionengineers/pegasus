.design-sync/*.md text eol=lf
docs/design/system/src/**/*.ts text eol=lf
docs/design/system/src/**/*.tsx text eol=lf
docs/design/system/docs/*.md text eol=lf
*.doc binary
*.docx binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.woff binary
*.woff2 binary
*.xls binary
*.xlsx binary
*.zip binary
*.onnx binary
src/Pegasus.Infrastructure/Vision/Models/*.yaml binary
