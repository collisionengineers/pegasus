<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Pegasus.Core\Pegasus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
    <PackageReference Include="Box.Sdk.Gen" Version="1.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Graph" Version="6.2.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="Scriban" Version="7.2.6" />
    <PackageReference Include="Microsoft.Playwright" Version="$(PlaywrightVersion)" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\ReferenceData\provider-domains.v1.json"
                      LogicalName="Pegasus.Infrastructure.Persistence.ReferenceData.provider-domains.v1.json" />
    <EmbeddedResource Include="Vision\Models\yolo-v9-t-384-license-plates-end2end.onnx"
                      LogicalName="Pegasus.Infrastructure.Vision.Models.yolo-v9-t-384-license-plates-end2end.onnx" />
    <EmbeddedResource Include="Vision\Models\cct_s_v2_global.onnx"
                      LogicalName="Pegasus.Infrastructure.Vision.Models.cct_s_v2_global.onnx" />
    <EmbeddedResource Include="Vision\Models\cct_s_v2_global_plate_config.yaml"
                      LogicalName="Pegasus.Infrastructure.Vision.Models.cct_s_v2_global_plate_config.yaml" />
    <EmbeddedResource Include="Vision\Models\vision-models-manifest.json"
                      LogicalName="Pegasus.Infrastructure.Vision.Models.vision-models-manifest.json" />
    <EmbeddedResource Include="..\..\docs\design\assets\report-renderer\templates\assessment_report.scriban"
                      LogicalName="Pegasus.Infrastructure.Reports.Assets.templates.assessment_report.scriban" />
    <EmbeddedResource Include="..\..\docs\design\assets\report-renderer\templates\assessment_fee_note.scriban"
                      LogicalName="Pegasus.Infrastructure.Reports.Assets.templates.assessment_fee_note.scriban" />
    <EmbeddedResource Include="..\..\docs\design\assets\report-renderer\templates\report.css"
                      LogicalName="Pegasus.Infrastructure.Reports.Assets.templates.report.css" />
    <EmbeddedResource Include="..\..\docs\design\brand\logos\logo_no_margin.png">
      <Link>Reports\Assets\brand\logo.png</Link>
      <LogicalName>Pegasus.Infrastructure.Reports.Assets.brand.logo.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\design\brand\signatures\andy_patterson.png"
                      LogicalName="Pegasus.Infrastructure.Reports.Assets.brand.signatures.andy_patterson.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pegasus.IntegrationTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
