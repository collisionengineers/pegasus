<div class="flex flex-col w-2/5 h-auto gap-2 p-2 relative">
  {{#vehicleImage}}
  <img
    src="{{vehicleImage}}"
    alt="logo"
    class="rounded w-full h-auto object-cover border-2 border-gray-300 border-transparent aspect-video"
  />
  {{/vehicleImage}} {{^vehicleImage}}
  <div
    class="w-full rounded border-2 border-gray-300 flex items-item justify-center {{placeholderBgClass}} border-transparent aspect-video"
  >
    <img src="{{placeholderLogo}}" alt="logo" class="w-1/3" />
  </div>
  {{/vehicleImage}}
  <div class="flex flex-row items-center justify-between p-2">
    <div class="flex flex-row items-center gap-4">
      <i class="fas fa-tachometer has-text-light"></i>
      <p class="">Mileage</p>
    </div>
    <div class="value">
      <p class="">{{mileage}}</p>
    </div>
  </div>
  <div class="flex flex-row items-center justify-between p-2 bg-slate-100">
    <div class="flex flex-row items-center gap-4">
      <i class="fas fa-calendar-alt has-text-light"></i>
      <p class="">Valuation date</p>
    </div>
    <div class="value">
      <p class="">{{valuationDate}}</p>
    </div>
  </div>
  <div class="flex flex-row items-center justify-between p-2">
    <div class="flex flex-row items-center gap-4">
      <i class="fas fa-star has-text-light"></i>
      <p class="">Condition</p>
    </div>
    <div class="value">
      <p class="">{{condition}}</p>
    </div>
  </div>
</div>

<style>
  .bg-tertiary {
    background-color: #211527;
  }
</style>
