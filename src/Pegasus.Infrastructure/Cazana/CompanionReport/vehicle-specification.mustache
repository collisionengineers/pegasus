<div class="break-inside-avoid">
  <h3 class="font-semibold text-slate-600 my-4 border-b-2 pb-2">
    Vehicle Specification
  </h3>
  <div class="flex flex-col gap-4 text-gray-700">
    <div class="flex flex-row justify-between">
      <p>Type</p>
      <p>{{type}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Manufacturer</p>
      <p>{{manufacturer}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Model</p>
      <p>{{model}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Trim</p>
      <p>{{trim}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Manufacture Year</p>
      <p>{{year}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>First Registration</p>
      <p>{{firstRegistration}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Body Style</p>
      <p>{{bodyType}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Transmission</p>
      <p>{{transmission}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Trim</p>
      <p>{{trim}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Doors</p>
      <p>{{doors}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Fuel Type</p>
      <p>{{fuelType}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Engine Compasity</p>
      <p>{{engineSize}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Valves</p>
      <p>{{valves}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Cylinders</p>
      <p>{{cylinders}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Gears</p>
      <p>{{gears}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Engine Number</p>
      <p>{{engineNumber}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Power Output</p>
      <p>{{powerOutputBhp}}bhp, {{powerOutputKw}}kw</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Colour</p>
      <p>{{currentColour}}</p>
    </div>
    <div class="flex flex-row justify-between">
      <p>Vehicle Seats</p>
      <p>{{vehicleSeats}}</p>
    </div>
  </div>
</div>
