<section class="w-full my-12">
  <h2 class="text-xl font-semibold text-slate-700">Market Overview</h2>
  <div class="w-full h-auto flex flex-row justify-between flex-wrap my-4">
    <div class="flex flex-col gap-2 w-4/5">
      <p class="font-bold text-gray-700">Applied filters:</p>
      <div class="flex flex-row gap-2 flex-wrap">
        {{#similarListingFilters}} {{#listingTypes.length}}
        <button
          class="text-base font-semibold text-dark border-2 border-dark rounded-lg px-3 py-1 inline-flex items-center w-fit"
        >
          <span>Listing type :</span>
          <span class="ml-2 font-normal">{{listingTypes}}</span>
        </button>
        {{/listingTypes.length}} {{#sellerTypes.length}}
        <button
          class="text-base font-semibold text-dark border-2 border-dark rounded-lg px-3 py-1 inline-flex items-center w-fit"
        >
          <span>Seller type :</span>
          <span class="ml-2 font-normal">{{sellerTypes}}</span>
        </button>
        {{/sellerTypes.length}} {{#registrations.length}}
        <button
          class="text-base font-semibold text-dark border-2 border-dark rounded-lg px-3 py-1 inline-flex items-center w-fit"
        >
          <span>Registration :</span>
          <span class="ml-2 font-normal">{{registrations}}</span>
        </button>
        {{/registrations.length}} {{#mileages.length}}
        <button
          class="text-base font-semibold text-dark border-2 border-dark rounded-lg px-3 py-1 inline-flex items-center w-fit"
        >
          <span>Mileage :</span>
          <span class="ml-2 font-normal">{{mileages}}</span>
        </button>
        {{/mileages.length}} {{#colours.length}}
        <button
          class="text-base font-semibold text-dark border-2 border-dark rounded-lg px-3 py-1 inline-flex items-center w-fit"
        >
          <span>Colour :</span>
          <span class="ml-2 font-normal">{{colours}}</span>
        </button>
        {{/colours.length}} {{#distance.length}}
        <button
          class="text-base font-semibold text-dark border-2 border-dark rounded-lg px-3 py-1 inline-flex items-center w-fit"
        >
          <span>Distance :</span>
          <span class="ml-2 font-normal">{{distance}}</span>
        </button>
        {{/distance.length}} {{#options.length}}
        <button
          class="text-base font-semibold text-dark border-2 border-dark rounded-lg px-3 py-1 inline-flex items-center w-fit"
        >
          <span>Options :</span>
          <span class="ml-2 font-normal">{{options}}</span>
        </button>
        {{/options.length}} {{/similarListingFilters}}
      </div>
    </div>
    <div class="flex flex-col gap-2 w-1/5 flex-wrap">
      <p class="font-bold text-gray-700">Sorted by:</p>
      <button
        class="text-base font-semibold text-dark border-2 border-dark rounded-lg inline-block py-1 px-3 w-fit"
      >
        {{sortBy}}
      </button>
    </div>
  </div>
  {{#totalSimilarListings}}
  <p>
    {{listings.length}} of {{totalSimilarListings}} vehicles currently in the
    market
  </p>
  {{/totalSimilarListings}}
  <div
    class="w-full bg-white rounded-md border border-slate-200 overflow-hidden mt-4"
  >
    <table class="w-full">
      <thead>
        <tr>
          <th class="text-left p-4 text-slate-700 font-semibold">VRM</th>
          <th class="text-left p-4 text-slate-700 font-semibold">Year</th>
          <th class="text-left p-4 text-slate-700 font-semibold">Colour</th>
          {{#additionalColumns}}
          <th class="text-left p-4 text-slate-700 font-semibold">
            Transmission
          </th>
          <th class="text-left p-4 text-slate-700 font-semibold">Fuel Type</th>
          {{/additionalColumns}}
          <th class="text-left p-4 text-slate-700 font-semibold">Mileage</th>
          <th class="text-left p-4 text-slate-700 font-semibold">
            Seller Type
          </th>
          <th class="text-left p-4 text-slate-700 font-semibold">Price</th>
        </tr>
      </thead>
      <tbody class="font-medium text-xs">
        {{#listings}}
        <tr class="text-slate-700 odd:bg-slate-50">
          <td class="text-left px-4 py-2">
            <p
              style="
                color: {{primaryColor}};
                background-color: {{secondaryColor}};
                border: none;
                border-radius: 50px;
              "
              class="py-2 text-center w-24 font-bold rounded"
            >
              {{listingVrm}}
            </p>
          </td>
          <td class="text-left px-4 py-2">{{listingYear}}</td>
          <td class="text-left px-4 py-2">{{listingColour}}</td>
          {{#additionalColumns}}
          <td class="text-left px-4 py-2">{{listingTransmission}}</td>
          <td class="text-left px-4 py-2">{{listingFuelType}}</td>
          {{/additionalColumns}}
          <td class="text-left px-4 py-2">{{listingMileage}}</td>
          <td class="text-left px-4 py-2">{{listingSeller}}</td>
          <td class="text-left px-4 py-2 font-bold" style="color: {{priceColor}}">
            {{listingPrice}}
          </td>
        </tr>
        {{/listings}}
      </tbody>
    </table>
  </div>
</section>
