{{#containsSalesEvents}}
<section class="break-before-page">
  <h2 class="text-xl font-semibold text-slate-700 mb-4">
    Vehicle advert full details
  </h2>
  {{#carHistory}} {{#saleListings}} {{#advertisementImage}}
  <div class="break-inside-avoid mb-4 border-2 p-4 rounded text-gray-700">
    <p class="mb-2 text-sm">{{advertisementDate}}</p>
    <p class="mb-2 font-bold mb-4 text-lg">listed for sale</p>
    <div class="flex flex-row mb-4 gap-2 border-b-2 pb-4">
      <div class="w-1/3">
        <img
          src="{{advertisementImage}}"
          alt="logo"
          class="rounded w-full object-contain"
        />
      </div>
      <div class="flex flex-col gap-4 text-gray-700 w-2/3">
        <div class="flex flex-row justify-between">
          <p>Listing price</p>
          <p>£{{advertisementPrice}}</p>
        </div>
        <div class="flex flex-row justify-between">
          <p>Listed mileage</p>
          <p>{{advertisementMileage}}</p>
        </div>
      </div>
    </div>
    <div>
      <p class="font-bold mb-4 text-lg">Advert text</p>
      <p class="text-sm">{{advertisementAdText}}</p>
    </div>
  </div>
  {{/advertisementImage}} {{^advertisementImage}}
  <div class="break-inside-avoid mb-4 border-2 p-4 rounded text-gray-700">
    <p class="mb-2 text-sm">{{advertisementDate}}</p>
    <p class="mb-2 font-bold mb-4 text-lg">listed for sale</p>
    <div class="flex flex-row mb-4 gap-2 border-b-2 pb-4">
      <div class="flex flex-col gap-4 text-gray-700 w-full">
        <div class="flex flex-row justify-between">
          <p>Listing price</p>
          <p>£{{advertisementPrice}}</p>
        </div>
        <div class="flex flex-row justify-between">
          <p>Listed mileage</p>
          <p>{{advertisementMileage}}</p>
        </div>
      </div>
    </div>
    <div>
      <p class="font-bold mb-4 text-lg">Advert text</p>
      <p class="text-sm">{{advertisementAdText}}</p>
    </div>
  </div>
  {{/advertisementImage}} {{/saleListings}} {{/carHistory}}
</section>
{{/containsSalesEvents}}
