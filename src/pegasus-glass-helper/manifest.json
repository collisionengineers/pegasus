{
  "manifest_version": 3,
  "name": "Glass's Repair Estimate start-up fix",
  "version": "1.0.0",
  "description": "Removes the intermittent \"ERROR dialog not found\" when Glass's Repair Estimate starts, by making its framing page's dialog helper exist before the editor frame asks for it.",
  "host_permissions": [
    "https://pegasus-prod-web-252ow37gij.azurewebsites.net/*",
    "https://cemattypc-1.tail432b53.ts.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://repairestimate.autovistagroup.com/ere/aco/acofr.php*"],
      "js": ["patch-dialog.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://repairestimate.autovistagroup.com/ere/aco/acofr.php*"],
      "js": ["helper.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
