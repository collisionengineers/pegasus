{
  "Runtime": {
    "Profile": "DevelopmentOffline"
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionStringName": "Pegasus"
  },
  "ConnectionStrings": {
    "Pegasus": "Server=(localdb)\\MSSQLLocalDB;Database=PegasusDevelopment;Integrated Security=True;Encrypt=False;MultipleActiveResultSets=True"
  },
  "Intake": {
    "LocalArtifactPath": "../../artifacts/local-development/default/intake"
  },
  "Features": {
    "LocalIntake": true
  },
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
