@page
@using Pegasus.Core.Operations
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Operations.RequestsModel
@{
    ViewData["Title"] = "Upload links";

    // Box file requests are superseded, so they are absent rather than shown
    // in a state nobody acts on. Historical Box records remain in the case's
    // own history; this operations view is about work in flight.
    var uploadLinks = Model.Operations.Items
        .Where(item => item.Kind == RequestOperationKind.PegasusUploadLink)
        .ToArray();
    var externalWork = Model.Operations.Items
        .Where(item => item.Kind == RequestOperationKind.ExternalWork)
        .ToArray();
}

<header class="page-heading">
    <h1>Upload links</h1>
    <a class="secondary-action" asp-page="/Index">Back to Dashboard</a>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="status-card" role="status">@Model.StatusMessage</div>
}

<section aria-labelledby="upload-links-title">
    <h2 id="upload-links-title" class="section-label">Upload links</h2>
    @if (uploadLinks.Length == 0)
    {
        <p class="empty-state">No upload links have been issued.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Case</th>
                        <th scope="col">Principal</th>
                        <th scope="col">Status</th>
                        <th scope="col">Used</th>
                        <th scope="col">Expires</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in uploadLinks)
                {
                    <tr>
                        <td><a asp-page="/Cases/Details" asp-route-id="@item.CaseId">@item.CaseReference</a></td>
                        <td>@item.PrincipalCode</td>
                        <td><partial name="Shared/_StatusChip" model="@RequestsModel.StateLabel(item.State)" /></td>
                        <td>
                            @* Sizes in MB, never bytes, and the internal limits
                               version integer does not render at all. *@
                            @if (item.MaximumByteCount is { } maximumBytes)
                            {
                                <span>@OperatorLabels.FileSize(item.AcceptedByteCount ?? 0) of @OperatorLabels.FileSize(maximumBytes)</span>
                            }
                            @if (item.MaximumFileCount is { } maximumFiles)
                            {
                                <span> · @item.AcceptedFileCount of @maximumFiles files</span>
                            }
                            @if (item.MaximumByteCount is null && item.MaximumFileCount is null)
                            {
                                <span class="empty-state">—</span>
                            }
                        </td>
                        <td>
                            @if (item.ExpiresAtUtc is { } expiresAtUtc)
                            {
                                <time datetime="@expiresAtUtc.ToString("O")">@expiresAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</time>
                            }
                            else
                            {
                                <span class="empty-state">—</span>
                            }
                        </td>
                        <td>
                            @if (item.CanRevoke)
                            {
                                @* One post does the whole operation. Whether
                                   someone else is editing the case is the
                                   result of trying, not a state the operator
                                   is asked to manage. *@
                                <details>
                                    <summary class="btn">Withdraw link</summary>
                                    <form method="post" asp-page-handler="RevokeLink" class="row-confirm">
                                        <input type="hidden" name="requestId" value="@item.Id" />
                                        <input type="hidden" name="caseId" value="@item.CaseId" />
                                        <input type="hidden" name="expectedVersion" value="@item.Version" />
                                        <input type="hidden" name="expectedCaseVersion" value="@item.CaseVersion" />
                                        <input type="hidden" name="operationKey" value="@RequestsModel.NewOperationKey()" />
                                        <label for="withdraw-reason-@item.Id">Reason</label>
                                        <input id="withdraw-reason-@item.Id" name="reason" maxlength="500" required
                                               value="@(Model.PreservedRequestId == item.Id ? Model.PreservedReason : null)" />
                                        <button class="btn btn--dark" type="submit">Withdraw link</button>
                                    </form>
                                </details>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="section-gap" aria-labelledby="external-work-title">
    <h2 id="external-work-title" class="section-label">External work</h2>
    @if (externalWork.Length == 0)
    {
        <p class="empty-state">No external work is recorded.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Case</th>
                        <th scope="col">Work</th>
                        <th scope="col">Status</th>
                        <th scope="col">Attempts</th>
                        <th scope="col">Last activity</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in externalWork)
                {
                    <tr>
                        <td><a asp-page="/Cases/Details" asp-route-id="@item.CaseId">@item.CaseReference</a></td>
                        <td>@OperatorLabels.Humanise(item.ExternalKind)</td>
                        <td>
                            <partial name="Shared/_StatusChip" model="@RequestsModel.StateLabel(item.State)" />
                            @if (!string.IsNullOrWhiteSpace(item.FailureReason))
                            {
                                @* The recorded human reason, never the failure
                                   code token. *@
                                <small class="empty-state">@item.FailureReason</small>
                            }
                        </td>
                        <td class="tabular">@item.AttemptCount</td>
                        <td><time datetime="@item.LastActivityAtUtc.ToString("O")">@item.LastActivityAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</time></td>
                        <td>
                            @if (item.CanRetry)
                            {
                                <details>
                                    <summary class="btn">Retry</summary>
                                    <form method="post" asp-page-handler="RetryExternal" class="row-confirm">
                                        <input type="hidden" name="workItemId" value="@item.Id" />
                                        <input type="hidden" name="expectedAttemptCount" value="@item.AttemptCount" />
                                        <input type="hidden" name="operationKey" value="@RequestsModel.NewOperationKey()" />
                                        <button class="btn btn--dark" type="submit">Retry this work</button>
                                    </form>
                                </details>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.Operations.LimitReached)
{
    <p class="empty-state section-gap">Showing the latest @GetRequestOperations.MaximumItems items.</p>
}
