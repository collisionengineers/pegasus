@page
@using Pegasus.Core.Operations
@model Pegasus.Web.Pages.Operations.EmailModel
@{
    ViewData["Title"] = "Email operations";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Operations</p>
        <h1>Email</h1>
        <p class="lede">Bounded approved-mailbox Received and Sent processing outcomes.</p>
    </div>
    <a class="secondary-action" asp-page="/Index">Back to Operations</a>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="status-card" role="status">@Model.StatusMessage</div>
}

<section aria-labelledby="received-title">
    <h2 id="received-title" class="section-label">Received</h2>
    @if (Model.Operations.Received.IsEmpty)
    {
        <div class="panel empty-state">No Received processing outcomes are recorded.</div>
    }
    else
    {
        @foreach (var item in Model.Operations.Received)
        {
            <article class="panel section-gap">
                <h3>Received · @EmailModel.StateLabel(item.State)</h3>
                <dl class="detail-list">
                    <div>
                        <dt>Mailbox</dt>
                        <dd>@(item.MailboxIdentity ?? "Not recorded")</dd>
                    </div>
                    <div>
                        <dt>Last activity</dt>
                        <dd><time datetime="@item.LastActivityAtUtc.ToString("O")">@item.LastActivityAtUtc.ToString("u")</time></dd>
                    </div>
                    <div>
                        <dt>Owner</dt>
                        <dd>
                            @if (item.IntakeId is { } intakeId)
                            {
                                <a asp-page="/Intake/Details" asp-route-id="@intakeId">Open Intake receipt</a>
                            }
                            else if (item.TriageId is { } triageId)
                            {
                                <a asp-page="/Triage/Details" asp-route-id="@triageId">Open Triage</a>
                            }
                            else if (item.CaseId is { } caseId)
                            {
                                <a asp-page="/Cases/Details" asp-route-id="@caseId">Open Case @(item.CaseReference ?? string.Empty)</a>
                            }
                            else
                            {
                                <a asp-page="/Intake/Index">Open Intake queue</a>
                            }
                        </dd>
                    </div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(item.FailureCode))
                {
                    <div class="failure-detail">
                        <strong>Failure</strong>
                        <span>@item.FailureCode</span>
                    </div>
                }
                @if (item.CanRetry)
                {
                    <form method="post" asp-page-handler="Retry" class="section-gap">
                        <input type="hidden" name="mailboxId" value="@item.RetryMailboxId" />
                        <input type="hidden" name="direction" value="@item.Direction" />
                        <input type="hidden" name="expectedFailureCode" value="@item.FailureCode" />
                        <input type="hidden" name="expectedDueAtUtc" value="@item.RetryExpectedDueAtUtc!.Value.ToString("O")" />
                        <input type="hidden" name="operationKey" value="@EmailModel.NewOperationKey()" />
                        <button class="secondary-action" type="submit">Retry Received processing</button>
                    </form>
                }
            </article>
        }
    }
    @if (Model.Operations.ReceivedLimitReached)
    {
        <p class="notice">Showing the latest @GetEmailOperations.MaximumItemsPerDirection Received outcomes.</p>
    }
</section>

<section class="section-gap" aria-labelledby="sent-title">
    <h2 id="sent-title" class="section-label">Sent</h2>
    @if (Model.Operations.Sent.IsEmpty)
    {
        <div class="panel empty-state">No Sent processing outcomes are recorded.</div>
    }
    else
    {
        @foreach (var item in Model.Operations.Sent)
        {
            <article class="panel section-gap">
                <h3>Sent · @EmailModel.StateLabel(item.State)</h3>
                <dl class="detail-list">
                    <div>
                        <dt>Mailbox</dt>
                        <dd>@(item.MailboxIdentity ?? "Not recorded")</dd>
                    </div>
                    <div>
                        <dt>Last activity</dt>
                        <dd><time datetime="@item.LastActivityAtUtc.ToString("O")">@item.LastActivityAtUtc.ToString("u")</time></dd>
                    </div>
                    <div>
                        <dt>Owner</dt>
                        <dd>
                            @if (item.TriageId is { } triageId)
                            {
                                <a asp-page="/Triage/Details" asp-route-id="@triageId">Open Triage</a>
                            }
                            else if (item.CaseId is { } caseId)
                            {
                                <a asp-page="/Cases/Details" asp-route-id="@caseId">Open Case @(item.CaseReference ?? string.Empty)</a>
                            }
                            else
                            {
                                <span>Not linked</span>
                            }
                        </dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.PrincipalCode))
                    {
                        <div>
                            <dt>Principal</dt>
                            <dd>@item.PrincipalCode</dd>
                        </div>
                    }
                </dl>
                @if (!string.IsNullOrWhiteSpace(item.FailureCode))
                {
                    <div class="failure-detail">
                        <strong>Failure</strong>
                        <span>@item.FailureCode</span>
                    </div>
                }
                @if (item.CanRetry)
                {
                    <form method="post" asp-page-handler="Retry" class="section-gap">
                        <input type="hidden" name="mailboxId" value="@item.RetryMailboxId" />
                        <input type="hidden" name="direction" value="@item.Direction" />
                        <input type="hidden" name="expectedFailureCode" value="@item.FailureCode" />
                        <input type="hidden" name="expectedDueAtUtc" value="@item.RetryExpectedDueAtUtc!.Value.ToString("O")" />
                        <input type="hidden" name="operationKey" value="@EmailModel.NewOperationKey()" />
                        <button class="secondary-action" type="submit">Retry Sent processing</button>
                    </form>
                }
            </article>
        }
    }
    @if (Model.Operations.SentLimitReached)
    {
        <p class="notice">Showing the latest @GetEmailOperations.MaximumItemsPerDirection Sent outcomes.</p>
    }
</section>
