@page "/Operations"
@using Pegasus.Core.Operations
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Operations.IndexModel
@{
    ViewData["Title"] = "Operations";
    var uploadLinks = Model.Operations.Items
        .Where(item => item.Kind == RequestOperationKind.PegasusUploadLink)
        .ToArray();
    var externalWork = Model.Operations.Items
        .Where(item => item.Kind == RequestOperationKind.ExternalWork && item.CanRetry)
        .ToArray();
}

<header class="page-heading">
    <h1>Operations</h1>
    <a class="secondary-action" asp-page="/Index">Back to Dashboard</a>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="status-card" role="status">@Model.StatusMessage</div>
}

<section aria-labelledby="attention-title">
    <h2 id="attention-title" class="section-label">Attention required</h2>
    @if (externalWork.Length == 0)
    {
        <p class="empty-state">No retryable external work is waiting for attention.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <caption class="sr-only">Retryable external work</caption>
                <thead><tr><th scope="col">Case</th><th scope="col">Work</th><th scope="col">Attempts</th><th scope="col">Failure</th><th scope="col">Action</th></tr></thead>
                <tbody>
                @foreach (var item in externalWork)
                {
                    <tr>
                        <td><a asp-page="/Cases/Details" asp-route-id="@item.CaseId">@item.CaseReference</a></td>
                        <td>@OperatorLabels.Humanise(item.ExternalKind)</td>
                        <td class="tabular">@item.AttemptCount</td>
                        <td>@item.FailureReason</td>
                        <td>
                            <form method="post" asp-page-handler="RetryExternal">
                                <input type="hidden" name="workItemId" value="@item.Id" />
                                <input type="hidden" name="expectedAttemptCount" value="@item.AttemptCount" />
                                <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                <button class="btn btn--dark" type="submit">Retry this work</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="section-gap" aria-labelledby="upload-links-title">
    <h2 id="upload-links-title" class="section-label">Active upload links</h2>
    @if (uploadLinks.Length == 0)
    {
        <p class="empty-state">No active upload links are currently available.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <caption class="sr-only">Active Pegasus upload links</caption>
                <thead><tr><th scope="col">Case</th><th scope="col">Last activity</th><th scope="col">Accepted</th><th scope="col">Expires</th><th scope="col">Action</th></tr></thead>
                <tbody>
                @foreach (var item in uploadLinks)
                {
                    <tr>
                        <td><a asp-page="/Cases/Details" asp-route-id="@item.CaseId">@item.CaseReference</a></td>
                        <td><time datetime="@item.LastActivityAtUtc.ToString("O")">@OperatorLabels.OfficeTime(item.LastActivityAtUtc)</time></td>
                        <td>
                            @if (item.MaximumByteCount is { } maximumBytes)
                            {
                                <span>@OperatorLabels.FileSize(item.AcceptedByteCount ?? 0) of @OperatorLabels.FileSize(maximumBytes)</span>
                            }
                            @if (item.MaximumFileCount is { } maximumFiles)
                            {
                                <span> · @item.AcceptedFileCount of @maximumFiles files</span>
                            }
                        </td>
                        <td>@if (item.ExpiresAtUtc is { } expiry) { <time datetime="@expiry.ToString("O")">@OperatorLabels.OfficeTime(expiry)</time> }</td>
                        <td>
                            @if (item.CanRevoke)
                            {
                                <details>
                                    <summary class="btn">Withdraw link</summary>
                                    <form method="post" asp-page-handler="RevokeLink" class="row-confirm">
                                        <input type="hidden" name="requestId" value="@item.Id" />
                                        <input type="hidden" name="caseId" value="@item.CaseId" />
                                        <input type="hidden" name="expectedVersion" value="@item.Version" />
                                        <input type="hidden" name="expectedCaseVersion" value="@item.CaseVersion" />
                                        <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                        <label for="withdraw-reason-@item.Id">Reason</label>
                                        <input id="withdraw-reason-@item.Id" name="reason" maxlength="500" required value="@(Model.PreservedRequestId == item.Id ? Model.PreservedReason : null)" />
                                        <button class="btn btn--dark" type="submit">Withdraw link</button>
                                    </form>
                                </details>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="section-gap" aria-labelledby="ai-title">
    <h2 id="ai-title" class="section-label">AI operations</h2>
    <p>Requesting an AI job and viewing live AI work are planned and unavailable here.</p>
</section>

@if (Model.Operations.LimitReached)
{
    <p class="empty-state section-gap">Showing bounded operational results. Refresh for the latest activity.</p>
}
