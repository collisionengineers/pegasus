@page "/Operations"
@using Pegasus.Core.AiWork
@using Pegasus.Core.Operations
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Operations.IndexModel
@{
    ViewData["Title"] = "Operations";
    var aiJobs = Model.AiJobs;
    var externalWork = Model.Operations.Items
        .Where(item => item.CanRetry)
        .ToArray();
    var evaActivity = Model.EvaActivity;
    var evaFailures = Model.EvaFailures;
    var hasEvaHandoffs = evaActivity.LatestSubmittedAtUtc is not null
        || evaFailures.Count > 0;
}

@* The rail is the way back, so the header's action slot carries the thing
   only this screen can say: when its work list was last read. *@
<header class="page-header">
    <div class="page-title">
        <h1>Operations</h1>
    </div>
    <div class="page-actions">
        <partial name="Shared/_FreshnessBanner" model="Model.LoadedAtUtc" />
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice mb-2" role="status">
        <svg class="icon" aria-hidden="true"><use href="#icon-info" /></svg>
        <span>@Model.StatusMessage</span>
    </div>
}

@* Service health is Administration-only (FRD-12); this page runs no health
   query of its own and only points to where it lives (D37). *@
@if (Model.Operations.LimitReached)
{
    <div class="notice notice--warning" role="status">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>
            <strong>@OperatorLabels.OperationsNotices.PartialData</strong>
            &mdash; <a href="/Administration/Health">@OperatorLabels.Admin.Health</a>
        </span>
    </div>
}

<div class="stack section-gap">
    <section class="panel" aria-labelledby="ai-jobs-title">
        <div class="panel-head">
            <div>
                <h2 id="ai-jobs-title">@OperatorLabels.AiJobs.PanelTitle</h2>
                <span class="muted">@OperatorLabels.AiJobs.Count(aiJobs.Count)</span>
            </div>
            <details>
                <summary class="btn btn--dark">
                    <svg class="icon" aria-hidden="true"><use href="#icon-sparkles" /></svg>
                    <span>@OperatorLabels.AiJobs.SendUnidentified</span>
                </summary>
                <form method="post" asp-page-handler="SendUnidentifiedToAi" class="row-confirm">
                    <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                    <label for="send-unidentified-reference">Unidentified reference</label>
                    <input id="send-unidentified-reference"
                           name="unidentifiedReference"
                           maxlength="20"
                           required />
                    <button class="btn btn--dark" type="submit">@OperatorLabels.AiJobs.SendUnidentified</button>
                </form>
            </details>
        </div>
        @if (aiJobs.Count > 0)
        {
            <div class="table-wrap no-border">
                <table>
                    <caption class="sr-only">@OperatorLabels.AiJobs.PanelTitle</caption>
                    <thead><tr><th scope="col">Job</th><th scope="col">Record</th><th scope="col">Started by</th><th scope="col">Created</th><th scope="col">State</th><th scope="col">Action</th></tr></thead>
                    <tbody>
                    @foreach (var job in aiJobs)
                    {
                        var recordPage = IndexModel.RecordPage(job);
                        var review = IndexModel.ReviewAction(job);
                        var canComplete = IndexModel.CanCompleteByHand(job);
                        var canCancel = !AiJobStates.IsTerminal(job.State);
                        <tr>
                            <td>
                                <strong>@OperatorLabels.AiJobs.Kind(job.Kind)</strong>
                                <span class="muted">@job.Instruction</span>
                            </td>
                            <td>
                                @if (recordPage is { } recordRoute && job.SubjectId is { } subjectId)
                                {
                                    <a asp-page="@recordRoute" asp-route-id="@subjectId">@job.SubjectReference</a>
                                }
                                else
                                {
                                    <span>@OperatorLabels.AiJobs.QueueRecord</span>
                                }
                            </td>
                            <td>@Model.StartedBy(job)</td>
                            <td><time datetime="@job.CreatedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(job.CreatedAtUtc)</time></td>
                            <td>
                                <partial name="Shared/_StatusChip"
                                         model="@OperatorLabels.AiJobs.State(job.State)"
                                         view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = OperatorLabels.AiJobs.StateToneOverride(job.State) }' />
                            </td>
                            <td>
                                @if (review is { } action)
                                {
                                    <a class="btn btn--small" href="@action.Route">@action.Label</a>
                                }
                                @if (canComplete)
                                {
                                    <form method="post" asp-page-handler="CompleteAiJob">
                                        <input type="hidden" name="jobId" value="@job.JobId" />
                                        <input type="hidden" name="expectedVersion" value="@job.Version" />
                                        <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                        <button class="btn btn--small btn--dark" type="submit">@OperatorLabels.AiJobs.CompleteJob</button>
                                    </form>
                                }
                                @if (canCancel)
                                {
                                    <details>
                                        <summary class="btn btn--small btn--danger">@OperatorLabels.AiJobs.Cancel</summary>
                                        <form method="post" asp-page-handler="CancelAiJob" class="row-confirm">
                                            <input type="hidden" name="jobId" value="@job.JobId" />
                                            <input type="hidden" name="expectedVersion" value="@job.Version" />
                                            <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                            <label for="cancel-job-reason-@job.JobId">Reason</label>
                                            <input id="cancel-job-reason-@job.JobId" name="reason" maxlength="500" required />
                                            <button class="btn btn--dark" type="submit">@OperatorLabels.AiJobs.Cancel</button>
                                        </form>
                                    </details>
                                }
                                @if (review is null && !canComplete && !canCancel)
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (hasEvaHandoffs)
    {
        <section class="panel" aria-labelledby="eva-handoffs-title">
            <div class="panel-head">
                <h2 id="eva-handoffs-title">@OperatorLabels.EvaHandoffs.PanelTitle</h2>
            </div>
            <div class="table-wrap no-border">
                <table>
                    <caption class="sr-only">@OperatorLabels.EvaHandoffs.PanelTitle</caption>
                    <thead><tr><th scope="col">@OperatorLabels.EvaHandoffs.LatestActivity</th><th scope="col">@OperatorLabels.EvaHandoffs.Failures</th></tr></thead>
                    <tbody>
                        <tr>
                            <td>
                                @if (evaActivity.LatestSubmittedAtUtc is { } activity)
                                {
                                    <time datetime="@activity.ToString("O")">@OperatorLabels.OfficeTime(activity)</time>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td class="tabular">@evaFailures.Count</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            @if (evaFailures.Count > 0)
            {
                <div class="table-wrap no-border">
                    <table>
                        <caption class="sr-only">@OperatorLabels.EvaHandoffs.Failures</caption>
                        <thead><tr><th scope="col">@OperatorLabels.EvaHandoffs.Failure</th><th scope="col">@OperatorLabels.EvaHandoffs.Submitted</th></tr></thead>
                        <tbody>
                        @foreach (var failure in evaFailures)
                        {
                            <tr>
                                <td>@OperatorLabels.EvaHandoffs.Failed</td>
                                <td><time datetime="@failure.SubmittedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(failure.SubmittedAtUtc)</time></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    <section class="panel" aria-labelledby="attention-title">
        <div class="panel-head">
            <h2 id="attention-title">Attention required</h2>
        </div>
        @if (externalWork.Length == 0 && Model.FailedIntake.Count == 0)
        {
            <div class="empty">
                <h2>Nothing needs attention</h2>
            </div>
        }
        @if (Model.FailedIntake.Count > 0)
        {
            <div class="table-wrap no-border">
                <table class="table table--compact" data-failed-intake>
                    <caption class="sr-only">Failed intake processing</caption>
                    <thead><tr><th scope="col">Work</th><th scope="col">Item</th><th scope="col">Source</th><th scope="col">Attempts</th><th scope="col">Failure</th><th scope="col">Received</th><th scope="col"><span class="sr-only">Action</span></th></tr></thead>
                    <tbody>
                    @foreach (var intake in Model.FailedIntake)
                    {
                        var logUrl = $"/Administration/Logs?tab=intake&Receipt={intake.Row.ReceiptId:D}";
                        var failureKind = intake.Row.Outcome;
                        <tr data-failed-intake-row="@intake.Row.ReceiptId" data-failed-intake-kind="@OperatorLabels.IntakeLog.FailureKindSlug(failureKind)">
                            <td>@OperatorLabels.IntakeLog.Outcome(failureKind)</td>
                            <td><a href="@logUrl">@intake.Row.Item</a></td>
                            <td>@OperatorLabels.IntakeLog.Source(intake.Row.Source)</td>
                            <td class="tabular">@intake.Row.ProcessingAttempts</td>
                            <td>@(intake.Row.OutcomeReason ?? "—")</td>
                            <td><time datetime="@intake.Row.ReceivedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(intake.Row.ReceivedAtUtc)</time></td>
                            <td class="row-actions">
                                @if (failureKind == IntakeLogOutcome.AllocationFailed && intake.Actions.CanRetryAllocation && intake.LatestAllocationAttempt is { } lastAttempt)
                                {
                                    <details>
                                        <summary class="btn btn--small">@OperatorLabels.IntakeLog.RetryAllocation</summary>
                                        <form method="post" action="/Administration/Logs?handler=RetryIntakeAllocation" class="row-confirm">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="receiptId" value="@intake.Row.ReceiptId" />
                                            <input type="hidden" name="expectedVersion" value="@intake.ReceiptVersion" />
                                            <input type="hidden" name="expectedAttemptId" value="@lastAttempt.AttemptId" />
                                            <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                            <input type="hidden" name="returnUrl" value="/Operations" />
                                            <label for="retry-allocation-reason-@intake.Row.ReceiptId">Reason</label>
                                            <input id="retry-allocation-reason-@intake.Row.ReceiptId" name="reason" maxlength="500" required />
                                            <button class="btn btn--dark" type="submit">@OperatorLabels.IntakeLog.RetryAllocation</button>
                                        </form>
                                    </details>
                                }
                                @if (failureKind == IntakeLogOutcome.OcrFailed && intake.Actions.CanRetryOcr)
                                {
                                    <details>
                                        <summary class="btn btn--small">@OperatorLabels.IntakeLog.RetryOcr</summary>
                                        <form method="post" action="/Administration/Logs?handler=RetryIntakeOcr" class="row-confirm">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="receiptId" value="@intake.Row.ReceiptId" />
                                            <input type="hidden" name="expectedVersion" value="@intake.ReceiptVersion" />
                                            <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                            <input type="hidden" name="returnUrl" value="/Operations" />
                                            <label for="retry-ocr-reason-@intake.Row.ReceiptId">Reason</label>
                                            <input id="retry-ocr-reason-@intake.Row.ReceiptId" name="reason" maxlength="500" required />
                                            <button class="btn btn--dark" type="submit">@OperatorLabels.IntakeLog.RetryOcr</button>
                                        </form>
                                    </details>
                                }
                                @if (failureKind == IntakeLogOutcome.ProcessingFailed && intake.Actions.CanReevaluate)
                                {
                                    <details>
                                        <summary class="btn btn--small">Re-evaluate</summary>
                                        <form method="post" action="/Administration/Logs?handler=ReevaluateIntake" class="row-confirm">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="receiptId" value="@intake.Row.ReceiptId" />
                                            <input type="hidden" name="expectedVersion" value="@intake.ReceiptVersion" />
                                            <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                            <input type="hidden" name="returnUrl" value="/Operations" />
                                            <label for="reevaluate-reason-@intake.Row.ReceiptId">Reason</label>
                                            <input id="reevaluate-reason-@intake.Row.ReceiptId" name="reason" maxlength="500" required />
                                            <button class="btn btn--dark" type="submit">@OperatorLabels.IntakeLog.Reevaluate</button>
                                        </form>
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        @if (externalWork.Length > 0)
        {
            <div class="table-wrap no-border">
                <table>
                    <caption class="sr-only">Retryable external work</caption>
                    <thead><tr><th scope="col">Case</th><th scope="col">Work</th><th scope="col">Attempts</th><th scope="col">Failure</th><th scope="col">Action</th></tr></thead>
                    <tbody>
                    @foreach (var item in externalWork)
                    {
                        <tr>
                            <td><a asp-page="/Cases/Details" asp-route-id="@item.CaseId">@item.CaseReference</a></td>
                            <td>@OperatorLabels.Humanise(item.ExternalKind)</td>
                            <td class="tabular">@item.AttemptCount</td>
                            <td>@item.FailureReason</td>
                            <td>
                                <form method="post" asp-page-handler="RetryExternal">
                                    <input type="hidden" name="workItemId" value="@item.Id" />
                                    <input type="hidden" name="expectedAttemptCount" value="@item.AttemptCount" />
                                    <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                    <button class="btn btn--dark" type="submit">
                                        <svg class="icon" aria-hidden="true"><use href="#icon-play" /></svg>
                                        <span>Retry this work</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

</div>
