@page "/Operations"
@using Pegasus.Core.Operations
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Operations.IndexModel
@{
    ViewData["Title"] = "Operations";
    var uploadLinks = Model.Operations.Items
        .Where(item => item.Kind == RequestOperationKind.PegasusUploadLink)
        .ToArray();
    var externalWork = Model.Operations.Items
        .Where(item => item.Kind == RequestOperationKind.ExternalWork && item.CanRetry)
        .ToArray();
    var serviceHealth = Model.ServiceHealth;
}

@* The rail is the way back, so the header's action slot carries the thing
   only this screen can say: when its work list was last read. *@
<header class="page-header">
    <div class="page-title">
        <h1>Operations</h1>
    </div>
    <div class="page-actions">
        <partial name="Shared/_FreshnessBanner" model="Model.LoadedAtUtc" />
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice mb-2" role="status">
        <svg class="icon" aria-hidden="true"><use href="#icon-info" /></svg>
        <span>@Model.StatusMessage</span>
    </div>
}

@if (Model.Operations.LimitReached)
{
    <div class="notice notice--warning" role="status">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span><strong>Partial data</strong> — Showing recent operational results; refresh for the latest activity.</span>
    </div>
}

<div class="stack section-gap">
    @* The snapshot exists only where this deployment composes the query; an
       uncomposed capability is absent, never an empty panel. *@
    @if (serviceHealth is not null)
    {
        <section class="panel" aria-labelledby="service-health-title">
            <div class="panel-head">
                <div>
                    <h2 id="service-health-title">Service health</h2>
                    <span class="muted">@OperatorLabels.OfficeClock(serviceHealth.AsOfUtc)</span>
                </div>
            </div>
            <div class="table-wrap no-border">
                <table>
                    <caption class="sr-only">Service health</caption>
                    <thead><tr><th scope="col">Area</th><th scope="col">Service</th><th scope="col">State</th><th scope="col">Latest evidence</th><th scope="col">Dependency</th><th scope="col"><span class="sr-only">Action</span></th></tr></thead>
                    <tbody>
                    @foreach (var row in serviceHealth.Rows)
                    {
                        <tr>
                            <td>@OperatorLabels.ServiceHealthAreaName(row.Area)</td>
                            <td>@OperatorLabels.ServiceHealthServiceName(row.Service)</td>
                            <td><partial name="Shared/_StatusChip" model="@OperatorLabels.ServiceHealthStateName(row.State)" /></td>
                            <td>
                                @if (row.LatestEvidenceAtUtc is { } evidence)
                                {
                                    <time datetime="@evidence.ToString("O")">@OperatorLabels.OfficeTime(evidence)</time>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td>@OperatorLabels.ServiceHealthDependencyName(row.Dependency)</td>
                            <td>
                                @if (row.RetryTarget is { } target)
                                {
                                    <form method="post" asp-page-handler="RetryExternal">
                                        <input type="hidden" name="workItemId" value="@target.WorkItemId" />
                                        <input type="hidden" name="expectedAttemptCount" value="@target.ExpectedAttemptCount" />
                                        <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                        <button class="btn btn--small btn--dark" type="submit">
                                            <svg class="icon" aria-hidden="true"><use href="#icon-refresh-cw" /></svg>
                                            <span>Retry</span>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section class="panel" aria-labelledby="attention-title">
        <div class="panel-head">
            <h2 id="attention-title">Attention required</h2>
        </div>
        @if (externalWork.Length == 0)
        {
            <div class="empty">
                <h2>No retryable external work</h2>
            </div>
        }
        else
        {
            <div class="table-wrap no-border">
                <table>
                    <caption class="sr-only">Retryable external work</caption>
                    <thead><tr><th scope="col">Case</th><th scope="col">Work</th><th scope="col">Attempts</th><th scope="col">Failure</th><th scope="col">Action</th></tr></thead>
                    <tbody>
                    @foreach (var item in externalWork)
                    {
                        <tr>
                            <td><a asp-page="/Cases/Details" asp-route-id="@item.CaseId">@item.CaseReference</a></td>
                            <td>@OperatorLabels.Humanise(item.ExternalKind)</td>
                            <td class="tabular">@item.AttemptCount</td>
                            <td>@item.FailureReason</td>
                            <td>
                                <form method="post" asp-page-handler="RetryExternal">
                                    <input type="hidden" name="workItemId" value="@item.Id" />
                                    <input type="hidden" name="expectedAttemptCount" value="@item.AttemptCount" />
                                    <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                    <button class="btn btn--dark" type="submit">
                                        <svg class="icon" aria-hidden="true"><use href="#icon-refresh-cw" /></svg>
                                        <span>Retry this work</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel" aria-labelledby="upload-links-title">
        <div class="panel-head">
            <h2 id="upload-links-title">Active upload links</h2>
        </div>
        @if (uploadLinks.Length == 0)
        {
            <div class="empty">
                <h2>No active upload links</h2>
            </div>
        }
        else
        {
            <div class="table-wrap no-border">
                <table>
                    <caption class="sr-only">Active Pegasus upload links</caption>
                    <thead><tr><th scope="col">Case</th><th scope="col">Last activity</th><th scope="col">Accepted</th><th scope="col">Expires</th><th scope="col">State</th><th scope="col">Action</th></tr></thead>
                    <tbody>
                    @foreach (var item in uploadLinks)
                    {
                        <tr>
                            <td><a asp-page="/Cases/Details" asp-route-id="@item.CaseId">@item.CaseReference</a></td>
                            <td><time datetime="@item.LastActivityAtUtc.ToString("O")">@OperatorLabels.OfficeTime(item.LastActivityAtUtc)</time></td>
                            <td>
                                @if (item.MaximumByteCount is { } maximumBytes)
                                {
                                    <span>@OperatorLabels.FileSize(item.AcceptedByteCount ?? 0) of @OperatorLabels.FileSize(maximumBytes)</span>
                                }
                                @if (item.MaximumFileCount is { } maximumFiles)
                                {
                                    <span> · @item.AcceptedFileCount of @maximumFiles files</span>
                                }
                            </td>
                            <td>@if (item.ExpiresAtUtc is { } expiry) { <time datetime="@expiry.ToString("O")">@OperatorLabels.OfficeTime(expiry)</time> }</td>
                            <td><partial name="Shared/_StatusChip" model="@IndexModel.StateLabel(item.State)" /></td>
                            <td>
                                @if (item.CanRevoke)
                                {
                                    <details>
                                        <summary class="btn btn--danger">
                                            <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                                            <span>Withdraw link</span>
                                        </summary>
                                        <form method="post" asp-page-handler="RevokeLink" class="row-confirm">
                                            <input type="hidden" name="requestId" value="@item.Id" />
                                            <input type="hidden" name="caseId" value="@item.CaseId" />
                                            <input type="hidden" name="expectedVersion" value="@item.Version" />
                                            <input type="hidden" name="expectedCaseVersion" value="@item.CaseVersion" />
                                            <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                            <label for="withdraw-reason-@item.Id">Reason</label>
                                            <input id="withdraw-reason-@item.Id" name="reason" maxlength="500" required value="@(Model.PreservedRequestId == item.Id ? Model.PreservedReason : null)" />
                                            <button class="btn btn--dark" type="submit">Withdraw link</button>
                                        </form>
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
