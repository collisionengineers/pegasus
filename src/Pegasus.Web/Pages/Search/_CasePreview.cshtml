@model Pegasus.Web.Pages.Search.IndexModel.ResultRow
@using Pegasus.Web.Presentation

@* The Selected Case preview is drawn once for the server-selected row and
   once per results row as that row's swap-in template. Open Case travels
   with the preview, so the anchor remains live after the script swaps it in.
   The accident circumstances are read for the one Case the page opens on and
   printed here; every other row carries the address that reads its own, which
   the script fetches when the row is selected. The data- attributes sit in
   their own branch because Razor writes a data- attribute even when its
   value is null. *@
<div class="detail-canvas">
    <p class="eyebrow">@OperatorLabels.CaseTypeName(Model.Item.CaseType)</p>
    <h2>@Model.Heading</h2>
    <p class="muted">@Model.Muted</p>
    <partial name="Shared/_StatusChip" model="@Model.Chip" />
    <section class="section-gap">
        <h3 class="section-label">Accident circumstances</h3>
        @if (Model.CircumstancesHref is { } circumstancesHref)
        {
            <p data-circumstances-url="@circumstancesHref" data-circumstances-failed="@OperatorLabels.CircumstancesUnavailable">@OperatorLabels.Busy.Loading</p>
        }
        else
        {
            <p>@Pegasus.Web.Pages.Search.IndexModel.CircumstancesText(Model.Circumstances)</p>
        }
    </section>
    <div class="fact-grid">
        <dl class="fact"><dt>Our ref</dt><dd>@Model.PrincipalReference</dd></dl>
        <dl class="fact"><dt>Engineer</dt><dd>@Model.Engineer</dd></dl>
        @if (Model.Editing.Length > 0)
        {
            <dl class="fact"><dt>@Pegasus.Web.Presentation.CaseWorkspaceLabels.Frame.Editing</dt><dd>@Model.Editing</dd></dl>
        }
        <dl class="fact"><dt>Due</dt><dd>@Model.Due</dd></dl>
        <dl class="fact"><dt>Next action</dt><dd>@Model.NextAction</dd></dl>
    </div>
    @* Outstanding requirements are the case's recorded completeness facts:
       the requirement and the action that resolves it, nothing else. *@
    @if (Model.Outstanding.Count > 0)
    {
        <section class="section-gap">
            <h3 class="section-label">Outstanding (@Model.Outstanding.Count)</h3>
            <ul class="blocker-list">
                @foreach (var requirement in Model.Outstanding)
                {
                    <li class="blocker">
                        <strong>@requirement.Requirement</strong>
                        <small>@requirement.Resolve</small>
                    </li>
                }
            </ul>
        </section>
    }
    <div class="button-row section-gap">
        <a class="btn btn--dark" href="@Model.DetailHref">
            <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
            <span>Open Case</span>
        </a>
    </div>
</div>
