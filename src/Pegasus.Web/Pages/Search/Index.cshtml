@page
@model Pegasus.Web.Pages.Search.IndexModel
@using System.Globalization
@using Pegasus.Core.Workflow
@using Pegasus.Web.Presentation
@{
    ViewData["Title"] = "Search";

    // Refreshing reruns the query with its filters, page and selected row,
    // not page one of everything.
    ViewData["RefreshFields"] = Model.RefreshFields();

    var results = Model.Results;
    var listingImages = Model.RecordKindFilter == "images";
}

@* No lede: the grid names its inputs and the two panes name themselves. *@
<header class="page-header">
    <div class="page-title">
        <h1>Search</h1>
    </div>
    <div class="page-actions">
        <partial name="Shared/_FreshnessBanner" model="Model.LoadedAtUtc" />
        @* A case is made from received material, so /Cases/Create is
           receipt-bound (Create.cshtml.cs returns NotFound without one) and
           every working call site reaches it with a receipt. This page holds
           no receipt, so the contracted action starts where the receipt comes
           from. The Add dialog and Ctrl N still point at the receipt-less
           404; settling all of them is PLAT-059, whose files are PLAT-029's. *@
        <a class="btn btn--primary" asp-page="/Upload">
            <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
            <span>Create Case</span>
        </a>
    </div>
</header>

@* The advanced grid: every UI-07 input in one panel. Search is the form's
   one submit; Clear is the page itself. The State select is the lifecycle
   enum through the one display mapping (D3), so a terminal outcome is a
   choice here and a result here — the work views exclude those cases, this
   page is where they stay findable. *@
<form method="get" class="panel section-gap" aria-label="Filter cases">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="panel-body advanced-search-grid">
        <div class="field">
            <label for="search-query">Case/PO or image reference</label>
            <input id="search-query" name="query" value="@Model.Query" maxlength="300" />
        </div>
        <div class="field">
            <label for="search-registration">Registration</label>
            <input id="search-registration" name="registration" value="@Model.Registration" maxlength="20" />
        </div>
        <div class="field">
            <label for="search-claimant">Claimant</label>
            <input id="search-claimant" name="claimant" value="@Model.Claimant" maxlength="300" />
        </div>
        <div class="field">
            <label for="search-claim-number">Claim/provider reference</label>
            <input id="search-claim-number" name="claimNumber" value="@Model.ClaimNumber" maxlength="100" />
        </div>
        <div class="field">
            <label for="search-principal">Principal</label>
            <input id="search-principal" name="principal" value="@Model.Principal" maxlength="20" />
        </div>
        <div class="field">
            <label for="search-state">State</label>
            <select id="search-state" name="state">
                <option value="">All states</option>
                @foreach (var state in Enum.GetValues<CaseLifecycleState>())
                {
                    <option value="@state" selected="@(Model.State == state)">@OperatorLabels.CaseStage(state)</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="search-engineer">Engineer</label>
            <input id="search-engineer" name="engineerId" value="@Model.EngineerId?.ToString("D")" />
            <span asp-validation-for="EngineerId" class="field-validation-error"></span>
        </div>
        <div class="field">
            <label for="search-from-date">Received from</label>
            <input id="search-from-date" name="fromDate" type="date"
                   value="@Model.FromDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
            <span asp-validation-for="FromDate" class="field-validation-error"></span>
        </div>
        <div class="field">
            <label for="search-to-date">Received to</label>
            <input id="search-to-date" name="toDate" type="date"
                   value="@Model.ToDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
            <span asp-validation-for="ToDate" class="field-validation-error"></span>
        </div>
        <div class="field">
            <label for="search-origin">Origin</label>
            <input id="search-origin" name="origin" value="@Model.Origin" maxlength="100" />
        </div>
        <div class="button-row">
            <button type="submit" class="btn btn--dark">
                <svg class="icon" aria-hidden="true"><use href="#icon-search" /></svg>
                <span>Search</span>
            </button>
            <a asp-page="/Search/Index" class="btn">
                <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                <span>Clear</span>
            </a>
        </div>
    </div>
</form>

@* One failure, one notice. Both reads on this page run inside the same
   guarded load, so either can fail; neither section may answer a failed
   query with an empty result or a "0 results" count. *@
@if (Model.QueryFailed)
{
    <div class="notice notice--danger section-gap" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <div>
            <strong>Cases are unavailable</strong>
            <p>The search could not be completed; try again.</p>
        </div>
    </div>
}
else if (Model.ImageIntakeResults.Count > 0)
{
    @* Image-initiated Cases answer the same reference or registration and
       keep their own record shape and named states (FRD-12). *@
    <h2 class="section-label section-gap">Vehicle images</h2>
    <div class="panel" data-row-list>
        @foreach (var item in Model.ImageIntakeResults)
        {
            <a class="row-button" asp-page="/ImageIntake/Details" asp-route-id="@item.Id">
                <span class="row-top">
                    <span class="row-title">@IndexModel.Join(item.ImageIntakeReference, item.NormalizedVehicleRegistration)</span>
                    <partial name="Shared/_StatusChip" model="@OperatorLabels.ImageIntakeLifecycleState(item.State)" />
                </span>
                @if (item.AssociatedCaseReference is { } caseReference)
                {
                    <span class="row-excerpt">Associated with @caseReference</span>
                }
                <span class="row-top">
                    <span class="row-meta">Registered @OperatorLabels.OfficeTime(item.RegisteredAtUtc)</span>
                </span>
            </a>
        }
    </div>
}
else if (listingImages)
{
    <p class="empty">No vehicle images match these filters.</p>
}

@if (!listingImages && !Model.QueryFailed)
{
    <section class="pane-layout pane-layout--2 case-search-layout section-gap">
        <div class="pane">
            <div class="pane-head">
                <div>
                    <h2>Case results</h2>
                    <span class="muted">@Model.Rows.Count result@(Model.Rows.Count == 1 ? string.Empty : "s")</span>
                </div>
            </div>
            <div class="pane-body pane-scroll" data-row-list>
                @if (ViewData.ModelState.IsValid && Model.Rows.Count == 0 && Model.ImageIntakeResults.Count == 0)
                {
                    @* One sentence, in the wording the page's own
                       "No vehicle images match these filters." line uses.
                       It does not run when invalid input kept the query
                       from executing at all. *@
                    <p class="empty" aria-live="polite">No cases match these filters.</p>
                }
                else if (Model.Rows.Count > 0)
                {
                    @* A row previews itself beside the table through its own
                       template, and carries its Case's link for the no-script
                       path; the selected row is the one the pane reads,
                       marked as the table's current row. *@
                    <div class="table-wrap">
                        <table>
                            <caption class="sr-only">Case search results</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Case/PO</th>
                                    <th scope="col">Vehicle</th>
                                    <th scope="col">Claimant</th>
                                    <th scope="col">Principal</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">State</th>
                                    <th scope="col">Due</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.Rows)
                                {
                                    <tr data-select-href="@row.SelectHref" data-select-id="@row.Item.CaseId"
                                        data-copy-reference="@row.Item.Reference"
                                        aria-selected="@(Model.SelectedId == row.Item.CaseId ? "true" : "false")">
                                        <td>
                                            <a class="table-row-link" href="@row.DetailHref">@row.Item.Reference</a>
                                            @if (row.Item.ClaimNumber is { } providerReference)
                                            {
                                                <span class="secondary">@providerReference</span>
                                            }
                                        </td>
                                        <td>
                                            @(row.Item.Registration ?? "Not recorded")
                                            @if (row.Vehicle.Length > 0)
                                            {
                                                <span class="secondary">@row.Vehicle</span>
                                            }
                                        </td>
                                        <td>@(row.Item.Claimant ?? "Not recorded")</td>
                                        <td>@row.Item.Principal</td>
                                        <td>@OperatorLabels.CaseTypeName(row.Item.CaseType)</td>
                                        <td><partial name="Shared/_StatusChip" model="@row.Chip" /></td>
                                        <td>@row.Due</td>
                                        <template>
                                            <partial name="_CasePreview" model="row" />
                                        </template>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            @if (results is { HasPreviousPage: true } or { HasNextPage: true })
            {
                <nav class="pagination" aria-label="Case result pages">
                    @if (results.HasPreviousPage)
                    {
                        <a class="btn btn--small" href="@Model.Href(page: results.Page - 1)">Previous</a>
                    }
                    <span>Page @results.Page</span>
                    @if (results.HasNextPage)
                    {
                        <a class="btn btn--small" href="@Model.Href(page: results.Page + 1)">Next</a>
                    }
                </nav>
            }
        </div>
        <div class="pane">
            <div class="pane-head">
                <h2>Selected Case</h2>
            </div>
            <div class="pane-body pane-scroll">
                <div data-preview-target>
                    @if (Model.Selected is { } selected)
                    {
                        <partial name="_CasePreview" model="selected" />
                    }
                </div>
                @if (Model.Selected is { } copySource)
                {
                    @* Copy Case/PO sits outside the swapped preview because
                       the shell's copy control binds once at load; a control
                       swapped into the preview would lose that binding. Its
                       value is the selected row's reference — server-rendered
                       here, and kept in step with a script-side selection by
                       the Scripts section below. *@
                    <div class="button-row">
                        <span class="sr-only" id="search-copy-reference">@copySource.Item.Reference</span>
                        <button type="button" class="btn btn--small" data-copy-target="search-copy-reference" hidden>
                            <svg class="icon" aria-hidden="true"><use href="#icon-copy" /></svg>
                            <span>Copy Case/PO</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </section>
}

@section Scripts {
    <script>
        // The shell's row-selection module swaps the preview target and
        // rewrites the address; two controls this page owns live outside that
        // region because they cannot survive being replaced — the Copy
        // Case/PO source (the shell's clipboard binding resolves it once, at
        // load) and the refresh form's hidden `selected` field. Without this
        // they keep the row the server selected: Copy pasted the previous
        // Case/PO and Refresh reopened the previous row. The clipboard and
        // the selection stay the shell's; this only keeps the two values on
        // the row the operator is reading.
        (function () {
            'use strict';
            var reference = document.getElementById('search-copy-reference');
            var refreshField = document.querySelector('[data-refresh-form] input[name="selected"]');
            if (!reference && !refreshField) {
                return;
            }

            document.querySelectorAll('tr[data-copy-reference][data-select-id]').forEach(function (row) {
                function follow() {
                    if (reference) {
                        reference.textContent = row.getAttribute('data-copy-reference');
                    }
                    if (refreshField) {
                        refreshField.value = row.getAttribute('data-select-id');
                    }
                }

                // The same three openings the shell selects on, with the same
                // guard: a click on the row's own link or button is that
                // control's, not a selection.
                row.addEventListener('click', function (event) {
                    if (!event.target.closest('a, button')) {
                        follow();
                    }
                });
                row.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter' && !event.target.closest('a, button')) {
                        follow();
                    }
                });
                row.addEventListener('focus', follow);
            });
        })();
    </script>
}
