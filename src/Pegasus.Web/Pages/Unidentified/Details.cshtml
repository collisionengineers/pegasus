@page "/Unidentified/{id:guid}"
@model Pegasus.Web.Pages.Unidentified.DetailsModel
@using Pegasus.Core.ImageIntake
@using Pegasus.Core.Intake
@using Pegasus.Core.Intake.Unidentified
@using Pegasus.Web.Presentation
@{
    ViewData["Title"] = Model.Item.Reference;
    var isOpen = Model.Item.State == UnidentifiedState.Open;
}

<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">Unidentified</p>
        <h1>@Model.Item.Reference</h1>
    </div>
    <div class="page-actions">
        <a class="btn" asp-page="/Cases/Index" asp-route-tab="unidentified">
            <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
            <span>Back to Cases</span>
        </a>
        <form method="get" data-refresh-form>
            <button type="submit" class="btn btn--small" title="Refresh">
                <svg class="icon icon--spin" aria-hidden="true"><use href="#icon-refresh-cw" /></svg>
                <span>Refresh</span>
            </button>
        </form>
    </div>
</header>

<div asp-validation-summary="All" class="validation-summary" role="alert"></div>

<article class="record">
    <header class="record-head">
        <strong>@Model.Item.Reference</strong>
        <span class="record-identity">
            <span>@Model.MediaKindLabel</span>
            <span>Received @OperatorLabels.OfficeTime(Model.Item.CreatedAtUtc)</span>
            <span>@Model.Handle</span>
        </span>
        <span class="record-head-end">
            <partial name="Shared/_StatusChip" model="@OperatorLabels.UnidentifiedState(Model.Item.State)" />
        </span>
    </header>
    <div class="record-accent"></div>

    <div class="record-body">
        <div class="notice notice--warning" role="status">
            <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
            <span>@Model.ReasonLabel</span>
        </div>

        <section class="panel section-gap" aria-labelledby="unidentified-source-title">
            <div class="panel-head"><h2 id="unidentified-source-title">Retained source</h2></div>
            <div class="panel-body stack">
                <div class="definition-list">
                    <dl class="definition"><dt>Permanent reference</dt><dd>@Model.Item.Reference</dd></dl>
                    <dl class="definition"><dt>Kind</dt><dd>@Model.MediaKindLabel</dd></dl>
                    <dl class="definition"><dt>Operator handle</dt><dd>@Model.Handle</dd></dl>
                    <dl class="definition"><dt>Received</dt><dd>@OperatorLabels.OfficeTime(Model.Item.CreatedAtUtc)</dd></dl>
                    <dl class="definition">
                        <dt>Source</dt>
                        <dd>@(Model.SourceReceipt is { } receipt
                            ? OperatorLabels.SourceChannel(receipt.SourceIdentity.Channel)
                            : Model.SourceSubmissionGroup is { } sourceGroup
                                ? OperatorLabels.SourceChannel(sourceGroup.Channel)
                                : "Not available")</dd>
                    </dl>
                    <dl class="definition"><dt>Canonical reason</dt><dd>@Model.ReasonLabel</dd></dl>
                </div>
                @if (Model.SourceSubmissionGroup is { } retainedGroup)
                {
                    <ul aria-label="Retained files">
                        @foreach (var member in retainedGroup.Members.OrderBy(member => member.Ordinal))
                        {
                            <li>@member.SourceFileName</li>
                        }
                    </ul>
                    <a class="btn" asp-page="/UploadGroupStatus" asp-route-id="@retainedGroup.Id">View retained submission</a>
                }
                @if (Model.SourceReceipt is { } imageReceipt
                    && imageReceipt.MediaType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                {
                    var href = $"/Received/{imageReceipt.Id:D}/Image";
                    <partial name="Shared/_ImageGallery" model="@new[] { new GalleryImage(
                        href, href, imageReceipt.SourceFileName, imageReceipt.MediaType) }" />
                }
                <div class="button-row">
                    @if (Model.SourceReceipt is { } viewableReceipt)
                    {
                        <a class="btn" asp-page="/Intake/Details" asp-route-id="@viewableReceipt.Id">
                            <svg class="icon" aria-hidden="true"><use href="#icon-eye" /></svg>
                            <span>View retained source</span>
                        </a>
                    }
                    @if (isOpen)
                    {
                        <button type="button" class="btn btn--dark" data-dialog-open="unidentified-resolve-dialog">
                            <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
                            <span>Resolve destination</span>
                        </button>
                    }
                </div>
            </div>
        </section>

        @if (Model.History.Count > 0)
        {
            <section class="panel section-gap" aria-labelledby="unidentified-history-title">
                <div class="panel-head"><h2 id="unidentified-history-title">History</h2></div>
                <div class="panel-body">
                    <div class="timeline">
                        @foreach (var entry in Model.History.OrderByDescending(history => history.OccurredAtUtc))
                        {
                            <div class="timeline-item">
                                <div class="timeline-title">
                                    @OperatorLabels.UnidentifiedState(entry.NewState)
                                    @if (entry.TargetKind is { } targetKind)
                                    {
                                        @:· @OperatorLabels.UnidentifiedResolutionTarget(targetKind)
                                    }
                                </div>
                                <div class="timeline-meta">
                                    @OperatorLabels.OfficeTime(entry.OccurredAtUtc) · @entry.Reason
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
    </div>
</article>

@if (isOpen)
{
    <div class="dialog-backdrop" data-dialog="unidentified-resolve-dialog"
         data-dialog-open-on-load="@(Model.OpenResolutionDialog ? "true" : "false")" hidden>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="unidentified-resolve-dialog-title">
            <div class="dialog-head">
                <h2 id="unidentified-resolve-dialog-title" tabindex="-1">Resolve @Model.Item.Reference</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
            </div>
            <div class="dialog-body stack">
                <partial name="Shared/_ErrorSummary" />
                <div class="notice notice--warning"><svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg><span>The U-reference and original source remain after resolution.</span></div>
                <form method="get" asp-page="/Unidentified/Details" asp-route-id="@Model.Item.Id" class="filter-bar">
                    <div class="field"><label class="req" for="unidentified-action">Resolution</label>
                        <select id="unidentified-action" name="action" required data-dialog-initial-focus>
                            <option value="@Pegasus.Web.Pages.Unidentified.DetailsModel.AddExistingCaseAction" selected="@((Model.ResolutionAction is null or Pegasus.Web.Pages.Unidentified.DetailsModel.AddExistingCaseAction) ? "selected" : null)">Add to an existing Case</option>
                            <option value="@Pegasus.Web.Pages.Unidentified.DetailsModel.CreateCaseAction" disabled="@(!Model.CanCreateCase)" selected="@(Model.ResolutionAction == Pegasus.Web.Pages.Unidentified.DetailsModel.CreateCaseAction ? "selected" : null)">Create a Case from an accepted instruction</option>
                            <option value="@Pegasus.Web.Pages.Unidentified.DetailsModel.RegisterImageAction" disabled="@(!Model.CanRegisterImage && !Model.CanReviewGroupRegistration)" selected="@(Model.ResolutionAction == Pegasus.Web.Pages.Unidentified.DetailsModel.RegisterImageAction ? "selected" : null)">Register Image-initiated Case</option>
                            <option value="@Pegasus.Web.Pages.Unidentified.DetailsModel.CloseAction" selected="@(Model.ResolutionAction == Pegasus.Web.Pages.Unidentified.DetailsModel.CloseAction ? "selected" : null)">Close with reason</option>
                        </select>
                    </div>
                    <button type="submit" class="btn">Continue</button>
                </form>
                @if (Model.ResolutionAction == Pegasus.Web.Pages.Unidentified.DetailsModel.AddExistingCaseAction)
                {
                    @if (Model.SourceReceipt is { } associationReceipt) { <a class="btn btn--primary" asp-page="/Intake/Details" asp-route-id="@associationReceipt.Id">Open Case association</a> }
                    else if (Model.SourceSubmissionGroup?.Channel == IntakeSourceChannel.ManualUpload)
                    {
                        <a class="btn btn--primary" asp-page="/UploadGroupStatus" asp-route-id="@Model.Item.Origin.Id">Open submission association</a>
                    }
                    else if (Model.SourceImageIntake is { State: ImageInitiatedCaseState.AwaitingInstruction } imageIntake)
                    {
                        <a class="btn btn--primary" asp-page="/Cases/Index" asp-route-tab="awaiting" asp-route-selected="@imageIntake.Record.Id">Open awaiting instruction</a>
                    }
                    else if (Model.Item.Origin.Kind == UnidentifiedOriginKind.SubmissionGroup) { <p>This group is not currently ready for Case association.</p> }
                    else { <p>This retained source is not available for Case association.</p> }
                }
                else if (Model.ResolutionAction == Pegasus.Web.Pages.Unidentified.DetailsModel.CreateCaseAction)
                {
                    @if (Model.CanCreateCase && Model.SourceReceipt is { } createReceipt) { <a class="btn btn--primary" asp-page="/Cases/Create" asp-route-receiptId="@createReceipt.Id">Open Case creation</a> } else { <p>This retained source cannot create a Case.</p> }
                }
                else if (Model.ResolutionAction == Pegasus.Web.Pages.Unidentified.DetailsModel.RegisterImageAction)
                {
                    @if (Model.CanRegisterImage && Model.SourceReceipt is { } registrationReceipt)
                    {
                        <a class="btn btn--primary" asp-page="/Intake/Details" asp-route-id="@registrationReceipt.Id">Open image registration</a>
                    }
                    else if (Model.CanReviewGroupRegistration && Model.SourceSubmissionGroup is { } registrationGroup)
                    {
                        <p>Review the retained files and their processing results before registering this submission.</p>
                        <a class="btn btn--primary" asp-page="/UploadGroupStatus" asp-route-id="@registrationGroup.Id">Review image registration</a>
                    }
                    else { <p>This retained source cannot register an Image-initiated Case.</p> }
                }
                else if (Model.ResolutionAction == Pegasus.Web.Pages.Unidentified.DetailsModel.CloseAction)
                {
                    <form method="post" asp-page-handler="Resolve" asp-route-id="@Model.Item.Id" class="stack">
                        <input type="hidden" asp-for="ExpectedVersion" /><input type="hidden" asp-for="OperationKey" /><input type="hidden" name="action" value="@Pegasus.Web.Pages.Unidentified.DetailsModel.CloseAction" />
                        <div class="field"><label class="req" for="unidentified-resolution-reason">Reason</label><textarea id="unidentified-resolution-reason" asp-for="ResolutionReason" maxlength="500" rows="3" required></textarea></div>
                        <div class="dialog-foot"><button type="button" class="btn" data-dialog-close>Cancel</button><button type="submit" class="btn btn--primary">Close with reason</button></div>
                    </form>
                }
            </div>
        </section>
    </div>
}
<partial name="Shared/_EvidenceViewer" />
