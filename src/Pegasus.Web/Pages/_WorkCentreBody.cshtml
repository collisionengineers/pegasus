@model IndexModel
@using Pegasus.Core.AiWork
@using Pegasus.Core.Operations
@using Pegasus.Web.Presentation
@using Labels = Pegasus.Web.Presentation.OperatorLabels.WorkCentre
@{
    ViewData["Title"] = "Work Centre";
    var returnUrl = Model.PageUrl(selected: Model.Selected?.Id);
    var sinceAttribute = Model.DividerUtc is { } dividerAt
        ? Html.Raw($" data-wc-since=\"{dividerAt.ToString("O", System.Globalization.CultureInfo.InvariantCulture)}\"")
        : Html.Raw(string.Empty);
    // The refresh button replays the address that produced this screen:
    // scope, the kinds actually on, the search term, the tab, both pages, the
    // expanded row and the "since" line. Kinds repeat one key, so the replay is
    // a pair sequence rather than a dictionary.
    var refreshFields = new List<KeyValuePair<string, string?>>
    {
        new("scope", IndexModel.ScopeSlug(Model.Scope)),
        new("refresh", "true")
    };
    refreshFields.AddRange(Model.Kinds.Select(kind =>
        new KeyValuePair<string, string?>("kind", NeedsAttentionPresentation.KindSlug(kind))));
    if (Model.Search is { } refreshSearch)
    {
        refreshFields.Add(new("q", refreshSearch));
    }
    refreshFields.Add(new("tab", Model.Tab));
    if (IndexModel.ArrivalSlug(Model.Arrival) is { } refreshArrival)
    {
        refreshFields.Add(new("arrival", refreshArrival));
    }
    if (IndexModel.SystemFilterSlug(Model.SystemFilter) is { } refreshSys)
    {
        refreshFields.Add(new("sys", refreshSys));
    }
    if (IndexModel.AiFilterSlug(Model.AiFilter) is { } refreshAi)
    {
        refreshFields.Add(new("ai", refreshAi));
    }
    if (Model.CurrentPage > 1)
    {
        refreshFields.Add(new("page", Model.CurrentPage.ToString(System.Globalization.CultureInfo.InvariantCulture)));
    }
    if (Model.Selected is { } refreshSelected)
    {
        refreshFields.Add(new("selected", refreshSelected.Id.ToString("D")));
    }
    if (Model.NewCasesPage > 1)
    {
        refreshFields.Add(new("newPage", Model.NewCasesPage.ToString(System.Globalization.CultureInfo.InvariantCulture)));
    }
    if (Model.SystemActionsPage > 1)
    {
        refreshFields.Add(new("sysPage", Model.SystemActionsPage.ToString(System.Globalization.CultureInfo.InvariantCulture)));
    }
    if (Model.DividerUtc is { } refreshSince)
    {
        refreshFields.Add(new("since", refreshSince.ToString("O", System.Globalization.CultureInfo.InvariantCulture)));
    }
    ViewData["RefreshFields"] = refreshFields;
    var attentionState = Model.AttentionFailed ? "unavailable" : "current";
    var newCasesState = Model.NewCasesFailed ? "unavailable" : "current";
    var systemActionsState = Model.SystemActionsFailed ? "unavailable" : "current";
    var aiJobsState = Model.AiJobsUnavailable ? "unavailable" : "current";
    var activityState = Model.ActivityFailed ? "unavailable" : "current";
    var visibleTabs = Model.VisibleTabs;
}

<div class="work-centre" data-work-centre data-wc-scope="@IndexModel.ScopeSlug(Model.Scope)" data-wc-scope-named="@(Model.ScopeNamed ? "true" : "false")" data-wc-refresh-outcome="@Model.RefreshOutcome" data-wc-tab="@Model.Tab" @sinceAttribute>
<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">@Labels.Eyebrow</p>
        <h1>@Labels.Title</h1>
    </div>
    <div class="page-actions">
        @* "Updated HH:MM" is the page's one clock (v32 item J). It and the busy
           state share one region, so a background refresh can never report an
           outcome the operator's own click does not see. A plain GET: the page
           works without script. The script refreshes the same regions in place
           on focus and every five minutes (P5). *@
        <div class="wc-refresh">
            <span class="meta wc-refresh-outcome" data-wc-refresh-outcome-label>@Model.RefreshOutcomeLabel</span>
            <partial name="Shared/_RefreshButton" />
        </div>
    </div>
</header>

@if (Model.StatusMessage is { } status)
{
    <div class="notice notice--success" role="status">
        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-check")" /></svg>
        <span>@status</span>
        <button type="button" class="dismiss" data-dismiss aria-label="Dismiss"><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg></button>
    </div>
}
@if (Model.ErrorMessage is { } error)
{
    <div class="notice notice--danger" role="alert">
        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-triangle")" /></svg>
        <span>@error</span>
        <button type="button" class="dismiss" data-dismiss aria-label="Dismiss"><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg></button>
    </div>
}

@* Office queues beside Activity (v42 Design A). Each queue still opens its
   Cases tab. A failed read renders no figure, never a zero. The two cards
   stay separate refresh sections so one failure does not blank the other. *@
<div class="wc-stats-grid" aria-label="@Labels.OfficeQueueTotals">
    <section class="panel wc-stat-card" aria-label="@Labels.OfficeQueues" data-wc-refresh-section="metrics" data-wc-refresh-state="@attentionState">
        <div class="wc-stat-head">
            <h2>@Labels.OfficeQueues</h2>
            <a class="wc-stat-link" asp-page="/Cases/Index">@Labels.AllCases</a>
        </div>
        @if (Model.AttentionFailed)
        {
            <div class="notice notice--warning" role="status">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-triangle")" /></svg>
                <span>@Labels.Unavailable</span>
            </div>
        }
        else
        {
            var metrics = Model.Metrics!;
            <nav class="wc-queues" aria-label="@Labels.OfficeQueueTotals">
                <a class="wc-queue-cell wc-tone--amber" data-value="not_ready" asp-page="/Cases/Index" asp-route-tab="not_ready">
                    <span class="wc-queue-label">@Labels.NotReadyQueue</span>
                    <strong class="wc-queue-val">@metrics.NotReady</strong>
                </a>
                <a class="wc-queue-cell wc-tone--navy" data-value="review" asp-page="/Cases/Index" asp-route-tab="review">
                    <span class="wc-queue-label">@Labels.ReviewQueue</span>
                    <strong class="wc-queue-val">@metrics.Review</strong>
                </a>
                <a class="wc-queue-cell wc-tone--neutral" data-value="held" asp-page="/Cases/Index" asp-route-tab="held">
                    <span class="wc-queue-label">@Labels.HeldQueue</span>
                    <strong class="wc-queue-val">@metrics.Held</strong>
                </a>
                <a class="wc-queue-cell wc-tone--red" data-value="unidentified" asp-page="/Cases/Index" asp-route-tab="unassigned" asp-route-show="unidentified">
                    <span class="wc-queue-label">@Labels.UnidentifiedQueue</span>
                    <strong class="wc-queue-val">@metrics.Unidentified</strong>
                </a>
                <a class="wc-queue-cell wc-tone--blue" data-value="triage" asp-page="/Cases/Index" asp-route-tab="triage">
                    <span class="wc-queue-label">@Labels.Triages</span>
                    <strong class="wc-queue-val">@metrics.Triages</strong>
                </a>
            </nav>
        }
    </section>
    <section class="panel wc-stat-card" aria-label="@Labels.Activity" data-wc-activity data-wc-refresh-section="activity" data-wc-refresh-state="@activityState">
        <div class="wc-stat-head">
            <h2 id="wc-activity-title">@Labels.Activity</h2>
            <span class="meta">@Labels.Today / @Labels.ThisWeek</span>
        </div>
        @if (Model.ActivityFailed)
        {
            <div class="notice notice--warning" role="status">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-triangle")" /></svg>
                <span>@Labels.ActivityUnavailable</span>
            </div>
        }
        else
        {
            var counts = Model.Activity!;
            <div class="wc-activity-grid">
                <div class="wc-act-cell" data-figure="new-cases">
                    <span class="wc-act-label">
                        @if (Model.ShowNewCases)
                        {
                            <a href="@Model.PageUrl(tab: IndexModel.NewCasesTab)" data-wc-goto-tab="@IndexModel.NewCasesTab">@Labels.NewCases</a>
                        }
                        else
                        {
                            @Labels.NewCases
                        }
                    </span>
                    <strong class="wc-act-today" data-figure="new-cases-today">@counts.NewCases.Today</strong>
                    <small class="wc-act-week" data-figure="new-cases-week">@Labels.ThisWeekCount(counts.NewCases.ThisWeek)</small>
                </div>
                <div class="wc-act-cell" data-figure="sent">
                    <span class="wc-act-label">@Labels.SentToEngineer</span>
                    <strong class="wc-act-today" data-figure="sent-today">@counts.SentToEngineer.Today</strong>
                    <small class="wc-act-week" data-figure="sent-week">@Labels.ThisWeekCount(counts.SentToEngineer.ThisWeek)</small>
                </div>
                <div class="wc-act-cell" data-figure="reports">
                    <span class="wc-act-label">@Labels.ReportsSent</span>
                    <strong class="wc-act-today" data-figure="reports-today">@counts.ReportsSent.Today</strong>
                    <small class="wc-act-week" data-figure="reports-week">@Labels.ThisWeekCount(counts.ReportsSent.ThisWeek)</small>
                </div>
                <div class="wc-act-cell" data-figure="emails">
                    <span class="wc-act-label">@Labels.EmailsReceived</span>
                    <strong class="wc-act-today" data-figure="emails-today">@counts.EmailsReceived.Today</strong>
                    <small class="wc-act-week" data-figure="emails-week">@Labels.ThisWeekCount(counts.EmailsReceived.ThisWeek)</small>
                </div>
            </div>
        }
    </section>
</div>

@if (Model.NothingToShow)
{
    <p class="wc-nothing" role="status" data-wc-nothing>@Labels.NoWorkToShow</p>
}

@* One panel, three sections behind tabs (v30 WD). A tab is omitted when its
   section is empty (WG) and kept, with a dash, when the section could not be
   read. Every tabpanel is rendered, so the background refresh can pair the
   sections by name; the inactive and omitted ones are hidden. Every section
   is a table whose rows end the same way (v32 A, item B): the next action,
   then one icon-only Dismiss named for the row's record. *@
<section class="panel wc-ledger" hidden="@Model.NothingToShow">
    <div class="wc-panel-head">
        <div class="tabs wc-tabs" role="tablist" aria-label="@Labels.Sections">
            @foreach (var tab in visibleTabs)
            {
                var current = tab == Model.Tab;
                <a class="tab" role="tab" id="wc-tab-@tab" href="@Model.PageUrl(tab: tab)" data-wc-tab-link="@tab"
                   aria-selected="@(current ? "true" : "false")" aria-controls="wc-panel-@tab" tabindex="@(current ? "0" : "-1")">@IndexModel.TabLabel(tab)<span class="tab-count">@Model.TabCount(tab)</span></a>
            }
        </div>
        <form method="get" action="/" class="wc-search" role="search">
            <input type="hidden" name="scope" value="@IndexModel.ScopeSlug(Model.Scope)" />
            @foreach (var kind in Model.Kinds)
            {
                <input type="hidden" name="kind" value="@NeedsAttentionPresentation.KindSlug(kind)" />
            }
            @if (Model.Tab != IndexModel.NewCasesTab)
            {
                <input type="hidden" name="tab" value="@Model.Tab" />
            }
            @if (IndexModel.ArrivalSlug(Model.Arrival) is { } searchArrival)
            {
                <input type="hidden" name="arrival" value="@searchArrival" />
            }
            @if (IndexModel.SystemFilterSlug(Model.SystemFilter) is { } searchSys)
            {
                <input type="hidden" name="sys" value="@searchSys" />
            }
            @if (IndexModel.AiFilterSlug(Model.AiFilter) is { } searchAi)
            {
                <input type="hidden" name="ai" value="@searchAi" />
            }
            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-search")" /></svg>
            <input id="wc-search" type="search" name="q" value="@Model.Search" placeholder="@Labels.FindWorkCentrePlaceholder" aria-label="@Labels.FindInWorkCentre" autocomplete="off" data-wc-search />
        </form>
    </div>

    <div role="tabpanel" id="wc-panel-attention" aria-labelledby="wc-tab-attention" data-wc-attention
         data-wc-refresh-section="attention" data-wc-refresh-state="@attentionState"
         hidden="@(Model.Tab != IndexModel.AttentionTab || !Model.ShowAttention)">
    @if (Model.AttentionFailed)
    {
        <div class="notice notice--warning" role="status">
            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-triangle")" /></svg>
            <span>@Labels.Unavailable</span>
        </div>
    }
    else
    {
        var attention = Model.Attention!;
        <div class="wc-toolbar">
            <div class="wc-toolbar-left">
                <h2 id="wc-attention-title" tabindex="-1">@Labels.NeedsAttention</h2>
                <span class="meta">@Labels.Items(attention.TotalCount)</span>
                <div class="wc-switch" role="group" aria-label="Scope">
                    @foreach (var option in new[] { NeedsAttentionScope.Office, NeedsAttentionScope.Mine })
                    {
                        <a href="@Model.PageUrl(scope: option, page: 1)" data-wc-scope-link="@IndexModel.ScopeSlug(option)"
                           aria-current="@(option == Model.Scope ? "true" : "false")">@(option == NeedsAttentionScope.Mine ? Labels.Mine : Labels.Office)</a>
                    }
                </div>
            </div>
        </div>
        <nav class="chips wc-filters" aria-label="Kinds">
            @foreach (var kind in NeedsAttentionPresentation.ChipsFor(Model.Scope))
            {
                var on = Model.Kinds.Contains(kind);
                <a class="chip @(on ? "on" : null)" href="@Model.PageUrl(kinds: Model.ToggledKinds(kind), page: 1)"
                   aria-current="@(on ? "true" : "false")" data-wc-kind="@NeedsAttentionPresentation.KindSlug(kind)">@Labels.KindChip(kind)<span class="n">@Model.KindCounts.GetValueOrDefault(kind)</span></a>
            }
            @if (Model.AttentionFiltered)
            {
                <a class="chip chip--clear" href="@Model.PageUrl(kinds: Array.Empty<NeedsAttentionKind>(), page: 1, clearSearch: true)" data-wc-clear>@Labels.ClearFilters</a>
            }
        </nav>
        @if (attention.Items.Count == 0)
        {
            <div class="wc-none" data-wc-empty>@(Model.AttentionFiltered ? Labels.NoMatches : Labels.NothingNeedsAttention)</div>
        }
        else
        {
            // The rows in display order, so each Dismiss can name the row that
            // follows it: a dismissal returns there, or to the heading (item B).
            var ordered = NeedsAttentionPresentation.Groups
                .SelectMany(group => attention.Items.Where(item => item.Priority == group))
                .ToList();
            <div class="wc-table">
                <table class="table wc-ledger-table wc-table--fold">
                    <thead>
                        <tr>
                            <th scope="col" class="wc-col-task">@Labels.NextAction</th>
                            <th scope="col" class="wc-col-record">@Labels.RecordDetail</th>
                            <th scope="col" class="wc-col-owner">@Labels.Owner</th>
                            <th scope="col" class="wc-col-due">@Labels.Due</th>
                            <th scope="col" class="wc-col-received">@Labels.Received</th>
                            <th scope="col" class="wc-col-action"><span class="sr-only">@Labels.ActionColumn</span></th>
                            <th scope="col" class="wc-col-dismiss"><span class="sr-only">@Labels.Dismiss</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var group in NeedsAttentionPresentation.Groups)
                    {
                        var rows = attention.Items.Where(item => item.Priority == group).ToArray();
                        if (rows.Length == 0)
                        {
                            // An empty due group is not drawn (WG, operator 25 September 2026).
                            continue;
                        }
                        var total = group switch
                        {
                            NeedsAttentionPriority.Overdue => attention.OverdueCount,
                            NeedsAttentionPriority.Today => attention.TodayCount,
                            _ => attention.LaterCount
                        };
                        <tr class="wc-group-row" data-wc-group="@NeedsAttentionPresentation.DueTone(group)"><td colspan="7"><h3>@Labels.Group(group, total)</h3></td></tr>
                        foreach (var item in rows)
                        {
                            var open = Model.Selected?.Id == item.Id;
                            var subject = NeedsAttentionPresentation.RowSubject(item);
                            var received = Labels.ReceivedAge(item.Received, Model.NowUtc) ?? Labels.NotRecorded;
                            var position = ordered.FindIndex(row => row.Id == item.Id);
                            var after = position >= 0 && position + 1 < ordered.Count
                                ? $"wc-row-{ordered[position + 1].Id:D}"
                                : "wc-attention-title";
                            <tr id="wc-row-@item.Id" data-wc-row="@item.Id" data-wc-row-kind="@NeedsAttentionPresentation.KindSlug(item.Kind)" data-wc-record="@item.Id" aria-selected="@(open ? "true" : "false")">
                                <td class="wc-col-task">
                                    @* The task opens its facts in place; a second click on the open row closes it. *@
                                    <a class="wc-task-link" href="@(open ? Model.PageUrl() : Model.PageUrl(selected: item.Id))"
                                       aria-expanded="@(open ? "true" : "false")" aria-controls="@(open ? $"wc-detail-{item.Id:D}" : null)">@NeedsAttentionPresentation.RowTitle(item)</a>
                                    <small>@Labels.KindChip(item.Kind)</small>
                                    <span class="wc-fold">@NeedsAttentionPresentation.OwnerLabel(item) · @received</span>
                                </td>
                                <td class="wc-col-record">
                                    <span class="mono">
                                        @if (!string.IsNullOrWhiteSpace(item.RecordRoute))
                                        {
                                            <a href="@item.RecordRoute">@NeedsAttentionPresentation.ReferenceLabel(item)</a>
                                        }
                                        else
                                        {
                                            @NeedsAttentionPresentation.ReferenceLabel(item)
                                        }
                                    </span>
                                    @if (subject is not null)
                                    {
                                        <small>@subject</small>
                                    }
                                </td>
                                <td class="wc-col-owner">@NeedsAttentionPresentation.OwnerLabel(item)</td>
                                <td class="wc-col-due"><span class="wc-due wc-due--@NeedsAttentionPresentation.DueTone(item.Priority)">@Labels.DueText(item.Due, Model.NowUtc)</span></td>
                                <td class="wc-col-received">@received</td>
                                <td class="wc-col-action">
                                    @* The next action in the row (v32 item M). Assign Engineer opens the
                                       dialog in place when the row is open and the dialog is on the page;
                                       otherwise the address opens the row with the dialog. Take beside it
                                       assigns the Case to the signed-in person in one step (v41 W8). *@
                                    @if (item.Kind == NeedsAttentionKind.Query)
                                    {
                                        <div class="wc-row-actions">
                                            <a class="btn btn--small" href="@item.Route">
                                                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-right")" /></svg>
                                                <span>@Labels.OpenQuery</span>
                                            </a>
                                            @if (item.OwnerStaffId is null && Model.ViewerStaffId is not null)
                                            {
                                                <form method="post" asp-page="/Index" asp-page-handler="TakeQuery" data-wc-take>
                                                    <input type="hidden" name="queryId" value="@item.Id" />
                                                    <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                    <button type="submit" class="btn btn--primary btn--small" data-busy-label="@OperatorLabels.Busy.Assigning">@Labels.Take</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                    else if (item.Kind == NeedsAttentionKind.UnassignedEngineer)
                                    {
                                        <div class="wc-row-actions">
                                            <a class="btn btn--small" href="@Model.PageUrl(selected: item.Id, assign: true)" data-wc-dialog="wc-assign-dialog">
                                                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-right")" /></svg>
                                                <span>@Labels.AssignEngineer</span>
                                            </a>
                                            @if (Model.ViewerStaffId is { } rowViewer)
                                            {
                                                <form method="post" asp-page="/Index" asp-page-handler="AssignEngineer" data-wc-take>
                                                    <input type="hidden" name="caseId" value="@item.Id" />
                                                    <input type="hidden" name="engineerId" value="@rowViewer" />
                                                    <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                    <button type="submit" class="btn btn--primary btn--small" data-busy-label="@OperatorLabels.Busy.Assigning">@Labels.Take</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.Route))
                                    {
                                        <a class="btn btn--small" href="@item.Route">
                                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-right")" /></svg>
                                            <span>@NeedsAttentionPresentation.ActionLabel(item)</span>
                                        </a>
                                    }
                                </td>
                                <td class="wc-col-dismiss">
                                    <form method="post" asp-page="/Index" asp-page-handler="Dismiss" class="wc-dismiss" data-wc-dismiss>
                                        <input type="hidden" name="recordId" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@Model.PageUrl(fragment: after)" />
                                        <button type="submit" class="btn btn--small btn--icon" aria-label="@Labels.DismissRow(NeedsAttentionPresentation.ReferenceLabel(item))" title="@Labels.DismissRow(NeedsAttentionPresentation.ReferenceLabel(item))" data-busy-label="@OperatorLabels.Busy.Dismissing">
                                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            if (open)
                            {
                                <tr class="wc-inline-detail" id="wc-detail-@item.Id" data-wc-detail>
                                    <td colspan="7">
                                        <div class="wc-context">
                                            <div class="wc-context-kind">
                                                <span class="eyebrow">@Labels.KindChip(item.Kind)</span>
                                                @if (item.Priority == NeedsAttentionPriority.Overdue)
                                                {
                                                    <span class="status status--red">@Labels.DueText(item.Due, Model.NowUtc)</span>
                                                }
                                                else if (item.Priority == NeedsAttentionPriority.Today)
                                                {
                                                    <span class="status status--amber">@Labels.DueText(item.Due, Model.NowUtc)</span>
                                                }
                                            </div>
                                            <h3>@NeedsAttentionPresentation.RowTitle(item)</h3>
                                            <dl class="fact-grid wc-facts">
                                                @foreach (var fact in NeedsAttentionPresentation.Facts(item, Model.NowUtc))
                                                {
                                                    <div class="fact">
                                                        <dt>@fact.Label</dt>
                                                        <dd class="@(fact.Mono ? "mono" : null)">@(string.IsNullOrWhiteSpace(fact.Value) ? Labels.NotRecorded : fact.Value)</dd>
                                                    </div>
                                                }
                                            </dl>
                                            @* The open row's action. The row's own Dismiss is the one;
                                               it is not repeated here (v32 item B). *@
                                            <div class="wc-context-actions" data-wc-actions>
                                                @if (item.Kind == NeedsAttentionKind.UnassignedEngineer && Model.Assignment is not null)
                                                {
                                                    <a class="btn btn--dark" href="@Model.PageUrl(selected: item.Id, assign: true)" data-wc-dialog="wc-assign-dialog">
                                                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-right")" /></svg>
                                                        <span>@Labels.AssignEngineer</span>
                                                    </a>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(item.Route))
                                                {
                                                    <a class="btn btn--dark" href="@item.Route">
                                                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-right")" /></svg>
                                                        <span>@NeedsAttentionPresentation.ActionLabel(item)</span>
                                                    </a>
                                                }
                                                @if (item.Kind == NeedsAttentionKind.Query && item.OwnerStaffId is null && Model.ViewerStaffId is not null)
                                                {
                                                    <form method="post" asp-page="/Index" asp-page-handler="TakeQuery" data-wc-take>
                                                        <input type="hidden" name="queryId" value="@item.Id" />
                                                        <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                        <button type="submit" class="btn btn--primary btn--small" data-busy-label="@OperatorLabels.Busy.Assigning">@Labels.Take</button>
                                                    </form>
                                                }
                                                @if (item.Kind == NeedsAttentionKind.UnassignedEngineer && Model.ViewerStaffId is { } openViewer)
                                                {
                                                    <form method="post" asp-page="/Index" asp-page-handler="AssignEngineer" data-wc-take>
                                                        <input type="hidden" name="caseId" value="@item.Id" />
                                                        <input type="hidden" name="engineerId" value="@openViewer" />
                                                        <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                        <button type="submit" class="btn btn--primary btn--small" data-busy-label="@OperatorLabels.Busy.Assigning">@Labels.Take</button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                    </tbody>
                </table>
            </div>
        }
        <div class="pagination" data-wc-paging>
            <span>@Labels.AttentionPaging(attention.Page, attention.TotalPages)</span>
            <div class="button-row">
                @if (attention.Page > 1)
                {
                    <a class="btn btn--small" href="@Model.PageUrl(page: attention.Page - 1)">@Labels.Previous</a>
                }
                @if (attention.Page < attention.TotalPages)
                {
                    <a class="btn btn--small" href="@Model.PageUrl(page: attention.Page + 1)">@Labels.Next</a>
                }
            </div>
        </div>
        @* The assignment forms belong to attention: if that independently loaded
           section is retained after a failed refresh, its dialog remains intact. *@
        @if (Model.Assignment is { } assignment)
        {
            var openOnLoad = Model.OpenAssignment ? Html.Raw(" data-dialog-open-on-load=\"true\"") : Html.Raw(" hidden");
            <div id="wc-assign-dialog" class="dialog-backdrop" data-dialog="wc-assign-dialog" @openOnLoad>
                <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="wc-assign-title">
                    <div class="dialog-head">
                        <h2 id="wc-assign-title" tabindex="-1">@Labels.AssignEngineer · @assignment.Reference</h2>
                        <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                        </button>
                    </div>
                    <div class="dialog-body stack">
                        <dl class="fact-grid">
                            <div class="fact"><dt>Registration</dt><dd class="mono">@(assignment.Registration ?? Labels.NotRecorded)</dd></div>
                            <div class="fact"><dt>Claimant</dt><dd>@(assignment.Claimant ?? Labels.NotRecorded)</dd></div>
                            <div class="fact"><dt>Principal</dt><dd>@(assignment.Principal ?? Labels.NotRecorded)</dd></div>
                            <div class="fact"><dt>@Labels.Engineer</dt><dd>@(assignment.EngineerName ?? Labels.NotRecorded)</dd></div>
                        </dl>
                        <form method="post" asp-page="/Index" asp-page-handler="AssignEngineer" id="wc-assign-form" class="stack">
                            <input type="hidden" name="caseId" value="@assignment.CaseId" />
                            <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <div class="field">
                                <label class="req" for="wc-assign-engineer">@Labels.Engineer</label>
                                <select id="wc-assign-engineer" name="engineerId" required data-dialog-initial-focus>
                                    <option value="">@Labels.ChooseEngineer</option>
                                    @foreach (var engineer in assignment.Engineers)
                                    {
                                        <option value="@engineer.Id">@Model.EngineerChoiceLabel(engineer)</option>
                                    }
                                    <option value="@AssignEngineerChoice.UnassignedValue">@OperatorLabels.CaseWorkspace.Unassigned</option>
                                </select>
                            </div>
                        </form>
                    </div>
                    <div class="dialog-foot">
                        <button type="button" class="btn" data-dialog-close>Cancel</button>
                        <button type="submit" form="wc-assign-form" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Assigning">@(assignment.EngineerName is null ? Labels.Assign : Labels.Reassign)</button>
                    </div>
                </section>
            </div>
        }
    }
    </div>

    <div role="tabpanel" id="wc-panel-new-cases" aria-labelledby="wc-tab-new-cases" data-wc-new-cases
         data-wc-refresh-section="new-cases" data-wc-refresh-state="@newCasesState"
         hidden="@(Model.Tab != IndexModel.NewCasesTab || !Model.ShowNewCases)">
        <div class="wc-subbar" role="toolbar" aria-label="@Labels.ArrivalColumn">
            <div class="chips" role="group" aria-label="@Labels.ArrivalColumn">
                <a class="chip" href="@Model.PageUrl(tab: IndexModel.NewCasesTab, clearArrival: true, newPage: 1)" aria-current="@(Model.Arrival is null ? "true" : "false")" data-wc-arrival-filter="all">@Labels.All<span class="n">@Model.NewCasesWindowCount</span></a>
                @foreach (var channel in new[] { CaseArrival.PrincipalApi, CaseArrival.Email, CaseArrival.Manual, CaseArrival.Automation })
                {
                    var count = Model.NewCases?.Page.ArrivalCounts.GetValueOrDefault(channel) ?? 0;
                    <a class="chip" href="@Model.PageUrl(tab: IndexModel.NewCasesTab, arrival: channel, newPage: 1)" aria-current="@(Model.Arrival == channel ? "true" : "false")" data-wc-arrival-filter="@IndexModel.ArrivalSlug(channel)">@Labels.Arrival(channel)<span class="n">@count</span></a>
                }
            </div>
            @if (Model.NewCases is { } channelMeta)
            {
                <span class="meta">@Labels.NewCasesMeta(channelMeta.Page.TotalCount)</span>
            }
        </div>
        <h2 id="wc-new-cases-title" class="sr-only" tabindex="-1">@Labels.NewCases</h2>
        @if (Model.NewCasesFailed)
        {
            <div class="notice notice--warning" role="status">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-triangle")" /></svg>
                <span>@Labels.NewCasesUnavailable</span>
            </div>
        }
        else
        {
            var feed = Model.NewCases!;
            var rows = feed.Page.Items;
            var divider = Model.DividerUtc;
            var anyNewer = divider is { } line && rows.Any(row => row.CreatedAtUtc > line);
            var divided = false;
            if (rows.Count == 0)
            {
                <div class="wc-none" data-wc-empty>@Labels.NoNewCases</div>
            }
            else
            {
                <div class="wc-table">
                    <table class="table wc-ledger-table wc-new-cases-table">
                        <thead>
                            <tr>
                                <th scope="col" class="wc-col-ref">@Labels.CaseColumn</th>
                                <th scope="col">@Labels.DetailColumn</th>
                                <th scope="col" class="wc-col-arrival">@Labels.ArrivalColumn</th>
                                <th scope="col" class="wc-col-time">@Labels.Received</th>
                                <th scope="col" class="wc-col-dismiss"><span class="sr-only">@Labels.Dismiss</span></th>
                            </tr>
                        </thead>
                        <tbody>
                        @for (var index = 0; index < rows.Count; index++)
                        {
                            var row = rows[index];
                            if (!divided && anyNewer && row.CreatedAtUtc <= divider)
                            {
                                divided = true;
                                <tr class="wc-group-row" data-wc-divider><td colspan="5"><h3>@Labels.SinceYouLastLooked</h3></td></tr>
                            }
                            var subParts = new[] { row.Registration, row.Claimant, row.Principal }
                                .Where(part => !string.IsNullOrWhiteSpace(part));
                            var after = index + 1 < rows.Count ? $"wc-new-{index + 1}" : "wc-new-cases-title";
                            <tr id="wc-new-@index" data-wc-new-case-row data-wc-record="@row.CaseId">
                                <td class="wc-col-ref">
                                    <a class="wc-task-link" asp-page="/Cases/Details" asp-route-id="@row.CaseId">@row.Reference</a>
                                </td>
                                <td>@string.Join(" · ", subParts)</td>
                                <td class="wc-col-arrival"><span class="status status--@Labels.ArrivalTone(row.Arrival)" data-wc-arrival>@Labels.Arrival(row.Arrival)</span></td>
                                <td class="wc-col-time"><time datetime="@row.CreatedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(row.CreatedAtUtc)</time></td>
                                <td class="wc-col-dismiss">
                                    <form method="post" asp-page="/Index" asp-page-handler="Dismiss" class="wc-dismiss" data-wc-dismiss>
                                        <input type="hidden" name="recordId" value="@row.CaseId" />
                                        <input type="hidden" name="returnUrl" value="@Model.PageUrl(selected: Model.Selected?.Id, tab: IndexModel.NewCasesTab, fragment: after)" />
                                        <button type="submit" class="btn btn--small btn--icon" aria-label="@Labels.DismissRow(row.Reference)" title="@Labels.DismissRow(row.Reference)" data-busy-label="@OperatorLabels.Busy.Dismissing">
                                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <div class="pagination">
                <span>@Labels.NewCasesPaging(feed.Page.Page, feed.Page.TotalPages)</span>
                <div class="button-row">
                    @if (feed.Page.Page > 1)
                    {
                        <a class="btn btn--small" href="@Model.PageUrl(selected: Model.Selected?.Id, newPage: feed.Page.Page - 1, tab: IndexModel.NewCasesTab)">@Labels.Previous</a>
                    }
                    @if (feed.Page.Page < feed.Page.TotalPages)
                    {
                        <a class="btn btn--small" href="@Model.PageUrl(selected: Model.Selected?.Id, newPage: feed.Page.Page + 1, tab: IndexModel.NewCasesTab)">@Labels.Next</a>
                    }
                </div>
            </div>
        }
    </div>

    <div role="tabpanel" id="wc-panel-system-actions" aria-labelledby="wc-tab-system-actions" data-wc-system-actions
         data-wc-refresh-section="system-actions" data-wc-refresh-state="@systemActionsState"
         hidden="@(Model.Tab != IndexModel.SystemActionsTab || !Model.ShowSystemActions)">
        <div class="wc-subbar" role="toolbar" aria-label="@Labels.SystemActions">
            <div class="chips" role="group" aria-label="@Labels.SystemActionColumn">
                <a class="chip" href="@Model.PageUrl(tab: IndexModel.SystemActionsTab, systemFilter: SystemActionFilter.All, sysPage: 1)" aria-current="@(Model.SystemFilter == SystemActionFilter.All ? "true" : "false")" data-wc-sys-filter="all">@Labels.All<span class="n">@Model.SystemActionsWindowCount</span></a>
                <a class="chip" href="@Model.PageUrl(tab: IndexModel.SystemActionsTab, systemFilter: SystemActionFilter.AutoMatched, sysPage: 1)" aria-current="@(Model.SystemFilter == SystemActionFilter.AutoMatched ? "true" : "false")" data-wc-sys-filter="auto-match">@Labels.AutoMatched<span class="n">@(Model.SystemActions?.KindCounts.GetValueOrDefault(SystemActionKind.AutoMatchedMail) ?? 0)</span></a>
                <a class="chip" href="@Model.PageUrl(tab: IndexModel.SystemActionsTab, systemFilter: SystemActionFilter.ImagesPaired, sysPage: 1)" aria-current="@(Model.SystemFilter == SystemActionFilter.ImagesPaired ? "true" : "false")" data-wc-sys-filter="images">@Labels.ImagesPaired<span class="n">@(Model.SystemActions?.KindCounts.GetValueOrDefault(SystemActionKind.VehicleImagesPaired) ?? 0)</span></a>
                <a class="chip" href="@Model.PageUrl(tab: IndexModel.SystemActionsTab, systemFilter: SystemActionFilter.RulesAndQueries, sysPage: 1)" aria-current="@(Model.SystemFilter == SystemActionFilter.RulesAndQueries ? "true" : "false")" data-wc-sys-filter="rules">@Labels.RulesAndQueries<span class="n">@((Model.SystemActions?.KindCounts.GetValueOrDefault(SystemActionKind.QueryOpenedAutomatically) ?? 0) + (Model.SystemActions?.KindCounts.GetValueOrDefault(SystemActionKind.CancellationMatched) ?? 0))</span></a>
            </div>
        </div>
        <h2 id="wc-system-actions-title" class="sr-only" tabindex="-1">@Labels.SystemActions</h2>
        @if (Model.SystemActionsFailed)
        {
            <div class="notice notice--warning" role="status">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-triangle")" /></svg>
                <span>@Labels.SystemActionsUnavailable</span>
            </div>
        }
        else if (Model.SystemActions!.Items.Count == 0)
        {
            <div class="wc-none" data-wc-empty>@(Model.SystemFilter != SystemActionFilter.All || Model.Search is not null ? Labels.NoMatches : Labels.NoSystemActions)</div>
        }
        else
        {
            var actions = Model.SystemActions!;
            <div class="wc-table">
                <table class="table wc-ledger-table" aria-label="@Labels.SystemActions">
                    <thead>
                        <tr>
                            <th scope="col">@Labels.SystemActionColumn</th>
                            <th scope="col">@Labels.CaseColumn</th>
                            <th scope="col">@Labels.MatchedDetailColumn</th>
                            <th scope="col">@Labels.WhenColumn</th>
                            <th scope="col"><span class="sr-only">@Labels.ActionColumn</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var index = 0; index < actions.Items.Count; index++)
                    {
                        var row = actions.Items[index];
                        var after = index + 1 < actions.Items.Count ? $"wc-sys-{index + 1}" : "wc-system-actions-title";
                        var vehicle = string.Join(" · ", new[] { row.Registration, row.VehicleMake, row.VehicleModel }.Where(part => !string.IsNullOrWhiteSpace(part)));
                        var openQuery = row.Kind == SystemActionKind.QueryOpenedAutomatically;
                        <tr id="wc-sys-@index" data-wc-system-action="@row.Kind" data-wc-record="@row.RecordId">
                            <td><span class="status">@Labels.SystemActionKindLabel(row.Kind)</span></td>
                            <td>
                                <a class="mono wc-task-link" asp-page="/Cases/Details" asp-route-id="@row.CaseId">@row.Reference</a>
                                @if (vehicle.Length > 0)
                                {
                                    <small>@vehicle</small>
                                }
                            </td>
                            <td>
                                <span>@row.Summary</span>
                                @if (!string.IsNullOrWhiteSpace(row.Signal))
                                {
                                    <small>@Labels.SignalLabel: <strong>@row.Signal</strong></small>
                                }
                            </td>
                            <td><time datetime="@row.OccurredAtUtc.ToString("O")">@OperatorLabels.OfficeTime(row.OccurredAtUtc)</time></td>
                            <td class="wc-col-action">
                                <div class="wc-row-actions">
                                    @if (openQuery)
                                    {
                                        <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@row.CaseId" asp-route-section="queries">@Labels.OpenQuery</a>
                                        @if (row.QueryUnassigned && row.QueryId is { } queryId && Model.ViewerStaffId is not null)
                                        {
                                            <form method="post" asp-page="/Index" asp-page-handler="TakeQuery" data-wc-take>
                                                <input type="hidden" name="queryId" value="@queryId" />
                                                <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                                <input type="hidden" name="returnUrl" value="@Model.PageUrl(tab: IndexModel.SystemActionsTab)" />
                                                <button type="submit" class="btn btn--primary btn--small" data-busy-label="@OperatorLabels.Busy.Assigning">@Labels.Take</button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@row.CaseId">@Labels.OpenCase</a>
                                    }
                                    <form method="post" asp-page="/Index" asp-page-handler="Dismiss" class="wc-dismiss" data-wc-dismiss>
                                        <input type="hidden" name="recordId" value="@row.RecordId" />
                                        <input type="hidden" name="returnUrl" value="@Model.PageUrl(tab: IndexModel.SystemActionsTab, fragment: after)" />
                                        <button type="submit" class="btn btn--small btn--icon" aria-label="@Labels.DismissRow(row.Reference)" title="@Labels.DismissRow(row.Reference)" data-busy-label="@OperatorLabels.Busy.Dismissing">
                                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="pagination">
                <span>@Labels.NewCasesPaging(actions.Page, actions.TotalPages)</span>
                <div class="button-row">
                    @if (actions.Page > 1)
                    {
                        <a class="btn btn--small" href="@Model.PageUrl(tab: IndexModel.SystemActionsTab, sysPage: actions.Page - 1)">@Labels.Previous</a>
                    }
                    @if (actions.Page < actions.TotalPages)
                    {
                        <a class="btn btn--small" href="@Model.PageUrl(tab: IndexModel.SystemActionsTab, sysPage: actions.Page + 1)">@Labels.Next</a>
                    }
                </div>
            </div>
        }
    </div>

    <div role="tabpanel" id="wc-panel-ai-actions" aria-labelledby="wc-tab-ai-actions" data-wc-ai-jobs
         data-wc-refresh-section="ai-actions" data-wc-refresh-state="@aiJobsState"
         hidden="@(Model.Tab != IndexModel.AiActionsTab || !Model.ShowAiJobs)">
        <div class="wc-subbar" role="toolbar" aria-label="@Labels.AiActions">
            <div class="chips" role="group" aria-label="@Labels.AiActionColumn">
                <a class="chip" href="@Model.PageUrl(tab: IndexModel.AiActionsTab, aiFilter: WorkCentreAiActionFilter.All)" aria-current="@(Model.AiFilter == WorkCentreAiActionFilter.All ? "true" : "false")" data-wc-ai-filter="all">@Labels.All<span class="n">@Model.AiJobs.Count</span></a>
                <a class="chip" href="@Model.PageUrl(tab: IndexModel.AiActionsTab, aiFilter: WorkCentreAiActionFilter.Estimate)" aria-current="@(Model.AiFilter == WorkCentreAiActionFilter.Estimate ? "true" : "false")" data-wc-ai-filter="estimate">@Labels.EstimateDone<span class="n">@Model.AiJobs.Count(row => WorkCentreAiActionPolicy.Matches(WorkCentreAiActionFilter.Estimate, row.Job))</span></a>
                <a class="chip" href="@Model.PageUrl(tab: IndexModel.AiActionsTab, aiFilter: WorkCentreAiActionFilter.QueryDraft)" aria-current="@(Model.AiFilter == WorkCentreAiActionFilter.QueryDraft ? "true" : "false")" data-wc-ai-filter="query-draft">@Labels.DraftToQuery<span class="n">@Model.AiJobs.Count(row => WorkCentreAiActionPolicy.Matches(WorkCentreAiActionFilter.QueryDraft, row.Job))</span></a>
                <a class="chip" href="@Model.PageUrl(tab: IndexModel.AiActionsTab, aiFilter: WorkCentreAiActionFilter.Failed)" aria-current="@(Model.AiFilter == WorkCentreAiActionFilter.Failed ? "true" : "false")" data-wc-ai-filter="failed">@Labels.Failed<span class="n">@Model.AiJobs.Count(row => WorkCentreAiActionPolicy.Matches(WorkCentreAiActionFilter.Failed, row.Job))</span></a>
            </div>
            @if (!Model.AiJobsUnavailable)
            {
                <span class="meta">@Labels.AiJobsMeta(Model.AiJobs.Count(row => row.Job.State == AiJobState.DraftReady), Model.AiJobs.Count(row => row.Job.State == AiJobState.Failed))</span>
            }
        </div>
        <h2 id="wc-ai-jobs-title" class="sr-only" tabindex="-1">@Labels.AiActions</h2>
        @if (Model.AiJobsUnavailable)
        {
            <div class="notice notice--warning" role="status">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-triangle")" /></svg>
                <span>@Labels.AiActionsUnavailable</span>
            </div>
        }
        else if (Model.ShownAiJobs.Count == 0)
        {
            <div class="wc-none" data-wc-empty>@(Model.AiFilter != WorkCentreAiActionFilter.All || Model.Search is not null ? Labels.NoMatches : Labels.NoAiActions)</div>
        }
        else
        {
            @* One table (v32 A): kind, state, the instruction, the record, who
               started it and when, the Taken or failure note, then the per-kind
               action (FRD-27) and Dismiss. *@
            <div class="wc-table">
                <table class="table wc-ledger-table wc-jobs-table">
                    <thead>
                        <tr>
                            <th scope="col" class="wc-col-job">@Labels.AiActionColumn</th>
                            <th scope="col" class="wc-col-record">@Labels.CaseColumn</th>
                            <th scope="col" class="wc-col-state">@Labels.StateColumn</th>
                            <th scope="col" class="wc-col-instruction">@Labels.SummaryColumn</th>
                            <th scope="col" class="wc-col-started">@Labels.WhenColumn</th>
                            <th scope="col" class="wc-col-action"><span class="sr-only">@Labels.ActionColumn</span></th>
                            <th scope="col" class="wc-col-dismiss"><span class="sr-only">@Labels.Dismiss</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var index = 0; index < Model.ShownAiJobs.Count; index++)
                    {
                        var row = Model.ShownAiJobs[index];
                        var job = row.Job;
                        var recordPage = AiJobActions.RecordPage(job.SubjectKind);
                        var after = index + 1 < Model.ShownAiJobs.Count ? $"wc-job-{Model.ShownAiJobs[index + 1].Job.JobId:D}" : "wc-ai-jobs-title";
                        var reference = NeedsAttentionPresentation.ReferenceLabel(job.SubjectReference);
                        <tr id="wc-job-@job.JobId" data-wc-job="@job.JobId" data-wc-job-state="@job.State" data-wc-record="@job.JobId">
                            <td class="wc-col-job"><strong>@Labels.AiActionLabel(job.Kind, job.State)</strong></td>
                            <td class="wc-col-record">
                                <span class="mono">
                                    @if (recordPage is not null && job.SubjectId is { } subjectId)
                                    {
                                        <a asp-page="@recordPage" asp-route-id="@subjectId">@reference</a>
                                    }
                                    else
                                    {
                                        <span>@reference</span>
                                    }
                                </span>
                            </td>
                            <td class="wc-col-state">
                                <partial name="Shared/_StatusChip" model="@OperatorLabels.AiJobs.State(job.State)"
                                         view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = OperatorLabels.AiJobs.StateToneOverride(job.State) }' />
                            </td>
                            <td class="wc-col-instruction@(job.State == AiJobState.Failed ? " wc-failed" : null)">
                                <span>@OperatorLabels.AiJobs.Instruction(job)</span>
                                @if (row.AdoptedBy is { } adoptedBy)
                                {
                                    <small>@Labels.TakenBy(adoptedBy)</small>
                                }
                                else if (job.State == AiJobState.Taken && job.LeaseExpiresAtUtc is { } takenUntil)
                                {
                                    <small>@Labels.TakenUntil(takenUntil)</small>
                                }
                                else if (job.State == AiJobState.Failed)
                                {
                                    <small>@(string.IsNullOrWhiteSpace(job.ClosureReason) ? Labels.NoReasonRecorded : job.ClosureReason)</small>
                                }
                            </td>
                            <td class="wc-col-started"><time datetime="@job.CreatedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(job.CreatedAtUtc)</time></td>
                            <td class="wc-col-action">
                                <div class="wc-row-actions wc-job-actions">
                                    @if (row.Draft is { Route: { Length: > 0 } draftRoute } draft)
                                    {
                                        <a class="btn btn--small" href="@draftRoute">@Labels.AiDraftAction(draft.Action.ToString())</a>
                                    }
                                    @if (row.CanComplete)
                                    {
                                        <form method="post" asp-page="/Index" asp-page-handler="CompleteAiJob">
                                            <input type="hidden" name="jobId" value="@job.JobId" />
                                            <input type="hidden" name="expectedVersion" value="@job.Version" />
                                            <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                            <input type="hidden" name="returnUrl" value="@Model.PageUrl(selected: Model.Selected?.Id, tab: IndexModel.AiActionsTab)" />
                                            <button type="submit" class="btn btn--small" data-busy-label="@OperatorLabels.Busy.Completing">@OperatorLabels.AiJobs.CompleteJob</button>
                                        </form>
                                    }
                                    @if (job.State == AiJobState.Failed && job.SubjectKind == AiJobSubjectKind.Case && job.SubjectId is { } failedCaseId)
                                    {
                                        <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@failedCaseId">@Labels.OpenCase</a>
                                    }
                                </div>
                            </td>
                            <td class="wc-col-dismiss">
                                <form method="post" asp-page="/Index" asp-page-handler="Dismiss" class="wc-dismiss" data-wc-dismiss>
                                    <input type="hidden" name="recordId" value="@job.JobId" />
                                    <input type="hidden" name="returnUrl" value="@Model.PageUrl(selected: Model.Selected?.Id, tab: IndexModel.AiActionsTab, fragment: after)" />
                                    <button type="submit" class="btn btn--small btn--icon" aria-label="@Labels.DismissRow(reference)" title="@Labels.DismissRow(reference)" data-busy-label="@OperatorLabels.Busy.Dismissing">
                                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
