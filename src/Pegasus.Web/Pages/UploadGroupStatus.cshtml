@page "/Upload/Group/{id:guid}"
@model Pegasus.Web.Pages.UploadGroupStatusModel
@{
    ViewData["Title"] = "Upload received";
    var groupConfirmation = Model.UploadCaseConfirmation;
    var groupReceiptVersions = Model.GroupConfirmationReceiptVersions ?? Model.OpenMemberReceiptVersions;
    if (Model.OpenGroupDecision || Model.RefreshAutomatically)
    {
        // The submission owns the decision, including while a sibling is
        // still processing; per-file outcomes render as reports only.
        ViewData["UploadOutcomeCompact"] = true;
    }
}

<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">Upload status</p>
        <h1>Upload received</h1>
    </div>
    <div class="page-actions">
        <a class="btn btn--primary" asp-page="/Upload">
            <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
            <span>@OperatorLabels.Upload.Another</span>
        </a>
    </div>
</header>

@if (TempData["UploadConfirmationError"] is string confirmationError)
{
    <div class="validation-summary" role="alert">@confirmationError</div>
}

<div class="stack">
    @if (Model.OpenGroupDecision)
    {
        @* One decision for the whole submission — never per file. *@
        <section class="panel" aria-labelledby="group-decision-title" data-refresh-hold>
            <div class="panel-head">
                <h2 id="group-decision-title">This submission</h2>
            </div>
            <div class="panel-body stack">
                @if (Model.OfferGroupRegistration)
                {
                    <form method="post" asp-page-handler="RegisterGroup" class="stack">
                        <div class="field">
                            <label for="group-registration">Vehicle registration</label>
                            <input id="group-registration"
                                   name="vehicleRegistration"
                                   type="text"
                                   maxlength="20"
                                   required
                                   autocomplete="off"
                                   spellcheck="false" />
                        </div>
                        <div class="field">
                            <label for="group-registration-reason">Reason</label>
                            <input id="group-registration-reason" name="reason" maxlength="500" required />
                        </div>
                        <div class="button-row">
                            <button type="submit" class="btn btn--primary">Create a vehicle-image case</button>
                        </div>
                    </form>
                }
                <details class="upload-attach" data-refresh-hold open="@(Model.GroupSuggestedDestinations.Count > 0 ? "open" : null)">
                    <summary class="btn">Add to an existing case</summary>
                    <form method="post"
                          asp-page-handler="AttachGroup"
                          class="upload-attach__form"
                          data-case-search
                          data-case-search-url="@Url.Page(null, "CaseSearch")">
                        <input type="hidden" name="operationId" value="@(groupConfirmation?.Input.OperationId ?? Model.UploadCaseDraft?.OperationId ?? Guid.NewGuid())" />
                        @foreach (var member in groupReceiptVersions)
                        {
                            <input type="hidden" name="receiptVersions[@member.Key]" value="@member.Value" />
                        }
                        <input type="hidden" name="caseId" value="@(groupConfirmation?.CaseId ?? Model.UploadCaseDraft?.CaseId)" data-case-search-value />
                        <input type="hidden" name="caseVersion" value="@(Model.GroupConfirmationCaseVersion ?? groupConfirmation?.Input.ExpectedCaseVersion)" data-case-search-version />
                        @if (groupConfirmation is null && Model.GroupSuggestedDestinations.Count > 0)
                        {
                            <div class="field">
                                <span class="field-label">Possible existing case@(Model.GroupSuggestedDestinations.Count == 1 ? string.Empty : "s")</span>
                                <div class="button-row">
                                    @foreach (var suggestion in Model.GroupSuggestedDestinations)
                                    {
                                        <button type="button"
                                                class="btn btn--small"
                                                data-case-search-suggestion
                                                data-case-id="@suggestion.CaseId"
                                                data-case-reference="@suggestion.Reference"
                                                data-case-version="@suggestion.Version">
                                            @suggestion.Reference
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        <div class="field">
                            <label for="group-attach-input">Case</label>
                            @if (groupConfirmation is not null)
                            {
                                <input id="group-attach-input" name="reference" type="text" value="@groupConfirmation.Reference" readonly />
                                <p class="field-hint">Confirm that every file in this submission belongs on this case.</p>
                            }
                            else
                            {
                                <input id="group-attach-input"
                                       name="reference"
                                       type="text"
                                       value="@(Model.UploadCaseDraft?.Reference ?? (Model.GroupSuggestedDestinations.Count == 1 ? Model.GroupSuggestedDestinations[0].Reference : null))"
                                       maxlength="60"
                                       required
                                       autocomplete="off"
                                       spellcheck="false"
                                       data-case-search-input />
                                <ul id="group-attach-list" class="case-search-list" hidden data-case-search-list></ul>
                            }
                        </div>
                        <div class="field">
                            <label for="group-attach-reason">Reason</label>
                            <textarea id="group-attach-reason" name="reason" maxlength="500" rows="2" required>@(groupConfirmation?.Reason ?? Model.UploadCaseDraft?.Reason)</textarea>
                        </div>
                        <div class="button-row">
                            <button type="submit" class="btn">@(groupConfirmation is null ? "Add the submission to this case" : "Confirm and add the submission")</button>
                        </div>
                    </form>
                </details>
                <div class="button-row">
                    <a class="btn btn--ghost" asp-page="/Upload">Cancel</a>
                </div>
            </div>
        </section>
    }
    <section class="panel"
             aria-labelledby="group-status-title"
             data-auto-refresh="@Model.AutomaticRefreshMilliseconds">
        <div class="panel-head">
            <h2 id="group-status-title">Files in this submission</h2>
        </div>
        <div class="panel-body">
            @if (Model.GroupRegistrationOutcome is { } groupOutcome)
            {
                @* The whole submission registered as one vehicle-image case:
                   report that once for the group rather than repeating the
                   identical outcome under every file, which then lists by name
                   alone below. *@
                <partial name="Shared/_UploadOutcome" model="@groupOutcome" />
            }
            <div class="file-list section-gap">
                @foreach (var member in Model.Group.Members)
                {
                    var memberOutcome = Model.GroupRegistrationOutcome is null
                        && Model.Outcomes.TryGetValue(member.StagedReceiptId, out var outcome)
                        ? outcome
                        : null;
                    // The group's own registration settles every member, so a
                    // member is reported once either it or the group has an
                    // outcome; until then it is still moving.
                    var reported = Model.GroupRegistrationOutcome is not null || memberOutcome is not null;
                    <div class="file-row">
                        <span>
                            @if (memberOutcome?.ThumbnailReceiptId is { } thumbnailReceiptId)
                            {
                                <a class="upload-thumb" href="/Received/@thumbnailReceiptId/Image" target="_blank">
                                    <img src="/Received/@thumbnailReceiptId/Image"
                                         loading="lazy"
                                         alt="@member.SourceFileName" />
                                </a>
                            }
                            else
                            {
                                <svg class="icon" aria-hidden="true"><use href="#icon-file" /></svg>
                            }
                        </span>
                        <span>
                            @if (reported)
                            {
                                <strong>@member.SourceFileName</strong>
                            }
                            else
                            {
                                <strong><a asp-page="/UploadStatus" asp-route-id="@member.StagedReceiptId">@member.SourceFileName</a></strong>
                            }
                            @if (memberOutcome is not null)
                            {
                                <partial name="Shared/_UploadOutcome" model="@memberOutcome" />
                                @* The existing create proposal remains a
                                   receipt-level acceptance: a submission can
                                   share one destination choice, but it cannot
                                   fabricate a group allocator or silently
                                   create Cases for every file. *@
                                @if (Model.OpenGroupDecision && memberOutcome is
                                    { Kind: UploadOutcomeKind.ReadyToCreate,
                                      PrimaryAction: { } createAction })
                                {
                                    <div class="button-row">
                                        <a class="btn btn--small" href="@createAction.Url">@createAction.Label</a>
                                    </div>
                                }
                            }
                        </span>
                        <span>
                            @* Still moving, so the queue state is the only
                               honest thing to show. *@
                            @if (!reported)
                            {
                                var memberState = Model.Statuses[member.StagedReceiptId]?.Status is { } status
                                    ? OperatorLabels.Humanise(status.ToString())
                                    : "Received";
                                <partial name="Shared/_StatusChip" model="@memberState" />
                            }
                        </span>
                    </div>
                }
            </div>
        </div>
    </section>
</div>
