@page "/PhotoCapture/{id:guid}"
@model Pegasus.Web.Pages.PhotoCapture.DetailsModel
@using Pegasus.Core.PhotoCapture
@using Labels = Pegasus.Web.Presentation.OperatorLabels.PhotoCapture
@{
    var capture = Model.Capture;
    var registration = Labels.Registration(capture.NormalizedRegistration);
    ViewData["Title"] = $"{Labels.PhotoLink} {registration}";
    var photos = Model.Photos;
    var contacts = string.Join(" · ", new[] { capture.Mobile, capture.Email }.Where(value => !string.IsNullOrWhiteSpace(value)));
}

@section Styles {
    <link rel="stylesheet" href="~/css/photo-capture.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/photo-link-send.js" asp-append-version="true"></script>
    <script src="~/js/photo-capture.js" asp-append-version="true"></script>
}

@{
    var primary = Model.PrimaryAct;
    // After the follow-up act and where the photos are, More holds the rest:
    // Resend or Log call when not the primary, Extend's lifetimes, and Cancel
    // link last after a separator; with one act it is that act's own button
    // (v50 N; R912, R913; operator, 11 November 2026; v51 D; R948).
    var moreResend = Model.OffersResend && primary != Labels.Resend;
    var moreLogCall = Model.OffersLogCall && primary != Labels.LogCall;
    var moreCount = (moreResend ? 1 : 0) + (moreLogCall ? 1 : 0) + (Model.OffersExtend ? CaptureLimits.LifetimeDays.Count : 0) + (Model.OffersCancel ? 1 : 0);
}
<header class="page-header">
    <div class="page-title">
        <p class="eyebrow"><a asp-page="/PhotoCapture/Index" asp-route-tab="@(Model.IsCaseLink ? null : Labels.StandingLinksKey)">@Labels.LinkEyebrow(Model.IsCaseLink)</a></p>
        <div class="photo-link-title">
            <h1 class="mono">@registration</h1>
            <partial name="Shared/_StatusChip" model="@Model.ChipLabel" view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = Model.ChipTone }' />
        </div>
    </div>
    <div class="page-actions">
        @if (primary == Labels.Resend)
        {
            @* Resend opens the composer (R914, R915); the wrapper marks the trigger. *@
            <span class="photo-link-resend" data-photo-link-resend>
                <a class="btn btn--primary" href="@Model.ResendHref" data-photo-link-composer>
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-send")" /></svg>
                    <span>@Labels.Resend</span>
                </a>
            </span>
        }
        else if (primary == Labels.LogCall)
        {
            <form method="post" asp-page-handler="LogCall" asp-route-id="@capture.Id">
                <input type="hidden" name="OperationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                <button type="submit" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Logging">@Labels.LogCall</button>
            </form>
        }
        @if (Model.DestinationHref is { } destinationHref)
        {
            <a class="btn" href="@destinationHref" data-photo-link-destination>
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-right")" /></svg>
                <span>@Model.DestinationLabel</span>
            </a>
        }
        @if (moreCount == 1)
        {
            @if (moreResend)
            {
                <span class="photo-link-resend" data-photo-link-resend><a class="btn" href="@Model.ResendHref" data-photo-link-composer><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-send")" /></svg><span>@Labels.Resend</span></a></span>
            }
            else if (moreLogCall)
            {
                <form method="post" asp-page-handler="LogCall" asp-route-id="@capture.Id">
                    <input type="hidden" name="OperationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                    <button type="submit" class="btn" data-busy-label="@OperatorLabels.Busy.Logging">@Labels.LogCall</button>
                </form>
            }
            else if (Model.OffersCancel)
            {
                <form method="post" asp-page-handler="Cancel" asp-route-id="@capture.Id">
                    <input type="hidden" name="OperationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                    <button type="submit" class="btn btn--danger" data-busy-label="@OperatorLabels.Busy.Revoking">@Labels.CancelLink</button>
                </form>
            }
        }
        else if (moreCount > 1)
        {
            <details class="menu" data-menu>
                <summary class="btn"><span>More</span><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-chevron-down")" /></svg></summary>
                <div class="menu-body">
                    @if (moreResend)
                    {
                        <span class="photo-link-resend" data-photo-link-resend><a class="btn" href="@Model.ResendHref" data-photo-link-composer><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-send")" /></svg><span>@Labels.Resend</span></a></span>
                    }
                    @if (moreLogCall)
                    {
                        <form method="post" asp-page-handler="LogCall" asp-route-id="@capture.Id">
                            <input type="hidden" name="OperationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                            <button type="submit" class="btn" data-busy-label="@OperatorLabels.Busy.Logging">@Labels.LogCall</button>
                        </form>
                    }
                    @if (Model.OffersExtend)
                    {
                        @if (moreResend || moreLogCall)
                        {
                            <div class="menu-sep"></div>
                        }
                        @* Extend by any of the three lifetimes (R817), one click each. *@
                        <div class="menu-label" aria-hidden="true">@Labels.Extend</div>
                        @foreach (var days in CaptureLimits.LifetimeDays)
                        {
                            <form method="post" asp-page-handler="Extend" asp-route-id="@capture.Id">
                                <input type="hidden" name="OperationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                                <input type="hidden" name="Days" value="@days" />
                                <button type="submit" class="btn" aria-label="@Labels.Extend @Labels.Days(days)" data-busy-label="@OperatorLabels.Busy.Saving">
                                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-clock")" /></svg>
                                    <span>@Labels.Days(days)</span>
                                </button>
                            </form>
                        }
                    }
                    @if (Model.OffersCancel)
                    {
                        <div class="menu-sep"></div>
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@capture.Id">
                            <input type="hidden" name="OperationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                            <button type="submit" class="btn btn--danger" data-busy-label="@OperatorLabels.Busy.Revoking">@Labels.CancelLink</button>
                        </form>
                    }
                </div>
            </details>
        }
    </div>
</header>

@if (Model.Notice is { } notice)
{
    <div class="notice notice--success" role="status">
        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-check-circle")" /></svg>
        <span>@notice</span>
    </div>
}

<partial name="/Pages/Shared/_ErrorSummary.cshtml" />

@* Main column: one Photos panel, the photographs as tiles that open the
   evidence viewer in place and the paperwork and video under them; aside:
   one 320px Summary of the link's facts, what they told us and its folded
   history (operator, 11 November 2026; v51 A to G; R948). *@
<div class="photo-link-layout">
    <div class="stack">
        <section class="panel photo-link-photos" aria-labelledby="photo-link-photos-title" data-photo-link-photos>
            <div class="panel-head">
                <h2 id="photo-link-photos-title">@(photos.Count > 0 ? Labels.Counted(Labels.Photos, photos.Count) : Labels.Photos)</h2>
                @if (Model.IsUploading && photos.Count > 0)
                {
                    <partial name="Shared/_StatusChip" model="@Labels.UploadingLive" view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = "amber" }' />
                }
                @if (photos.Count > 0)
                {
                    @* The filters work in the browser only, so without script they
                       stay hidden and every photo shows (v51 B; R948). *@
                    <div class="pc-pills" role="group" aria-label="@Labels.FilterPhotos" data-photo-filters hidden>
                        <button type="button" class="pc-pill" aria-pressed="true" data-photo-filter="all"><span>@Labels.All</span><span class="pc-pill-count">@photos.Count</span></button>
                        @foreach (var (key, label) in Labels.PhotoFilters)
                        {
                            var count = photos.Count(photo => photo.Category == key);
                            if (count > 0)
                            {
                                <button type="button" class="pc-pill" aria-pressed="false" data-photo-filter="@key"><span>@label</span><span class="pc-pill-count">@count</span></button>
                            }
                        }
                    </div>
                }
            </div>
            @if (Model.ShowsMissing)
            {
                @* One line on a Direct link, an area's stages gathered (v51 C; R948). *@
                <div class="photo-link-missing-bar" data-photo-link-missing>
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-triangle")" /></svg>
                    <p><strong>@Labels.MissingLead</strong> @Labels.MissingSummary(Model.Row.MissingItems)</p>
                </div>
            }
            @if (photos.Count == 0 && Model.Files.Count == 0)
            {
                <div class="panel-body"><p class="muted photo-link-empty">@(Model.IsLive ? Labels.NoPhotosUploadedYet : Labels.NoPhotosWereUploaded)</p></div>
            }
            else if (photos.Count > 0)
            {
                <div class="panel-body">
                    <ul class="gallery photo-link-gallery" data-evidence-set>
                        @foreach (var photo in photos)
                        {
                            <li data-photo-category="@photo.Category">
                                <a href="@photo.Href"
                                   class="gallery-item"
                                   data-evidence-item
                                   data-download-href="@photo.Href"
                                   data-media-type="@photo.MediaType"
                                   data-file-name="@photo.FileName"
                                   data-thumb="@photo.TileHref">
                                    <span class="gallery-image">
                                        <img src="@photo.TileHref" alt="@photo.Caption" loading="lazy" data-gallery-image />
                                        <span class="photo-link-tile-number" aria-hidden="true">@photo.Number</span>
                                    </span>
                                    <span class="gallery-caption"><strong title="@photo.Caption">@photo.Caption</strong></span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
            @if (Model.Files.Count > 0)
            {
                @* Paperwork and video open where staff can read them (R807). *@
                <div class="photo-link-files" data-photo-link-files>
                    <span class="section-label">@Labels.Files</span>
                    @foreach (var file in Model.Files)
                    {
                        @if (file.Href is { } fileHref)
                        {
                            <a class="photo-link-file" href="@fileHref" target="_blank" rel="noopener"><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-file-text")" /></svg><span>@file.Caption</span></a>
                        }
                        else
                        {
                            <span class="photo-link-file"><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-file-text")" /></svg><span>@file.Caption</span></span>
                        }
                    }
                </div>
            }
        </section>
    </div>

    <aside class="stack">
        <section class="panel photo-link-summary" aria-labelledby="photo-link-summary-title" data-photo-link-summary>
            <div class="panel-head"><h2 id="photo-link-summary-title">@Labels.Summary</h2></div>
            <dl class="photo-link-summary-list">
                @if (Model.IsCaseLink)
                {
                    <div>
                        <dt>@Labels.Case</dt>
                        <dd>
                            @if (capture.CaseId is { } caseId)
                            {
                                <a class="mono" asp-page="/Cases/Details" asp-route-id="@caseId">@(capture.CaseReference ?? Labels.Case)</a>
                            }
                            else
                            {
                                <span class="muted">@Labels.AwaitingInstruction</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>@Labels.Recipient</dt>
                        <dd>
                            @if (capture.CustomerName is { Length: > 0 } recipient)
                            {
                                @recipient
                            }
                            else
                            {
                                <span class="muted">@Labels.NotGiven</span>
                            }
                            @if (Model.Row.SentOnToCustomer)
                            {
                                <span class="photo-link-sub">@Labels.ForwardedToCustomer</span>
                            }
                            @if (contacts.Length > 0)
                            {
                                <span class="photo-link-sub">@contacts</span>
                            }
                        </dd>
                    </div>
                    @if (Model.Row.OrganizationName is { Length: > 0 } principal)
                    {
                        <div><dt>@OperatorLabels.Principal</dt><dd>@principal</dd></div>
                    }
                    @if (Model.Row.IssuedByName is { Length: > 0 } issuedBy)
                    {
                        <div><dt>@Labels.SentBy</dt><dd>@issuedBy</dd></div>
                    }
                    @if (capture.IncidentDate is { } incidentDate)
                    {
                        <div><dt>@Labels.Accident</dt><dd>@incidentDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                    }
                    @if (capture.IsRevoked)
                    {
                        <div><dt>@Labels.Status</dt><dd>@Labels.Cancelled</dd></div>
                    }
                    else
                    {
                        <div><dt>@Labels.Expires</dt><dd>@OperatorLabels.OfficeTime(capture.ExpiresAtUtc)</dd></div>
                    }
                    @if (Model.Chase is { } chase)
                    {
                        <div><dt>@Labels.Chase</dt><dd><strong class="photo-link-chase">@chase</strong></dd></div>
                    }
                }
                else
                {
                    <div>
                        <dt>@Labels.Destination</dt>
                        <dd>
                            @if (capture.CaseId is { } caseId)
                            {
                                <a class="mono" asp-page="/Cases/Details" asp-route-id="@caseId">@(capture.CaseReference ?? Labels.Case)</a>
                            }
                            else if (Model.Row.ImageIntakeId is { } recordId)
                            {
                                <a class="mono" href="/VehicleImages/@recordId">@(Model.Row.ImageIntakeReference ?? Labels.VehicleImages)</a>
                                <span class="muted"> · @Labels.AwaitingInstruction</span>
                            }
                            else
                            {
                                <span class="muted">@Labels.AwaitingInstruction</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>@Labels.StandingLink</dt>
                        <dd>
                            @(Model.Row.OrganizationName ?? Labels.Website)
                            <span class="photo-link-sub">@Labels.Source(capture.Origin)</span>
                        </dd>
                    </div>
                    <div>
                        <dt>@Labels.Customer</dt>
                        <dd>
                            @if (capture.CustomerName is { Length: > 0 } customer)
                            {
                                @customer
                            }
                            else
                            {
                                <span class="muted">@Labels.NotGiven</span>
                            }
                            @if (contacts.Length > 0)
                            {
                                <span class="photo-link-sub">@contacts</span>
                            }
                        </dd>
                    </div>
                    @if (capture.IncidentDate is { } incidentDate)
                    {
                        <div><dt>@Labels.Accident</dt><dd>@incidentDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                    }
                    @if (capture.LastItemAtUtc is { } receivedAt)
                    {
                        <div><dt>@Labels.Received</dt><dd>@OperatorLabels.OfficeTime(receivedAt)</dd></div>
                    }
                }
            </dl>

            <partial name="Shared/_PhotoCaptureDetails" model="capture" />

            @* Key milestones only, folded at the foot of the card (v51 G; R948). *@
            <details class="photo-link-history" data-photo-link-history>
                <summary>
                    <span>@Labels.Counted(Labels.History, Model.History.Count)</span>
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-chevron-down")" /></svg>
                </summary>
                <ol class="photo-link-history-list">
                    @foreach (var line in Model.History)
                    {
                        <li>
                            <span>@line.Label@(line.Detail is { } detail ? $" · {detail}" : null)</span>
                            <time datetime="@line.AtUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@OperatorLabels.OfficeTime(line.AtUtc)</time>
                        </li>
                    }
                </ol>
            </details>
        </section>
    </aside>
</div>

<partial name="Shared/_EvidenceViewer" />
<div class="dialog-backdrop" data-dialog="photo-link-compose" hidden></div>
