@page "/PhotoCapture"
@model Pegasus.Web.Pages.PhotoCapture.IndexModel
@using Pegasus.Core.PhotoCapture
@using Labels = Pegasus.Web.Presentation.OperatorLabels.PhotoCapture
@{
    ViewData["Title"] = Labels.Title;
    // Refreshing reruns the tab, its scope or standing link, the search and the page.
    ViewData["RefreshFields"] = new Dictionary<string, string?>
    {
        ["tab"] = Model.Direct ? null : Labels.StandingLinksKey,
        ["scope"] = Model.Direct ? Model.ScopeKey : null,
        ["link"] = Model.SelectedLink?.Link.Id.ToString("D"),
        ["q"] = Model.Query,
        ["page"] = Model.CurrentPage > 1 ? Model.CurrentPage.ToString(System.Globalization.CultureInfo.InvariantCulture) : null
    };
    if (Model.IsUnavailable)
    {
        ViewData["RefreshStatus"] = "unavailable";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/photo-capture.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/photo-link-send.js" asp-append-version="true"></script>
}

<header class="page-header">
    <div class="page-title">
        <h1>@Labels.Title</h1>
    </div>
    <div class="page-actions">
        <partial name="Shared/_FreshnessBanner" model="Model.LoadedAtUtc" />
    </div>
</header>

@if (Model.Notice is { } notice)
{
    <div class="notice notice--success" role="status">
        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-check-circle")" /></svg>
        <span>@notice</span>
    </div>
}

@* The two kinds of link (v51 N; R948): Direct links, sent for a Case, counted
   by those Awaiting; Standing links, counted by the links themselves. Each tab
   is its own server-rendered address, so the tabs are a nav of links. *@
<nav class="tabs photo-capture-tabs" aria-label="@Labels.Title">
    <a class="tab" href="@Model.Href(direct: true, keepLink: false)" aria-current="@(Model.Direct ? "page" : null)">
        <span>@Labels.DirectLinks</span>
        @if (Model.AwaitingCount is { } awaiting)
        {
            <span class="tab-count">@awaiting</span>
        }
    </a>
    <a class="tab" href="@Model.Href(direct: false, keepLink: false)" aria-current="@(Model.Direct ? null : "page")">
        <span>@Labels.StandingLinks</span>
        @if (!Model.IsUnavailable)
        {
            <span class="tab-count">@Model.StandingLinks.Count</span>
        }
    </a>
</nav>

@if (!Model.IsUnavailable && Model.Direct)
{
    <section class="panel pc-direct" data-photo-capture-tab="direct">
        @* Workflow scopes and the search on one toolbar (v51 N; R948): the scopes
           are one GET form whose buttons carry scope=, keeping the search. *@
        <div class="pc-toolbar">
            <form method="get" action="/PhotoCapture" class="pc-pills" role="group" aria-label="@Labels.FilterDirectLinks">
                @if (Model.Query is { } scopeQuery)
                {
                    <input type="hidden" name="q" value="@scopeQuery" />
                }
                @foreach (var scope in Enum.GetValues<PhotoCaptureScope>())
                {
                    <button type="submit" name="scope" value="@Labels.ScopeKey(scope)" class="pc-pill" aria-pressed="@(Model.Scope == scope ? "true" : "false")">
                        <span>@Labels.Scope(scope)</span>
                        <span class="pc-pill-count">@Model.Counts.GetValueOrDefault(scope)</span>
                    </button>
                }
            </form>
            <form method="get" action="/PhotoCapture" class="pc-search-form" data-auto-submit role="search">
                @if (Model.ScopeKey is { Length: > 0 } scopeKey)
                {
                    <input type="hidden" name="scope" value="@scopeKey" />
                }
                <label class="sr-only" for="photo-capture-search">@Labels.Search</label>
                <input id="photo-capture-search" name="q" type="search" value="@Model.Query" maxlength="100" placeholder="@Labels.DirectSearchPlaceholder" />
                <noscript><button type="submit" class="btn btn--small">@Labels.Apply</button></noscript>
                @if (Model.Query is not null)
                {
                    <a class="btn btn--small" href="@Model.Href(keepQuery: false)" data-photo-capture-clear>@Labels.Clear</a>
                }
            </form>
        </div>
        @* One-line rows: the act the row's state calls for is its one button, and
           Cancel link and Extend stay on the link's page and the Case (v51 N). *@
        <div class="photo-capture-table" data-row-list>
            @if (Model.Rows.Count == 0)
            {
                <div class="photo-capture-empty">@(Model.TotalCount == 0 && Model.Counts.GetValueOrDefault(PhotoCaptureScope.All) == 0 ? Labels.NoDirectLinksYet : Labels.NoDirectLinksMatch)</div>
            }
            else
            {
                <table class="table pc-oneline photo-capture-rows">
                    <thead>
                        <tr>
                            <th scope="col">@Labels.Vehicle</th>
                            <th scope="col">@Labels.Case</th>
                            <th scope="col" class="hide-s">@Labels.Recipient</th>
                            <th scope="col">@Labels.Status</th>
                            <th scope="col">@Labels.Photos</th>
                            <th scope="col" class="hide-l">@Labels.Sent</th>
                            <th scope="col"><span class="sr-only">@Labels.Action</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var capture = row.Capture;
                            // Resend while the link is live and a reminder is due or it is
                            // still waiting for photos; Log call when it needs a call (R912).
                            var resend = row.IsLive && (row.Due is not null
                                || row.State is PhotoCaptureState.SentNotOpened or PhotoCaptureState.Opened or PhotoCaptureState.SomethingMissing);
                            var logCall = !resend && row.State == PhotoCaptureState.NeedsCall;
                            var chase = row.IsLive ? Labels.ChaseCue(row.Due, capture.ReminderCount) : null;
                            var missing = row.Source.MissingItems.Count > 0 && row.State is PhotoCaptureState.SomethingMissing or PhotoCaptureState.PhotosComingIn
                                ? string.Join(" · ", row.Source.MissingItems)
                                : null;
                            <tr data-photo-capture-row="@capture.Id">
                                <td class="mono nowrap">
                                    <span class="pc-veh-cell">
                                        <a class="table-row-link" asp-page="/PhotoCapture/Details" asp-route-id="@capture.Id">@Labels.Registration(capture.NormalizedRegistration)</a>
                                        <partial name="/Pages/PhotoCapture/_PreviewStrip.cshtml" model="@((Model, row.Source.Preview))" />
                                    </span>
                                </td>
                                <td class="nowrap">
                                    @if (capture.CaseId is { } caseId)
                                    {
                                        <a class="mono" asp-page="/Cases/Details" asp-route-id="@caseId">@capture.CaseReference</a>
                                    }
                                    @if (row.Source.OrganizationName is { Length: > 0 } principal)
                                    {
                                        <small class="muted photo-capture-sub photo-capture-clip hide-m" title="@principal">@principal</small>
                                    }
                                </td>
                                <td class="hide-s">
                                    @if (capture.CustomerName is { Length: > 0 } customer)
                                    {
                                        <span class="photo-capture-clip" title="@customer">@customer</span>
                                    }
                                    else
                                    {
                                        <span class="muted">@Labels.NotGiven</span>
                                    }
                                    @if (row.Source.SentOnToCustomer)
                                    {
                                        @* A quick link its firm sent on to their customer (R798). *@
                                        <small class="muted photo-capture-sub">@Labels.ForwardedToCustomer</small>
                                    }
                                    else if (capture.Mobile is { Length: > 0 } mobile)
                                    {
                                        <small class="muted photo-capture-sub">@mobile</small>
                                    }
                                </td>
                                <td>
                                    <partial name="Shared/_StatusChip" model="@Labels.State(row.State)" view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = Labels.StateTone(row.State) }' />
                                    @if (chase is not null)
                                    {
                                        <span class="pc-due-sub">@chase</span>
                                    }
                                </td>
                                <td>
                                    @if (row.Source.Photographs > 0)
                                    {
                                        <span>@Labels.PhotoCount(row.Source.Photographs, row.State == PhotoCaptureState.Complete)</span>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                    @if (missing is not null)
                                    {
                                        <small class="muted photo-capture-sub photo-capture-clip hide-s" title="@missing">@missing</small>
                                    }
                                </td>
                                <td class="nowrap hide-l">@OperatorLabels.OfficeTime(capture.SentAtUtc ?? capture.CreatedAtUtc)</td>
                                <td class="row-actions">
                                    @if (resend)
                                    {
                                        <a class="btn btn--small" href="@Pegasus.Web.Pages.PhotoCapture.IndexModel.ResendHref(capture.Id, Model.Href())" data-photo-link-composer>@Labels.Resend</a>
                                    }
                                    else if (logCall)
                                    {
                                        @* Log call returns to this list with its notice (v50 P). *@
                                        <form method="post" asp-page="/PhotoCapture/Details" asp-page-handler="LogCall" asp-route-id="@capture.Id">
                                            <input type="hidden" name="OperationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                                            <input type="hidden" name="returnUrl" value="@Model.Href()" />
                                            <button type="submit" class="btn btn--small" data-busy-label="@OperatorLabels.Busy.Logging">@Labels.LogCall</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <partial name="/Pages/PhotoCapture/_ListPages.cshtml" model="Model" />
    </section>
}
else if (!Model.IsUnavailable)
{
    var selected = Model.SelectedLink;
    <section class="pc-standing-layout" data-photo-capture-tab="@Labels.StandingLinksKey">
        @* The directory of standing and website links (v51 P; R948): every member
           of staff may copy one or show its QR code; Defaults and Manage lead
           Administrators to where links are changed. *@
        <aside class="panel pc-directory">
            <div class="panel-head">
                <h2>@Labels.StandingLinks</h2>
                @if (Model.ManagesLinks)
                {
                    <a class="btn btn--small" asp-page="/Administration/PhotoLinks">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-settings")" /></svg>
                        <span>@Labels.Defaults</span>
                    </a>
                }
            </div>
            @if (Model.StandingLinks.Count == 0)
            {
                <div class="photo-capture-empty">@Labels.NoStandingLinks</div>
            }
            else
            {
                <ul class="pc-partner-list">
                    <li class="pc-partner-item@(selected is null ? " is-selected" : null)">
                        <a class="pc-partner-select" href="@Model.Href(keepLink: false)" aria-current="@(selected is null ? "true" : null)">
                            <span class="pc-partner-name">@Labels.AllSubmissions</span>
                            <span class="pc-partner-meta">@Labels.AcrossActiveLinks(Model.StandingLinks.Count(link => link.Link.StartsCaptures))</span>
                        </a>
                        <span class="pc-partner-count">@Model.StandingSubmissions</span>
                    </li>
                    @foreach (var standing in Model.StandingLinks)
                    {
                        var link = standing.Link;
                        var name = Labels.StandingLinkName(link);
                        var isSelected = selected?.Link.Id == link.Id;
                        <li class="pc-partner-item@(isSelected ? " is-selected" : null)">
                            <a class="pc-partner-select" href="@Model.Href(link: link.Id)" aria-current="@(isSelected ? "true" : null)">
                                <span class="pc-partner-name" title="@name">@name</span>
                                <span class="pc-partner-meta">
                                    <span>@Labels.StandingLinkKind(link)</span>
                                    @if (!link.ContactActive)
                                    {
                                        <span>· <strong>@Labels.ContactInactive</strong></span>
                                    }
                                    else if (!link.IsActive)
                                    {
                                        <span>· <strong>@Labels.Paused</strong></span>
                                    }
                                </span>
                            </a>
                            <span class="pc-partner-count">@standing.Listing.Submissions</span>
                            @if (standing.Url is { } url)
                            {
                                <span class="pc-partner-tools">
                                    <code id="standing-link-url-@link.Id" hidden>@url</code>
                                    <button type="button" class="pc-icon-btn" data-copy-target="standing-link-url-@link.Id" data-copy-quiet title="@Labels.CopyLink" aria-label="@Labels.CopyLinkFor(name)" hidden>
                                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-copy")" /></svg>
                                    </button>
                                    <button type="button" class="pc-icon-btn" data-dialog-open="standing-qr-@link.Id" title="@Labels.QrCode" aria-label="@Labels.QrCodeFor(name)">
                                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-layout-grid")" /></svg>
                                    </button>
                                </span>
                            }
                        </li>
                    }
                </ul>
            }
        </aside>

        <div class="panel pc-submissions">
            <div class="pc-toolbar">
                <div><strong>@(selected is null ? Labels.RecentSubmissions : Labels.StandingLinkName(selected.Link))</strong> <span class="muted">· @Labels.ReceivedCount(Model.TotalCount)</span></div>
                <form method="get" action="/PhotoCapture" class="pc-search-form" data-auto-submit role="search">
                    <input type="hidden" name="tab" value="@Labels.StandingLinksKey" />
                    @if (selected is not null)
                    {
                        <input type="hidden" name="link" value="@selected.Link.Id" />
                    }
                    <label class="sr-only" for="photo-capture-search">@Labels.Search</label>
                    <input id="photo-capture-search" name="q" type="search" value="@Model.Query" maxlength="100" placeholder="@Labels.StandingSearchPlaceholder" />
                    <noscript><button type="submit" class="btn btn--small">@Labels.Apply</button></noscript>
                    @if (Model.Query is not null)
                    {
                        <a class="btn btn--small" href="@Model.Href(keepQuery: false)" data-photo-capture-clear>@Labels.Clear</a>
                    }
                </form>
            </div>
            @if (selected is not null)
            {
                var link = selected.Link;
                var name = Labels.StandingLinkName(link);
                var chip = !link.ContactActive ? Labels.ContactInactive : link.IsActive ? Labels.Active : Labels.Paused;
                <div class="pc-partner-bar">
                    <partial name="Shared/_StatusChip" model="@chip" view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = link.StartsCaptures ? "green" : "amber" }' />
                    @if (selected.Url is { } url)
                    {
                        <code id="selected-standing-link-url">@url</code>
                    }
                    <span class="muted">@Labels.StandingLinkDefaults(link)</span>
                    <span class="pc-partner-bar-end">
                        @if (selected.Url is not null)
                        {
                            <button type="button" class="btn btn--small" data-copy-target="selected-standing-link-url" hidden>
                                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-copy")" /></svg>
                                <span data-copy-label>@Labels.CopyLink</span>
                            </button>
                            <button type="button" class="btn btn--small" data-dialog-open="standing-qr-@link.Id">
                                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-layout-grid")" /></svg>
                                <span>@Labels.QrCode</span>
                            </button>
                        }
                        @if (Model.ManagesLinks)
                        {
                            @if (link.Kind == StandingPhotoLinkKind.Website)
                            {
                                <a class="btn btn--small" asp-page="/Administration/PhotoLinks">
                                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-settings")" /></svg>
                                    <span>@Labels.Manage</span>
                                </a>
                            }
                            else if (link.OrganizationId is { } organizationId)
                            {
                                <a class="btn btn--small" asp-page="/Administration/Contacts/Edit" asp-route-id="@organizationId" asp-route-tab="@Pegasus.Web.Pages.Administration.Contacts.EditModel.PhotoLinksTab">
                                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-settings")" /></svg>
                                    <span>@Labels.Manage</span>
                                </a>
                            }
                        }
                    </span>
                </div>
            }
            @* No Ask for it and no Match to a case (v51 Q, R; R948): a submission
               shows Uploading until it settles, and its Destination is the Case
               or the Vehicle images record Pegasus already made for it. *@
            <div class="photo-capture-table" data-row-list>
                @if (Model.Rows.Count == 0)
                {
                    <div class="photo-capture-empty">@(selected is null ? Labels.NoStandingSubmissionsYet : Labels.NoSubmissionsVia(Labels.StandingLinkName(selected.Link)))</div>
                }
                else
                {
                    <table class="table pc-oneline pc-oneline--standing photo-capture-rows">
                        <thead>
                            <tr>
                                <th scope="col">@Labels.Vehicle</th>
                                @if (selected is null)
                                {
                                    <th scope="col" class="hide-s">@Labels.StandingLink</th>
                                }
                                <th scope="col" class="hide-m">@Labels.Customer</th>
                                <th scope="col">@Labels.Destination</th>
                                <th scope="col">@Labels.Photos</th>
                                <th scope="col" class="hide-l">@Labels.Received</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                var capture = row.Capture;
                                var from = row.Source.OrganizationName ?? (capture.Origin == PhotoCaptureOrigin.Website ? Labels.Website : null);
                                var uploading = PhotoCaptureStatus.IsUploading(capture);
                                <tr data-photo-capture-row="@capture.Id">
                                    <td class="mono nowrap">
                                        <span class="pc-veh-cell">
                                            <a class="table-row-link" asp-page="/PhotoCapture/Details" asp-route-id="@capture.Id">@Labels.Registration(capture.NormalizedRegistration)</a>
                                            <partial name="/Pages/PhotoCapture/_PreviewStrip.cshtml" model="@((Model, row.Source.Preview))" />
                                        </span>
                                    </td>
                                    @if (selected is null)
                                    {
                                        <td class="hide-s">
                                            <span class="photo-capture-clip" title="@from">@from</span>
                                            <small class="muted photo-capture-sub photo-capture-clip">@Labels.Source(capture.Origin)</small>
                                        </td>
                                    }
                                    <td class="hide-m">
                                        @if (capture.CustomerName is { Length: > 0 } customer)
                                        {
                                            <span class="photo-capture-clip" title="@customer">@customer</span>
                                        }
                                        else
                                        {
                                            <span class="muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (capture.CaseId is { } caseId)
                                        {
                                            <a class="mono" asp-page="/Cases/Details" asp-route-id="@caseId">@capture.CaseReference</a>
                                        }
                                        else if (row.Source.ImageIntakeId is { } recordId)
                                        {
                                            <a class="mono" href="/VehicleImages/@recordId">@(row.Source.ImageIntakeReference ?? Labels.AwaitingInstruction)</a>
                                            <small class="muted photo-capture-sub">@Labels.AwaitingInstruction</small>
                                        }
                                        else
                                        {
                                            <span class="muted">@Labels.AwaitingInstruction</span>
                                        }
                                    </td>
                                    <td class="nowrap">
                                        @if (uploading)
                                        {
                                            <partial name="Shared/_StatusChip" model="@Labels.Uploading" view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = "amber" }' />
                                            <span class="muted">@Labels.PhotoCount(row.Source.Photographs, complete: false)</span>
                                        }
                                        else if (row.Source.Photographs > 0)
                                        {
                                            <span>@Labels.PhotoCount(row.Source.Photographs, complete: true)</span>
                                        }
                                        else
                                        {
                                            <span class="muted">@Labels.NoPhotosYet</span>
                                        }
                                    </td>
                                    <td class="nowrap hide-l">@OperatorLabels.OfficeTime(capture.LastItemAtUtc ?? capture.CreatedAtUtc)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <partial name="/Pages/PhotoCapture/_ListPages.cshtml" model="Model" />
        </div>
    </section>

    @* One QR code dialog per link; its picture loads when the dialog first shows. *@
    @foreach (var standing in Model.StandingLinks.Where(link => link.Url is not null))
    {
        var link = standing.Link;
        var name = Labels.StandingLinkName(link);
        <div class="dialog-backdrop" data-dialog="standing-qr-@link.Id" hidden>
            <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="standing-qr-title-@link.Id">
                <div class="dialog-head">
                    <div>
                        <p class="eyebrow">@Labels.StandingLinkKind(link)</p>
                        <h2 id="standing-qr-title-@link.Id" tabindex="-1">@name</h2>
                    </div>
                    <button type="button" class="dialog-close" data-dialog-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg></button>
                </div>
                <div class="dialog-body stack">
                    <div class="pc-qr-stage">
                        <img class="pc-qr-box" src="@Url.Page("/PhotoCapture/Index", "Qr", new { id = link.Id })" alt="@Labels.QrCodeFor(name)" width="220" height="220" loading="lazy" />
                        <code id="standing-qr-url-@link.Id" class="photo-link-url">@standing.Url</code>
                    </div>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>Close</button>
                    <button type="button" class="btn" data-copy-target="standing-qr-url-@link.Id" hidden>
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-copy")" /></svg>
                        <span data-copy-label>@Labels.CopyLink</span>
                    </button>
                    <a class="btn btn--primary" href="@Url.Page("/PhotoCapture/Index", "Qr", new { id = link.Id, download = true })"
                       data-busy-download data-busy-label="@OperatorLabels.Busy.Downloading" data-busy-done="@OperatorLabels.Busy.Done.Downloaded" data-busy-download-failed="@OperatorLabels.Busy.DownloadFailed">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-download")" /></svg>
                        <span>@Labels.DownloadQr</span>
                    </a>
                </div>
            </section>
        </div>
    }
}

@* The composer every Resend opens (v51 M; R948): one backdrop, filled per link. *@
<div class="dialog-backdrop" data-dialog="photo-link-compose" hidden></div>
