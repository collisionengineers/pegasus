@page "/PhotoCapture"
@model Pegasus.Web.Pages.PhotoCapture.IndexModel
@using Pegasus.Core.PhotoCapture
@using Labels = Pegasus.Web.Presentation.OperatorLabels.PhotoCapture
@{
    ViewData["Title"] = Labels.Title;
    // Refreshing reruns the tab, its state, its filters and the page.
    ViewData["RefreshFields"] = new Dictionary<string, string?>
    {
        ["tab"] = Model.SentByUs ? Labels.LinksWeSentKey : null,
        ["state"] = Model.StateFilter,
        ["origin"] = Model.SentByUs ? null : Model.OriginFilter,
        ["q"] = Model.Query,
        ["page"] = Model.CurrentPage > 1 ? Model.CurrentPage.ToString(System.Globalization.CultureInfo.InvariantCulture) : null
    };
    if (Model.IsUnavailable)
    {
        ViewData["RefreshStatus"] = "unavailable";
    }

    var tabLabel = Model.SentByUs ? Labels.LinksWeSent : Labels.ComingIn;
    var hasFilters = Model.Origin is not null || Model.NoCaseYet || Model.Query is not null;
}

@section Styles {
    <link rel="stylesheet" href="~/css/photo-capture.css" asp-append-version="true" />
}

<header class="page-header">
    <div class="page-title">
        <h1>@Labels.Title</h1>
    </div>
    <div class="page-actions">
        <partial name="Shared/_FreshnessBanner" model="Model.LoadedAtUtc" />
    </div>
</header>

@if (Model.Notice is { } notice)
{
    <div class="notice notice--success" role="status">
        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-check-circle")" /></svg>
        <span>@notice</span>
    </div>
}

@* Each tab is its own server-rendered address (?tab=), so the tabs are a nav
   of links with aria-current, as on Logs and a Principal contact. *@
<nav class="tabs photo-capture-tabs" aria-label="@Labels.Title">
    @* Each tab carries how many captures it holds (R806). *@
    <a class="tab" href="@Model.Href(tab: Labels.ComingInKey, keepState: false)" aria-current="@(Model.SentByUs ? null : "page")">
        <span>@Labels.ComingIn</span>
        @if (Model.TabCounts is { } comingInCount)
        {
            <span class="tab-count">@comingInCount.ComingIn</span>
        }
    </a>
    <a class="tab" href="@Model.Href(tab: Labels.LinksWeSentKey, keepState: false)" aria-current="@(Model.SentByUs ? "page" : null)">
        <span>@Labels.LinksWeSent</span>
        @if (Model.TabCounts is { } sentCount)
        {
            <span class="tab-count">@sentCount.LinksWeSent</span>
        }
    </a>
</nav>

@if (!Model.IsUnavailable)
{
<section class="pane-layout queue-layout photo-capture-queue" data-photo-capture-tab="@(Model.SentByUs ? Labels.LinksWeSentKey : Labels.ComingInKey)">
    <aside class="pane">
        @* The tab's headline states with their queried counts, as the Cases
           list's scopes: one GET form whose buttons carry state=, keeping the
           tab, the From filter and the search. *@
        <form method="get" action="/PhotoCapture" class="scope-list" data-row-list>
            @if (Model.SentByUs)
            {
                <input type="hidden" name="tab" value="@Labels.LinksWeSentKey" />
            }
            else if (Model.OriginFilter is { Length: > 0 } origin)
            {
                <input type="hidden" name="origin" value="@origin" />
            }
            @if (Model.Query is { } query)
            {
                <input type="hidden" name="q" value="@query" />
            }
            <button type="submit" name="state" value="" class="scope-button" aria-pressed="@(Model.State is null ? "true" : "false")">
                <span class="scope-visual-icon">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-list")" /></svg>
                </span>
                <span>@Labels.All</span>
                @if (Model.State is null)
                {
                    <span>@Model.TotalCount</span>
                }
                else
                {
                    <span hidden></span>
                }
            </button>
            @foreach (var state in Model.CountedStates)
            {
                <button type="submit" name="state" value="@Labels.StateKey(state)" class="scope-button"
                        aria-pressed="@(Model.State == state ? "true" : "false")">
                    <span class="scope-visual-icon">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href(Labels.StateIcon(state))" /></svg>
                    </span>
                    <span>@Labels.State(state)</span>
                    <span>@Model.Counts[state]</span>
                </button>
            }
        </form>
    </aside>

    <div class="pane photo-capture-list">
        @* The tab and All carry the count, so the list's own heading is for
           assistive technology only (v50 L). *@
        <div class="pane-head">
            <h2 class="sr-only">@tabLabel</h2>
            <form method="get" action="/PhotoCapture" class="filter-bar photo-capture-filters" data-auto-submit role="search">
                @if (Model.SentByUs)
                {
                    <input type="hidden" name="tab" value="@Labels.LinksWeSentKey" />
                }
                @if (Model.StateFilter is { Length: > 0 } stateKey)
                {
                    <input type="hidden" name="state" value="@stateKey" />
                }
                @if (!Model.SentByUs)
                {
                    <div class="field">
                        <label class="sr-only" for="photo-capture-origin">@Labels.From</label>
                        <select id="photo-capture-origin" name="origin">
                            <option value="">@Labels.All</option>
                            @foreach (var origin in Labels.ComingInOrigins)
                            {
                                <option value="@Labels.OriginKey(origin)" selected="@(Model.Origin == origin ? "selected" : null)">@Labels.Source(origin)</option>
                            }
                            <option value="@Labels.NoCaseYetKey" selected="@(Model.NoCaseYet ? "selected" : null)">@Labels.NoCaseYet</option>
                        </select>
                    </div>
                }
                <div class="field">
                    <label class="sr-only" for="photo-capture-search">@Labels.Search</label>
                    <input id="photo-capture-search" name="q" type="search" value="@Model.Query" maxlength="100" placeholder="@Labels.SearchPlaceholder" />
                </div>
                <noscript><button type="submit" class="btn">@Labels.Apply</button></noscript>
                @if (hasFilters)
                {
                    <a class="btn" href="@Model.Href(keepState: true)" data-photo-capture-clear>@Labels.Clear</a>
                }
            </form>
        </div>
        @* One-line rows (v50 I to M): long text ends in an ellipsis with the full
           text on hover; narrower widths drop the columns marked --wide, --medium
           and --narrow rather than scroll (#2029). Each row leads with the act its
           state calls for; one other act is its own button, two or more go in
           More with Cancel link last (R912). *@
        <div class="photo-capture-table" data-row-list>
            @if (Model.Rows.Count == 0)
            {
                <div class="photo-capture-empty">@Labels.NothingHere</div>
            }
            else if (Model.SentByUs)
            {
                <table class="table photo-capture-rows">
                    <thead>
                        <tr>
                            <th scope="col">@Labels.Vehicle</th>
                            <th scope="col">@Labels.Customer</th>
                            <th scope="col">@Labels.Case</th>
                            <th scope="col" class="photo-capture-col--medium">@Labels.From</th>
                            <th scope="col">@Labels.Status</th>
                            <th scope="col">@Labels.Photos</th>
                            <th scope="col" class="photo-capture-col--wide">@Labels.NextReminder</th>
                            <th scope="col"><span class="sr-only">@Labels.Action</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var capture = row.Capture;
                            var photosHref = Pegasus.Web.Pages.PhotoCapture.IndexModel.PhotosHref(row.Source);
                            // The act the row's state calls for (R912): Resend while the link is
                            // live and a reminder is due or it is unopened, Log call when it needs
                            // a call, else View photos.
                            var resend = row.IsLive && (row.Due is not null || row.State is PhotoCaptureState.SentNotOpened or PhotoCaptureState.Opened);
                            var logCall = !resend && row.State == PhotoCaptureState.NeedsCall;
                            var viewPhotosFirst = !resend && !logCall && capture.AcceptedItemCount > 0 && photosHref is not null;
                            var viewPhotos = !viewPhotosFirst && capture.AcceptedItemCount > 0 && photosHref is not null;
                            var cancel = row.IsLive;
                            var missing = row.Source.MissingItems.Count > 0 && row.State is PhotoCaptureState.SomethingMissing or PhotoCaptureState.PhotosComingIn
                                ? row.Source.MissingItems[0]
                                : null;
                            <tr data-photo-capture-row="@capture.Id">
                                <td class="mono nowrap"><a class="table-row-link" asp-page="/PhotoCapture/Details" asp-route-id="@capture.Id">@Labels.Registration(capture.NormalizedRegistration)</a></td>
                                <td>
                                    @if (capture.CustomerName is { Length: > 0 } customer)
                                    {
                                        <span class="photo-capture-clip" title="@customer">@customer</span>
                                    }
                                    else
                                    {
                                        <span class="muted">@Labels.NotGiven</span>
                                    }
                                    @if (capture.Mobile is { Length: > 0 } mobile)
                                    {
                                        <small class="muted photo-capture-sub photo-capture-col--narrow">@mobile</small>
                                    }
                                </td>
                                <td class="mono nowrap">
                                    @if (capture.CaseId is { } caseId)
                                    {
                                        <a asp-page="/Cases/Details" asp-route-id="@caseId">@capture.CaseReference</a>
                                    }
                                </td>
                                <td class="photo-capture-col--medium">
                                    <span class="photo-capture-clip" title="@row.Source.OrganizationName">@row.Source.OrganizationName</span>
                                    @if (row.Source.SentOnToCustomer)
                                    {
                                        @* A quick link its firm sent on to their customer (R798). *@
                                        <small class="muted photo-capture-sub photo-capture-clip">@Labels.SentOnToTheirCustomer</small>
                                    }
                                </td>
                                <td><partial name="Shared/_StatusChip" model="@Labels.State(row.State)" view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = Labels.StateTone(row.State) }' /></td>
                                <td>
                                    @if (row.Source.Photographs > 0)
                                    {
                                        <span>@Labels.PhotoCount(row.Source.Photographs, row.State == PhotoCaptureState.Complete)</span>
                                    }
                                    @if (missing is not null)
                                    {
                                        <small class="muted photo-capture-sub photo-capture-clip photo-capture-col--narrow" title="@missing">@missing</small>
                                    }
                                </td>
                                @* Blank when nothing is due (v50 K). *@
                                <td class="photo-capture-col--wide">@row.Due?.Label</td>
                                <td class="row-actions">
                                    <span class="cluster">
                                        @if (resend)
                                        {
                                            <a class="btn btn--small" href="@Pegasus.Web.Pages.PhotoCapture.IndexModel.ResendHref(capture.Id, Model.Href())">@Labels.Resend</a>
                                        }
                                        else if (logCall)
                                        {
                                            @* Log call returns to this list with its notice (v50 P). *@
                                            <form method="post" asp-page="/PhotoCapture/Details" asp-page-handler="LogCall" asp-route-id="@capture.Id">
                                                <input type="hidden" name="OperationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                                                <input type="hidden" name="returnUrl" value="@Model.Href()" />
                                                <button type="submit" class="btn btn--small" data-busy-label="@OperatorLabels.Busy.Logging">@Labels.LogCall</button>
                                            </form>
                                        }
                                        else if (viewPhotosFirst)
                                        {
                                            <a class="btn btn--small" href="@photosHref">@Labels.ViewPhotos</a>
                                        }
                                        @if (viewPhotos && cancel)
                                        {
                                            <details class="menu" data-menu>
                                                <summary class="btn btn--small"><span class="photo-capture-more">More</span><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-chevron-down")" /></svg></summary>
                                                <div class="menu-body">
                                                    <a class="btn" href="@photosHref"><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-images")" /></svg><span>@Labels.ViewPhotos</span></a>
                                                    <div class="menu-sep"></div>
                                                    <partial name="/Pages/PhotoCapture/_CancelLinkForm.cshtml" model="@((capture.Id, Model.Href(), true))" />
                                                </div>
                                            </details>
                                        }
                                        else if (viewPhotos)
                                        {
                                            <a class="btn btn--small" href="@photosHref">@Labels.ViewPhotos</a>
                                        }
                                        else if (cancel)
                                        {
                                            <partial name="/Pages/PhotoCapture/_CancelLinkForm.cshtml" model="@((capture.Id, Model.Href(), false))" />
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table class="table photo-capture-rows">
                    <thead>
                        <tr>
                            <th scope="col">@Labels.Vehicle</th>
                            <th scope="col" class="photo-capture-col--narrow">@Labels.From</th>
                            <th scope="col" class="photo-capture-col--medium">@Labels.Customer</th>
                            <th scope="col">@Labels.Case</th>
                            <th scope="col">@Labels.Status</th>
                            <th scope="col">@Labels.Photos</th>
                            <th scope="col" class="photo-capture-col--wide">@Labels.Received</th>
                            <th scope="col"><span class="sr-only">@Labels.Action</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var capture = row.Capture;
                            var photosHref = Pegasus.Web.Pages.PhotoCapture.IndexModel.PhotosHref(row.Source);
                            var caseHow = Pegasus.Web.Pages.PhotoCapture.IndexModel.CaseHow(row.Source);
                            var from = row.Source.OrganizationName ?? (capture.Origin == PhotoCaptureOrigin.Website ? Labels.Website : null);
                            var askForIt = row.State == PhotoCaptureState.SomethingMissing && row.IsLive;
                            var photosLabel = capture.CaseId is not null ? Labels.ViewPhotos : row.Source.ImageIntakeId is not null ? Labels.MatchToACase : null;
                            var photos = photosHref is not null && photosLabel is not null;
                            var missing = row.Source.MissingItems.Count > 0 && row.State is PhotoCaptureState.SomethingMissing or PhotoCaptureState.PhotosComingIn
                                ? row.Source.MissingItems[0]
                                : null;
                            <tr data-photo-capture-row="@capture.Id">
                                <td class="mono nowrap"><a class="table-row-link" asp-page="/PhotoCapture/Details" asp-route-id="@capture.Id">@Labels.Registration(capture.NormalizedRegistration)</a></td>
                                <td class="photo-capture-col--narrow">
                                    <span class="photo-capture-clip" title="@from">@from</span>
                                    <small class="muted photo-capture-sub photo-capture-clip">@Labels.Source(capture.Origin)</small>
                                </td>
                                <td class="photo-capture-col--medium">
                                    @if (capture.CustomerName is { Length: > 0 } customer)
                                    {
                                        <span class="photo-capture-clip" title="@customer">@customer</span>
                                    }
                                    else
                                    {
                                        <span class="muted">@Labels.NotGiven</span>
                                    }
                                </td>
                                <td>
                                    @if (capture.CaseId is { } caseId)
                                    {
                                        <a class="mono" asp-page="/Cases/Details" asp-route-id="@caseId">@capture.CaseReference</a>
                                        @if (caseHow is not null)
                                        {
                                            <small class="muted photo-capture-sub photo-capture-clip">@caseHow</small>
                                        }
                                    }
                                    else if (row.Source.ImageIntakeId is { } recordId)
                                    {
                                        <a href="/VehicleImages/@recordId">@Labels.AwaitingInstruction</a>
                                        @if (row.Source.ImageIntakeReference is { } recordReference)
                                        {
                                            <small class="muted mono photo-capture-sub">@recordReference</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted">@Labels.AwaitingInstruction</span>
                                    }
                                </td>
                                <td><partial name="Shared/_StatusChip" model="@Labels.State(row.State)" view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = Labels.StateTone(row.State) }' /></td>
                                <td>
                                    <span>@Labels.PhotoCount(row.Source.Photographs, row.State == PhotoCaptureState.Complete)</span>
                                    @if (missing is not null)
                                    {
                                        <small class="muted photo-capture-sub photo-capture-clip photo-capture-col--narrow" title="@missing">@missing</small>
                                    }
                                </td>
                                <td class="nowrap photo-capture-col--wide">@OperatorLabels.OfficeTime(capture.LastItemAtUtc ?? capture.CreatedAtUtc)</td>
                                <td class="row-actions">
                                    <span class="cluster">
                                        @if (askForIt)
                                        {
                                            @* Ask for it (R806, R816): a fresh link for this capture, through the
                                               composer when it can be e-mailed or texted (R915, R920), else made to copy. *@
                                            @if (Model.CanSend(capture))
                                            {
                                                <a class="btn btn--small" href="@Pegasus.Web.Pages.PhotoCapture.IndexModel.ResendHref(capture.Id, Model.Href())">@Labels.AskForIt</a>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page="/PhotoCapture/Details" asp-page-handler="Resend" asp-route-id="@capture.Id">
                                                    <input type="hidden" name="OperationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                                                    <button type="submit" class="btn btn--small" data-busy-label="@OperatorLabels.Busy.Creating">@Labels.AskForIt</button>
                                                </form>
                                            }
                                        }
                                        @if (photos)
                                        {
                                            <a class="btn btn--small" href="@photosHref">@photosLabel</a>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <nav class="pagination" aria-label="Pages">
            <span>@OperatorLabels.CaseQueueFooter.PageLine(Model.CurrentPage, Model.HasPreviousPage || Model.HasNextPage)</span>
            <div class="button-row">
                @if (Model.HasPreviousPage)
                {
                    <a class="btn btn--small" href="@Model.Href(page: Model.CurrentPage - 1)">Previous</a>
                }
                @if (Model.HasNextPage)
                {
                    <a class="btn btn--small" href="@Model.Href(page: Model.CurrentPage + 1)">Next</a>
                }
            </div>
        </nav>
    </div>
</section>
}
