@model Pegasus.Web.Pages.PhotoCapture.PhotoLinkComposerPageModel
@using Pegasus.Core.PhotoCapture
@using Pegasus.Web.Pages.PhotoCapture
@using Pegasus.Web.Presentation
@using Labels = Pegasus.Web.Presentation.OperatorLabels.PhotoCapture
@*
    The one photo-link composer (operator, 11 November 2026; v51 L, M; R948),
    drawn by Send a photo link and Resend, on their pages and as the dialog
    ?handler=Composer answers, in the one send-e-mail dialogue (R1330): its
    Email / Text message / Link to copy switch first, then the shared From,
    To, Subject and Message for the e-mail. One channel shows at a time: the
    checked switch shows its recipient, its wording and its one button, by CSS
    without script and by photo-link-send.js with it. Every box stays in the
    form, so a link's facts (the customer's name, mobile, e-mail and accident
    date) are posted whichever channel sends; the server checks only the
    channel the button names. Nothing is sent before a button is pressed
    (R915). It is a full-page post wherever it is drawn (data-no-inplace: over
    the Case it is not one of the Case's own in-place forms). The words and
    wording are today's (R806, R808, R868, R918, R919).
*@
@{
    var send = Model as SendModel;
    var resend = Model as ResendModel;
    var channel = Model.ActiveChannel;
    var quick = send?.Mode == PhotoCaptureMode.Quick;
    // The tag helpers' own error class, for the boxes Send alone draws by name.
    string? Invalid(string key) => ViewData.ModelState[key]?.Errors.Count > 0 ? "input-validation-error" : null;

    Func<object?, object> eyebrow = @<text>
        @* The Case, its registration and its Principal (v51 L). *@
        @if (Model.EyebrowReference is { Length: > 0 } reference)
        {
            <span class="mono">@reference</span><text> · </text>
        }
        <span class="mono">@Model.EyebrowRegistration</span>
        @if (Model.EyebrowPrincipal is { Length: > 0 } principal)
        {
            <text> · @principal</text>
        }
    </text>;

    Func<object?, object> beforeFields = @<text>
        <div class="pc-channel-bar">
            <fieldset class="pc-channel-seg">
                <legend class="sr-only">@Labels.DeliveryMethod</legend>
                @if (Model.CanEmail)
                {
                    <label>
                        <input type="radio" name="Channel" value="@PhotoLinkComposerPageModel.ByEmail" checked="@(channel == PhotoLinkComposerPageModel.ByEmail)" data-dialog-initial-focus="@(channel == PhotoLinkComposerPageModel.ByEmail)" />
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-mail")" /></svg>
                        <span>@Labels.Email</span>
                    </label>
                }
                @if (Model.CanText)
                {
                    <label>
                        <input type="radio" name="Channel" value="@PhotoLinkComposerPageModel.ByText" checked="@(channel == PhotoLinkComposerPageModel.ByText)" data-dialog-initial-focus="@(channel == PhotoLinkComposerPageModel.ByText)" />
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-send")" /></svg>
                        <span>@Labels.TextMessage</span>
                    </label>
                }
                <label>
                    <input type="radio" name="Channel" value="@PhotoLinkComposerPageModel.ToCopy" checked="@(channel == PhotoLinkComposerPageModel.ToCopy)" data-dialog-initial-focus="@(channel == PhotoLinkComposerPageModel.ToCopy)" />
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-link")" /></svg>
                    <span>@Labels.LinkToCopy</span>
                </label>
            </fieldset>
            @if (send is not null)
            {
                @* Mode, its Type when Quick (R808), and Lasts on one row (v51 S2).
                   The lifetimes are the Administrators' (R817). *@
                <div class="pc-send-opts">
                    <label class="pc-send-opt">
                        <span>@Labels.ComposerMode</span>
                        <select id="photo-link-compose-mode" name="Mode" data-photo-link-mode>
                            @foreach (var mode in Enum.GetValues<PhotoCaptureMode>())
                            {
                                <option value="@mode" selected="@(send.Mode == mode)">@Labels.Mode(mode)</option>
                            }
                        </select>
                    </label>
                    @* Asked, and required, only when Quick is chosen (R808); a
                       Quick link sent without one is refused here (R868). *@
                    <fieldset class="pc-send-opt fieldset-plain" data-photo-link-type hidden="@(!quick)">
                        <label class="pc-send-opt">
                            <span>@Labels.QuickLinkType</span>
                            <select id="photo-link-compose-type" name="QuickLinkFor" class="@Invalid(nameof(SendModel.QuickLinkFor))" required="@quick">
                                <option value=""></option>
                                @foreach (var quickLinkFor in Enum.GetValues<PhotoCaptureQuickLinkFor>())
                                {
                                    <option value="@quickLinkFor" selected="@(send.QuickLinkFor == quickLinkFor)">@Labels.QuickLinkFor(quickLinkFor)</option>
                                }
                            </select>
                        </label>
                        @Html.ValidationMessage(nameof(SendModel.QuickLinkFor))
                    </fieldset>
                    <label class="pc-send-opt">
                        <span>@Labels.Lasts</span>
                        <select id="photo-link-compose-days" name="Days">
                            @foreach (var days in send.LifetimesOffered)
                            {
                                <option value="@days" selected="@(send.Days == days)">@Labels.Days(days)</option>
                            }
                        </select>
                    </label>
                </div>
            }
        </div>

        @* The link's facts: the customer's name (Send's own), the mobile a
           text goes to, and for a link to copy the accident date. The e-mail
           is the composer's To below. *@
        @if (send is not null || Model.CanText)
        {
            <div class="form-grid form-grid--2">
                @if (send is not null)
                {
                    <div class="field">
                        <label for="photo-link-compose-name">@Labels.CustomerName</label>
                        <input id="photo-link-compose-name" name="@nameof(SendModel.CustomerName)" type="text" value="@send.CustomerName" class="@Invalid(nameof(SendModel.CustomerName))" autocomplete="off" />
                        @Html.ValidationMessage(nameof(SendModel.CustomerName))
                    </div>
                }
                @if (send is not null && !Model.CanEmail)
                {
                    @* No e-mail to send, but the link still records the customer's address. *@
                    <div class="field" data-photo-link-for="@PhotoLinkComposerPageModel.ToCopy">
                        <label for="photo-link-compose-email">@Labels.Email</label>
                        <input id="photo-link-compose-email" name="@nameof(SendModel.Email)" type="email" value="@send.Email" class="@Invalid(nameof(SendModel.Email))" autocomplete="off" />
                        @Html.ValidationMessage(nameof(SendModel.Email))
                    </div>
                }
                @if (Model.CanText || send is not null)
                {
                    @* The text goes to this mobile (R918); on Send it is also the link's own. *@
                    <div class="field" data-photo-link-for="@(Model.CanText ? PhotoLinkComposerPageModel.ByText : PhotoLinkComposerPageModel.ToCopy)">
                        <label for="photo-link-compose-mobile">@Labels.Mobile</label>
                        <input id="photo-link-compose-mobile" name="@nameof(Model.Mobile)" value="@Model.Mobile" type="tel" inputmode="tel" autocomplete="off" class="@Invalid(nameof(Model.Mobile))" />
                        @Html.ValidationMessage(nameof(Model.Mobile))
                    </div>
                }
                @if (send is not null)
                {
                    <div class="field" data-photo-link-for="@PhotoLinkComposerPageModel.ToCopy">
                        <label for="photo-link-compose-accident">@Labels.AccidentDate</label>
                        <input id="photo-link-compose-accident" name="@nameof(SendModel.AccidentDate)" type="date" value="@send.AccidentDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
                    </div>
                }
            </div>
        }
    </text>;

    Func<object?, object> standardWording = @<text>
        @* The standard wording with the name, registration, Principal and
           expiry filled in; {photo link} stays until the link exists (R806). *@
        <input type="hidden" id="photo-link-compose-standard" name="@nameof(Model.StandardBody)" value="@Model.StandardBody" data-photo-link-standard />
        <p class="field-hint" data-photo-link-edited hidden="@(!Model.BodyEdited)">
            @Labels.EditedForThisOneOnly
            <button type="submit" name="Submit" value="@PhotoLinkComposerPageModel.StandardWording" class="btn btn--small" formnovalidate data-photo-link-reset data-busy-label="@OperatorLabels.Busy.Restoring">@Labels.PutTheStandardWordingBack</button>
        </p>
    </text>;

    Func<object?, object> afterMessage = @<text>
        @if (Model.CanText)
        {
            @* The Photo link (text) wording (R918, R919). *@
            <div class="field mail-compose-message" data-photo-link-for="@PhotoLinkComposerPageModel.ByText" data-photo-link-wording>
                <label for="photo-link-compose-text">@Labels.TextMessage</label>
                <textarea id="photo-link-compose-text" name="@nameof(Model.TextBody)" rows="4" data-photo-link-message>@Model.TextBody</textarea>
                @Html.ValidationMessage(nameof(Model.TextBody))
                <input type="hidden" id="photo-link-compose-standard-text" name="@nameof(Model.StandardTextBody)" value="@Model.StandardTextBody" data-photo-link-standard />
                <p class="field-hint" data-photo-link-edited hidden="@(!Model.TextBodyEdited)">
                    @Labels.EditedForThisOneOnly
                    <button type="submit" name="Submit" value="@PhotoLinkComposerPageModel.StandardTextWording" class="btn btn--small" formnovalidate data-photo-link-reset data-busy-label="@OperatorLabels.Busy.Restoring">@Labels.PutTheStandardWordingBack</button>
                </p>
            </div>
        }
        @if (send is not null)
        {
            @* The capture options sit with Link to copy (v51 L); they are the
               link's, so every channel posts them as they stand. *@
            <details class="pc-capture-options" data-photo-link-for="@PhotoLinkComposerPageModel.ToCopy">
                <summary>@Labels.CaptureOptions</summary>
                <div class="cluster">
                    <label class="choice"><input type="checkbox" id="photo-link-compose-live" name="@nameof(SendModel.LiveCameraOnly)" value="true" checked="@send.LiveCameraOnly" /> <span>@Labels.LiveCameraOnly</span></label>
                    <label class="choice"><input type="checkbox" id="photo-link-compose-originals" name="@nameof(SendModel.OriginalsInBackground)" value="true" checked="@send.OriginalsInBackground" /> <span>@Labels.FullSizeOriginals</span></label>
                </div>
            </details>
            <input type="hidden" name="@nameof(SendModel.LiveCameraOnly)" value="false" />
            <input type="hidden" name="@nameof(SendModel.OriginalsInBackground)" value="false" />
        }
    </text>;

    Func<object?, object> sendButtons = @<text>
        @if (Model.CanEmail)
        {
            <button type="submit" name="Submit" value="@PhotoLinkComposerPageModel.ByEmail" class="btn btn--primary" data-photo-link-for="@PhotoLinkComposerPageModel.ByEmail" data-busy-label="@OperatorLabels.Busy.Sending">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-send")" /></svg>
                <span>@Labels.SendByEmail</span>
            </button>
        }
        @if (Model.CanText)
        {
            <button type="submit" name="Submit" value="@PhotoLinkComposerPageModel.ByText" class="btn btn--primary" data-photo-link-for="@PhotoLinkComposerPageModel.ByText" data-busy-label="@OperatorLabels.Busy.Sending">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-send")" /></svg>
                <span>@Labels.SendByText</span>
            </button>
        }
        @* Resend's link to copy asks nothing of the form; Send's still asks for a Quick link's Type first (R868). *@
        <button type="submit" name="Submit" value="@PhotoLinkComposerPageModel.ToCopy" class="btn btn--primary" data-photo-link-for="@PhotoLinkComposerPageModel.ToCopy" formnovalidate="@(resend is not null)" data-busy-label="@OperatorLabels.Busy.Creating">
            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-link")" /></svg>
            <span>@Labels.CreateLinkToCopy</span>
        </button>
    </text>;

    var route = new Microsoft.AspNetCore.Routing.RouteValueDictionary();
    foreach (var (key, value) in Model.ComposerRoute)
    {
        route[key] = value;
    }
    // The e-mail fields show only on the Email channel; with no e-mail to
    // send they never show.
    var emailOnly = Model.CanEmail
        ? new Dictionary<string, string?> { ["data-photo-link-for"] = PhotoLinkComposerPageModel.ByEmail }
        : new Dictionary<string, string?> { ["data-photo-link-for"] = PhotoLinkComposerPageModel.ByEmail, ["hidden"] = null };
    Func<object?, object> errors = @<partial name="/Pages/Shared/_ErrorSummary.cshtml" />;
    var composer = new MailComposerView
    {
        Id = "photo-link-compose",
        InDialog = Model.InDialog,
        // Fetched into the page's own [data-dialog="photo-link-compose"] backdrop.
        OwnBackdrop = false,
        EyebrowContent = eyebrow,
        Title = Model.ComposerTitle,
        BackHref = Model.InDialog ? null : Model.BackHref,
        // Send's page says its errors above the card.
        Status = send is not null && !Model.InDialog ? null : errors,
        Action = Url.Page(Model.ComposerPage, route)!,
        FormClass = "pc-composer",
        FormAttributes = new Dictionary<string, string?> { ["data-photo-link-composer-form"] = null, ["data-no-inplace"] = null },
        Hidden =
        [
            new(nameof(Model.OperationKey), Model.OperationKey),
            new(nameof(Model.ReturnUrl), Model.ReturnUrl),
        ],
        FieldsRequired = false,
        BeforeFields = beforeFields,
        EmailFieldAttributes = emailOnly,
        FromChoices = [.. Model.Senders.Mailboxes.Select(mailbox => new MailComposerSender(mailbox.Id, mailbox.Address))],
        FromSelected = Model.FromMailboxId,
        // The e-mail goes to the link's one address, and a photo link copies
        // no one (R915); Resend goes to the link's own address.
        ToName = nameof(SendModel.Email),
        To = [send is not null ? send.Email ?? string.Empty : resend?.Capture.Email ?? string.Empty],
        ToReadOnly = resend is not null,
        CcName = null,
        OffersMoreRecipients = false,
        Subject = Model.Subject,
        BodyName = nameof(Model.Body),
        Body = Model.Body,
        BodyRows = 7,
        BodyFieldAttributes = new Dictionary<string, string?> { ["data-photo-link-wording"] = null },
        BodyAttributes = new Dictionary<string, string?> { ["data-photo-link-message"] = null },
        BodyExtra = standardWording,
        AfterMessage = afterMessage,
        SendButtons = sendButtons,
    };
}
<partial name="/Pages/Shared/_MailComposer.cshtml" model="composer" />
