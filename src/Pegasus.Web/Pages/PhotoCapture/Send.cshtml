@page "/PhotoCapture/Send/{caseId:guid}"
@model Pegasus.Web.Pages.PhotoCapture.SendModel
@using Pegasus.Core.PhotoCapture
@using Labels = Pegasus.Web.Presentation.OperatorLabels.PhotoCapture
@{
    ViewData["Title"] = Labels.SendAPhotoLink;
    var facts = Model.Facts!;
    var registration = Labels.Registration(facts.NormalizedRegistration);
    var unresolvedOperation = Model.Operation?.State is Pegasus.Core.Operations.StaffMailState.Submitted
        or Pegasus.Core.Operations.StaffMailState.Unknown;
}

@section Styles {
    <link rel="stylesheet" href="~/css/photo-capture.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/photo-link-send.js" asp-append-version="true"></script>
}

<header class="page-header">
    <div class="page-title">
        <p class="eyebrow"><a class="mono" asp-page="/Cases/Details" asp-route-id="@facts.CaseId">@facts.Reference</a></p>
        <h1>@Labels.SendAPhotoLink</h1>
    </div>
</header>

<partial name="/Pages/Shared/_ErrorSummary.cshtml" />

@if (Model.IssuedUrl is { } issuedUrl && Model.Issued is { } issued)
{
    @* The link exists only in this response: shown once to copy, then the
       link's own page carries its status, reminders and history. *@
    <section class="panel photo-link-panel" aria-labelledby="photo-link-issued-title" data-photo-link-issued>
        <div class="panel-head">
            <h2 id="photo-link-issued-title">@Labels.PhotoLink</h2>
            <a class="btn btn--small" asp-page="/PhotoCapture/Details" asp-route-id="@issued.Id">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-right")" /></svg>
                <span class="mono">@registration</span>
            </a>
        </div>
        <div class="panel-body stack">
            @if (Model.Operation is { } operation)
            {
                @if (operation.State == Pegasus.Core.Operations.StaffMailState.Sent)
                {
                    <div class="notice notice--success" role="status">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-check")" /></svg>
                        <span>@Labels.LinkSentTo(issued.CustomerName)</span>
                    </div>
                }
                else
                {
                    <p><span class="section-label">@Labels.SendStatus</span> @OperatorLabels.StaffMail.State(operation.State)</p>
                    @if (operation.State == Pegasus.Core.Operations.StaffMailState.Failed && operation.FailureCode is { Length: > 0 } failureCode)
                    {
                        <p class="field-hint">@OperatorLabels.StaffMail.Failure(failureCode)</p>
                    }
                    @if (unresolvedOperation)
                    {
                        <p class="field-hint">Confirm the provider outcome before starting another message.</p>
                    }
                }
            }
            <div class="photo-link-box">
                <code id="photo-link-issued-url" class="photo-link-url">@issuedUrl</code>
                <button type="button" class="btn btn--small" data-copy-target="photo-link-issued-url" hidden>
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-copy")" /></svg>
                    <span>@Labels.CopyLink</span>
                </button>
            </div>
        </div>
    </section>
}
else if (facts.IsClosed)
{
    @* A closed Case sends no photo link (R847); links sent before it closed keep working. *@
    <div class="notice notice--danger" role="alert">
        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-triangle")" /></svg>
        <span>@IssuePhotoLink.CaseCannotTakeALink</span>
    </div>
}
else
{
    <form method="post" asp-route-caseId="@facts.CaseId" class="photo-link-send">
        <input type="hidden" asp-for="OperationKey" />
        <div class="stack">
            <section class="panel" aria-labelledby="photo-link-who-title">
                <div class="panel-head"><h2 id="photo-link-who-title">@Labels.WhoItsFor</h2></div>
                <div class="panel-body form-grid form-grid--2">
                    <div class="field"><label for="photo-link-case">@Labels.Case</label><input id="photo-link-case" class="mono" value="@facts.Reference · @registration" readonly /></div>
                    <div class="field"><label for="photo-link-principal">@Labels.InstructedBy</label><input id="photo-link-principal" value="@facts.PrincipalName" readonly /></div>
                    <div class="field"><label asp-for="CustomerName">@Labels.CustomerName</label><input asp-for="CustomerName" autocomplete="off" /><span asp-validation-for="CustomerName"></span></div>
                    <div class="field"><label for="AccidentDate">@Labels.AccidentDate</label><input id="AccidentDate" name="AccidentDate" type="date" value="@Model.AccidentDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" /></div>
                    <div class="field"><label asp-for="Mobile">@Labels.Mobile</label><input asp-for="Mobile" type="tel" inputmode="tel" autocomplete="off" /><span asp-validation-for="Mobile"></span></div>
                    <div class="field"><label asp-for="Email">@Labels.Email</label><input asp-for="Email" type="email" autocomplete="off" /><span asp-validation-for="Email"></span></div>
                </div>
            </section>

            @if (Model.CanEmail)
            {
                <section class="panel" aria-labelledby="photo-link-how-title">
                    <div class="panel-head"><h2 id="photo-link-how-title">@Labels.HowToSendIt</h2></div>
                    <div class="panel-body stack">
                        <div class="form-grid form-grid--2">
                            <div class="field">
                                <label asp-for="FromMailboxId">@Labels.FromMailbox</label>
                                <select asp-for="FromMailboxId">
                                    <option value=""></option>
                                    @foreach (var mailbox in Model.Senders.Mailboxes)
                                    {
                                        <option value="@mailbox.Id" selected="@(Model.FromMailboxId == mailbox.Id)">@mailbox.Address</option>
                                    }
                                </select>
                                <span asp-validation-for="FromMailboxId"></span>
                            </div>
                            <div class="field"><label asp-for="Subject">@Labels.Subject</label><input asp-for="Subject" /><span asp-validation-for="Subject"></span></div>
                        </div>
                        <div class="field">
                            <label asp-for="Body">@Labels.Message</label>
                            @* The standard wording with the name, registration, Principal and expiry
                               filled in; {photo link} stays until the link exists (R806). *@
                            <textarea asp-for="Body" rows="9" data-photo-link-message></textarea>
                            <span asp-validation-for="Body"></span>
                            <input type="hidden" asp-for="StandardBody" data-photo-link-standard />
                            <p class="field-hint" data-photo-link-edited hidden="@(!Model.BodyEdited)">
                                @Labels.EditedForThisOneOnly
                                <button type="submit" name="Submit" value="@Pegasus.Web.Pages.PhotoCapture.SendModel.StandardWording" class="btn btn--small" formnovalidate data-photo-link-reset data-busy-label="@OperatorLabels.Busy.Restoring">@Labels.PutTheStandardWordingBack</button>
                            </p>
                        </div>
                    </div>
                </section>
            }
        </div>

        <div class="stack">
            <section class="panel" aria-labelledby="photo-link-settings-title">
                <div class="panel-head"><h2 id="photo-link-settings-title">@Labels.LinkSettings</h2></div>
                <div class="panel-body stack">
                    <fieldset class="field fieldset-plain">
                        <legend>@Labels.PhotoGuidance</legend>
                        <div class="cluster">
                            @foreach (var mode in Enum.GetValues<PhotoCaptureMode>())
                            {
                                <label class="choice"><input type="radio" name="Mode" value="@mode" checked="@(Model.Mode == mode)" /> <span>@Labels.Mode(mode)</span></label>
                            }
                        </div>
                    </fieldset>
                    @* Asked, and required, only when Quick is chosen (R808); photo-link-send.js follows the choice. *@
                    <fieldset class="field fieldset-plain" data-photo-link-type hidden="@(Model.Mode != PhotoCaptureMode.Quick)">
                        <legend>@Labels.QuickLinkType</legend>
                        <div class="cluster">
                            @foreach (var quickLinkFor in Enum.GetValues<PhotoCaptureQuickLinkFor>())
                            {
                                <label class="choice"><input type="radio" name="QuickLinkFor" value="@quickLinkFor" checked="@(Model.QuickLinkFor == quickLinkFor)" required="@(Model.Mode == PhotoCaptureMode.Quick)" /> <span>@Labels.QuickLinkFor(quickLinkFor)</span></label>
                            }
                        </div>
                        @* A Quick link sent without a Type is refused here (R868). *@
                        <span asp-validation-for="QuickLinkFor"></span>
                    </fieldset>
                    <label class="choice"><input asp-for="LiveCameraOnly" /> <span>@Labels.LiveCameraOnly</span></label>
                    <div class="field field--narrow">
                        <label asp-for="Days">@Labels.LinkLasts</label>
                        <select asp-for="Days">
                            @foreach (var days in Model.LifetimesOffered)
                            {
                                <option value="@days" selected="@(Model.Days == days)">@Labels.Days(days)</option>
                            }
                        </select>
                    </div>
                    <label class="choice"><input asp-for="OriginalsInBackground" /> <span>@Labels.FullSizeOriginals</span></label>
                </div>
            </section>
            <div class="button-row photo-link-send-actions">
                <a class="btn" asp-page="/Cases/Details" asp-route-id="@facts.CaseId">Cancel</a>
                <button type="submit" name="Submit" value="@Pegasus.Web.Pages.PhotoCapture.SendModel.ToCopy" class="btn" data-busy-label="@OperatorLabels.Busy.Creating">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-link")" /></svg>
                    <span>@Labels.CreateLinkToCopy</span>
                </button>
                @if (Model.CanEmail)
                {
                    <button type="submit" name="Submit" value="@Pegasus.Web.Pages.PhotoCapture.SendModel.ByEmail" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Sending">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-send")" /></svg>
                        <span>@Labels.SendByEmail</span>
                    </button>
                }
            </div>
        </div>
    </form>
}
