@page "/PhotoCapture/Send/{caseId:guid}"
@model Pegasus.Web.Pages.PhotoCapture.SendModel
@using Pegasus.Core.PhotoCapture
@using Labels = Pegasus.Web.Presentation.OperatorLabels.PhotoCapture
@{
    ViewData["Title"] = Labels.SendAPhotoLink;
    var facts = Model.Facts!;
    var registration = Labels.Registration(facts.NormalizedRegistration);
    var unresolvedOperation = Model.Operation?.State is Pegasus.Core.Operations.StaffMailState.Submitted
        or Pegasus.Core.Operations.StaffMailState.Unknown;
}

@section Styles {
    <link rel="stylesheet" href="~/css/photo-capture.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/photo-link-send.js" asp-append-version="true"></script>
}

<header class="page-header">
    <div class="page-title">
        @* The Case, its registration and its Principal, rather than read-only
           boxes (operator, 11 November 2026; v51 L; R948). *@
        <p class="eyebrow">
            <a class="mono" asp-page="/Cases/Details" asp-route-id="@facts.CaseId">@facts.Reference</a> · <span class="mono">@registration</span>
            @if (facts.PrincipalName is { Length: > 0 } principal)
            {
                <text> · @principal</text>
            }
        </p>
        <h1>@Labels.SendAPhotoLink</h1>
    </div>
</header>

<partial name="/Pages/Shared/_ErrorSummary.cshtml" />

@if (Model.IssuedUrl is { } issuedUrl && Model.Issued is { } issued)
{
    @* The link exists only in this response: shown once to copy, then the
       link's own page carries its status, reminders and history. *@
    <section class="panel photo-link-panel" aria-labelledby="photo-link-issued-title" data-photo-link-issued>
        <div class="panel-head">
            <h2 id="photo-link-issued-title">@Labels.PhotoLink</h2>
            <a class="btn btn--small" asp-page="/PhotoCapture/Details" asp-route-id="@issued.Id">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-right")" /></svg>
                <span class="mono">@registration</span>
            </a>
        </div>
        <div class="panel-body stack">
            @if (Model.TextOutcome is { } textOutcome)
            {
                @if (textOutcome.Accepted)
                {
                    <div class="notice notice--success" role="status">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-check")" /></svg>
                        <span>@Labels.LinkTextedTo(issued.CustomerName)</span>
                    </div>
                }
                else
                {
                    <p><span class="section-label">@Labels.SendStatus</span> @Labels.TextNotSent <span class="mono">@textOutcome.FailureCode</span></p>
                }
            }
            @if (Model.Operation is { } operation)
            {
                @if (operation.State == Pegasus.Core.Operations.StaffMailState.Sent)
                {
                    <div class="notice notice--success" role="status">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-check")" /></svg>
                        <span>@Labels.LinkSentTo(issued.CustomerName)</span>
                    </div>
                }
                else
                {
                    <p><span class="section-label">@Labels.SendStatus</span> @OperatorLabels.StaffMail.State(operation.State)</p>
                    @if (operation.State == Pegasus.Core.Operations.StaffMailState.Failed && operation.FailureCode is { Length: > 0 } failureCode)
                    {
                        <p class="field-hint">@OperatorLabels.StaffMail.Failure(failureCode)</p>
                    }
                    @if (unresolvedOperation)
                    {
                        <p class="field-hint">Confirm the provider outcome before starting another message.</p>
                    }
                }
            }
            <div class="photo-link-box">
                <code id="photo-link-issued-url" class="photo-link-url">@issuedUrl</code>
                <button type="button" class="btn btn--small" data-copy-target="photo-link-issued-url" hidden>
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-copy")" /></svg>
                    <span>@Labels.CopyLink</span>
                </button>
            </div>
        </div>
    </section>
}
else if (facts.IsClosed)
{
    @* A closed Case sends no photo link (R847); links sent before it closed keep working. *@
    <div class="notice notice--danger" role="alert">
        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-triangle")" /></svg>
        <span>@IssuePhotoLink.CaseCannotTakeALink</span>
    </div>
}
else
{
    @* The composer, one channel at a time (v51 L; R948): the page the Case's
       dialog falls back to without script, and answers a refusal with. *@
    <div class="panel pc-composer-page">
        <div class="panel-body">
            <partial name="_PhotoLinkComposer" model="Model" view-data="@(new ViewDataDictionary(ViewData) { ["PhotoLinkComposerOnPage"] = true })" />
        </div>
    </div>
}
