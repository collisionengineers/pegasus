@page "/Inbox/{id:guid}"
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Mail.MessageModel
@{
    var summary = Model.Detail.Summary;
    ViewData["Title"] = Pegasus.Web.Pages.Mail.IndexModel.SubjectLine(summary);
}

@* One record, one container: the way back is a return link above the heading,
   the heading is the subject alone, and the action beside it is the one thing
   worth doing from here. The sender and time were a lede repeating facts the
   Message section states properly. *@
<a class="back-link" asp-page="/Mail/Index"
   asp-route-mailbox="@Model.MailboxFilter"
   asp-route-folder="@Model.FolderRouteValue"
   asp-route-search="@Model.SearchTerm"
   asp-route-pageNumber="@Model.PageRouteValue">
    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
    Back to Inbox
</a>

<header class="page-heading">
    <h1>@Pegasus.Web.Pages.Mail.IndexModel.SubjectLine(summary)</h1>
    @if (summary.CaseId is { } headingCaseId)
    {
        <div class="page-heading-actions">
            <a class="btn btn--dark" asp-page="/Cases/Details" asp-route-id="@headingCaseId">Open case @summary.CaseReference</a>
        </div>
    }
</header>

@if (Model.OutsideListScope)
{
    <div class="status-card" role="status">
        This message is no longer in the view you opened it from. It is still here,
        in @summary.MailboxAddress.
    </div>
}

@if (Model.ClassificationNotice is { } classificationNotice)
{
    <div class="status-card" role="status">@classificationNotice</div>
}

@if (Model.FolderMoveNotice is { } folderMoveNotice)
{
    <div class="status-card" role="status">@folderMoveNotice</div>
}

@if (Model.AssociationNotice is { } associationNotice)
{
    <div class="status-card" role="status">@associationNotice</div>
}

@* The state before any action: what processing decided, and what it became.
   These are read-only findings with a source, not counts, so they are evidence
   figures rather than metric tiles. *@
<section class="panel" aria-label="Current state">
    <div class="evidence-row">
        <div class="evidence-figure">
            <span class="evidence-figure__label">Classification</span>
            <span class="evidence-figure__value">@Pegasus.Web.Pages.Mail.MessageModel.ClassificationLabel(Model.Detail.ClassificationOutcome)</span>
            <span class="evidence-figure__source">Read from the message and its attachments</span>
        </div>
        <div class="evidence-figure">
            <span class="evidence-figure__label">Queue</span>
            <span class="evidence-figure__value">@Pegasus.Web.Pages.Mail.MessageModel.QueueLabel(Model.Detail.RouteDisposition)</span>
        </div>
        <div class="evidence-figure">
            <span class="evidence-figure__label">Filed to</span>
            <span class="evidence-figure__value">
                @if (summary.CaseId is { } caseId)
                {
                    <a asp-page="/Cases/Details" asp-route-id="@caseId">@summary.CaseReference</a>
                }
                else
                {
                    <text>Not associated with a case.</text>
                }
            </span>
            <span class="evidence-figure__source">@Pegasus.Web.Pages.Mail.MessageModel.OutcomeLabel(summary) · <time datetime="@summary.ReceivedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(summary.ReceivedAtUtc)</time></span>
        </div>
    </div>
</section>

@if (Model.AssociationReceipt is { } associationReceipt)
{
    <section class="panel section-gap" aria-labelledby="case-association-heading">
        <h2 id="case-association-heading">Case association</h2>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        @if (Model.CurrentCase is { } currentCase)
        {
            <dl class="detail-list">
                <div><dt>Current Case/PO</dt><dd><a asp-page="/Cases/Details" asp-route-id="@currentCase.Summary.CaseId">@currentCase.Summary.Reference</a></dd></div>
                <div><dt>Principal</dt><dd>@currentCase.Summary.Principal</dd></div>
                <div><dt>Vehicle registration</dt><dd>@(currentCase.Summary.Registration ?? "Not recorded")</dd></div>
                <div><dt>Claimant</dt><dd>@(currentCase.Summary.Claimant ?? "Not recorded")</dd></div>
                <div><dt>Claim number</dt><dd>@(currentCase.Summary.ClaimNumber ?? "Not recorded")</dd></div>
            </dl>
            @if (Model.AssociationLeaseCaseId == currentCase.Summary.CaseId
                && Model.AssociationLeaseCaseVersion is { } unlinkCaseVersion
                && Model.AssociationLeaseIntakeVersion is { } unlinkIntakeVersion
                && Model.AssociationLeaseToken is { } unlinkLeaseToken
                && Model.AssociationOperationKey is { } unlinkOperationKey)
            {
                var unlinkAction = Url.Page(
                    "/Mail/Message",
                    "UnlinkCase",
                    new
                    {
                        id = summary.Id,
                        mailbox = Model.MailboxFilter,
                        folder = Model.FolderFilter,
                        pageNumber = Model.PageNumber,
                        search = Model.SearchTerm
                    });
                var unlinkDialogData = new ViewDataDictionary(ViewData)
                {
                    ["DialogId"] = "unlinkCaseDialog",
                    ["DialogTitle"] = $"Unlink from {currentCase.Summary.Reference}",
                    ["DialogActionUrl"] = unlinkAction,
                    ["DialogConsequence"] = "This records a permanent reasoned unlink. To correct the association, search for and confirm the replacement case afterwards.",
                    ["DialogHiddenFields"] = new Dictionary<string, string?>
                    {
                        ["caseId"] = currentCase.Summary.CaseId.ToString("D"),
                        ["expectedIntakeVersion"] = unlinkIntakeVersion.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        ["expectedCaseVersion"] = unlinkCaseVersion.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        ["editLeaseToken"] = unlinkLeaseToken,
                        ["operationKey"] = unlinkOperationKey
                    }
                };
                <button class="secondary-action" type="button" data-dialog-open="unlinkCaseDialog">Unlink from this case</button>
                <partial name="Shared/_ReasonDialog" view-data="unlinkDialogData" />
            }
            else
            {
                <form method="post" asp-page-handler="PrepareUnlinkCase" asp-route-id="@summary.Id"
                      asp-route-mailbox="@Model.MailboxFilter" asp-route-folder="@Model.FolderFilter"
                      asp-route-search="@Model.SearchTerm" asp-route-pageNumber="@Model.PageNumber">
                    <input type="hidden" name="caseId" value="@currentCase.Summary.CaseId" />
                    <input type="hidden" name="expectedIntakeVersion" value="@associationReceipt.Version" />
                    <input type="hidden" name="expectedCaseVersion" value="@currentCase.Workflow.Version" />
                    <input type="hidden" name="leaseOperationKey" value="@Guid.NewGuid().ToString("N")" />
                    <button class="secondary-action" type="submit">Continue to unlink confirmation</button>
                </form>
            }
        }
        else
        {
            <p>This message is not associated with a case. Search for the exact Case/PO before linking it.</p>
            <form method="get" class="form-grid">
                <input type="hidden" name="id" value="@summary.Id" />
                <input type="hidden" name="mailbox" value="@Model.MailboxFilter" />
                <input type="hidden" name="folder" value="@Model.FolderRouteValue" />
                <input type="hidden" name="pageNumber" value="@Model.PageRouteValue" />
                <input type="hidden" name="search" value="@Model.SearchTerm" />
                <label for="association-case-query">Search by Case/PO, registration, claimant or claim number</label>
                <input id="association-case-query" name="caseQuery" value="@Model.CaseQuery" maxlength="300" required />
                <button class="secondary-action" type="submit">Search cases</button>
            </form>

            @if (Model.CaseResults is { } caseResults)
            {
                if (caseResults.Count == 0)
                {
                    <p class="empty-state">No matching cases were found.</p>
                }
                else
                {
                    <h3>Matching cases</h3>
                    <ul class="plain-list">
                        @foreach (var candidate in caseResults)
                        {
                            <li>
                                <a asp-page="/Mail/Message" asp-route-id="@summary.Id"
                                   asp-route-mailbox="@Model.MailboxFilter" asp-route-folder="@Model.FolderRouteValue"
                                   asp-route-pageNumber="@Model.PageRouteValue" asp-route-search="@Model.SearchTerm"
                                   asp-route-caseQuery="@Model.CaseQuery" asp-route-targetCaseId="@candidate.CaseId">
                                    Review @candidate.Reference
                                    — @(candidate.Registration ?? "registration not recorded") · @(candidate.Claimant ?? "claimant not recorded") · @candidate.Stage
                                </a>
                            </li>
                        }
                    </ul>
                }
            }

            @if (Model.TargetCase is { } targetCase)
            {
                <h3>Confirm target</h3>
                <dl class="detail-list">
                    <div><dt>Case/PO</dt><dd>@targetCase.Summary.Reference</dd></div>
                    <div><dt>Principal</dt><dd>@targetCase.Summary.Principal</dd></div>
                    <div><dt>Vehicle registration</dt><dd>@(targetCase.Summary.Registration ?? "Not recorded")</dd></div>
                    <div><dt>Claimant</dt><dd>@(targetCase.Summary.Claimant ?? "Not recorded")</dd></div>
                    <div><dt>Claim number</dt><dd>@(targetCase.Summary.ClaimNumber ?? "Not recorded")</dd></div>
                    <div><dt>State</dt><dd>@OperatorLabels.CaseStage(targetCase.Summary.State)</dd></div>
                </dl>
                @if (Model.AssociationLeaseCaseId == targetCase.Summary.CaseId
                    && Model.AssociationLeaseCaseVersion is { } linkCaseVersion
                    && Model.AssociationLeaseIntakeVersion is { } linkIntakeVersion
                    && Model.AssociationLeaseToken is { } linkLeaseToken
                    && Model.AssociationOperationKey is { } linkOperationKey)
                {
                    var linkAction = Url.Page(
                        "/Mail/Message",
                        "LinkCase",
                        new
                        {
                            id = summary.Id,
                            mailbox = Model.MailboxFilter,
                            folder = Model.FolderFilter,
                            pageNumber = Model.PageNumber,
                            search = Model.SearchTerm
                        });
                    var linkDialogData = new ViewDataDictionary(ViewData)
                    {
                        ["DialogId"] = "linkCaseDialog",
                        ["DialogTitle"] = $"Link to {targetCase.Summary.Reference}",
                        ["DialogActionUrl"] = linkAction,
                        ["DialogConsequence"] = "Confirm that this exact message belongs to the case shown below. The reason and before/after association are retained permanently.",
                        ["DialogHiddenFields"] = new Dictionary<string, string?>
                        {
                            ["caseId"] = targetCase.Summary.CaseId.ToString("D"),
                            ["expectedIntakeVersion"] = linkIntakeVersion.ToString(System.Globalization.CultureInfo.InvariantCulture),
                            ["expectedCaseVersion"] = linkCaseVersion.ToString(System.Globalization.CultureInfo.InvariantCulture),
                            ["editLeaseToken"] = linkLeaseToken,
                            ["operationKey"] = linkOperationKey
                        }
                    };
                    <button class="btn btn--dark" type="button" data-dialog-open="linkCaseDialog">Link to this case</button>
                    <partial name="Shared/_ReasonDialog" view-data="linkDialogData" />
                }
                else
                {
                    <form method="post" asp-page-handler="PrepareLinkCase" asp-route-id="@summary.Id"
                          asp-route-mailbox="@Model.MailboxFilter" asp-route-folder="@Model.FolderFilter"
                          asp-route-search="@Model.SearchTerm" asp-route-pageNumber="@Model.PageNumber"
                          asp-route-caseQuery="@Model.CaseQuery" asp-route-targetCaseId="@targetCase.Summary.CaseId">
                        <input type="hidden" name="caseId" value="@targetCase.Summary.CaseId" />
                        <input type="hidden" name="expectedIntakeVersion" value="@associationReceipt.Version" />
                        <input type="hidden" name="expectedCaseVersion" value="@targetCase.Workflow.Version" />
                        <input type="hidden" name="leaseOperationKey" value="@Guid.NewGuid().ToString("N")" />
                        <button class="btn btn--dark" type="submit">Continue to link confirmation</button>
                    </form>
                }
            }
        }
    </section>
}

@if (Model.Detail.Classification is { } dossier)
{
    var destination = Pegasus.Web.Pages.Mail.MessageModel.Destination(dossier.Current);
    <section class="panel section-gap" aria-labelledby="classification-heading">
        <h2 id="classification-heading">Classification evidence</h2>
        <dl class="detail-list">
            <div><dt>Current decision</dt><dd>@Pegasus.Web.Pages.Mail.MessageModel.DecisionLabel(dossier.Current)</dd></div>
            <div><dt>Policy</dt><dd>@dossier.Current.PolicyKey version @dossier.Current.PolicyVersion</dd></div>
            <div><dt>Operational destination</dt><dd>@OperatorLabels.MailOperationalDestinationLabel(destination.Destination)</dd></div>
            <div><dt>Destination policy</dt><dd>@destination.PolicyKey version @destination.PolicyVersion</dd></div>
            @if (Model.Detail.FolderRecommendation is { IsAvailable: true, FolderType: { } folderType } recommendation)
            {
                <div><dt>Recommended Outlook folder</dt><dd>@Pegasus.Core.Intake.MailLogicalFolders.Definition(folderType).Label</dd></div>
                <div><dt>Folder recommendation policy</dt><dd>@recommendation.PolicyKey version @recommendation.PolicyVersion</dd></div>
                @if (Model.Detail.LatestFolderMove is { } latestMove)
                {
                    <div><dt>Latest folder move</dt><dd>@latestMove.Outcome — @(latestMove.FailureReason ?? latestMove.Reason)</dd></div>
                }
            }
            else if (Model.Detail.FolderRecommendation is { } unavailableRecommendation)
            {
                <div><dt>Recommended Outlook folder</dt><dd>Unavailable — @unavailableRecommendation.Reason</dd></div>
                <div><dt>Folder recommendation policy</dt><dd>@unavailableRecommendation.PolicyKey version @unavailableRecommendation.PolicyVersion</dd></div>
            }
            <div><dt>Reason</dt><dd>@dossier.Current.Reason</dd></div>
            <div><dt>Decision version</dt><dd>@dossier.Version</dd></div>
            <div><dt>Decided by</dt><dd>@dossier.CurrentActorDisplayName</dd></div>
            <div><dt>Decided at</dt><dd><time datetime="@dossier.CurrentDecidedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(dossier.CurrentDecidedAtUtc)</time></dd></div>
        </dl>
        @if (Model.Detail.LatestFolderMove is
            {
                Outcome: Pegasus.Core.Intake.RetainedMailFolderMoveOutcome.Uncertain,
                OperationKey: { } recoveryOperationKey,
                ExpectedClassificationVersion: { } recoveryClassificationVersion,
                ExpectedRecommendationPolicyKey: { } recoveryPolicyKey,
                ExpectedRecommendationPolicyVersion: { } recoveryPolicyVersion,
                ExpectedMailboxVersion: { } recoveryMailboxVersion
            } uncertainMove)
        {
            <form method="post" asp-page-handler="MoveToRecommendedFolder" asp-route-id="@summary.Id"
                  asp-route-mailbox="@Model.MailboxFilter" asp-route-folder="@Model.FolderFilter"
                  asp-route-search="@Model.SearchTerm" asp-route-pageNumber="@Model.PageNumber">
                <input type="hidden" name="ExpectedClassificationVersion" value="@recoveryClassificationVersion" />
                <input type="hidden" name="ExpectedRecommendationPolicyKey" value="@recoveryPolicyKey" />
                <input type="hidden" name="ExpectedRecommendationPolicyVersion" value="@recoveryPolicyVersion" />
                <input type="hidden" name="ExpectedMailboxVersion" value="@recoveryMailboxVersion" />
                <input type="hidden" name="MoveOperationKey" value="@recoveryOperationKey" />
                <input type="hidden" name="Reason" value="@uncertainMove.Reason" />
                <button class="btn btn--dark" type="submit">Check move status</button>
            </form>
        }
        else if (Model.Detail.SuggestedMove is { } suggestedMove
            && Model.Detail.FolderRecommendation is
            {
                MailboxVersion: { } mailboxVersion
            } moveRecommendation)
        {
            var moveOperationKey = Guid.NewGuid().ToString("D");
            var moveAction = Url.Page(
                "/Mail/Message",
                "MoveToRecommendedFolder",
                new
                {
                    id = summary.Id,
                    mailbox = Model.MailboxFilter,
                    folder = Model.FolderFilter,
                    pageNumber = Model.PageNumber,
                    search = Model.SearchTerm,
                    expectedClassificationVersion = dossier.Version,
                    expectedRecommendationPolicyKey = moveRecommendation.PolicyKey,
                    expectedRecommendationPolicyVersion = moveRecommendation.PolicyVersion,
                    expectedMailboxVersion = mailboxVersion,
                    moveOperationKey
                });
            var moveDialogData = new ViewDataDictionary(ViewData)
            {
                ["DialogId"] = "moveRecommendedFolderDialog",
                ["DialogTitle"] = "Confirm Outlook folder move",
                ["DialogActionUrl"] = moveAction,
                ["DialogConsequence"] = "This moves the message to the current designated Outlook folder."
            };
            <h3>Suggested next action</h3>
            <p>@suggestedMove.Reason</p>
            <button class="btn btn--dark" type="button" data-dialog-open="moveRecommendedFolderDialog">
                Move to @Pegasus.Core.Intake.MailLogicalFolders.Definition(suggestedMove.FolderType).Label
            </button>
            <partial name="Shared/_ReasonDialog" view-data="moveDialogData" />
        }
        @if (dossier.Current.Predicates.Count > 0)
        {
            <h3>Material evidence</h3>
            <ul>
                @foreach (var predicate in dossier.Current.Predicates)
                {
                    <li><strong>@predicate.Key:</strong> @(predicate.Matched ? "matched" : "not matched") — @predicate.Detail</li>
                }
            </ul>
        }

        <h3>Correct classification</h3>
        <form method="post" asp-page-handler="CorrectClassification" asp-route-id="@summary.Id"
              asp-route-mailbox="@Model.MailboxFilter" asp-route-folder="@Model.FolderFilter"
              asp-route-search="@Model.SearchTerm"
              asp-route-pageNumber="@Model.PageNumber">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input type="hidden" asp-for="ExpectedClassificationVersion" value="@dossier.Version" />
            <div class="field">
                <label asp-for="ClassificationKey">Classification</label>
                <select asp-for="ClassificationKey">
                    <option value="">Choose classification</option>
                    @foreach (var option in Pegasus.Web.Pages.Mail.MessageModel.ClassificationOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
                <span asp-validation-for="ClassificationKey"></span>
            </div>
            <div class="field">
                <label asp-for="OtherClassificationName">New Other category name (only when Other is selected)</label>
                <input asp-for="OtherClassificationName" maxlength="200" />
            </div>
            <div class="field">
                <label asp-for="OtherClassificationReasoning">Why no existing category fits (only when Other is selected)</label>
                <textarea asp-for="OtherClassificationReasoning" rows="2" maxlength="1000"></textarea>
            </div>
            <div class="field">
                <label asp-for="CorrectionReason">Correction reason</label>
                <textarea asp-for="CorrectionReason" rows="3" maxlength="500" required></textarea>
                <span asp-validation-for="CorrectionReason"></span>
            </div>
            <button class="btn btn--dark" type="submit">Save classification correction</button>
        </form>

        <h3>Permanent correction history</h3>
        @if (dossier.History.Count == 0)
        {
            <p class="empty-state">This classification has not been corrected.</p>
        }
        else
        {
            <ol>
                @foreach (var entry in dossier.History.OrderByDescending(item => item.Version))
                {
                    <li>
                        <strong>Version @entry.Version:</strong>
                        @Pegasus.Web.Pages.Mail.MessageModel.DecisionLabel(entry.Before)
                        → @Pegasus.Web.Pages.Mail.MessageModel.DecisionLabel(entry.After).
                        @entry.Reason — @entry.ActorDisplayName,
                        <time datetime="@entry.CorrectedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(entry.CorrectedAtUtc)</time>
                    </li>
                }
            </ol>
        }
    </section>
}
else if (Model.Detail.FolderRecommendation is { IsAvailable: false } unavailableRecommendation)
{
    <section class="panel section-gap" aria-labelledby="folder-recommendation-heading">
        <h2 id="folder-recommendation-heading">Folder recommendation</h2>
        <dl class="detail-list">
            <div><dt>Recommended Outlook folder</dt><dd>Unavailable — @unavailableRecommendation.Reason</dd></div>
            <div><dt>Folder recommendation policy</dt><dd>@unavailableRecommendation.PolicyKey version @unavailableRecommendation.PolicyVersion</dd></div>
        </dl>
    </section>
}

<nav class="tabs section-gap" aria-label="Sections">
    <a asp-page="/Mail/Message" asp-route-id="@summary.Id" asp-route-mailbox="@Model.MailboxFilter"
       asp-route-folder="@Model.FolderRouteValue" asp-route-pageNumber="@Model.PageRouteValue"
       asp-route-search="@Model.SearchTerm"
       aria-current="@(Model.ActiveSection == "message" ? "page" : null)">Message</a>
    <a asp-page="/Mail/Message" asp-route-id="@summary.Id" asp-route-mailbox="@Model.MailboxFilter"
       asp-route-folder="@Model.FolderRouteValue" asp-route-pageNumber="@Model.PageRouteValue"
       asp-route-search="@Model.SearchTerm"
       asp-route-section="attachments"
       aria-current="@(Model.ActiveSection == "attachments" ? "page" : null)">
        @(Model.Detail.Attachments.Count > 0
            ? $"Attachments ({Model.Detail.Attachments.Count})"
            : "Attachments")
    </a>
    <a asp-page="/Mail/Message" asp-route-id="@summary.Id" asp-route-mailbox="@Model.MailboxFilter"
       asp-route-folder="@Model.FolderRouteValue" asp-route-pageNumber="@Model.PageRouteValue"
       asp-route-search="@Model.SearchTerm"
       asp-route-section="thread"
       aria-current="@(Model.ActiveSection == "thread" ? "page" : null)">Thread</a>
</nav>

@if (Model.ActiveSection == "message")
{
    <section class="panel" aria-label="Message">
        <dl class="detail-list">
            <div>
                <dt>From</dt>
                <dd>@(summary.EffectiveSenderAddress ?? summary.SenderAddress ?? "Not recorded")</dd>
            </div>
            @if (Pegasus.Web.Pages.Mail.IndexModel.ForwarderLine(summary) is { } forwarder)
            {
                <div>
                    <dt>Forwarded by</dt>
                    <dd>@forwarder</dd>
                </div>
            }
            <div>
                <dt>To</dt>
                <dd>@(Model.Detail.ToAddresses.Count == 0 ? "Not recorded" : string.Join(", ", Model.Detail.ToAddresses))</dd>
            </div>
            @if (Model.Detail.CcAddresses.Count > 0)
            {
                <div>
                    <dt>Cc</dt>
                    <dd>@string.Join(", ", Model.Detail.CcAddresses)</dd>
                </div>
            }
            <div>
                <dt>Mailbox</dt>
                <dd>@summary.MailboxAddress</dd>
            </div>
        </dl>
        @if (string.IsNullOrWhiteSpace(Model.Detail.BodyPlainText))
        {
            <p class="empty-state">This message has no readable text body.</p>
        }
        else
        {
            @* Flattened text, never markup. The reader that produced it already
               stripped every tag, and this element renders what it was given. *@
            <pre class="mail-body">@Model.Detail.BodyPlainText</pre>
        }
    </section>
}
else if (Model.ActiveSection == "attachments")
{
    <section class="panel" aria-label="Attachments">
        @if (Model.Detail.Attachments.Count == 0)
        {
            <p class="empty-state">This message has no attachments.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">File</th>
                            <th scope="col">Type</th>
                            <th scope="col">Size</th>
                            <th scope="col">Search content</th>
                            <th scope="col">Custody</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var attachment in Model.Detail.Attachments)
                    {
                        <tr>
                            <td>@attachment.FileName</td>
                            <td>@attachment.MediaType</td>
                            <td class="tabular">@OperatorLabels.FileSize(attachment.ContentLength)</td>
                            <td>@OperatorLabels.AttachmentSearchability(attachment.IsSearchable)</td>
                            @* The row exists because the attachment was kept, so
                               custody is a fact of the row rather than a lookup. *@
                            <td><partial name="Shared/_StatusChip" model="@("Retained")" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
else
{
    <section class="panel" aria-label="Thread">
        @if (Model.Detail.Thread.Count <= 1)
        {
            @* Retained scope only: a matching conversation never reaches for a
               message Pegasus has not already kept. *@
            <p class="empty-state">No other message in this conversation is kept here.</p>
        }
        else
        {
            <div class="queue-list">
                @foreach (var entry in Model.Detail.Thread)
                {
                    <a asp-page="/Mail/Message" asp-route-id="@entry.Id"
                       asp-route-mailbox="@Model.MailboxFilter"
                       asp-route-folder="@Model.FolderRouteValue"
                       asp-route-search="@Model.SearchTerm"
                       asp-route-pageNumber="@Model.PageRouteValue"
                       aria-current="@(entry.Id == summary.Id ? "page" : null)">
                        <span>
                            <strong>@(entry.SenderDisplayName ?? entry.SenderAddress ?? "Sender not recorded")</strong>
                        </span>
                        <span>
                            <strong>@(string.IsNullOrWhiteSpace(entry.Subject) ? "No subject" : entry.Subject)</strong>
                        </span>
                        <span>
                            <time datetime="@entry.ReceivedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(entry.ReceivedAtUtc)</time>
                        </span>
                    </a>
                }
            </div>
        }
    </section>
}
