@page "/Inbox"
@using Pegasus.Core.Intake
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Mail.IndexModel
@{
    ViewData["Title"] = "Inbox";
    ViewData["RefreshStatus"] = Pegasus.Web.Pages.Mail.IndexModel.FreshnessStatus(Model.Freshness.State);
    ViewData["RefreshFields"] = Model.RefreshFields;
    var totalPages = Model.Results.TotalPages;
    var currentPage = Model.Results.Page;
    var rowHandler = Model.Dismissed ? "Restore" : "Dismiss";
}
@section Styles {
    <link rel="stylesheet" href="~/css/inbox.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/case-picker.js" asp-append-version="true"></script>
}

<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">Emails</p>
        <h1>Inbox</h1>
    </div>
    <div class="page-actions">
        <div class="page-action-group">
            <partial name="Shared/_FreshnessBanner" model="Model.Freshness.LastSuccessfulUpdateAtUtc" />
        </div>
    </div>
</header>

<section class="pane-layout inbox-layout" data-mail-workspace aria-label="Emails">
    <div class="pane">
        <nav class="tabs scope-list" data-mail-scopes aria-label="Inbox">
            @foreach (var scope in Model.Scopes)
            {
                <form method="get">
                    @foreach (var field in scope.HiddenFields)
                    {
                        <input type="hidden" name="@field.Key" value="@field.Value" />
                    }
                    <button type="submit" class="tab" aria-current="@(scope.Pressed ? "page" : null)">
                        @scope.Definition.Label
                        <span class="tab-count tabular">@scope.Count</span>
                    </button>
                </form>
            }
        </nav>

        <form method="get" class="inbox-toolbar inbox-filter" data-auto-submit aria-label="Mail view">
            @if (Model.FolderRouteValue is { } folderCode)
            {
                <input type="hidden" name="folder" value="@folderCode" />
            }
            @if (Model.QueueFilter is not null)
            {
                <input type="hidden" name="queue" value="@Model.QueueFilter" />
            }
            <div class="inbox-search-box">
                <label class="sr-only" for="mail-search">Search</label>
                <input id="mail-search" type="search" name="search" value="@Model.SearchTerm" maxlength="200" placeholder="Subject, sender, reference" />
            </div>
            <label class="sr-only" for="principal-filter">@OperatorLabels.Inbox.AllPrincipals</label>
            <select id="principal-filter" name="principal" aria-label="@OperatorLabels.Inbox.AllPrincipals">
                <option value="">@OperatorLabels.Inbox.AllPrincipals</option>
                @foreach (var principal in Model.Principals)
                {
                    <option value="@principal" selected="@(Model.PrincipalFilter == principal)">@principal</option>
                }
            </select>
            <label class="sr-only" for="mailbox-filter">Mailbox</label>
            <select id="mailbox-filter" name="mailbox" aria-label="Mailbox">
                <option value="">All Mailboxes</option>
                @foreach (var mailbox in Model.Mailboxes)
                {
                    <option value="@mailbox.MailboxId" selected="@(Model.MailboxFilter == mailbox.MailboxId.ToString("D"))">@mailbox.MailboxAddress</option>
                }
            </select>
            <div class="inbox-toolbar-meta">
                <span class="meta tabular">@Model.Results.TotalCount message@(Model.Results.TotalCount == 1 ? string.Empty : "s")</span>
                <a class="btn btn--small sort-toggle"
                   asp-page="/Mail/Index"
                   asp-route-mailbox="@Model.MailboxFilter"
                   asp-route-folder="@Model.FolderRouteValue"
                   asp-route-principal="@Model.PrincipalFilter"
                   asp-route-search="@Model.SearchTerm"
                   asp-route-queue="@Model.QueueFilter"
                   asp-route-sort="@(Model.OldestFirst ? null : "oldest")"
                   aria-label="@(Model.OldestFirst ? "Received order: oldest first; activate for newest first" : "Received order: newest first; activate for oldest first")">
                    Received @(Model.OldestFirst ? "↑" : "↓")
                </a>
            </div>
        </form>

        <form id="mail-bulk" method="post" class="inbox-bulk" hidden="@(Model.TickedIds.Count == 0)">
            <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
            <span class="inbox-bulk-count tabular" data-bulk-count>@Model.TickedIds.Count</span>
            <button type="submit" class="btn btn--small" formnovalidate
                    asp-page="/Mail/Index" asp-page-handler="@(Model.Dismissed ? "BulkRestore" : "BulkDismiss")"
                    asp-route-mailbox="@Model.MailboxFilter"
                    asp-route-folder="@Model.FolderRouteValue"
                    asp-route-principal="@Model.PrincipalFilter"
                    asp-route-search="@Model.SearchTerm"
                    asp-route-queue="@Model.QueueFilter"
                    asp-route-sort="@(Model.OldestFirst ? "oldest" : null)"
                    asp-route-pageNumber="@(currentPage > 1 ? currentPage : (int?)null)"
                    data-busy-label="@(Model.Dismissed ? OperatorLabels.Busy.Restoring : OperatorLabels.Busy.Dismissing)">
                <span>@(Model.Dismissed ? OperatorLabels.Inbox.Restore : OperatorLabels.Inbox.Dismiss)</span>
            </button>
        </form>

        <div class="inbox-ledger-head" aria-hidden="true">
            <label class="inbox-row-tick"><input type="checkbox" data-mail-tick-all aria-label="Select all" /></label>
            <span>@OperatorLabels.Inbox.Case</span>
            <span>@OperatorLabels.Inbox.Type</span>
            <span>@OperatorLabels.CaseWorkspace.Subject</span>
            <span>@OperatorLabels.CaseWorkspace.Sender</span>
            <span>@OperatorLabels.CaseWorkspace.Received</span>
            <span></span>
        </div>

        <div class="pane-body pane-scroll" tabindex="0">
            @if (Model.NotChangedCount > 0)
            {
                <div class="notice notice--warning" role="status" data-bulk-not-changed>
                    <span>@OperatorLabels.Inbox.NotChanged(Model.NotChangedCount)</span>
                </div>
            }
            @if (Model.SearchValidationMessage is { } validationMessage)
            {
                <div class="notice notice--warning" role="alert"><span>@validationMessage</span></div>
            }
            else if (Model.Results.Items.Count == 0)
            {
                <div class="empty">
                    @if (Model.SearchTerm is not null)
                    {
                        <p>No emails matched “@Model.SearchTerm”.</p>
                    }
                    else if (Model.Dismissed)
                    {
                        <p>No dismissed messages.</p>
                    }
                    else if (Model.Results.HasUnretainedHistory)
                    {
                        <p>Nothing here yet. Messages are kept from the point this screen started keeping them.</p>
                    }
                    else
                    {
                        <p>No mail has been received.</p>
                    }
                </div>
            }
            else
            {
                <div class="inbox-ledger" data-row-list>
                    @foreach (var item in Model.Results.Items)
                    {
                        var subject = Pegasus.Web.Pages.Mail.IndexModel.SubjectLine(item);
                        var classification = item.Classification is { IsClassified: true, Category: { } } current ? current : null;
                        <div class="inbox-row inbox-ledger-row @(item.IsRead ? null : "unread")" data-mail-row="@item.Id" aria-current="@(Model.SelectedMessageId == item.Id ? "true" : null)">
                            <label class="inbox-row-tick">
                                <input type="checkbox" form="mail-bulk" name="ids" value="@item.Id" data-mail-tick
                                       aria-label="@subject"
                                       checked="@Model.TickedIds.Contains(item.Id)" />
                                @if (!item.IsRead)
                                {
                                    <span class="unread-indicator" aria-hidden="true"></span><span class="sr-only">@OperatorLabels.Shell.Unread</span>
                                }
                            </label>
                            <div class="inbox-cell-case">
                                @if (item.CaseId is { } caseId && item.CaseReference is { Length: > 0 } reference)
                                {
                                    <a class="mail-row-case" asp-page="/Cases/Details" asp-route-id="@caseId">@reference</a>
                                }
                                else
                                {
                                    <span class="quiet">@OperatorLabels.Inbox.NoCase</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.VehicleSummary))
                                {
                                    <small class="inbox-cell-sub">@item.VehicleSummary</small>
                                }
                            </div>
                            @* Type (v42 H; R559): the category as its status chip with the work
                               type beneath as a plain neutral chip, the message's open query as
                               the purple Query chip with its assignee, and Correspondence as a
                               neutral chip. *@
                            <div class="inbox-cell-type">
                                @if (item.Query is { IsOpen: true } query)
                                {
                                    <span class="status status--purple" data-row-query>@OperatorLabels.QueryStage</span>
                                    <small class="inbox-cell-sub">@(query.AssignedTo ?? OperatorLabels.CaseWorkspace.Unassigned)</small>
                                }
                                else if (classification?.Category is { } category)
                                {
                                    <span class="status status--@OperatorLabels.Inbox.CategoryTone(category)">@OperatorLabels.MailClassification(category)</span>
                                    @if (category == MailCategory.NewInstruction && classification.CaseType is { } caseType)
                                    {
                                        <span class="status status--neutral status--plain inbox-type-work">@OperatorLabels.CaseTypeName(caseType)</span>
                                    }
                                }
                                else
                                {
                                    <span class="status status--neutral">@OperatorLabels.Inbox.Correspondence</span>
                                }
                            </div>
                            <div class="inbox-cell-message">
                                <div class="inbox-subject-line">
                                    <a class="row-title" data-mail-open
                                       asp-page="/Mail/Message" asp-route-id="@item.Id"
                                       asp-route-mailbox="@Model.MailboxFilter"
                                       asp-route-folder="@Model.FolderRouteValue"
                                       asp-route-principal="@Model.PrincipalFilter"
                                       asp-route-search="@Model.SearchTerm"
                                       asp-route-queue="@Model.QueueFilter"
                                       asp-route-sort="@(Model.OldestFirst ? "oldest" : null)"
                                       asp-route-pageNumber="@(currentPage > 1 ? currentPage : (int?)null)">@subject</a>
                                    @if (item.AttachmentCount > 0)
                                    {
                                        <span class="mail-att-pill" title="@OperatorLabels.Inbox.AttachmentCount(item.AttachmentCount)">
                                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-file")" /></svg>
                                            <span>@item.AttachmentCount</span><span class="sr-only"> @OperatorLabels.Inbox.AttachmentCount(item.AttachmentCount)</span>
                                        </span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.BodyExcerpt))
                                {
                                    <span class="row-excerpt">@item.BodyExcerpt</span>
                                }
                            </div>
                            <div class="inbox-cell-sender">
                                <span class="inbox-sender-addr">@Pegasus.Web.Pages.Mail.IndexModel.SenderLine(item)</span>
                                @if (item.PrincipalCode is { Length: > 0 } principal)
                                {
                                    <span class="inbox-principal-text" data-principal-badge>@principal</span>
                                }
                            </div>
                            <div class="inbox-cell-time">
                                <time datetime="@item.ReceivedAtUtc.ToString("O")">@OperatorLabels.OfficeDate(item.ReceivedAtUtc)</time>
                                <small class="tabular">@OperatorLabels.OfficeClock(item.ReceivedAtUtc)</small>
                            </div>
                            <div class="inbox-row-actions">
                                @if (Model.OffersReply(item))
                                {
                                    <a class="icon-button" data-mail-row-reply data-mail-open
                                       asp-page="/Mail/Message" asp-route-id="@item.Id" asp-route-compose="reply"
                                       asp-route-mailbox="@Model.MailboxFilter"
                                       asp-route-folder="@Model.FolderRouteValue"
                                       asp-route-principal="@Model.PrincipalFilter"
                                       asp-route-search="@Model.SearchTerm"
                                       asp-route-queue="@Model.QueueFilter"
                                       title="@OperatorLabels.StaffMail.Reply" aria-label="@OperatorLabels.StaffMail.Reply @subject">
                                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-reply")" /></svg>
                                    </a>
                                }
                                <form method="post" asp-page-handler="@rowHandler" class="inbox-row-action"
                                      asp-route-mailbox="@Model.MailboxFilter"
                                      asp-route-folder="@Model.FolderRouteValue"
                                      asp-route-principal="@Model.PrincipalFilter"
                                      asp-route-search="@Model.SearchTerm"
                                      asp-route-queue="@Model.QueueFilter">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                                    <button type="submit" class="icon-button" title="@(Model.Dismissed ? OperatorLabels.Inbox.Restore : OperatorLabels.Inbox.Dismiss)"
                                            aria-label="@(Model.Dismissed ? OperatorLabels.Inbox.Restore : OperatorLabels.Inbox.Dismiss) @Pegasus.Web.Pages.Mail.IndexModel.SubjectLine(item)"
                                            data-busy-label="@(Model.Dismissed ? OperatorLabels.Busy.Restoring : OperatorLabels.Busy.Dismissing)">
                                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href(Model.Dismissed ? "icon-undo" : "icon-x")" /></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        @if (totalPages > 1)
        {
            <div class="pagination">
                <span>Page @currentPage of @totalPages</span>
                <div class="button-row">
                    @if (currentPage > 1)
                    {
                        <a class="btn btn--small" asp-page="/Mail/Index"
                           asp-route-mailbox="@Model.MailboxFilter" asp-route-folder="@Model.FolderRouteValue"
                           asp-route-principal="@Model.PrincipalFilter" asp-route-search="@Model.SearchTerm"
                           asp-route-queue="@Model.QueueFilter" asp-route-sort="@(Model.OldestFirst ? "oldest" : null)"
                           asp-route-pageNumber="@(currentPage - 1)">Previous</a>
                    }
                    @if (currentPage < totalPages)
                    {
                        <a class="btn btn--small" asp-page="/Mail/Index"
                           asp-route-mailbox="@Model.MailboxFilter" asp-route-folder="@Model.FolderRouteValue"
                           asp-route-principal="@Model.PrincipalFilter" asp-route-search="@Model.SearchTerm"
                           asp-route-queue="@Model.QueueFilter" asp-route-sort="@(Model.OldestFirst ? "oldest" : null)"
                           asp-route-pageNumber="@(currentPage + 1)">Next</a>
                    }
                </div>
            </div>
        }
    </div>
</section>
<div data-mail-dialog-root></div>
