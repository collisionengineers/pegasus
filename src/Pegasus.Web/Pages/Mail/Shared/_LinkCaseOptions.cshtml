@model IReadOnlyList<Pegasus.Core.Intake.IntakeAssociationDestination>
@* The Link to Case option list (fetched by case-picker.js as staff type): the
   Cases and Triage Cases the message may be linked to. Choosing one fills the
   Case / PO field and writes nothing; the reason dialog confirms the link. The
   list carries no empty-state copy: nothing matching renders nothing, and the
   picker closes. *@
<ul class="command-results" role="listbox" data-case-picker-list>
    @for (var index = 0; index < Model.Count; index++)
    {
        var candidate = Model[index];
        <li role="none">
            <button type="button" role="option" id="@($"mail-link-option-{index}")" class="command-result"
                    aria-selected="false" value="@candidate.Reference">
                @candidate.Reference · @(candidate.Registration ?? "No registration") · @(candidate.Claimant ?? "No claimant")
            </button>
        </li>
    }
</ul>
