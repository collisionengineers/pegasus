@model Pegasus.Web.Pages.Mail.MessageModel
@using Pegasus.Core.Intake
@using Pegasus.Core.Lifecycle
@using Pegasus.Web.Presentation
@{
    var summary = Model.Detail.Summary;
    var dossier = Model.Detail.Classification;
    var part = ViewData["MailSettingsPart"] as string;
    var linkFormId = Model.CurrentDestination is null ? "linkCaseForm" : "changeLinkedCaseForm";
    var picksCase = Model.OffersLinkToCase || Model.OffersChangeLinkedCase;
    var currentValue = MailClassificationSelection.ValueFor(dossier?.Current);
    var typeLabel = dossier?.Current is { } current
        ? Pegasus.Web.Pages.Mail.MessageModel.DecisionLabel(current)
        : OperatorLabels.Inbox.Correspondence;
    var query = summary.Query;
}

@if (part is not "menu")
{
    <div class="mail-context-bar" data-mail-context-bar>
        <span data-context-case>
            @OperatorLabels.Inbox.Case
            @if (summary.CaseId is { } contextCaseId)
            {
                <a class="mail-context-case-link" asp-page="/Cases/Details" asp-route-id="@contextCaseId">@summary.CaseReference</a>
            }
            else
            {
                <span class="quiet">@OperatorLabels.Inbox.NoCase</span>
            }
        </span>
        <span class="mail-context-sep" aria-hidden="true">·</span>
        <span>@OperatorLabels.Inbox.Type <strong data-context-type>@typeLabel</strong></span>
        @if (query is { IsOpen: true })
        {
            <span class="mail-context-sep" aria-hidden="true">·</span>
            <span class="status status--purple" data-context-query>@OperatorLabels.QueryStage · @(query.AssignedTo ?? OperatorLabels.CaseWorkspace.Unassigned)</span>
        }
        else if (query is { IsOpen: false })
        {
            <span class="mail-context-sep" aria-hidden="true">·</span>
            <span class="status status--green" data-context-query>@CaseWorkspaceLabels.Frame.Done</span>
        }
    </div>
}

@if (part is not "bar")
{
    <details class="menu mail-settings-menu" data-menu data-mail-settings>
        <summary class="icon-button mail-settings-trigger" aria-label="@OperatorLabels.Inbox.Type" title="@OperatorLabels.Inbox.Type">
            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-settings")" /></svg>
        </summary>
        <div class="mail-settings-popover">
            <div class="mail-settings-section">
                <div class="decision-row mail-settings-row-head">
                    <span>@OperatorLabels.Inbox.Case</span>
                    @if (summary.CaseId is { } caseId)
                    {
                        <strong>
                            <a asp-page="/Cases/Details" asp-route-id="@caseId">@summary.CaseReference</a>
                            @if (Model.CurrentDestination is not null)
                            {
                                <span> · </span>
                                <button type="button" class="mail-settings-link" data-dialog-open="unlinkCaseDialog">@OperatorLabels.Inbox.Unlink</button>
                            }
                        </strong>
                    }
                    else
                    {
                        <strong class="quiet">@OperatorLabels.Inbox.NoCase</strong>
                    }
                </div>
                @if (picksCase)
                {
                    <div class="field case-picker" data-case-picker data-case-picker-fill
                         data-case-picker-url="@Url.Page("/Mail/Message", "LinkCaseOptions", new { id = summary.Id })">
                        <label class="mail-decision-label" for="mailLinkCaseReference">@OperatorLabels.Inbox.CasePo</label>
                        <input id="mailLinkCaseReference" name="caseReference" form="@linkFormId" type="text" maxlength="100"
                               autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false"
                               aria-controls="mailLinkCaseOptions" />
                        <div id="mailLinkCaseOptions" class="case-picker-options" data-case-picker-options hidden></div>
                    </div>
                    <div class="mail-settings-list">
                        @if (Model.OffersChangeLinkedCase)
                        {
                            <button class="mail-settings-item" type="button" data-dialog-open="changeLinkedCaseDialog">@OperatorLabels.Inbox.ChangeLinkedCase</button>
                        }
                        else if (Model.OffersLinkToCase)
                        {
                            <button class="mail-settings-item" type="button" data-dialog-open="linkCaseDialog">@OperatorLabels.Inbox.LinkToCase</button>
                        }
                    </div>
                }
            </div>
            @if (dossier is { } classification)
            {
                <form method="post" id="mailClassificationForm" class="mail-settings-section"
                      asp-page-handler="CorrectClassification" asp-route-id="@summary.Id"
                      asp-route-mailbox="@Model.MailboxFilter" asp-route-folder="@Model.FolderFilter"
                      asp-route-search="@Model.SearchTerm"
                      asp-route-queue="@Model.QueueFilter"
                      asp-route-sort="@(Model.OldestFirst ? "oldest" : null)"
                      asp-route-pageNumber="@Model.PageNumber"
                      asp-route-dialog="@(Model.InDialog ? "true" : null)">
                    <input type="hidden" asp-for="ExpectedClassificationVersion" value="@classification.Version" />
                    <input type="hidden" name="CorrectionReason" value="@MailClassificationSelection.CorrectedFromInboxReason" />
                    <label class="mail-decision-label" id="mailClassificationLabel" for="mailTypeSelect">@OperatorLabels.Inbox.Type</label>
                    <select id="mailTypeSelect" name="ClassificationKey" class="mail-type-select" data-mail-type-select
                            aria-labelledby="mailClassificationLabel">
                        @foreach (var option in Model.ClassificationOptions)
                        {
                            <option value="@option.Value" selected="@(option.Value == currentValue)">@option.Label</option>
                        }
                    </select>
                    <noscript><button class="btn btn--small" type="submit">@OperatorLabels.Inbox.SaveCorrection</button></noscript>
                    <span asp-validation-for="ClassificationKey"></span>
                </form>
            }
            @if (summary.CaseId is not null && !summary.IsTriageCase)
            {
                <div class="mail-settings-list" data-mail-query>
                    @if (query is { IsOpen: true })
                    {
                        <form method="post" asp-page-handler="MarkQueryDone" asp-route-id="@summary.Id">
                            <input type="hidden" name="queryId" value="@query.Id" />
                            <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                            <button class="mail-settings-item" type="submit" data-busy-label="@OperatorLabels.Busy.Saving">
                                <span>@OperatorLabels.StaffMail.MarkQueryDone</span>
                            </button>
                        </form>
                    }
                    else if (query is null && Model.CurrentCase is { } openCase && CaseQueryRules.CanOpen(openCase.Workflow))
                    {
                        <form method="post" asp-page-handler="OpenQuery" asp-route-id="@summary.Id">
                            <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                            <button class="mail-settings-item" type="submit" data-busy-label="@OperatorLabels.Busy.Saving">
                                <span>@CaseWorkspaceLabels.Frame.OpenQuery</span>
                            </button>
                        </form>
                    }
                </div>
            }
            @if (summary.CaseId is { } changeCaseId && (Model.OffersPlaceOnHold || Model.OffersCloseCase))
            {
                <div class="mail-settings-list" data-mail-change-case>
                    <span class="mail-decision-label">@OperatorLabels.Inbox.ChangeCase</span>
                    @if (Model.OffersPlaceOnHold)
                    {
                        <a class="mail-settings-item" asp-page="/Cases/Details" asp-route-id="@changeCaseId" asp-route-dialog="case-hold-dialog">
                            <span>@CaseWorkspaceLabels.Frame.PlaceOnHold</span>
                        </a>
                    }
                    @if (Model.OffersCloseCase)
                    {
                        <a class="mail-settings-item" asp-page="/Cases/Details" asp-route-id="@changeCaseId" asp-route-dialog="case-close-dialog">
                            <span>@OperatorLabels.CaseWorkspace.CloseCase</span>
                        </a>
                    }
                </div>
            }
            @if (dossier is { } decided)
            {
                var actorWord = decided.CurrentActorDisplayName == "System" ? "Automatic" : decided.CurrentActorDisplayName;
                <div class="mail-settings-foot">
                    <span>Decided</span>
                    <span><time datetime="@decided.CurrentDecidedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(decided.CurrentDecidedAtUtc)</time> · @actorWord</span>
                </div>
            }
        </div>
    </details>
}
