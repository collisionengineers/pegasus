@page
@model IndexModel
@{
    ViewData["Title"] = "Work Centre";
    // Create Case lives once, in this page's header (v30 WE): the utility bar's
    // New case is omitted here and only here.
    ViewData["HidesNewCase"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/work-centre.css" asp-append-version="true" />
}

<partial name="_WorkCentreBody" model="Model" />

@section Scripts {
    <script src="~/js/work-centre.js" asp-append-version="true"></script>
}
