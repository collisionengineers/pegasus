@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

@* No lede. The three sections and their numbers are the explanation; a
   sentence describing what the page is for is the page narrating itself. *@
<header class="page-heading">
    <h1>Dashboard</h1>
    <partial name="Shared/_FreshnessBanner" model="(DateTimeOffset?)Model.LoadedAtUtc" />
</header>

<section aria-labelledby="active-cases-title">
    <h2 id="active-cases-title" class="section-label">Active cases</h2>
    <div class="metric-strip metric-strip--3">
        @* Every metric opens the exact filtered list behind it, and 0 renders
           as 0. These three were the literal string "Unavailable" until the
           counts behind them existed. *@
        <a class="metric" data-state="not-ready" asp-page="/Triage/Index" asp-route-queue="not_ready">
            <span class="metric__label">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                Not ready
            </span>
            <strong class="metric__value">@Model.CaseStages.NotReady</strong>
        </a>
        <a class="metric" data-state="review" asp-page="/Triage/Index" asp-route-queue="review">
            <span class="metric__label">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-info" /></svg>
                Review
            </span>
            <strong class="metric__value">@Model.CaseStages.Review</strong>
        </a>
        <a class="metric" data-state="held" asp-page="/Triage/Index" asp-route-queue="held">
            <span class="metric__label">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-clock" /></svg>
                Held
            </span>
            <strong class="metric__value">@Model.CaseStages.Held</strong>
        </a>
    </div>
</section>

<section aria-labelledby="email-activity-title">
    <h2 id="email-activity-title" class="section-label">E-mail activity</h2>
    <div class="metric-strip metric-strip--3">
        @* The count is of mail that arrived, so it opens the mail workspace.
           The other values remain dashboard metrics without a general receipt-ledger destination. *@
        <a class="metric" asp-page="/Mail/Index">
            <span class="metric__label">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-file-text" /></svg>
                Received today
            </span>
            <strong class="metric__value">@Model.MailActivity.ReceivedToday</strong>
        </a>
        <span class="metric" data-state="needs-sorting">
            <span class="metric__label">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                Needs sorting
            </span>
            <strong class="metric__value">@Model.MailActivity.NeedsSorting</strong>
        </span>
        <span class="metric" data-state="blocked">
            <span class="metric__label">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-alert-circle" /></svg>
                Blocked
            </span>
            <strong class="metric__value">@Model.Counts.BlockedIntake</strong>
        </span>
    </div>
</section>

<section aria-labelledby="time-title">
    <h2 id="time-title" class="section-label">Today and this week</h2>
    <div class="metric-strip metric-strip--secondary">
        <a class="metric" asp-page="/Cases/Index">
            <span class="metric__label">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-file-text" /></svg>
                New cases today
            </span>
            <strong class="metric__value">@Model.CaseActivity.NewCasesToday</strong>
        </a>
        <span class="metric">
            <span class="metric__label">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
                Sent to Engineer today
            </span>
            <strong class="metric__value">@Model.CaseActivity.SentToEngineerToday</strong>
        </span>
        <span class="metric">
            <span class="metric__label">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
                Sent to Engineer this week
            </span>
            <strong class="metric__value">@Model.CaseActivity.SentToEngineerThisWeek</strong>
        </span>
        <span class="metric">
            <span class="metric__label">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-upload" /></svg>
                Reports sent today
            </span>
            <strong class="metric__value">@Model.CaseActivity.ReportsSentToday</strong>
        </span>
        <span class="metric">
            <span class="metric__label">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-upload" /></svg>
                Reports sent this week
            </span>
            <strong class="metric__value">@Model.CaseActivity.ReportsSentThisWeek</strong>
        </span>
    </div>
</section>


@* The section stays whether or not there is work in it. Hiding it made an
   empty day and a broken query look the same; a named empty result says
   which one this is. *@
<section id="due-work-list" aria-labelledby="due-work-title" class="section-gap">
    <h2 id="due-work-title" class="section-label">Case work due</h2>
    @if (Model.DueWork.Count == 0)
    {
        <p class="empty-state">No case work is due.</p>
    }
    else
    {
        <div class="panel queue-list">
            @foreach (var item in Model.DueWork)
            {
                <a asp-page="/Cases/Details" asp-route-id="@item.CaseId">
                    <span>
                        <strong>@item.Reference</strong>
                        <small>@item.MissingMaterialReason</small>
                    </span>
                    <span>
                        @* The chase schedule's own state, not the case stage:
                           a case in Review can still be waiting on a chase. *@
                        <partial name="Shared/_StatusChip" model="@Pegasus.Web.Presentation.OperatorLabels.ChaseState(item.State)" />
                        @if (item.NextChaseAtUtc is { } nextChaseAtUtc)
                        {
                            <small>
                                Next chase
                                <time datetime="@nextChaseAtUtc.ToString("O")">@nextChaseAtUtc.ToString("d MMM")</time>
                            </small>
                        }
                    </span>
                </a>
            }
        </div>
    }
</section>

@* The dashboard reports; Operations is where the retryable work and the live
   upload links are actually handled, so the screen ends by pointing there. *@
<p class="section-gap">
    <a asp-page="/Operations/Index">
        Open Operations
        <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-chevron-right" /></svg>
    </a>
</p>
