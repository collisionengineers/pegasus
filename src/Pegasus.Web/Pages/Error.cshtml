@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Pegasus</p>
        <h1>We could not complete that request</h1>
        <p class="lede">No changes should be assumed. Return to Operations and try the action again.</p>
    </div>
</header>

<section class="status-card status-card--error" role="alert">
    <h2>Request failed</h2>
    <p>If the problem continues, give the request ID below to the system administrator.</p>
    @if (Model.ShowRequestId)
    {
        <p class="request-id">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
    <a class="primary-action" asp-page="/Index">Return to Operations</a>
</section>
