@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
    Layout = "Shared/_LayoutAuth";
}

@* One card, one statement of the fault. The previous page said the same thing
   three times — heading, tinted panel, and a second heading — and gave a
   55-character trace identifier hero prominence. *@
<div class="auth-card auth-card--fault" role="alert">
    <p class="auth-card__mark">COLLISION ENGINEERS</p>
    <h1>We could not complete that request</h1>
    <p>What you submitted may not have been saved. Try again, and if it keeps failing, tell your administrator the reference below.</p>
    <div class="auth-card__actions">
        @if (Model.ShowReturnPath)
        {
            @* Never a POST replay: the return path is the page the operator was
               reading, re-requested as a GET. *@
            <a class="primary-action" href="@Model.ReturnPath">Try again</a>
        }
        <a class="secondary-action" asp-page="/Index">Return to Dashboard</a>
    </div>
    @if (Model.ShowRequestId)
    {
        <p class="auth-card__foot">
            Support reference
            <span class="auth-card__reference">
                <code id="support-reference">@Model.RequestId</code>
                <button type="button" class="btn" data-copy-target="support-reference" hidden>Copy</button>
            </span>
        </p>
    }
</div>
