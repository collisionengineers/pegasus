@page "/Upload"
@model Pegasus.Web.Pages.UploadModel
@{
    ViewData["Title"] = "Upload";
}

@* §1.10 draws this screen as a header and one panel. The "What happens next"
   steps and the "Accepted files" chips that used to sit beside the form are
   gone: both narrated the page's own mechanics, which the page-economy rule
   forbids, and the accepted types are already stated on the dropzone where
   the choice is actually made. *@
<header class="page-header">
    <div class="page-title">
        <h1>Upload</h1>
    </div>
</header>

<section class="panel">
    <div class="panel-body">
        <form method="post" enctype="multipart/form-data" data-upload-progress>
            <input asp-for="ExternalReceiptToken" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            @* The dashed area is the destination. site.js makes the whole
               panel the drop target and reveals the dark "Choose files"
               button; the native input stays the control underneath and is
               the visible control when script is off. *@
            <div class="dropzone" data-dropzone>
                <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                <div>
                    <h2><label asp-for="Upload">@OperatorLabels.Upload.Dropzone</label></h2>
                    <p>@Model.AcceptedFiles</p>
                    <button type="button" class="btn btn--dark" hidden data-dropzone-browse>@OperatorLabels.Upload.Choose</button>
                    <input asp-for="Upload" type="file" multiple accept=".eml,.pdf,.docx,.doc,.msg,.jpg,.jpeg,.png,message/rfc822,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword,application/vnd.ms-outlook,image/jpeg,image/png" />
                </div>
            </div>
            @* One row per chosen file, filled in by site.js from the input's
               own FileList. Empty and hidden until something is chosen. *@
            <div class="file-list section-gap" role="status" aria-live="polite" hidden data-dropzone-file></div>
            <span asp-validation-for="Upload" class="field-error"></span>
            <div class="button-row section-gap">
                <button type="submit" class="btn btn--primary">@OperatorLabels.Upload.Submit</button>
                @* A native reset: it empties the file input with no script at
                   all, and site.js re-renders the rows from the emptied
                   input. *@
                <button type="reset" class="btn">@OperatorLabels.Upload.Clear</button>
            </div>
        </form>
    </div>
</section>
