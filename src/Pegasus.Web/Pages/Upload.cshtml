@page "/Upload"
@model Pegasus.Web.Pages.UploadModel
@using Labels = Pegasus.Web.Presentation.OperatorLabels.Upload
@{
    ViewData["Title"] = Labels.Title;
    var errors = ViewData.ModelState.Values
        .SelectMany(entry => entry.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .ToArray();
    // Add evidence on a Case page declares the destination before the upload
    // (FRD-18): the head then names that Case and offers the way back to it.
    var declaredCase = Model.DeclaredCaseId is not null ? Model.Destination : null;
}

@section Styles {
    <link rel="stylesheet" href="~/css/upload.css" asp-append-version="true" />
}

@* v42 Upload E: the whole surface is one record sheet — the identity band
   states where the files go and the limits, the body is the drop target, and
   the selected files and their one action bar appear under it once files are
   chosen. The native file input is the control and keeps working on its own;
   upload.js keeps the accumulated selection, validates it against the limits
   declared here and lists it. *@
<div class="record up-sheet"
     data-upload-select
     data-max-files="@UploadModel.MaximumFileCount"
     data-max-bytes="@UploadModel.MaximumFileBytes"
     data-max-total="@UploadModel.MaximumTotalBytes">
    <form method="post" enctype="multipart/form-data" data-upload-form data-upload-fetch>
        <input asp-for="ExternalReceiptToken" type="hidden" />
        @if (declaredCase is not null)
        {
            <input asp-for="DeclaredCaseId" type="hidden" />
        }
        <header class="record-head">
            <span class="up-sheet-badge" aria-hidden="true">
                <svg class="icon"><use href="@IconSprite.Href("icon-upload")" /></svg>
            </span>
            <div class="up-sheet-title">
                @if (declaredCase is null)
                {
                    <h1>@Labels.Title</h1>
                }
                else
                {
                    <h1>@Labels.Title · @declaredCase.Reference</h1>
                }
                @* The limits are stated once, from their one owner, wherever Upload is opened. *@
                <div class="record-identity">
                    <span>@UploadModel.MaximumFileCount files maximum</span>
                    <span>@OperatorLabels.FileSize(UploadModel.MaximumFileBytes) per file</span>
                    <span>@OperatorLabels.FileSize(UploadModel.MaximumTotalBytes) per upload</span>
                </div>
                @* Opened from a Case page: the destination is already decided
                   and travels with the files. The card alone says where the
                   files go; it stays in view while files are chosen. *@
                @if (declaredCase is not null)
                {
                    <div class="up-declared" data-upload-declared>
                        <p class="up-eyebrow">@Labels.AddingTo</p>
                        <partial name="Shared/_UploadDestinationCard" model="@declaredCase" />
                    </div>
                }
            </div>
            @if (declaredCase is not null)
            {
                <div class="record-head-end">
                    <a class="btn" href="@declaredCase.Url">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-right")" /></svg>
                        <span>@Labels.BackToCase(declaredCase.Reference)</span>
                    </a>
                </div>
            }
        </header>
        <div class="record-accent"></div>
        <div class="record-body">
            @if (Model.DestinationUnavailable)
            {
                <div class="up-alert" role="status" data-upload-declared-unavailable>
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-circle")" /></svg>
                    <div><strong>@Labels.DestinationUnavailable</strong></div>
                </div>
            }
            @if (errors.Length > 0)
            {
                <div class="up-alert up-alert--error" role="alert" tabindex="-1">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-circle")" /></svg>
                    <div>
                        <strong>@Labels.CheckFiles</strong>
                        @foreach (var message in errors)
                        {
                            <p>@message</p>
                        }
                    </div>
                </div>
            }
            <partial name="Shared/_UploadPicker" model="@(declaredCase is not null)" />
        </div>
        @* A native reset empties the file input with no script at all;
           upload.js also empties its own roster on reset. *@
        <footer class="record-bar" data-select-actions>
            <p data-select-summary></p>
            <div class="record-bar-end">
                <button type="reset" class="btn">@Labels.Clear</button>
                <button type="submit" class="btn btn--primary" data-select-submit data-busy-label="@OperatorLabels.Busy.Uploading">
                    <span data-select-submit-label>@Labels.UploadFiles(1)</span>
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-right")" /></svg>
                </button>
            </div>
        </footer>
    </form>
</div>

@section Scripts {
    <script src="~/js/upload.js" asp-append-version="true"></script>
}
