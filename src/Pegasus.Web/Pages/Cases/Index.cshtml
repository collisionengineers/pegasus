@page
@using Pegasus.Core.Workflow
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Cases.IndexModel
@{
    ViewData["Title"] = "Cases";

    // Refreshing reruns the scope, its filters, the page and the selected
    // row, not page one of everything.
    ViewData["RefreshFields"] = new Dictionary<string, string?>
    {
        ["tab"] = Model.Queue,
        ["principal"] = Model.PrincipalFilter,
        ["missing"] = Model.ShowingNotReady ? Model.MissingFilter : null,
        ["show"] = Model.ShowFilter,
        ["page"] = Model.CurrentPage > 1 ? Model.CurrentPage.ToString() : null,
        ["selected"] = Model.SelectedId?.ToString("D")
    };

    var hasFilters = Model.PrincipalFilter is not null || Model.MissingFilter is not null;
    var isCaseScope = IndexModel.ListsCases(Model.Queue);
    var noun = isCaseScope || Model.Queue == "awaiting" ? "case" : "item";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cases-index.css" asp-append-version="true" />
}

<header class="page-header">
    <div class="page-title">
        <h1>Cases</h1>
    </div>
    <div class="page-actions">
        <partial name="Shared/_FreshnessBanner" model="Model.LoadedAtUtc" />
    </div>
</header>

@if (TempData["UploadConfirmationError"] is string uploadConfirmationError)
{
    <div class="validation-summary" role="alert">@uploadConfirmationError</div>
}

@if (Model.IsUnavailable)
{
    <div class="notice notice--warning" role="status" data-cases-unavailable>
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>Cases are unavailable. Refresh to run the live queues again.</span>
    </div>
}
else
{
<section class="pane-layout pane-layout--3 queue-layout cases-queue" data-cases-queue="@Model.Queue">
    <aside class="pane">
        <div class="pane-head">
            <h2>Workflow</h2>
        </div>
        @* The rail: buttons carrying tab=X in one GET form, so a scope opens
           with a plain native submit and keeps the Principal filter. Counts
           are queried figures, never placeholders. *@
        <form method="get" action="/Cases" class="scope-list">
            @if (Model.PrincipalFilter is not null)
            {
                <input type="hidden" name="principal" value="@Model.PrincipalFilter" />
            }
            @{ var groupOrdinal = 0; }
            @foreach (var group in IndexModel.Tabs.GroupBy(tab => tab.Group))
            {
                if (groupOrdinal++ > 0)
                {
                    <div class="queue-group-divider"></div>
                }
                <div class="queue-group-label">@group.Key</div>
                @foreach (var tab in group)
                {
                    <button type="submit" name="tab" value="@tab.Key"
                            class="scope-button @(tab.IsException ? "queue-exception" : null)"
                            aria-pressed="@(Model.Queue == tab.Key ? "true" : "false")">
                        <span class="scope-visual-icon">
                            <svg class="icon" aria-hidden="true"><use href="#@tab.Icon" /></svg>
                        </span>
                        <span>@tab.Label</span>
                        <span>@Model.Count(tab)</span>
                    </button>
                }
            }
        </form>
    </aside>

    <div class="pane cases-list">
        @if (isCaseScope)
        {
            @* Selects submit on change; the button is the no-script path. The
               Principal select exists only where Principal rows are listed, and
               the Missing select only on Not ready. *@
            <form method="get" class="filter-bar cases-filters" data-auto-submit>
                <input type="hidden" name="tab" value="@Model.Queue" />
                <div class="field">
                    <label for="queue-principal">Principal</label>
                    <select id="queue-principal" name="principal">
                        <option value="">All principals</option>
                        @foreach (var principal in Model.Principals)
                        {
                            <option value="@principal" selected="@(Model.PrincipalFilter == principal ? "selected" : null)">@principal</option>
                        }
                    </select>
                </div>
                @if (Model.ShowingNotReady)
                {
                    <div class="field">
                        <label for="queue-missing">Missing</label>
                        <select id="queue-missing" name="missing">
                            <option value="">All</option>
                            <option value="instructions" selected="@(Model.MissingFilter == "instructions" ? "selected" : null)">Instructions</option>
                            <option value="images" selected="@(Model.MissingFilter == "images" ? "selected" : null)">Images</option>
                            <option value="both" selected="@(Model.MissingFilter == "both" ? "selected" : null)">Both missing</option>
                        </select>
                    </div>
                }
                <noscript><button type="submit" class="btn">Apply</button></noscript>
                @if (hasFilters)
                {
                    <a class="btn" href="@Model.Href(tab: Model.Queue, keepFilters: false)">Clear</a>
                }
            </form>
        }
        else if (Model.Queue == "unidentified")
        {
            <form method="get" class="filter-bar cases-filters" data-auto-submit>
                <input type="hidden" name="tab" value="unidentified" />
                <div class="field">
                    <label for="queue-show">Show</label>
                    <select id="queue-show" name="show" data-cases-show>
                        <option value="open">Open items</option>
                        <option value="closed" selected="@(Model.ShowingClosed ? "selected" : null)">Closed items</option>
                    </select>
                </div>
                <noscript><button type="submit" class="btn">Apply</button></noscript>
            </form>
        }
        <div class="pane-head">
            <h2>@Model.CurrentTab.Label</h2>
            <span class="meta">@Model.Rows.Count @(noun)@(Model.Rows.Count == 1 ? string.Empty : "s")</span>
        </div>
        <div class="cases-table" data-row-list>
            @if (Model.Rows.Count == 0)
            {
                <div class="cases-empty">@(Model.ShowingClosed ? "No closed items" : isCaseScope ? "No cases in this queue" : Model.Queue == "triage" ? "No open Triage" : Model.Queue == "awaiting" ? "No images awaiting an instruction" : "Nothing Unidentified")</div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            @foreach (var column in Model.Columns)
                            {
                                <th scope="col">@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr data-cases-row="@row.Id" data-select-url="@Model.Href(selected: row.Id)"
                                aria-selected="@(Model.SelectedId == row.Id ? "true" : "false")">
                                @foreach (var cell in row.Cells)
                                {
                                    switch (cell.Kind)
                                    {
                                        case IndexModel.CellKind.Link:
                                            <td class="mono nowrap">
                                                <a class="table-row-link" href="@row.DetailHref">@cell.Text</a>
                                                @if (row.Kind == IndexModel.RowKind.Case && row.Notice is { } typeChip)
                                                {
                                                    <span class="status status--navy" data-cases-type>@typeChip</span>
                                                }
                                            </td>
                                            break;
                                        case IndexModel.CellKind.Mono:
                                            <td class="mono nowrap">@cell.Text</td>
                                            break;
                                        case IndexModel.CellKind.Late:
                                            <td class="nowrap cases-late">@cell.Text</td>
                                            break;
                                        case IndexModel.CellKind.Date:
                                            <td class="nowrap">@cell.Text</td>
                                            break;
                                        case IndexModel.CellKind.Chip:
                                            <td>
                                                <partial name="Shared/_StatusChip" model="@cell.Text"
                                                         view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = cell.Tone }' />
                                            </td>
                                            break;
                                        default:
                                            <td>@cell.Text</td>
                                            break;
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <nav class="pagination" aria-label="Pages">
            <span>Page @Model.CurrentPage · newest first</span>
            <div class="button-row">
                @if (Model.HasPreviousPage)
                {
                    <a class="btn btn--small" href="@Model.Href(page: Model.CurrentPage - 1)">Previous</a>
                }
                @if (Model.HasNextPage)
                {
                    <a class="btn btn--small" href="@Model.Href(page: Model.CurrentPage + 1)">Next</a>
                }
            </div>
        </nav>
    </div>

    <div class="pane cases-detail">
        <div class="pane-head">
            <h2>Quick detail</h2>
            @if (Model.Selected is { } head)
            {
                <a class="btn btn--small btn--dark" href="@head.DetailHref">
                    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
                    <span>@head.OpenLabel</span>
                </a>
            }
        </div>
        <div class="pane-body">
            @if (Model.Selected is { } detail)
            {
                <div class="detail-canvas stack" data-cases-detail="@detail.Kind">
                    <div>
                        <p class="eyebrow">@detail.Eyebrow</p>
                        <h2>@detail.Heading</h2>
                    </div>
                    @if (detail.Notice is { } notice)
                    {
                        <div class="notice notice--@(detail.NoticeTone ?? "info")" data-cases-notice>
                            <svg class="icon" aria-hidden="true"><use href="#@(detail.NoticeTone == "success" ? "icon-check-circle" : "icon-alert-triangle")" /></svg>
                            <span>@notice</span>
                        </div>
                    }
                    <dl class="fact-grid cases-facts">
                        @foreach (var fact in detail.Facts)
                        {
                            <div class="fact"><dt>@fact.Label</dt><dd class="@(fact.Label is "Case/PO" or "Registration" or "Reference" or "Image reference" ? "mono" : null)">@fact.Value</dd></div>
                        }
                        @if (detail.StateChip is { } stateChip)
                        {
                            <div class="fact">
                                <dt>State</dt>
                                <dd><partial name="Shared/_StatusChip" model="@stateChip"
                                             view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = detail.StateTone }' /></dd>
                            </div>
                        }
                    </dl>
                    @if (detail.Outstanding is { Count: > 0 })
                    {
                        <section>
                            <h3 class="section-label">Outstanding requirements</h3>
                            <ul class="blocker-list">
                                @foreach (var requirement in detail.Outstanding)
                                {
                                    <li class="blocker">
                                        <strong>@requirement.Requirement</strong>
                                        <small>@requirement.Resolve</small>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                    @if (detail.Work is { Count: > 0 })
                    {
                        <div class="cases-work">
                            @foreach (var fact in detail.Work)
                            {
                                <div class="decision-row">
                                    <span>@fact.Label</span>
                                    <strong>@fact.Value</strong>
                                </div>
                            }
                        </div>
                    }
                    @if (detail.Kind == IndexModel.RowKind.Image && detail.OriginReceiptId is { } receiptId)
                    {
                        @if (Model.SelectedImageSubmissionGroupId is { } groupId)
                        {
                            <div class="button-row">
                                <a class="btn btn--dark" href="/Upload/Group/@groupId">
                                    Continue with this submission
                                </a>
                            </div>
                        }
                        else
                        {
                            var confirmation = Model.UploadCaseConfirmation;
                            var draft = Model.UploadCaseDraft;
                            var isConfirmation = confirmation?.ReceiptId == receiptId;
                            <form method="post" asp-page-handler="Attach">
                                <input type="hidden" name="id" value="@Model.SelectedId" />
                                <input type="hidden" name="receiptId" value="@receiptId" />
                                <input type="hidden" name="operationId" value="@(isConfirmation ? confirmation!.Input.OperationId : draft?.OperationId ?? Guid.NewGuid())" />
                                <input type="hidden" name="receiptVersion" value="@(isConfirmation ? confirmation!.Input.ExpectedReceiptVersion : draft?.ExpectedReceiptVersion ?? Model.SelectedImageReceiptVersion)" />
                                <input type="hidden" name="caseId" value="@(isConfirmation ? confirmation!.CaseId : draft?.CaseId)" />
                                <input type="hidden" name="caseVersion" value="@(isConfirmation ? confirmation!.Input.ExpectedCaseVersion : draft?.ExpectedCaseVersion)" />
                                <div class="field">
                                    <label for="attach-reference">Case reference</label>
                                    <input id="attach-reference" name="reference" required maxlength="60"
                                           value="@(isConfirmation ? confirmation!.Reference : draft?.Reference)"
                                           readonly="@(isConfirmation ? "readonly" : null)" />
                                </div>
                                <div class="button-row section-gap">
                                    <button type="submit" class="btn btn--dark">@(isConfirmation ? "Confirm and add to this case" : "Add to an existing case")</button>
                                    <a class="btn" asp-page="/Cases/Create">Create Case</a>
                                </div>
                            </form>
                        }
                    }
                </div>
            }
            else
            {
                <div class="cases-empty">Select a row</div>
            }
        </div>
    </div>
</section>
}

@section Scripts {
    <script src="~/js/cases-index.js" asp-append-version="true"></script>
}
