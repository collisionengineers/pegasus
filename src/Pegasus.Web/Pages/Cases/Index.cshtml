@page
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Cases.IndexModel
@{
    ViewData["Title"] = "Cases";

    // Refreshing reruns the queue, its filter, and the page the operator is
    // on, not page one of everything.
    ViewData["RefreshFields"] = new Dictionary<string, string?>
    {
        ["tab"] = Model.Queue,
        ["state"] = Model.StateFilter,
        ["kind"] = Model.ShowingUnidentified ? Model.UnidentifiedKind : null,
        ["origin"] = Model.ShowingNotReady ? Model.NotReadyOrigin : null,
        ["principal"] = Model.ShowingNotReady ? Model.PrincipalFilter : null,
        ["sort"] = Model.SortParam,
        ["page"] = Model.CurrentPage > 1 ? Model.CurrentPage.ToString() : null
    };
}

@* "Triage queue" spent a reserved business term on a screen that is mostly not
   about Triage-type work. Not ready, Review, Held and Triage are joined by
   Unidentified — unresolved retained material, not a case stage, but queue
   work the same way the other four are. *@
<header class="page-heading">
    <h1>Cases</h1>
    @* Every count on this screen says when it was last read. *@
    <partial name="Shared/_FreshnessBanner" model="Model.LoadedAtUtc" />
</header>

<nav class="tabs" aria-label="Case workflow">
    <a asp-page="/Cases/Index" asp-route-tab="not_ready"
       aria-current="@(Model.Queue == "not_ready" ? "page" : null)">
        Not ready <span class="count">@Model.StageCounts.NotReady</span>
    </a>
    <a asp-page="/Cases/Index" asp-route-tab="review"
       aria-current="@(Model.Queue == "review" ? "page" : null)">
        Review <span class="count">@Model.StageCounts.Review</span>
    </a>
    <a asp-page="/Cases/Index" asp-route-tab="held"
       aria-current="@(Model.Queue == "held" ? "page" : null)">
        Held <span class="count">@Model.StageCounts.Held</span>
    </a>
    <a asp-page="/Cases/Index" asp-route-tab="triage"
       aria-current="@(Model.ShowingTriage ? "page" : null)">
        Triage <span class="count">@Model.Results.TotalCount</span>
    </a>
    <a asp-page="/Cases/Index" asp-route-tab="unidentified"
       aria-current="@(Model.ShowingUnidentified ? "page" : null)">
        Unidentified <span class="count">@Model.UnidentifiedCount</span>
    </a>
</nav>

@if (Model.ShowingTriage)
{
    @* The triage record's own lifecycle, as sub-states of this tab. At page
       level these read as case stages, which they are not. *@
    <nav class="subtabs section-gap" aria-label="Triage states">
        <a asp-page="/Cases/Index" asp-route-tab="triage"
           aria-current="@(Model.StateFilter is null ? "page" : null)">All open</a>
        <a asp-page="/Cases/Index" asp-route-tab="triage" asp-route-state="open"
           aria-current="@(Model.StateFilter == "open" ? "page" : null)">Open</a>
        <a asp-page="/Cases/Index" asp-route-tab="triage" asp-route-state="awaiting_information"
           aria-current="@(Model.StateFilter == "awaiting_information" ? "page" : null)">Awaiting information</a>
        <a asp-page="/Cases/Index" asp-route-tab="triage" asp-route-state="finding_recorded"
           aria-current="@(Model.StateFilter == "finding_recorded" ? "page" : null)">Finding recorded</a>
        <a asp-page="/Cases/Index" asp-route-tab="triage" asp-route-state="completed"
           aria-current="@(Model.StateFilter == "completed" ? "page" : null)">Completed</a>
        <a asp-page="/Cases/Index" asp-route-tab="triage" asp-route-state="cancelled"
           aria-current="@(Model.StateFilter == "cancelled" ? "page" : null)">Cancelled</a>
    </nav>

    @* The table is the surface, not something sitting on one: a panel around a
       bordered table draws a second box around the first. *@
    @if (Model.Results.Items.Count == 0)
    {
        <div class="mark-empty">
            <img class="mark mark--md" src="~/images/marks/checkmark.png" asp-append-version="true" alt="" aria-hidden="true" />
            <p class="empty-state">No triage work is open.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <caption class="vh">Triage work, most recently opened first</caption>
                <thead>
                    <tr>
                        <th scope="col">Registration</th>
                        <th scope="col">Opened</th>
                        <th scope="col">State</th>
                        <th scope="col">Assigned to</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Results.Items)
                {
                    <tr>
                        @* A triage record is pre-case, so the row leads
                           with the registration rather than a case
                           reference most rows will not have. *@
                        <td><a asp-page="/Triage/Details" asp-route-id="@item.Id">@item.NormalizedVehicleRegistration</a></td>
                        <td><time datetime="@item.CreatedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(item.CreatedAtUtc)</time></td>
                        <td><partial name="Shared/_StatusChip" model="@Pegasus.Web.Pages.Cases.IndexModel.StateLabel(item.State)" /></td>
                        <td>@(item.AssigneeId is null ? "Unassigned" : "Assigned")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
else if (Model.ShowingUnidentified)
{
    @* Images vs. e-mails is the operator's own split: "the material behind
       this row" not "the record type behind this row". *@
    <nav class="subtabs section-gap" aria-label="Unidentified filters">
        <a asp-page="/Cases/Index" asp-route-tab="unidentified"
           aria-current="@(Model.UnidentifiedKind == "all" ? "page" : null)">All</a>
        <a asp-page="/Cases/Index" asp-route-tab="unidentified" asp-route-kind="images"
           aria-current="@(Model.UnidentifiedKind == "images" ? "page" : null)">Images</a>
        <a asp-page="/Cases/Index" asp-route-tab="unidentified" asp-route-kind="emails"
           aria-current="@(Model.UnidentifiedKind == "emails" ? "page" : null)">E-mails</a>
    </nav>

    @if (Model.UnidentifiedRows.Count == 0)
    {
        <div class="mark-empty">
            <img class="mark mark--md" src="~/images/marks/checkmark.png" asp-append-version="true" alt="" aria-hidden="true" />
            <p class="empty-state">No Unidentified material matches this view.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <caption class="vh">Unidentified material, oldest first</caption>
                <thead>
                    <tr>
                        <th scope="col">Reference</th>
                        <th scope="col">Kind</th>
                        <th scope="col">Concerns</th>
                        <th scope="col">Received</th>
                        <th scope="col">Reason</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.UnidentifiedRows)
                {
                    <tr>
                        <td><a asp-page="/Unidentified/Details" asp-route-id="@row.Id">@row.Reference</a></td>
                        <td>@Pegasus.Web.Pages.Cases.IndexModel.UnidentifiedKindLabel(row)</td>
                        <td>@Pegasus.Web.Pages.Cases.IndexModel.UnidentifiedHandle(row)</td>
                        <td><time datetime="@row.ReceivedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(row.ReceivedAtUtc)</time></td>
                        <td>@Pegasus.Web.Pages.Cases.IndexModel.UnidentifiedReasonLabel(row)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
else
{
    @if (Model.ShowingNotReady)
    {
        @* Dropdown filters, not pills: origin in the operator's own words
           (what the case is waiting for), and the principals present in the
           queue. Selects submit on change; the button is the no-script path. *@
        <form method="get" class="filter-row section-gap" data-auto-submit>
            <input type="hidden" name="tab" value="not_ready" />
            @if (!string.IsNullOrEmpty(Model.SortParam))
            {
                <input type="hidden" name="sort" value="@Model.SortParam" />
            }
            <label>Waiting for
                <select name="origin">
                    <option value="">All</option>
                    <option value="instruction" selected="@(Model.NotReadyOrigin == "instruction" ? "selected" : null)">Awaiting images</option>
                    <option value="image" selected="@(Model.NotReadyOrigin == "image" ? "selected" : null)">Awaiting instructions</option>
                </select>
            </label>
            <label>Principal
                <select name="principal">
                    <option value="">All</option>
                    @foreach (var principal in Model.Principals)
                    {
                        <option value="@principal" selected="@(Model.PrincipalFilter == principal ? "selected" : null)">@principal</option>
                    }
                </select>
            </label>
            <noscript><button type="submit" class="btn">Apply</button></noscript>
        </form>

        @if (Model.NotReadyRows.Count == 0)
        {
            <div class="mark-empty">
                <img class="mark mark--md" src="~/images/marks/checkmark.png" asp-append-version="true" alt="" aria-hidden="true" />
                <p class="empty-state">No cases are waiting.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <caption class="vh">Cases waiting, both origins in one table</caption>
                    <thead>
                        <tr>
                            <th scope="col" aria-sort='@Model.AriaSort("reference")'><a asp-page="/Cases/Index" asp-route-tab="not_ready" asp-route-origin="@Model.OriginFilter" asp-route-principal="@Model.PrincipalFilter" asp-route-sort='@Model.NextSort("reference")'>Reference</a></th>
                            <th scope="col" aria-sort='@Model.AriaSort("registration")'><a asp-page="/Cases/Index" asp-route-tab="not_ready" asp-route-origin="@Model.OriginFilter" asp-route-principal="@Model.PrincipalFilter" asp-route-sort='@Model.NextSort("registration")'>Registration</a></th>
                            <th scope="col" aria-sort='@Model.AriaSort("claimant")'><a asp-page="/Cases/Index" asp-route-tab="not_ready" asp-route-origin="@Model.OriginFilter" asp-route-principal="@Model.PrincipalFilter" asp-route-sort='@Model.NextSort("claimant")'>Claimant</a></th>
                            <th scope="col" aria-sort='@Model.AriaSort("principal")'><a asp-page="/Cases/Index" asp-route-tab="not_ready" asp-route-origin="@Model.OriginFilter" asp-route-principal="@Model.PrincipalFilter" asp-route-sort='@Model.NextSort("principal")'>Principal</a></th>
                            <th scope="col">Status</th>
                            <th scope="col" aria-sort='@Model.AriaSort("received")'><a asp-page="/Cases/Index" asp-route-tab="not_ready" asp-route-origin="@Model.OriginFilter" asp-route-principal="@Model.PrincipalFilter" asp-route-sort='@Model.NextSort("received")'>Received</a></th>
                            <th scope="col">Chase</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.NotReadyRows)
                    {
                        <tr>
                            <td><a asp-page="@row.DetailsPage" asp-route-id="@row.Id">@row.Reference</a></td>
                            <td>@(row.Registration ?? "—")</td>
                            <td>@(row.Claimant ?? "—")</td>
                            <td>@(row.Principal ?? "—")</td>
                            <td>@row.Status</td>
                            <td><time datetime="@row.ReceivedAtUtc.ToString("O")">@OperatorLabels.OfficeDate(row.ReceivedAtUtc)</time></td>
                            <td>
                                @if (row.IsImageInitiated)
                                {
                                    @* TICK-065: the image half has no persisted chase
                                       machinery — a derived due/not-due read on the
                                       registration date (ImageIntakeChaseSchedule). *@
                                    <partial name="Shared/_StatusChip" model="@OperatorLabels.ImageChaseState(Model.IsImageIntakeChaseDue(row.ReceivedAtUtc))" />
                                }
                                else if (row.NextChaseAtUtc is { } chase)
                                {
                                    @OperatorLabels.OfficeDate(chase)
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        if (Model.Cases.Items.Count == 0)
        {
            <div class="mark-empty">
                <img class="mark mark--md" src="~/images/marks/checkmark.png" asp-append-version="true" alt="" aria-hidden="true" />
                <p class="empty-state">
                    @(Model.Queue == "held" ? "No cases are held." : "No cases are ready to confirm.")
                </p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <caption class="vh">Cases in this queue</caption>
                    <thead>
                        <tr>
                            <th scope="col" aria-sort='@Model.AriaSort("reference")'><a asp-page="/Cases/Index" asp-route-tab="@Model.Queue" asp-route-sort='@Model.NextSort("reference")'>Case</a></th>
                            <th scope="col" aria-sort='@Model.AriaSort("registration")'><a asp-page="/Cases/Index" asp-route-tab="@Model.Queue" asp-route-sort='@Model.NextSort("registration")'>Registration</a></th>
                            <th scope="col" aria-sort='@Model.AriaSort("claimant")'><a asp-page="/Cases/Index" asp-route-tab="@Model.Queue" asp-route-sort='@Model.NextSort("claimant")'>Claimant</a></th>
                            <th scope="col" aria-sort='@Model.AriaSort("principal")'><a asp-page="/Cases/Index" asp-route-tab="@Model.Queue" asp-route-sort='@Model.NextSort("principal")'>Principal</a></th>
                            <th scope="col" aria-sort='@Model.AriaSort("received")'><a asp-page="/Cases/Index" asp-route-tab="@Model.Queue" asp-route-sort='@Model.NextSort("received")'>Received</a></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Cases.Items)
                    {
                        <tr>
                            <td><a asp-page="/Cases/Details" asp-route-id="@item.CaseId">@item.Reference</a></td>
                            <td>@(item.Registration ?? "—")</td>
                            <td>@(item.Claimant ?? "—")</td>
                            <td>@item.Principal</td>
                            <td><time datetime="@item.ReceivedAtUtc.ToString("O")">@OperatorLabels.OfficeDate(item.ReceivedAtUtc)</time></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
}

@if (Model.ShowingTriage && Model.Results.TotalPages > 1)
{
    <nav class="pager" aria-label="Pages">
        @if (Model.Results.Page > 1)
        {
            <a asp-page="/Cases/Index" asp-route-tab="triage" asp-route-state="@Model.StateFilter" asp-route-page="@(Model.Results.Page - 1)">Previous</a>
        }
        <span class="pager__context">Page @Model.Results.Page of @Model.Results.TotalPages</span>
        @if (Model.Results.Page < Model.Results.TotalPages)
        {
            <a asp-page="/Cases/Index" asp-route-tab="triage" asp-route-state="@Model.StateFilter" asp-route-page="@(Model.Results.Page + 1)">Next</a>
        }
    </nav>
}
