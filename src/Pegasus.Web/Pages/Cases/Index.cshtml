@page
@model Pegasus.Web.Pages.Cases.IndexModel
@using Pegasus.Core.Workflow
@{
    ViewData["Title"] = "Cases";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Case workspace</p>
        <h1>Cases</h1>
        <p class="lede">Search the cases you are authorised to access. Filters remain in the URL when you move between result pages.</p>
    </div>
</header>

<section class="panel form-panel form-panel--wide" aria-labelledby="case-filters-title">
    <h2 id="case-filters-title" class="section-label">Filter cases</h2>
    <form method="get">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid">
            <div>
                <label for="case-reference">Case/PO</label>
                <input id="case-reference" name="case" value="@Model.CaseReference" maxlength="100" />
            </div>
            <div>
                <label asp-for="Registration">Registration</label>
                <input asp-for="Registration" maxlength="20" />
            </div>
            <div>
                <label asp-for="Claimant">Claimant</label>
                <input asp-for="Claimant" maxlength="300" />
            </div>
            <div>
                <label asp-for="ClaimNumber">Claim number</label>
                <input asp-for="ClaimNumber" maxlength="100" />
            </div>
            <div>
                <label asp-for="Principal">Principal</label>
                <input asp-for="Principal" maxlength="20" />
            </div>
            <div>
                <label asp-for="State">State</label>
                <select asp-for="State">
                    <option value="">All states</option>
                    @foreach (var state in Enum.GetValues<CaseLifecycleState>())
                    {
                        <option value="@state">@state</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="EngineerId">Engineer ID</label>
                <input asp-for="EngineerId" type="text" />
                <span asp-validation-for="EngineerId" class="field-validation"></span>
            </div>
            <div>
                <label asp-for="ReceivedDate">Received date</label>
                <input asp-for="ReceivedDate" type="date" />
                <span asp-validation-for="ReceivedDate" class="field-validation"></span>
            </div>
            <div>
                <label asp-for="InstructionDate">Instruction date</label>
                <input asp-for="InstructionDate" type="date" />
                <span asp-validation-for="InstructionDate" class="field-validation"></span>
            </div>
            <div>
                <label asp-for="FromDate">Received from</label>
                <input asp-for="FromDate" type="date" />
                <span asp-validation-for="FromDate" class="field-validation"></span>
            </div>
            <div>
                <label asp-for="ToDate">Received to</label>
                <input asp-for="ToDate" type="date" />
                <span asp-validation-for="ToDate" class="field-validation"></span>
            </div>
            <div>
                <label asp-for="Origin">Origin</label>
                <input asp-for="Origin" maxlength="100" />
            </div>
            <div>
                <label asp-for="Query">Any case text</label>
                <input asp-for="Query" maxlength="300" />
            </div>
            <div>
                <label for="record-kind">Record type</label>
                <select id="record-kind" name="kind">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.RecordKindFilter))">All</option>
                    <option value="instructions" selected="@(Model.RecordKindFilter == "instructions")">Instructions</option>
                    <option value="images" selected="@(Model.RecordKindFilter == "images")">Images</option>
                </select>
            </div>
        </div>
        <div class="button-row">
            <button type="submit" class="primary-action">Search cases</button>
            <a asp-page="/Cases/Index" class="secondary-action">Clear filters</a>
        </div>
    </form>
</section>

@if (Model.QueryFailed)
{
    <section class="status-card status-card--error" role="alert">
        <h2>Cases are unavailable</h2>
        <p>The authorised case query could not be completed. Try again.</p>
    </section>
}
else if (Model.Results is { Items.Count: 0 } && Model.ImageIntakeResults.Count == 0)
{
    <section class="panel empty-state" aria-live="polite">
        <h2>No matching cases</h2>
        <p>No authorised cases or Image intakes match the current filters. Clear a filter to widen the search.</p>
    </section>
}
else if (Model.RecordKindFilter == "images" && Model.ImageIntakeResults.Count == 0)
{
    <section class="empty-state" aria-live="polite">
        <h2>No matching Image intakes</h2>
        <p>No Image intakes match the current filters.</p>
    </section>
}

@if (Model.ImageIntakeResults.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="image-intake-results-title">
        <h2 id="image-intake-results-title" class="section-label">Image intakes</h2>
        <div class="queue-list">
            @foreach (var item in Model.ImageIntakeResults)
            {
                <a asp-page="/ImageIntake/Details" asp-route-id="@item.Id">
                    <span><strong>@item.ImageIntakeReference</strong><small>@item.NormalizedVehicleRegistration</small></span>
                    <span><strong>@Pegasus.Web.Pages.Cases.IndexModel.ImageIntakeOutcomeLabel(item)</strong><small>@item.RegisteredAtUtc.ToLocalTime().ToString("dd MMM yyyy") @item.RegisteredAtUtc.ToLocalTime().ToString("HH:mm")</small></span>
                </a>
            }
        </div>
    </section>
}

@if (Model.Results is { Items.Count: > 0 } results)
{
    <section class="panel" aria-labelledby="case-results-title">
        <h2 id="case-results-title" class="section-label">Results</h2>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Case/PO</th>
                        <th scope="col">Registration</th>
                        <th scope="col">Claimant</th>
                        <th scope="col">Claim number</th>
                        <th scope="col">Principal</th>
                        <th scope="col">State</th>
                        <th scope="col">Engineer</th>
                        <th scope="col">Received</th>
                        <th scope="col">Instruction</th>
                        <th scope="col">Origin</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in results.Items)
                    {
                        <tr>
                            <td><a asp-page="/Cases/Details" asp-route-id="@item.CaseId">@item.Reference</a></td>
                            <td>@(item.Registration ?? "Not recorded")</td>
                            <td>@(item.Claimant ?? "Not recorded")</td>
                            <td>@(item.ClaimNumber ?? "Not recorded")</td>
                            <td>@item.Principal</td>
                            <td><partial name="Shared/_StatusChip" model="@item.State.ToString()" /></td>
                            <td>@(item.EngineerId?.ToString("D") ?? "Unassigned")</td>
                            <td><time datetime="@item.ReceivedAtUtc.ToString("O")">@item.ReceivedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</time></td>
                            <td>@(item.InstructionDate?.ToString("dd MMM yyyy") ?? "Not recorded")</td>
                            <td>@item.Origin</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="pager" aria-label="Case result pages">
            @if (results.HasPreviousPage)
            {
                <a href="@Model.PageUrl(results.Page - 1)">Previous</a>
            }
            <span class="pager__context">Page @results.Page · showing @results.Items.Count</span>
            @if (results.HasNextPage)
            {
                <a href="@Model.PageUrl(results.Page + 1)">Next</a>
            }
        </nav>
    </section>
}
