@page
@using Pegasus.Core.Workflow
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Cases.IndexModel
@{
    ViewData["Title"] = "Cases";

    // Refreshing reruns the scope, its filters, the page and the selected
    // row, not page one of everything.
    ViewData["RefreshFields"] = new Dictionary<string, string?>
    {
        ["tab"] = Model.Queue,
        ["principal"] = Model.PrincipalFilter,
        ["missing"] = Model.ShowingNotReady ? Model.MissingFilter : null,
        ["page"] = Model.CurrentPage > 1 ? Model.CurrentPage.ToString() : null,
        ["selected"] = Model.SelectedId?.ToString("D")
    };

    var hasFilters = Model.PrincipalFilter is not null || Model.MissingFilter is not null;
}

@* One page for the whole case workflow: the rail's groups are where the work
   is, each count a queried figure, and the panes read the open group beside
   the row the operator selected. *@
<header class="page-header">
    <div class="page-title">
        <h1>Cases</h1>
    </div>
    <div class="page-actions">
        <partial name="Shared/_FreshnessBanner" model="Model.LoadedAtUtc" />
    </div>
</header>

@if (TempData["UploadConfirmationError"] is string uploadConfirmationError)
{
    <div class="alert alert--error" role="alert">@uploadConfirmationError</div>
}

@if (IndexModel.ListsCases(Model.Queue))
{
    @* Selects submit on change; the button is the no-script path. The
       Principal select exists only where Principal rows are listed, and the
       Missing select only on Not ready — a control that filters nothing is
       never drawn. *@
    <form method="get" class="filter-bar" data-auto-submit>
        <input type="hidden" name="tab" value="@Model.Queue" />
        <div class="field">
            <label for="queue-principal">Principal</label>
            <select id="queue-principal" name="principal">
                <option value="">All</option>
                @foreach (var principal in Model.Principals)
                {
                    <option value="@principal" selected="@(Model.PrincipalFilter == principal ? "selected" : null)">@principal</option>
                }
            </select>
        </div>
        @if (Model.ShowingNotReady)
        {
            <div class="field">
                <label for="queue-missing">Missing</label>
                <select id="queue-missing" name="missing">
                    <option value="">All</option>
                    <option value="instructions" selected="@(Model.MissingFilter == "instructions" ? "selected" : null)">Instructions</option>
                    <option value="images" selected="@(Model.MissingFilter == "images" ? "selected" : null)">Images</option>
                    <option value="both" selected="@(Model.MissingFilter == "both" ? "selected" : null)">Both missing</option>
                </select>
            </div>
        }
        <noscript><button type="submit" class="btn">Apply</button></noscript>
        @if (hasFilters)
        {
            <a class="btn" href="@Model.Href(tab: Model.Queue, keepFilters: false)">Clear</a>
        }
    </form>
}

<section class="pane-layout pane-layout--3 queue-layout">
    <aside class="pane">
        <div class="pane-head">
            <h2>Case workflow</h2>
        </div>
        @* The rail is the shape the design system styles for a pressed
           scope: buttons carrying tab=X, in one GET form, so a scope opens
           with a plain native submit and keeps the Principal filter. Counts
           are queried figures, never placeholders. *@
        <form method="get" action="/Cases" class="scope-list" data-row-list>
            @if (Model.PrincipalFilter is not null)
            {
                <input type="hidden" name="principal" value="@Model.PrincipalFilter" />
            }
            @{ var groupOrdinal = 0; }
            @foreach (var group in IndexModel.Tabs.GroupBy(tab => tab.Group))
            {
                if (groupOrdinal++ > 0)
                {
                    <div class="queue-group-divider"></div>
                }
                <div class="queue-group-label">@group.Key</div>
                @foreach (var tab in group)
                {
                    <button type="submit" name="tab" value="@tab.Key"
                            class="scope-button @(tab.IsException ? "queue-exception" : null)"
                            aria-pressed="@(Model.Queue == tab.Key ? "true" : "false")">
                        <span class="scope-visual-icon">
                            <svg class="icon" aria-hidden="true"><use href="#@tab.Icon" /></svg>
                        </span>
                        <span>@tab.Label</span>
                        <span>@Model.Count(tab)</span>
                    </button>
                }
            }
        </form>
    </aside>

    <div class="pane">
        <div class="pane-head">
            <div>
                <h2>@Model.CurrentTab.Label</h2>
                <span class="muted">@Model.Rows.Count item@(Model.Rows.Count == 1 ? string.Empty : "s")</span>
            </div>
        </div>
        <div class="pane-body pane-scroll" data-row-list>
            @* A row links to its detail and nothing else; the selected row
               is the one the quick detail beside it reads, marked as the
               current item of the list (aria-current, the one current-state
               token a link may legally carry). Blocked intake rows sit in
               the Unidentified scope with their own chip and no count of
               their own (D14). *@
            @foreach (var row in Model.Rows)
            {
                <a class="row-button" href="@(row.Kind == IndexModel.RowKind.Image ? Model.Href(selected: row.Id) : row.DetailHref)" aria-current="@(Model.SelectedId == row.Id ? "true" : null)">
                    <span class="row-top">
                        <span class="row-title">@row.Title</span>
                        @if (!string.IsNullOrEmpty(row.Chip))
                        {
                            <partial name="Shared/_StatusChip" model="@row.Chip" />
                        }
                    </span>
                    @if (!string.IsNullOrEmpty(row.Excerpt))
                    {
                        <span class="row-excerpt">@row.Excerpt</span>
                    }
                    <span class="row-top">
                        <span class="row-meta">@row.Meta</span>
                        @if (row.Time is { } time)
                        {
                            <span class="row-meta">@time</span>
                        }
                    </span>
                </a>
            }
        </div>
        @if (Model.HasPreviousPage || Model.HasNextPage)
        {
            <nav class="pagination" aria-label="Pages">
                @if (Model.HasPreviousPage)
                {
                    <a class="btn btn--small" href="@Model.Href(page: Model.CurrentPage - 1)">Previous</a>
                }
                <span>Page @Model.CurrentPage</span>
                @if (Model.HasNextPage)
                {
                    <a class="btn btn--small" href="@Model.Href(page: Model.CurrentPage + 1)">Next</a>
                }
            </nav>
        }
    </div>

    <div class="pane">
        <div class="pane-head">
            <h2>Quick detail</h2>
        </div>
        <div class="pane-body pane-scroll">
            @if (Model.Selected is { } detail)
            {
                <div class="detail-canvas">
                    <p class="eyebrow">@detail.Eyebrow</p>
                    <h2>@detail.Heading</h2>
                    @if (detail.Kind == IndexModel.RowKind.Case && detail.State is { } state)
                    {
                        var step = IndexModel.StepIndex(state);
                        <ol class="workflow-stepper workflow-stepper--compact" aria-label="Case workflow">
                            @for (var index = 0; index < IndexModel.Steps.Count; index++)
                            {
                                var current = IndexModel.Steps[index];
                                <li class="workflow-step @(index < step ? "is-complete" : null) @(index == step ? "is-current" : null)">
                                    <span class="workflow-step-icon">
                                        <svg class="icon" aria-hidden="true"><use href="#@(index < step ? "icon-check" : current.Icon)" /></svg>
                                    </span>
                                    <span>@current.Label</span>
                                </li>
                            }
                        </ol>
                        if (state == CaseLifecycleState.Held)
                        {
                            <div class="workflow-exception">
                                <svg class="icon" aria-hidden="true"><use href="#icon-pause" /></svg>
                                <strong>@OperatorLabels.CaseStage(CaseLifecycleState.Held)</strong>
                            </div>
                        }
                        @* Outstanding requirements are the case's recorded
                           completeness facts: the requirement and the action
                           that resolves it, nothing else. *@
                        @if (detail.Outstanding is { Count: > 0 })
                        {
                            <section class="section-gap">
                                <h3 class="section-label">Outstanding requirements</h3>
                                <ul class="blocker-list">
                                    @foreach (var requirement in detail.Outstanding)
                                    {
                                        <li class="blocker">
                                            <strong>@requirement.Requirement</strong>
                                            <small>@requirement.Resolve</small>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                        <section class="panel section-gap">
                            <div class="panel-head">
                                <h3>Current work</h3>
                            </div>
                            <div class="panel-body">
                                @foreach (var fact in detail.Facts)
                                {
                                    <div class="decision-row">
                                        <span>@fact.Label</span>
                                        <strong>@fact.Value</strong>
                                    </div>
                                }
                                <div class="button-row section-gap">
                                    <a class="btn btn--dark" href="@detail.DetailHref">
                                        <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
                                        <span>@detail.OpenLabel</span>
                                    </a>
                                </div>
                            </div>
                        </section>
                    }
                    else
                    {
                        <div class="definition-list section-gap">
                            @foreach (var fact in detail.Facts)
                            {
                                <dl class="definition">
                                    <dt>@fact.Label</dt>
                                    <dd>@fact.Value</dd>
                                </dl>
                            }
                        </div>
                        <div class="button-row section-gap">
                            <a class="btn btn--dark" href="@detail.DetailHref">
                                <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
                                <span>@detail.OpenLabel</span>
                            </a>
                        </div>
                        @if (detail.Kind == IndexModel.RowKind.Image && detail.OriginReceiptId is { } receiptId)
                        {
                            <form method="post" asp-page-handler="Attach" class="section-gap">
                                <input type="hidden" name="id" value="@Model.SelectedId" />
                                <input type="hidden" name="receiptId" value="@receiptId" />
                                <div class="field">
                                    <label for="attach-reference">Case reference</label>
                                    <input id="attach-reference" name="reference" required />
                                </div>
                                <div class="field">
                                    <label for="attach-reason">Reason</label>
                                    <textarea id="attach-reason" name="reason" required></textarea>
                                </div>
                                <div class="button-row section-gap">
                                    <button type="submit" class="btn btn--dark">Add to an existing case</button>
                                </div>
                            </form>
                        }
                    }
                </div>
            }
        </div>
    </div>
</section>
