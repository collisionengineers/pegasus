@page "/Cases/{id:guid}"
@* The record answers on `/Cases/{id}` and its section
   fragment on `/Cases/{id}/Section` (the added route in Program.cs), so a
   fragment response is never a candidate for the record's own snapshot
   states and every other handler keeps the query-string form. *@
@using Pegasus.Web.Presentation
@using Frame = Pegasus.Web.Presentation.CaseWorkspaceLabels.Frame
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    ViewData["Title"] = Model.TriageCase is { } titledTriageCase
        ? $"Triage {titledTriageCase.Reference}"
        : Model.Case is null ? "Case" : $"Case {Model.Case.Workflow.Identity.Reference}";
}

@* The sections are defined before any early return below, so every branch
   of the record — a Triage Case, an unavailable Case, the Case itself —
   loads its own stylesheet and script. *@
@section Styles {
    @if (Model.TriageCase is not null)
    {
        <link rel="stylesheet" href="~/css/triage.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/css/case-workspace.css" asp-append-version="true" />
    }
}

@section Scripts {
    @if (Model.TriageCase is null)
    {
        <script src="~/js/case-workspace.js" asp-append-version="true"></script>
    }
}

@if (Model.QueryFailed)
{
    @* The shell renders no heading of its own, so this is the page's one
       h1 in the state where the case itself cannot be drawn. *@
    <h1>Case unavailable</h1>
    <div class="notice notice--danger mb-2" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>The case could not be loaded; reload the page to try again.</span>
    </div>
    return;
}

@* A Triage Case is a Case with its own lifecycle and workspace. *@
@if (Model.TriageCase is not null)
{
    <partial name="Cases/Shared/_TriageCase" model="Model" />
    return;
}

@* Defensive only: the handler returns 404 when the case is absent or
   unauthorised, so the not-found surface is owned by the status-code page
   rather than by this view. *@
@if (Model.Case is null)
{
    return;
}

@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var summary = details.Summary;
    var editing = Model.IsEditing;
}

@* The record's notices sit above the card; each carries the shared dismiss. *@
<partial name="Cases/Shared/_CaseNotices" model="Model" />

<article class="record case-record @(editing ? "is-editing" : null)" id="case-record" data-case-record
         data-case-id="@summary.CaseId" data-case-version="@workflow.Version"
         data-editor-commit="@Model.CommittedEditorCommand"
         data-layout="@Pegasus.Web.Presentation.ShellPreferences.CaseLayout(HttpContext.Request)" data-section-current="@Model.Section"
         data-case-editing="@(editing ? "true" : "false")" data-case-view="@Model.ViewRoute">
    @* The sticky block (v26 frame rule 1): the 56px ribbon and the 40px
       section row, measured by case-workspace.js into --sticky-h. *@
    <div class="sticky-block" data-sticky-block>
        @* The ribbon: the Case's facts and its actions. *@
        <partial name="Cases/Shared/_CaseRibbon" model="Model" />
        <div class="section-row">
            <nav class="section-nav" aria-label="@OperatorLabels.CaseWorkspace.SectionNav" data-section-nav>
                @foreach (var entry in OperatorLabels.CaseWorkspace.Sections.Where(entry => Model.SectionIsShown(entry.Key)))
                {
                    <a class="section-link" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId"
                       asp-route-section="@entry.Key" asp-route-view="@Model.ViewRoute" asp-fragment="section-@entry.Key" data-section-link="@entry.Key"
                       aria-current="@(Model.SectionLinkKey == entry.Key ? "true" : "false")">
                        <svg class="icon" aria-hidden="true"><use href="#@entry.Icon" /></svg>
                        <span>@entry.Label</span>
                    </a>
                }
            </nav>
            <div class="section-tools">
                @* Refresh reruns this query on the section the operator is
                    looking at, not the Overview, and on the view it shows. *@
                @{
                    ViewData["RefreshFields"] = new Dictionary<string, string?>
                    {
                        ["section"] = Model.Section,
                        ["view"] = Model.ViewRoute
                    };
                }
                <partial name="Shared/_RefreshButton" />
                <div class="layout-switch" role="group" aria-label="Case layout" data-case-layout-switch hidden>
                    <button type="button" data-case-layout="scroll" aria-pressed="true">@Frame.Scroll</button>
                    <button type="button" data-case-layout="tabs" aria-pressed="false">@Frame.Tabs</button>
                </div>
            </div>
        </div>
    </div>

    <div class="workspace">
        <div class="workspace-main" id="case-main">
            @* The ten sections in their fixed order (D30), each a panel whose
               id the section nav addresses. A body below the fold is fetched
               as the reader approaches it; the fragment is the section itself. *@
            @foreach (var entry in OperatorLabels.CaseWorkspace.Sections)
            {
                if (entry.Key == "original-report" && !Model.IsAuditCase)
                {
                    continue;
                }
                if (Model.SectionIsDeferred(entry.Key))
                {
                    <section class="record-section panel section-placeholder @Model.ActiveTabClass(entry.Key)" id="section-@entry.Key"
                             data-section="@entry.Key" data-lazy="@entry.Key"
                             data-section-parent="@(DetailsModel.IsNestedSection(entry.Key) ? "vehicle" : null)"
                             aria-label="@entry.Label"></section>
                    continue;
                }

                switch (entry.Key)
                {
                    case "overview":
                        <partial name="Cases/Shared/_CaseOverview" model="Model" />
                        break;
                    case "claim":
                        <partial name="Cases/Shared/_CaseClaim" model="Model" />
                        break;
                    case "original-report":
                        <partial name="Cases/Shared/_CaseOriginalReport" model="Model" />
                        break;
                    case "inspection":
                        <partial name="Cases/Shared/_CaseInspectionAddress" model="Model" />
                        break;
                    case "vehicle":
                        <partial name="Cases/Shared/_CaseVehicle" model="Model" />
                        break;
                    case "damage":
                        <partial name="Cases/Shared/_CaseDamage" model="Model" />
                        break;
                    case "valuation":
                        <partial name="Cases/Shared/_CaseValuation" model="Model" />
                        break;
                    case "estimate":
                        <partial name="Cases/Shared/_CaseEstimate" model="Model" />
                        break;
                    case "settlement":
                        <partial name="Cases/Shared/_CaseSettlement" model="Model" />
                        break;
                    case "report":
                        <partial name="Cases/Shared/_CaseReport" model="Model" />
                        break;
                    case "files":
                        <partial name="Cases/Shared/_CaseFiles" model="Model" />
                        break;
                    case "notes":
                        <partial name="Cases/Shared/_CaseHistory" model="Model" />
                        break;
                }
            }
        </div>

        @* The aside (v25 decision 7): Figures and Next action, with the Views
           card once the Case has its Audit. *@
        <partial name="Cases/Shared/_CaseAside" model="Model" />
    </div>
</article>

<div data-case-viewer-host><partial name="Cases/Shared/_CaseViewer" model="Model" /></div>
<div data-case-dialogs><partial name="Cases/Shared/_CaseDialogs" model="Model" /></div>
