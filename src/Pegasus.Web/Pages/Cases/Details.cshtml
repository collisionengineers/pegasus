@page "/Cases/{id:guid}"
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    ViewData["Title"] = Model.Case is null ? "Case" : $"Case {Model.Case.Workflow.Identity.Reference}";
}

@if (Model.QueryFailed)
{
    <section class="status-card status-card--error" role="alert">
        <h1>Case unavailable</h1>
        <p>The case could not be loaded; reload the page to try again.</p>
    </section>
    return;
}

@* Defensive only: the handler returns 404 when the case is absent or
   unauthorised, so the not-found surface is owned by the status-code page
   rather than by this view. *@
@if (Model.Case is null)
{
    return;
}

@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var summary = details.Summary;
    var stage = OperatorLabels.CaseStage(workflow.State);
    var tab = Model.Tab;

    // Sending is offered only in Review. The rule is a Core precondition;
    // this control reflects it rather than defining it, and states the
    // condition instead of vanishing — the case will offer sending once it
    // reaches Review, so removing the button would say something false.
    var canSend = workflow.State == Pegasus.Core.Workflow.CaseLifecycleState.Review;
}

<nav class="crumb" aria-label="Breadcrumb">
    <a asp-page="/Cases/Index">Cases</a> / @workflow.Identity.Reference
</nav>

@* The case is one container: header band, action bar, tabs. It used to be a
   five-screen vertical stack of sibling panels the operator scrolled through.
   The lede - "Read-only evidence remains visible without edit mode. Every
   change uses the current version and an active lease where required." -
   narrated concurrency mechanics and is gone. *@
<article class="record" data-state="@(canSend ? "review" : "not-ready")">
    <header class="record__head">
        <h1>@workflow.Identity.Reference</h1>
        <span class="record__identity">
            <span><b>@workflow.Identity.PrincipalCode</b></span>
            <span>@(summary.Registration ?? "No registration")</span>
            <span>@(summary.Claimant ?? "No claimant recorded")</span>
            <span>@OperatorLabels.CaseTypeName(summary.CaseType)</span>
        </span>
        <span class="record__head-end">
            <partial name="Shared/_StatusChip" model="@stage" />
        </span>
    </header>
    <div class="record__accent"></div>

    @* The bar carries the actions valid now, and the committed one sits behind
       the rule at the end. "Actions" named no action; the things an operator
       comes here to do are editing the case and opening its assessment. *@
    <div class="record__bar">
        @if (workflow.Archive is null)
        {
            @if (!string.IsNullOrWhiteSpace(Model.LeaseToken))
            {
                <form method="post" asp-page-handler="ReleaseLease" class="record__bar-form" data-edit-toggle-off>
                    <input type="hidden" name="id" value="@summary.CaseId" />
                    <input type="hidden" name="operationKey" value="@Model.ReleaseLeaseOperationKey" />
                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                    <button type="submit" class="btn btn--dark">Finish editing</button>
                </form>
                @* Script hides this and beats instead; without script it is how
                   editing is kept. *@
                <form method="post" asp-page-handler="RenewLease" class="record__bar-form" data-edit-renew>
                    <input type="hidden" name="id" value="@summary.CaseId" />
                    <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                    <input type="hidden" name="operationKey" value="@Model.RenewLeaseOperationKey" />
                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                    <button type="submit" class="btn">Renew editing</button>
                </form>
                <partial name="Shared/_EditHeartbeat" view-data='new ViewDataDictionary(ViewData) { ["HeartbeatCaseId"] = summary.CaseId, ["HeartbeatLeaseToken"] = Model.LeaseToken }' />
            }
            else if (Model.CanRecoverLease)
            {
                <form method="post" asp-page-handler="ClaimLease" class="record__bar-form">
                    <input type="hidden" name="id" value="@summary.CaseId" />
                    <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                    <input type="hidden" name="operationKey" value="@Model.ClaimLeaseOperationKey" />
                    <button type="submit" class="btn">Recover editing</button>
                </form>
            }
            else if (details.ActiveEditLease is { } heldByOther && Model.EditAuthorityHolder is { } holder)
            {
                <span class="record__bar-note" data-edit-authority>
                    @EditModeDisplay.HeldBy(holder, Model.ViewerHoldsEditAuthority)
                    Editing cannot be taken over.
                </span>
            }
            else
            {
                <form method="post" asp-page-handler="ClaimLease" class="record__bar-form">
                    <input type="hidden" name="id" value="@summary.CaseId" />
                    <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                    <input type="hidden" name="operationKey" value="@Model.ClaimLeaseOperationKey" />
                    <button type="submit" class="btn">Edit case</button>
                </form>
            }
        }
        @if (workflow.OriginalCaseId is { } originalCaseId)
        {
            <a class="btn" asp-page="/Cases/Details" asp-route-id="@originalCaseId">Original case</a>
        }
        @if (workflow.ReplacementCaseId is { } replacementCaseId)
        {
            <a class="btn" asp-page="/Cases/Details" asp-route-id="@replacementCaseId">Replacement case</a>
        }
        @* CASE-019: the route parameter is caseId, not id. Sending id meant
           link generation had nothing to fill the route with, so the control
           rendered without an href at all and pressing it did nothing.
           EXT-04: an anchor again, and legitimately so. It was a form post
           because the export recorded the once-per-case First sent to Engineer
           proxy and a prefetched GET must not fire that. This control records
           nothing — it opens the page where the operator chooses between the
           API submission and the export, and both of those are still POSTs. *@
        <span class="gated" data-condition="@(canSend ? null : "Available in Review")">
            <a class="btn @(canSend ? string.Empty : "is-disabled")"
               asp-page="@(canSend ? "/Cases/Eva/Send" : null)"
               asp-route-caseId="@(canSend ? summary.CaseId : (Guid?)null)"
               aria-disabled="@(canSend ? "false" : "true")">
                <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                Send to EVA
            </a>
        </span>
        <span class="record__bar-end">
            <span class="record__bar-rule" aria-hidden="true"></span>
            <span class="gated" data-condition="@(Model.CanOpenAssessment ? null : "Available after the current Review export")">
                <a class="btn btn--dark @(Model.CanOpenAssessment ? string.Empty : "is-disabled")"
                   asp-page="@(Model.CanOpenAssessment ? "/Cases/Assessment/Index" : null)"
                   asp-route-id="@(Model.CanOpenAssessment ? summary.CaseId : null)"
                   aria-disabled="@(Model.CanOpenAssessment ? "false" : "true")">Open assessment</a>
            </span>
        </span>
    </div>

    <nav class="tabs" aria-label="Case sections">
        <a asp-page="/Cases/Details" asp-route-id="@summary.CaseId"
           aria-current="@(tab == "overview" ? "page" : null)">Overview</a>
        <a asp-page="/Cases/Details" asp-route-id="@summary.CaseId" asp-route-tab="evidence"
           aria-current="@(tab == "evidence" ? "page" : null)">
            Evidence <span class="count">@Model.EvidenceCount</span>
        </a>
        <a asp-page="/Cases/Details" asp-route-id="@summary.CaseId" asp-route-tab="history"
           aria-current="@(tab == "history" ? "page" : null)">
            Notes <span class="count">@details.History.Count</span>
        </a>
    </nav>

    <div class="record__body">
        @if (TempData["CaseStatus"] is string status)
        {
            <div class="status-card status-card--done" role="status">@status</div>
        }
        @if (TempData["CaseError"] is string error)
        {
            <div class="status-card status-card--error" role="alert">@error</div>
        }
        @if (TempData["CaseRequestSecret"] is string requestSecret)
        {
            <section class="panel form-panel" aria-labelledby="case-request-secret-title">
                <h2 id="case-request-secret-title" class="section-label">Copy this secret now</h2>
                <p>It is shown once and is not available from case history.</p>
                <input value="@requestSecret" readonly aria-label="One-time request secret" />
            </section>
        }

        @if (tab == "evidence")
        {
            @* One home for everything the case carries. The vehicle images
               used to sit in their own section further down the page under the
               banned term "Image intakes", and the sentence beside them said
               an association could be "reasonedly reversed", which is not a
               word. *@
            <partial name="Shared/_CaseDocuments" model="Model" />

            @if (Model.EvidenceImages.Count > 0)
            {
                <section class="section-gap" aria-labelledby="instruction-photos-title">
                    <div class="blockhead">
                        <h2 id="instruction-photos-title">Instruction photographs</h2>
                    </div>
                    @{
                        // DOCS-007: an image registered as a case document is served
                        // from Box through the case-document route. The intake-asset
                        // route remains only for a case accepted before those records
                        // existed.
                        // DOCS-011: the case-document route saves unless it is
                        // asked to display, so preview and download are two
                        // URLs. The retained-asset route already serves inline,
                        // so there both are the same and the anchor's download
                        // attribute does the saving.
                        var evidenceGallery = Model.EvidenceImages
                            .Select(image =>
                            {
                                string preview;
                                string download;
                                if (image.IsCaseDocument)
                                {
                                    download = Url.Page(
                                        "/Cases/Documents/Download",
                                        new
                                        {
                                            caseId = details.Summary.CaseId,
                                            occurrenceId = image.OccurrenceId,
                                            versionId = image.VersionId
                                        })!;
                                    preview = Url.Page(
                                        "/Cases/Documents/Download",
                                        new
                                        {
                                            caseId = details.Summary.CaseId,
                                            occurrenceId = image.OccurrenceId,
                                            versionId = image.VersionId,
                                            inline = true
                                        })!;
                                }
                                else
                                {
                                    download = Url.Page(
                                        "/Intake/Asset",
                                        new { id = image.ReceiptId, assetId = image.AssetId })!;
                                    preview = download;
                                }
                                return new Pegasus.Web.Presentation.GalleryImage(
                                    preview,
                                    download,
                                    image.FileName,
                                    image.MediaType);
                            })
                            .ToArray();
                    }
                    <partial name="Shared/_ImageGallery" model="evidenceGallery" />
                </section>
            }

            <section class="section-gap" aria-labelledby="case-images-title">
                <div class="blockhead">
                    <h2 id="case-images-title">Vehicle images</h2>
                </div>
                @if (Model.ImageIntakes.Count == 0)
                {
                    <p class="empty-state">No vehicle images yet.</p>
                }
                else
                {
                    @foreach (var image in Model.ImageIntakes)
                    {
                        <section class="section-gap">
                            <h3><a asp-page="/ImageIntake/Details" asp-route-id="@image.Id">@image.ImageIntakeReference</a></h3>
                            <p>@image.NormalizedVehicleRegistration · Registered <time datetime="@image.RegisteredAtUtc.ToString("O")">@OperatorLabels.OfficeTime(image.RegisteredAtUtc)</time></p>
                            @{
                                var intakeGallery = Model.ImagesByIntake.GetValueOrDefault(image.Id, [])
                                    .Select(item =>
                                    {
                                        var href = Url.Page("/Intake/Image", new { id = item.ReceiptId })!;
                                        return new Pegasus.Web.Presentation.GalleryImage(
                                            href,
                                            href,
                                            item.FileName,
                                            item.MediaType);
                                    })
                                    .ToArray();
                            }
                            <partial name="Shared/_ImageGallery" model="intakeGallery" />
                        </section>
                    }
                }
            </section>
        }
        else if (tab == "history")
        {
            <partial name="Shared/_CaseHistory" model="Model" />
        }
        else
        {
            <partial name="Shared/_CaseSummary" model="Model" />
            <div id="case-actions"></div>
            <partial name="Shared/_CaseWorkflow" model="Model" />
        }
    </div>
</article>

<partial name="Shared/_EvidenceViewer" />

<partial name="Shared/_EditFinishConfirm" />
