@page "/Cases/{id:guid}"
@* CASE-038: the record answers on `/Cases/{id}` and its section
   fragment on `/Cases/{id}/Section` (the added route in Program.cs), so a
   fragment response is never a candidate for the record's own snapshot
   states and every other handler keeps the query-string form. *@
@using System.Globalization
@using Pegasus.Core.AiWork
@using Pegasus.Core.Lifecycle
@using Pegasus.Core.Reports
@using Pegasus.Core.Workflow
@using Pegasus.Web.Presentation
@using Frame = Pegasus.Web.Presentation.CaseWorkspaceLabels.Frame
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    ViewData["Title"] = Model.Case is null ? "Case" : $"Case {Model.Case.Workflow.Identity.Reference}";
}

@if (Model.QueryFailed)
{
    @* The shell renders no heading of its own, so this is the page's one
       h1 in the state where the case itself cannot be drawn. *@
    <h1>Case unavailable</h1>
    <div class="notice notice--danger mb-2" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>The case could not be loaded; reload the page to try again.</span>
    </div>
    return;
}

@* Defensive only: the handler returns 404 when the case is absent or
   unauthorised, so the not-found surface is owned by the status-code page
   rather than by this view. *@
@if (Model.Case is null)
{
    return;
}

@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var summary = details.Summary;
    var state = workflow.State;
    var isClosed = CaseLifecycleRules.IsTerminal(state);
    var isHeld = state == CaseLifecycleState.Held;
    var isReview = state == CaseLifecycleState.Review;
    var isComplete = state == CaseLifecycleState.PostReportComplete;
    var isQuery = state == CaseLifecycleState.Query;
    var editing = Model.IsEditing;
    var editingCaseData = editing && !Model.IsPostReportReadOnly;
    var registration = string.IsNullOrWhiteSpace(summary.Registration)
        ? "No registration"
        : summary.Registration!;
    var canHandToEngineer = editingCaseData && isReview
        && Model.EvaHandoff is { EngineerOptions.Count: > 0 };
    var canSendToEva = (Model.EvaHandoff?.ReportGenerationPolicy is PrincipalReportGenerationPolicy.EvaZip or PrincipalReportGenerationPolicy.EvaManualApi
        || Model.EvaHandoff?.CanRetryAutomaticFailure == true)
        && state is CaseLifecycleState.Review or CaseLifecycleState.ReportPreparation or CaseLifecycleState.PostReport;
    // The confirmation is a lease-carrying Core action, so it is offered in
    // edit context only; without detected evidence there is nothing to
    // confirm (D10: a send is never asserted here).
    var canConfirmReportSent = editing
        && state == CaseLifecycleState.ReportPreparation
        && details.AvailableReportSentEvidence.Count > 0;
    var canMarkCompleted = editing && state == CaseLifecycleState.PostReport;
    var canReturnToReview = editingCaseData
        && state is CaseLifecycleState.ReportPreparation or CaseLifecycleState.PostReport;
    var canReturnToEngineer = editing && (isComplete || isQuery);
    var canArchive = editing && isClosed && workflow.Archive is null;
    // Review point 12: the adverse dispositions Core will accept for this
    // state, decided in the page model from Core's own closure rules.
    var closureOutcomes = Model.AvailableClosureOutcomes;
    var offersAdverseClosure = editing && closureOutcomes.Count > 0;
    var offersHoldGroup = editingCaseData && !isClosed;
    var offersCreateAudit = Model.CanCreateAudit;
    // The menu shows outside an edit session only when an item that needs
    // no lease is available (Send to EVA); everything else joins it inside.
    var offersActionsMenu = canSendToEva || canHandToEngineer || canConfirmReportSent || canMarkCompleted
        || canReturnToReview || canReturnToEngineer || canArchive || offersHoldGroup
        || offersCreateAudit || offersAdverseClosure;
    ViewData["WorkingSetRecord"] = new WorkingSetRecord(
        $"/Cases/{summary.CaseId:D}",
        WorkingSetRecord.Kinds.Case,
        workflow.Identity.Reference,
        summary.Registration,
        Model.WorkingSetGlyph);
    var staleGeneration = Model.CurrentReportGeneration is { State: CaseReportGenerationState.Stale };
    var next = Model.NextAction;
    var outcome = Model.AssessmentEditorValue(Pegasus.Core.Assessment.AssessmentVocabulary.Outcome)
        ?? Model.Assessment?.Field(Pegasus.Core.Assessment.AssessmentVocabulary.Outcome)?.Value;
    var salvageCategory = Model.Assessment?.Field(Pegasus.Core.Assessment.AssessmentVocabulary.SalvageCategory)?.Value;
    var legalStatus = Model.Assessment?.Field(Pegasus.Core.Assessment.AssessmentVocabulary.LegalStatus)?.Value;
    var engineerValue = Model.EngineerValue;
    var repairCost = Model.RepairCostIncVat;
    var headTools = new Pegasus.Web.Pages.Cases.CaseSectionHeadView(Model, "overview");
    string FormatMoney(decimal value) => "£" + value.ToString("N2", CultureInfo.GetCultureInfo("en-GB"));
}

@* The record's notices sit above the card; each carries the shared dismiss. *@
<div data-case-notices>
@if (TempData["CaseStatus"] is string caseStatus
    && !(editing && caseStatus == "Edit mode is active."))
{
    <div class="notice notice--success mb-2" role="status" data-confirmation>
        <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
        <span>@caseStatus</span>
        <button type="button" class="dismiss" data-dismiss aria-label="Dismiss"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
    </div>
}
@if (TempData["CaseError"] is string caseError)
{
    <div class="notice notice--danger mb-2" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>@caseError</span>
        <button type="button" class="dismiss" data-dismiss aria-label="Dismiss"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
    </div>
}
@if (TempData["CaseRequestSecret"] is string requestSecret)
{
    <section class="panel form-panel mb-2" aria-labelledby="case-request-secret-title">
        <h2 id="case-request-secret-title" class="section-label">Copy this secret now</h2>
        <p>It is shown once and is not available from case history.</p>
        <input value="@requestSecret" readonly aria-label="One-time request secret" />
    </section>
}
</div>

<article class="record case-record @(editing ? "is-editing" : null)" id="case-record" data-case-record
         data-case-id="@summary.CaseId" data-case-version="@workflow.Version"
         data-layout="scroll" data-section-current="@Model.Section"
         data-case-editing="@(editing ? "true" : "false")">
    @* The sticky block (v26 frame rule 1): the 56px ribbon and the 40px
       section row, measured by the shared helper into --sticky-h. *@
    <div class="sticky-block" data-sticky-block>
        <div class="ribbon" aria-label="Case identity">
            <div class="ribbon-facts" data-case-ribbon-facts>
                <div class="ribbon-item ribbon-ref">
                    <div class="ribbon-label">Case workspace · @registration</div>
                    <h1 class="ribbon-value">@workflow.Identity.Reference</h1>
                </div>
                <div class="ribbon-item">
                    <div class="ribbon-label">@OperatorLabels.CaseWorkspace.RibbonClaimant</div>
                    <div class="ribbon-value"><span>@(string.IsNullOrWhiteSpace(summary.Claimant) ? OperatorLabels.CaseWorkspace.AbsentValue : summary.Claimant)</span></div>
                </div>
                <div class="ribbon-item">
                    <div class="ribbon-label">@OperatorLabels.CaseWorkspace.RibbonPrincipal</div>
                    <div class="ribbon-value"><span>@workflow.Identity.PrincipalCode</span></div>
                </div>
                <div class="ribbon-item">
                    <div class="ribbon-label">@OperatorLabels.CaseWorkspace.RibbonEngineer</div>
                    <div class="ribbon-value"><span>@(Model.EngineerDisplayName ?? OperatorLabels.CaseWorkspace.AbsentValue)</span></div>
                </div>
                <div class="ribbon-chips" aria-label="@OperatorLabels.CaseWorkspace.RibbonState" data-case-ribbon-chips>
                    <partial name="Shared/_StatusChip" model="@Model.StateChipText" />
                    @if (Model.CaseTypeChip is { } caseTypeChip)
                    {
                        <span class="status status--navy status--plain" data-case-type-chip>@caseTypeChip</span>
                    }
                    @if (workflow.Archive is not null)
                    {
                        <span class="status status--red status--plain">@Frame.Archived</span>
                    }
                    @if (Model.ColleagueIsEditing && Model.EditAuthorityHolder is { } holder)
                    {
                        <span class="status status--navy status--plain" data-edit-authority>
                            <svg class="icon" aria-hidden="true"><use href="#icon-lock" /></svg>
                            @EditModeDisplay.HolderName(holder) is editing
                        </span>
                    }
                </div>
            </div>
            <div class="ribbon-actions" data-case-ribbon-actions>
                @if (Model.AuditCase is { } auditCase)
                {
                    <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@auditCase.CaseId" data-audit-link>@Frame.AuditCase @auditCase.Reference</a>
                }
                @if (Model.OriginalCase is { } originalAudit)
                {
                    <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@originalAudit.CaseId" data-original-link>@Frame.OriginalCase @originalAudit.Reference</a>
                }
                @if (workflow.OriginalCaseId is { } originalCaseId)
                {
                    <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@originalCaseId">@Frame.OriginalCase</a>
                }
                @if (workflow.ReplacementCaseId is { } replacementCaseId)
                {
                    <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@replacementCaseId">@Frame.ReplacementCase</a>
                }
                @if (editing)
                {
                    <span class="lease-line" data-lease-line hidden></span>
                    <form method="post" asp-page-handler="ReleaseLease" id="case-finish-editing-form" data-case-cancel-form hidden>
                        <input type="hidden" name="id" value="@summary.CaseId" />
                        <input type="hidden" name="operationKey" value="@Model.ReleaseLeaseOperationKey" />
                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                        <input type="hidden" name="section" value="@Model.Section" data-case-section-field />
                    </form>
                    @* Script hides this and beats instead; without script it is
                       how editing is kept. *@
                    <form method="post" asp-page-handler="RenewLease" data-case-renew>
                        <input type="hidden" name="id" value="@summary.CaseId" />
                        <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                        <input type="hidden" name="operationKey" value="@Model.RenewLeaseOperationKey" />
                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                        <button type="submit" class="btn btn--small">
                            <svg class="icon" aria-hidden="true"><use href="#icon-refresh-cw" /></svg>
                            <span>@Frame.RenewEditing</span>
                        </button>
                    </form>
                    <form method="post" asp-page-handler="HeartbeatLease" data-case-heartbeat
                          data-heartbeat-seconds="@((int)CaseEditAuthority.HeartbeatInterval.TotalSeconds)" hidden>
                        <input type="hidden" name="id" value="@summary.CaseId" />
                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                    </form>
                    <span class="status status--navy status--plain case-edit-badge">@Frame.Editing</span>
                    <button type="submit" form="case-finish-editing-form" class="btn" data-case-cancel>
                        <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                        <span>@Frame.Cancel</span>
                    </button>
                    @if (editingCaseData && details.Data is not null)
                    {
                        <button type="submit" form="case-edit-form" class="btn btn--primary" data-case-save>
                            <svg class="icon" aria-hidden="true"><use href="#icon-save" /></svg>
                            <span>@Frame.Save</span>
                        </button>
                    }
                }
                else if (Model.OwnLeaseHeldElsewhere || details.ActiveEditLease is null)
                {
                    @* One control, whether or not this operator's own earlier lease is
                       still live: the claim replays it (EfCaseWorkflowStore.ClaimAsync
                       returns the retained token for the same operation key). A
                       person's own second window reads Take over; a colleague's live
                       lease renders no control at all. *@
                    <form method="post" asp-page-handler="ClaimLease" data-case-edit-form>
                        <input type="hidden" name="id" value="@summary.CaseId" />
                        <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                        <input type="hidden" name="operationKey" value="@Model.ClaimLeaseOperationKey" />
                        <input type="hidden" name="section" value="@Model.Section" data-case-section-field />
                        <button type="submit" class="btn btn--dark" data-case-edit>
                            <svg class="icon" aria-hidden="true"><use href="#icon-pencil" /></svg>
                            <span>@(Model.OwnLeaseHeldElsewhere ? Frame.TakeOver : Model.IsPostReportReadOnly ? Frame.EnableReturn : Frame.EditCase)</span>
                        </button>
                    </form>
                }
                @if (offersActionsMenu)
                {
                    <details class="menu" data-menu data-case-actions>
                        <summary class="btn"><span>@Frame.Actions</span><svg class="icon" aria-hidden="true"><use href="#icon-chevron-down" /></svg></summary>
                        <div class="menu-body">
                            @if (canHandToEngineer)
                            {
                                <button type="button" class="btn" data-dialog-open="case-handoff-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
                                    <span>@CaseWorkspaceLabels.HandToEngineer</span>
                                </button>
                            }
                            @if (canSendToEva)
                            {
                                @* A real link to the fallback page the dialog's own form
                                   posts to (/Cases/Eva/Send), so the handoff is reachable
                                   with script disabled and enhanced into a dialog. *@
                                <a class="btn" asp-page="/Cases/Eva/Send" asp-route-caseId="@workflow.CaseId" data-dialog-open="eva-handoff-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                                    <span>@OperatorLabels.CaseWorkspace.SendToEva</span>
                                </a>
                            }
                            @if (canConfirmReportSent)
                            {
                                <button type="button" class="btn" data-dialog-open="case-report-sent-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-send" /></svg>
                                    <span>@Frame.MarkReportSent</span>
                                </button>
                            }
                            @if (canMarkCompleted)
                            {
                                <button type="button" class="btn" data-dialog-open="case-complete-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                                    <span>@Frame.MarkCompleted</span>
                                </button>
                            }
                            @if (canReturnToReview)
                            {
                                <button type="button" class="btn" data-dialog-open="case-return-review-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-chevron-left" /></svg>
                                    <span>@Frame.ReturnToReview</span>
                                </button>
                            }
                            @if (canReturnToEngineer)
                            {
                                <button type="button" class="btn" data-dialog-open="case-return-engineer-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-chevron-left" /></svg>
                                    <span>@Frame.ReturnToEngineer</span>
                                </button>
                            }
                            @if (canArchive)
                            {
                                <button type="button" class="btn" data-dialog-open="case-archive-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-archive" /></svg>
                                    <span>@Frame.ArchiveCase</span>
                                </button>
                            }
                            @if (offersHoldGroup || offersCreateAudit)
                            {
                                @if (canHandToEngineer || canSendToEva || canConfirmReportSent || canMarkCompleted || canReturnToReview || canReturnToEngineer || canArchive)
                                {
                                    <div class="menu-sep"></div>
                                }
                                @if (offersHoldGroup)
                                {
                                    @if (isHeld)
                                    {
                                        <button type="button" class="btn" data-dialog-open="case-release-hold-dialog">
                                            <svg class="icon" aria-hidden="true"><use href="#icon-play" /></svg>
                                            <span>@Frame.ReleaseHold</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn" data-dialog-open="case-hold-dialog">
                                            <svg class="icon" aria-hidden="true"><use href="#icon-pause" /></svg>
                                            <span>@Frame.PlaceOnHold</span>
                                        </button>
                                    }
                                    <form method="post" asp-page="/Cases/Custody" asp-route-id="@summary.CaseId"
                                          asp-page-handler="CreateRequestUploadLink">
                                        <input type="hidden" name="id" value="@summary.CaseId" />
                                        <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                                        <input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" />
                                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                                        <button type="submit" class="btn">
                                            <svg class="icon" aria-hidden="true"><use href="#icon-link" /></svg>
                                            <span>@Frame.CreateUploadLink</span>
                                        </button>
                                    </form>
                                    <button type="button" class="btn" data-dialog-open="case-correct-principal-dialog">
                                        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                                        <span>@Frame.CorrectPrincipal</span>
                                    </button>
                                }
                                @if (offersCreateAudit)
                                {
                                    <button type="button" class="btn" data-dialog-open="case-create-audit-dialog" data-create-audit>
                                        <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                                        <span>@Frame.CreateAudit</span>
                                    </button>
                                }
                            }
                            @if (offersAdverseClosure)
                            {
                                @* Review point 12: an adverse disposition is not a step
                                   in the workflow, so it stands apart below a divider in
                                   red. It closes the Case; it never deletes one. *@
                                <div class="menu-sep"></div>
                                <button type="button" class="btn btn--danger" data-dialog-open="case-close-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                                    <span>@OperatorLabels.CaseWorkspace.CloseCase</span>
                                </button>
                            }
                        </div>
                    </details>
                }
            </div>
        </div>
        <div class="section-row">
            <nav class="section-nav" aria-label="@OperatorLabels.CaseWorkspace.SectionNav" data-section-nav>
                @foreach (var entry in OperatorLabels.CaseWorkspace.Sections)
                {
                    <a class="section-link" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId"
                       asp-route-section="@entry.Key" asp-fragment="section-@entry.Key" data-section-link="@entry.Key"
                       aria-current="@(Model.Section == entry.Key ? "true" : "false")">
                        <svg class="icon" aria-hidden="true"><use href="#@entry.Icon" /></svg>
                        <span>@entry.Label</span>
                    </a>
                }
            </nav>
            <div class="section-tools">
                @* Refresh reruns this query on the section the operator is
                   looking at, not the Overview. *@
                <form method="get" data-refresh-form data-case-refresh>
                    <input type="hidden" name="section" value="@Model.Section" data-case-section-field />
                    <button type="submit" class="btn btn--icon btn--small" title="@Frame.Refresh" aria-label="@Frame.Refresh">
                        <svg class="icon icon--spin" aria-hidden="true"><use href="#icon-refresh-cw" /></svg>
                    </button>
                </form>
                <div class="layout-switch" role="group" aria-label="Case layout" data-case-layout-switch hidden>
                    <button type="button" data-case-layout="scroll" aria-pressed="true">@Frame.Scroll</button>
                    <button type="button" data-case-layout="tabs" aria-pressed="false">@Frame.Tabs</button>
                </div>
            </div>
        </div>
        <div data-case-stale>
        @if (staleGeneration)
        {
            <div class="stale-bar" role="status" data-dismissable data-stale-bar>
                <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                <span>@CaseWorkspaceLabels.ReportDelivery.GenerationStaleNotice</span>
                <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId" asp-route-section="report" asp-fragment="section-report" data-section-jump="report">Open Report</a>
                <button type="button" class="dismiss" data-dismiss aria-label="Dismiss"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
            </div>
        }
        </div>
    </div>

    <div class="workspace">
        <div class="workspace-main" id="case-main">
            @* The ten sections in their fixed order (D30), each a panel whose
               id the section nav addresses. A body below the fold is fetched
               as the reader approaches it; the fragment is the section itself. *@
            @foreach (var entry in OperatorLabels.CaseWorkspace.Sections)
            {
                if (Model.SectionIsDeferred(entry.Key))
                {
                    <section class="record-section panel section-placeholder" id="section-@entry.Key"
                             data-section="@entry.Key" data-lazy="@entry.Key"
                             aria-label="@entry.Label"></section>
                    continue;
                }

                switch (entry.Key)
                {
                    case "overview":
                        <partial name="Cases/Shared/_CaseOverview" model="Model" />
                        break;
                    case "inspection":
                        <partial name="Cases/Shared/_CaseInspectionAddress" model="Model" />
                        break;
                    case "vehicle":
                        <partial name="Cases/Shared/_CaseVehicle" model="Model" />
                        break;
                    case "damage":
                        <partial name="Cases/Shared/_CaseDamage" model="Model" />
                        break;
                    case "valuation":
                        <partial name="Cases/Shared/_CaseValuation" model="Model" />
                        break;
                    case "estimate":
                        <partial name="Cases/Shared/_CaseEstimate" model="Model" />
                        break;
                    case "settlement":
                        <partial name="Cases/Shared/_CaseSettlement" model="Model" />
                        break;
                    case "report":
                        <partial name="Cases/Shared/_CaseReport" model="Model" />
                        break;
                    case "files":
                        <partial name="Cases/Shared/_CaseFiles" model="Model" />
                        break;
                    case "notes":
                        <partial name="Cases/Shared/_CaseHistory" model="Model" />
                        break;
                }
            }
        </div>

        @* The aside (v25 decision 7): Figures and Next action. Current
           position is gone because the ribbon carries it. *@
        <aside class="workspace-aside" aria-label="Case context" data-case-aside>
            <section class="panel context-card" data-figures>
                <div class="panel-head"><h2>@Frame.Figures</h2></div>
                <div class="panel-body">
                    @if (outcome is not null || legalStatus is not null)
                    {
                        <div class="fig-chips">
                            @if (outcome is not null)
                            {
                                var outcomeText = outcome == "total_loss" && !string.IsNullOrWhiteSpace(salvageCategory)
                                    ? $"Total loss · Cat {salvageCategory}"
                                    : OperatorLabels.Humanise(outcome);
                                <span class="status @(outcome == "total_loss" ? "status--red" : "status--blue")" data-outcome-chip>@outcomeText</span>
                            }
                            @if (legalStatus is not null)
                            {
                                <span class="status @(legalStatus == "unroadworthy" ? "status--amber" : "status--neutral")" data-legal-chip>@OperatorLabels.Humanise(legalStatus)</span>
                            }
                        </div>
                    }
                    <dl class="figures">
                        <div class="figure figure--big"><dt>@Frame.RepairCostIncVat</dt><dd class="mono">@(repairCost is { } cost ? FormatMoney(cost) : "—")</dd></div>
                        <div class="figure"><dt>@Frame.EngineersValue</dt><dd class="mono">@(engineerValue is { } ev ? FormatMoney(ev) : "—")</dd></div>
                        <div class="figure"><dt>@Frame.RepairCostOfValue</dt><dd class="mono">@(repairCost is { } c && engineerValue is { } v && v > 0 ? $"{Math.Round(c / v * 100)}%" : "—")</dd></div>
                    </dl>
                </div>
            </section>
            <section class="panel context-card" data-next-action>
                <div class="panel-head"><h2>@Frame.NextAction</h2></div>
                <div class="panel-body">
                    @foreach (var draft in Model.AiDrafts)
                    {
                        var (label, action) = draft.Action switch
                        {
                            AiDraftAction.ReviewEstimate => ("Estimate draft ready", Frame.ReviewEstimate),
                            AiDraftAction.OpenQuery => ("Query response draft ready", Frame.OpenQuery),
                            _ => ("Unidentified resolution draft ready", Frame.Review)
                        };
                        <div class="next-row ai-next" data-ai-draft="@draft.Job.JobId">
                            <span><span class="src-tag src-tag--ai">AI</span> @label</span>
                            <a class="btn btn--small btn--primary" href="@draft.Route">@action</a>
                        </div>
                    }
                    <div class="next-row">
                        <span data-next-label>@next.Label</span>
                        <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId" asp-route-section="@next.SectionKey" asp-fragment="section-@next.SectionKey" data-section-jump="@next.SectionKey">@OperatorLabels.CaseWorkspace.Sections.First(section => section.Key == next.SectionKey).Label</a>
                    </div>
                </div>
            </section>
        </aside>
    </div>
</article>

<div data-case-viewer-host><partial name="Cases/Shared/_CaseViewer" model="Model" /></div>
<partial name="Shared/_EditFinishConfirm" />
