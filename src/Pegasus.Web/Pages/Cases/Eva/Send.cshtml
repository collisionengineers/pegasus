@page "/Cases/{caseId:guid}/Eva/Send"
@using Pegasus.Core.Eva
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Cases.Eva.SendModel
@{
    ViewData["Title"] = OperatorLabels.CaseWorkspace.EvaHandoff;
}

<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">Case workspace · @Model.Reference</p>
        <h1>@OperatorLabels.CaseWorkspace.EvaHandoff</h1>
    </div>
    <div class="page-actions">
        <a class="btn" asp-page="/Cases/Details" asp-route-id="@Model.CaseId">
            <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
            <span>Back to @Model.Reference</span>
        </a>
    </div>
</header>

<section class="panel" aria-labelledby="eva-handoff-title">
    <div class="panel-head">
        <h2 id="eva-handoff-title">@Model.Reference</h2>
    </div>
    <div class="panel-body stack">
        @* A prior handoff remains visible while both configured routes stay
           available for an explicit re-send. The file reference is what an
           operator quotes to EVA, so it is the value shown; no EVA identifier,
           handle or hash is printed. *@
        @if (Model.LastSubmission is { IsSucceeded: true } sent)
        {
            <div class="definition-list">
                <dl class="definition">
                    <dt>Sent to EVA</dt>
                    <dd>@OperatorLabels.OfficeTime(sent.SubmittedAtUtc)</dd>
                </dl>
                @if (sent.FileReference is { } fileReference)
                {
                    <dl class="definition">
                        <dt>File reference</dt>
                        <dd>@fileReference</dd>
                    </dl>
                }
            </div>
        }
        else if (Model.LastSubmission is { } attempted)
        {
            <div class="definition-list">
                <dl class="definition">
                    <dt>Last attempt</dt>
                    <dd>@OperatorLabels.OfficeTime(attempted.SubmittedAtUtc)</dd>
                </dl>
                <dl class="definition">
                    <dt>Outcome</dt>
                    <dd>
                        <partial name="Shared/_StatusChip" model="@OutcomeLabel(attempted.Outcome)"
                                 view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = OutcomeTone(attempted.Outcome) }' />
                    </dd>
                </dl>
            </div>
        }

        <partial name="Cases/Shared/_EvaHandoff" model="Model.Handoff!" />
    </div>
</section>

@functions {
    private static string OutcomeLabel(EvaSubmissionOutcome outcome) => outcome switch
    {
        EvaSubmissionOutcome.Rejected => "Refused by EVA",
        EvaSubmissionOutcome.Partial => "Sent, no reference returned",
        _ => "EVA could not be reached"
    };

    // _StatusChip's rule (docs/design/README.md): red is blocked/failed/denied,
    // amber is incomplete/pending. A refusal and an unreachable transport are
    // both failures; only Partial actually reached EVA with something missing.
    private static string OutcomeTone(EvaSubmissionOutcome outcome) => outcome switch
    {
        EvaSubmissionOutcome.Partial => "amber",
        _ => "red"
    };
}
