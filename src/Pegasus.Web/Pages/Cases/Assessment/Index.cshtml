@page "/Cases/{id:guid}/Assessment"
@model Pegasus.Web.Pages.Cases.Assessment.IndexModel
@using System.Globalization
@using Pegasus.Core.Assessment
@using Pegasus.Core.Cases
@using Pegasus.Web.Presentation
@*
    The Assessment workspace (context.md §1.9, ENG-025). Access is owned by
    Core's AssessmentAccessPolicy (D11: With Engineer or onwards plus a
    current-cycle export; read-only once Complete). The evidence rail and
    the Estimates pane render custody facts and the repair-specification
    seam; the multi-estimate editor (tabs, per-estimate fields, lines and
    totals) is ENG-028, and no placeholder is drawn for it here.
*@
@{
    ViewData["Title"] = "Assessment";

    var caseId = ViewContext.RouteData.Values["id"]?.ToString() ?? string.Empty;
}

@if (Model.UnavailableReference is not null)
{
    var gateEyebrow = string.IsNullOrWhiteSpace(Model.UnavailableRegistration)
        ? Model.UnavailableReference
        : $"{Model.UnavailableReference} · {Model.UnavailableRegistration}";
    <header class="page-header">
        <div class="page-title">
            <p class="eyebrow">@gateEyebrow</p>
            <h1>Assessment unavailable</h1>
        </div>
        <div class="page-actions">
            <a class="btn" asp-page="/Cases/Details" asp-route-id="@caseId">
                <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
                <span>Back to Case</span>
            </a>
        </div>
    </header>
    <div class="notice notice--warning" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>A current Review-cycle EVA export is required before the assessment opens.</span>
    </div>
    return;
}

@{
    var caseStage = OperatorLabels.CaseStage(Model.Case!.Header.State);
    var registration = string.IsNullOrWhiteSpace(Model.Case.Header.Registration)
        ? "No registration"
        : Model.Case.Header.Registration!;
    var vehicle = Model.VehicleDisplay;
    var mileage = Model.MileageDisplay;
    var claimant = string.IsNullOrWhiteSpace(Model.Claimant) ? "Not recorded" : Model.Claimant!;
    var editing = !string.IsNullOrWhiteSpace(Model.LeaseToken) && !Model.CaseIsArchived;
    var canImport = Model.ImportCondition is null;
    var engineerValue = Model.EngineerValue;
    var targetBase = engineerValue is null ? string.Empty
        : engineerValue.Value.ToString("0.##", CultureInfo.InvariantCulture);
}

<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">@Model.HeaderEyebrow</p>
        <h1>Assessment</h1>
    </div>
    <div class="page-actions">
        <a class="btn" asp-page="/Cases/Details" asp-route-id="@caseId">
            <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
            <span>Back to Case</span>
        </a>
        <form method="get" data-refresh-form>
            <button type="submit" class="btn btn--small" title="Refresh">
                <svg class="icon icon--spin" aria-hidden="true"><use href="#icon-refresh-cw" /></svg>
                <span>Refresh</span>
            </button>
        </form>
    </div>
</header>

@if (TempData["AssessmentStatus"] is string assessmentStatus)
{
    <div class="notice notice--success mb-2" role="status" data-confirmation>
        <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
        <span>@assessmentStatus</span>
    </div>
}
@if (TempData["AssessmentError"] is string assessmentError)
{
    <div class="notice notice--danger mb-2" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>@assessmentError</span>
    </div>
}
@if (Model.ReportDraftNotReady)
{
    <div class="notice notice--warning mb-2" role="status">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>
            Report draft not ready: @string.Join("; ", Model.ReportDraftReasons.Select(reason => reason.Requirement)).
        </span>
    </div>
}

<article class="record">
    <div class="record-ribbon assessment-identity-ribbon" aria-label="Case identity">
        <div class="ribbon-item ribbon-ref">
            <div class="ribbon-label">Case/PO</div>
            <div class="ribbon-value">@Model.Case.Header.Reference</div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">Registration</div>
            <div class="ribbon-value">@registration</div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">Claimant</div>
            <div class="ribbon-value">@claimant</div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">Principal</div>
            <div class="ribbon-value">@Model.Case.Header.Principal</div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">State</div>
            <div class="ribbon-value"><partial name="Shared/_StatusChip" model="@caseStage" /></div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">Mileage</div>
            <div class="ribbon-value">@(mileage is null ? "Not recorded" : mileage)</div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">Vehicle</div>
            <div class="ribbon-value">@(vehicle.Length == 0 ? "Not recorded" : vehicle)</div>
        </div>
    </div>

    @* Presence: who holds the case's one edit authority, as the Case
       workspace shows it (FRD-01, CASE-024). *@
    @if (Model.ViewerHoldsEditAuthority)
    {
        <div class="presence-strip" role="status">
            <span class="presence-dot" aria-hidden="true"></span>
            <span>You are editing this case.</span>
        </div>
    }
    else if (Model.EditAuthorityHolder is { } holder)
    {
        <div class="presence-strip" role="status">
            <span class="presence-dot" aria-hidden="true"></span>
            <span data-edit-authority>@EditModeDisplay.HeldBy(holder, false) Editing cannot be taken over.</span>
        </div>
    }

    @* The bar carries the actions valid now; each posts to the Core action
       that owns it. The estimate controls are lease-carrying acts, so they
       need the edit mode entered here; a read-only case (D11) offers none
       of them. Glass's and Audatex are the D7 disabled seams (EXT-09). *@
    <div class="record-bar">
        @if (!Model.CaseIsArchived && !Model.IsReadOnly)
        {
            @if (editing)
            {
                <form method="post" asp-page-handler="ReleaseLease" data-edit-toggle-off>
                    <input type="hidden" name="id" value="@caseId" />
                    <input type="hidden" name="operationKey" value="@Model.ReleaseLeaseOperationKey" />
                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                    <button type="submit" class="btn btn--dark">
                        <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                        <span>Finish editing</span>
                    </button>
                </form>
                <partial name="Shared/_EditHeartbeat" view-data='new ViewDataDictionary(ViewData) { ["HeartbeatCaseId"] = caseId, ["HeartbeatLeaseToken"] = Model.LeaseToken }' />
            }
            else if (Model.CanRecoverLease)
            {
                <form method="post" asp-page-handler="ClaimLease">
                    <input type="hidden" name="id" value="@caseId" />
                    <input type="hidden" name="expectedVersion" value="@Model.Case!.Header.Version" />
                    <input type="hidden" name="operationKey" value="@Model.ClaimLeaseOperationKey" />
                    <button type="submit" class="btn">Recover editing</button>
                </form>
            }
            else if (Model.EditAuthorityHolder is null)
            {
                <form method="post" asp-page-handler="ClaimLease">
                    <input type="hidden" name="id" value="@caseId" />
                    <input type="hidden" name="expectedVersion" value="@Model.Case!.Header.Version" />
                    <input type="hidden" name="operationKey" value="@Model.ClaimLeaseOperationKey" />
                    <button type="submit" class="btn">
                        <svg class="icon" aria-hidden="true"><use href="#icon-pencil" /></svg>
                        <span>Edit assessment</span>
                    </button>
                </form>
            }
        }
        @if (canImport)
        {
            <button type="button" class="btn" data-dialog-open="import-estimate-dialog">
                <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                <span>Import estimate</span>
            </button>
        }
        else if (Model.ImportCondition is not null && !Model.CaseIsArchived)
        {
            <span class="gated" data-condition="@Model.ImportCondition">
                <button type="button" class="btn" disabled aria-disabled="true">
                    <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                    <span>Import estimate</span>
                </button>
            </span>
        }
        <span class="gated" data-condition="Available once the estimating-service link is agreed">
            <button type="button" class="btn" disabled aria-disabled="true">Glass's</button>
        </span>
        <span class="gated" data-condition="Available once the estimating-service link is agreed">
            <button type="button" class="btn" disabled aria-disabled="true">Audatex</button>
        </span>
        @if (Model.SendToClaudeCondition is null)
        {
            <button type="button" class="btn btn--primary" data-dialog-open="send-to-claude-dialog">
                <svg class="icon" aria-hidden="true"><use href="#icon-send" /></svg>
                <span>Send to Claude</span>
            </button>
        }
        else
        {
            <span class="gated" data-condition="@Model.SendToClaudeCondition">
                <button type="button" class="btn btn--primary" disabled aria-disabled="true">
                    <svg class="icon" aria-hidden="true"><use href="#icon-send" /></svg>
                    <span>Send to Claude</span>
                </button>
            </span>
        }
        <span class="record-bar-end">
            @if (Model.ReportDraftCondition is null)
            {
                <form method="post" asp-page-handler="GenerateReportDraft" asp-route-id="@caseId">
                    <input type="hidden" name="operationKey" value="@Model.ReportDraftOperationKey" />
                    <button type="submit" class="btn">
                        <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                        <span>Generate report draft</span>
                    </button>
                </form>
                <a class="btn" asp-page="/Cases/Assessment/Index" asp-route-id="@caseId"
                   asp-page-handler="PreviewReportDraft" target="_blank" rel="noopener">
                    <svg class="icon" aria-hidden="true"><use href="#icon-eye" /></svg>
                    <span>Preview report draft</span>
                </a>
            }
            else if (Model.ReportDraftPreparation is not null)
            {
                <span class="gated" data-condition="@Model.ReportDraftCondition">
                    <button type="button" class="btn" disabled aria-disabled="true">
                        <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                        <span>Generate report draft</span>
                    </button>
                </span>
            }
        </span>
    </div>

    <div class="record-body">
        <section class="assessment-v3" aria-label="Assessment workspace">
            @* Evidence rail: the instruction documents and custody-confirmed
               images, each opening the shared evidence viewer through the
               same authorised download-inline routes the Case Files view
               uses (DOCS-011). *@
            <aside class="pane assessment-v3-evidence" aria-label="Evidence">
                <div class="pane-head">
                    <h2>Evidence</h2>
                    <button type="button" class="assessment-rail-toggle" data-rail-toggle
                            aria-expanded="true" aria-label="Collapse Evidence rail">
                        <svg class="icon" aria-hidden="true"><use href="#icon-chevron-left" /></svg>
                    </button>
                </div>
                <div class="pane-body pane-scroll">
                    <div class="assessment-evidence-list" data-evidence-set>
                        @foreach (var file in Model.InstructionFiles)
                        {
                            var previewHref = Url.Page("/Cases/Documents/Download", new
                            {
                                caseId,
                                occurrenceId = file.Occurrence.Id,
                                versionId = file.Version.Id,
                                inline = true
                            });
                            var downloadHref = Url.Page("/Cases/Documents/Download", new
                            {
                                caseId,
                                occurrenceId = file.Occurrence.Id,
                                versionId = file.Version.Id
                            });
                            <a class="row-button" href="@previewHref" data-evidence-item
                               data-download-href="@downloadHref"
                               data-media-type="@file.Version.MediaType"
                               data-file-name="@file.Version.FileName">
                                <span class="row-title">@file.Version.FileName</span>
                                <span class="row-meta">Instruction</span>
                            </a>
                        }
                        @foreach (var image in Model.EvidenceImages)
                        {
                            string previewHref;
                            string downloadHref;
                            if (image.IsCaseDocument)
                            {
                                downloadHref = Url.Page("/Cases/Documents/Download", new
                                {
                                    caseId,
                                    occurrenceId = image.OccurrenceId,
                                    versionId = image.VersionId
                                })!;
                                previewHref = Url.Page("/Cases/Documents/Download", new
                                {
                                    caseId,
                                    occurrenceId = image.OccurrenceId,
                                    versionId = image.VersionId,
                                    inline = true
                                })!;
                            }
                            else
                            {
                                downloadHref = Url.Page("/Intake/Asset", new { id = image.ReceiptId, assetId = image.AssetId })!;
                                previewHref = downloadHref;
                            }
                            <a class="row-button" href="@previewHref" data-evidence-item
                               data-download-href="@downloadHref"
                               data-media-type="@image.MediaType"
                               data-file-name="@image.FileName">
                                <span class="row-title">@image.FileName</span>
                                <span class="row-meta">Vehicle image</span>
                            </a>
                        }
                    </div>
                </div>
            </aside>

            @* Estimates pane: the case's current single estimate surfaces —
               the accepted or draft repair specification with its lines and,
               for a draft, the Engineer acceptance (ENG-002). Named
               estimates, the tab strip and the per-estimate editor arrive
               with ENG-028. *@
            <main class="pane assessment-v3-main" aria-label="Estimates">
                <div class="pane-head"><h2>Estimates</h2></div>
                <div class="pane-body pane-scroll">
                    <div class="detail-canvas">
                        <div class="assessment-estimates">
                            @if (Model.AcceptedSpecification is { } acceptedSpec)
                            {
                                <section class="panel estimate-editor" aria-labelledby="estimate-current-title">
                                    <div class="panel-head">
                                        <div>
                                            <h2 id="estimate-current-title">Repair specification</h2>
                                            <span class="panel-title-meta">
                                                Accepted@(acceptedSpec.AcceptedAtUtc is { } acceptedAt
                                                    ? $" {OperatorLabels.OfficeDate(acceptedAt)}"
                                                    : "")
                                                · @OperatorLabels.RepairSpecificationRoute(acceptedSpec.Source.Route)
                                            </span>
                                        </div>
                                        <partial name="Shared/_StatusChip" model="@("Current")" />
                                    </div>
                                    <div class="panel-body">
                                        @if (acceptedSpec.CalculationBasis is { } basis)
                                        {
                                            <dl class="estimate-totals">
                                                <div><dt>Labour</dt><dd class="tabular">&#163;@basis.Labour.ToString("N2")</dd></div>
                                                <div><dt>Parts</dt><dd class="tabular">&#163;@basis.Parts.ToString("N2")</dd></div>
                                                <div><dt>Paint materials</dt><dd class="tabular">&#163;@basis.PaintMaterials.ToString("N2")</dd></div>
                                                <div><dt>Specialist and other</dt><dd class="tabular">&#163;@basis.SpecialistOther.ToString("N2")</dd></div>
                                                <div><dt>VAT</dt><dd class="tabular">&#163;@basis.Vat.ToString("N2")</dd></div>
                                                <div class="estimate-total"><dt>Total</dt><dd class="tabular">&#163;@basis.Total.ToString("N2")</dd></div>
                                            </dl>
                                        }
                                        RenderSpecificationLines(acceptedSpec, "accepted");
                                    </div>
                                </section>
                            }

                            @if (Model.DraftSpecification is { } draftSpec)
                            {
                                <section class="panel estimate-editor" aria-labelledby="estimate-draft-title">
                                    <div class="panel-head">
                                        <div>
                                            <h2 id="estimate-draft-title">Draft estimate</h2>
                                            <span class="panel-title-meta">
                                                Awaiting an Engineer&#8217;s acceptance
                                                · @OperatorLabels.RepairSpecificationRoute(draftSpec.Source.Route)
                                            </span>
                                        </div>
                                        <partial name="Shared/_StatusChip" model="@("Draft")" />
                                    </div>
                                    <div class="panel-body">
                                        @if (draftSpec.Source.Route == RepairSpecificationSourceRoute.LegacyUnresolved)
                                        {
                                            <div class="notice notice--warning" role="status">
                                                <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                                                <span>These lines need source review before they can be accepted.</span>
                                            </div>
                                        }
                                        RenderSpecificationLines(draftSpec, "draft");

                                        @if (!Model.IsReadOnly)
                                        {
                                            if (Model.ActorIsEngineer)
                                            {
                                                <h3 class="section-label section-gap">Accept this specification</h3>
                                                <form method="post" asp-page-handler="AcceptSpecification" asp-route-id="@caseId">
                                                    <input type="hidden" name="operationKey" value="@Model.AcceptOperationKey" />
                                                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                                                    <input type="hidden" name="specificationId" value="@draftSpec.SpecificationId" />
                                                    <input type="hidden" name="specificationVersion" value="@draftSpec.Version" />
                                                    <div class="form-grid">
                                                        <div>
                                                            <label for="accept-labour">Labour (&#163;)</label>
                                                            <input type="number" id="accept-labour" name="labour" min="0" step="0.01" inputmode="decimal" class="tabular" required />
                                                        </div>
                                                        <div>
                                                            <label for="accept-parts">Parts (&#163;)</label>
                                                            <input type="number" id="accept-parts" name="parts" min="0" step="0.01" inputmode="decimal" class="tabular" required />
                                                        </div>
                                                        <div>
                                                            <label for="accept-paint">Paint materials (&#163;)</label>
                                                            <input type="number" id="accept-paint" name="paintMaterials" min="0" step="0.01" inputmode="decimal" class="tabular" required />
                                                        </div>
                                                        <div>
                                                            <label for="accept-specialist">Specialist and other (&#163;)</label>
                                                            <input type="number" id="accept-specialist" name="specialistOther" min="0" step="0.01" inputmode="decimal" class="tabular" required />
                                                        </div>
                                                        <div>
                                                            <label for="accept-vat">VAT (&#163;)</label>
                                                            <input type="number" id="accept-vat" name="vat" min="0" step="0.01" inputmode="decimal" class="tabular" required />
                                                        </div>
                                                        <div>
                                                            <fieldset class="role-choices role-choices--stacked">
                                                                <legend>Is the repairer VAT registered?</legend>
                                                                <label class="choice"><input type="radio" name="repairerVatRegistered" value="true" required /> <span>Yes</span></label>
                                                                <label class="choice"><input type="radio" name="repairerVatRegistered" value="false" /> <span>No</span></label>
                                                            </fieldset>
                                                        </div>
                                                        <div class="field-wide">
                                                            <label for="accept-reason">Reason</label>
                                                            <input type="text" id="accept-reason" name="reason" maxlength="500" />
                                                        </div>
                                                    </div>
                                                    <div class="button-row section-gap">
                                                        <button type="submit" class="btn btn--dark">Accept specification</button>
                                                    </div>
                                                </form>
                                            }
                                            else
                                            {
                                                <p class="empty-state">An Engineer accepts the specification.</p>
                                            }
                                        }
                                    </div>
                                </section>
                            }

                            @if (Model.AcceptedSpecification is null && Model.DraftSpecification is null)
                            {
                                <div class="empty estimate-empty">No estimates recorded</div>
                            }
                        </div>
                    </div>
                </div>
            </main>
        </section>
    </div>
</article>

@if (canImport)
{
    <div class="dialog-backdrop" data-dialog="import-estimate-dialog" hidden>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="import-estimate-dialog-title">
            <div class="dialog-head">
                <h2 id="import-estimate-dialog-title" tabindex="-1">Import estimate</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </div>
            <form method="post" enctype="multipart/form-data" asp-page-handler="ImportEstimate" asp-route-id="@caseId">
                <input type="hidden" name="operationKey" value="@Model.ImportOperationKey" />
                <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                <div class="dialog-body stack">
                    <div class="dropzone" data-dropzone>
                        <span class="dropzone__glyph" aria-hidden="true"><svg class="icon icon--lg"><use href="#icon-upload" /></svg></span>
                        <label for="estimate-file">Drag an estimate here, or choose it</label>
                        <span class="field-hint">An Audatex estimate report as a PDF &#8212; up to 10 MB.</span>
                        <input type="file" id="estimate-file" name="estimateFile" accept=".pdf,application/pdf" required />
                        <button type="button" class="btn dropzone__browse" hidden data-dropzone-browse>Choose a file</button>
                        <p class="dropzone__file" role="status" aria-live="polite" hidden data-dropzone-file></p>
                    </div>
                    <div>
                        <label for="import-reason">Reason</label>
                        <input type="text" id="import-reason" name="reason" maxlength="500" data-dialog-initial-focus />
                    </div>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>Cancel</button>
                    <button type="submit" class="btn btn--dark">Import estimate</button>
                </div>
            </form>
        </section>
    </div>
}

@if (Model.SendToClaudeCondition is null)
{
    <div class="dialog-backdrop" data-dialog="send-to-claude-dialog" hidden>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="send-to-claude-dialog-title">
            <div class="dialog-head">
                <h2 id="send-to-claude-dialog-title" tabindex="-1">Send to Claude</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </div>
            <form method="post" asp-page-handler="SendToClaude" asp-route-id="@caseId">
                <input type="hidden" name="operationKey" value="@Model.SendOperationKey" />
                <div class="dialog-body stack">
                    <div>
                        <label for="claude-direction">Direction</label>
                        <textarea id="claude-direction" name="direction" rows="4" maxlength="1000"
                                  data-dialog-initial-focus></textarea>
                    </div>
                    <div>
                        <label for="claude-target">
                            Target Estimate <output id="claude-target-value">75%</output>
                        </label>
                        <input type="range" id="claude-target" name="targetPercent" min="1" max="100" step="1" value="75"
                               data-range-output="claude-target-value"
                               data-range-base="@targetBase"
                               data-range-amount-output="claude-target-amount" />
                    </div>
                    <dl class="definition-list">
                        <div class="definition">
                            <dt>Case Valuation</dt>
                            <dd>&#163;@engineerValue!.Value.ToString("N0")</dd>
                        </div>
                        <div class="definition">
                            <dt>Target amount</dt>
                            <dd id="claude-target-amount">&#8212;</dd>
                        </div>
                    </dl>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>Cancel</button>
                    <button type="submit" class="btn btn--primary">Send to Claude</button>
                </div>
            </form>
        </section>
    </div>
}

<partial name="Shared/_EvidenceViewer" />
<partial name="Shared/_EditFinishConfirm" />

@functions {
    /// <summary>
    /// ENG-002: one renderer for a specification's ordered lines, shared by
    /// the accepted and draft views so the two can never drift apart.
    /// </summary>
    private void RenderSpecificationLines(RepairSpecificationVersion specification, string kind)
    {
        <div class="table-wrap">
            <table class="line-grid">
                <caption>The @kind specification&#8217;s ordered lines, exactly as recorded.</caption>
                <thead>
                    <tr>
                        <th scope="col">Line</th>
                        <th scope="col">Type</th>
                        <th scope="col">Code</th>
                        <th scope="col">Description</th>
                        <th scope="col">Work units</th>
                        <th scope="col">Price</th>
                        <th scope="col">Part number</th>
                        <th scope="col">Betterment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in specification.Lines)
                    {
                        <tr>
                            <th scope="row">@line.Position</th>
                            <td>@OperatorLabels.EstimateLineType(line.Type)</td>
                            <td>@(line.GuideCode ?? "")</td>
                            <td>@(line.Description ?? "")</td>
                            <td class="tabular">@(line.WorkUnits is { } workUnits ? workUnits.ToString("0.0") : "")</td>
                            <td class="tabular">@(line.Price is { } price ? "£" + price.ToString("N2") : line.Unpriced ? "To be confirmed" : "")</td>
                            <td>@(line.PartNumber ?? "")</td>
                            <td>@(line.Betterment ?? "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
