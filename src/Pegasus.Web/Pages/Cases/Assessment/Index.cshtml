@functions {
    /// <summary>One totals renderer shared by editable and read-only estimates.</summary>
    private void RenderEstimateTotals(EstimateTotals totals)
    {
        <dl class="estimate-totals">
            <div><dt>Parts</dt><dd class="tabular">&#163;@totals.Parts.ToString("N2")</dd></div>
            <div><dt>Labour</dt><dd class="tabular">&#163;@totals.Labour.ToString("N2")</dd></div>
            <div><dt>Paint</dt><dd class="tabular">&#163;@totals.Paint.ToString("N2")</dd></div>
            <div><dt>Other</dt><dd class="tabular">&#163;@totals.Other.ToString("N2")</dd></div>
            <div><dt>Subtotal</dt><dd class="tabular">&#163;@totals.Subtotal.ToString("N2")</dd></div>
            <div><dt>VAT</dt><dd class="tabular">&#163;@totals.Vat.ToString("N2")</dd></div>
            <div class="estimate-total"><dt>Total</dt><dd class="tabular">&#163;@totals.Total.ToString("N2")</dd></div>
        </dl>
    }

    /// <summary>
    /// ENG-002: one renderer for a specification's ordered lines, shared by
    /// the accepted and draft views so the two can never drift apart.
    /// </summary>
    private void RenderSpecificationLines(RepairSpecificationVersion specification, string kind)
    {
        <div class="table-wrap">
            <table class="line-grid">
                <caption>The @kind specification&#8217;s ordered lines, exactly as recorded.</caption>
                <thead>
                    <tr>
                        <th scope="col">Line</th>
                        <th scope="col">Type</th>
                        <th scope="col">Code</th>
                        <th scope="col">Description</th>
                        <th scope="col">Work units</th>
                        <th scope="col">Price</th>
                        <th scope="col">Part number</th>
                        <th scope="col">Betterment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in specification.Lines)
                    {
                        <tr>
                            <th scope="row">@line.Position</th>
                            <td>@OperatorLabels.EstimateLineType(line.Type)</td>
                            <td>@(line.GuideCode ?? "")</td>
                            <td>@(line.Description ?? "")</td>
                            <td class="tabular">@(line.WorkUnits is { } workUnits ? workUnits.ToString("0.0") : "")</td>
                            <td class="tabular">@(line.Price is { } price ? "£" + price.ToString("N2") : line.Unpriced ? "To be confirmed" : "")</td>
                            <td>@(line.PartNumber ?? "")</td>
                            <td>@(line.Betterment ?? "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
