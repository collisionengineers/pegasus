@page "/Cases/{id:guid}/Assessment"
@model Pegasus.Web.Pages.Cases.Assessment.IndexModel
@using Pegasus.Core.AiWork
@using Pegasus.Core.Assessment
@*
    Engineers assessment screen.

    The route, case-identity header, readiness rail, Send to Claude panel,
    and PAV slider are wired by the AI-09 Send to AI task
    (ADR-0021 / FRD-11: docs/adr/0021-automation-actor-direct-write-assessment-contract.md,
    docs/frd/frd-11-reports-correspondence-and-reviewed-proposals.md) — that
    plan is the re-entry specification docs/design/README.md § Deferred casework
    requires, and the page stays unlinked from navigation. Every section form
    below remains empty and unbound: field `name` attributes follow the
    report job definition under reference/rendererref1/, and the staff
    save paths belong to the UI-15 activation task.
*@
@{
    ViewData["Title"] = "Assessment";
    ViewData["Eyebrow"] = "Case";
    ViewData["Lede"] = "Record the engineering assessment and the content the report is written from.";

    var caseId = ViewContext.RouteData.Values["id"]?.ToString() ?? string.Empty;
    var assessmentUrl = $"/Cases/{caseId}/Assessment";

    var sections = new (string Key, string Label)[]
    {
        ("vehicle", "Vehicle"),
        ("incident", "Incident and impact"),
        ("inspection", "Inspection"),
        ("valuation", "Valuation"),
        ("estimate", "Estimate"),
        ("findings", "Findings"),
        ("report", "Report content"),
    };

    var requested = Model.Request.Query["section"].ToString().Trim();
    var current = "vehicle";
    foreach (var candidate in sections)
    {
        if (string.Equals(candidate.Key, requested, StringComparison.OrdinalIgnoreCase))
        {
            current = candidate.Key;
        }
    }
}

<a class="back-link" href="/Cases/@caseId">
    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
    <span>Back to the case</span>
</a>

<partial name="Shared/_PageHeader" />

@if (TempData["AssessmentStatus"] is string assessmentStatus)
{
    <div role="status" class="status-card">@assessmentStatus</div>
}
@if (TempData["AssessmentError"] is string assessmentError)
{
    <div role="status" class="status-card status-card--error">@assessmentError</div>
}

<section class="panel" aria-labelledby="case-identity-title">
    <h2 id="case-identity-title" class="section-label">Case identity</h2>
    <dl class="detail-list">
        <div>
            <dt>Case/PO</dt>
            <dd>@Model.Case!.Summary.Reference</dd>
        </div>
        <div>
            <dt>Principal</dt>
            <dd>@Model.Case.Summary.Principal</dd>
        </div>
        <div>
            <dt>Registration</dt>
            <dd>
                @if (Model.Case.Summary.Registration is { } registration)
                {
                    @registration
                }
                else
                {
                    <span aria-hidden="true">&#8212;</span><span class="vh">No value</span>
                }
            </dd>
        </div>
        <div>
            <dt>Case type</dt>
            <dd>@Model.Case.Summary.CaseType</dd>
        </div>
        <div>
            <dt>Workflow state</dt>
            <dd>@Model.Case.Summary.State</dd>
        </div>
        <div>
            <dt>Due by</dt>
            <dd>
                @if (Model.Case.Workflow.DueWork?.DueBy is { } dueBy)
                {
                    <span class="tabular">@dueBy.ToString("yyyy-MM-dd")</span>
                }
                else
                {
                    <span aria-hidden="true">&#8212;</span><span class="vh">No value</span>
                }
            </dd>
        </div>
    </dl>
</section>

<nav class="section-tabs section-gap" aria-label="Assessment sections">
    @* `tab`, not `section`: `@section` is the Razor section directive. *@
    @foreach (var tab in sections)
    {
        <a href="@assessmentUrl?section=@tab.Key"
           aria-current="@(tab.Key == current ? "page" : null)">@tab.Label</a>
    }
</nav>

<div class="workbench-grid">
    <aside aria-label="Assessment readiness">
        <section class="panel" aria-labelledby="readiness-title">
            <h2 id="readiness-title" class="section-label">Readiness</h2>
            @if (Model.Assessment is { Readiness.Count: > 0 } assessment)
            {
                <ul class="blocker-list">
                    @foreach (var item in assessment.Readiness)
                    {
                        <li class="blocker" data-state="not-ready">
                            <strong>@item.Requirement</strong>
                            <small>@item.Source. @item.WhyOutstanding @item.HowToResolve</small>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="empty-state">No outstanding requirements are listed.</p>
            }
        </section>

        <section class="panel" aria-labelledby="send-title">
            <h2 id="send-title" class="section-label">Send to Claude</h2>
            <p>Claude works on this case directly. Every change is recorded with its author, and the values it records stay unconfirmed until you review them.</p>

            @if (Model.PanelState == "available")
            {
                <form id="send-to-claude-form" method="post" asp-page-handler="Send" asp-route-id="@caseId">
                    <input type="hidden" name="operationKey" value="@Model.SendOperationKey" />
                    <div class="button-row" data-send-available>
                        <button type="button" class="secondary-action send-action" data-send-open>
                            <svg class="send-action__sparkle" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 1.5c.6 4.6 1.9 7.6 4.2 9.9 2.3 2.3 5.3 3.6 9.9 4.2-4.6.6-7.6 1.9-9.9 4.2-2.3 2.3-3.6 5.3-4.2 9.9-.6-4.6-1.9-7.6-4.2-9.9C5.5 17.5 2.5 16.2-2 15.6c4.6-.6 7.6-1.9 9.9-4.2C10.1 9.1 11.4 6.1 12 1.5Z" fill="currentColor" /></svg>
                            <span>Send to Claude</span>
                        </button>
                    </div>
                </form>
            }

            <div role="status" aria-live="polite">
                <p class="empty-state" data-send-state="in-flight" hidden>Sending.</p>
                @if (Model.PanelState == "sent")
                {
                    <p class="empty-state" data-send-state="sent">Sent. Changes will appear on this case for your review.</p>
                    <form method="post" asp-page-handler="Reconcile" asp-route-id="@caseId">
                        <input type="hidden" name="requestId" value="@Model.LatestRequest!.RequestId" />
                        <input type="hidden" name="operationKey" value="@Model.ReconcileOperationKey" />
                        <div class="button-row">
                            <button type="submit" class="secondary-action">Check for completion</button>
                        </div>
                    </form>
                }
                @if (Model.PanelState == "completed")
                {
                    <div class="status-card" data-send-state="completed">
                        <h3>Claude has finished</h3>
                        <p>Review the changes on this case. Every change is listed in the <a href="/Cases/@caseId">case history</a>.</p>
                    </div>
                }
                @if (Model.PanelState == "unavailable")
                {
                    <div class="status-card status-card--attention" data-send-state="unavailable">
                        <h3>Not available</h3>
                        @if (Model.UnavailableReasons.Count > 0)
                        {
                            <p>@string.Join(" ", Model.UnavailableReasons)</p>
                        }
                        else
                        {
                            <p>Sending is not available for this case. The readiness list above names what is outstanding.</p>
                        }
                    </div>
                }
                @if (Model.PanelState == "failed")
                {
                    <div class="status-card status-card--error" data-send-state="failed">
                        <h3>Nothing was sent</h3>
                        <p>The case is unchanged. You can try again.@(Model.FailureReason is { } failure ? " " + failure : string.Empty)</p>
                    </div>
                    <form method="post" asp-page-handler="Send" asp-route-id="@caseId">
                        <input type="hidden" name="operationKey" value="@Model.SendOperationKey" />
                        <div class="button-row">
                            <button type="submit" class="secondary-action">Try again</button>
                        </div>
                    </form>
                }
            </div>
        </section>
    </aside>

    <div>
        @if (current == "vehicle")
        {
            <section class="panel" aria-labelledby="vehicle-title">
                <h2 id="vehicle-title">Vehicle</h2>
                <p class="lede">Identity and condition of the vehicle assessed. VIN, engine, fuel and odometer are not carried by every vehicle type.</p>
                <div class="form-grid section-gap">
                    <div>
                        <label for="vehicle-registration">Registration</label>
                        <input type="text" id="vehicle-registration" name="vehicle.registration" aria-describedby="vehicle-registration-hint" />
                        <small id="vehicle-registration-hint">Required.</small>
                    </div>
                    <div>
                        <label for="vehicle-type">Vehicle type</label>
                        <select id="vehicle-type" name="vehicle.vehicle_type" aria-describedby="vehicle-type-hint">
                            <option value=""></option>
                            <option value="car">Car</option>
                            <option value="van">Van</option>
                            <option value="motorcycle">Motorcycle</option>
                            <option value="scooter">Scooter</option>
                            <option value="bicycle">Bicycle</option>
                            <option value="trailer">Trailer</option>
                            <option value="caravan">Caravan</option>
                            <option value="other">Other</option>
                        </select>
                        <small id="vehicle-type-hint">Required.</small>
                    </div>
                    <div>
                        <label for="vehicle-make">Make</label>
                        <input type="text" id="vehicle-make" name="vehicle.make" aria-describedby="vehicle-make-hint" />
                        <small id="vehicle-make-hint">Required.</small>
                    </div>
                    <div>
                        <label for="vehicle-model">Model</label>
                        <input type="text" id="vehicle-model" name="vehicle.model" aria-describedby="vehicle-model-hint" />
                        <small id="vehicle-model-hint">Required.</small>
                    </div>
                    <div>
                        <label for="vehicle-year">Year</label>
                        <input type="text" id="vehicle-year" name="vehicle.year" class="tabular" aria-describedby="vehicle-year-hint" />
                        <small id="vehicle-year-hint">Required.</small>
                    </div>
                    <div>
                        <label for="vehicle-vin">VIN</label>
                        <input type="text" id="vehicle-vin" name="vehicle.vin" aria-describedby="vehicle-vin-hint" />
                        <small id="vehicle-vin-hint">Optional. No format is enforced.</small>
                    </div>
                    <div>
                        <label for="vehicle-engine">Engine size</label>
                        <input type="number" id="vehicle-engine" name="vehicle.engine_cc" min="0" step="1" class="tabular" aria-describedby="vehicle-engine-hint" />
                        <small id="vehicle-engine-hint">Optional. In cc.</small>
                    </div>
                    <div>
                        <label for="vehicle-fuel">Fuel</label>
                        <input type="text" id="vehicle-fuel" name="vehicle.fuel" aria-describedby="vehicle-fuel-hint" />
                        <small id="vehicle-fuel-hint">Optional.</small>
                    </div>
                    <div>
                        <label for="vehicle-odometer">Odometer reading</label>
                        <input type="number" id="vehicle-odometer" name="vehicle.odometer_miles" min="0" step="1" class="tabular" aria-describedby="vehicle-odometer-hint" />
                        <small id="vehicle-odometer-hint">In miles. Required unless the mileage source is To be confirmed.</small>
                    </div>
                    <div>
                        <label for="vehicle-mileage-source">Mileage source</label>
                        <select id="vehicle-mileage-source" name="vehicle.mileage_source" aria-describedby="vehicle-mileage-source-hint">
                            <option value=""></option>
                            <option value="online_data">Online data</option>
                            <option value="owner">Owner</option>
                            <option value="repairer">Repairer</option>
                            <option value="principal">Principal</option>
                            <option value="average">Average</option>
                            <option value="tbc">To be confirmed</option>
                        </select>
                        <small id="vehicle-mileage-source-hint">Required. Sets the mileage sentence in the Engineer's comments.</small>
                    </div>
                    <div>
                        <label for="vehicle-condition">Pre-incident condition</label>
                        <select id="vehicle-condition" name="vehicle.condition" aria-describedby="vehicle-condition-hint">
                            <option value=""></option>
                            <option value="poor">Poor</option>
                            <option value="below_average">Below average</option>
                            <option value="average">Average</option>
                            <option value="good">Good</option>
                            <option value="excellent">Excellent</option>
                        </select>
                        <small id="vehicle-condition-hint">Required.</small>
                    </div>
                </div>
                <div class="button-row section-gap">
                    <button type="button" class="primary-action">Save vehicle</button>
                </div>
            </section>
        }

        @if (current == "incident")
        {
            <section class="panel" aria-labelledby="incident-title">
                <h2 id="incident-title">Incident and impact</h2>
                <p class="lede">Dates for the incident and this instruction, and where and how hard the vehicle was struck.</p>
                <div class="form-grid section-gap">
                    <div>
                        <label for="incident-date">Incident date</label>
                        <input type="date" id="incident-date" name="incident.date" class="tabular" aria-describedby="incident-date-hint" />
                        <small id="incident-date-hint">Optional.</small>
                    </div>
                    <div>
                        <label for="incident-instructions">Instructions received</label>
                        <input type="date" id="incident-instructions" name="incident.instructions_received" class="tabular" aria-describedby="incident-instructions-hint" />
                        <small id="incident-instructions-hint">Required.</small>
                    </div>
                    <div>
                        <label for="incident-assessed">Assessed</label>
                        <input type="date" id="incident-assessed" name="incident.assessed" class="tabular" aria-describedby="incident-assessed-hint" />
                        <small id="incident-assessed-hint">Required.</small>
                    </div>
                    <div>
                        <label for="impact-severity">Impact severity</label>
                        <select id="impact-severity" name="assessment.impact_severity" aria-describedby="impact-severity-hint">
                            <option value=""></option>
                            <option value="light">Light</option>
                            <option value="light_to_moderate">Light to moderate</option>
                            <option value="moderate">Moderate</option>
                            <option value="moderate_to_heavy">Moderate to heavy</option>
                            <option value="heavy">Heavy</option>
                        </select>
                        <small id="impact-severity-hint">Required.</small>
                    </div>
                    <div>
                        <label for="impact-location">Impact location</label>
                        <select id="impact-location" name="assessment.impact_location" aria-describedby="impact-location-hint">
                            <option value=""></option>
                            <option value="front">Front</option>
                            <option value="left_front">Left front</option>
                            <option value="right_front">Right front</option>
                            <option value="left_side">Left side</option>
                            <option value="right_side">Right side</option>
                            <option value="rear">Rear</option>
                            <option value="left_rear">Left rear</option>
                            <option value="right_rear">Right rear</option>
                            <option value="roof">Roof</option>
                            <option value="underside">Underside</option>
                            <option value="wheel">Wheel</option>
                            <option value="interior">Interior</option>
                            <option value="mechanical">Mechanical</option>
                            <option value="multiple">Multiple</option>
                        </select>
                        <small id="impact-location-hint">Required.</small>
                    </div>
                    <div class="field-wide">
                        <label for="incident-nature">Nature of the incident</label>
                        <textarea id="incident-nature" name="narrative.nature_of_incident" rows="3" aria-describedby="incident-nature-hint"></textarea>
                        <small id="incident-nature-hint">Optional. Replaces the sentence written from the impact severity and location.</small>
                    </div>
                </div>
                <div class="button-row section-gap">
                    <button type="button" class="primary-action">Save incident and impact</button>
                </div>
            </section>
        }

        @if (current == "inspection")
        {
            <section class="panel" aria-labelledby="inspection-title">
                <h2 id="inspection-title">Inspection</h2>
                <p class="lede">How the vehicle was assessed, and where, when a physical inspection took place.</p>

                <div class="status-card status-card--info">
                    <h3>The principal sets the default</h3>
                    <p>The inspection mode comes from the principal's setting. Changing it on this case needs a reason, and address fields never imply attendance.</p>
                </div>

                <fieldset class="role-choices role-choices--stacked">
                    <legend>Assessment method</legend>
                    <label class="choice" for="method-image">
                        <input type="radio" id="method-image" name="assessment.method" value="image_based" />
                        <span>Image Based Assessment</span>
                    </label>
                    <label class="choice" for="method-physical">
                        <input type="radio" id="method-physical" name="assessment.method" value="physical" />
                        <span>Physical</span>
                    </label>
                </fieldset>

                <div class="form-grid section-gap">
                    <div class="field-wide">
                        <label for="inspection-address">Inspection address</label>
                        <textarea id="inspection-address" name="assessment.location_address" rows="4" aria-describedby="inspection-address-hint"></textarea>
                        <small id="inspection-address-hint">Required when the method is Physical. Leave empty for an Image Based Assessment.</small>
                    </div>
                </div>
                <div class="button-row section-gap">
                    <button type="button" class="primary-action">Save inspection</button>
                </div>
            </section>
        }

        @if (current == "valuation")
        {
            <section class="panel" aria-labelledby="valuation-title">
                <h2 id="valuation-title">Valuation</h2>
                <p class="lede">Guide evidence supports your opinion. The three figures you choose are the ones the report carries.</p>

                <h3 class="section-label section-gap">Guide evidence</h3>
                <div class="form-grid">
                    <div class="evidence-figure">
                        <span class="evidence-figure__label">CAP retail</span>
                        <span class="evidence-figure__value"><span aria-hidden="true">&#8212;</span><span class="vh">No value</span></span>
                        <span class="evidence-figure__source">No figure recorded</span>
                    </div>
                    <div class="evidence-figure">
                        <span class="evidence-figure__label">CAP trade</span>
                        <span class="evidence-figure__value"><span aria-hidden="true">&#8212;</span><span class="vh">No value</span></span>
                        <span class="evidence-figure__source">No figure recorded</span>
                    </div>
                    <div class="evidence-figure">
                        <span class="evidence-figure__label">Glass's retail</span>
                        <span class="evidence-figure__value"><span aria-hidden="true">&#8212;</span><span class="vh">No value</span></span>
                        <span class="evidence-figure__source">No figure recorded</span>
                    </div>
                    <div class="evidence-figure">
                        <span class="evidence-figure__label">Glass's trade</span>
                        <span class="evidence-figure__value"><span aria-hidden="true">&#8212;</span><span class="vh">No value</span></span>
                        <span class="evidence-figure__source">No figure recorded</span>
                    </div>
                    <div class="evidence-figure">
                        <span class="evidence-figure__label">Cazana retail</span>
                        <span class="evidence-figure__value"><span aria-hidden="true">&#8212;</span><span class="vh">No value</span></span>
                        <span class="evidence-figure__source">No figure recorded</span>
                    </div>
                    <div class="evidence-figure">
                        <span class="evidence-figure__label">Cazana trade</span>
                        <span class="evidence-figure__value"><span aria-hidden="true">&#8212;</span><span class="vh">No value</span></span>
                        <span class="evidence-figure__source">No figure recorded</span>
                    </div>
                </div>

                <div class="status-card status-card--info">
                    <h3>Guide figures stay on this screen</h3>
                    <p>They are evidence for your opinion and are read-only here. Only the three figures below reach the report.</p>
                </div>

                @{
                    var pavFigures = new[]
                    {
                        Model.MoneyField(AssessmentVocabulary.ValueRetail),
                        Model.MoneyField(AssessmentVocabulary.ValueTrade),
                        Model.MoneyField(AssessmentVocabulary.ValueEngineer)
                    }.Where(figure => figure is not null).Select(figure => figure!.Value).ToArray();
                    var pavMinimum = pavFigures.Length == 0 ? 0m : pavFigures.Min();
                    var pavMaximum = pavFigures.Length == 0 ? 0m : pavFigures.Max();
                    var pavDefault = Model.MoneyField(AssessmentVocabulary.ValueEngineer)
                        ?? (pavFigures.Length == 0 ? 0m : pavFigures.Max());
                    var pavHasRange = pavFigures.Length >= 2 && pavMinimum < pavMaximum;
                    var pavSalvage = Model.MoneyField(AssessmentVocabulary.SalvageValue);
                    var pavOutcomeIsTotalLoss = Model.FieldValue(AssessmentVocabulary.Outcome) == "total_loss";
                }

                <h3 class="section-label">Chosen figures</h3>
                <div class="form-grid">
                    <div>
                        <label for="value-retail">Retail value (&#163;)</label>
                        <input type="number" id="value-retail" name="assessment.values.retail" min="0" step="0.01" inputmode="decimal" class="tabular" aria-describedby="value-retail-hint" />
                        <small id="value-retail-hint">Required. Chosen from the guide evidence above.</small>
                    </div>
                    <div>
                        <label for="value-trade">Trade value (&#163;)</label>
                        <input type="number" id="value-trade" name="assessment.values.trade" min="0" step="0.01" inputmode="decimal" class="tabular" aria-describedby="value-trade-hint" />
                        <small id="value-trade-hint">Required. Chosen from the guide evidence above.</small>
                    </div>
                    <div>
                        <label for="value-engineer">Engineer's value (&#163;)</label>
                        <input type="number" id="value-engineer" name="assessment.values.engineer" min="0" step="0.01" inputmode="decimal" class="tabular" aria-describedby="value-engineer-hint" />
                        <small id="value-engineer-hint">Required. Your opinion. Usually the retail value; it may differ.</small>
                    </div>
                </div>

                <h3 class="section-label section-gap">Pre-accident value sensitivity</h3>
                @* A review aid only: it writes nothing, its value is never
                   copied into an input, and no figure is ever invented — a
                   missing input renders its named missing-evidence state. *@
                @if (pavHasRange)
                {
                    <div data-pav-slider
                         data-pav-minimum="@pavMinimum.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                         data-pav-maximum="@pavMaximum.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                         data-pav-default="@pavDefault.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                         data-pav-salvage="@(pavSalvage?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                         data-pav-total-loss="@(pavOutcomeIsTotalLoss ? "true" : "false")">
                        <p>Drag the pre-accident value across the recorded figures to see how sensitive the recorded outcome is to the PAV opinion.</p>
                        <div class="form-grid">
                            <div class="field-wide">
                                <label for="pav-range">Pre-accident value (&#163;)</label>
                                <input type="range" id="pav-range" min="@pavMinimum" max="@pavMaximum" step="1" value="@pavDefault" aria-describedby="pav-range-hint" />
                                <small id="pav-range-hint">The range spans the recorded valuation figures. Nothing is saved from this control.</small>
                            </div>
                            <div>
                                <label for="pav-value">Exact figure (&#163;)</label>
                                <input type="number" id="pav-value" class="tabular" min="@pavMinimum" max="@pavMaximum" step="1" value="@pavDefault" inputmode="numeric" />
                            </div>
                        </div>
                        <dl class="detail-list section-gap" aria-live="polite">
                            <div>
                                <dt>Repair-cost-to-PAV ratio</dt>
                                <dd class="empty-state">No costed repair total is recorded on this case. A ratio without a costed repair total is not evidence.</dd>
                            </div>
                            <div>
                                <dt>Position against threshold</dt>
                                <dd class="empty-state">No accepted total-loss threshold is recorded for this instruction.</dd>
                            </div>
                            <div>
                                <dt>Indicative settlement (PAV &#8722; salvage)</dt>
                                @if (pavOutcomeIsTotalLoss && pavSalvage is not null)
                                {
                                    <dd class="tabular" data-pav-settlement></dd>
                                }
                                else
                                {
                                    <dd class="empty-state">Shown when the recorded outcome is Total loss with a salvage value.</dd>
                                }
                            </div>
                        </dl>
                    </div>
                }
                else
                {
                    <p class="empty-state">The slider needs at least two distinct recorded valuation figures to give a range. Record the retail, trade, and engineer's values above.</p>
                }

                <div class="button-row section-gap">
                    <button type="button" class="primary-action">Save valuation</button>
                </div>
            </section>
        }

        @if (current == "estimate")
        {
            <section class="panel" aria-labelledby="estimate-title">
                <h2 id="estimate-title">Estimate</h2>
                <p class="lede">Build the repair one line at a time. Every total below follows from the lines and the rate card, so none of them are typed in.</p>

                <h3 class="section-label section-gap">Rate card</h3>
                @* Rates are published reference data with their own dates and caveat, not a
                   Pegasus tariff, so no figure is written into this page. The card supplies
                   them and the rate in use is shown back as a derived value. *@
                <div class="form-grid">
                    <div class="field-wide">
                        <label for="rate-card">Rate card</label>
                        <select id="rate-card" name="rates.card" aria-describedby="rate-card-hint">
                            <option value="">Choose a rate card</option>
                        </select>
                        <small id="rate-card-hint">A guide to charges, not a fixed tariff. The card carries its own dates.</small>
                    </div>
                    <div>
                        <fieldset class="role-choices role-choices--stacked">
                            <legend>Rate class</legend>
                            <label class="choice"><input type="radio" name="rates.class" value="standard" /> <span>Standard</span></label>
                            <label class="choice"><input type="radio" name="rates.class" value="prestige" /> <span>Prestige</span></label>
                            <label class="choice"><input type="radio" name="rates.class" value="van" /> <span>Vans up to 3.5 tonnes</span></label>
                        </fieldset>
                    </div>
                    <div>
                        <fieldset class="role-choices role-choices--stacked">
                            <legend>Adjustments</legend>
                            <label class="choice"><input type="checkbox" name="rates.manufacturer_approved" value="true" /> <span>Manufacturer-approved repairer</span></label>
                            <label class="choice"><input type="checkbox" name="rates.regional_uplift" value="true" /> <span>Higher-cost area</span></label>
                        </fieldset>
                        <small>Say what the case shows before applying either one.</small>
                    </div>
                    <div>
                        <dl class="detail-list">
                            <div>
                                <dt>Labour rate in use</dt>
                                <dd class="tabular"><span aria-hidden="true">&#8212;</span><span class="vh">No rate card chosen</span></dd>
                            </div>
                            <div>
                                <dt>Paint rate in use</dt>
                                <dd class="tabular"><span aria-hidden="true">&#8212;</span><span class="vh">No rate card chosen</span></dd>
                            </div>
                        </dl>
                    </div>
                </div>

                <h3 class="section-label section-gap">Repair lines</h3>
                <div class="table-wrap">
                    <table class="line-grid">
                        <caption>Each line is worth its work units divided by ten, times the rate &#8212; or its price, for parts and fixed charges.</caption>
                        <thead>
                            <tr>
                                <th scope="col">Line</th>
                                <th scope="col">Type</th>
                                <th scope="col">Code</th>
                                <th scope="col">Description</th>
                                <th scope="col">Work units</th>
                                <th scope="col">Price</th>
                                <th scope="col">Part number</th>
                                <th scope="col">Betterment</th>
                                <th scope="col">Status</th>
                                <th scope="col">Where this came from</th>
                                <th scope="col">Why this line</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var line = 0; line < 3; line++)
                            {
                                <tr>
                                    <th scope="row">Line @(line + 1)</th>
                                    <td>
                                        <label class="vh" for="line-type-@line">Type, line @(line + 1)</label>
                                        <select id="line-type-@line" name="operations[@line].type">
                                            <option value="">Choose</option>
                                            <option value="rnr">Remove and refit</option>
                                            <option value="repair">Repair</option>
                                            <option value="new_part">New part</option>
                                            <option value="check_labour">Check</option>
                                            <option value="paint_new">Paint &#8212; new part</option>
                                            <option value="paint_repair">Paint &#8212; repair</option>
                                            <option value="paint_blend">Paint &#8212; blend</option>
                                            <option value="paint_prep">Paint &#8212; preparation</option>
                                            <option value="specialist_fixed">Specialist, fixed price</option>
                                            <option value="specialist_wu">Specialist, by work units</option>
                                        </select>
                                    </td>
                                    <td>
                                        <label class="vh" for="line-guide-@line">Code, line @(line + 1)</label>
                                        <input type="text" id="line-guide-@line" name="operations[@line].guide" />
                                    </td>
                                    <td>
                                        <label class="vh" for="line-desc-@line">Description, line @(line + 1)</label>
                                        <input type="text" id="line-desc-@line" name="operations[@line].desc" />
                                    </td>
                                    <td>
                                        <label class="vh" for="line-wu-@line">Work units, line @(line + 1)</label>
                                        <input type="number" id="line-wu-@line" name="operations[@line].wu" min="0" step="0.1" inputmode="decimal" class="tabular" />
                                    </td>
                                    <td>
                                        <label class="vh" for="line-price-@line">Price, line @(line + 1)</label>
                                        <input type="number" id="line-price-@line" name="operations[@line].price" min="0" step="0.01" inputmode="decimal" class="tabular" />
                                        <label class="choice" for="line-unpriced-@line">
                                            <input type="checkbox" id="line-unpriced-@line" name="operations[@line].unpriced" value="true" />
