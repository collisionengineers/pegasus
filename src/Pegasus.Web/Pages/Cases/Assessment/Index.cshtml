                                        </label>
                                    </td>
                                    <td>
                                        <label class="vh" for="line-part-@line">Part number, line @(line + 1)</label>
                                        <input type="text" id="line-part-@line" name="operations[@line].part_num" />
                                    </td>
                                    <td>
                                        <label class="vh" for="line-bet-@line">Betterment, line @(line + 1)</label>
                                        <input type="text" id="line-bet-@line" name="operations[@line].bet" />
                                    </td>
                                    <td>
                                        <label class="vh" for="line-status-@line">Status, line @(line + 1)</label>
                                        <select id="line-status-@line" name="operations[@line].status">
                                            <option value="">Choose</option>
                                            <option value="confirmed">Confirmed</option>
