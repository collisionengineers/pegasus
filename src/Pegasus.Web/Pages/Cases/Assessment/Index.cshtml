@page "/Cases/{id:guid}/Assessment"
@model Pegasus.Web.Pages.Cases.Assessment.IndexModel
@using System.Globalization
@using Pegasus.Core.Assessment
@using Pegasus.Core.Cases
@using Pegasus.Web.Presentation
@*
    The Assessment workspace (context.md §1.9, ENG-025). Access is owned by
    Core's AssessmentAccessPolicy (D11: With Engineer or onwards plus a
    current-cycle export; read-only once Complete). The evidence rail and
    the Estimates pane render custody facts and the repair-specification
    seam; the multi-estimate editor (tabs, per-estimate fields, lines and
    totals) is ENG-028, and no placeholder is drawn for it here.
*@
@{
    ViewData["Title"] = "Assessment";

    var caseId = ViewContext.RouteData.Values["id"]?.ToString() ?? string.Empty;
}

@if (Model.UnavailableReference is not null)
{
    var gateEyebrow = string.IsNullOrWhiteSpace(Model.UnavailableRegistration)
        ? Model.UnavailableReference
        : $"{Model.UnavailableReference} · {Model.UnavailableRegistration}";
    <header class="page-header">
        <div class="page-title">
            <p class="eyebrow">@gateEyebrow</p>
            <h1>Assessment unavailable</h1>
        </div>
        <div class="page-actions">
            <a class="btn" asp-page="/Cases/Details" asp-route-id="@caseId">
                <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
                <span>Back to Case</span>
            </a>
        </div>
    </header>
    <div class="notice notice--warning" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>A current Review-cycle EVA export is required before the assessment opens.</span>
    </div>
    return;
}

@{
    var caseStage = OperatorLabels.CaseStage(Model.Case!.Header.State);
    var registration = string.IsNullOrWhiteSpace(Model.Case.Header.Registration)
        ? "No registration"
        : Model.Case.Header.Registration!;
    var vehicle = Model.VehicleDisplay;
    var mileage = Model.MileageDisplay;
    var claimant = string.IsNullOrWhiteSpace(Model.Claimant) ? "Not recorded" : Model.Claimant!;
    var editing = !string.IsNullOrWhiteSpace(Model.LeaseToken) && !Model.CaseIsArchived;
    var canImport = Model.ImportCondition is null;
    var engineerValue = Model.EngineerValue;
    var targetBase = engineerValue is null ? string.Empty
        : engineerValue.Value.ToString("0.##", CultureInfo.InvariantCulture);
}

<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">@Model.HeaderEyebrow</p>
        <h1>Assessment</h1>
    </div>
    <div class="page-actions">
        <a class="btn" asp-page="/Cases/Details" asp-route-id="@caseId">
            <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
            <span>Back to Case</span>
        </a>
        <form method="get" data-refresh-form>
            <button type="submit" class="btn btn--small" title="Refresh">
                <svg class="icon icon--spin" aria-hidden="true"><use href="#icon-refresh-cw" /></svg>
                <span>Refresh</span>
            </button>
        </form>
    </div>
</header>

@if (TempData["AssessmentStatus"] is string assessmentStatus)
{
    <div class="notice notice--success mb-2" role="status" data-confirmation>
        <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
        <span>@assessmentStatus</span>
    </div>
}
@if (TempData["AssessmentError"] is string assessmentError)
{
    <div class="notice notice--danger mb-2" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>@assessmentError</span>
    </div>
}
@if (Model.ReportDraftNotReady)
{
    <div class="notice notice--warning mb-2" role="status">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>
            Report draft not ready: @string.Join("; ", Model.ReportDraftReasons.Select(reason => reason.Requirement)).
        </span>
    </div>
}

<article class="record">
    <div class="record-ribbon assessment-identity-ribbon" aria-label="Case identity">
        <div class="ribbon-item ribbon-ref">
            <div class="ribbon-label">Case/PO</div>
            <div class="ribbon-value">@Model.Case.Header.Reference</div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">Registration</div>
            <div class="ribbon-value">@registration</div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">Claimant</div>
            <div class="ribbon-value">@claimant</div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">Principal</div>
            <div class="ribbon-value">@Model.Case.Header.Principal</div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">State</div>
            <div class="ribbon-value"><partial name="Shared/_StatusChip" model="@caseStage" /></div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">Mileage</div>
            <div class="ribbon-value">@(mileage is null ? "Not recorded" : mileage)</div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">Vehicle</div>
            <div class="ribbon-value">@(vehicle.Length == 0 ? "Not recorded" : vehicle)</div>
        </div>
    </div>

    @* Presence: who holds the case's one edit authority, as the Case
       workspace shows it (FRD-01, CASE-024). *@
    @if (Model.ViewerHoldsEditAuthority)
    {
        <div class="presence-strip" role="status">
            <span class="presence-dot" aria-hidden="true"></span>
            <span>You are editing this case.</span>
        </div>
    }
    else if (Model.EditAuthorityHolder is { } holder)
    {
        <div class="presence-strip" role="status">
            <span class="presence-dot" aria-hidden="true"></span>
            <span data-edit-authority>@EditModeDisplay.HeldBy(holder, false) Editing cannot be taken over.</span>
        </div>
    }

    @* The bar carries the actions valid now; each posts to the Core action
       that owns it. The estimate controls are lease-carrying acts, so they
       need the edit mode entered here; a read-only case (D11) offers none
       of them. Glass's and Audatex are the D7 disabled seams (EXT-09). *@
    <div class="record-bar">
        @if (!Model.CaseIsArchived && !Model.IsReadOnly)
        {
            @if (editing)
            {
                <form method="post" asp-page-handler="ReleaseLease" data-edit-toggle-off>
                    <input type="hidden" name="id" value="@caseId" />
                    <input type="hidden" name="operationKey" value="@Model.ReleaseLeaseOperationKey" />
                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                    <button type="submit" class="btn btn--dark">
                        <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                        <span>Finish editing</span>
                    </button>
                </form>
                <partial name="Shared/_EditHeartbeat" view-data='new ViewDataDictionary(ViewData) { ["HeartbeatCaseId"] = caseId, ["HeartbeatLeaseToken"] = Model.LeaseToken }' />
            }
            else if (Model.CanRecoverLease)
            {
                <form method="post" asp-page-handler="ClaimLease">
                    <input type="hidden" name="id" value="@caseId" />
                    <input type="hidden" name="expectedVersion" value="@Model.Case!.Header.Version" />
                    <input type="hidden" name="operationKey" value="@Model.ClaimLeaseOperationKey" />
                    <button type="submit" class="btn">Recover editing</button>
                </form>
            }
            else if (Model.EditAuthorityHolder is null)
            {
                <form method="post" asp-page-handler="ClaimLease">
                    <input type="hidden" name="id" value="@caseId" />
                    <input type="hidden" name="expectedVersion" value="@Model.Case!.Header.Version" />
                    <input type="hidden" name="operationKey" value="@Model.ClaimLeaseOperationKey" />
                    <button type="submit" class="btn">
                        <svg class="icon" aria-hidden="true"><use href="#icon-pencil" /></svg>
                        <span>Edit assessment</span>
                    </button>
                </form>
            }
        }
        @if (!Model.CaseIsArchived && !Model.IsReadOnly && Model.ActorIsEngineer)
        {
            <a class="btn btn--dark" asp-page="/Cases/Assessment/Index" asp-route-id="@caseId"
               asp-route-estimate="new">
                <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                <span>New estimate</span>
            </a>
        }
        @if (canImport)
        {
            <a class="btn" asp-page="/Cases/Assessment/Index" asp-route-id="@caseId"
               asp-route-dialog="import-estimate" data-dialog-open="import-estimate-dialog">
                <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                <span>Import estimate</span>
            </a>
        }
        else if (Model.ImportCondition is not null && !Model.CaseIsArchived)
        {
            <span class="gated" data-condition="@Model.ImportCondition">
                <button type="button" class="btn" disabled aria-disabled="true">
                    <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                    <span>Import estimate</span>
                </button>
            </span>
        }
        <span class="gated" data-condition="@Model.EstimatingServiceCondition">
            <button type="button" class="btn" disabled aria-disabled="true">Glass's</button>
        </span>
        <span class="gated" data-condition="@Model.EstimatingServiceCondition">
            <button type="button" class="btn" disabled aria-disabled="true">Audatex</button>
        </span>
        @if (Model.SendToClaudeCondition is null)
        {
            <a class="btn btn--primary" asp-page="/Cases/Assessment/Index" asp-route-id="@caseId"
               asp-route-dialog="send-to-claude" data-dialog-open="send-to-claude-dialog">
                <svg class="icon" aria-hidden="true"><use href="#icon-send" /></svg>
                <span>Send to Claude</span>
            </a>
        }
        else
        {
            <span class="gated" data-condition="@Model.SendToClaudeCondition">
                <button type="button" class="btn btn--primary" disabled aria-disabled="true">
                    <svg class="icon" aria-hidden="true"><use href="#icon-send" /></svg>
                    <span>Send to Claude</span>
                </button>
            </span>
        }
        <span class="record-bar-end">
            @if (Model.ReportDraftCondition is null)
            {
                <form method="post" asp-page-handler="GenerateReportDraft" asp-route-id="@caseId">
                    <input type="hidden" name="operationKey" value="@Model.ReportDraftOperationKey" />
                    <button type="submit" class="btn">
                        <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                        <span>Generate report draft</span>
                    </button>
                </form>
                <a class="btn" asp-page="/Cases/Assessment/Index" asp-route-id="@caseId"
                   asp-page-handler="PreviewReportDraft" target="_blank" rel="noopener">
                    <svg class="icon" aria-hidden="true"><use href="#icon-eye" /></svg>
                    <span>Preview report draft</span>
                </a>
            }
            else if (Model.ReportDraftPreparation is not null)
            {
                <span class="gated" data-condition="@Model.ReportDraftCondition">
                    <button type="button" class="btn" disabled aria-disabled="true">
                        <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                        <span>Generate report draft</span>
                    </button>
                </span>
            }
        </span>
    </div>

    <div class="record-body">
        <section class="assessment-v3" aria-label="Assessment workspace">
            @* Evidence rail: the instruction documents and custody-confirmed
               images, each opening the shared evidence viewer through the
               same authorised download-inline routes the Case Files view
               uses (DOCS-011). *@
            <aside class="pane assessment-v3-evidence" aria-label="Evidence">
                <div class="pane-head">
                    <h2>Evidence</h2>
                    <button type="button" class="assessment-rail-toggle" data-rail-toggle
                            aria-expanded="true" aria-label="Collapse Evidence rail">
                        <svg class="icon" aria-hidden="true"><use href="#icon-chevron-left" /></svg>
                    </button>
                </div>
                <div class="pane-body pane-scroll">
                    <div class="assessment-evidence-list" data-evidence-set>
                        @foreach (var file in Model.InstructionFiles)
                        {
                            var previewHref = Url.Page("/Cases/Documents/Download", new
                            {
                                caseId,
                                occurrenceId = file.Occurrence.Id,
                                versionId = file.Version.Id,
                                inline = true
                            });
                            var downloadHref = Url.Page("/Cases/Documents/Download", new
                            {
                                caseId,
                                occurrenceId = file.Occurrence.Id,
                                versionId = file.Version.Id
                            });
                            <a class="row-button" href="@previewHref" data-evidence-item
                               data-download-href="@downloadHref"
                               data-media-type="@file.Version.MediaType"
                               data-file-name="@file.Version.FileName">
                                <span class="row-title">@file.Version.FileName</span>
                                <span class="row-meta">Instruction</span>
                            </a>
                        }
                        @foreach (var image in Model.EvidenceImages)
                        {
                            string previewHref;
                            string downloadHref;
                            if (image.IsCaseDocument)
                            {
                                downloadHref = Url.Page("/Cases/Documents/Download", new
                                {
                                    caseId,
                                    occurrenceId = image.OccurrenceId,
                                    versionId = image.VersionId
                                })!;
                                previewHref = Url.Page("/Cases/Documents/Download", new
                                {
                                    caseId,
                                    occurrenceId = image.OccurrenceId,
                                    versionId = image.VersionId,
                                    inline = true
                                })!;
                            }
                            else
                            {
                                downloadHref = Url.Page("/Intake/Asset", new { id = image.ReceiptId, assetId = image.AssetId })!;
                                previewHref = downloadHref;
                            }
                            <a class="row-button" href="@previewHref" data-evidence-item
                               data-download-href="@downloadHref"
                               data-media-type="@image.MediaType"
                               data-file-name="@image.FileName">
                                <span class="row-title">@image.FileName</span>
                                <span class="row-meta">Vehicle image</span>
                            </a>
                        }
                    </div>
                </div>
            </aside>

            <section class="pane assessment-v3-main">
                <div class="pane-head"><h2>Estimates</h2></div>
                <div class="pane-body pane-scroll">
                    <div class="detail-canvas">
                        <div class="assessment-estimates">
                            @if (Model.Estimates.Count > 0 || Model.EditingNewEstimate)
                            {
                                <div class="estimate-tabs" role="tablist" aria-label="Estimates">
                                    @foreach (var estimate in Model.Estimates)
                                    {
                                        var isSelected = Model.SelectedEstimate?.SpecificationId == estimate.SpecificationId
                                            && !Model.EditingNewEstimate;
                                        <a class="estimate-tab" role="tab"
                                           asp-page="/Cases/Assessment/Index" asp-route-id="@caseId"
                                           asp-route-estimate="@estimate.SpecificationId"
                                           aria-selected="@(isSelected ? "true" : "false")">
                                            @estimate.Details.Name@(estimate.IsCurrent ? " · Current" : null)
                                        </a>
                                    }
                                    @if (Model.EditingNewEstimate)
                                    {
                                        <a class="estimate-tab" role="tab" aria-selected="true"
                                           asp-page="/Cases/Assessment/Index" asp-route-id="@caseId"
                                           asp-route-estimate="new">New estimate</a>
                                    }
                                </div>
                            }
                            else
                            {
                                @* The design authority requires every screen to
                                   define its empty state in business language.
                                   One stated value, not a panel with a heading:
                                   the pane says the fact and draws no inert tab
                                   strip or editor beneath it. *@
                                <div class="empty estimate-empty">No estimates recorded</div>
                            }

                            @if (Model.SelectedEstimate is not null || Model.EditingNewEstimate)
                            {
                                var estimate = Model.SelectedEstimate;
                                var editable = Model.SelectedEstimateIsEditable;
                                var details = Model.EditorDetails!;
                                var totals = Model.EditorTotals;
                                var route = estimate?.Source.Route ?? RepairSpecificationSourceRoute.Manual;
                                <section class="panel estimate-editor" aria-labelledby="estimate-editor-title">
                                    <div class="panel-head">
                                        <div>
                                            <h2 id="estimate-editor-title">@(Model.EditingNewEstimate ? "New estimate" : details.Name)</h2>
                                            <span class="panel-title-meta">@OperatorLabels.RepairSpecificationRoute(route)</span>
                                        </div>
                                        <div class="button-row">
                                            @if (editable && estimate is not null && !estimate.IsCurrent)
                                            {
                                                <a class="btn btn--danger" asp-page="/Cases/Assessment/Index"
                                                   asp-route-id="@caseId" asp-route-estimate="@estimate.SpecificationId"
                                                   asp-route-dialog="delete-estimate" data-dialog-open="delete-estimate-dialog">
                                                    <svg class="icon" aria-hidden="true"><use href="#icon-trash-2" /></svg>
                                                    <span>Delete estimate</span>
                                                </a>
                                            }
                                            @if (Model.SelectedEstimateCanBeDuplicated && estimate is not null)
                                            {
                                                <form method="post" asp-page-handler="DuplicateEstimate" asp-route-id="@caseId">
                                                    <input type="hidden" name="operationKey" value="@Model.DuplicateOperationKey" />
                                                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                                                    <input type="hidden" name="estimateId" value="@estimate.SpecificationId" />
                                                    <button type="submit" class="btn">
                                                        <svg class="icon" aria-hidden="true"><use href="#icon-copy" /></svg>
                                                        <span>Duplicate</span>
                                                    </button>
                                                </form>
                                            }
                                            @if (Model.SelectedEstimateCanBeCurrent && estimate is not null)
                                            {
                                                <form method="post" asp-page-handler="SetCurrentEstimate" asp-route-id="@caseId">
                                                    <input type="hidden" name="operationKey" value="@Model.UseEstimateOperationKey" />
                                                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                                                    <input type="hidden" name="estimateId" value="@estimate.SpecificationId" />
                                                    <button type="submit" class="btn">
                                                        <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                                                        <span>Use estimate</span>
                                                    </button>
                                                </form>
                                            }
                                            @if (estimate?.IsCurrent == true)
                                            {
                                                <partial name="Shared/_StatusChip" model="@("Current")" />
                                            }
                                        </div>
                                    </div>
                                    <div class="panel-body">
                                        @if (editable)
                                        {
                                            <form method="post" asp-page-handler="SaveEstimate" asp-route-id="@caseId">
                                                <input type="hidden" name="operationKey" value="@Model.SaveEstimateOperationKey" />
                                                <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                                                <input type="hidden" name="estimateId" value="@(estimate?.SpecificationId)" />
                                                <div class="estimate-form-grid">
                                                    <div>
                                                        <label for="estimate-name">Estimate name</label>
                                                        <input id="estimate-name" name="estimateName" maxlength="100" required value="@details.Name" />
                                                    </div>
                                                    <div>
                                                        <label for="estimate-days">Repair days</label>
                                                        <input id="estimate-days" name="estimateRepairDays" type="number" min="0" step="1" inputmode="numeric" class="tabular" value="@details.RepairDays" />
                                                    </div>
                                                    <div>
                                                        <label for="estimate-labour-rate">Labour rate (&#163;/h)</label>
                                                        <input id="estimate-labour-rate" name="estimateLabourRate" type="number" min="0" step="0.01" inputmode="decimal" class="tabular" value="@details.LabourRate" />
                                                    </div>
                                                    <div>
                                                        <label for="estimate-paint-rate">Paint labour rate (&#163;/h)</label>
                                                        <input id="estimate-paint-rate" name="estimatePaintLabourRate" type="number" min="0" step="0.01" inputmode="decimal" class="tabular" value="@details.PaintLabourRate" />
                                                    </div>
                                                    <div>
                                                        <label for="estimate-materials">Paint materials (&#163;)</label>
                                                        <input id="estimate-materials" name="estimatePaintMaterials" type="number" min="0" step="0.01" inputmode="decimal" class="tabular" value="@details.PaintMaterials" />
                                                    </div>
                                                    <div>
                                                        <label for="estimate-other">Other costs (&#163;)</label>
                                                        <input id="estimate-other" name="estimateOtherCosts" type="number" min="0" step="0.01" inputmode="decimal" class="tabular" value="@details.OtherCosts" />
                                                    </div>
                                                    <div>
                                                        <label for="estimate-vat">VAT %</label>
                                                        <input id="estimate-vat" name="estimateVatPercent" type="number" min="0" max="100" step="0.01" inputmode="decimal" class="tabular" value="@details.VatPercent" />
                                                    </div>
                                                </div>
                                                @{ var editLineAction = Url.Page("/Cases/Assessment/Index", "EditLine", new { id = caseId }); }
                                                <div class="estimate-table-head">
                                                    <h3>Parts and operations</h3>
                                                    <button type="submit" class="btn" name="addLine" value="true" formaction="@editLineAction">
                                                        <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                                                        <span>Add line</span>
                                                    </button>
                                                </div>
                                                <div class="table-wrap estimate-table">
                                                    <table>
                                                        <thead>
                                                            <tr>
                                                                <th scope="col">Operation</th>
                                                                <th scope="col">Description</th>
                                                                <th scope="col">Part number</th>
                                                                <th scope="col">Qty</th>
                                                                <th scope="col">Labour h</th>
                                                                <th scope="col">Paint h</th>
                                                                <th scope="col">Part &#163;</th>
                                                                <th scope="col"><span class="sr-only">Action</span></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @for (var line = 0; line < Model.EditorLines.Count; line++)
                                                            {
                                                                var row = Model.EditorLines[line];
                                                                <tr>
                                                                    <td>
                                                                        <input type="hidden" name="lineId" value="@row.ExistingLineId" />
                                                                        <label class="vh" for="line-operation-@line">Operation, line @(line + 1)</label>
                                                                        <select id="line-operation-@line" name="lineOperation">
                                                                            @foreach (var (value, label) in new[] { ("Replace", "Replace"), ("Repair", "Repair"), ("RemoveAndRefit", "R&I"), ("Paint", "Paint"), ("Other", "Other") })
                                                                            {
                                                                                <option value="@value" selected="@(row.Operation == value ? "selected" : null)">@label</option>
                                                                            }
                                                                        </select>
                                                                    </td>
                                                                    <td><label class="vh" for="line-description-@line">Description, line @(line + 1)</label><input id="line-description-@line" name="lineDescription" value="@row.Description" /></td>
                                                                    <td><label class="vh" for="line-part-@line">Part number, line @(line + 1)</label><input id="line-part-@line" name="linePartNumber" value="@row.PartNumber" /></td>
                                                                    <td><label class="vh" for="line-quantity-@line">Quantity, line @(line + 1)</label><input id="line-quantity-@line" name="lineQuantity" type="number" min="1" step="1" inputmode="numeric" class="tabular" value="@row.Quantity" /></td>
                                                                    <td><label class="vh" for="line-labour-@line">Labour hours, line @(line + 1)</label><input id="line-labour-@line" name="lineLabourHours" type="number" min="0" step="0.1" inputmode="decimal" class="tabular" value="@row.LabourHours" /></td>
                                                                    <td><label class="vh" for="line-paint-@line">Paint hours, line @(line + 1)</label><input id="line-paint-@line" name="linePaintHours" type="number" min="0" step="0.1" inputmode="decimal" class="tabular" value="@row.PaintHours" /></td>
                                                                    <td><label class="vh" for="line-pounds-@line">Part amount, line @(line + 1)</label><input id="line-pounds-@line" name="linePartPounds" type="number" min="0" step="0.01" inputmode="decimal" class="tabular" value="@row.PartPounds" /></td>
                                                                    <td><button type="submit" class="btn btn--icon estimate-remove" name="removeLine" value="@line" formaction="@editLineAction" aria-label="Remove line @(line + 1)"><svg class="icon" aria-hidden="true"><use href="#icon-trash-2" /></svg></button></td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <div class="estimate-bottom">
                                                    <div class="estimate-notes"><label for="estimate-notes">Estimate notes</label><textarea id="estimate-notes" name="estimateNotes" rows="4" maxlength="4000">@details.Notes</textarea></div>
                                                    RenderEstimateTotals(totals);
                                                </div>
                                                <div class="button-row section-gap"><button type="submit" class="btn btn--dark"><svg class="icon" aria-hidden="true"><use href="#icon-save" /></svg><span>Save estimate</span></button></div>
                                            </form>
                                        }
                                        else
                                        {
                                            <dl class="detail-list">
                                                <div><dt>Repair days</dt><dd>@(details.RepairDays?.ToString(CultureInfo.InvariantCulture) ?? "Not recorded")</dd></div>
                                                <div><dt>Labour rate</dt><dd>@(details.LabourRate is { } labourRate ? $"£{labourRate.ToString("N2")}/h" : "Not recorded")</dd></div>
                                                <div><dt>Paint labour rate</dt><dd>@(details.PaintLabourRate is { } paintRate ? $"£{paintRate.ToString("N2")}/h" : "Not recorded")</dd></div>
                                                <div><dt>Paint materials</dt><dd>@(details.PaintMaterials is { } paintMaterials ? $"£{paintMaterials.ToString("N2")}" : "Not recorded")</dd></div>
                                                <div><dt>Other costs</dt><dd>@(details.OtherCosts is { } otherCosts ? $"£{otherCosts.ToString("N2")}" : "Not recorded")</dd></div>
                                                <div><dt>VAT</dt><dd>@($"{totals.VatPercent.ToString("0.##", CultureInfo.InvariantCulture)}%")</dd></div>
                                            </dl>
                                            <div class="estimate-bottom">
                                                <div class="estimate-notes"><h3 class="section-label">Notes</h3>@(string.IsNullOrWhiteSpace(details.Notes) ? "None recorded" : details.Notes)</div>
                                                RenderEstimateTotals(totals);
                                            </div>
                                            RenderSpecificationLines(estimate!, "recorded");
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                </div>
            </section>
        </section>
    </div>
</article>

@if (canImport)
