@section Scripts {
    <script>
        // PAV sensitivity slider: a review aid that writes nothing. It keeps
        // the range and numeric inputs in step and recomputes the indicative
        // settlement as text. No animation, no colour signalling, no network.
        (function () {
            var host = document.querySelector('[data-pav-slider]');
            if (!host) { return; }

            var range = host.querySelector('#pav-range');
            var exact = host.querySelector('#pav-value');
            var settlement = host.querySelector('[data-pav-settlement]');
            var salvage = parseFloat(host.getAttribute('data-pav-salvage'));
            var isTotalLoss = host.getAttribute('data-pav-total-loss') === 'true';
            if (!range || !exact) { return; }

            function formatPounds(value) {
                return '£' + value.toLocaleString('en-GB', {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 2
                });
            }

            function update(value) {
                var figure = parseFloat(value);
                if (!isFinite(figure)) { return; }
                range.value = String(figure);
                exact.value = String(figure);
                if (settlement && isTotalLoss && isFinite(salvage)) {
                    settlement.textContent = formatPounds(figure - salvage)
                        + ' at a PAV of ' + formatPounds(figure);
                }
            }

            range.addEventListener('input', function () { update(range.value); });
            exact.addEventListener('input', function () { update(exact.value); });
            update(range.value);
        }());
    </script>
    <script>
        // Ember field behind the Send to Claude glyph. Decoration only: it draws
        // to a canvas layered under the label and reads nothing from the page.
        //
        // The particle placement comes from a seeded generator rather than
        // Math.random, so every load of a given button produces the same drift
        // instead of fresh noise each time.
        //
        // It does not start at all under reduced motion, and it stops itself
        // when the button leaves the document, so a hidden panel does not keep
        // an animation frame alive.
        (function () {
            var motionIsWelcome = !window.matchMedia
                || !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!motionIsWelcome) { return; }

            var palette = ['#ffd9c2', '#a9c7e8', '#c3d1ad'];

            function seededRandom(seed) {
                return function () {
                    seed |= 0;
                    seed = seed + 0x6D2B79F5 | 0;
                    var t = Math.imul(seed ^ seed >>> 15, 1 | seed);
                    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
                    return ((t ^ t >>> 14) >>> 0) / 4294967296;
                };
            }

            function attachEmbers(button, seed) {
                var canvas = document.createElement('canvas');
                canvas.setAttribute('aria-hidden', 'true');
                button.prepend(canvas);

                var context = canvas.getContext('2d');
                if (!context) { return; }

                var random = seededRandom(seed);
                var particles = [];
                for (var i = 0; i < 10; i++) {
                    particles.push({
                        baseX: random(),
                        baseY: random(),
                        radius: 1.1 + random() * 1.6,
                        speed: 0.4 + random() * 0.5,
                        phase: random() * Math.PI * 2,
                        colour: palette[i % palette.length]
                    });
                }

                function resize() {
                    var box = button.getBoundingClientRect();
                    canvas.width = box.width;
                    canvas.height = box.height;
                }

                resize();
                window.addEventListener('resize', resize);

                var time = 0;
                var hovered = false;
                button.addEventListener('mouseenter', function () { hovered = true; });
                button.addEventListener('mouseleave', function () { hovered = false; });

                function draw() {
                    if (!button.isConnected) { return; }

                    time += hovered ? 0.028 : 0.012;
                    context.clearRect(0, 0, canvas.width, canvas.height);

                    particles.forEach(function (particle) {
                        var x = (particle.baseX * canvas.width)
                            + Math.sin(time * particle.speed + particle.phase) * (canvas.width * 0.06);
                        var y = (particle.baseY * canvas.height)
                            + Math.cos(time * particle.speed * 1.3 + particle.phase) * (canvas.height * 0.22);

                        context.beginPath();
                        context.fillStyle = particle.colour;
                        context.globalAlpha = Math.max(0, 0.35 + 0.25 * Math.sin(time * 2 + particle.phase));
                        context.shadowBlur = 6;
                        context.shadowColor = particle.colour;
                        context.arc(x, y, particle.radius, 0, Math.PI * 2);
                        context.fill();
                    });

                    context.globalAlpha = 1;
                    window.requestAnimationFrame(draw);
                }

                window.requestAnimationFrame(draw);
            }

            document.querySelectorAll('.send-action').forEach(function (button, index) {
                attachEmbers(button, 90210 + index);
            });
        }());
    </script>
    <script>
        // Presentation only: opens the confirm dialog, keeps focus inside it,
        // returns focus to the invoking control, and reveals the in-flight
        // state so each state in this panel can be seen. No case data moves.
        (function () {
            var dialog = document.getElementById('send-confirm');
            if (!dialog) { return; }

            var opener = document.querySelector('[data-send-open]');
            var available = document.querySelector('[data-send-available]');
            var inFlight = document.querySelector('[data-send-state="in-flight"]');
            var invoker = null;

            function focusable() {
                return Array.prototype.filter.call(
                    dialog.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'),
                    function (element) { return !element.disabled && !element.hidden; });
            }

            function close() {
                dialog.hidden = true;
                document.removeEventListener('keydown', onKeydown, true);
                if (invoker) { invoker.focus(); }
            }

            function onKeydown(event) {
                if (event.key === 'Escape') {
                    event.preventDefault();
                    close();
                    return;
                }
                if (event.key !== 'Tab') { return; }
                var items = focusable();
                if (items.length === 0) { return; }
                var first = items[0];
                var last = items[items.length - 1];
                if (event.shiftKey && document.activeElement === first) {
                    event.preventDefault();
                    last.focus();
                } else if (!event.shiftKey && document.activeElement === last) {
                    event.preventDefault();
                    first.focus();
                }
            }

            if (opener) {
                opener.addEventListener('click', function () {
                    invoker = opener;
                    dialog.hidden = false;
                    document.addEventListener('keydown', onKeydown, true);
                    var items = focusable();
                    if (items.length > 0) { items[0].focus(); }
                });
            }

            dialog.addEventListener('click', function (event) {
                if (event.target === dialog) { close(); }
            });

            var cancel = dialog.querySelector('[data-send-cancel]');
            if (cancel) { cancel.addEventListener('click', close); }

            var confirmButton = dialog.querySelector('[data-send-confirm]');
            if (confirmButton) {
                confirmButton.addEventListener('click', function () {
                    close();
                    if (available) { available.hidden = true; }
                    if (inFlight) { inFlight.hidden = false; }
                    var form = document.getElementById('send-to-claude-form');
                    if (form) { form.submit(); }
                });
            }
        }());
    </script>
}
