@page "/Cases/{id:guid}"
@model Pegasus.Web.Pages.Cases.DetailModel
@using Pegasus.Core.Cases
@{
    ViewData["Title"] = "Case detail";
    var item = Model.Detail!;
}
<main class="page-shell">
    <header class="page-heading"><a href="/Cases">Cases</a><p class="eyebrow">Case workspace</p><h1>@item.Identity.DisplayReference</h1><p>@item.Identity.PrincipalCode · @item.Identity.Type · @item.State@if(item.IsHeld){<span> · Held</span>}</p></header>
    @if(Model.Error is not null){<div class="panel error-panel" role="alert">@Model.Error</div>}
    <section class="panel stack-lg"><h2>Immutable identity</h2><dl class="detail-list"><dt>Case / PO</dt><dd>@item.Identity.BaseReference</dd><dt>Display reference</dt><dd>@item.Identity.DisplayReference</dd><dt>Principal</dt><dd>@item.Identity.PrincipalCode</dd><dt>Registration</dt><dd>@item.Identity.Registration</dd><dt>Type</dt><dd>@item.Identity.Type</dd></dl></section>
    <div class="two-column-layout"><section class="panel stack-lg"><h2>Workflow and due work</h2><dl class="detail-list"><dt>State</dt><dd>@item.State</dd><dt>Received</dt><dd>@item.ReceivedAtUtc.ToLocalTime().ToString("g")</dd><dt>Next due</dt><dd>@(item.DueWork.NextDueAtUtc?.ToLocalTime().ToString("g") ?? "No due work")</dd><dt>Chases</dt><dd>@item.DueWork.ChaseCount</dd><dt>Terminal outcome</dt><dd>@(item.TerminalOutcome?.ToString() ?? "Open")</dd></dl>@if(item.DueWork.IsOverdue){<p class="status-danger">Overdue</p>}</section><section class="panel stack-lg"><h2>Edit lease</h2>@if(item.Lease.HeldByCurrentActor){<p>Editing until @item.Lease.ExpiresAtUtc?.ToLocalTime().ToString("g").</p><form method="post" asp-page-handler="RenewLease" asp-route-id="@item.Identity.Id"><input type="hidden" asp-for="LeaseToken" /><button class="button button-secondary" type="submit">Renew lease</button></form><form method="post" asp-page-handler="LeaveEdit" asp-route-id="@item.Identity.Id"><input type="hidden" asp-for="LeaseToken" /><button class="button button-secondary" type="submit">Leave edit</button></form>}else if(item.Lease.HolderId is not null){<p>Read-only: @item.Lease.HolderName is editing until @item.Lease.ExpiresAtUtc?.ToLocalTime().ToString("g").</p>}else{<p>No active editor.</p><form method="post" asp-page-handler="EnterEdit" asp-route-id="@item.Identity.Id"><button class="button button-primary" type="submit">Enter edit</button></form>}</section></div>
    @if(item.Lease.HeldByCurrentActor){<section class="panel stack-lg"><h2>Actions</h2><form method="post" asp-page-handler="ConfirmCompleteness" asp-route-id="@item.Identity.Id"><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="LeaseToken" /><label class="checkbox-row"><input asp-for="InstructionsComplete" /> Instructions complete</label><label class="checkbox-row"><input asp-for="ImagesComplete" /> Images complete</label><button class="button button-primary" type="submit">Confirm completeness</button></form><form method="post" asp-page-handler="Hold" asp-route-id="@item.Identity.Id"><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="LeaseToken" /><input asp-for="Reason" placeholder="Reason to hold" required /><button class="button button-secondary" type="submit">Hold</button></form><form method="post" asp-page-handler="Release" asp-route-id="@item.Identity.Id"><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="LeaseToken" /><input asp-for="Reason" placeholder="Reason to release" required /><button class="button button-secondary" type="submit">Release</button></form><form method="post" asp-page-handler="RecordChase" asp-route-id="@item.Identity.Id"><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="LeaseToken" /><input asp-for="Channel" placeholder="Channel" required /><input asp-for="Target" placeholder="Target" required /><input asp-for="ChaseOutcome" placeholder="Outcome" required /><input asp-for="Reason" placeholder="Note" /><button class="button button-secondary" type="submit">Record chase</button></form><form method="post" asp-page-handler="StartReportPreparation" asp-route-id="@item.Identity.Id"><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="LeaseToken" /><button class="button button-secondary" type="submit">Start report preparation</button></form><form method="post" asp-page-handler="RecordReportSent" asp-route-id="@item.Identity.Id"><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="LeaseToken" /><button class="button button-secondary" type="submit">Record report sent</button></form><form method="post" asp-page-handler="Close" asp-route-id="@item.Identity.Id"><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="LeaseToken" /><select asp-for="Outcome"><option value="PostReportComplete">Post-report complete</option><option value="ProviderCancelled">Provider cancelled</option><option value="CollisionEngineersRejected">Collision Engineers rejected</option><option value="CreatedInError">Created in error</option></select><input asp-for="Reason" placeholder="Reason to close" required /><button class="button button-danger" type="submit">Close</button></form><form method="post" asp-page-handler="Reopen" asp-route-id="@item.Identity.Id"><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="LeaseToken" /><input asp-for="Reason" placeholder="Reason to reopen" required /><button class="button button-secondary" type="submit">Reopen</button></form></section>}
    <section class="panel stack-lg"><h2>History</h2>@if(item.History.Count == 0){<p>No actions recorded.</p>}else{<ol class="history-list">@foreach(var entry in item.History){<li><strong>@entry.Action</strong> · @entry.Outcome · @entry.OccurredAtUtc.ToLocalTime().ToString("g") @if(entry.Reason is not null){<span> · @entry.Reason</span>}</li>}</ol>}</section>
</main>
