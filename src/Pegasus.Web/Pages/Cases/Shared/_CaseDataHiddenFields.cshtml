@*
    Every editable case value at what the case currently holds.

    `SaveCase` overwrites all twenty members of `CaseEditableData` — an
    omitted value is written as null and clears the confirmed field — so a
    form that edits one value must still post the other nineteen. Rendering
    that set once keeps the list in a single place instead of one copy per
    edit form.

    A form that edits a value renders its own control for it *before* this
    partial: the model binder reads the first entry for a repeated name, the
    same convention the completeness checkboxes' trailing hidden false
    already relies on (CaseMutationPageModel.RetainProposedValues).
*@
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var data = Model.Case?.Data;
}
<input type="hidden" name="claimantName" value="@data?.Claimant.Name.Confirmed?.Value" />
<input type="hidden" name="claimantContactNumber" value="@data?.Claimant.ContactNumber.Confirmed?.Value" />
<input type="hidden" name="claimantAddress" value="@data?.Claimant.Address.Confirmed?.Value" />
<input type="hidden" name="claimNumber" value="@data?.Claim.Number.Confirmed?.Value" />
<input type="hidden" name="vehicleRegistration" value="@data?.Vehicle.Registration.Confirmed?.Value" />
<input type="hidden" name="vehicleMake" value="@data?.Vehicle.Make.Confirmed?.Value" />
<input type="hidden" name="vehicleModel" value="@data?.Vehicle.Model.Confirmed?.Value" />
<input type="hidden" name="vehicleMileage" value="@data?.Vehicle.Mileage.Confirmed?.Value" />
<input type="hidden" name="vehicleMileageUnit" value="@data?.Vehicle.MileageUnit.Confirmed?.Value" />
<input type="hidden" name="accidentCircumstances" value="@data?.Accident.Circumstances.Confirmed?.Value" />
<input type="hidden" name="incidentDate" value="@data?.Accident.IncidentDate.Confirmed?.Value.ToString("yyyy-MM-dd")" />
<input type="hidden" name="contactName" value="@data?.Contact.Name.Confirmed?.Value" />
<input type="hidden" name="contactEmailAddress" value="@data?.Contact.EmailAddress.Confirmed?.Value" />
<input type="hidden" name="contactPhoneNumber" value="@data?.Contact.PhoneNumber.Confirmed?.Value" />
<input type="hidden" name="instructionDate" value="@data?.Instruction.InstructionDate.Confirmed?.Value.ToString("yyyy-MM-dd")" />
<input type="hidden" name="vatStatus" value="@data?.Instruction.VatStatus.Confirmed?.Value" />
<input type="hidden" name="inspectionDate" value="@data?.Inspection.InspectionDate.Confirmed?.Value.ToString("yyyy-MM-dd")" />
<input type="hidden" name="inspectionDeadline" value="@data?.Inspection.Deadline.Confirmed?.Value.ToString("yyyy-MM-dd")" />
<input type="hidden" name="inspectionAddress" value="@data?.Inspection.Address.Confirmed?.Value" />
<input type="hidden" name="inspectionMode" value="@data?.Inspection.Mode.Confirmed?.Value" />
