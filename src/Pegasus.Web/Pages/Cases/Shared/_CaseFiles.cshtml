@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Cases
@using Pegasus.Web.Pages.Cases
@using Pegasus.Web.Presentation
@using TagLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.ImageTags
@using FilesLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Files
@{
    var custodyState = Model.FilesSection?.CustodyState ?? CaseCustodyState.Pending;
    var custodyFolderRemoteId = Model.FilesSection?.CustodyFolderRemoteId;
    var queryEmails = Model.FilesSection?.QueryEmails ?? [];
    var custodyConfirmed = custodyState == CaseCustodyState.Confirmed
        && !string.IsNullOrWhiteSpace(custodyFolderRemoteId);
    var documentCount = Model.CaseDocumentFiles.Count;
    var imageCount = Model.CaseImageFiles.Count + Model.ImageIntakes.Sum(intake => Model.ImagesByIntake.GetValueOrDefault(intake.Id, []).Count);
    var correspondenceCount = queryEmails.Count;
    var headTools = new CaseSectionHeadView(Model, "files");
}

@* Files (v26 § Files): one panel, three tabs — Documents, Images and
   Correspondence — under one primary (Add evidence) and one More menu. Every
   tab body is rendered, so with no script the section is the three lists one
   after the other, each under its own heading; script turns the strip on. An
   image's tags and crop live on its tile; where it sits in the report is the
   Report section's. *@
<section class="record-section panel @Model.CollapsedClass("case.files") @Model.ActiveTabClass("files") @(Model.IsEditing && !Model.SectionIsEditable("files") ? "is-locked" : null)" id="section-files" data-section="files" data-collapse="case.files" aria-labelledby="section-files-title" data-file-tabs-wrap>
    <div class="panel-head">
        <h2 id="section-files-title">@OperatorLabels.CaseWorkspace.FilesPanel</h2>
        @if (custodyConfirmed)
        {
            <span class="status status--green status--plain" data-custody-chip>@FilesLabels.BoxConfirmed</span>
        }
        else
        {
            <span class="status @(custodyState == CaseCustodyState.Failed ? "status--red" : "status--amber") status--plain" data-custody-chip>@OperatorLabels.CustodyFolderState(custodyState)</span>
        }
        <div class="panel-actions">
            <a class="btn btn--small btn--primary" asp-page="/Upload" data-add-evidence>
                <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                <span>@OperatorLabels.CaseWorkspace.AddEvidence</span>
            </a>
            <details class="menu" data-menu data-files-menu>
                <summary class="btn btn--small"><span>@CaseWorkspaceLabels.Frame.More</span><svg class="icon" aria-hidden="true"><use href="#icon-chevron-down" /></svg></summary>
                <div class="menu-body">
                    @if (custodyConfirmed)
                    {
                        <a class="btn" href="https://app.box.com/folder/@custodyFolderRemoteId" target="_blank" rel="noopener" data-open-in-box>
                            <svg class="icon" aria-hidden="true"><use href="#icon-external-link" /></svg>
                            <span>@FilesLabels.OpenInBox</span>
                        </a>
                    }
                    <a class="btn" asp-page="/Operations/Index">
                        <svg class="icon" aria-hidden="true"><use href="#icon-activity" /></svg>
                        <span>@OperatorLabels.CaseWorkspace.OpenOperations</span>
                    </a>
                </div>
            </details>
            <partial name="Cases/Shared/_CaseSectionHeadTools" model="headTools" />
        </div>
    </div>
    <div class="panel-body stack">
        <div class="tabs" role="tablist" aria-label="@OperatorLabels.CaseWorkspace.FilesPanel" data-file-tabs hidden>
            <button type="button" class="tab" role="tab" aria-selected="true" aria-controls="case-files-documents" data-file-tab="documents">@TagLabels.DocumentsTab · @documentCount</button>
            <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="case-files-images" data-file-tab="images">@TagLabels.ImagesTab · @imageCount</button>
            <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="case-files-correspondence" data-file-tab="correspondence">@FilesLabels.CorrespondenceTab · @correspondenceCount</button>
        </div>
        <div id="case-files-documents" role="tabpanel" data-file-tab-panel="documents">
            <h3 class="tab-panel-title">@TagLabels.DocumentsTab</h3>
            <partial name="Cases/Shared/_CaseDocuments" model="Model" />
        </div>
        <div id="case-files-images" role="tabpanel" data-file-tab-panel="images">
            <h3 class="tab-panel-title">@TagLabels.ImagesTab</h3>
            <partial name="Cases/Shared/_CaseImages" model="Model" />
        </div>
        <div id="case-files-correspondence" role="tabpanel" data-file-tab-panel="correspondence">
            <h3 class="tab-panel-title">@FilesLabels.CorrespondenceTab</h3>
            <partial name="Cases/Shared/_CaseCorrespondence" model="Model" />
        </div>

</div>
</section>
