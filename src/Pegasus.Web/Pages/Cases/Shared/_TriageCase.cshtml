@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Cases
@using Pegasus.Core.Documents
@using Pegasus.Core.Triage
@using Pegasus.Web.Pages.Cases
@using Pegasus.Web.Presentation
@using Labels = Pegasus.Web.Presentation.OperatorLabels.Triage
@using TagLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.ImageTags
@using FilesLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Files
@{
    // The Triage Case's record on /Cases/{id} (v31 C, Contact sheet). There
    // is no Edit step: each control posts once and the save claims and
    // releases the Triage edit scope itself (TriageWriteAuthority).
    var view = Model.TriageCase!;
    var record = view.Record;
    var reference = record.Reference;

    var mutable = record.State is not (TriageState.Completed or TriageState.Cancelled);
    var activeFindings = view.ActiveFindings;
    var currentFinding = view.CurrentFinding;
    // Record finding records a new finding when there is none and supersedes
    // the single active one otherwise, so a change never overwrites history.
    // On a Completed record Record correction opens the same fields. Cancelled
    // triage must be reopened first (Core). Multiple active findings need
    // reconciliation first.
    var correction = record.State == TriageState.Completed && currentFinding is not null;
    var offersFinding = mutable && (currentFinding is not null || activeFindings.Count == 0);
    var canLinkCase = mutable && view.CaseAssociationUnavailableReason is null;
    var canAssign = mutable && view.EngineerChoices.Count > 0;
    var offersOpenFile = !view.SourceIsEmail && view.OpenFileHref is not null;
    var hiddenBase = new Dictionary<string, string?>
    {
        ["expectedVersion"] = record.Version.ToString(System.Globalization.CultureInfo.InvariantCulture),
        ["operationKey"] = view.OperationKey
    };
    var actionUrl = Url.Page("/Cases/Details", "TriageAction", new { id = record.CaseId });
    var replyLabel = view.IsOutcomeReply ? Labels.ReplyWithFinding : Labels.SendChaser;

    // The state's next step stands beside the Actions menu; every other
    // action the state allows is in the menu.
    var lead = record.State switch
    {
        TriageState.Open or TriageState.AwaitingInformation when offersFinding => "finding",
        TriageState.FindingRecorded => "complete",
        TriageState.Completed when view.OffersReply => "compose",
        TriageState.Cancelled => "reopen",
        _ => null
    };
    var menu = new List<string>();
    if (canAssign) { menu.Add("assign"); }
    if (offersFinding) { menu.Add("finding"); }
    if (correction) { menu.Add("correction"); }
    if (record.State == TriageState.FindingRecorded) { menu.Add("complete"); }
    if (view.OffersComposer) { menu.Add("compose"); }
    if (offersOpenFile) { menu.Add("open-file"); }
    if (canLinkCase) { menu.Add(record.LinkedInstructionCaseId is null ? "link" : "unlink"); }
    menu.Remove(lead ?? string.Empty);
    var end = mutable ? "cancel" : "reopen";
    var endInMenu = end != lead;

    var custodyState = view.Triage.CustodyState;
    var custodyFolderRemoteId = view.Triage.CustodyFolderRemoteId;
    var custodyConfirmed = custodyState == CaseCustodyState.Confirmed
        && !string.IsNullOrWhiteSpace(custodyFolderRemoteId);
    var files = view.Files;
    var correspondence = view.Triage.Correspondence;
    var showsResponse = view.Triage.ResponseEvidence.Count > 0 || (mutable && view.Triage.ResponseEvidenceCandidates.Count > 0);
    var history = view.Triage.History.OrderByDescending(entry => entry.OccurredAtUtc).ToArray();
    var hasImages = view.EvidenceImages.Count > 0 && record.Origin is not null;
}
@functions {
    // One Actions control, drawn the same in the menu and as the lead.
    private static string ControlClass(bool primary, bool danger = false) =>
        primary ? "btn btn--primary" : danger ? "btn btn--danger" : "btn";
}
@{
    async Task ActionControl(string key, bool primary)
    {
        switch (key)
        {
            case "assign":
                <button type="button" class="@ControlClass(primary)" data-dialog-open="triage-assign-dialog" data-triage-action="assign">
                    <svg class="icon" aria-hidden="true"><use href="#icon-user" /></svg>
                    <span>@(record.AssigneeId is null ? Labels.Assign : Labels.Reassign)</span>
                </button>
                break;
            case "finding":
                <button type="button" class="@ControlClass(primary)" data-dialog-open="triage-finding-dialog" data-triage-action="record-finding">
                    <svg class="icon" aria-hidden="true"><use href="#icon-clipboard-list" /></svg>
                    <span>@Labels.RecordFinding</span>
                </button>
                break;
            case "correction":
                <button type="button" class="@ControlClass(primary)" data-dialog-open="triage-correction-dialog" data-triage-correction>
                    <svg class="icon" aria-hidden="true"><use href="#icon-save" /></svg>
                    <span>@Labels.RecordCorrection</span>
                </button>
                break;
            case "complete":
                <form method="post" asp-page-handler="TriageAction" asp-route-id="@record.CaseId">
                    <input type="hidden" name="expectedVersion" value="@record.Version" />
                    <input type="hidden" name="operationKey" value="@view.OperationKey" />
                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Completing" name="actionName" value="complete" class="@ControlClass(primary)" data-triage-complete>
                        <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                        <span>@Labels.CompleteTriage</span>
                    </button>
                </form>
                break;
            case "compose":
                <button type="button" class="@ControlClass(primary)" data-dialog-open="triage-compose-dialog" data-triage-action="compose">
                    <svg class="icon" aria-hidden="true"><use href="#@(view.IsOutcomeReply ? "icon-reply" : "icon-send")" /></svg>
                    <span>@replyLabel</span>
                </button>
                break;
            case "open-file":
                <a class="@ControlClass(primary)" href="@view.OpenFileHref" target="_blank" rel="noopener" data-triage-action="open-file">
                    <svg class="icon" aria-hidden="true"><use href="#icon-eye" /></svg>
                    <span>@Labels.OpenFile</span>
                </a>
                break;
            case "link":
                <button type="button" class="@ControlClass(primary)" data-dialog-open="triage-link-case-dialog" data-triage-action="link-case">
                    <svg class="icon" aria-hidden="true"><use href="#icon-link" /></svg>
                    <span>Link case</span>
                </button>
                break;
            case "unlink":
                <button type="button" class="@ControlClass(primary)" data-dialog-open="triage-unlink-case-dialog" data-triage-action="unlink-case">
                    <svg class="icon" aria-hidden="true"><use href="#icon-unlink" /></svg>
                    <span>Unlink case</span>
                </button>
                break;
            case "cancel":
                <button type="button" class="@ControlClass(primary, danger: true)" data-dialog-open="triage-cancel-dialog" data-triage-action="cancel">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                    <span>@Labels.CancelTriage</span>
                </button>
                break;
            case "reopen":
                <button type="button" class="@ControlClass(primary)" data-dialog-open="triage-reopen-dialog" data-triage-action="reopen">
                    <svg class="icon" aria-hidden="true"><use href="#icon-undo" /></svg>
                    <span>@Labels.Reopen</span>
                </button>
                break;
        }
    }
}

<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">Triage</p>
        <h1>@reference</h1>
    </div>
    <div class="page-actions">
        <a class="btn" asp-page="/Cases/Index" asp-route-tab="triage">
            <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
            <span>Back to Cases</span>
        </a>
        <partial name="Shared/_RefreshButton" />
    </div>
</header>

@if (!view.ReasonsInComposer)
{
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
}

@if (!string.IsNullOrWhiteSpace(view.Message))
{
    <div class="notice notice--info mb-2" role="status" aria-live="polite">
        <svg class="icon" aria-hidden="true"><use href="#icon-info" /></svg>
        <span>@view.Message</span>
        @if (view.NoticeOffersReply)
        {
            <button type="button" class="link-button" data-dialog-open="triage-compose-dialog" data-triage-reply-link>@Labels.ReplyWithFinding</button>
        }
        <button type="button" class="dismiss" data-dismiss aria-label="Dismiss"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
    </div>
}
@if (view.CaseAssociationUnavailableReason is { } unavailableReason && unavailableReason != view.Message)
{
    <div class="notice notice--warning mb-2" role="status">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>@unavailableReason</span>
    </div>
}
@if (mutable && !offersFinding)
{
    <div class="notice notice--warning mb-2" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
        <span>Multiple active findings require reconciliation before another finding can be recorded.</span>
    </div>
}
@* The one-time notice a write elsewhere leaves for this record (Upload's
   Add evidence), drawn as the Case record draws it. *@
<div data-case-notices>
@if (TempData["CaseStatus"] is string caseStatus)
{
    <div class="notice notice--success mb-2" role="status" data-confirmation>
        <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
        <span>@caseStatus</span>
        <button type="button" class="dismiss" data-dismiss aria-label="Dismiss"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
    </div>
}
</div>

<article class="record triage-record" data-triage-record data-triage-state="@record.State">
    @* The page's tabs: Images, Files and Notes. Every panel is rendered, so
       with no script the record is the three one after the other, each under
       its own heading; site.js turns the strip on. *@
    <div data-file-tabs-wrap data-file-tabs-hash="triage-">
        <div class="triage-sticky">
            <div class="ribbon triage-ribbon" aria-label="Triage identity">
                <div class="ribbon-facts">
                    <div class="ribbon-item ribbon-ref"><span class="ribbon-label">@OperatorLabels.TriageReference</span><span class="ribbon-value mono">@reference</span></div>
                    <div class="ribbon-item"><span class="ribbon-label">Registration</span><span class="ribbon-value mono">@record.NormalizedVehicleRegistration</span></div>
                    <div class="ribbon-item"><span class="ribbon-label">@OperatorLabels.Principal</span><span class="ribbon-value">@(view.Triage.PrincipalCode ?? OperatorLabels.PrincipalNotKnown)</span></div>
                    <div class="ribbon-item"><span class="ribbon-label">Source</span><span class="ribbon-value">@view.SourceLabel</span></div>
                    <div class="ribbon-item"><span class="ribbon-label">Opened</span><span class="ribbon-value">@OperatorLabels.OfficeTime(view.Triage.CreatedAtUtc)</span></div>
                    <div class="ribbon-item"><span class="ribbon-label">@Labels.Assignee</span><span class="ribbon-value" data-triage-assignee>@(view.AssigneeName ?? Labels.NoAssignee)</span></div>
                    <div class="ribbon-item">
                        <span class="ribbon-label">@Labels.Case</span>
                        <span class="ribbon-value">
                            @if (record.LinkedInstructionCaseId is { } linkedCaseId)
                            {
                                <a asp-page="/Cases/Details" asp-route-id="@linkedCaseId" data-triage-linked-case>@(view.LinkedCaseReference ?? Labels.OpenCase)</a>
                            }
                            else
                            {
                                <span>@Labels.NoCase</span>
                            }
                        </span>
                    </div>
                </div>
                <div class="ribbon-chips"><partial name="Shared/_StatusChip" model="@TriageCaseView.StateLabel(record.State)" /></div>
                <div class="ribbon-actions">
                    @if (lead is not null)
                    {
                        await ActionControl(lead, primary: true);
                    }
                    @if (menu.Count > 0 || endInMenu)
                    {
                        <details class="menu" data-menu data-triage-actions>
                            <summary class="btn"><span>@CaseWorkspaceLabels.Frame.Actions</span><svg class="icon" aria-hidden="true"><use href="#icon-chevron-down" /></svg></summary>
                            <div class="menu-body">
                                @foreach (var key in menu)
                                {
                                    await ActionControl(key, primary: false);
                                }
                                @if (endInMenu)
                                {
                                    if (menu.Count > 0)
                                    {
                                        <div class="menu-sep"></div>
                                    }
                                    await ActionControl(end, primary: false);
                                }
                            </div>
                        </details>
                    }
                </div>
            </div>
            <div class="triage-tabrow">
                <div class="tabs" role="tablist" aria-label="@reference" data-file-tabs hidden>
                    @if (hasImages)
                    {
                        <button type="button" class="tab" role="tab" aria-selected="true" aria-controls="triage-images" data-file-tab="images">@TagLabels.ImagesTab · @view.EvidenceImages.Count</button>
                    }
                    <button type="button" class="tab" role="tab" aria-selected="@(hasImages ? "false" : "true")" aria-controls="triage-files" data-file-tab="files">@OperatorLabels.CaseWorkspace.FilesPanel · @(files.Count + correspondence.Count)</button>
                    <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="triage-notes" data-file-tab="notes">@Labels.Notes · @history.Length</button>
                </div>
                @* The finding, read-only; Record finding and Record correction change it. *@
                <dl class="triage-finding" aria-label="@Labels.Finding" data-triage-finding>
                    <div><dt>Roadworthiness</dt><dd class="@(currentFinding?.Roadworthiness is null ? "is-empty" : null)">@(currentFinding?.Roadworthiness is { } roadworthiness ? TriageCaseView.RoadworthinessLabel(roadworthiness) : "Not recorded")</dd></div>
                    <div><dt>Repair outcome</dt><dd class="@(currentFinding?.Assessment is null ? "is-empty" : null)">@(currentFinding?.Assessment is { } assessment ? TriageCaseView.AssessmentLabel(assessment) : "Not recorded")</dd></div>
                </dl>
            </div>
        </div>

        <div class="record-body">
            @if (hasImages)
            {
                var origin = record.Origin!;
                <section id="triage-images" role="tabpanel" data-file-tab-panel="images" aria-labelledby="triage-images-title" class="triage-images">
                    <h2 class="tab-panel-title" id="triage-images-title">@Labels.VehicleImages</h2>
                    @{
                        // The request's photographs at contact-sheet size. A
                        // retained receipt asset is already served inline, so
                        // preview and download are the same authorised URL; the
                        // tile is the asset route's tile rendering. Triage takes
                        // no crop or tag.
                        var triageGallery = view.EvidenceImages
                            .Select(asset =>
                            {
                                var href = Url.Page(
                                    "/Intake/Asset",
                                    new { id = origin.ReceiptId, assetId = asset.Id, v = asset.ContentHash })!;
                                var tile = CaseDocumentThumbnails.IsThumbnailable(asset.MediaType)
                                    ? IntakeImageAddress.Tile(
                                        origin.ReceiptId,
                                        asset.Id,
                                        asset.ContentHash,
                                        Pegasus.Core.ImageIntake.PreCaseImagePreparation.NoPreparationVersion)
                                    : null;
                                return new GalleryImage(href, href, asset.FileName, asset.MediaType, ThumbnailHref: tile);
                            })
                            .ToArray();
                    }
                    <partial name="Shared/_ImageGallery" model="triageGallery" />
                </section>
            }

            <section id="triage-files" role="tabpanel" data-file-tab-panel="files" aria-labelledby="section-files-title">
                <div class="panel" id="section-files">
                    <div class="panel-head">
                        <h2 id="section-files-title">@OperatorLabels.CaseWorkspace.FilesPanel</h2>
                        @if (custodyConfirmed)
                        {
                            <span class="status status--green status--plain" data-custody-chip>@FilesLabels.BoxConfirmed</span>
                        }
                        else
                        {
                            <span class="status @(custodyState == CaseCustodyState.Failed ? "status--red" : "status--amber") status--plain" data-custody-chip>@OperatorLabels.CustodyFolderState(custodyState)</span>
                        }
                        <div class="panel-actions">
                            <a class="btn btn--small btn--primary" asp-page="/Upload" asp-route-caseId="@record.CaseId" data-add-evidence>
                                <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                                <span>@OperatorLabels.CaseWorkspace.AddEvidence</span>
                            </a>
                            @if (custodyConfirmed)
                            {
                                <details class="menu" data-menu data-files-menu>
                                    <summary class="btn btn--small"><span>@CaseWorkspaceLabels.Frame.More</span><svg class="icon" aria-hidden="true"><use href="#icon-chevron-down" /></svg></summary>
                                    <div class="menu-body">
                                        <a class="btn" href="https://app.box.com/folder/@custodyFolderRemoteId" target="_blank" rel="noopener" data-open-in-box>
                                            <svg class="icon" aria-hidden="true"><use href="#icon-external-link" /></svg>
                                            <span>@FilesLabels.OpenInBox</span>
                                        </a>
                                    </div>
                                </details>
                            }
                        </div>
                    </div>
                    <div class="panel-body stack" data-file-tabs-wrap data-file-tabs-hash="triage-files-">
                        <div class="tabs" role="tablist" aria-label="@OperatorLabels.CaseWorkspace.FilesPanel" data-file-tabs hidden>
                            <button type="button" class="tab" role="tab" aria-selected="true" aria-controls="triage-files-documents" data-file-tab="documents">@TagLabels.DocumentsTab · @files.Count</button>
                            <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="triage-files-correspondence" data-file-tab="correspondence">@FilesLabels.CorrespondenceTab · @correspondence.Count</button>
                        </div>
                        <div id="triage-files-documents" role="tabpanel" data-file-tab-panel="documents">
                            <h3 class="tab-panel-title">@TagLabels.DocumentsTab</h3>
                            @if (files.Count == 0)
                            {
                                <p class="muted" data-documents-empty>@FilesLabels.NoDocuments</p>
                            }
                            else
                            {
                                <div class="doc-list stack" data-document-list>
                                    @foreach (var entry in files)
                                    {
                                        var occurrence = entry.Occurrence;
                                        var version = entry.Version;
                                        var mayRead = version.CustodyStatus == DocumentCustodyStatus.Confirmed;
                                        var isMail = occurrence.SemanticRole == DocumentSemanticRole.Correspondence
                                            || occurrence.Source == DocumentSource.ExternalCorrespondence;
                                        <div class="doc-row" data-document-row="@occurrence.Id">
                                            <svg class="icon" aria-hidden="true"><use href="#@(isMail ? "icon-mail" : "icon-file-text")" /></svg>
                                            <div class="doc-row-name">
                                                <b>@version.FileName</b>
                                                <small>@OperatorLabels.DocumentOrigin(occurrence.Source) · @OperatorLabels.OfficeTime(occurrence.RecordedAtUtc) · @OperatorLabels.FileSize(version.ContentLength)</small>
                                            </div>
                                            <span class="doc-row-tags">
                                                <span class="src-tag">@OperatorLabels.DocumentRole(occurrence.SemanticRole)</span>
                                                @if (!mayRead)
                                                {
                                                    <span class="status @(version.CustodyStatus == DocumentCustodyStatus.Failed ? "status--red" : "status--amber") status--plain">@(version.CustodyStatus == DocumentCustodyStatus.Failed ? FilesLabels.StorageNotReady : OperatorLabels.CustodyState(version.CustodyStatus))</span>
                                                }
                                            </span>
                                            <span class="doc-row-actions">
                                                @if (mayRead)
                                                {
                                                    <a class="btn btn--small btn--icon" href="@view.DownloadUrl(entry)" download title="@OperatorLabels.CaseWorkspace.SaveAs" aria-label="@OperatorLabels.CaseWorkspace.SaveAs @version.FileName">
                                                        <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                                                    </a>
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div id="triage-files-correspondence" role="tabpanel" data-file-tab-panel="correspondence" data-triage-correspondence="@(view.ReplyPurpose?.ToString() ?? string.Empty)">
                            <h3 class="tab-panel-title">@FilesLabels.CorrespondenceTab</h3>
                            @if (view.CanSendReply && view.ReplyOperation is { } replyOperation)
                            {
                                <div class="notice mb-2" role="status" data-triage-send-status>
                                    <svg class="icon" aria-hidden="true"><use href="#icon-mail" /></svg>
                                    <span>@Labels.LatestSendStatus(replyOperation.State)</span>
                                </div>
                            }
                            @if (view.CanSendReply && view.ReplyPurpose is not null && view.ReplyOperationBlocked)
                            {
                                <div class="notice notice--warning mb-2" role="alert">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                                    <span>The existing correspondence operation must finish or be resolved before another action.</span>
                                </div>
                            }
                            @if (view.OffersComposer)
                            {
                                <div class="button-row">
                                    <button type="button" class="btn btn--small" data-dialog-open="triage-compose-dialog">
                                        <svg class="icon" aria-hidden="true"><use href="#@(view.IsOutcomeReply ? "icon-reply" : "icon-send")" /></svg>
                                        <span>@replyLabel</span>
                                    </button>
                                </div>
                            }
                            <partial name="Cases/Shared/_CaseCorrespondence" model="@(new CaseCorrespondenceView(correspondence, reference, OffersCompose: false))" />

                            @* Exact response evidence keeps its handlers; it renders
                               only when there is something linked or something to
                               link — both can be true at once. *@
                            @if (showsResponse)
                            {
                                <div class="triage-response" aria-labelledby="triage-response-title">
                                    <h3 id="triage-response-title">Exact response evidence</h3>
                                    <div class="stack">
                                        @if (view.Triage.ResponseEvidence.Count > 0)
                                        {
                                            <div class="timeline">
                                                @foreach (var evidence in view.Triage.ResponseEvidence)
                                                {
                                                    <div class="timeline-item">
                                                        <div class="timeline-title">@OperatorLabels.OfficeTime(evidence.LinkedAtUtc)</div>
                                                        <div class="timeline-text">@evidence.Reason</div>
                                                    </div>
                                                }
                                            </div>
                                            @if (mutable)
                                            {
                                                var linkedResponse = view.Triage.ResponseEvidence[0];
                                                <form method="post" asp-page-handler="TriageAction" asp-route-id="@record.CaseId" class="stack">
                                                    <input type="hidden" name="expectedVersion" value="@record.Version" />
                                                    <input type="hidden" name="operationKey" value="@view.OperationKey" />
                                                    <input type="hidden" name="sentEvidenceId" value="@linkedResponse.SentEvidenceId" />
                                                    <div class="field">
                                                        <label class="req" for="triage-unlink-response-reason">Reason</label>
                                                        <textarea id="triage-unlink-response-reason" name="reason" rows="3" required maxlength="500"></textarea>
                                                    </div>
                                                    <div class="button-row">
                                                        <button type="submit" data-busy-label="@OperatorLabels.Busy.Unlinking" name="actionName" value="unlink_response" class="btn">
                                                            <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                                                            <span>Unlink response</span>
                                                        </button>
                                                    </div>
                                                </form>
                                            }
                                        }
                                        @if (mutable && view.Triage.ResponseEvidenceCandidates.Count > 0)
                                        {
                                            <form method="post" asp-page-handler="TriageAction" asp-route-id="@record.CaseId" class="stack">
                                                <input type="hidden" name="expectedVersion" value="@record.Version" />
                                                <input type="hidden" name="operationKey" value="@view.OperationKey" />
                                                <div class="field">
                                                    <label class="req" for="triage-response-candidate">Approved-mailbox reply</label>
                                                    <select id="triage-response-candidate" name="responseCandidate" required>
                                                        <option value="">Select exact response evidence</option>
                                                        @foreach (var candidate in view.Triage.ResponseEvidenceCandidates)
                                                        {
                                                            <option value="@candidate.PollOutcomeId|@candidate.SentEvidenceId">
                                                                @OperatorLabels.OfficeTime(candidate.SentAtUtc) —
                                                                @candidate.MailboxAddress —
                                                                message @candidate.InternetMessageIdentity —
                                                                Sent evidence @candidate.SentEvidenceId
                                                            </option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="field">
                                                    <label class="req" for="triage-response-reason">Reason</label>
                                                    <textarea id="triage-response-reason" name="reason" rows="3" required maxlength="500"></textarea>
                                                </div>
                                                <div class="button-row">
                                                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Linking" name="actionName" value="link_response" class="btn btn--dark">
                                                        <svg class="icon" aria-hidden="true"><use href="#icon-link" /></svg>
                                                        <span>Record and link exact response</span>
                                                    </button>
                                                </div>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>

            @* Notes: the one permanent, attributed, versioned history. An
               operator note is an entry in that stream, not a second, editable
               record beside it. *@
            <section id="triage-notes" role="tabpanel" data-file-tab-panel="notes" aria-labelledby="triage-history-title">
                <div class="panel">
                    <div class="panel-head"><h2 id="triage-history-title">@Labels.Notes</h2></div>
                    <div class="panel-body">
                        @if (mutable)
                        {
                            <form method="post" asp-page-handler="TriageAction" asp-route-id="@record.CaseId" class="stack">
                                <input type="hidden" name="actionName" value="note" />
                                <input type="hidden" name="expectedVersion" value="@record.Version" />
                                <input type="hidden" name="operationKey" value="@view.OperationKey" />
                                <div class="field">
                                    <label class="req" for="triage-note">Note</label>
                                    @* The bound is Core's, so the form cannot offer
                                       more than the history entry accepts. *@
                                    <textarea id="triage-note" name="note" rows="3" required maxlength="@TriageNotes.MaximumLength"></textarea>
                                </div>
                                <div class="button-row">
                                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Adding" class="btn btn--dark">
                                        <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                                        <span>Add note</span>
                                    </button>
                                </div>
                            </form>
                        }
                        <div class="notes-list">
                            @foreach (var entry in history)
                            {
                                <div class="note-entry">
                                    <div class="note-meta">
                                        <span>Date @OperatorLabels.OfficeDate(entry.OccurredAtUtc)</span>
                                        <span>Time @OperatorLabels.OfficeClock(entry.OccurredAtUtc)</span>
                                        <span>ID @entry.ActorDisplayName</span>
                                    </div>
                                    <div>@TriageCaseView.EventLabel(entry.EventType): @entry.Reason</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</article>

<partial name="Shared/_EvidenceViewer" />

@if (canAssign)
{
    @* One Assign control: the eligible roster with the signed-in account
       first, nothing preselected, and no reason anywhere. Unassign posts
       from the same dialog. *@
    <div class="dialog-backdrop" data-dialog="triage-assign-dialog" hidden>
        <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="triage-assign-dialog-title">
            <div class="dialog-head">
                <h2 id="triage-assign-dialog-title" tabindex="-1">@Labels.Assign</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </div>
            <form method="post" asp-page-handler="TriageAction" asp-route-id="@record.CaseId">
                <input type="hidden" name="expectedVersion" value="@record.Version" />
                <input type="hidden" name="operationKey" value="@view.OperationKey" />
                <div class="dialog-body">
                    <div class="field">
                        <label class="req" for="triage-assignee">@Labels.Assignee</label>
                        <select id="triage-assignee" name="assigneeId" required data-dialog-initial-focus>
                            <option value=""></option>
                            @foreach (var choice in view.EngineerChoices)
                            {
                                <option value="@choice.StaffId">@view.AssigneeChoiceLabel(choice)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="dialog-foot">
                    @if (record.AssigneeId is not null)
                    {
                        <button type="submit" data-busy-label="@OperatorLabels.Busy.Removing" name="actionName" value="unassign" class="btn" formnovalidate data-triage-unassign>@Labels.Unassign</button>
                    }
                    <button type="button" class="btn" data-dialog-close>@Labels.Cancel</button>
                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Assigning" name="actionName" value="assign" class="btn btn--primary">@Labels.Assign</button>
                </div>
            </form>
        </section>
    </div>
}

@if (offersFinding)
{
    @* Record finding: the two findings and the reason, with Complete Triage
       to complete on the same save and Reply with finding to open the reply
       composer once it completes (operator, 5 October 2026). Reply with
       finding is offered only where a reply can be sent. *@
    <div class="dialog-backdrop" data-dialog="triage-finding-dialog" hidden>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="triage-finding-dialog-title">
            <div class="dialog-head">
                <h2 id="triage-finding-dialog-title" tabindex="-1">@Labels.RecordFinding</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </div>
            <form method="post" asp-page-handler="TriageAction" asp-route-id="@record.CaseId" data-triage-determinations>
                <input type="hidden" name="expectedVersion" value="@record.Version" />
                <input type="hidden" name="operationKey" value="@view.OperationKey" />
                @if (currentFinding is not null)
                {
                    <input type="hidden" name="supersedesFindingId" value="@currentFinding.Id" />
                }
                <div class="dialog-body stack">
                    <partial name="Cases/Shared/_TriageDeterminationFields" model="view" />
                    <div>
                        <label class="check"><input type="checkbox" name="completeTriage" value="true" data-triage-tick-complete /> @Labels.CompleteTriage</label>
                        @if (view.CanSendReply && !view.ReplyOperationBlocked)
                        {
                            <label class="check"><input type="checkbox" name="replyWithFinding" value="true" data-triage-tick-reply /> @Labels.ReplyWithFinding</label>
                        }
                    </div>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>@Labels.Cancel</button>
                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Saving" name="actionName"
                            value="@(currentFinding is null ? "record_finding" : "supersede_finding")" class="btn btn--primary">
                        <svg class="icon" aria-hidden="true"><use href="#icon-save" /></svg>
                        <span>@Labels.RecordFinding</span>
                    </button>
                </div>
            </form>
        </section>
    </div>
}

@if (correction)
{
    @* Record correction on a Completed Triage: the Record finding fields. The
       correction supersedes the current finding; history keeps both. *@
    <div class="dialog-backdrop" data-dialog="triage-correction-dialog" hidden>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="triage-correction-dialog-title">
            <div class="dialog-head">
                <h2 id="triage-correction-dialog-title" tabindex="-1">@Labels.RecordCorrection</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </div>
            <form method="post" asp-page-handler="TriageAction" asp-route-id="@record.CaseId" data-triage-determinations>
                <input type="hidden" name="expectedVersion" value="@record.Version" />
                <input type="hidden" name="operationKey" value="@view.OperationKey" />
                <input type="hidden" name="supersedesFindingId" value="@currentFinding!.Id" />
                <div class="dialog-body stack">
                    <partial name="Cases/Shared/_TriageDeterminationFields" model="view" />
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>@Labels.Cancel</button>
                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Recording" name="actionName" value="supersede_finding" class="btn btn--primary">@Labels.RecordCorrection</button>
                </div>
            </form>
        </section>
    </div>
}

@if (view.OffersComposer)
{
    @* The composer (FRD-03, FRD-21): the Inbox composer's frame over the
       record, sending the chaser until the finding is recorded and Reply with
       finding once Completed, as a reply to the request e-mail. A refused
       send opens it again on what was posted, with the reasons. *@
    <div class="dialog-backdrop" data-dialog="triage-compose-dialog" data-dialog-open-on-load="@(view.ComposerOpensOnLoad ? "true" : null)" hidden>
        <section class="dialog mail-compose-dialog" role="dialog" aria-modal="true" aria-labelledby="triage-compose-title">
            <header class="dialog-head">
                <div>
                    <p class="eyebrow">Triage · @reference</p>
                    <h2 id="triage-compose-title" tabindex="-1">@replyLabel</h2>
                </div>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </header>
            <div class="dialog-body mail-compose-body">
                @if (view.ReasonsInComposer)
                {
                    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
                }
                <form method="post" asp-page-handler="TriageSendReply" asp-route-id="@record.CaseId" class="mail-compose-form" data-triage-reply-form>
                    <input type="hidden" name="expectedVersion" value="@record.Version" />
                    <input type="hidden" name="operationKey" value="@view.ReplyOperationKey" />
                    <div class="mail-compose-form-fields">
                        <div class="mail-compose-addresses">
                            <div class="field mail-compose-from">
                                <label for="triage-reply-from">From</label>
                                <input id="triage-reply-from" value="@view.ReplyMailbox?.Address" readonly />
                            </div>
                            <div class="field mail-compose-to">
                                <label class="req" for="triage-reply-to">To</label>
                                <input id="triage-reply-to" name="to" value="@view.ReplyTo" required maxlength="500" data-dialog-initial-focus />
                            </div>
                            <div class="field mail-compose-cc">
                                <label for="triage-reply-cc">Cc</label>
                                <input id="triage-reply-cc" name="cc" value="@view.ReplyCc" maxlength="500" />
                            </div>
                        </div>
                        <div class="field mail-compose-subject">
                            <label class="req" for="triage-reply-subject">Subject</label>
                            <input id="triage-reply-subject" name="subject" value="@view.ReplySubject" required maxlength="500" />
                        </div>
                        <div class="field mail-compose-message">
                            <label class="req" for="triage-reply-body">Message</label>
                            <textarea id="triage-reply-body" name="body" rows="8" required maxlength="5000">@view.ReplyBody</textarea>
                        </div>
                        @if (view.AvailableAttachments.Count > 0)
                        {
                            <fieldset class="field mail-compose-attachments">
                                <legend>Attachments</legend>
                                @foreach (var attachment in view.AvailableAttachments)
                                {
                                    <label>
                                        <input type="checkbox" name="selectedAttachments" value="@attachment.Selection"
                                               checked="@view.SelectedAttachments.Contains(attachment.Selection)" />
                                        @attachment.FileName
                                    </label>
                                }
                            </fieldset>
                        }
                    </div>
                    <footer class="mail-compose-footer">
                        <button type="submit" data-busy-label="@OperatorLabels.Busy.Sending" class="btn btn--primary">
                            <svg class="icon" aria-hidden="true"><use href="#icon-send" /></svg>
                            <span>@(view.IsOutcomeReply ? Labels.SendReply : Labels.SendChaser)</span>
                        </button>
                    </footer>
                </form>
            </div>
        </section>
    </div>
}

@if (mutable)
{
    <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
    {
        ["DialogId"] = "triage-cancel-dialog",
        ["DialogTitle"] = Labels.CancelTriage,
        ["DialogConsequence"] = "Cancelled Triage can be reopened with a reason.",
        ["DialogActionUrl"] = actionUrl,
        ["DialogHiddenFields"] = new Dictionary<string, string?>(hiddenBase) { ["actionName"] = "cancel" }
    })" />

    @if (canLinkCase && record.LinkedInstructionCaseId is null)
    {
        <div class="dialog-backdrop" data-dialog="triage-link-case-dialog" hidden>
            <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="triage-link-case-dialog-title">
                <div class="dialog-head">
                    <h2 id="triage-link-case-dialog-title" tabindex="-1">Link case</h2>
                    <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                        <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                    </button>
                </div>
                <form method="post" asp-page-handler="TriageAction" asp-route-id="@record.CaseId">
                    <input type="hidden" name="expectedVersion" value="@record.Version" />
                    <input type="hidden" name="operationKey" value="@view.OperationKey" />
                    <input type="hidden" name="actionName" value="link_case" />
                    <div class="dialog-body stack">
                        <div class="field">
                            <label class="req" for="triage-link-case-id">Case ID</label>
                            <input id="triage-link-case-id" name="caseId" required maxlength="100" data-dialog-initial-focus />
                        </div>
                        <div class="field">
                            <label class="req" for="triage-link-case-reason">Reason for action</label>
                            <textarea id="triage-link-case-reason" name="reason" rows="3" required maxlength="500"></textarea>
                        </div>
                    </div>
                    <div class="dialog-foot">
                        <button type="button" class="btn" data-dialog-close>Cancel</button>
                        <button type="submit" data-busy-label="@OperatorLabels.Busy.Linking" class="btn btn--primary">Link case</button>
                    </div>
                </form>
            </section>
        </div>
    }
    else if (canLinkCase && record.LinkedInstructionCaseId is { } linkedCaseForUnlink)
    {
        <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["DialogId"] = "triage-unlink-case-dialog",
            ["DialogTitle"] = "Unlink case",
            ["DialogActionUrl"] = actionUrl,
            ["DialogHiddenFields"] = new Dictionary<string, string?>(hiddenBase)
            {
                ["actionName"] = "unlink_case",
                ["caseId"] = linkedCaseForUnlink.ToString()
            }
        })" />
    }
}
else
{
    <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
    {
        ["DialogId"] = "triage-reopen-dialog",
        ["DialogTitle"] = Labels.Reopen,
        ["DialogActionUrl"] = actionUrl,
        ["DialogHiddenFields"] = new Dictionary<string, string?>(hiddenBase) { ["actionName"] = "reopen" }
    })" />
}
