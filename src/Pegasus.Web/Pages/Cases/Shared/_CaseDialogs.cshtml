@*
    Every dialog the Case record's frame opens (v26 § Dialogs). Each is a
    div-backdrop dialog carrying its own posted form, so every action works as
    a plain POST without script; site.js opens, contains and closes them from
    the [data-dialog-open] controls in the ribbon's Actions menu, the Overview
    Lifecycle actions and the section heads. The section-owned dialogs (Add
    valuation, Import, Compare, Send to AI, Remove file, Withdraw link, Upload
    request) live beside their sections.
*@
@using System.Globalization
@using Pegasus.Core.Lifecycle
@using Pegasus.Core.Reports
@using Pegasus.Core.Workflow
@using Pegasus.Web.Presentation
@using Frame = Pegasus.Web.Presentation.CaseWorkspaceLabels.Frame
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var state = workflow.State;
    var isClosed = CaseLifecycleRules.IsTerminal(state);
    var isHeld = state == CaseLifecycleState.Held;
    // The same offers as the ribbon's Actions menu (operator, 29 September
    // 2026): in and out of an edit session, and never while a colleague holds
    // the lease. Outside a session the forms carry no lease token at all, so
    // a page in read mode holds no edit authority, and each handler claims one
    // for the action.
    var leased = !string.IsNullOrWhiteSpace(Model.LeaseToken);
    var mayAct = !Model.ColleagueIsEditing;
    var mayActOnCaseData = mayAct;
    var canAssignEngineer = Model.CanAssignEngineer;
    var canConfirmReportSent = mayAct
        && details.AvailableReportSentEvidence.Count > 0
        && (Model.IsInspectionView || state == CaseLifecycleState.ReportPreparation);
    var closureOutcomes = Model.AvailableClosureOutcomes;
    var offersAdverseClosure = mayAct && closureOutcomes.Count > 0;
    var today = Pegasus.Core.LondonCalendar.DateAt(DateTimeOffset.UtcNow);

    Dictionary<string, string?> LeaseFields()
    {
        var fields = new Dictionary<string, string?>
        {
            ["id"] = workflow.CaseId.ToString(),
            ["expectedVersion"] = workflow.Version.ToString(CultureInfo.InvariantCulture),
            ["operationKey"] = Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()
        };
        if (leased)
        {
            fields["editLeaseToken"] = Model.LeaseToken;
        }
        if (Model.ViewRoute is { } view)
        {
            fields["view"] = view;
        }
        return fields;
    }
}

@if (mayActOnCaseData && !isClosed)
{
    @if (isHeld)
    {
        <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["DialogId"] = "case-release-hold-dialog",
            ["DialogTitle"] = Frame.ReleaseHold,
            ["DialogActionUrl"] = Url.Page("/Cases/Workflow", "ReleaseHold", new { id = workflow.CaseId }),
            ["DialogHiddenFields"] = LeaseFields()
        })" />
    }
    else if (Model.CanPlaceOnHold)
    {
        @* Place on Hold (13 September): the reason and an optional Review on
           date, today or later, that the ribbon then reads. *@
        <div id="case-hold-dialog" class="dialog-backdrop" data-dialog="case-hold-dialog" data-dialog-open-on-load="@(Model.OpenDialog == "hold" ? "true" : null)" hidden>
            <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="case-hold-dialog-title">
                <div class="dialog-head">
                    <h2 id="case-hold-dialog-title" tabindex="-1">@Frame.PlaceOnHold</h2>
                    <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                    </button>
                </div>
                <form method="post" asp-page="/Cases/Workflow" asp-route-id="@workflow.CaseId" asp-page-handler="Hold">
                    <input type="hidden" name="id" value="@workflow.CaseId" />
                    <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                    <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                    @if (leased) { <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" /> }
                    <input type="hidden" name="view" value="@Model.ViewRoute" />
                <input type="hidden" name="section" value="@Model.Section" />
                    <div class="dialog-body stack">
                        <div class="field">
                            <label class="req" for="case-hold-reason">@OperatorLabels.CaseWorkspace.ReasonForAction</label>
                            <textarea id="case-hold-reason" name="reason" rows="3" required maxlength="500" data-dialog-initial-focus></textarea>
                        </div>
                        <div class="field">
                            <label for="case-hold-review-on">@Frame.ReviewOn</label>
                            <input id="case-hold-review-on" name="reviewOn" type="date" min="@today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                        </div>
                    </div>
                    <div class="dialog-foot">
                        <button type="button" class="btn" data-dialog-close>Cancel</button>
                        <button type="submit" data-busy-label="@OperatorLabels.Busy.Placing" class="btn btn--primary">@Frame.PlaceOnHold</button>
                    </div>
                </form>
            </section>
        </div>
    }
    @if (Model.CanOpenQuery)
    {
        @* Log query: the channel the query came by and what it is. No lease. *@
        <div id="case-log-query-dialog" class="dialog-backdrop" data-dialog="case-log-query-dialog" hidden>
            <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="case-log-query-dialog-title">
                <div class="dialog-head">
                    <h2 id="case-log-query-dialog-title" tabindex="-1">@Frame.LogQuery</h2>
                    <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                    </button>
                </div>
                <form method="post" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId" asp-page-handler="LogQuery" data-log-query-form>
                    <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                    <div class="dialog-body stack">
                        <div class="field">
                            <label for="case-log-query-channel">@Frame.Channel</label>
                            <select id="case-log-query-channel" name="channel" data-dialog-initial-focus>
                                @foreach (var channel in Enum.GetValues<CaseQueryChannel>())
                                {
                                    <option value="@channel">@CaseWorkspaceLabels.Queries.Channel(channel)</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label for="case-log-query-details">@Frame.Details</label>
                            <textarea id="case-log-query-details" name="details" rows="4"></textarea>
                        </div>
                    </div>
                    <div class="dialog-foot">
                        <button type="button" class="btn" data-dialog-close>Cancel</button>
                        <button type="submit" data-busy-label="@OperatorLabels.Busy.Logging" class="btn btn--primary">@Frame.LogQuery</button>
                    </div>
                </form>
            </section>
        </div>
    }
    @if (Model.AssignEngineerChoices is { Engineers.Count: > 0 } queryAssignees)
    {
        <div id="case-assign-query-dialog" class="dialog-backdrop" data-dialog="case-assign-query-dialog" hidden>
            <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="case-assign-query-dialog-title">
                <div class="dialog-head">
                    <h2 id="case-assign-query-dialog-title" tabindex="-1">@CaseWorkspaceLabels.Queries.AssignQuery</h2>
                    <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                    </button>
                </div>
                <form method="post" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId" asp-page-handler="AssignQuery" data-assign-query-form>
                    <input type="hidden" name="queryId" value="" />
                    <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                    <div class="dialog-body stack">
                        <div class="field">
                            <label for="case-assign-query-assignee">@CaseWorkspaceLabels.Queries.AssignedTo</label>
                            <select id="case-assign-query-assignee" name="assignee" data-dialog-initial-focus>
                                @foreach (var engineer in queryAssignees.Engineers)
                                {
                                    <option value="@engineer.StaffId">@queryAssignees.Label(engineer)</option>
                                }
                                <option value="unassigned">@CaseWorkspaceLabels.Queries.Unassigned</option>
                            </select>
                        </div>
                    </div>
                    <div class="dialog-foot">
                        <button type="button" class="btn" data-dialog-close>Cancel</button>
                        <button type="submit" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Assigning">@CaseWorkspaceLabels.Queries.Assign</button>
                    </div>
                </form>
            </section>
        </div>
    }
    @if (state is CaseLifecycleState.ReportPreparation or CaseLifecycleState.ReportSent)
    {
        <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["DialogId"] = "case-return-review-dialog",
            ["DialogTitle"] = Frame.ReturnToReview,
            ["DialogActionUrl"] = Url.Page("/Cases/Workflow", "ReturnToReview", new { id = workflow.CaseId }),
            ["DialogHiddenFields"] = LeaseFields()
        })" />
    }
    @if (workflow.ReportSentEvidence is { } unlinked && state is not CaseLifecycleState.Held)
    {
        var unlinkFields = LeaseFields();
        unlinkFields["evidenceId"] = unlinked.EvidenceId.ToString();
        <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["DialogId"] = "case-unlink-evidence-dialog",
            ["DialogTitle"] = Frame.UnlinkReportEvidence,
            ["DialogActionUrl"] = Url.Page("/Cases/Tasks", "UnlinkReportEvidence", new { id = workflow.CaseId }),
            ["DialogHiddenFields"] = unlinkFields
        })" />
    }
    <div id="case-correct-principal-dialog" class="dialog-backdrop" data-dialog="case-correct-principal-dialog" hidden>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="case-correct-principal-dialog-title">
            <div class="dialog-head">
                <h2 id="case-correct-principal-dialog-title" tabindex="-1">@Frame.CorrectPrincipal</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                </button>
            </div>
            <form method="post" asp-page="/Cases/Workflow" asp-route-id="@workflow.CaseId"
                  asp-page-handler="CreateLinkedReplacement">
                <input type="hidden" name="id" value="@workflow.CaseId" />
                <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                @if (leased) { <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" /> }
                <input type="hidden" name="view" value="@Model.ViewRoute" />
                <input type="hidden" name="section" value="@Model.Section" />
                <div class="dialog-body stack">
                    <div class="notice notice--warning">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-triangle")" /></svg>
                        <span>Record Created in error and create the linked replacement case.</span>
                    </div>
                    <div class="field">
                        <label class="req" for="case-replacement-principal">Replacement principal code</label>
                        <input id="case-replacement-principal" name="replacementPrincipalCode" required maxlength="100" data-dialog-initial-focus />
                    </div>
                    <div class="field">
                        <label class="req" for="case-replacement-reason">@OperatorLabels.CaseWorkspace.ReasonForAction</label>
                        <textarea id="case-replacement-reason" name="reason" rows="3" required maxlength="500"></textarea>
                    </div>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>Cancel</button>
                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Creating" class="btn btn--danger">Create linked replacement</button>
                </div>
            </form>
        </section>
    </div>
}

@if (Model.CanReturnToWork)
{
    @* Return to work (R157, v41 K10): the Archive dialog's frame with the
       stage to return to above the reason, posting the Closure page's Reopen
       handler, which applies the destination gates. *@
    <div id="case-return-to-work-dialog" class="dialog-backdrop" data-dialog="case-return-to-work-dialog" hidden>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="case-return-to-work-dialog_title">
            <div class="dialog-head">
                <h2 id="case-return-to-work-dialog_title" tabindex="-1">@Frame.ReturnToWork</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                </button>
            </div>
            <form method="post" asp-page="/Cases/Closure" asp-route-id="@workflow.CaseId" asp-page-handler="Reopen">
                @foreach (var field in LeaseFields())
                {
                    <input type="hidden" name="@field.Key" value="@field.Value" />
                }
                <div class="dialog-body stack">
                    <div class="field">
                        <label class="req" for="case-return-to-work-dialog_destination">@Frame.ReturnToWorkStage</label>
                        <select id="case-return-to-work-dialog_destination" name="destination" required>
                            <option value=""></option>
                            @foreach (var destination in Enum.GetValues<CaseReopenDestination>())
                            {
                                <option value="@destination">@Frame.ReturnToWorkDestination(destination)</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label class="req" for="case-return-to-work-dialog_reason">@OperatorLabels.CaseWorkspace.ReasonForAction</label>
                        <textarea id="case-return-to-work-dialog_reason" name="reason" rows="3" required maxlength="500"></textarea>
                    </div>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>Cancel</button>
                    <button type="submit" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Confirming">@OperatorLabels.CaseWorkspace.ConfirmAction</button>
                </div>
            </form>
        </section>
    </div>
}

@if (mayAct && isClosed && workflow.Archive is null)
{
    <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
    {
        ["DialogId"] = "case-archive-dialog",
        ["DialogTitle"] = Frame.ArchiveCase,
        ["DialogActionUrl"] = Url.Page("/Cases/Closure", "Archive", new { id = workflow.CaseId }),
        ["DialogHiddenFields"] = LeaseFields()
    })" />
}

@if (offersAdverseClosure)
{
    @* Review point 12: which outcome, and why. The chooser lists only the
       outcomes the page model derived from Core's closure rules for this
       state, so nothing offered here is refused for being the wrong outcome. *@
    <div id="case-close-dialog" class="dialog-backdrop" data-dialog="case-close-dialog" data-dialog-open-on-load="@(Model.OpenDialog == "close" ? "true" : null)" hidden>
        <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="case-close-dialog-title">
            <div class="dialog-head">
                <h2 id="case-close-dialog-title" tabindex="-1">@OperatorLabels.CaseWorkspace.CloseCase</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                </button>
            </div>
            <form method="post" asp-page="/Cases/Closure" asp-route-id="@workflow.CaseId" asp-page-handler="Close">
                <input type="hidden" name="id" value="@workflow.CaseId" />
                <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                @if (leased) { <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" /> }
                <input type="hidden" name="view" value="@Model.ViewRoute" />
                <input type="hidden" name="section" value="@Model.Section" />
                <div class="dialog-body stack">
                    <div class="field">
                        <label class="req" for="case-close-outcome">@OperatorLabels.CaseWorkspace.ClosureOutcome</label>
                        <select id="case-close-outcome" name="outcome" required data-dialog-initial-focus>
                            <option value=""></option>
                            @foreach (var outcome in closureOutcomes)
                            {
                                <option value="@outcome">@OperatorLabels.CaseClosure(outcome)</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label class="req" for="case-close-reason">@OperatorLabels.CaseWorkspace.ReasonForAction</label>
                        <textarea id="case-close-reason" name="reason" rows="3" required maxlength="500"></textarea>
                    </div>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>Cancel</button>
                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Closing" class="btn btn--danger btn--danger-solid">@OperatorLabels.CaseWorkspace.CloseCase</button>
                </div>
            </form>
        </section>
    </div>
}

@if (mayAct && state == CaseLifecycleState.ReportSent)
{
    <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
    {
        ["DialogId"] = "case-return-engineer-dialog",
        ["DialogTitle"] = Frame.ReturnToEngineer,
        ["DialogActionUrl"] = Url.Page("/Cases/Closure", "ReturnToEngineer", new { id = workflow.CaseId }),
        ["DialogHiddenFields"] = LeaseFields()
    })" />
}

@if (canAssignEngineer)
{
    <div id="case-handoff-dialog" class="dialog-backdrop" data-dialog="case-handoff-dialog" hidden>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="case-handoff-dialog-title">
            <div class="dialog-head">
                <h2 id="case-handoff-dialog-title" tabindex="-1">@CaseWorkspaceLabels.AssignEngineer</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                </button>
            </div>
            <div class="dialog-body stack">
                <form method="post" asp-page="/Cases/Workflow" asp-route-id="@workflow.CaseId"
                      asp-page-handler="AssignEngineer" class="stack" id="case-handoff-form">
                    <input type="hidden" name="id" value="@workflow.CaseId" />
                    <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                    <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                    @if (leased) { <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" /> }
                    <input type="hidden" name="view" value="@Model.ViewRoute" />
                <input type="hidden" name="section" value="@Model.Section" />
                    @* The signed-in person first as "Name (you)", the other
                       Engineers, then Unassigned (#1213, v41 K9). *@
                    <div class="field">
                        <label class="req" for="case-handoff-engineer">@OperatorLabels.CaseWorkspace.RibbonEngineer</label>
                        <select id="case-handoff-engineer" name="engineerId" required data-dialog-initial-focus>
                            <option value=""></option>
                            @foreach (var engineer in Model.AssignEngineerChoices!.Engineers)
                            {
                                <option value="@engineer.StaffId">@Model.AssignEngineerChoices!.Label(engineer)</option>
                            }
                            <option value="@AssignEngineerChoice.UnassignedValue">@OperatorLabels.CaseWorkspace.Unassigned</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="dialog-foot">
                <button type="submit" data-busy-label="@OperatorLabels.Busy.Assigning" form="case-handoff-form" class="btn btn--primary">@CaseWorkspaceLabels.AssignEngineer</button>
            </div>
        </section>
    </div>
}

@if (canConfirmReportSent)
{
    @* D10: the action only confirms detected Sent evidence; nothing here
       asserts a send. Each detected item offers its own confirmation. *@
    <div id="case-report-sent-dialog" class="dialog-backdrop" data-dialog="case-report-sent-dialog" hidden>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="case-report-sent-dialog-title">
            <div class="dialog-head">
                <h2 id="case-report-sent-dialog-title" tabindex="-1">@Frame.MarkReportSent</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                </button>
            </div>
            <div class="dialog-body stack">
                @foreach (var evidence in details.AvailableReportSentEvidence)
                {
                    <form method="post" asp-page="/Cases/Tasks" asp-route-id="@workflow.CaseId"
                          asp-page-handler="LinkReportEvidence" class="stack">
                        <input type="hidden" name="id" value="@workflow.CaseId" />
                        <input type="hidden" name="evidenceId" value="@evidence.EvidenceId" />
                        <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                        <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                        @if (leased) { <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" /> }
                        @* In the Inspection view, the Inspection report's own evidence, on its work. *@
                        <input type="hidden" name="view" value="@Model.ViewRoute" />
                <input type="hidden" name="section" value="@Model.Section" />
                        <div class="definition-list">
                            <dl class="definition"><dt>Mailbox</dt><dd>@evidence.MailboxIdentity</dd></dl>
                            <dl class="definition"><dt>Sent</dt><dd>@OperatorLabels.OfficeTime(evidence.SentAtUtc)</dd></dl>
                        </div>
                        <div class="field">
                            <label class="req" for="report-sent-reason-@evidence.EvidenceId">@OperatorLabels.CaseWorkspace.ReasonForAction</label>
                            <input id="report-sent-reason-@evidence.EvidenceId" name="reason" required maxlength="500" />
                        </div>
                        <div class="button-row">
                            <button type="submit" data-busy-label="@OperatorLabels.Busy.Linking" class="btn btn--primary">Confirm detected evidence</button>
                        </div>
                    </form>
                }
            </div>
        </section>
    </div>
}

@* Tasks, the Actions menu's dialog on every standard Case (operator, 13 October 2026). *@
<partial name="Cases/Shared/_CaseTasks" model="Model" />

@if (Model.CanCreateAudit)
{
    @* Create audit (v29 P5): the Case, the Audit reference it gains and the
       Engineer the Audit goes to, and one primary. No reason is asked; the
       action is its own record. *@
    <div id="case-create-audit-dialog" class="dialog-backdrop" data-dialog="case-create-audit-dialog" hidden>
        <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="case-create-audit-dialog-title">
            <div class="dialog-head">
                <h2 id="case-create-audit-dialog-title" tabindex="-1">@Frame.CreateAudit</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                </button>
            </div>
            <form method="post" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId" asp-page-handler="CreateAudit">
                <input type="hidden" name="id" value="@workflow.CaseId" />
                <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                @if (leased) { <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" /> }
                <div class="dialog-body stack">
                    <dl class="audit-facts">
                        <dt>@Frame.AuditDialogCase</dt><dd class="mono">@workflow.Identity.Reference</dd>
                        <dt>@Frame.AuditReference</dt><dd class="mono" data-audit-reference>@Model.ProposedAuditReference</dd>
                        <dt>@OperatorLabels.CaseWorkspace.RibbonEngineer</dt><dd data-audit-engineer>@(Model.EngineerDisplayName ?? OperatorLabels.CaseWorkspace.Unassigned)</dd>
                    </dl>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>Cancel</button>
                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Creating" class="btn btn--primary" data-dialog-initial-focus>
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-plus")" /></svg>
                        <span>@Frame.CreateAudit</span>
                    </button>
                </div>
            </form>
        </section>
    </div>
}

@if (Model.IsEditing)
{
    @* A request to edit addressed to the holder (R550, R553, R557): Accept
       hands the lease to the one asking, Deny closes the popup and editing
       carries on. It is a decision, not a notice, so it has no close
       control and Escape does nothing. Drawn while editing so the page's
       long poll can open it when a request arrives, and drawn open with its
       sentence when one was already waiting as the page was drawn. *@
    var requestToAnswer = Model.EditRequestToAnswer;
    <div id="case-edit-request-dialog" class="dialog-backdrop" data-dialog="case-edit-request-dialog"
         data-dialog-open-on-load="@(requestToAnswer is not null ? "true" : null)"
         data-edit-request-asks="@Frame.AsksToEdit("{name}")" data-edit-request-flash="@Frame.TitleFlash("{name}")" hidden>
        <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="case-edit-request-dialog-title">
            <div class="dialog-head">
                <h2 id="case-edit-request-dialog-title" tabindex="-1" data-dialog-initial-focus>@Frame.RequestToEdit</h2>
            </div>
            <div class="dialog-body stack">
                <p data-edit-request-text>@(requestToAnswer is not null && Model.EditRequester is { } requester ? Frame.AsksToEdit(EditModeDisplay.HolderName(requester)) : null)</p>
            </div>
            @foreach (var (formAnswer, formId) in new[] { ("decline", "case-edit-request-decline-form"), ("accept", "case-edit-request-accept-form") })
            {
                <form method="post" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId" asp-page-handler="AnswerEditRequest"
                      id="@formId" data-edit-request-form="@formAnswer" data-no-inplace>
                    <input type="hidden" name="id" value="@workflow.CaseId" />
                    <input type="hidden" name="requestId" value="@(requestToAnswer?.Id)" data-edit-request-id />
                    <input type="hidden" name="answer" value="@formAnswer" />
                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                    <input type="hidden" name="section" value="@Model.Section" />
                    <input type="hidden" name="view" value="@Model.ViewRoute" />
                </form>
            }
            <div class="dialog-foot">
                <button type="submit" form="case-edit-request-decline-form" data-busy-label="@OperatorLabels.Busy.Refusing" class="btn" data-edit-request-deny>@Frame.Deny</button>
                <button type="submit" form="case-edit-request-accept-form" data-busy-label="@OperatorLabels.Busy.Releasing" class="btn btn--primary" data-edit-request-accept>@Frame.Accept</button>
            </div>
        </section>
    </div>
}
