@using Pegasus.Core.Assessment
@using Pegasus.Web.Presentation
@using GlassLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.GlassSession
@using EstimateLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Estimate
@using EngineerLabels = Pegasus.Web.Presentation.OperatorLabels.CaseWorkspace.EngineerSections
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var caseId = Model.CurrentWorkflow!.CaseId;
    var caseVersion = Model.CurrentWorkflow!.Version;
    var glassSession = Model.GlassSession;
    var editing = Model.SectionIsEditable("estimate");
}
<div data-glass-controls="launch" data-glass-id="@glassSession?.Id" data-glass-version="@glassSession?.Version"
     data-glass-controls-url="@Url.Page("/Cases/Details", "GlassSession", new { id = caseId, view = Model.ViewRoute, estimate = Model.GlassSpecificationId })"
     data-glass-closed-notice="@GlassLabels.ClosedWithoutReturn" data-glass-stall-notice="@GlassLabels.EditorDidNotOpen"
     hidden="@(!editing || !Model.CanLaunchGlass)">
    @* The one Glass's slot (v26 G; one button, operator 6 October 2026):
       Glass's continues this staff member's session while it holds the
       account, reopens the estimate the repair spec on the screen belongs
       to, and otherwise starts a new one. Absent without an enabled
       account, and absent while the account is held from another Case.
       The estimator opens in its own window (case-workspace.js names it;
       target is the no-script path) and this record keeps its edit
       session. *@
    @if (editing && Model.CanLaunchGlass)
    {
        @* A session that failed because its export could not be read has
           nothing wrong at Glass's: the resume handler fetches that estimate
           again without opening the estimator. *@
        @if (Model.CanFetchGlassAgain && glassSession is not null)
        {
            <form method="post" asp-page="/Cases/Details" asp-page-handler="ResumeGlass"
                  asp-route-id="@caseId" asp-route-section="estimate"
                  target="_blank" data-glass-window data-glass-slot="fetch-again">
                <input type="hidden" name="operationKey" value="@Model.ResumeGlassOperationKey" />
                <input type="hidden" name="expectedCaseVersion" value="@caseVersion" />
                <input type="hidden" name="editLeaseToken" value="@Model.RenderLeaseToken" />
                <input type="hidden" name="view" value="@Model.ViewRoute" />
                <input type="hidden" name="sessionId" value="@glassSession.Id" />
                <input type="hidden" name="expectedSessionVersion" value="@glassSession.Version" />
                <button type="submit" data-busy-label="@OperatorLabels.Busy.Opening" class="btn btn--small">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-download")" /></svg>
                    <span>@GlassLabels.FetchAgain</span>
                </button>
            </form>
        }
        @if (Model.AsksGlassBuild && Model.GlassSpecificationId is { } outsideId)
        {
            @* A spec made outside Pegasus asks first (operator, 18 November
               2026; R1171). The dialog lives in this host so a controls
               refresh brings it with the current lease. Each answer is its
               own Glass's window form, opened on its own press: Import and
               open posts with build, and Open an empty estimate is the
               launch as it was, which the stall's second press finds. The
               link is the no-script path. *@
            var openOnLoad = Model.OpenDialog == "glass-build"
                ? Html.Raw(" data-dialog-open-on-load=\"true\"")
                : Html.Raw(" hidden");
            <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@caseId" asp-route-section="estimate"
               asp-route-estimate="@outsideId" asp-route-dialog="glass-build" asp-route-view="@Model.ViewRoute"
               data-dialog-open="glass-build-dialog" data-glass-slot="ask">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-external-link")" /></svg>
                <span>@GlassLabels.Launch</span>
            </a>
            <div id="glass-build-dialog" class="dialog-backdrop" data-dialog="glass-build-dialog" @openOnLoad>
                <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="glass-build-dialog-title">
                    <div class="dialog-head">
                        <h2 id="glass-build-dialog-title" tabindex="-1">@GlassLabels.BuildTitle</h2>
                        <button type="button" class="dialog-close" data-dialog-close aria-label="@EngineerLabels.CloseDialog">
                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                        </button>
                    </div>
                    <div class="dialog-body stack">
                        <p class="consequence">@GlassLabels.BuildPrompt</p>
                    </div>
                    <div class="dialog-foot">
                        <button type="button" class="btn" data-dialog-close>@EngineerLabels.Cancel</button>
                        <form method="post" asp-page="/Cases/Details" asp-page-handler="LaunchGlass"
                              asp-route-id="@caseId" asp-route-section="estimate"
                              target="_blank" data-glass-window data-glass-slot="launch">
                            <input type="hidden" name="operationKey" value="@Model.LaunchGlassOperationKey" />
                            <input type="hidden" name="expectedCaseVersion" value="@caseVersion" />
                            <input type="hidden" name="editLeaseToken" value="@Model.RenderLeaseToken" />
                            <input type="hidden" name="view" value="@Model.ViewRoute" />
                            <input type="hidden" name="estimate" value="@outsideId.ToString("D")" />
                            <button type="submit" data-busy-label="@OperatorLabels.Busy.Opening" class="btn">@GlassLabels.BuildEmpty</button>
                        </form>
                        <form method="post" asp-page="/Cases/Details" asp-page-handler="LaunchGlass"
                              asp-route-id="@caseId" asp-route-section="estimate" asp-route-build="true"
                              target="_blank" data-glass-window data-glass-slot="build">
                            <input type="hidden" name="operationKey" value="@Model.LaunchGlassOperationKey" />
                            <input type="hidden" name="expectedCaseVersion" value="@caseVersion" />
                            <input type="hidden" name="editLeaseToken" value="@Model.RenderLeaseToken" />
                            <input type="hidden" name="view" value="@Model.ViewRoute" />
                            <input type="hidden" name="estimate" value="@outsideId.ToString("D")" />
                            <button type="submit" data-busy-label="@OperatorLabels.Busy.Opening" class="btn btn--primary">@GlassLabels.BuildImport</button>
                        </form>
                    </div>
                </section>
            </div>
        }
        else
        {
            <form method="post" asp-page="/Cases/Details" asp-page-handler="LaunchGlass"
                  asp-route-id="@caseId" asp-route-section="estimate"
                  target="_blank" data-glass-window data-glass-slot="launch">
                <input type="hidden" name="operationKey" value="@Model.LaunchGlassOperationKey" />
                <input type="hidden" name="expectedCaseVersion" value="@caseVersion" />
                <input type="hidden" name="editLeaseToken" value="@Model.RenderLeaseToken" />
                <input type="hidden" name="view" value="@Model.ViewRoute" />
                @if (Model.GlassSpecificationId is { } specificationId)
                {
                    <input type="hidden" name="estimate" value="@specificationId.ToString("D")" />
                }
                <button type="submit" data-busy-label="@OperatorLabels.Busy.Opening" class="btn btn--small">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-external-link")" /></svg>
                    <span>@GlassLabels.Launch</span>
                </button>
            </form>
        }
    }
</div>
