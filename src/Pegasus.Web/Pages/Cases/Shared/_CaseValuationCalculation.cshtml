@*
    The calculation and the three values it ends in (v33 design D, operator,
    6 October 2026), drawn once: under the chosen source's row, or after the
    list when no source is chosen. The script moves it when another row is
    chosen.

    The calculator's controls belong to the Case form (one Save, 23 September
    2026): the Case's save records the calculation against its basis when it
    differs from the one the page opened on (selection.Opening), or when the
    Engineer pressed Use this value on a row (selection.Use, 28 September
    2026; a row typed in the same edit is named by selection.GuideSource).
    There is no Apply. The figures are Core's own arithmetic over what the
    save will use, fetched by script from the PreviewValuation handler: the
    proposal fills the Engineer's Value box, which is the one place the figure
    stands, and the commercial VAT and previous total loss amounts show in
    their own cells' label lines. There is no second total and no applied
    block (6 October 2026).

    The Retail, Trade and Engineer's Value boxes are ordinary fields of the
    Case form: typed, or filled in place by script when a row is chosen or the
    calculation changes. While the Engineer's Value holds a recorded
    calculation's figure, its label carries that calculation's source as one
    word; a typed figure carries none.
*@
@model Pegasus.Web.Pages.Cases.DetailsModel
@using System.Globalization
@using Pegasus.Core.Assessment
@using Pegasus.Web.Presentation
@using ValuationLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Valuation
@{
    var workflow = Model.ValuationSection?.Frame.Workflow ?? Model.Case!.Workflow;
    var caseId = workflow.CaseId;
    var editable = Model.SectionIsEditable("valuation");
    var basis = Model.DefaultBasis;
    var recorded = Model.RecordedValuation;
    var claimantVat = Model.ClaimantVatRegistered;
    // The calculator opens on the recorded calculation, so the figures read
    // the same in both modes until the Engineer changes one.
    var recordedIsBasis = recorded is not null && basis is not null && basis.ValuationId == recorded.GuideValuationId;
    var calculation = editable
        ? (recordedIsBasis ? recorded!.Calculation : Model.DefaultCalculation)
        : recorded?.Calculation;
    var recordedBasis = recorded is null
        ? null
        : Model.Valuations.FirstOrDefault(valuation => valuation.ValuationId == recorded.GuideValuationId);
    var basisName = editable
        ? (basis is null ? null : ValuationLabels.SourceLabel(basis.Details.Source))
        : (recorded is null ? null : (recordedBasis is null ? "Guide" : ValuationLabels.SourceLabel(recordedBasis.Details.Source)));
    var lineForm = editable ? "case-edit-form" : null;

    // The value increases, one list in both modes (DetailsModel.ValuationIncreaseRows):
    // every active preset, ticked where the recorded calculation applied it,
    // then any applied increase that is not an active preset. Read mode leaves
    // out the blank custom rows the calculator offers.
    var shownIncreases = Model.ValuationIncreaseRows.Where(row => row.PresetId != Guid.Empty || row.Selected).ToArray();
    var hasIncreases = editable || shownIncreases.Length > 0;

    string Money(decimal value) => ValuationCalculationPolicy.FormatMoney(value);

    var recordedPtl = recorded?.Calculation.PriorTotalLossPercentage is { } recordedPercentage
        ? (recordedPercentage * 100m).ToString("0", CultureInfo.InvariantCulture)
        : null;
    var recordedDeduction = recorded is { Calculation.ConditionDeduction: > 0m }
        ? recorded.Calculation.ConditionDeduction.ToString("0.00", CultureInfo.InvariantCulture)
        : null;
}
<div class="valuation-open" data-valuation-open>
    <div class="sub-panel calc-inputs" data-valuation-calc
         data-valuation-form="@(editable ? "true" : null)"
         data-preview-url="@(editable ? Url.Page("/Cases/Details", "PreviewValuation", new { id = caseId, view = Model.ViewRoute }) : null)"
         data-text-use="@(editable ? ValuationLabels.UseThisValue : null)"
         data-text-using="@(editable ? ValuationLabels.UsingThisValue : null)"
         data-text-use-needs-retail="@(editable ? ValuationLabels.UseNeedsRetail : null)"
         data-text-preview-failed="@(editable ? ValuationLabels.PreviewFailed : null)">
        @if (editable)
        {
            @* The calculation the last commit recorded: a commit records
               one that differs from it, or one the Engineer chose to use,
               and the script carries the recorded one forward. Use this
               value switches the two hidden fields on (a row typed in
               this edit has no identity, so it is named by its source);
               they post nothing until then. *@
            <partial name="Cases/Shared/_CaseValuationOpening" model="Model" />
            <input type="hidden" name="selection.GuideSource" value="" form="case-edit-form" disabled data-valuation-source-input />
            <input type="hidden" name="selection.Use" value="true" form="case-edit-form" disabled data-valuation-use-input />
        }
        <h3>@ValuationLabels.Calculation <span class="rt" data-valuation-basis-name>@(basisName is null ? string.Empty : string.Format(CultureInfo.InvariantCulture, ValuationLabels.FromRetail, basisName))</span></h3>
        <div class="fg g3">
            <div class="fc @(editable ? null : "ro")">
                @if (editable)
                {
                    <label for="f-valuation-ptl">@ValuationLabels.PreviousTotalLoss<span class="calc-amount" data-valuation-amount="ptl">@(calculation is null ? null : ValuationLabels.PriorTotalLossAmount(calculation))</span></label>
                }
                else
                {
                    <span class="lbl">@ValuationLabels.PreviousTotalLoss<span class="calc-amount" data-valuation-amount="ptl">@(calculation is null ? null : ValuationLabels.PriorTotalLossAmount(calculation))</span></span>
                }
                <div class="fv" data-valuation-ptl-read>@(recordedPtl is null ? "None" : "−" + recordedPtl + " %")</div>
                @if (editable)
                {
                    <select id="f-valuation-ptl" class="fi" name="selection.PriorTotalLossPercentage" form="@lineForm" data-valuation-input>
                        <option value="" selected="@(recordedPtl is null ? "selected" : null)">None</option>
                        <option value="10" selected="@(recordedPtl == "10" ? "selected" : null)">−10 %</option>
                        <option value="20" selected="@(recordedPtl == "20" ? "selected" : null)">−20 %</option>
                    </select>
                }
            </div>
            <div class="fc @(editable ? null : "ro")">
                @if (editable)
                {
                    <label for="f-valuation-deduction">@ValuationLabels.ConditionDeduction</label>
                }
                else
                {
                    <span class="lbl">@ValuationLabels.ConditionDeduction</span>
                }
                <div class="fv mono @(recordedDeduction is null ? "empty" : null)" data-valuation-deduction-read>@(recorded is { Calculation.ConditionDeduction: > 0m } ? Money(recorded.Calculation.ConditionDeduction) : "—")</div>
                @if (editable)
                {
                    <input id="f-valuation-deduction" class="fi mono" type="number" min="0" step="0.01" placeholder="£" name="selection.ConditionDeduction" form="@lineForm" value="@recordedDeduction" data-valuation-input />
                }
            </div>
            <div class="fc @(editable ? null : "ro")">
                <span class="lbl">@ValuationLabels.CommercialVat<span class="calc-amount" data-valuation-amount="vat">@(calculation is null ? null : ValuationLabels.VatAmount(calculation))</span></span>
                <div class="fv" data-valuation-vat-read>@(recorded is { Calculation.CommercialVatApplied: true } ? ValuationLabels.Applied : ValuationLabels.NotApplied)</div>
                @if (editable)
                {
                    <label class="fi chk choice" data-valuation-vat-wrap>
                        <input type="checkbox" name="selection.CommercialVat" value="true" form="@lineForm"
                               checked="@(!claimantVat && recorded is { Calculation.CommercialVatApplied: true } ? "checked" : null)"
                               disabled="@(claimantVat ? "disabled" : null)" data-valuation-input />
                        <span>@ValuationLabels.AddVat</span>
                        @if (claimantVat)
                        {
                            <span class="src-tag src-tag--warn">@ValuationLabels.ClaimantVatRegistered</span>
                        }
                    </label>
                }
            </div>
        </div>
        <h3 class="adds-head @(hasIncreases ? null : "none")" data-valuation-adds-head>@ValuationLabels.ValueIncreases</h3>
        <div class="adds" data-valuation-adds>
            @if (editable)
            {
                @* The rows the calculation opens on (DetailsModel.ValuationIncreaseRows):
                   every active preset, then the custom rows, where an
                   applied increase that is not an active preset opens. *@
                var index = 0;
                foreach (var row in Model.ValuationIncreaseRows)
                {
                    if (row.PresetId != Guid.Empty)
                    {
                        <div class="add @(row.Selected ? "on" : null)" data-valuation-add="@index">
                            <input type="checkbox" name="selection.AdditionSelected" value="@index" form="@lineForm" id="f-valuation-add-@index" checked="@(row.Selected ? "checked" : null)" data-preset-toggle data-valuation-input aria-label="@row.Label" />
                            <input type="hidden" name="selection.AdditionPresetId" value="@row.PresetId" form="@lineForm" />
                            <input type="hidden" name="selection.AdditionPresetVersion" value="@row.PresetVersion" form="@lineForm" />
                            <input type="hidden" name="selection.AdditionLabel" value="" form="@lineForm" />
                            <label for="f-valuation-add-@index">@row.Label</label>
                            <input class="amt" type="number" min="0" step="0.01" name="selection.AdditionAmount" form="@lineForm"
                                   value="@row.Amount?.ToString("0.##", CultureInfo.InvariantCulture)" placeholder="£"
                                   aria-label="@row.Label amount" data-valuation-input />
                        </div>
                    }
                    else
                    {
                        <div class="add add--custom @(row.Selected ? "on" : null)" data-valuation-add="@index">
                            <input type="checkbox" name="selection.AdditionSelected" value="@index" form="@lineForm" id="f-valuation-add-@index" checked="@(row.Selected ? "checked" : null)" data-preset-toggle data-valuation-input aria-label="@ValuationLabels.OtherAddition" />
                            <input type="hidden" name="selection.AdditionPresetId" value="@Guid.Empty" form="@lineForm" />
                            <input type="hidden" name="selection.AdditionPresetVersion" value="0" form="@lineForm" />
                            <input type="text" name="selection.AdditionLabel" form="@lineForm" maxlength="@ValuationCalculationPolicy.MaximumAdditionLabelLength"
                                   value="@row.Label" placeholder="@ValuationLabels.OtherAddition" aria-label="@ValuationLabels.OtherAddition" data-valuation-input />
                            <input class="amt" type="number" min="0" step="0.01" name="selection.AdditionAmount" form="@lineForm" placeholder="£"
                                   value="@row.Amount?.ToString("0.##", CultureInfo.InvariantCulture)"
                                   aria-label="@ValuationLabels.OtherAddition amount" data-valuation-input />
                        </div>
                    }
                    index++;
                }
            }
            else
            {
                @* Read mode lists the same increases; a tick marks each one
                   the recorded calculation applied (a mark, not a control). *@
                foreach (var row in shownIncreases)
                {
                    <div class="add @(row.Selected ? "on" : null)" data-valuation-applied-addition="@(row.Selected ? "true" : null)">
                        <span class="add-check" aria-hidden="@(row.Selected ? null : "true")">@if (row.Selected) {<svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg><span class="sr-only">@ValuationLabels.Applied</span>}</span>
                        <span>@row.Label</span>
                        <span class="amt">@Money(row.Amount ?? 0m)</span>
                    </div>
                }
            }
        </div>
        @* What the calculation says when it has no figure: "None yet" only
           while editing with no source chosen (FRD-24); the script puts a
           refusal's own reason here. *@
        <div data-valuation-preview-host>
            @if (editable && calculation is null)
            {
                <div class="muted" data-valuation-none>@ValuationLabels.NoneYet</div>
            }
        </div>
    </div>
    @* The three values the report prints side by side. *@
    <div class="fg g3" data-valuation-values>
        @{ ValueCell(AssessmentVocabulary.ValueRetail, "retail");
            ValueCell(AssessmentVocabulary.ValueTrade, "trade");
            ValueCell(AssessmentVocabulary.ValueEngineer, "engineer"); }
    </div>
</div>

@functions {
    // One of the report's three values: a money box of the Case form while
    // editing, the same cell greyed while reading. The hook names it for the
    // script that fills it. The Engineer's Value carries the recorded
    // calculation's source as its one word; the script shows and hides it as
    // the box changes and as each save lands.
    private void ValueCell(string path, string hook)
    {
        var editable = Model.SectionIsEditable("valuation") && Model.CanEditAssessmentField(path);
        var label = CaseWorkspaceLabels.Editors.Valuation[path];
        var tag = Model.AssessmentSourceTag(path);
        var id = "f-valuation-value-" + hook;
        var word = hook == "engineer" ? Model.RecordedBasisWord : null;
        var wordClass = Model.RecordedBasisIsResearch ? "src-tag src-tag--ai" : "src-tag";
        <div class="fc @(editable ? null : "ro")" data-field="@path">
            @if (editable)
            {
                <label for="@id">@label@(tag?.Render())@if (hook == "engineer") {<span class="@wordClass" data-valuation-recorded-word hidden="@(word is null ? "hidden" : null)">@word</span>}</label>
            }
            else
            {
                <span class="lbl">@label@(tag?.Render())@if (word is not null) {<span class="@wordClass" data-valuation-recorded-word>@word</span>}</span>
            }
            <div class="fv mono @(Model.AssessmentIsAbsent(path) ? "empty" : null)">@Model.AssessmentDisplay(path)</div>
            @if (editable)
            {
                <input id="@id" class="fi mono" type="number" min="0" step="0.01" name="@CaseWorkspaceLabels.Editors.FormName(path)"
                       form="case-edit-form" value="@Model.AssessmentEditorValue(path)" data-valuation-value="@hook" />
            }
        </div>
    }
}
