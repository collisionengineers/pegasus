@*
    The calculation and the value it ends in (v34, operator, 8 October 2026),
    drawn once below the guide cards: the value increases, with Add 20 % VAT
    as one of them; the condition deduction and the previous total loss; then
    the Engineer's Value with the basis the calculation starts from.

    The calculator's controls belong to the Case form (one Save, 23 September
    2026): the Case's save records the calculation against its basis when it
    differs from the one the page opened on (selection.Opening), or when the
    Engineer clicked a card (selection.Use, 8 October 2026; a card typed in
    the same edit is named by selection.GuideSource), and writes the report's
    Retail and Trade from that card. There is no Apply. The figures are Core's
    own arithmetic over what the save will use, fetched by script from the
    PreviewValuation handler: the proposal fills the Engineer's Value box,
    which is the one place the figure stands, and the commercial VAT and
    previous total loss amounts show beside their own controls.

    The Engineer's Value box is an ordinary field of the Case form: typed, or
    filled in place by script when a card is chosen or the calculation
    changes. While it holds a recorded calculation's figure, its label carries
    that calculation's source as one word; a typed figure carries none.
*@
@model Pegasus.Web.Pages.Cases.DetailsModel
@using System.Globalization
@using Pegasus.Core.Assessment
@using Pegasus.Web.Presentation
@using ValuationLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Valuation
@{
    var workflow = Model.ValuationSection?.Frame.Workflow ?? Model.Case!.Workflow;
    var caseId = workflow.CaseId;
    var editable = Model.SectionIsEditable("valuation");
    var basis = Model.DefaultBasis;
    var recorded = Model.RecordedValuation;
    var claimantVat = Model.ClaimantVatRegistered;
    // The calculator opens on the recorded calculation, so the figures read
    // the same in both modes until the Engineer changes one.
    var recordedIsBasis = recorded is not null && basis is not null && basis.ValuationId == recorded.GuideValuationId;
    var calculation = editable
        ? (recordedIsBasis ? recorded!.Calculation : Model.DefaultCalculation)
        : recorded?.Calculation;
    var recordedBasis = recorded is null
        ? null
        : Model.Valuations.FirstOrDefault(valuation => valuation.ValuationId == recorded.GuideValuationId);
    var basisName = editable
        ? (basis is null ? null : ValuationLabels.SourceLabel(basis.Details.Source))
        : (recorded is null ? null : (recordedBasis is null ? "Guide" : ValuationLabels.SourceLabel(recordedBasis.Details.Source)));
    var lineForm = editable ? "case-edit-form" : null;

    // The value increases, one list in both modes (DetailsModel.ValuationIncreaseRows):
    // every active preset, then Add 20 % VAT, then the custom rows the
    // calculator offers. Read mode lists only what the recorded calculation applied.
    var vatApplied = recorded is { Calculation.CommercialVatApplied: true };
    var shownIncreases = Model.ValuationIncreaseRows.Where(row => row.Selected).ToArray();
    var hasIncreases = editable || shownIncreases.Length > 0 || vatApplied;

    string Money(decimal value) => ValuationCalculationPolicy.FormatMoney(value);

    var recordedPtl = recorded?.Calculation.PriorTotalLossPercentage is { } recordedPercentage
        ? (recordedPercentage * 100m).ToString("0", CultureInfo.InvariantCulture)
        : null;
    var recordedDeduction = recorded is { Calculation.ConditionDeduction: > 0m }
        ? recorded.Calculation.ConditionDeduction.ToString("0.00", CultureInfo.InvariantCulture)
        : null;
}
<div class="valuation-calc" data-valuation-calc
     data-valuation-form="@(editable ? "true" : null)"
     data-preview-url="@(editable ? Url.Page("/Cases/Details", "PreviewValuation", new { id = caseId, view = Model.ViewRoute }) : null)"
     data-text-preview-failed="@(editable ? ValuationLabels.PreviewFailed : null)">
    @if (editable)
    {
        @* The calculation the last commit recorded: a commit records one
           that differs from it, or one the Engineer chose by clicking its
           card, and the script carries the recorded one forward. A click
           switches the two hidden fields on (a card typed in this edit has
           no identity, so it is named by its source); they post nothing
           until then. *@
        <partial name="Cases/Shared/_CaseValuationOpening" model="Model" />
        <input type="hidden" name="selection.GuideSource" value="" form="case-edit-form" disabled data-valuation-source-input />
        <input type="hidden" name="selection.Use" value="true" form="case-edit-form" disabled data-valuation-use-input />
    }
    @if (hasIncreases)
    {
        <div class="sub-panel valuation-increases">
            <h3 class="adds-head" data-valuation-adds-head>@ValuationLabels.ValueIncreases</h3>
            <div class="adds" data-valuation-adds>
                @if (editable)
                {
                    @* The rows the calculation opens on (DetailsModel.ValuationIncreaseRows):
                       every active preset, Add 20 % VAT, then the custom rows,
                       where an applied increase that is not an active preset opens. *@
                    var index = 0;
                    var vatDrawn = false;
                    foreach (var row in Model.ValuationIncreaseRows)
                    {
                        if (row.PresetId == Guid.Empty && !vatDrawn)
                        {
                            vatDrawn = true;
                            VatRow(claimantVat, recorded, calculation, lineForm);
                        }
                        if (row.PresetId != Guid.Empty)
                        {
                            <div class="add @(row.Selected ? "on" : null)" data-valuation-add="@index">
                                <input type="checkbox" name="selection.AdditionSelected" value="@index" form="@lineForm" id="f-valuation-add-@index" checked="@(row.Selected ? "checked" : null)" data-preset-toggle data-valuation-input aria-label="@row.Label" />
                                <input type="hidden" name="selection.AdditionPresetId" value="@row.PresetId" form="@lineForm" />
                                <input type="hidden" name="selection.AdditionPresetVersion" value="@row.PresetVersion" form="@lineForm" />
                                <input type="hidden" name="selection.AdditionLabel" value="" form="@lineForm" />
                                <label for="f-valuation-add-@index">@row.Label</label>
                                <input class="amt" type="number" min="0" step="0.01" name="selection.AdditionAmount" form="@lineForm"
                                       value="@row.Amount?.ToString("0.##", CultureInfo.InvariantCulture)" placeholder="£"
                                       aria-label="@row.Label amount" data-valuation-input />
                            </div>
                        }
                        else
                        {
                            <div class="add add--custom @(row.Selected ? "on" : null)" data-valuation-add="@index">
                                <input type="checkbox" name="selection.AdditionSelected" value="@index" form="@lineForm" id="f-valuation-add-@index" checked="@(row.Selected ? "checked" : null)" data-preset-toggle data-valuation-input aria-label="@ValuationLabels.OtherAddition" />
                                <input type="hidden" name="selection.AdditionPresetId" value="@Guid.Empty" form="@lineForm" />
                                <input type="hidden" name="selection.AdditionPresetVersion" value="0" form="@lineForm" />
                                <input type="text" name="selection.AdditionLabel" form="@lineForm" maxlength="@ValuationCalculationPolicy.MaximumAdditionLabelLength"
                                       value="@row.Label" placeholder="@ValuationLabels.OtherAddition" aria-label="@ValuationLabels.OtherAddition" data-valuation-input />
                                <input class="amt" type="number" min="0" step="0.01" name="selection.AdditionAmount" form="@lineForm" placeholder="£"
                                       value="@row.Amount?.ToString("0.##", CultureInfo.InvariantCulture)"
                                       aria-label="@ValuationLabels.OtherAddition amount" data-valuation-input />
                            </div>
                        }
                        index++;
                    }
                    if (!vatDrawn)
                    {
                        VatRow(claimantVat, recorded, calculation, lineForm);
                    }
                }
                else
                {
                    @* Read mode lists what the recorded calculation applied,
                       each with a tick (a mark, not a control). *@
                    foreach (var row in shownIncreases)
                    {
                        <div class="add on" data-valuation-applied-addition="true">
                            <span class="add-check"><svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg><span class="sr-only">@ValuationLabels.Applied</span></span>
                            <span>@row.Label</span>
                            <span class="amt">@Money(row.Amount ?? 0m)</span>
                        </div>
                    }
                    if (vatApplied)
                    {
                        <div class="add on add--vat" data-valuation-applied-addition="true">
                            <span class="add-check"><svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg><span class="sr-only">@ValuationLabels.Applied</span></span>
                            <span>@ValuationLabels.AddVat</span>
                            <span class="amt" data-valuation-amount="vat">@ValuationLabels.VatAmount(recorded!.Calculation)</span>
                        </div>
                    }
                }
            </div>
        </div>
    }
    <div class="sub-panel valuation-deductions">
        <div class="fc @(editable ? null : "ro")">
            @if (editable)
            {
                <label for="f-valuation-deduction">@ValuationLabels.ConditionDeduction</label>
            }
            else
            {
                <span class="lbl">@ValuationLabels.ConditionDeduction</span>
            }
            <div class="fv mono @(recordedDeduction is null ? "empty" : null)" data-valuation-deduction-read>@(recorded is { Calculation.ConditionDeduction: > 0m } ? Money(recorded.Calculation.ConditionDeduction) : "—")</div>
            @if (editable)
            {
                <input id="f-valuation-deduction" class="fi mono" type="number" min="0" step="0.01" placeholder="£" name="selection.ConditionDeduction" form="@lineForm" value="@recordedDeduction" data-valuation-input />
            }
        </div>
        @* Previous total loss (item G): a tick box, then −10 % or −20 %. The
           two percentages are the field's radios, so without script they are
           the control; the script ties them to the tick box. Its amount stands
           in the label line, as the commercial VAT's does on its row. *@
        <div class="fc valuation-ptl @(editable ? null : "ro")">
            <span class="lbl">@(editable ? null : ValuationLabels.PreviousTotalLoss)<span class="calc-amount" data-valuation-amount="ptl">@(calculation is null ? null : ValuationLabels.PriorTotalLossAmount(calculation))</span></span>
            <div class="fv" data-valuation-ptl-read>@(recordedPtl is null ? "None" : "−" + recordedPtl + " %")</div>
            @if (editable)
            {
                var ptl = recordedPtl;
                <div class="fi chk valuation-ptl-row">
                    <label class="choice"><input type="checkbox" id="f-valuation-ptl" checked="@(ptl is null ? null : "checked")" data-valuation-ptl-toggle /><span>@ValuationLabels.PreviousTotalLoss</span></label>
                    <span class="case-layout-switch valuation-ptl-switch" role="radiogroup" aria-label="@ValuationLabels.PreviousTotalLoss">
                        @foreach (var percentage in new[] { "10", "20" })
                        {
                            <label><input type="radio" name="selection.PriorTotalLossPercentage" value="@percentage" form="@lineForm" checked="@(ptl == percentage ? "checked" : null)" data-valuation-input data-valuation-ptl /><span>−@percentage %</span></label>
                        }
                    </span>
                </div>
            }
        </div>
    </div>
    @* The Engineer's Value: the one box, then the basis the calculation
       starts from, or what it says when it has no figure: "None yet" only
       while editing with no card chosen (FRD-24); the script puts a
       refusal's own reason here. *@
    <div class="valuation-value" data-valuation-values>
        @{ ValueCell(); }
        @* Reading with no recorded calculation has nothing to say here. *@
        @if (editable || basisName is not null)
        {
            <div class="valuation-value-calc">
                <span class="lbl">@ValuationLabels.Calculation</span>
                <span data-valuation-basis-name>@(basisName is null ? string.Empty : string.Format(CultureInfo.InvariantCulture, ValuationLabels.FromRetail, basisName))</span>
                <div data-valuation-preview-host>
                    @if (editable && calculation is null)
                    {
                        <div class="muted" data-valuation-none>@ValuationLabels.NoneYet</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@functions {
    // Add 20 % VAT as a row of the value increases (item F), its amount where
    // an increase's figure stands. A VAT-registered claimant never has the
    // commercial addition, so the box is disabled with the reason beside it.
    private void VatRow(bool claimantVat, AppliedValuation? recorded, ValuationCalculation? calculation, string? lineForm)
    {
        var on = !claimantVat && recorded is { Calculation.CommercialVatApplied: true };
        <div class="add add--vat @(on ? "on" : null)" data-valuation-vat-wrap>
            <input type="checkbox" id="f-valuation-vat" name="selection.CommercialVat" value="true" form="@lineForm"
                   checked="@(on ? "checked" : null)" disabled="@(claimantVat ? "disabled" : null)" data-valuation-input />
            <label for="f-valuation-vat">@CaseWorkspaceLabels.Valuation.AddVat
                @if (claimantVat)
                {
                    <span class="src-tag src-tag--warn">@CaseWorkspaceLabels.Valuation.ClaimantVatRegistered</span>
                }
            </label>
            <span class="amt calc-amount" data-valuation-amount="vat">@(calculation is null ? null : CaseWorkspaceLabels.Valuation.VatAmount(calculation))</span>
        </div>
    }

    // The Engineer's Value: a money box of the Case form while editing, the
    // same cell greyed while reading. The hook names it for the script that
    // fills it. It carries the recorded calculation's source as its one word;
    // the script shows and hides it as the box changes and as each save lands.
    private void ValueCell()
    {
        var path = AssessmentVocabulary.ValueEngineer;
        var editable = Model.SectionIsEditable("valuation") && Model.CanEditAssessmentField(path);
        var label = CaseWorkspaceLabels.Editors.Valuation[path];
        var tag = Model.AssessmentSourceTag(path);
        var id = "f-valuation-value-engineer";
        var word = Model.RecordedBasisWord;
        var wordClass = Model.RecordedBasisIsResearch ? "src-tag src-tag--ai" : "src-tag";
        <div class="fc @(editable ? null : "ro")" data-field="@path">
            @if (editable)
            {
                <label for="@id">@label@(tag?.Render())<span class="@wordClass" data-valuation-recorded-word hidden="@(word is null ? "hidden" : null)">@word</span></label>
            }
            else
            {
                <span class="lbl">@label@(tag?.Render())@if (word is not null) {<span class="@wordClass" data-valuation-recorded-word>@word</span>}</span>
            }
            <div class="fv mono @(Model.AssessmentIsAbsent(path) ? "empty" : null)">@(Model.AssessmentIsAbsent(path) ? "—" : Model.AssessmentDisplay(path))</div>
            @if (editable)
            {
                <input id="@id" class="fi mono" type="number" min="0" step="0.01" name="@CaseWorkspaceLabels.Editors.FormName(path)"
                       form="case-edit-form" value="@Model.AssessmentEditorValue(path)" data-valuation-value="engineer" />
            }
        </div>
    }
}
