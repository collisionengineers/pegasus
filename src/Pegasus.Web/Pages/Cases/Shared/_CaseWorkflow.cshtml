@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Cases
@using Pegasus.Core.Custody
@using Pegasus.Core.Lifecycle
@using Pegasus.Core.Tasks
@using Pegasus.Core.Vehicle
@using Pegasus.Core.Workflow
@using Pegasus.Web.Pages
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    // A typed value as text, keeping its provenance so the row can show where
    // it came from as an icon rather than as a source label, a policy key and
    // a version integer.
    static CaseDataValue<string>? Text<T>(CaseDataValue<T>? value) where T : notnull =>
        value is null
            ? null
            : new(
                value.Value.ToString() ?? string.Empty,
                value.Kind,
                value.Source,
                value.ConfirmedByActor,
                value.ConfirmedAtUtc);
    // A mileage figure never appears without its supplied/external/estimated
    // class, so the one place that turns a case mileage value into row text
    // also appends the classification word (a derived estimate is never
    // presented as supplied).
    static CaseDataValue<string>? ModeText(CaseDataValue<CaseInspectionMode>? value) =>
        value is null
            ? null
            : new(
                OperatorLabels.InspectionMode(value.Value),
                value.Kind,
                value.Source,
                value.ConfirmedByActor,
                value.ConfirmedAtUtc);
    static CaseDataValue<string>? MileageText(CaseDataValue<long>? value) =>
        value is null
            ? null
            : new(
                $"{value.Value:N0} — {OperatorLabels.MileageEvidence(VehicleMileageEvidenceClassification.Classify(value.Source.Kind))}",
                value.Kind,
                value.Source,
                value.ConfirmedByActor,
                value.ConfirmedAtUtc);
    var data = details.Data;
    var leaseToken = Model.LeaseToken;
    var mayEdit = !string.IsNullOrWhiteSpace(leaseToken) && workflow.Archive is null;
}

@* Edit mode is a toggle on the case action bar (CASE-007); this
   partial renders only the sections that carry content or an action in the
   current mode. *@

@if (Model.ProposedValuesWereDropped)
{
    <section class="panel form-panel" aria-labelledby="case-proposed-values-title">
        <h2 id="case-proposed-values-title" class="section-label">Your change was not applied</h2>
        <p>The values you submitted were too large to keep and are not shown here; enter edit mode again and re-enter them.</p>
    </section>
}
else if (Model.ProposedValues.Count > 0)
{
    <section class="panel form-panel" aria-labelledby="case-proposed-values-title">
        <h2 id="case-proposed-values-title" class="section-label">Your change was not applied</h2>
        <p>Nothing here can be applied; enter edit mode again and re-enter the values you still want.</p>
        @if (Model.ProposedValuesWereShortened)
        {
            <p class="notice">Some values were too long to keep in full and are shown shortened; re-enter those in full.</p>
        }
        <div class="table-wrap">
            <table>
                <thead><tr><th>Field</th><th>You proposed</th><th>The case now holds</th></tr></thead>
                <tbody>
                    @foreach (var proposed in Model.ProposedValues)
                    {
                        <tr>
                            <th>@proposed.Label</th>
                            <td>@proposed.Proposed</td>
                            <td>@(string.IsNullOrWhiteSpace(proposed.Current) ? "—" : proposed.Current)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (data is not null)
{
    <section class="panel form-panel" aria-labelledby="case-data-title">
        <h2 id="case-data-title" class="section-label">Case detail</h2>
        @{
            // One row per field, showing the value that applies and where it
            // came from. It replaces a three-column Fact / Suggestion /
            // Staff-confirmed grid in which every populated cell also carried a
            // source label, a policy key and a version integer — none of which
            // an operator can act on, and most of which were em dashes.
            var rows = new (string Field, CaseDataValue<string>? Accepted, CaseDataValue<string>? Suggested)[]
            {
                ("Claimant", Text(data.Claimant.Name.Fact) ?? Text(data.Claimant.Name.Confirmed), Text(data.Claimant.Name.Suggestion)),
                ("Claim number", Text(data.Claim.Number.Fact) ?? Text(data.Claim.Number.Confirmed), Text(data.Claim.Number.Suggestion)),
                ("Registration", Text(data.Vehicle.Registration.Fact) ?? Text(data.Vehicle.Registration.Confirmed), Text(data.Vehicle.Registration.Suggestion)),
                ("Vehicle make", Text(data.Vehicle.Make.Fact) ?? Text(data.Vehicle.Make.Confirmed), Text(data.Vehicle.Make.Suggestion)),
                ("Vehicle model", Text(data.Vehicle.Model.Fact) ?? Text(data.Vehicle.Model.Confirmed), Text(data.Vehicle.Model.Suggestion)),
                ("Mileage", MileageText(data.Vehicle.Mileage.Fact) ?? MileageText(data.Vehicle.Mileage.Confirmed), MileageText(data.Vehicle.Mileage.Suggestion)),
                ("Incident date", Text(data.Accident.IncidentDate.Fact) ?? Text(data.Accident.IncidentDate.Confirmed), Text(data.Accident.IncidentDate.Suggestion)),
                ("Accident circumstances", Text(data.Accident.Circumstances.Fact) ?? Text(data.Accident.Circumstances.Confirmed), Text(data.Accident.Circumstances.Suggestion)),
                ("Contact name", Text(data.Contact.Name.Fact) ?? Text(data.Contact.Name.Confirmed), Text(data.Contact.Name.Suggestion)),
                ("Contact e-mail", Text(data.Contact.EmailAddress.Fact) ?? Text(data.Contact.EmailAddress.Confirmed), Text(data.Contact.EmailAddress.Suggestion)),
                ("Contact phone", Text(data.Contact.PhoneNumber.Fact) ?? Text(data.Contact.PhoneNumber.Confirmed), Text(data.Contact.PhoneNumber.Suggestion)),
                ("Instruction date", Text(data.Instruction.InstructionDate.Fact) ?? Text(data.Instruction.InstructionDate.Confirmed), Text(data.Instruction.InstructionDate.Suggestion)),
                ("VAT status", Text(data.Instruction.VatStatus.Fact) ?? Text(data.Instruction.VatStatus.Confirmed), Text(data.Instruction.VatStatus.Suggestion)),
                ("Inspection date", Text(data.Inspection.InspectionDate.Fact) ?? Text(data.Inspection.InspectionDate.Confirmed), Text(data.Inspection.InspectionDate.Suggestion)),
                ("Inspection deadline", Text(data.Inspection.Deadline.Fact) ?? Text(data.Inspection.Deadline.Confirmed), Text(data.Inspection.Deadline.Suggestion)),
                ("Inspection address", Text(data.Inspection.Address.Fact) ?? Text(data.Inspection.Address.Confirmed), Text(data.Inspection.Address.Suggestion)),
                ("Inspection mode", ModeText(data.Inspection.Mode.Fact) ?? ModeText(data.Inspection.Mode.Confirmed), ModeText(data.Inspection.Mode.Suggestion))
            };
            var populated = rows.Where(row => row.Accepted is not null || row.Suggested is not null).ToArray();
        }

        @if (populated.Length == 0)
        {
            <p class="empty-state">No case detail has been recorded yet.</p>
        }
        else
        {
            @foreach (var row in populated)
            {
                <div class="datarow">
                    <span class="datarow__field">@row.Field</span>
                    @if (row.Accepted is { } accepted)
                    {
                        <span class="datarow__value">@accepted.Value</span>
                    }
                    else
                    {
                        <span class="datarow__value quiet">Not recorded</span>
                    }
                    @if (row.Suggested is { } suggested && row.Accepted is null)
                    {
                        <span class="datarow__sug">Suggested @suggested.Value</span>
                    }
                    <span class="datarow__end">
                        <partial name="Shared/_Provenance" model="@((row.Accepted ?? row.Suggested)!.Source)" />
                    </span>
                </div>
            }
        }

        @if (!string.IsNullOrWhiteSpace(leaseToken) && workflow.Archive is null)
        {
            <form method="post" asp-page-handler="Save" class="form-grid">
                <input type="hidden" name="id" value="@workflow.CaseId" />
                <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                <input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" />
                <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                <label>Claimant<input name="claimantName" maxlength="300" value="@data.Claimant.Name.Confirmed?.Value" /></label>
                <label>Claim number<input name="claimNumber" maxlength="200" value="@data.Claim.Number.Confirmed?.Value" /></label>
                <label>Registration<input name="vehicleRegistration" maxlength="20" value="@data.Vehicle.Registration.Confirmed?.Value" /></label>
                <label>Vehicle make<input name="vehicleMake" maxlength="100" value="@data.Vehicle.Make.Confirmed?.Value" /></label>
                <label>Vehicle model<input name="vehicleModel" maxlength="100" value="@data.Vehicle.Model.Confirmed?.Value" /></label>
                <label>Mileage<input type="number" min="0" name="vehicleMileage" value="@data.Vehicle.Mileage.Confirmed?.Value" /></label>
                <label>Mileage unit<input name="vehicleMileageUnit" maxlength="20" value="@data.Vehicle.MileageUnit.Confirmed?.Value" /></label>
                <label>Incident date<input type="date" name="incidentDate" value="@data.Accident.IncidentDate.Confirmed?.Value.ToString("yyyy-MM-dd")" /></label>
                <label>Contact name<input name="contactName" maxlength="300" value="@data.Contact.Name.Confirmed?.Value" /></label>
                <label>Contact email<input type="email" name="contactEmailAddress" maxlength="320" value="@data.Contact.EmailAddress.Confirmed?.Value" /></label>
                <label>Contact phone<input name="contactPhoneNumber" maxlength="100" value="@data.Contact.PhoneNumber.Confirmed?.Value" /></label>
                <label>Instruction date<input type="date" name="instructionDate" value="@data.Instruction.InstructionDate.Confirmed?.Value.ToString("yyyy-MM-dd")" /></label>
                <label>VAT status<input name="vatStatus" maxlength="100" value="@data.Instruction.VatStatus.Confirmed?.Value" /></label>
                <label>Inspection date<input type="date" name="inspectionDate" value="@data.Inspection.InspectionDate.Confirmed?.Value.ToString("yyyy-MM-dd")" /></label>
                <label>Inspection deadline<input type="date" name="inspectionDeadline" value="@data.Inspection.Deadline.Confirmed?.Value.ToString("yyyy-MM-dd")" /></label>
                <label>Inspection address<input name="inspectionAddress" maxlength="1000" value="@data.Inspection.Address.Confirmed?.Value" /></label>
                <label>Inspection mode
                    <select name="inspectionMode">
                        @if (data.Inspection.Mode.Confirmed is null)
                        {
                            <option value="" selected>Not recorded</option>
                        }
                        else
                        {
                            <option value="">Not recorded</option>
                        }
                        @if (data.Inspection.Mode.Confirmed?.Value == CaseInspectionMode.PhysicalAddress)
                        {
                            <option value="PhysicalAddress" selected>Physical address</option>
                        }
                        else
                        {
                            <option value="PhysicalAddress">Physical address</option>
                        }
                        @if (data.Inspection.Mode.Confirmed?.Value == CaseInspectionMode.ImageBasedAssessment)
                        {
                            <option value="ImageBasedAssessment" selected>Image Based Assessment</option>
                        }
                        else
                        {
                            <option value="ImageBasedAssessment">Image Based Assessment</option>
                        }
                    </select>
                </label>
                <label class="field-wide">Accident circumstances<textarea name="accidentCircumstances" maxlength="2000">@data.Accident.Circumstances.Confirmed?.Value</textarea></label>
                <label class="field-wide">Reason<input name="reason" required maxlength="500" /></label>
                <button type="submit" class="primary-action">Save case data</button>
            </form>

            <form method="post" asp-page-handler="ConfirmCompleteness" class="form-grid">
                <input type="hidden" name="id" value="@workflow.CaseId" />
                <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                <input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" />
                <input type="hidden" name="editLeaseToken" value="@leaseToken" />
@* Each checkbox carries a trailing hidden false so an unchecked box still submits its value: the
   binder takes the first entry, and a refused save can show what the editor actually proposed. *@
                <label><input type="checkbox" name="instructionComplete" value="true" checked="@data.Completeness.Values.InstructionComplete" /> Instructions complete</label><input type="hidden" name="instructionComplete" value="false" />
                <label><input type="checkbox" name="imagesComplete" value="true" checked="@data.Completeness.Values.ImagesComplete" /> Images complete</label><input type="hidden" name="imagesComplete" value="false" />
                <label><input type="checkbox" name="instructionConfirmedByStaff" value="true" checked="@data.Completeness.Values.InstructionConfirmedByStaff" /> Instructions staff-reviewed</label><input type="hidden" name="instructionConfirmedByStaff" value="false" />
                <label><input type="checkbox" name="imagesConfirmedByStaff" value="true" checked="@data.Completeness.Values.ImagesConfirmedByStaff" /> Images staff-reviewed</label><input type="hidden" name="imagesConfirmedByStaff" value="false" />
                <label class="field-wide">Reason<input name="reason" required maxlength="500" /></label>
                <button type="submit" class="primary-action">Confirm completeness</button>
            </form>
        }
    </section>
}

@if (mayEdit)
{
<section class="panel form-panel" aria-labelledby="case-workflow-title">
    <h2 id="case-workflow-title" class="section-label">Lifecycle actions</h2>
    <div class="form-grid">
            <form method="post" asp-page="/Cases/Workflow" asp-route-id="@workflow.CaseId" asp-page-handler="Hold">
                <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Hold case</button>
            </form>
            <form method="post" asp-page="/Cases/Workflow" asp-route-id="@workflow.CaseId" asp-page-handler="ReleaseHold">
                <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Release hold</button>
            </form>
            <form method="post" asp-page="/Cases/Workflow" asp-route-id="@workflow.CaseId" asp-page-handler="StartWork">
                <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Transition to report preparation</button>
            </form>
            <form method="post" asp-page="/Cases/Workflow" asp-route-id="@workflow.CaseId" asp-page-handler="ReturnToReview">
                <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                <label><input type="checkbox" name="instructionsComplete" value="true" checked="@data?.Completeness.Values.InstructionComplete" /> Instructions complete</label><input type="hidden" name="instructionsComplete" value="false" /><label><input type="checkbox" name="imagesComplete" value="true" checked="@data?.Completeness.Values.ImagesComplete" /> Images complete</label><input type="hidden" name="imagesComplete" value="false" /><label><input type="checkbox" name="instructionsReviewedByStaff" value="true" checked="@data?.Completeness.Values.InstructionConfirmedByStaff" /> Instructions staff-reviewed</label><input type="hidden" name="instructionsReviewedByStaff" value="false" /><label><input type="checkbox" name="imagesReviewedByStaff" value="true" checked="@data?.Completeness.Values.ImagesConfirmedByStaff" /> Images staff-reviewed</label><input type="hidden" name="imagesReviewedByStaff" value="false" /><label>Evidence reference<input name="evidenceReference" required maxlength="500" value="case-completeness-projection" /></label>
                <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Transition to Review</button>
            </form>
            <form method="post" asp-page="/Cases/Closure" asp-route-id="@workflow.CaseId" asp-page-handler="Close">
                <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                <label>Outcome<select name="outcome"><option value="PostReportComplete">Post-report complete</option><option value="ProviderCancelled">Provider cancelled</option><option value="CollisionEngineersRejected">Collision Engineers rejected</option></select></label>
                <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Close case</button>
            </form>
            <form method="post" asp-page="/Cases/Closure" asp-route-id="@workflow.CaseId" asp-page-handler="Reopen">
                <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                <label><input type="checkbox" name="instructionsComplete" value="true" checked="@data?.Completeness.Values.InstructionComplete" /> Instructions complete</label><input type="hidden" name="instructionsComplete" value="false" /><label><input type="checkbox" name="imagesComplete" value="true" checked="@data?.Completeness.Values.ImagesComplete" /> Images complete</label><input type="hidden" name="imagesComplete" value="false" /><label><input type="checkbox" name="instructionsReviewedByStaff" value="true" checked="@data?.Completeness.Values.InstructionConfirmedByStaff" /> Instructions staff-reviewed</label><input type="hidden" name="instructionsReviewedByStaff" value="false" /><label><input type="checkbox" name="imagesReviewedByStaff" value="true" checked="@data?.Completeness.Values.ImagesConfirmedByStaff" /> Images staff-reviewed</label><input type="hidden" name="imagesReviewedByStaff" value="false" /><label>Evidence reference<input name="evidenceReference" maxlength="500" value="case-completeness-projection" /></label>
                <label>Destination<select name="destination"><option value="NotReady">Not ready</option><option value="Review">Review</option><option value="ReportPreparation">Report preparation</option><option value="PostReport">Post report</option></select></label>
                <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Reopen case</button>
            </form>
            <form method="post" asp-page="/Cases/Closure" asp-route-id="@workflow.CaseId" asp-page-handler="Archive">
                <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Archive terminal case</button>
            </form>
            <form method="post" asp-page="/Cases/Workflow" asp-route-id="@workflow.CaseId" asp-page-handler="CreateLinkedReplacement">
                <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                <label>Replacement principal code<input name="replacementPrincipalCode" required maxlength="100" /></label><label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Create linked replacement</button>
            </form>
            <form method="post" asp-page="/Cases/Workflow" asp-route-id="@workflow.CaseId" asp-page-handler="AssignEngineer">
                <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                <label>Engineer ID<input type="text" name="engineerId" required /></label><label><input type="checkbox" name="instructionsComplete" value="true" checked="@data?.Completeness.Values.InstructionComplete" /> Instructions complete</label><input type="hidden" name="instructionsComplete" value="false" /><label><input type="checkbox" name="imagesComplete" value="true" checked="@data?.Completeness.Values.ImagesComplete" /> Images complete</label><input type="hidden" name="imagesComplete" value="false" /><label><input type="checkbox" name="instructionsReviewedByStaff" value="true" checked="@data?.Completeness.Values.InstructionConfirmedByStaff" /> Instructions staff-reviewed</label><input type="hidden" name="instructionsReviewedByStaff" value="false" /><label><input type="checkbox" name="imagesReviewedByStaff" value="true" checked="@data?.Completeness.Values.ImagesConfirmedByStaff" /> Images staff-reviewed</label><input type="hidden" name="imagesReviewedByStaff" value="false" /><label>Evidence reference<input name="evidenceReference" required maxlength="500" value="case-completeness-projection" /></label><label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Assign Engineer</button>
            </form>
            <form method="post" asp-page="/Cases/Workflow" asp-route-id="@workflow.CaseId" asp-page-handler="RecordEngineerFinding">
                <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                <label>Assessment<select name="assessment"><option value="Repairable">Repairable</option><option value="TotalLoss">Total loss</option></select></label><label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Record Engineer finding</button>
            </form>
    </div>
</section>
}

@if (workflow.ReportApproval is not null
    || (mayEdit && workflow.State == CaseLifecycleState.ReportPreparation))
{
<section class="panel form-panel" aria-labelledby="case-report-approval-title">
    <h2 id="case-report-approval-title" class="section-label">Report approval</h2>
    @if (workflow.ReportApproval is { } approval)
    {
        <p>Report <strong>@approval.ArtifactIdentity</strong> was approved at @OperatorLabels.OfficeTime(approval.ApprovedAtUtc); this does not confirm the report was sent.</p>
    }
    else if (mayEdit && workflow.State == CaseLifecycleState.ReportPreparation)
    {
        <form method="post" asp-page="/Cases/Closure" asp-route-id="@workflow.CaseId" asp-page-handler="RecordReportApproval" class="form-grid">
            <input type="hidden" name="id" value="@workflow.CaseId" />
            <input type="hidden" name="expectedVersion" value="@workflow.Version" />
            <input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" />
            <input type="hidden" name="editLeaseToken" value="@leaseToken" />
            <input type="hidden" name="approvalId" value="@Model.ReportApprovalId" />
            <label>Report identity<input name="artifactIdentity" required maxlength="200" /></label>
            <label>Report SHA-256<input name="artifactSha256" required minlength="64" maxlength="64" pattern="[0-9A-Fa-f]{64}" /></label>
            <label class="field-wide">Reason<input name="reason" required maxlength="500" /></label>
            <button type="submit" class="primary-action">Approve report</button>
        </form>
    }
</section>
}

@if (details.AvailableReportSentEvidence.Count > 0
    || (workflow.ReportSentEvidence is not null && mayEdit && workflow.State is not CaseLifecycleState.Held && !CaseLifecycleRules.IsTerminal(workflow.State)))
{
<section class="panel form-panel" aria-labelledby="case-report-evidence-title">
    <h2 id="case-report-evidence-title" class="section-label">Report-Sent evidence</h2>
    @if (details.AvailableReportSentEvidence.Count > 0)
    {
        <ul>
        @foreach (var evidence in details.AvailableReportSentEvidence)
        {
            <li>
                <strong>@OperatorLabels.OfficeTime(evidence.SentAtUtc)</strong> — @evidence.MailboxIdentity / @evidence.ImmutableItemIdentity
                @if (mayEdit && workflow.State == CaseLifecycleState.ReportPreparation)
                {
                    <form method="post" asp-page="/Cases/Tasks" asp-route-id="@workflow.CaseId" asp-page-handler="LinkReportEvidence">
                        <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="evidenceId" value="@evidence.EvidenceId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                        <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Link exact evidence</button>
                    </form>
                }
            </li>
        }
        </ul>
    }
    @if (workflow.ReportSentEvidence is { } linkedEvidence && mayEdit && workflow.State is not CaseLifecycleState.Held && !CaseLifecycleRules.IsTerminal(workflow.State))
    {
        <form method="post" asp-page="/Cases/Tasks" asp-route-id="@workflow.CaseId" asp-page-handler="UnlinkReportEvidence">
            <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="evidenceId" value="@linkedEvidence.EvidenceId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
            <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Unlink current evidence</button>
        </form>
    }
</section>
}

@if (details.Tasks.Count > 0 || (!string.IsNullOrWhiteSpace(leaseToken) && workflow.Archive is null))
{
<section class="panel form-panel" aria-labelledby="case-tasks-title">
    <h2 id="case-tasks-title" class="section-label">Case tasks</h2>
    @if (details.Tasks.Count > 0)
    {
        <ul>
        @foreach (var task in details.Tasks)
        {
            <li>
                <strong>@task.Description</strong> — @OperatorLabels.Humanise(task.State.ToString()) — assignee @(task.AssigneeId?.ToString("D") ?? "unassigned")
                @if (!string.IsNullOrWhiteSpace(leaseToken) && workflow.Archive is null && task.State == CaseTaskState.Open)
                {
                    <form method="post" asp-page="/Cases/Tasks" asp-route-id="@workflow.CaseId" asp-page-handler="AssignTask">
                        <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="taskId" value="@task.Id" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="expectedTaskVersion" value="@task.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                        <label>Assignee ID<input type="text" name="assigneeId" /></label><label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Assign task</button>
                    </form>
                    <form method="post" asp-page="/Cases/Tasks" asp-route-id="@workflow.CaseId" asp-page-handler="CompleteTask">
                        <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="taskId" value="@task.Id" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="expectedTaskVersion" value="@task.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                        <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Complete task</button>
                    </form>
                    <form method="post" asp-page="/Cases/Tasks" asp-route-id="@workflow.CaseId" asp-page-handler="CancelTask">
                        <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="taskId" value="@task.Id" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="expectedTaskVersion" value="@task.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                        <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Cancel task</button>
                    </form>
                }
            </li>
        }
        </ul>
    }
    @if (!string.IsNullOrWhiteSpace(leaseToken) && workflow.Archive is null)
    {
        <form method="post" asp-page="/Cases/Tasks" asp-route-id="@workflow.CaseId" asp-page-handler="CreateTask" class="form-grid">
            <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="taskId" value="@Guid.NewGuid()" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
            <label>Description<input name="description" required maxlength="1000" /></label><label>Assignee ID<input type="text" name="assigneeId" /></label><label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="primary-action">Create task</button>
        </form>
    }
</section>
}

@if (details.LatestChaser is { } chaser)
{
    <section class="panel" aria-labelledby="case-chaser-title">
        <h2 id="case-chaser-title" class="section-label">Latest generated chase draft</h2>
        <dl><dt>Generated</dt><dd>@OperatorLabels.OfficeTime(chaser.GeneratedAtUtc)</dd><dt>Next chase</dt><dd>@OperatorLabels.OfficeTime(chaser.NextChaseAtUtc)</dd></dl>
        <pre>@chaser.CopyableText</pre>
        <p>Copyable text only; nothing has been sent.</p>
    </section>
}

@if (workflow.DueWork is { State: CaseDueWorkState.Scheduled } && mayEdit)
{
    <section class="panel form-panel" aria-labelledby="case-manual-chase-title">
        <h2 id="case-manual-chase-title" class="section-label">Record manual chase</h2>
        <p>Recording an attempt updates the chase schedule; nothing is sent.</p>
        <form method="post" asp-page="/Cases/Tasks" asp-route-id="@workflow.CaseId" asp-page-handler="RecordManualChase" class="form-grid">
            <input type="hidden" name="id" value="@workflow.CaseId" />
            <input type="hidden" name="expectedVersion" value="@workflow.Version" />
            <input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" />
            <input type="hidden" name="attemptedAtUtc" value="@Model.ManualChaseAttemptedAtUtc.ToString("O")" />
            <input type="hidden" name="editLeaseToken" value="@leaseToken" />
            <label>Channel<input name="channel" required maxlength="100" /></label>
            <label>Target party or address<input name="targetPartyOrAddress" required maxlength="500" /></label>
            <label>Outcome<input name="outcome" required maxlength="500" /></label>
            <label>Note<textarea name="note" maxlength="1000"></textarea></label>
            <label class="field-wide">Reason<input name="reason" required maxlength="500" /></label>
            <button type="submit" class="primary-action">Record chase attempt</button>
        </form>
    </section>
}

@if (details.VehicleEvidence is not null || mayEdit)
{
<section class="panel form-panel" aria-labelledby="case-vehicle-evidence-title">
    <h2 id="case-vehicle-evidence-title" class="section-label">Vehicle evidence</h2>
    @if (details.VehicleEvidence is { } vehicleEvidence)
    {
        @if (vehicleEvidence.Confirmed is { } confirmed)
        {
            var confirmedMileageClass = data?.Vehicle.Mileage.Confirmed is { } confirmedMileage
                ? $" — {OperatorLabels.MileageEvidence(VehicleMileageEvidenceClassification.Classify(confirmedMileage.Source.Kind))}"
                : string.Empty;
            <dl>
                <dt>Confirmed registration</dt><dd>@confirmed.Registration.Value — @confirmed.Registration.SourceLabel</dd>
                <dt>Confirmed make</dt><dd>@(confirmed.Make?.Value ?? "Not confirmed")</dd>
                <dt>Confirmed model</dt><dd>@(confirmed.Model?.Value ?? "Not confirmed")</dd>
                <dt>Confirmed mileage</dt><dd>@(confirmed.Mileage is null
                    ? "Not confirmed"
                    : $"{confirmed.Mileage.Value:N0} {confirmed.MileageUnit?.Value}{confirmedMileageClass}")</dd>
            </dl>
        }
        @if (vehicleEvidence.LatestObservation is { } observation)
        {
            <dl>
                <dt>Registration</dt><dd>@observation.Registration</dd>
                <dt>Retrieved</dt><dd>@OperatorLabels.OfficeTime(observation.Provenance.RetrievedAtUtc)</dd>
                @if (observation.Vehicle is { } vehicleDetails)
                {
                    <dt>Make</dt><dd>@(vehicleDetails.Make ?? "—")</dd>
                    <dt>Model</dt><dd>@(vehicleDetails.Model ?? "—")</dd>
                    <dt>Manufacture year</dt><dd>@(vehicleDetails.ManufactureYear?.ToString() ?? "—")</dd>
                    <dt>Engine capacity</dt><dd>@(vehicleDetails.EngineCapacityCc is { } engineCapacityCc ? $"{engineCapacityCc:N0} cc" : "—")</dd>
                    <dt>Fuel type</dt><dd>@(vehicleDetails.FuelType ?? "—")</dd>
                }
                @if (observation.Mileage is { } estimatedMileage)
                {
                    <dt>Mileage</dt><dd>@($"{estimatedMileage.Value:N0} {OperatorLabels.MileageUnit(estimatedMileage.Unit)} — {OperatorLabels.MileageEvidence(VehicleMileageEvidenceClass.Estimated)}") (@estimatedMileage.ObservedOn.ToString("d MMM yyyy"))</dd>
                }
            </dl>
            @if (mayEdit)
            {
                <form method="post" asp-page="/Cases/Vehicle" asp-route-id="@workflow.CaseId" asp-page-handler="AcceptVehicleSuggestion" class="form-grid">
                    <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="lookupObservationId" value="@observation.Id" /><input type="hidden" name="decision" value="Accept" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                    <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="primary-action">Accept vehicle suggestion</button>
                </form>
                <form method="post" asp-page="/Cases/Vehicle" asp-route-id="@workflow.CaseId" asp-page-handler="AcceptVehicleSuggestion" class="form-grid">
                    <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="lookupObservationId" value="@observation.Id" /><input type="hidden" name="decision" value="Correct" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                    <label>Registration<input name="registration" required maxlength="20" value="@observation.Registration" /></label><label>Make<input name="make" maxlength="100" value="@observation.Vehicle?.Make" /></label><label>Model<input name="model" maxlength="100" value="@observation.Vehicle?.Model" /></label><label>Mileage<input type="number" min="0" name="mileage" value="@observation.Mileage?.Value" /></label><label>Mileage unit<input name="mileageUnit" maxlength="20" value="@observation.Mileage?.Unit" /></label><label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Confirm corrected vehicle values</button>
                </form>
            }
        }
    }
    @if (mayEdit)
    {
        <form method="post" asp-page="/Cases/Vehicle" asp-route-id="@workflow.CaseId" asp-page-handler="RequestVehicleLookup" class="form-grid">
            <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
            <label>Registration<input name="registration" required maxlength="20" value="@(details.VehicleEvidence?.Confirmed?.Registration.Value ?? data?.Vehicle.Registration.Fact?.Value)" /></label><button type="submit" class="primary-action">Request vehicle lookup</button>
        </form>
    }
</section>
}

@if (details.Custody.Count > 0)
{
<section class="panel form-panel" aria-labelledby="case-custody-title">
    <h2 id="case-custody-title" class="section-label">Case custody</h2>
    @{
        <ul class="action-list">
        @foreach (var custody in details.Custody)
        {
            <li>
                <strong>@(custody.TargetKind == CustodyTargetKind.CaseSource ? "Case evidence" : "Audit reference")</strong>
                — @OperatorLabels.Humanise(custody.State.ToString())
                @if (!string.IsNullOrWhiteSpace(custody.SafeFailureReason))
                {
                    <span>— @custody.SafeFailureReason</span>
                }
                @if (mayEdit && custody.CanRetry)
                {
                    <form method="post" asp-page="/Cases/Custody" asp-route-id="@workflow.CaseId" asp-page-handler="RetryCustody" class="form-grid">
                        <input type="hidden" name="id" value="@workflow.CaseId" />
                        <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                        <input type="hidden" name="targetKind" value="@custody.TargetKind" />
                        <input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" />
                        <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                        <label>Reason<input name="reason" required maxlength="500" /></label>
                        <button type="submit" class="secondary-action">Retry custody</button>
                    </form>
                }
            </li>
        }
        </ul>
    }
</section>
}

@if (details.EvaHandoff is { IsWorthShowing: true } eva && (eva.Revisions.Count > 0 || mayEdit))
{
<section class="panel form-panel" aria-labelledby="case-eva-title">
    <h2 id="case-eva-title" class="section-label">EVA handoff</h2>
    @if (eva.Revisions.Count > 0)
    {
        <ul class="action-list">
        @foreach (var revision in eva.Revisions)
        {
            <li>
                <strong>@revision.FileName</strong>
                <small>Generated @OperatorLabels.OfficeTime(revision.GeneratedAtUtc) · integrity verified</small>
                @if (mayEdit)
                {
                    <form method="post" asp-page="/Cases/Eva/Download" asp-route-id="@workflow.CaseId" class="form-grid">
                        <input type="hidden" name="id" value="@workflow.CaseId" />
                        <input type="hidden" name="revision" value="@revision.Revision" />
                        <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                        <input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" />
                        <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                        <label>Reason<input name="reason" required maxlength="500" /></label>
                        <button type="submit" class="secondary-action">Download handoff</button>
                    </form>
                }
            </li>
        }
        </ul>
    }
    @if (mayEdit && eva.CanGenerate)
    {
        <form method="post" asp-page="/Cases/Vehicle" asp-route-id="@workflow.CaseId" asp-page-handler="GenerateEvaHandoff" class="form-grid">
            <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
            <label class="field-wide">Reason<input name="reason" required maxlength="300" /></label><button type="submit" class="primary-action">Generate EVA handoff</button>
        </form>
    }
    else if (mayEdit && eva.BlockingReasons.Count > 0)
    {
        <details class="readiness-summary" data-hover-disclosure>
            <summary>
                <span class="status-chip status-chip--amber">
                    <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                    <span>@Pegasus.Web.Pages.Cases.Assessment.IndexModel.IssueSummaryText(eva.BlockingReasons.Count)</span>
                </span>
            </summary>
            <ul class="blocker-list">@foreach (var blockingReason in eva.BlockingReasons){<li>@blockingReason</li>}</ul>
        </details>
    }
</section>
}
