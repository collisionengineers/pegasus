@model Pegasus.Web.Pages.Cases.DetailsModel
@using System.Globalization
@using Pegasus.Core.Cases
@using Pegasus.Core.Lifecycle
@using Pegasus.Core.Workflow
@using Pegasus.Web.Pages
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var data = details.Data;
    var leaseToken = Model.LeaseToken;
    var mayEdit = !string.IsNullOrWhiteSpace(leaseToken) && workflow.Archive is null;
    var state = workflow.State;
    var requirements = Model.OutstandingRequirements;

    // The stepper speaks the display vocabulary (D3): Report preparation and
    // Post report both read "With Engineer", Post-report complete reads
    // "Complete". Core's states are untouched.
    var stage = state switch
    {
        CaseLifecycleState.Review => 1,
        CaseLifecycleState.ReportPreparation or CaseLifecycleState.PostReport => 2,
        CaseLifecycleState.PostReportComplete => 3,
        _ => 0
    };
    (string Label, string Icon)[] steps =
    [
        ("Not ready", "icon-alert-circle"),
        ("Review", "icon-eye"),
        ("With Engineer", "icon-user"),
        ("Complete", "icon-check")
    ];
}

<div class="stack">
    @* A refused save (stale version) is a non-destructive conflict: the
       proposed values are retained beside what the case now holds, with no
       way to apply or force them — re-entering edit mode is the only path. *@
    @if (Model.ProposedValuesWereDropped)
    {
        <section class="panel" aria-labelledby="case-proposed-values-title">
            <div class="panel-head"><h2 id="case-proposed-values-title">Your change was not applied</h2></div>
            <div class="panel-body">
                <div class="notice notice--warning">
                    <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                    <span>The values you submitted were too large to keep and are not shown here; enter edit mode again and re-enter them.</span>
                </div>
            </div>
        </section>
    }
    else if (Model.ProposedValues.Count > 0)
    {
        <section class="panel" aria-labelledby="case-proposed-values-title">
            <div class="panel-head"><h2 id="case-proposed-values-title">Your change was not applied</h2></div>
            <div class="panel-body stack">
                @if (Model.ProposedValuesWereShortened)
                {
                    <div class="notice notice--warning">
                        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                        <span>Some values were too long to keep in full and are shown shortened; re-enter those in full.</span>
                    </div>
                }
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Field</th><th>You proposed</th><th>The case now holds</th></tr></thead>
                        <tbody>
                            @foreach (var proposed in Model.ProposedValues)
                            {
                                <tr>
                                    <th>@proposed.Label</th>
                                    <td>@proposed.Proposed</td>
                                    <td>@(string.IsNullOrWhiteSpace(proposed.Current) ? "—" : proposed.Current)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }

    <ol class="workflow-stepper" aria-label="Case workflow">
        @for (var index = 0; index < steps.Length; index++)
        {
            var current = index == stage;
            var complete = index < stage;
            <li class="workflow-step @(complete ? "is-complete" : null) @(current ? "is-current" : null)">
                <span class="workflow-step-icon">
                    <svg class="icon" aria-hidden="true"><use href="#@(complete ? "icon-check" : steps[index].Icon)" /></svg>
                </span>
                <span>@steps[index].Label</span>
            </li>
        }
    </ol>
    @if (state == CaseLifecycleState.Held)
    {
        <div class="workflow-exception">
            <svg class="icon" aria-hidden="true"><use href="#icon-pause" /></svg>
            <strong>Held</strong>
        </div>
    }

    @if (requirements.Count > 0)
    {
        <section class="panel" aria-labelledby="case-requirements-title">
            <div class="panel-head">
                <h2 id="case-requirements-title">Outstanding requirements</h2>
                <partial name="Shared/_StatusChip" view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = "amber" }' model="@(requirements.Count.ToString(CultureInfo.InvariantCulture) + " outstanding")" />
            </div>
            <div class="panel-body">
                <ul class="blocker-list">
                    @foreach (var requirement in requirements)
                    {
                        <li class="blocker">
                            <strong>@requirement.Title</strong>
                            <small>
                                <b>Source:</b> @requirement.Source
                                @if (!string.IsNullOrWhiteSpace(requirement.Why))
                                {
                                    <br /><b>Why:</b> @requirement.Why
                                }
                                <br /><b>Resolve:</b> Confirm completeness
                            </small>
                        </li>
                    }
                </ul>
                @if (mayEdit && data is not null)
                {
                    <form method="post" asp-page="/Cases/Details" asp-page-handler="ConfirmCompleteness"
                          asp-route-id="@workflow.CaseId" class="stack blocker-actions">
                        <input type="hidden" name="id" value="@workflow.CaseId" />
                        <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                        <input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" />
                        <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                        <div class="grid grid-2">
                            @* Each checkbox carries a trailing hidden false so an unchecked box still submits its value. *@
                            <label class="choice"><input type="checkbox" name="instructionComplete" value="true" checked="@data.Completeness.Values.InstructionComplete" /> Instructions complete</label><input type="hidden" name="instructionComplete" value="false" />
                            <label class="choice"><input type="checkbox" name="imagesComplete" value="true" checked="@data.Completeness.Values.ImagesComplete" /> Images complete</label><input type="hidden" name="imagesComplete" value="false" />
                            <input type="hidden" name="instructionConfirmedByStaff" value="@data.Completeness.Values.InstructionConfirmedByStaff" />
                            <input type="hidden" name="imagesConfirmedByStaff" value="@data.Completeness.Values.ImagesConfirmedByStaff" />
                            <div class="field"><label class="req" for="completeness-reason">Reason</label><input id="completeness-reason" name="reason" required maxlength="500" /></div>
                        </div>
                        <div class="button-row">
                            <button type="submit" class="btn btn--primary">Confirm completeness</button>
                        </div>
                    </form>
                }
            </div>
        </section>
    }

    @if (data is not null && mayEdit)
    {
        <section class="panel" aria-labelledby="case-edit-title">
            <div class="panel-head"><h2 id="case-edit-title">Edit Case data</h2></div>
            <div class="panel-body stack">
                @* The save overwrites every editable value, so the fields the
                   drawn editor does not carry post back unchanged beside the
                   six the operator edits. *@
                <form method="post" asp-page="/Cases/Details" asp-page-handler="Save"
                      asp-route-id="@workflow.CaseId" id="case-edit-form" data-edit-save class="stack">
                    <input type="hidden" name="id" value="@workflow.CaseId" />
                    <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                    <input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" />
                    <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                    @* CASE-027: the claimant's own contact number and address
                       are editable values too, and SaveCase writes every one of
                       the twenty — an omitted value is written as null and
                       clears the confirmed field, so leaving these two out of
                       the form silently discarded them on every save. *@
                    <input type="hidden" name="claimantContactNumber" value="@data.Claimant.ContactNumber.Confirmed?.Value" />
                    <input type="hidden" name="claimantAddress" value="@data.Claimant.Address.Confirmed?.Value" />
                    <input type="hidden" name="vehicleMileage" value="@data.Vehicle.Mileage.Confirmed?.Value" />
                    <input type="hidden" name="vehicleMileageUnit" value="@data.Vehicle.MileageUnit.Confirmed?.Value" />
                    <input type="hidden" name="incidentDate" value="@data.Accident.IncidentDate.Confirmed?.Value.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="contactName" value="@data.Contact.Name.Confirmed?.Value" />
                    <input type="hidden" name="contactEmailAddress" value="@data.Contact.EmailAddress.Confirmed?.Value" />
                    <input type="hidden" name="contactPhoneNumber" value="@data.Contact.PhoneNumber.Confirmed?.Value" />
                    <input type="hidden" name="instructionDate" value="@data.Instruction.InstructionDate.Confirmed?.Value.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="vatStatus" value="@data.Instruction.VatStatus.Confirmed?.Value" />
                    <input type="hidden" name="inspectionDate" value="@data.Inspection.InspectionDate.Confirmed?.Value.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="inspectionDeadline" value="@data.Inspection.Deadline.Confirmed?.Value.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="inspectionAddress" value="@data.Inspection.Address.Confirmed?.Value" />
                    <input type="hidden" name="inspectionMode" value="@data.Inspection.Mode.Confirmed?.Value" />
                    <div class="grid grid-2">
                        <div class="field"><label for="edit-claimant">Claimant</label><input id="edit-claimant" name="claimantName" maxlength="300" value="@data.Claimant.Name.Confirmed?.Value" /></div>
                        <div class="field"><label for="edit-provider-reference">Provider reference</label><input id="edit-provider-reference" name="claimNumber" maxlength="200" value="@data.Claim.Number.Confirmed?.Value" /></div>
                        <div class="field"><label for="edit-registration">Registration</label><input id="edit-registration" name="vehicleRegistration" maxlength="20" value="@data.Vehicle.Registration.Confirmed?.Value" /></div>
                        <div class="field"><label for="edit-make">Make</label><input id="edit-make" name="vehicleMake" maxlength="100" value="@data.Vehicle.Make.Confirmed?.Value" /></div>
                        <div class="field"><label for="edit-model">Model</label><input id="edit-model" name="vehicleModel" maxlength="100" value="@data.Vehicle.Model.Confirmed?.Value" /></div>
                        <div class="field"><label class="req" for="edit-reason">Reason</label><input id="edit-reason" name="reason" required maxlength="500" /></div>
                    </div>
                    <div class="field">
                        <label for="edit-circumstances">Accident circumstances</label>
                        <textarea id="edit-circumstances" name="accidentCircumstances" maxlength="2000" rows="4">@data.Accident.Circumstances.Confirmed?.Value</textarea>
                    </div>
                    @if (state == CaseLifecycleState.Review)
                    {
                        @* One consequence sentence, from the closed necessary-copy intent:
                           a save demotes the case to Not ready until completeness is
                           confirmed again. *@
                        <div class="notice notice--warning">
                            <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                            <span>Saving returns the case to Not ready.</span>
                        </div>
                    }
                    <div class="button-row">
                        <button type="submit" class="btn btn--primary">
                            <svg class="icon" aria-hidden="true"><use href="#icon-save" /></svg>
                            <span>Save case data</span>
                        </button>
                    </div>
                </form>
            </div>
        </section>
    }

    @* Undrawn in the prototype, but the only surface for three real Core
       paths: the Review → With Engineer transition, its return, and the
       correction of a wrongly linked report-Sent item. Archiving ends a
       terminal case's editability. Offered only in edit context, and only
       when one of them applies. *@
    @{
        var offersStartWork = mayEdit && state == CaseLifecycleState.Review;
        var offersReturnToReview = mayEdit
            && state is CaseLifecycleState.ReportPreparation or CaseLifecycleState.PostReport;
        var offersUnlinkEvidence = mayEdit
            && workflow.ReportSentEvidence is not null
            && state is not CaseLifecycleState.Held
            && !CaseLifecycleRules.IsTerminal(state);
        var offersArchive = mayEdit && CaseLifecycleRules.IsTerminal(state) && workflow.Archive is null;
        var offersLifecyclePanel = offersStartWork
            || offersReturnToReview
            || offersUnlinkEvidence
            || offersArchive;
    }
    @if (offersLifecyclePanel)
    {
        <section class="panel" aria-labelledby="case-lifecycle-title">
            <div class="panel-head"><h2 id="case-lifecycle-title">Lifecycle actions</h2></div>
            <div class="panel-body button-row">
                @if (offersStartWork)
                {
                    <button type="button" class="btn" data-dialog-open="case-start-work-dialog">
                        <svg class="icon" aria-hidden="true"><use href="#icon-play" /></svg>
                        <span>Start report preparation</span>
                    </button>
                }
                @if (offersReturnToReview)
                {
                    <button type="button" class="btn" data-dialog-open="case-return-review-dialog">
                        <svg class="icon" aria-hidden="true"><use href="#icon-reply" /></svg>
                        <span>Return to Review</span>
                    </button>
                }
                @if (offersUnlinkEvidence)
                {
                    <button type="button" class="btn" data-dialog-open="case-unlink-evidence-dialog">
                        <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                        <span>Unlink report evidence</span>
                    </button>
                }
                @if (offersArchive)
                {
                    <button type="button" class="btn" data-dialog-open="case-archive-dialog">
                        <svg class="icon" aria-hidden="true"><use href="#icon-archive" /></svg>
                        <span>Archive case</span>
                    </button>
                }
            </div>
        </section>
    }
</div>

@if (mayEdit)
{
    @if (state == CaseLifecycleState.Review)
    {
        <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["DialogId"] = "case-start-work-dialog",
            ["DialogTitle"] = "Start report preparation",
            ["DialogActionUrl"] = Url.Page("/Cases/Workflow", "StartWork", new { id = workflow.CaseId }),
            ["DialogHiddenFields"] = new Dictionary<string, string?>
            {
                ["id"] = workflow.CaseId.ToString(),
                ["expectedVersion"] = workflow.Version.ToString(CultureInfo.InvariantCulture),
                ["operationKey"] = CaseMutationPageModel.NewOperationKey(),
                ["editLeaseToken"] = leaseToken
            }
        })" />
    }
    @if (state is CaseLifecycleState.ReportPreparation or CaseLifecycleState.PostReport)
    {
        <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["DialogId"] = "case-return-review-dialog",
            ["DialogTitle"] = "Return to Review",
            ["DialogActionUrl"] = Url.Page("/Cases/Workflow", "ReturnToReview", new { id = workflow.CaseId }),
            ["DialogHiddenFields"] = new Dictionary<string, string?>
            {
                ["id"] = workflow.CaseId.ToString(),
                ["expectedVersion"] = workflow.Version.ToString(CultureInfo.InvariantCulture),
                ["operationKey"] = CaseMutationPageModel.NewOperationKey(),
                ["editLeaseToken"] = leaseToken,
                ["instructionsComplete"] = data?.Completeness.Values.InstructionComplete.ToString() ?? false.ToString(),
                ["imagesComplete"] = data?.Completeness.Values.ImagesComplete.ToString() ?? false.ToString(),
                ["evidenceReference"] = "case-completeness-projection"
            }
        })" />
    }
    @if (workflow.ReportSentEvidence is { } unlinked && state is not CaseLifecycleState.Held && !CaseLifecycleRules.IsTerminal(state))
    {
        <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["DialogId"] = "case-unlink-evidence-dialog",
            ["DialogTitle"] = "Unlink report evidence",
            ["DialogActionUrl"] = Url.Page("/Cases/Tasks", "UnlinkReportEvidence", new { id = workflow.CaseId }),
            ["DialogHiddenFields"] = new Dictionary<string, string?>
            {
                ["id"] = workflow.CaseId.ToString(),
                ["evidenceId"] = unlinked.EvidenceId.ToString(),
                ["expectedVersion"] = workflow.Version.ToString(CultureInfo.InvariantCulture),
                ["operationKey"] = CaseMutationPageModel.NewOperationKey(),
                ["editLeaseToken"] = leaseToken
            }
        })" />
    }
    @if (CaseLifecycleRules.IsTerminal(state) && workflow.Archive is null)
    {
        <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["DialogId"] = "case-archive-dialog",
            ["DialogTitle"] = "Archive case",
            ["DialogActionUrl"] = Url.Page("/Cases/Closure", "Archive", new { id = workflow.CaseId }),
            ["DialogHiddenFields"] = new Dictionary<string, string?>
            {
                ["id"] = workflow.CaseId.ToString(),
                ["expectedVersion"] = workflow.Version.ToString(CultureInfo.InvariantCulture),
                ["operationKey"] = CaseMutationPageModel.NewOperationKey(),
                ["editLeaseToken"] = leaseToken
            }
        })" />
    }
}
