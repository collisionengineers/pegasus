@model Pegasus.Web.Pages.Cases.NewMessageModel
@using Pegasus.Web.Presentation

@* The Case's e-mail dialogue on a new message (FRD-21; operator, 27 November
   2026; R1323, R1327): the dialogue the Inbox and the Case share (R1278), its
   id, frame and foot, holding the composer alone as a reply's does. Fetched by
   the dialogue's script into the Case page's mount after Close case. *@
<div id="mailMessageDialog" class="dialog-backdrop" data-dialog="mailMessageDialog" hidden>
    <section class="dialog dialog--mail" role="dialog" aria-modal="true" aria-labelledby="mailMessageDialog_title">
        <div class="dialog-head">
            <div class="mail-dialog-title">
                <h2 id="mailMessageDialog_title" class="wrap" tabindex="-1" data-dialog-initial-focus>@OperatorLabels.StaffMail.NewMessage</h2>
            </div>
            <span class="mail-dialog-tools">
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                </button>
            </span>
        </div>
        <div class="dialog-body">
            <partial name="Shared/_CaseNewMessageForm" model="Model" />
        </div>
        <div class="dialog-foot">
            <button type="button" class="btn" data-dialog-close>Cancel</button>
            @if (Model.OffersForm)
            {
                <button type="submit" form="mailComposerForm" class="btn btn--dark" data-busy-label="@OperatorLabels.Busy.Sending">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-send")" /></svg>
                    <span>Send</span>
                </button>
            }
        </div>
    </section>
</div>
