@using Pegasus.Core.Assessment
@using Pegasus.Web.Presentation
@using GlassLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.GlassSession
@using EstimateLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Estimate
@using EngineerLabels = Pegasus.Web.Presentation.OperatorLabels.CaseWorkspace.EngineerSections
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var caseId = Model.CurrentWorkflow!.CaseId;
    var glassSession = Model.GlassSession;
    var showGlassLine = glassSession is not null &&
        (GlassRepairEstimateSessionPolicy.OccupiesAccount(glassSession.State) || glassSession.State == GlassRepairEstimateSessionState.Failed);
    var tone = glassSession?.State switch
    {
        GlassRepairEstimateSessionState.Failed => "status--red",
        GlassRepairEstimateSessionState.Unknown or GlassRepairEstimateSessionState.AwaitingImport => "status--amber",
        _ => "status--blue"
    };
}
<div data-glass-controls="session" data-glass-id="@glassSession?.Id" data-glass-version="@glassSession?.Version"
     data-glass-state="@glassSession?.State" hidden="@(Model.GlassSessionElsewhere is null && !showGlassLine)">
    @* The Glass's session line: only while this staff member's session holds
       the account or has failed, or while the account is held from
       another Case (v26 § Glass's). *@
    @if (Model.GlassSessionElsewhere is { } elsewhere)
    {
        <div class="glass-session" data-glass-session="elsewhere" data-glass-elsewhere="@elsewhere.Session.CaseId">
            <span class="status status--blue">@GlassLabels.Launch session · @GlassLabels.StateLabel(elsewhere.Session.State)</span>
            <span class="muted grow">@EstimateLabels.HeldFromAnotherCase</span>
            <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@elsewhere.Session.CaseId" asp-route-section="estimate">
                <span>@GlassLabels.OpenOn @elsewhere.CaseReference</span>
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-right")" /></svg>
            </a>
        </div>
    }
    else if (showGlassLine && glassSession is not null)
    {
        <div class="glass-session" data-glass-session="@glassSession.State.ToString().ToLowerInvariant()">
            <span class="status @tone">@GlassLabels.Launch session · @GlassLabels.StateLabel(glassSession.State)</span>
            <span class="muted grow">@EstimateLabels.Started @OperatorLabels.OfficeClock(glassSession.CreatedAtUtc)</span>
            @if (glassSession.FailureCode is { Length: > 0 } glassFailure)
            {
                <span class="glass-fail" data-glass-failure>@glassFailure</span>
            }
            @if (glassSession.State == GlassRepairEstimateSessionState.AwaitingImport)
            {
                <span class="gated"><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-lock")" /></svg><span>@EstimateLabels.AvailableWhileEditing</span></span>
            }
            @if (Model.CanCloseGlass)
            {
                <button type="button" class="btn btn--small btn--danger" data-dialog-open="glass-close-dialog">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                    <span>@GlassLabels.Close</span>
                </button>
            }
        </div>
        @if (Model.CanCloseGlass)
        {
            @* The guarded close (FRD-25, R647): the prompt states the
               condition and the press is the confirmation that Glass's is
               closed, with a reason. Never offered mid-import (Recording).
               It lives inside the session host so a controls refresh brings
               the session's current version with it. *@
            <div id="glass-close-dialog" class="dialog-backdrop" data-dialog="glass-close-dialog" hidden>
                <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="glass-close-dialog-title">
                    <div class="dialog-head">
                        <h2 id="glass-close-dialog-title" tabindex="-1">@GlassLabels.CloseTitle</h2>
                        <button type="button" class="dialog-close" data-dialog-close aria-label="@EngineerLabels.CloseDialog">
                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                        </button>
                    </div>
                    <form method="post" asp-page="/Cases/Details" asp-page-handler="CloseGlass"
                          asp-route-id="@caseId" asp-route-section="estimate" data-glass-close-form>
                        <input type="hidden" name="sessionId" value="@glassSession.Id" />
                        <input type="hidden" name="expectedSessionVersion" value="@glassSession.Version" />
                        <input type="hidden" name="view" value="@Model.ViewRoute" />
                        <input type="hidden" name="externalSessionClosed" value="true" />
                        <div class="dialog-body stack">
                            <p class="consequence">@GlassLabels.ClosePrompt</p>
                            <div class="field">
                                <label class="req" for="glass-close-reason">@GlassLabels.CloseReason</label>
                                <input type="text" id="glass-close-reason" name="reason" maxlength="2000" required data-dialog-initial-focus />
                            </div>
                        </div>
                        <div class="dialog-foot">
                            <button type="button" class="btn" data-dialog-close>@EngineerLabels.Cancel</button>
                            <button type="submit" data-busy-label="@OperatorLabels.Busy.Closing" class="btn btn--danger">@GlassLabels.Close</button>
                        </div>
                    </form>
                </section>
            </div>
        }
    }

</div>
