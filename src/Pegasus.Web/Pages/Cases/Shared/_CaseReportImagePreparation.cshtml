@model Pegasus.Web.Pages.Cases.ReportImagePreparationView
@using System.Globalization
@using Microsoft.AspNetCore.Html
@using Pegasus.Core.Documents
@using Pegasus.Web.Presentation
@using ReportImageLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.ReportImages
@{
    var view = Model;
    IHtmlContent? PreparationMetadata(CaseAssetPreparation item) => !view.MayPrepare
        ? null
        : new HtmlString($"""data-preparation-card="" data-preparation-occurrence="{item.OccurrenceId:D}" data-preparation-version="{item.PreparationVersion}" data-preparation-role="{item.Role}" data-preparation-order="{item.Order?.ToString(CultureInfo.InvariantCulture) ?? string.Empty}" data-preparation-rotation="{(int)item.Rotation}" data-preparation-crop-left="{item.Crop.Left.ToString(CultureInfo.InvariantCulture)}" data-preparation-crop-top="{item.Crop.Top.ToString(CultureInfo.InvariantCulture)}" data-preparation-crop-width="{item.Crop.Width.ToString(CultureInfo.InvariantCulture)}" data-preparation-crop-height="{item.Crop.Height.ToString(CultureInfo.InvariantCulture)}"""
        );
}
<div class="report-images" data-report-images="@view.Section">
    @foreach (var item in view.Items)
    {
        var slug = $"{view.Section}-{item.OccurrenceId:N}";
        <article class="report-image"
                 @PreparationMetadata(item)
                 data-preparation-preview="@view.PreviewUrls.GetValueOrDefault(item.OccurrenceId)">
            <h3>@(view.FileNames.GetValueOrDefault(item.OccurrenceId) ?? OperatorLabels.CaseWorkspace.AbsentValue)</h3>
            <div class="report-image-preview"><img src="@view.PreviewUrls.GetValueOrDefault(item.OccurrenceId)" alt="" loading="lazy" data-preparation-preview-image /></div>
            <dl class="detail-list">
                <div><dt>@ReportImageLabels.Role</dt><dd data-preparation-role-label>@ReportImageLabels.RoleLabel(item.Role)</dd></div>
                <div><dt>@ReportImageLabels.Rotation</dt><dd data-preparation-rotation-label>@ReportImageLabels.RotationLabel(item.Rotation)</dd></div>
                <div><dt>@ReportImageLabels.Crop</dt><dd data-preparation-crop-label>@ReportImageLabels.CropLabel(item.Crop)</dd></div>
            </dl>
            @if (view.MayPrepare)
            {
                <div class="form-grid">
                    <div class="field"><label for="report-image-role-@slug">@ReportImageLabels.Role</label><select id="report-image-role-@slug" data-preparation-role-select>@foreach (var role in Enum.GetValues<CaseAssetReportRole>()){<option value="@role" selected="@(role == item.Role)">@ReportImageLabels.RoleLabel(role)</option>}</select></div>
                    <div class="field"><label for="report-image-order-@slug">@ReportImageLabels.Order</label><input id="report-image-order-@slug" type="number" min="1" step="1" value="@item.Order" data-preparation-order /></div>
                </div>
                <div class="button-row">
                    <button type="button" class="btn btn--primary" data-preparation-crop>Crop</button>
                    <button type="button" class="btn" data-preparation-rotate="-90">@ReportImageLabels.RotateLeft</button>
                    <button type="button" class="btn" data-preparation-rotate="90">@ReportImageLabels.RotateRight</button>
                    <button type="button" class="btn" data-preparation-reset>@ReportImageLabels.Reset</button>
                </div>
            }
        </article>
    }
</div>
