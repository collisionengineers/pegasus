@*
    Overview (v26, trimmed by v28 P4 and P7): outstanding requirements, the
    Lifecycle actions sub-panel, the three fact columns (Case / Principal /
    Claimant), the Notes band (record notes beside this Case's notes) and the
    accident band. One look for read and edit (operator, 23 September 2026):
    every fact is a .fc cell whose greyed value box and control box share the
    grid position, and the same cells render in both modes; a cell with no
    control is .ro. The controls belong to the record's one Save form,
    #case-edit-form, which this section renders because it owns the hidden
    fields the other sections' controls join.
*@
@model Pegasus.Web.Pages.Cases.DetailsModel
@using System.Globalization
@using Pegasus.Core.Cases
@using Pegasus.Core.Lifecycle
@using Pegasus.Core.Workflow
@using Pegasus.Web.Pages
@using Pegasus.Web.Presentation
@using Frame = Pegasus.Web.Presentation.CaseWorkspaceLabels.Frame
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var summary = details.Summary;
    var data = details.Data;
    var mayEdit = Model.CanEditCaseData && data is not null;
    var state = workflow.State;
    var requirements = Model.OutstandingRequirements;
    var headTools = new Pegasus.Web.Pages.Cases.CaseSectionHeadView(Model, "overview");
    var notes = details.RecordNotes;
    var caseNotes = data?.Workspace;

    string Value(string? text) => string.IsNullOrWhiteSpace(text) ? OperatorLabels.CaseWorkspace.AbsentValue : text;
    string ValueClass(string? text) => string.IsNullOrWhiteSpace(text) ? "fv empty" : "fv";
    // A cell renders its control only while Case data edits; without one it
    // is .ro, so its value stays in place wherever the record is editing.
    string? Ro() => mayEdit ? null : "ro";

    var claimant = Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Claimant.Name)?.Value ?? (data is null ? summary.Claimant : null);
    var claimNumberValue = Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Claim.Number);
    var claimNumber = claimNumberValue?.Value ?? (data is null ? summary.ClaimNumber : null);
    var incidentDateValue = Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Accident.IncidentDate);
    var incidentDate = incidentDateValue?.Value;
    var dueBy = workflow.DueWork?.DueBy
        ?? Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Inspection.Deadline)?.Value;
    var circumstancesValue = Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Accident.Circumstances);
    var circumstances = circumstancesValue?.Value;
    var contactNameValue = Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Contact.Name);
    var contactEmailValue = Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Contact.EmailAddress);
    var contactPhoneValue = Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Contact.PhoneNumber);
    var contactName = contactNameValue?.Value;
    var contactEmail = contactEmailValue?.Value;
    var contactPhone = contactPhoneValue?.Value;
    // The matter line (v28 P12): the nature of the incident, the claimant and
    // the incident date as one derived sentence, following its fields on save.
    var matterLine = string.Join(": ", new[]
    {
        Frame.NatureOfIncident,
        claimant,
        incidentDate?.ToString("d MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
    }.Where(part => !string.IsNullOrWhiteSpace(part)));
    // The claim source's contact reads as three cells in both modes: the
    // Case's own override where one is recorded, otherwise the contact copied
    // from the Claim source record. Save keeps an override only where the
    // posted value differs from that copy.
    var claimSource = caseNotes?.ClaimSource;
}

<section class="record-section panel @Model.CollapsedClass("case.overview") @Model.ActiveTabClass("overview") @(Model.IsEditing && !Model.SectionIsEditable("overview") ? "is-locked" : null)" id="section-overview" data-section="overview" data-collapse="case.overview" aria-labelledby="section-overview-title">
    <div class="panel-head">
        <h2 id="section-overview-title">Case details</h2>
        <div class="panel-actions">
            <partial name="Cases/Shared/_CaseSectionHeadTools" model="headTools" />
        </div>
    </div>
    <div class="panel-body stack">
        @* A refused save (stale version) is a non-destructive conflict: the
           proposed values are retained beside what the case now holds, with no
           way to apply or force them — re-entering edit mode is the only path. *@
        @if (Model.ProposedValuesWereDropped)
        {
            <div class="notice notice--warning" data-dismissable>
                <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                <span>Your change was not applied. The values you submitted were too large to keep and are not shown here; enter edit mode again and re-enter them.</span>
                <button type="button" class="dismiss" data-dismiss aria-label="Dismiss"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
            </div>
        }
        else if (Model.ProposedValues.Count > 0)
        {
            <div class="sub-panel" data-proposed-values aria-labelledby="case-proposed-values-title">
                <h3 id="case-proposed-values-title">Your change was not applied</h3>
                @if (Model.ProposedValuesWereShortened)
                {
                    <div class="notice notice--warning mb-2">
                        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                        <span>Some values were too long to keep in full and are shown shortened; re-enter those in full.</span>
                    </div>
                }
                <div class="table-wrap">
                    <table class="table table--compact">
                        <thead><tr><th>Field</th><th>You proposed</th><th>The case now holds</th></tr></thead>
                        <tbody>
                            @foreach (var proposed in Model.ProposedValues)
                            {
                                <tr>
                                    <th>@proposed.Label</th>
                                    <td>@proposed.Proposed</td>
                                    <td>@(string.IsNullOrWhiteSpace(proposed.Current) ? "—" : proposed.Current)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (requirements.Count > 0)
        {
            <div class="sub-panel blockers" data-outstanding-requirements>
                <h3>@Frame.OutstandingRequirements <span class="status status--amber">@requirements.Count outstanding</span></h3>
                <ul class="blocker-list">
                    @foreach (var requirement in requirements)
                    {
                        <li class="blocker">
                            <strong>@requirement.Title</strong>
                            <small>
                                <b>Source:</b> @requirement.Source
                                @if (!string.IsNullOrWhiteSpace(requirement.Why))
                                {
                                    <br /><b>Why:</b> @requirement.Why
                                }
                            </small>
                        </li>
                    }
                </ul>
            </div>
        }

        @* The remaining Core lifecycle actions: return to Review and the
           correction of a wrongly linked report-Sent item. Archiving ends a
           terminal case's editability. Offered only in edit context. *@

        @if (mayEdit)
        {
            @* Submitted workspace sections retain unshown accepted values;
               these hidden controls also use Confirmed then Fact, never the
               suggestion fallback. `vehicleMileage`, `vehicleMileageUnit`,
               `inspectionAddress` and the assessment fields are not hidden
               here: each has one visible control in its own section,
               associated with this form. *@
            <form method="post" asp-page="/Cases/Details" asp-page-handler="Save"
                  asp-route-id="@workflow.CaseId" id="case-edit-form" data-edit-save data-case-save-form>
                <input type="hidden" name="id" value="@workflow.CaseId" />
                <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                <input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" />
                <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                <input type="hidden" name="section" value="@Model.Section" data-case-section-field />
                <input type="hidden" name="instructionDate" value="@(Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data!.Instruction.InstructionDate)?.Value.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="inspectionDeadline" value="@(Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data!.Inspection.Deadline)?.Value.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="inspectionMode" value="@(Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data!.Inspection.Mode)?.Value)" />
            </form>
        }

        <div class="overview-grid">
            <div class="sub-panel @Model.CollapsedClass("case.overview.case")" data-collapse="case.overview.case"><h3>Case <partial name="Shared/_SubPanelToggle" model="@Model.SubPanel("case.overview.case")" /></h3>
                <div class="fg g2">
                    <div class="fc ro"><span class="lbl">@Frame.CaseType</span><div class="fv">@OperatorLabels.CaseTypeName(summary.CaseType)</div></div>
                    <div class="fc ro"><span class="lbl">@Frame.OurRef</span><div class="fv mono">@workflow.Identity.Reference</div></div>
                    <div class="fc @Ro()">@{ Lbl("f-claim-reference", Frame.ClaimReference, claimNumberValue?.Source); }<div class="@ValueClass(claimNumber) mono">@Value(claimNumber)</div>@if (mayEdit){<input id="f-claim-reference" class="fi mono" name="claimNumber" form="case-edit-form" maxlength="200" value="@claimNumber" />}</div>
                    <div class="fc @Ro()">@{ Lbl("f-incident-date", Frame.IncidentDate, incidentDateValue?.Source); }<div class="@ValueClass(incidentDate?.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture))">@Value(incidentDate?.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture))</div>@if (mayEdit){<input id="f-incident-date" class="fi" name="incidentDate" form="case-edit-form" type="date" value="@incidentDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />}</div>
                    <div class="fc ro"><span class="lbl">@Frame.Received</span><div class="fv">@OperatorLabels.OfficeTime(summary.ReceivedAtUtc)</div></div>
                    <div class="fc @Ro()">@{ Lbl("f-due-by", Frame.Due); }<div class="@ValueClass(dueBy?.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture))">@Value(dueBy?.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture))</div>@if (mayEdit){<input id="f-due-by" class="fi" name="dueBy" form="case-edit-form" type="date" value="@dueBy?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />}</div>
                    <div class="fc ro"><span class="lbl">@Frame.MatterLine</span><div class="fv derived @(matterLine.Length == 0 ? "empty" : null)" data-matter-line>@(matterLine.Length == 0 ? OperatorLabels.CaseWorkspace.AbsentValue : matterLine)</div></div>
                    @* The Sign-off Engineer (v28 P38): decided with the Case, not the report. *@
                    @{ var signOffEditable = Model.SectionIsEditable("report") && data is not null; }
                    <div class="fc @(signOffEditable ? null : "ro")" data-field="signOffEngineerId">
                        @if (signOffEditable)
                        {
                            <label for="f-sign-off-engineer">@CaseWorkspaceLabels.Report.SignOffEngineer</label>
                            <div class="fv">@Model.SignOffEngineerDisplayName</div>
                            <select id="f-sign-off-engineer" class="fi" name="signOffEngineerId" form="case-edit-form">
                                <option value="" disabled selected="@(Model.SelectedSignOffEngineerId is null)"></option>
                                @foreach (var engineer in Model.EligibleSignOffEngineers)
                                {
                                    <option value="@engineer.StaffId" selected="@(engineer.StaffId == Model.SelectedSignOffEngineerId)">@engineer.PrintedName</option>
                                }
                            </select>
                        }
                        else
                        {
                            <span class="lbl">@CaseWorkspaceLabels.Report.SignOffEngineer</span>
                            <div class="fv">@Model.SignOffEngineerDisplayName</div>
                        }
                    </div>
                    @if (workflow.ReportSentEvidence is { } sentEvidence)
                    {
                        @* Inherited scope: the mailbox address and the authoritative time, never the retained identifiers. *@
                        <div class="fc ro"><span class="lbl">@Frame.ReportSent</span><div class="fv">@sentEvidence.MailboxIdentity · @OperatorLabels.OfficeTime(sentEvidence.SentAtUtc)</div></div>
                    }
                </div>
            </div>
            <div class="sub-panel @Model.CollapsedClass("case.overview.principal")" data-collapse="case.overview.principal"><h3>Principal <partial name="Shared/_SubPanelToggle" model="@Model.SubPanel("case.overview.principal")" /></h3>
                <div class="fg">
                    <div class="fc ro"><span class="lbl">@OperatorLabels.CaseWorkspace.RibbonPrincipal</span><div class="fv">@workflow.Identity.PrincipalCode</div></div>
                    @* The claim source is chosen from the active Claim source
                       records while editing; each option carries the record's
                       notes and contact so the notes band and the contact
                       cells follow a change before Save (case-workspace.js). *@
                    <div class="fc @Ro()" data-claim-source-cell>@{ Lbl("f-claim-source", Frame.ClaimSource); }<div class="@ValueClass(claimSource?.Name)">@Value(claimSource?.Name)</div>@if (mayEdit)
                        {
                            <select id="f-claim-source" class="fi" name="claimSourceId" form="case-edit-form" data-claim-source-select>
                                <option value="" data-notes="" selected="@(claimSource?.ClaimSourceId is null)">@Frame.NoClaimSource</option>
                                @if (claimSource?.ClaimSourceId is { } recordedSourceId && Model.ClaimSourceChoices.All(choice => choice.OrganizationId != recordedSourceId))
                                {
                                    <option value="@recordedSourceId" data-notes="@notes.ClaimSourceNotes" data-contact-name="@claimSource.ContactName" data-contact-phone="@claimSource.ContactTelephone" data-contact-email="@claimSource.ContactEmailAddress" selected>@claimSource.Name</option>
                                }
                                @foreach (var choice in Model.ClaimSourceChoices)
                                {
                                    <option value="@choice.OrganizationId" data-notes="@choice.NotesOnEveryCase" data-contact-name="@choice.ContactPerson" data-contact-phone="@choice.Telephone" data-contact-email="@choice.Email" selected="@(choice.OrganizationId == claimSource?.ClaimSourceId)">@choice.Name</option>
                                }
                            </select>
                        }</div>
                    <div class="fc @Ro()" data-claim-source-contact="name">@{ Lbl("f-claim-source-contact-name", Frame.ClaimSourceContactName); }<div class="@ValueClass(claimSource?.EffectiveContactName)">@Value(claimSource?.EffectiveContactName)</div>@if (mayEdit){<input id="f-claim-source-contact-name" class="fi" name="claimSourceContactName" form="case-edit-form" maxlength="300" value="@claimSource?.EffectiveContactName" />}</div>
                    <div class="fc @Ro()" data-claim-source-contact="phone">@{ Lbl("f-claim-source-contact-phone", Frame.ClaimSourceContactPhone); }<div class="@ValueClass(claimSource?.EffectiveContactTelephone)">@Value(claimSource?.EffectiveContactTelephone)</div>@if (mayEdit){<input id="f-claim-source-contact-phone" class="fi" name="claimSourceContactTelephone" form="case-edit-form" maxlength="100" value="@claimSource?.EffectiveContactTelephone" />}</div>
                    <div class="fc @Ro()" data-claim-source-contact="email">@{ Lbl("f-claim-source-contact-email", Frame.ClaimSourceContactEmail); }<div class="@ValueClass(claimSource?.EffectiveContactEmailAddress)">@Value(claimSource?.EffectiveContactEmailAddress)</div>@if (mayEdit){<input id="f-claim-source-contact-email" class="fi" name="claimSourceContactEmail" form="case-edit-form" type="email" maxlength="300" value="@claimSource?.EffectiveContactEmailAddress" />}</div>
                </div>
            </div>
        </div>
        @* The Case's own contact: who to speak to, distinct from the claimant. *@
        <div class="sub-panel @Model.CollapsedClass("case.overview.contact")" data-collapse="case.overview.contact"><h3>Case contact <partial name="Shared/_SubPanelToggle" model="@Model.SubPanel("case.overview.contact")" /></h3>
            <div class="fg g3">
                <div class="fc @Ro()">@{ Lbl("f-contact-name", Frame.ContactName, contactNameValue?.Source); }<div class="@ValueClass(contactName)">@Value(contactName)</div>@if (mayEdit){<input id="f-contact-name" class="fi" name="contactName" form="case-edit-form" maxlength="300" value="@contactName" />}</div>
                <div class="fc @Ro()">@{ Lbl("f-contact-email", Frame.ContactEmail, contactEmailValue?.Source); }<div class="@ValueClass(contactEmail)">@Value(contactEmail)</div>@if (mayEdit){<input id="f-contact-email" class="fi" name="contactEmailAddress" form="case-edit-form" type="email" maxlength="300" value="@contactEmail" />}</div>
                <div class="fc @Ro()">@{ Lbl("f-contact-phone", Frame.ContactPhone, contactPhoneValue?.Source); }<div class="@ValueClass(contactPhone)">@Value(contactPhone)</div>@if (mayEdit){<input id="f-contact-phone" class="fi" name="contactPhoneNumber" form="case-edit-form" maxlength="100" value="@contactPhone" />}</div>
            </div>
        </div>

        @* The Notes band (13 September): the Principal record's and the Claim
           source record's notes on every Case, read live and locked, absent
           when the record has none, beside this Case's own notes. *@
        <div class="sub-panel notes-band @Model.CollapsedClass("case.overview.notes")" data-notes-band data-collapse="case.overview.notes"><h3>@Frame.Notes <partial name="Shared/_SubPanelToggle" model="@Model.SubPanel("case.overview.notes")" /></h3>
            <div class="fg g2">
                @if (!string.IsNullOrWhiteSpace(notes.PrincipalNotes))
                {
                    <div class="fc ro" data-record-notes="principal"><span class="lbl">@Frame.PrincipalNotes</span><div class="fv multi">@notes.PrincipalNotes</div></div>
                }
                <div class="fc @Ro()">@{ Lbl("f-principal-notes", Frame.PrincipalNotesThisCase); }<div class="@ValueClass(caseNotes?.PrincipalNotes) multi">@Value(caseNotes?.PrincipalNotes)</div>@if (mayEdit){<textarea id="f-principal-notes" class="fi" name="principalNotes" form="case-edit-form" maxlength="4000">@caseNotes?.PrincipalNotes</textarea>}</div>
                @if (!string.IsNullOrWhiteSpace(notes.ClaimSourceNotes))
                {
                    <div class="fc ro" data-record-notes="claim-source"><span class="lbl">@Frame.ClaimSourceNotes</span><div class="fv multi" data-record-notes-text>@notes.ClaimSourceNotes</div></div>
                }
                else if (mayEdit)
                {
                    @* While editing, an empty slot the claim source select can fill. *@
                    <div class="fc ro" data-record-notes-slot="claim-source" hidden><span class="lbl">@Frame.ClaimSourceNotes</span><div class="fv multi" data-record-notes-text></div></div>
                }
                <div class="fc @Ro()">@{ Lbl("f-claim-source-notes", Frame.ClaimSourceNotesThisCase); }<div class="@ValueClass(caseNotes?.ClaimSourceNotes) multi">@Value(caseNotes?.ClaimSourceNotes)</div>@if (mayEdit){<textarea id="f-claim-source-notes" class="fi" name="claimSourceNotes" form="case-edit-form" maxlength="4000">@caseNotes?.ClaimSourceNotes</textarea>}</div>
            </div>
        </div>

        <div class="accident" data-accident-band>
            <div class="fg g2">
                <div class="fc @Ro()">@{ Lbl("f-circumstances", Frame.AccidentCircumstances, circumstancesValue?.Source); }<div class="@ValueClass(circumstances) multi">@Value(circumstances)</div>@if (mayEdit){<textarea id="f-circumstances" class="fi" name="accidentCircumstances" form="case-edit-form" maxlength="2000">@circumstances</textarea>}</div>
                <div class="fc @Ro()" data-client-notes>@{ Lbl("f-client-notes", Frame.NotesFromClient); }<div class="@ValueClass(caseNotes?.ClientNotes) multi">@Value(caseNotes?.ClientNotes)</div>@if (mayEdit){<textarea id="f-client-notes" class="fi" name="clientNotes" form="case-edit-form" maxlength="4000">@caseNotes?.ClientNotes</textarea>}</div>
            </div>
        </div>
    </div>
</section>

@functions {
    // The cell's label: a real <label> for the control while editing, the
    // same words as a plain caption while reading, with the value's source
    // tag in the label line in both.
    private void Lbl(string id, string text, CaseDataSource? source = null)
    {
        var tag = OperatorLabels.SourceTag(source);
        if (Model.CanEditCaseData && Model.Case!.Data is not null)
        {
            <label for="@id">@text@(tag?.Render())</label>
        }
        else
        {
            <span class="lbl">@text@(tag?.Render())</span>
        }
    }
}
