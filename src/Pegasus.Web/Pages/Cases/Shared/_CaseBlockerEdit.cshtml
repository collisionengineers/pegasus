@*
    A report blocker the Repair Spec clears by one control (issue 898): the
    section-head Edit's claim, on the Current spec, in the words and class
    the caller gives (the blocker's requirement in the Report not ready card,
    the section's name as the Next action step). Once edit mode is open in
    place the control named by data-edit-focus takes focus; without script
    the claim lands on the section.

    Model: the page, the control's selector, the words and the button class.
*@
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Cases.CaseBlockerEditView
@{
    var owner = Model.Page;
    var caseId = owner.CurrentWorkflow!.CaseId;
}
<form method="post" asp-page="/Cases/Details" asp-page-handler="ClaimLease" asp-route-id="@caseId" data-case-edit-form>
    <input type="hidden" name="id" value="@caseId" />
    <input type="hidden" name="expectedVersion" value="@owner.CurrentWorkflow!.Version" />
    <input type="hidden" name="operationKey" value="@owner.ClaimLeaseOperationKey" />
    <input type="hidden" name="section" value="estimate" />
    <input type="hidden" name="view" value="@owner.ViewRoute" />
    <input type="hidden" name="estimate" value="@owner.CurrentSpecification!.SpecificationId" />
    <button type="submit" data-busy-label="@OperatorLabels.Busy.Opening" class="@Model.ButtonClass" data-section-edit="estimate" data-edit-focus="@Model.Focus">@Model.Label</button>
</form>
