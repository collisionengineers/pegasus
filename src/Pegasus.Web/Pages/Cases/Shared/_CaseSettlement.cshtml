@using Pegasus.Core.Assessment
@using Pegasus.Web.Presentation
@using EngineerLabels = Pegasus.Web.Presentation.OperatorLabels.CaseWorkspace.EngineerSections
@model Pegasus.Web.Pages.Cases.DetailsModel

<section class="panel" aria-labelledby="section-settlement-title">
    <div class="panel-head"><h2 id="section-settlement-title">@EngineerLabels.Settlement</h2></div>
    <div class="panel-body">
        <dl class="detail-list">
            <div><dt>@EngineerLabels.Outcome</dt><dd>@Model.AssessmentValue(AssessmentVocabulary.Outcome)</dd></div>
            <div><dt>@EngineerLabels.SalvageCategory</dt><dd>@Model.AssessmentValue(AssessmentVocabulary.SalvageCategory)</dd></div>
            <div><dt>@EngineerLabels.SalvageValue</dt><dd>@Model.AssessmentValue(AssessmentVocabulary.SalvageValue)</dd></div>
            <div><dt>@EngineerLabels.RecoveryCharge</dt><dd>@Model.AssessmentValue(AssessmentVocabulary.CostRecoveryCharge)</dd></div>
            <div><dt>@EngineerLabels.StorageCharge</dt><dd>@Model.AssessmentValue(AssessmentVocabulary.CostStorageCharge)</dd></div>
            <div><dt>@EngineerLabels.RepairerVatRegistered</dt><dd>@Model.AssessmentValue(AssessmentVocabulary.CostRepairerVatRegistered)</dd></div>
        </dl>
    </div>
</section>
