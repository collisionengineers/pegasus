@*
    Decisions (v26 § Settlement, renamed by v28 P26). The figures strip, then
    the Decisions strip with its radio groups (v28 P29: the select stays the
    posted control and the buttons drive it, so the live show-and-hide rules
    still fire), the salvage share slider (P14), the firm's unroadworthy
    reason bank (P15), the temporary repair rows for an unroadworthy vehicle,
    the computed repair reserve (P30) and the "Salvage · Not applicable" line
    (P29) while the outcome is not a total loss. Historic head comment
    follows.

    Settlement (v26 § Settlement). The figures strip, then the Decisions strip
    (manager's v24 decision folded in: Outcome, Engineer's Value, Salvage
    category and value, Roadworthiness and the unroadworthy reason in one
    place), then the settlement money, the costs/hire/delays sub-panel and
    the seven salvage fields. One geometry for read and edit: every editable
    value is a .fc cell whose control joins the record's one Save form.
*@
@using System.Globalization
@using Pegasus.Core.Assessment
@using Pegasus.Core.Reports
@using Pegasus.Web.Presentation
@using SettlementLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Settlement
@using EngineerLabels = Pegasus.Web.Presentation.OperatorLabels.CaseWorkspace.EngineerSections
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var editing = Model.SectionIsEditable("settlement");
    var labels = CaseWorkspaceLabels.Editors.Settlement;
    var engineerValue = Model.EngineerValue;
    var repairCost = Model.RepairCostIncVat;
    var salvage = Model.SalvageValueFigure;
    var isTotalLoss = Model.IsTotalLoss;
    var isUnroadworthy = Model.IsUnroadworthy;
    var outcome = Model.RecordedOutcome;
    var equity = engineerValue is { } ev ? ev - (salvage ?? 0m) : (decimal?)null;

    string Money(decimal? value) => value is { } figure ? Pegasus.Web.Pages.Cases.DetailsModel.FormatPounds(figure) : "—";

    var computedReserve = Model.ComputedRepairReserve;
}

<section class="record-section panel @Model.CollapsedClass("case.settlement") @Model.ActiveTabClass("settlement") @(Model.IsEditing && !Model.SectionIsEditable("settlement") ? "is-locked" : null)" id="section-settlement" data-section="settlement" data-collapse="case.settlement" aria-labelledby="section-settlement-title"
         data-settlement-repair-cost="@(repairCost?.ToString("0.##", CultureInfo.InvariantCulture))"
         data-settlement data-settlement-outcome="@outcome" data-settlement-editable="@(editing ? "true" : "false")">
    <div class="panel-head">
        <h2 id="section-settlement-title">@EngineerLabels.Settlement</h2>
        <div class="panel-actions">
            <partial name="Cases/Shared/_CaseSectionHeadTools" model='new Pegasus.Web.Pages.Cases.CaseSectionHeadView(Model, "settlement")' />
        </div>
    </div>
    <div class="panel-body stack">
        @* The figures the decision produces, from the Engineer's Value, the
           recorded salvage value and the Current estimate's printed total. *@
        <div class="metric-strip" data-settlement-figures>
            @if (isTotalLoss)
            {
                <div class="metric"><span class="metric-label">@SettlementLabels.EngineersValue</span><span class="metric-value">@Money(engineerValue)</span>@if (engineerValue is null){<span class="metric-meta">@SettlementLabels.SetInValuationMeta</span>}</div>
                <div class="metric"><span class="metric-label">@SettlementLabels.SalvageValue</span><span class="metric-value">@Money(salvage)</span></div>
                <div class="metric"><span class="metric-label">@SettlementLabels.Equity</span><span class="metric-value red">@Money(equity)</span><span class="metric-meta">@SettlementLabels.EquityMeta</span></div>
                <div class="metric"><span class="metric-label">@SettlementLabels.RepairCostIncVat</span><span class="metric-value">@Money(repairCost)</span><span class="metric-meta">@(repairCost is { } cost && engineerValue is { } value && cost > value ? SettlementLabels.ExceedsEngineersValue : SettlementLabels.FromCurrentEstimate)</span></div>
            }
            else
            {
                <div class="metric"><span class="metric-label">@SettlementLabels.EngineersValue</span><span class="metric-value">@Money(engineerValue)</span>@if (engineerValue is null){<span class="metric-meta">@SettlementLabels.SetInValuationMeta</span>}</div>
                <div class="metric"><span class="metric-label">@SettlementLabels.LabourHours</span><span class="metric-value">@(Model.LabourHours is { } hours ? hours.ToString("0.00", CultureInfo.InvariantCulture) : "—")</span></div>
                <div class="metric"><span class="metric-label">@(outcome == "cash_in_lieu" ? SettlementLabels.CashInLieu : SettlementLabels.RepairCostIncVat)</span><span class="metric-value red">@Money(repairCost)</span><span class="metric-meta">@SettlementLabels.FromCurrentEstimate</span></div>
                <div class="metric"><span class="metric-label">@SettlementLabels.RepairCostOfValue</span><span class="metric-value">@(repairCost is { } c && engineerValue is { } v && v > 0 ? $"{Math.Round(c / v * 100)}%" : "—")</span></div>
            }
        </div>

        @* The Decisions strip. *@
        <div class="decisions" data-decisions>
            <div class="dec-head">
                <h3>@SettlementLabels.Decisions</h3>
            </div>
            @{ await DecisionRow(AssessmentVocabulary.Outcome, labels[AssessmentVocabulary.Outcome], false); }
            <div class="dec" data-decision="@AssessmentVocabulary.ValueEngineer">
                <span class="dl">@SettlementLabels.EngineersValue</span>
                <div class="fc ro">
                    <span class="lbl">@SettlementLabels.EngineersValue</span>
                    <div class="fv mono" data-decision-engineer-value data-engineer-value="@(engineerValue?.ToString("0.##", CultureInfo.InvariantCulture))">
                        <span>@Money(engineerValue)</span>
                        <a class="src-tag" asp-page="/Cases/Details" asp-route-id="@Model.Case!.Workflow.CaseId" asp-route-section="valuation" asp-route-view="@Model.ViewRoute" asp-fragment="section-valuation" data-section-jump="valuation">@SettlementLabels.ValuationLink</a>
                    </div>
                </div>
            </div>
            @* While the outcome is not a total loss the salvage rows are gone;
               this says so as a label and a value, never as a sentence (P29). *@
            <div class="dec" data-decision-salvage-absent data-hidden-when="total-loss" hidden="@(isTotalLoss ? "hidden" : null)">
                <span class="dl">@SettlementLabels.Salvage</span>
                <div class="fc ro"><span class="lbl">@SettlementLabels.Salvage</span><div class="fv">@SettlementLabels.NotApplicable</div></div>
            </div>
            @{ await DecisionRow(AssessmentVocabulary.SalvageCategory, labels[AssessmentVocabulary.SalvageCategory], !isTotalLoss, "total-loss");
                await DecisionRow(
                    AssessmentVocabulary.SalvageValue, labels[AssessmentVocabulary.SalvageValue], !isTotalLoss, "total-loss",
                    share: true);
                await DecisionRow(AssessmentVocabulary.LegalStatus, labels[AssessmentVocabulary.LegalStatus], false);
            }
            <div class="dec wide" data-decision="@AssessmentVocabulary.UnroadworthyReason" data-shown-when="unroadworthy" hidden="@(isUnroadworthy ? null : "hidden")">
                <span class="dl">@labels[AssessmentVocabulary.UnroadworthyReason]</span>
                @{ await Field(AssessmentVocabulary.UnroadworthyReason, labels[AssessmentVocabulary.UnroadworthyReason], multi: true); }
                @if (editing && Model.CanEditAssessmentField(AssessmentVocabulary.UnroadworthyReason))
                {
                    @* The firm's bank (P15): a wording is inserted into the reason,
                       joined with "and"; the typed reason can be saved to the bank. *@
                    <div class="reason-bank" data-reason-bank aria-label="@SettlementLabels.ReasonBank">
                        @foreach (var wording in Model.UnroadworthyReasonWordings)
                        {
                            <button type="button" class="btn btn--small" data-bank-wording="@wording">@wording</button>
                        }
                        <button type="submit" class="btn btn--small" form="case-edit-form"
                                name="saveUnroadworthyReason" value="true">
                            <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                            <span>@SettlementLabels.SaveWordingToTheBank</span>
                        </button>
                    </div>
                }
            </div>
            @* Temporary repairs are the unroadworthy vehicle's: they follow the reason and
               show only while Roadworthiness is Unroadworthy, as the salvage rows show
               only on a total loss (operator, 24 September 2026). *@
            @{ await DecisionRow(AssessmentVocabulary.VehicleTemporaryRepairsPossible, labels[AssessmentVocabulary.VehicleTemporaryRepairsPossible], !isUnroadworthy, "unroadworthy");
                await DecisionRow(AssessmentVocabulary.VehicleTemporaryRepairMethod, labels[AssessmentVocabulary.VehicleTemporaryRepairMethod], !isUnroadworthy, "unroadworthy");
                await DecisionRow(AssessmentVocabulary.VehicleTemporaryRepairCost, labels[AssessmentVocabulary.VehicleTemporaryRepairCost], !isUnroadworthy, "unroadworthy");
            }
        </div>

        <div class="fg g4">
            @{ await Field(AssessmentVocabulary.SettlementExcess, labels[AssessmentVocabulary.SettlementExcess]);
                await Field(AssessmentVocabulary.SettlementBetterment, labels[AssessmentVocabulary.SettlementBetterment]);
                @* The agreed contract sum (v28 P35) is a decision, recorded
                   here; the Repair Spec bar ties to this one control. *@
                await Field(AssessmentVocabulary.SettlementContractSum, labels[AssessmentVocabulary.SettlementContractSum]);
            }
        </div>

        <div class="sub-panel @Model.CollapsedClass("case.settlement.costs")" data-collapse="case.settlement.costs"><h3>@SettlementLabels.CostsHireDelays <partial name="Shared/_SubPanelToggle" model="@Model.SubPanel("case.settlement.costs")" /></h3>
            <div class="fg g4">
                <div class="fc ro" data-settlement-computed-reserve>
                    <span class="lbl">@SettlementLabels.ComputedRepairReserve</span>
                    <div class="fv mono derived @(computedReserve is null ? "empty" : null)"
                         data-settlement-computed-reserve-value
                         data-not-applicable="@SettlementLabels.NotApplicable"
                         data-rounded-up="@SettlementLabels.RoundedUpToFifty">@(computedReserve is { } reserve ? Money(reserve) + " (" + SettlementLabels.RoundedUpToFifty + ")" : SettlementLabels.NotApplicable)</div>
                </div>
                @{ await Field(AssessmentVocabulary.SettlementReserve, labels[AssessmentVocabulary.SettlementReserve]);
                    await Field(AssessmentVocabulary.SettlementDiminution, labels[AssessmentVocabulary.SettlementDiminution]);
                    await Field(AssessmentVocabulary.SettlementHireStart, labels[AssessmentVocabulary.SettlementHireStart]);
                    await Field(AssessmentVocabulary.SettlementHireDailyCost, labels[AssessmentVocabulary.SettlementHireDailyCost]);
                    await Field(AssessmentVocabulary.SettlementRepairDelays, labels[AssessmentVocabulary.SettlementRepairDelays]);
                    await Field(AssessmentVocabulary.SettlementReportDelay, labels[AssessmentVocabulary.SettlementReportDelay]);
                }
                <div class="fc ro"><span class="lbl">@SettlementLabels.StorageCharge</span><div class="fv mono derived @(Model.AssessmentIsAbsent(AssessmentVocabulary.CostStorageCharge) ? "empty" : null)">@Model.AssessmentDisplay(AssessmentVocabulary.CostStorageCharge)</div></div>
            </div>
        </div>

        <div class="sub-panel @Model.CollapsedClass("case.settlement.salvage")" data-shown-when="total-loss" hidden="@(isTotalLoss ? null : "hidden")" data-collapse="case.settlement.salvage"><h3>@SettlementLabels.Salvage <partial name="Shared/_SubPanelToggle" model="@Model.SubPanel("case.settlement.salvage")" /></h3>
            <div class="fg g4">
                @{ await Field(AssessmentVocabulary.SettlementSalvageAt, labels[AssessmentVocabulary.SettlementSalvageAt]);
                    await Field(AssessmentVocabulary.SettlementSalvageAgent, labels[AssessmentVocabulary.SettlementSalvageAgent]);
                    await Field(AssessmentVocabulary.SettlementSalvageAgentReference, labels[AssessmentVocabulary.SettlementSalvageAgentReference]);
                    await Field(AssessmentVocabulary.SettlementSalvageMoved, labels[AssessmentVocabulary.SettlementSalvageMoved]);
                    await Field(AssessmentVocabulary.SettlementSalvageOwnerRetains, labels[AssessmentVocabulary.SettlementSalvageOwnerRetains]);
                    await Field(AssessmentVocabulary.SettlementSalvageValueAgreed, labels[AssessmentVocabulary.SettlementSalvageValueAgreed]);
                    await Field(AssessmentVocabulary.SettlementSalvageSettled, labels[AssessmentVocabulary.SettlementSalvageSettled]);
                }
            </div>
        </div>
    </div>
</section>

@functions {
    // One decision row: the label column and the cell itself. The strip hides
    // the cell's own label, so the row carries its value's source tag in the
    // label column.
    private async Task DecisionRow(string path, string label, bool hidden, string? shownWhen = null, bool share = false)
    {
        var definition = AssessmentVocabulary.Definitions[path];
        var editable = Model.SectionIsEditable("settlement") && Model.CanEditAssessmentField(path);
        var radios = definition.Type == AssessmentFieldType.Enumerated;
        var rowTag = Model.AssessmentSourceTag(path);
        <div class="dec" data-decision="@path" data-shown-when="@shownWhen" hidden="@(hidden ? "hidden" : null)">
            <span class="dl">@label @(rowTag?.Render())</span>
            @{ await Field(path, label, radios: radios); }
            @if (share)
            {
                var engineerValueForShare = Model.EngineerValue;
                var recordedSalvage = Model.SalvageValueFigure;
                var salvageShare = engineerValueForShare is { } evForShare && evForShare > 0m && recordedSalvage is { } salvageFigure
                    ? Math.Round(salvageFigure / evForShare * 100m, 1)
                    : (decimal?)null;
                var salvageSnaps = new[] { 5, 10, 15, 20, 25 };
                var engineerValueText = engineerValueForShare is { } valueForText
                    ? Pegasus.Web.Pages.Cases.DetailsModel.FormatPounds(valueForText)
                    : "—";
                @* P14: the salvage value as a share of the Engineer's Value. The
                   money field stays the posted control; the slider writes into it. *@
                <div class="salvage-share" data-salvage-share>
                    @if (engineerValueForShare is null)
                    {
                        <span class="muted">@SettlementLabels.SetInValuation</span>
                    }
                    else
                    {
                        @if (editable)
                        {
                            <input type="range" min="0" max="100" step="1" value="@(salvageShare is { } share0 ? Math.Round(share0).ToString(CultureInfo.InvariantCulture) : "0")"
                                   aria-label="@SettlementLabels.SalvageShare" data-salvage-range />
                            <span class="snaps">
                                @foreach (var snap in salvageSnaps)
                                {
                                    <button type="button" class="@(salvageShare is { } at && Math.Abs(at - snap) < 0.5m ? "on" : null)" data-salvage-snap="@snap">@snap%</button>
                                }
                            </span>
                        }
                        <span class="read mono" data-salvage-read>@(salvageShare is { } read ? SettlementLabels.ShareOfValue(read, engineerValueText) : string.Empty)</span>
                    }
                </div>
            }
        </div>
    }

    // One assessment cell on the vocabulary's own type: a Yes/No select for a
    // flag, the codes for an enumeration, a money/number/date input, a text
    // input or textarea. The control renders only while the field edits.
    private async Task Field(string path, string label, bool multi = false, string? extraClass = null, bool radios = false)
    {
        var definition = AssessmentVocabulary.Definitions[path];
        var editable = Model.SectionIsEditable("settlement") && Model.CanEditAssessmentField(path);
        var value = Model.AssessmentEditorValue(path);
        var absent = Model.AssessmentIsAbsent(path);
        var tag = Model.AssessmentSourceTag(path);
        var name = CaseWorkspaceLabels.Editors.FormName(path);
        var id = "f-" + path.Replace('.', '-').Replace('_', '-');
        var mono = definition.Type is AssessmentFieldType.Money or AssessmentFieldType.WholeNumber;
        var isMulti = multi || (definition.Type == AssessmentFieldType.Text && definition.MaximumLength > 500);
        <div class="fc @extraClass @(editable ? null : "ro")" data-field="@path">
            @if (editable)
            {
                <label for="@id">@label@(tag?.Render())</label>
            }
            else
            {
                <span class="lbl">@label@(tag?.Render())</span>
            }
            <div class="fv @(mono ? "mono" : null) @(isMulti ? "multi" : null) @(absent ? "empty" : null) @(radios && !editable ? "sr-only" : null)">@Model.AssessmentDisplay(path)</div>
            @if (editable)
            {
                if (definition.Type == AssessmentFieldType.Flag)
                {
                    <select id="@id" class="fi" name="@name" form="case-edit-form">
                        <option value="" selected="@(value is null)"></option>
                        <option value="true" selected="@(value == "true")">Yes</option>
                        <option value="false" selected="@(value == "false")">No</option>
                    </select>
                }
                else if (definition.Type == AssessmentFieldType.Enumerated)
                {
                    <select id="@id" class="fi" name="@name" form="case-edit-form">
                        <option value="" selected="@(value is null)"></option>
                        @foreach (var code in definition.Codes ?? [])
                        {
                            <option value="@code" selected="@(value == code)">@Pegasus.Web.Pages.Cases.DetailsModel.CodeWords(code)</option>
                        }
                    </select>
                }
                else if (isMulti)
                {
                    <textarea id="@id" class="fi" name="@name" form="case-edit-form" maxlength="@definition.MaximumLength">@value</textarea>
                }
                else
                {
                    <input id="@id" class="fi @(mono ? "mono" : null)" name="@name" form="case-edit-form" value="@value"
                           type="@(definition.Type == AssessmentFieldType.Date ? "date" : mono ? "number" : "text")"
                           step="@(definition.Type == AssessmentFieldType.Money ? "0.01" : definition.Type == AssessmentFieldType.WholeNumber ? "1" : null)"
                           maxlength="@(definition.Type == AssessmentFieldType.Text ? definition.MaximumLength : null)" />
                }
            }
            @if (radios && editable)
            {
                @* P29: the codes as a radio group, in the cell beside the
                   label. The select above stays the posted control; script
                   shows this group and hides the select, so without script
                   the select is what the operator uses. *@
                <div class="radiorow" role="radiogroup" aria-label="@label" data-decision-radios="@path" hidden>
                    <button type="button" class="pick-radio" role="radio" aria-checked="@(value is null ? "true" : "false")" tabindex="@(value is null ? "0" : "-1")" data-radio-value=""><span class="dot"></span>@OperatorLabels.CaseWorkspace.AbsentValue</button>
                    @foreach (var code in definition.Codes ?? [])
                    {
                        <button type="button" class="pick-radio" role="radio" aria-checked="@(value == code ? "true" : "false")" tabindex="@(value == code ? "0" : "-1")" data-radio-value="@code"><span class="dot"></span>@Pegasus.Web.Pages.Cases.DetailsModel.CodeWords(code)</button>
                    }
                </div>
            }
            else if (radios)
            {
                @* Reading, the same group draws greyed and still: the choice
                   reads where it is made (23 September 2026). The value box
                   above carries the words for assistive technology. *@
                <div class="radiorow is-static" aria-hidden="true" data-decision-radios-read="@path">
                    <span class="pick-radio" data-on="@(value is null ? "true" : "false")"><span class="dot"></span>@OperatorLabels.CaseWorkspace.AbsentValue</span>
                    @foreach (var code in definition.Codes ?? [])
                    {
                        <span class="pick-radio" data-on="@(value == code ? "true" : "false")"><span class="dot"></span>@Pegasus.Web.Pages.Cases.DetailsModel.CodeWords(code)</span>
                    }
                </div>
            }
        </div>
    }
}
