@using Pegasus.Core.Assessment
@using Pegasus.Web.Presentation
@using EngineerLabels = Pegasus.Web.Presentation.OperatorLabels.CaseWorkspace.EngineerSections
@model Pegasus.Web.Pages.Cases.DetailsModel

<section class="panel" aria-labelledby="section-damage-title">
    <div class="panel-head"><h2 id="section-damage-title">@EngineerLabels.Damage</h2></div>
    <div class="panel-body">
        <dl class="detail-list">
            <div><dt>@EngineerLabels.ImpactLocation</dt><dd>@Model.AssessmentValue(AssessmentVocabulary.ImpactLocation)</dd></div>
            <div><dt>@EngineerLabels.ImpactSeverity</dt><dd>@Model.AssessmentValue(AssessmentVocabulary.ImpactSeverity)</dd></div>
            <div><dt>@EngineerLabels.IncidentNarrative</dt><dd>@Model.AssessmentValue(AssessmentVocabulary.NatureOfIncident)</dd></div>
        </dl>
    </div>
</section>
