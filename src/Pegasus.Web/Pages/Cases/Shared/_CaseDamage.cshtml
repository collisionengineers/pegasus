@*
    Damage (v46, operator, 3 November 2026): impacts entered by hand and
    damage markers for the report's picture only. The workbench is the
    top-down plan of the recorded Vehicle type: the car, the van or the
    motorbike. While the section edits, pressing and dragging on the vehicle
    sizes a marker and dragging a marker moves it; Clear markers removes them
    all. A marker is a position only, drawn as the one yellow comic burst
    (28 September 2026), unclipped and unnumbered, here and on the report, and
    kept as drawn, no wider than the vehicle. Beside the plan, staff enter the
    impacts: one row each, Impact · Severity · Location · Note · Clear, added
    with Add impact. Nothing is derived from the markers. The Incident
    narrative is the report's Nature of Incident: a sentence for each impact
    naming a severity and a location, each its own line with a line's space
    between them (v47). Read and edit share one geometry: the rows stand in
    the same places, values reading where controls edit. The Case's images
    live only under Files.

    Skip impacts (v47, operator, 3 November 2026; R647–R649): the report needs
    an impact or the deliberate skip. The tick stands beside Add impact while
    no row exists, and ticking it greys out Add impact; a row hides it. While
    reading with no row it is a static tick. With no row the empty state sits
    on the facts' own left edge.
*@
@using System.Globalization
@using System.Text.Json
@using Pegasus.Core.Assessment
@using Pegasus.Core.Cases
@using Pegasus.Web.Presentation
@using DamageLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Damage
@using EngineerLabels = Pegasus.Web.Presentation.OperatorLabels.CaseWorkspace.EngineerSections
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var details = Model.Case!;
    var editable = Model.SectionIsEditable("damage") && details.Data is not null;
    var rawMarkers = Model.AssessmentEditorValue(AssessmentVocabulary.DamageMarkers) ?? "[]";
    IReadOnlyList<DamageDisc> markers;
    try
    {
        markers = AssessmentPolicy.ParseMarkers(rawMarkers);
    }
    catch (Exception exception) when (exception is JsonException or ArgumentException)
    {
        markers = [];
    }
    var rawImpacts = Model.AssessmentEditorValue(AssessmentVocabulary.Impacts) ?? "[]";
    IReadOnlyList<AssessmentImpact> impacts;
    try
    {
        impacts = AssessmentPolicy.ParseImpacts(rawImpacts);
    }
    catch (Exception exception) when (exception is JsonException or ArgumentException)
    {
        impacts = [];
    }
    var mayEditImpacts = editable && Model.CanEditAssessmentField(AssessmentVocabulary.Impacts);
    var impactsSkipped = impacts.Count == 0
        && Model.AssessmentEditorValue(AssessmentVocabulary.ImpactsSkipped) == "true";
    var skipName = CaseWorkspaceLabels.Editors.FormName(AssessmentVocabulary.ImpactsSkipped);
    var damageFields = CaseWorkspaceLabels.Editors.Damage;
    var headTools = new Pegasus.Web.Pages.Cases.CaseSectionHeadView(Model, "damage");
    var profile = DamagePlanGeometry.ProfileFor(Model.AssessmentEditorValue(AssessmentVocabulary.VehicleType));

    string Svg(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}

<section class="record-section record-section--nested panel @Model.CollapsedClass("case.damage") case-damage @(Model.IsEditing && !editable ? "is-locked" : null)" id="section-damage" data-section="damage" data-section-parent="vehicle" data-collapse="case.damage" aria-labelledby="section-damage-title"
         data-damage-editor data-damage-editable="@(editable ? "true" : "false")" data-damage-markers="@rawMarkers"
         data-damage-plan="@DamageEditorTables.PlanTable" data-damage-narrative-table="@DamageEditorTables.NarrativeTable"
         data-damage-narrative-follows="@(Model.IncidentNarrativeFollowsImpacts ? "true" : "false")"
         data-damage-absent="@OperatorLabels.CaseWorkspace.AbsentValue">
    <div class="panel-head">
        <h2 id="section-damage-title">@EngineerLabels.Damage</h2>
        <div class="panel-actions"><partial name="Cases/Shared/_CaseSectionHeadTools" model="headTools" /></div>
    </div>
    <div class="panel-body stack">
        @if (editable)
        {
            <input type="hidden" id="case-damage-markers" name="damageMarkers" form="case-edit-form" value="@rawMarkers" data-damage-input />
        }
        <div class="damage-workbench">
            <div class="damage-view" data-damage-view data-field="@AssessmentVocabulary.DamageMarkers">
                <svg class="damage-diagram" viewBox="@DamagePlanGeometry.ViewBox" role="group" aria-label="@DamageLabels.DiagramLabel">
                    <text class="damage-diagram-label" x="120" y="8" text-anchor="middle">@DamageLabels.Front</text>
                    @Html.Raw(DamagePlanGeometry.Artwork(profile))
                    @* Where a press starts a new marker: the drawing's own outline. *@
                    <g class="dv-hit" aria-hidden="true">
                        @foreach (var hitPath in DamagePlanGeometry.HitPaths(profile))
                        {
                            <path d="@hitPath" />
                        }
                    </g>
                    @if (editable)
                    {
                        <g class="dm-guides" aria-hidden="true"><path d="@DamagePlanGeometry.GuidesPath" /></g>
                    }
                    @* Each marker is its burst over an unpainted disc: the disc
                       catches the press that moves it; the burst may spill past
                       the outline. *@
                    <g class="damage-marks" data-damage-marks aria-hidden="true">
                        @for (var index = 0; index < markers.Count; index++)
                        {
                            var disc = DamagePlanGeometry.Disc(markers[index]);
                            <g class="dm" data-mark="@index"><circle class="area" cx="@Svg(disc.CentreX)" cy="@Svg(disc.CentreY)" r="@Svg(disc.Radius)" /><path class="burst" d="@DamagePlanGeometry.BurstPath(disc)" fill="@DamageBurst.Fill" fill-opacity="@DamageBurst.FillOpacity.ToString(CultureInfo.InvariantCulture)" stroke="@DamageBurst.Line" stroke-width="@Svg(DamageBurst.LineWidth)" stroke-linejoin="round" /></g>
                        }
                    </g>
                    <text class="damage-diagram-label" x="120" y="431" text-anchor="middle">@DamageLabels.Rear</text>
                </svg>
                @if (editable)
                {
                    <div class="damage-extra">
                        <button type="button" class="btn" data-damage-clear-markers><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg><span>@DamageLabels.ClearMarkers</span></button>
                    </div>
                }
            </div>
            <div class="damage-facts">
                <div class="impact-entry" data-impacts data-field="@AssessmentVocabulary.Impacts">
                    @if (mayEditImpacts)
                    {
                        <input type="hidden" name="@CaseWorkspaceLabels.Editors.FormName(AssessmentVocabulary.Impacts)" form="case-edit-form" value="@rawImpacts" data-impacts-input />
                    }
                    <div class="impact-entry-head" aria-hidden="true" hidden="@(impacts.Count == 0)" data-impacts-head>
                        <span></span><span class="lbl">@DamageLabels.Severity</span><span class="lbl">@DamageLabels.Location</span><span class="lbl">@DamageLabels.Note</span><span></span>
                    </div>
                    <div class="impact-entry-rows" data-impacts-rows>
                        @foreach (var impact in impacts)
                        {
                            await ImpactRow(impact, mayEditImpacts);
                        }
                    </div>
                    <p class="muted impact-entry-empty" hidden="@(impacts.Count > 0)" data-impacts-empty>@DamageLabels.NoDamageRecorded</p>
                    @if (mayEditImpacts)
                    {
                        <div class="impact-entry-foot">
                            <span></span>
                            <button type="button" class="btn impact-entry-add" disabled="@impactsSkipped" data-impacts-add><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-plus")" /></svg><span>@DamageLabels.AddImpact</span></button>
                            <label class="choice impact-entry-skip" hidden="@(impacts.Count > 0)" data-field="@AssessmentVocabulary.ImpactsSkipped" data-impacts-skip>
                                <input type="checkbox" name="@skipName" value="true" form="case-edit-form" checked="@impactsSkipped" />
                                <input type="hidden" name="@skipName" value="false" form="case-edit-form" />
                                <span>@DamageLabels.SkipImpacts</span>
                            </label>
                        </div>
                        <template data-impacts-template>@{ await ImpactRow(new AssessmentImpact(string.Empty, string.Empty, string.Empty), true); }</template>
                    }
                    else if (impacts.Count == 0)
                    {
                        <div class="impact-entry-foot impact-entry-foot--read">
                            <span></span>
                            <span class="choice is-static impact-entry-skip" data-on="@(impactsSkipped ? "true" : "false")">
                                <span class="tick">
                                    @if (impactsSkipped)
                                    {
                                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-check")" /></svg>
                                    }
                                </span>
                                <span>@DamageLabels.SkipImpacts</span>
                            </span>
                        </div>
                    }
                </div>
                <div class="fg g4 mt-2">
                    @{
                        var unrelated = Model.AssessmentEditorValue(AssessmentVocabulary.DamageUnrelated);
                        var unrelatedRead = Model.AssessmentValue(AssessmentVocabulary.DamageUnrelated);
                        var mayEditUnrelated = Model.CanEditAssessmentField(AssessmentVocabulary.DamageUnrelated);
                    }
                    @* The tyres, belts, airbags, material transfer and the unrelated-damage
                       deduction are gone (operator, 9 October 2026): no document printed
                       them. Unrelated damage takes the row alone. *@
                    <div class="fc span4 @(mayEditUnrelated ? null : "ro")" data-field="@AssessmentVocabulary.DamageUnrelated">
                        @{ Lbl(mayEditUnrelated, "edit-" + AssessmentVocabulary.DamageUnrelated, damageFields[AssessmentVocabulary.DamageUnrelated]); }
                        <div class="fv @(unrelatedRead == OperatorLabels.CaseWorkspace.AbsentValue ? "empty" : null)">@unrelatedRead</div>
                        @if (mayEditUnrelated)
                        {
                            <input id="edit-@AssessmentVocabulary.DamageUnrelated" class="fi" name="@CaseWorkspaceLabels.Editors.FormName(AssessmentVocabulary.DamageUnrelated)" form="case-edit-form" value="@unrelated" maxlength="@AssessmentVocabulary.Definitions[AssessmentVocabulary.DamageUnrelated].MaximumLength" />
                        }
                    </div>
                    <div class="fc ro span4"><span class="lbl">@EngineerLabels.IncidentNarrative</span><div class="fv derived @(Model.IncidentNarrative is null ? "empty" : null) @(Model.IncidentNarrative?.Contains('\n') == true ? "multi" : null)" data-damage-narrative>@if (Model.IncidentNarrative is { } narrative) { foreach (var line in narrative.Split('\n')) { <span class="fv-line">@line</span> } } else { @OperatorLabels.CaseWorkspace.AbsentValue }</div></div>
                </div>
            </div>
        </div>
    </div>
</section>

@functions {
    // The cell's label: a real <label> for the control while it edits, the
    // same words as a plain caption otherwise.
    private void Lbl(bool editable, string id, string text)
    {
        if (editable)
        {
            <label for="@id">@text</label>
        }
        else
        {
            <span class="lbl">@text</span>
        }
    }

    // One impact: its value reads where its control edits, so read and edit
    // share the row. Blank stays blank until chosen (v46 item L).
    private async Task ImpactRow(AssessmentImpact impact, bool editable)
    {
        var severity = impact.Severity.Length == 0 ? string.Empty : DamageLabels.SeverityWord(impact.Severity);
        var location = impact.Location.Length == 0 ? string.Empty : DamageLabels.LocationWord(impact.Location);
        <div class="impact-entry-row" data-impact-row>
            <span class="impact-entry-label">@DamageLabels.Impact</span>
            <span class="fc @(editable ? null : "ro")" data-caption="@DamageLabels.Severity">
                <div class="fv @(severity.Length == 0 ? "empty" : null)">@severity</div>
                @if (editable)
                {
                    <select class="fi" aria-label="@DamageLabels.Severity" data-impact-severity>
                        <option value=""></option>
                        @foreach (var option in AssessmentVocabulary.DamageSeverities.OrderBy(entry => entry.Value.Rank))
                        {
                            <option value="@option.Key" selected="@(option.Key == impact.Severity)">@option.Value.Display</option>
                        }
                    </select>
                }
            </span>
            <span class="fc @(editable ? null : "ro")" data-caption="@DamageLabels.Location">
                <div class="fv @(location.Length == 0 ? "empty" : null)">@location</div>
                @if (editable)
                {
                    <select class="fi" aria-label="@DamageLabels.Location" data-impact-location>
                        <option value=""></option>
                        @foreach (var code in AssessmentVocabulary.DamageAreaCodes)
                        {
                            <option value="@code" selected="@(code == impact.Location)">@AssessmentVocabulary.DamageAreas[code]</option>
                        }
                    </select>
                }
            </span>
            <span class="fc @(editable ? null : "ro")" data-caption="@DamageLabels.Note">
                <div class="fv @(impact.Note.Length == 0 ? "empty" : null)">@impact.Note</div>
                @if (editable)
                {
                    <input class="fi" maxlength="200" aria-label="@DamageLabels.Note" value="@impact.Note" data-impact-note />
                }
            </span>
            <button type="button" class="icon-button impact-entry-clear" aria-label="@DamageLabels.Clear" title="@DamageLabels.Clear" disabled="@(!editable)" data-impact-clear><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg></button>
        </div>
    }
}
