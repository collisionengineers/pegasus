@*
    Damage (v28 P5, ruled 20 September 2026): damage by area. The workbench is
    the top-down plan silhouette. While the section edits, pressing and
    dragging on the vehicle sizes a disc and dragging a disc moves it; each
    disc is one recorded damage naming the plan areas under it, with a
    severity and a note. Underside, Interior and Mechanical are chips, each
    recorded alone. Impact location and severity derive from the areas. Core
    keeps the areas only: a disc is drawn from its areas (DamageAreaGeometry),
    here and on the report. The page reads without script: the discs, the
    list and the derived cells are rendered here from the recorded impacts,
    and script keeps them in step while the section edits; Reset returns to
    the values held when the edit opened. The Case's images live only under
    Files.
*@
@using System.Globalization
@using System.Text.Json
@using Pegasus.Core.Assessment
@using Pegasus.Core.Cases
@using Pegasus.Web.Presentation
@using DamageLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Damage
@using EngineerLabels = Pegasus.Web.Presentation.OperatorLabels.CaseWorkspace.EngineerSections
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var editable = Model.SectionIsEditable("damage") && details.Data is not null;
    var rawImpacts = Model.AssessmentEditorValue(AssessmentVocabulary.DamageImpacts) ?? "[]";
    IReadOnlyList<AssessmentImpact> impacts;
    try
    {
        impacts = AssessmentPolicy.ParseImpacts(rawImpacts);
    }
    catch (Exception exception) when (exception is JsonException or ArgumentException)
    {
        impacts = [];
    }
    var damageFields = CaseWorkspaceLabels.Editors.Damage;
    var headTools = new Pegasus.Web.Pages.Cases.CaseSectionHeadView(Model, "damage");
    // The vocabulary and the plan the editor works with, handed to script once
    // so the browser holds no second copy of the areas, the bands or the
    // severity table.
    var areaTable = JsonSerializer.Serialize(new
    {
        plan = AssessmentVocabulary.DamagePlanAreas,
        other = AssessmentVocabulary.DamageOtherAreas,
        names = AssessmentVocabulary.DamageAreas,
        centres = DamageAreaGeometry.Centres.ToDictionary(
            entry => entry.Key,
            entry => new { x = entry.Value.X, y = entry.Value.Y }),
        canonical = new
        {
            w = DamageAreaGeometry.CanonicalWidth,
            h = DamageAreaGeometry.CanonicalHeight,
            margin = DamageAreaGeometry.Margin
        },
        box = new { x = DamagePlanGeometry.PlanLeft, y = DamagePlanGeometry.PlanTop, w = DamagePlanGeometry.PlanWidth, h = DamagePlanGeometry.PlanHeight },
        bands = new { front = DamageAreaGeometry.FrontBand, rear = DamageAreaGeometry.RearBand, left = DamageAreaGeometry.LeftBand, right = DamageAreaGeometry.RightBand },
        radius = DamageAreaGeometry.BaseRadius
    });
    var severityTable = JsonSerializer.Serialize(AssessmentVocabulary.DamageSeverities
        .OrderBy(entry => entry.Value.Rank)
        .Select(entry => new { k = entry.Key, n = entry.Value.Display }));

    // The derived cells follow Core's rule: one distinct area reads as itself,
    // more than one reads "Multiple · a, b"; the severity is the highest rank
    // recorded.
    var recordedAreas = impacts
        .SelectMany(impact => impact.Areas)
        .Distinct(StringComparer.Ordinal)
        .OrderBy(AssessmentVocabulary.DamageAreaOrder)
        .ToArray();
    var locationText = recordedAreas.Length == 0
        ? OperatorLabels.CaseWorkspace.AbsentValue
        : recordedAreas.Length == 1
            ? DamageLabels.Location(recordedAreas[0])
            : DamageLabels.Multiple + " · " + string.Join(", ", recordedAreas.Select(DamageLabels.Location));
    var severityText = impacts.Count == 0
        ? OperatorLabels.CaseWorkspace.AbsentValue
        : DamageLabels.SeverityWord(impacts
            .Select(impact => impact.Severity)
            .OrderByDescending(code => AssessmentVocabulary.DamageSeverities.TryGetValue(code, out var severity) ? severity.Rank : -1)
            .First());

    string AreaNames(IReadOnlyList<string> codes) => string.Join(", ", codes.Select(DamageLabels.Location));
    string Svg(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
    string DisplayValue(string path, string? value)
    {
        var definition = AssessmentVocabulary.Definitions[path];
        if (string.IsNullOrWhiteSpace(value)) return OperatorLabels.CaseWorkspace.AbsentValue;
        if (definition.Type == AssessmentFieldType.Enumerated) return DamageLabels.CodeWord(value);
        if (definition.Type == AssessmentFieldType.Money
            && decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var money))
        {
            return "£" + money.ToString("N2", CultureInfo.GetCultureInfo("en-GB"));
        }
        return value;
    }
}

<section class="record-section record-section--nested panel @Model.CollapsedClass("case.damage") @Model.ActiveTabClass("damage") case-damage @(Model.IsEditing && !editable ? "is-locked" : null)" id="section-damage" data-section="damage" data-section-parent="vehicle" data-collapse="case.damage" aria-labelledby="section-damage-title"
         data-damage-editor data-damage-editable="@(editable ? "true" : "false")" data-damage-impacts="@rawImpacts"
         data-damage-areas="@areaTable" data-damage-severities="@severityTable" data-damage-multiple="@DamageLabels.Multiple"
         data-damage-absent="@OperatorLabels.CaseWorkspace.AbsentValue" data-damage-none="@DamageLabels.NoDamageRecorded"
         data-damage-no-note="@DamageLabels.NoNote" data-damage-note-label="@DamageLabels.Note" data-damage-remove-label="@DamageLabels.Remove"
         data-damage-grade-label="@DamageLabels.Severity">
    <div class="panel-head">
        <h2 id="section-damage-title">@EngineerLabels.Damage</h2>
        <div class="panel-actions"><partial name="Cases/Shared/_CaseSectionHeadTools" model="headTools" /></div>
    </div>
    <div class="panel-body stack">
        @if (editable)
        {
            <input type="hidden" id="case-damage-impacts" name="damageImpacts" form="case-edit-form" value="@rawImpacts" data-damage-input />
        }
        <div class="damage-workbench">
            <div class="damage-view" data-damage-view>
                <svg class="damage-diagram" viewBox="@DamagePlanGeometry.ViewBox" role="group" aria-label="@DamageLabels.DiagramLabel">
                    <defs>
                        <clipPath id="damage-plan-clip"><path d="@DamagePlanGeometry.BodyPath" /></clipPath>
                        <linearGradient id="damage-plan-body" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff" /><stop offset="1" stop-color="#eaeef0" /></linearGradient>
                        <linearGradient id="damage-plan-glass" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#d7dfe4" /><stop offset="1" stop-color="#b9c5cc" /></linearGradient>
                        <filter id="damage-plan-shadow" x="-20%" y="-10%" width="140%" height="130%"><feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#1a2a33" flood-opacity=".16" /></filter>
                    </defs>
                    <text class="damage-diagram-label" x="120" y="8" text-anchor="middle">@DamageLabels.Front</text>
                    @foreach (var wheel in DamagePlanGeometry.Wheels)
                    {
                        <rect class="dv-wheel" x="@(wheel.CentreX - 8)" y="@(wheel.CentreY - 24)" width="16" height="48" rx="5" />
                    }
                    @foreach (var mirror in DamagePlanGeometry.Mirrors)
                    {
                        <rect class="dv-mirror" x="@mirror.X" y="@mirror.Y" width="@mirror.Width" height="@mirror.Height" rx="4" />
                    }
                    <path class="dv-body" d="@DamagePlanGeometry.BodyPath" fill="url(#damage-plan-body)" filter="url(#damage-plan-shadow)" />
                    <path class="dv-glass" fill="url(#damage-plan-glass)" d="@DamagePlanGeometry.FrontGlassPath" />
                    <path class="dv-glass" fill="url(#damage-plan-glass)" d="@DamagePlanGeometry.RearGlassPath" />
                    <path class="dv-seam" d="@DamagePlanGeometry.SeamPath" />
                    <path class="dv-seam dv-seam--soft" d="@DamagePlanGeometry.SoftSeamPath" />
                    @foreach (var lamp in DamagePlanGeometry.FrontLampPaths)
                    {
                        <path class="dv-lamp" d="@lamp" />
                    }
                    @foreach (var lamp in DamagePlanGeometry.RearLampPaths)
                    {
                        <path class="dv-lamp dv-lamp--rear" d="@lamp" />
                    }
                    @if (editable)
                    {
                        <g class="dm-guides" aria-hidden="true"><path d="@DamagePlanGeometry.GuidesPath" /></g>
                        @foreach (var area in AssessmentVocabulary.DamagePlanAreas)
                        {
                            var centre = DamageAreaGeometry.Centres[area];
                            var centreX = DamagePlanGeometry.PlanLeft + centre.X * DamagePlanGeometry.PlanWidth;
                            var centreY = DamagePlanGeometry.PlanTop + centre.Y * DamagePlanGeometry.PlanHeight;
                            <g class="damage-plan-area" role="button" tabindex="0" data-damage-plan-area="@area" aria-label="@DamageLabels.Location(area)">
                                <circle class="damage-plan-area-hit" cx="@Svg(centreX)" cy="@Svg(centreY)" r="12" />
                            </g>
                        }
                    }
                    <g class="damage-marks" data-damage-marks aria-hidden="true">
                        @for (var index = 0; index < impacts.Count; index++)
                        {
                            var disc = DamagePlanGeometry.Disc(impacts[index].Areas);
                            if (disc is null)
                            {
                                continue;
                            }
                            <g class="dm" data-mark="@index" data-sev="@impacts[index].Severity"><circle class="area" cx="@Svg(disc.CentreX)" cy="@Svg(disc.CentreY)" r="@Svg(disc.Radius)" /><circle class="n" r="8" cx="@Svg(disc.CentreX)" cy="@Svg(disc.CentreY)" /><text x="@Svg(disc.CentreX)" y="@Svg(disc.CentreY + 3.2)" text-anchor="middle">@(index + 1)</text></g>
                        }
                    </g>
                    <text class="damage-diagram-label" x="120" y="431" text-anchor="middle">@DamageLabels.Rear</text>
                </svg>
                <div class="dv-readout" data-damage-readout aria-live="polite"></div>
                @if (editable)
                {
                    <button type="button" class="btn btn--small" data-damage-reset><svg class="icon" aria-hidden="true"><use href="#icon-refresh-cw" /></svg><span>@DamageLabels.Reset</span></button>
                }
                <div class="dv-legend" aria-label="@DamageLabels.Severity">
                    @foreach (var severity in AssessmentVocabulary.DamageSeverities.OrderBy(entry => entry.Value.Rank))
                    {
                        <span><i data-sev="@severity.Key"></i>@severity.Value.Display</span>
                    }
                </div>
                <div class="damage-extra" aria-label="@DamageLabels.OtherAreas">
                    @foreach (var extra in AssessmentVocabulary.DamageOtherAreas)
                    {
                        var recorded = impacts.Any(impact => impact.Areas.Contains(extra));
                        <button type="button" class="btn btn--small @(recorded ? "is-damaged" : null)" data-damage-area="@extra" aria-pressed="@(recorded ? "true" : "false")">@DamageLabels.Location(extra)</button>
                    }
                </div>
            </div>
            <div class="damage-facts">
                <div class="fg g3">
                    <div class="fc ro"><span class="lbl">@EngineerLabels.ImpactLocation</span><div class="fv derived" data-damage-location>@locationText</div></div>
                    <div class="fc ro"><span class="lbl">@EngineerLabels.ImpactSeverity</span><div class="fv derived" data-damage-severity>@severityText</div></div>
                    <div class="fc ro"><span class="lbl">@DamageLabels.RecordedAreas</span><div class="fv" data-damage-count>@impacts.Count</div></div>
                </div>
                <ul class="impact-list" data-damage-impact-list aria-label="@DamageLabels.RecordedAreas">
                    @if (impacts.Count == 0)
                    {
                        <li class="muted" data-damage-empty>@DamageLabels.NoDamageRecorded</li>
                    }
                    @for (var index = 0; index < impacts.Count; index++)
                    {
                        var impact = impacts[index];
                        <li class="impact-row @(editable && impact.Areas.Any(AssessmentVocabulary.DamagePlanAreas.Contains) ? "impact-row--areas" : null)" data-damage-row="@index">
                            <span class="zc"><i class="zn">@(index + 1)</i>@AreaNames(impact.Areas)</span>
                            @if (editable && impact.Areas.Any(AssessmentVocabulary.DamagePlanAreas.Contains))
                            {
                                <fieldset class="damage-area-set" data-damage-area-set>
                                    <legend>Areas for impact @(index + 1)</legend>
                                    @foreach (var area in AssessmentVocabulary.DamagePlanAreas)
                                    {
                                        <label><input type="checkbox" value="@area" checked="@(impact.Areas.Contains(area))" data-damage-area-choice />@DamageLabels.Location(area)</label>
                                    }
                                </fieldset>
                            }
                            <span class="fc">
                                @if (editable)
                                {
                                    <label class="sr-only" for="damage-severity-@index">@DamageLabels.Severity</label>
                                }
                                <div class="fv">@DamageLabels.SeverityWord(impact.Severity)</div>
                                @if (editable)
                                {
                                    <select id="damage-severity-@index" class="fi" data-damage-row-severity>
                                        @foreach (var severity in AssessmentVocabulary.DamageSeverities.OrderBy(entry => entry.Value.Rank))
                                        {
                                            <option value="@severity.Key" selected="@(severity.Key == impact.Severity)">@severity.Value.Display</option>
                                        }
                                    </select>
                                }
                            </span>
                            <span class="fc">
                                @if (editable)
                                {
                                    <label class="sr-only" for="damage-note-@index">@DamageLabels.Note</label>
                                }
                                <div class="fv @(string.IsNullOrWhiteSpace(impact.Note) ? "empty" : null)">@(string.IsNullOrWhiteSpace(impact.Note) ? DamageLabels.NoNote : impact.Note)</div>
                                @if (editable)
                                {
                                    <input id="damage-note-@index" class="fi" maxlength="200" value="@impact.Note" placeholder="@DamageLabels.Note" data-damage-row-note />
                                }
                            </span>
                            @if (editable)
                            {
                                <button type="button" class="del" data-damage-row-remove aria-label="@DamageLabels.Remove @AreaNames(impact.Areas)">×</button>
                            }
                        </li>
                    }
                </ul>
                <div class="sub-panel mt-2"><h3>@DamageLabels.TyresAndBelts</h3>
                    <div class="fg g4">
                        @foreach (var field in damageFields.Where(entry => entry.Key != AssessmentVocabulary.DamageUnrelated && entry.Key != AssessmentVocabulary.DamageUnrelatedDeduction))
                        {
                            var definition = AssessmentVocabulary.Definitions[field.Key];
                            var value = Model.AssessmentEditorValue(field.Key);
                            var recorded = Model.AssessmentValue(field.Key) == OperatorLabels.CaseWorkspace.AbsentValue ? null : Model.AssessmentValue(field.Key);
                            var name = CaseWorkspaceLabels.Editors.FormName(field.Key);
                            var mayEditField = Model.CanEditAssessmentField(field.Key);
                            var span = field.Key == AssessmentVocabulary.DamageMaterialTransfer ? "span2" : null;
                            <div class="fc @span">
                                @if (mayEditField)
                                {
                                    <label for="edit-@field.Key">@field.Value</label>
                                }
                                else
                                {
                                    <span class="lbl">@field.Value</span>
                                }
                                <div class="fv @(recorded is null ? "empty" : null)">@DisplayValue(field.Key, recorded)</div>
                                @if (mayEditField)
                                {
                                    if (definition.Type == AssessmentFieldType.Enumerated)
                                    {
                                        <select id="edit-@field.Key" class="fi" name="@name" form="case-edit-form">
                                            <option value="" selected="@(value is null)"></option>
                                            @foreach (var code in definition.Codes ?? [])
                                            {
                                                <option value="@code" selected="@(value == code)">@DamageLabels.CodeWord(code)</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input id="edit-@field.Key" class="fi" name="@name" form="case-edit-form" value="@value" maxlength="@definition.MaximumLength" />
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="fg g4 mt-2">
                    @{
                        var unrelated = Model.AssessmentEditorValue(AssessmentVocabulary.DamageUnrelated);
                        var unrelatedRead = Model.AssessmentValue(AssessmentVocabulary.DamageUnrelated);
                        var deduction = Model.AssessmentEditorValue(AssessmentVocabulary.DamageUnrelatedDeduction);
                        var deductionRead = Model.AssessmentValue(AssessmentVocabulary.DamageUnrelatedDeduction);
                        var mayEditUnrelated = Model.CanEditAssessmentField(AssessmentVocabulary.DamageUnrelated);
                        var mayEditDeduction = Model.CanEditAssessmentField(AssessmentVocabulary.DamageUnrelatedDeduction);
                    }
                    <div class="fc span3">
                        @if (mayEditUnrelated)
                        {
                            <label for="edit-@AssessmentVocabulary.DamageUnrelated">@damageFields[AssessmentVocabulary.DamageUnrelated]</label>
                            <div class="fv @(unrelatedRead == OperatorLabels.CaseWorkspace.AbsentValue ? "empty" : null)">@unrelatedRead</div>
                            <input id="edit-@AssessmentVocabulary.DamageUnrelated" class="fi" name="@CaseWorkspaceLabels.Editors.FormName(AssessmentVocabulary.DamageUnrelated)" form="case-edit-form" value="@unrelated" maxlength="@AssessmentVocabulary.Definitions[AssessmentVocabulary.DamageUnrelated].MaximumLength" />
                        }
                        else
                        {
                            <span class="lbl">@damageFields[AssessmentVocabulary.DamageUnrelated]</span>
                            <div class="fv @(unrelatedRead == OperatorLabels.CaseWorkspace.AbsentValue ? "empty" : null)">@unrelatedRead</div>
                        }
                    </div>
                    <div class="fc">
                        @if (mayEditDeduction)
                        {
                            <label for="edit-@AssessmentVocabulary.DamageUnrelatedDeduction">@damageFields[AssessmentVocabulary.DamageUnrelatedDeduction]</label>
                            <div class="fv mono @(deductionRead == OperatorLabels.CaseWorkspace.AbsentValue ? "empty" : null)">@DisplayValue(AssessmentVocabulary.DamageUnrelatedDeduction, deductionRead == OperatorLabels.CaseWorkspace.AbsentValue ? null : deductionRead)</div>
                            <input id="edit-@AssessmentVocabulary.DamageUnrelatedDeduction" class="fi mono" name="@CaseWorkspaceLabels.Editors.FormName(AssessmentVocabulary.DamageUnrelatedDeduction)" form="case-edit-form" type="number" step="0.01" min="0" value="@deduction" />
                        }
                        else
                        {
                            <span class="lbl">@damageFields[AssessmentVocabulary.DamageUnrelatedDeduction]</span>
                            <div class="fv mono @(deductionRead == OperatorLabels.CaseWorkspace.AbsentValue ? "empty" : null)">@DisplayValue(AssessmentVocabulary.DamageUnrelatedDeduction, deductionRead == OperatorLabels.CaseWorkspace.AbsentValue ? null : deductionRead)</div>
                        }
                    </div>
                    <div class="fc ro span4"><span class="lbl">@EngineerLabels.IncidentNarrative</span><div class="fv derived @(Model.AssessmentValue(AssessmentVocabulary.NatureOfIncident) == OperatorLabels.CaseWorkspace.AbsentValue ? "empty" : null)" data-damage-narrative>@Model.AssessmentValue(AssessmentVocabulary.NatureOfIncident)</div></div>
                </div>
            </div>
        </div>
    </div>
</section>
