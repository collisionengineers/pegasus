@*
    Valuation (v34, operator, 8 October 2026; one route per source since
    15 September; one look and one Save since 23 September 2026): the sources
    are guide cards in a grid, then the value increases, the deductions, the
    Engineer's Value with the calculation's basis, and On the report.

    Read and edit show the same cards: Glass's, Brego, Super CAP, CAP and
    Cazana each hold that source's latest recorded retail, trade and guide
    month, as text while reading and as inputs in the same place while
    editing. A card carries no mileage: the Case's own is used wherever a
    valuation needs one (operator, 24 September 2026). A card's inputs belong
    to the record's one Save form, #case-edit-form, so the Case's save records
    a changed card (the same source and month replaces); Get valuation asks
    the connected provider by script and fills the boxes, or shows the card's
    notice. A source with no connected provider says so on its card before
    anything is pressed and offers no Get valuation.

    A click anywhere on a card with a retail is the Engineer's decision to use
    it (operator, 8 October 2026): the script chooses it as the basis and
    switches on selection.Use, so the save records the calculation against it
    and writes the report's Retail and Trade from it. The card says "Selected".
    A card with no retail answers the click with the approved sentence. AI
    market research is a card of its own (6 October 2026): its figures, the
    Valuation month it is asked for and its own Get valuation, which starts
    the existing research job.
*@
@model Pegasus.Web.Pages.Cases.DetailsModel
@using System.Globalization
@using Pegasus.Core.Assessment
@using Pegasus.Web.Presentation
@using ValuationLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Valuation
@{
    var section = Model.ValuationSection;
    var workflow = section?.Frame.Workflow ?? Model.Case!.Workflow;
    var caseId = workflow.CaseId;
    var editable = Model.SectionIsEditable("valuation");
    var pending = Model.PendingMarketResearch;
    var headTools = new Pegasus.Web.Pages.Cases.CaseSectionHeadView(Model, "valuation");
    // The five guide sources, each one card (v28 P8, P13).
    var guideSources = new[] { ValuationSource.Glasses, ValuationSource.Brego, ValuationSource.SuperCap, ValuationSource.Cap, ValuationSource.Cazana };
    // Every other recorded card is AI market research's.
    var researchCards = Model.GuideValuations.Where(valuation => !guideSources.Contains(valuation.Details.Source)).ToArray();
    // The card shown as chosen: the calculator's basis while editing, the recorded basis while reading.
    var selectedId = editable ? Model.DefaultBasis?.ValuationId : Model.RecordedValuation?.GuideValuationId;
    // The research job lands on the current work, so the Inspection view does not offer it.
    var researchOffered = editable && !Model.IsInspectionView;
    var researchLabel = ValuationLabels.SourceLabel(ValuationSource.AiMarketResearch);
    var researchSlug = ValuationLabels.SourceSlug(ValuationSource.AiMarketResearch);
    var reportEditable = Model.SectionIsEditable("report") && Model.Case!.Data is not null;

    string GetValuationAction(ValuationSource source) =>
        Url.Page("/Cases/Details", "GetValuation", new { id = caseId, source, view = Model.ViewRoute })!;
    string Figure(decimal? value) => value?.ToString("0.00", CultureInfo.InvariantCulture) ?? string.Empty;
    string Month(DateOnly? month) => month?.ToString("MMM yyyy", CultureInfo.InvariantCulture) ?? ValuationLabels.AbsentGuideMonth;

    // What a recorded research card was asked with: its month, mileage and date.
    string CardMeta(CaseValuation valuation) =>
        Month(valuation.Details.GuideMonth)
        + (valuation.Details.Mileage is { } metaMileage ? " · " + metaMileage.ToString("N0", CultureInfo.InvariantCulture) + " miles" : string.Empty) + " · "
        + valuation.Details.Date.ToString("d MMM yyyy", CultureInfo.InvariantCulture);
}

<section class="record-section record-section--nested panel @Model.CollapsedClass("case.valuation") @(Model.IsEditing && !Model.SectionIsEditable("valuation") ? "is-locked" : null)" id="section-valuation" data-section="valuation" data-section-parent="vehicle" data-collapse="case.valuation" aria-labelledby="section-valuation-title">
    <div class="panel-head">
        <h2 id="section-valuation-title">@ValuationLabels.SectionTitle</h2>
        <span class="meta" data-valuation-head>@Model.ValuationHead</span>
        <div class="panel-actions">
            <partial name="Cases/Shared/_CaseSectionHeadTools" model="headTools" />
        </div>
    </div>
    <div class="panel-body stack">
        <div class="valuation-cards" data-valuation-cards>
            @for (var index = 0; index < guideSources.Length; index++)
            {
                var source = guideSources[index];
                var slug = ValuationLabels.SourceSlug(source);
                var recorded = Model.LatestRecorded(source);
                var selected = recorded is not null && selectedId == recorded.ValuationId;
                var retail = recorded?.Details.RetailValue;
                var trade = recorded?.Details.TradeValue;
                // A card holds exactly what was recorded, in both modes: any
                // box may be blank (operator, 23 September 2026).
                var canBeBasis = recorded is not null && Pegasus.Web.Pages.Cases.DetailsModel.CanBeBasis(recorded);
                var connected = editable && Model.GuideSourceConnected(source);
                var field = "guideEntries[" + index.ToString(CultureInfo.InvariantCulture) + "].";
                var idPrefix = "f-valuation-" + slug + "-";
                @* While editing, a card's boxes join the Case form and the
                   Case's save records a changed card; Get valuation fills them
                   by script. The Basis radio of a recorded card joins the same
                   form; the script checks it when the card is clicked. *@
                <div class="valuation-card entry @(selected ? "sel" : null)"
                     tabindex="@(editable ? "0" : null)"
                     data-valuation-entry="@slug"
                     data-valuation-source-card="@source"
                     data-valuation-card="@(recorded?.ValuationId.ToString("D") ?? slug)"
                     data-retail="@Figure(retail)"
                     data-trade="@Figure(trade)">
                    @if (editable)
                    {
                        <input type="hidden" name="@(field)Source" value="@source" form="case-edit-form" />
                    }
                    <div class="valuation-card-head">
                        <h3>@ValuationLabels.SourceLabel(source)</h3>
                        @if (editable && canBeBasis && recorded is not null)
                        {
                            <label class="pick sr-only">
                                <input type="radio" name="selection.GuideValuationId" value="@recorded.ValuationId"
                                       form="case-edit-form" checked="@(selected ? "checked" : null)"
                                       data-valuation-basis
                                       data-source-name="@ValuationLabels.SourceLabel(source)" />
                                @ValuationLabels.Basis
                            </label>
                        }
                        <span class="valuation-card-word" data-valuation-chosen-word hidden="@(selected ? null : "hidden")">@ValuationLabels.Selected</span>
                    </div>
                    <div class="valuation-card-figs">
                        @{ CardFigure(editable, idPrefix + "retail", ValuationLabels.Retail, retail, field + "RetailValue", "retail");
                            CardFigure(editable, idPrefix + "trade", ValuationLabels.Trade, trade, field + "TradeValue", "trade"); }
                        <div class="valuation-card-fig valuation-card-month">
                            @if (editable)
                            {
                                <label for="@(idPrefix)month">@ValuationLabels.GuideMonth</label>
                                <input id="@(idPrefix)month" class="fi" type="month" name="@(field)GuideMonth" form="case-edit-form" value="@recorded?.Details.GuideMonth?.ToString("yyyy-MM", CultureInfo.InvariantCulture)" data-valuation-entry-month />
                            }
                            else
                            {
                                <span class="lbl">@ValuationLabels.GuideMonth</span>
                                <span class="valuation-card-value @(recorded?.Details.GuideMonth is null ? "is-blank" : null)">@(recorded?.Details.GuideMonth is { } guideMonth ? Month(guideMonth) : "—")</span>
                            }
                        </div>
                    </div>
                    @if (connected)
                    {
                        @* Get valuation stands at the card's foot, centred, on every
                           card that has it (v36 item M, 9 October 2026). *@
                        <div class="valuation-card-foot">
                            <button type="button" class="btn btn--small" data-valuation-get data-busy-label="@OperatorLabels.Busy.LookingUp" data-busy-done="@OperatorLabels.Busy.Done.Valued" data-valuation-source="@slug"
                                    data-valuation-url="@GetValuationAction(source)"><span>@ValuationLabels.GetValuation</span></button>
                        </div>
                    }
                    @if (editable)
                    {
                        @* The card's own answer to Get valuation (operator-approved
                           wording, 23 September 2026): standing where no provider is
                           connected, or shown by script with a refusal's own words.
                           It becomes an alert only when it shows. *@
                        @* Two branches, not a conditional attribute: Razor writes
                           data-valuation-not-connected="" for a null there, and the
                           script would then keep a connected card's notice standing. *@
                        if (connected)
                        {
                            <div class="notice notice--danger valuation-card-note" data-valuation-notice hidden>
                                <span data-valuation-unavailable>@ValuationLabels.UnavailableLead(source)<button type="button" class="link-button" data-dialog-open="problem-dialog">@ValuationLabels.ReportAProblem</button>.</span>
                                <span data-valuation-refused hidden></span>
                            </div>
                        }
                        else
                        {
                            <div class="notice notice--info valuation-card-note" data-valuation-notice data-valuation-not-connected>
                                <span data-valuation-unavailable>@ValuationLabels.UnavailableLead(source)<button type="button" class="link-button" data-dialog-open="problem-dialog">@ValuationLabels.ReportAProblem</button>.</span>
                                <span data-valuation-refused hidden></span>
                            </div>
                        }
                        <div class="notice notice--info valuation-card-note" data-valuation-needs-retail hidden>@ValuationLabels.UseNeedsRetail</div>
                    }
                </div>
            }
            @* AI market research's card: the latest research, or nothing
               recorded yet, and the month and Get valuation that ask for the
               next one. An earlier research card stays as a card of its own.
               While research is in progress the card reads as Researching for
               the job's month in place of the recorded figures: a re-run
               replaces them. The result is filed without the Case edit lease,
               so it returns while the Engineer is still editing. *@
            @for (var row = 0; row < (pending is null ? Math.Max(1, researchCards.Length) : 1); row++)
            {
                var valuation = pending is null && row < researchCards.Length ? researchCards[row] : null;
                var selected = valuation is not null && selectedId == valuation.ValuationId;
                var asks = researchOffered && row == 0;
                var usable = editable && valuation is { Details.RetailValue: > 0m };
                var retail = valuation?.Details.RetailValue;
                var trade = valuation?.Details.TradeValue;
                <div class="valuation-card valuation-card--research @(selected ? "sel" : null) @(pending is null ? null : "is-pending")"
                     tabindex="@(usable ? "0" : null)"
                     data-valuation-pending="@pending?.JobId"
                     data-valuation-card="@(valuation?.ValuationId.ToString("D") ?? researchSlug)"
                     data-valuation-source-card="@ValuationSource.AiMarketResearch"
                     data-retail="@Figure(retail)"
                     data-trade="@Figure(trade)">
                    @if (asks)
                    {
                        @* The research form carries the month, the lease, the
                           version and the operation key; Get valuation runs
                           the existing job for that month. *@
                        <form method="post" asp-page="/Cases/Details" asp-page-handler="StartMarketResearch" asp-route-id="@caseId"
                              id="case-market-research-form" data-valuation-research-form hidden>
                            <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                            <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                            <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                            <input type="hidden" name="view" value="@Model.ViewRoute" />
                        </form>
                    }
                    <div class="valuation-card-head">
                        <h3>@researchLabel</h3>
                        <span class="src-tag src-tag--ai">AI</span>
                        @if (usable)
                        {
                            <label class="pick sr-only">
                                <input type="radio" name="selection.GuideValuationId" value="@valuation!.ValuationId"
                                       form="case-edit-form" checked="@(selected ? "checked" : null)"
                                       data-valuation-basis
                                       data-source-name="@researchLabel" />
                                @ValuationLabels.Basis
                            </label>
                        }
                        <span class="valuation-card-word" data-valuation-chosen-word hidden="@(selected ? null : "hidden")">@ValuationLabels.Selected</span>
                    </div>
                    <div class="valuation-card-figs">
                        @{ CardFigure(false, null, ValuationLabels.Retail, retail, null, null, pending is not null);
                            CardFigure(false, null, ValuationLabels.Trade, trade, null, null, pending is not null); }
                        <div class="valuation-card-fig valuation-card-month">
                            @if (asks)
                            {
                                <label for="f-valuation-month">@ValuationLabels.ValuationMonth</label>
                                <input id="f-valuation-month" class="fi" type="month" name="guideMonth" form="case-market-research-form" value="@Model.ValuationMonth" data-valuation-month />
                            }
                            else if (pending is null && valuation is not null)
                            {
                                <span class="lbl">@ValuationLabels.GuideMonth</span>
                                <span class="valuation-card-value @(valuation.Details.GuideMonth is null ? "is-blank" : null)">@(valuation.Details.GuideMonth is { } researchMonth ? Month(researchMonth) : "—")</span>
                            }
                        </div>
                    </div>
                    @if (asks)
                    {
                        <div class="valuation-card-foot">
                            <button type="submit" data-busy-label="@OperatorLabels.Busy.Starting" form="case-market-research-form" class="btn btn--small" data-valuation-source="@researchSlug"><span>@ValuationLabels.GetValuation</span></button>
                        </div>
                    }
                    @if (pending is not null)
                    {
                        <div class="valuation-card-meta researching">@ValuationLabels.Researching · @Model.PendingMarketResearchMonth</div>
                        @if (editable)
                        {
                            <div class="valuation-card-meta muted" data-valuation-pending-note>@ValuationLabels.ResearchFiledNote</div>
                        }
                    }
                    else if (valuation is not null)
                    {
                        @* What the recorded research was asked with. *@
                        <div class="valuation-card-meta">@CardMeta(valuation)</div>
                    }
                </div>
            }
        </div>

        <partial name="Cases/Shared/_CaseValuationCalculation" model="Model" />

        @* On the report (v28 P38): the three content switches, decided beside
           the valuation they describe, as one line. One cell, so editing shows
           the switches in place of the summary. A checkbox posts "true" ahead
           of its hidden "false", so an unticked switch still records No. *@
        <div class="valuation-report fc @(reportEditable ? null : "ro")" data-field="report-content">
            <span class="lbl">@CaseWorkspaceLabels.Frame.OnTheReport</span>
            <div class="fv" data-report-content>@Model.ReportContentSummary</div>
            @if (reportEditable)
            {
                <div class="fi chk switches" data-report-switches>
                    @foreach (var (path, label) in new[]
                    {
                        (AssessmentVocabulary.ReportDiscloseGuideSource, CaseWorkspaceLabels.Report.DiscloseGuideSource),
                        (AssessmentVocabulary.ReportValuationCommentary, CaseWorkspaceLabels.Report.ValuationCommentary),
                        (AssessmentVocabulary.ReportIncludeUnrelatedDamage, CaseWorkspaceLabels.Report.UnrelatedDamage)
                    })
                    {
                        var switchName = CaseWorkspaceLabels.Editors.FormName(path);
                        <label class="choice">
                            <input type="checkbox" name="@switchName" value="true" form="case-edit-form" checked="@(string.Equals(Model.AssessmentEditorValue(path), "true", StringComparison.OrdinalIgnoreCase) ? "checked" : null)" data-report-switch="@path" />
                            <input type="hidden" name="@switchName" value="false" form="case-edit-form" />
                            <span>@label</span>
                        </label>
                    }
                </div>
            }
        </div>
    </div>
</section>

@functions {
    // One figure line of a card: its label, then the figure as text while
    // reading, or the Case form's box in the same place while editing.
    private void CardFigure(bool editable, string? id, string label, decimal? value, string? name, string? kind, bool pending = false)
    {
        <div class="valuation-card-fig">
            @if (editable)
            {
                <label for="@id">@label</label>
                // A null data-* value still renders as ="", so each box names
                // its own figure in a branch of its own: the script fills the
                // first box that carries the attribute.
                if (kind == "retail")
                {
                    <input id="@id" class="fi mono" type="number" min="0" step="0.01" placeholder="£" name="@name" form="case-edit-form"
                           value="@value?.ToString("0.00", CultureInfo.InvariantCulture)" data-valuation-retail />
                }
                else
                {
                    <input id="@id" class="fi mono" type="number" min="0" step="0.01" placeholder="£" name="@name" form="case-edit-form"
                           value="@value?.ToString("0.00", CultureInfo.InvariantCulture)" data-valuation-trade />
                }
            }
            else
            {
                <span class="lbl">@label</span>
                <span class="valuation-card-value mono @(pending ? "derived" : value is null ? "is-blank" : null)">@(pending || value is null ? "—" : ValuationCalculationPolicy.FormatMoney(value.Value))</span>
            }
        </div>
    }
}
