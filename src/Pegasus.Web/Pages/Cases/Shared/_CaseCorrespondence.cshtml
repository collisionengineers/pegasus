@model Pegasus.Web.Pages.Cases.CaseCorrespondenceView
@using Pegasus.Core.Intake
@using Pegasus.Web.Presentation
@using FilesLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Files
@using Frame = Pegasus.Web.Presentation.CaseWorkspaceLabels.Frame
@{
    var emails = Model.Emails;
}

@* The Files section's Correspondence tab: every retained email
   associated with the Case - polled mail, uploaded .eml files and the Sent
   items of mail Pegasus sent for it. Open message shows the message in
   a dialog over the Case, its content fetched from the Inbox record on
   first open, with the record's Reply, Reply all and Forward for this Case
   where the record offers them; without script the link opens that record.
   Tag as query (operator, 11 October 2026) corrects a received message's
   classification to a query in one click, through the Inbox record's own
   correction, and comes back here. The Case record and the Triage Case both
   draw the tab; only the Case record offers the tag. *@
<div class="correspondence" data-correspondence>
    @if (emails.Count == 0)
    {
        <p class="muted" data-correspondence-empty>@FilesLabels.NoCorrespondence</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--compact">
                <thead>
                    <tr>
                        <th>@OperatorLabels.CaseWorkspace.Received</th>
                        <th>@OperatorLabels.CaseWorkspace.Sender</th>
                        <th>@OperatorLabels.CaseWorkspace.Subject</th>
                        <th>@OperatorLabels.CaseWorkspace.Classification</th>
                        <th><span class="sr-only">Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in emails)
                    {
                        var offersTag = Model.TagAsQueryCaseId is { } tagCaseId
                            && row.Direction == MailDirection.Received
                            && row.ClassificationVersion is { } classificationVersion
                            && row.Classification is not { IsPostReport: true };
                        <tr data-correspondence-row="@row.RetainedMessageId">
                            <td><time datetime="@row.ReceivedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(row.ReceivedAtUtc)</time></td>
                            <td>@(row.EffectiveSenderAddress ?? row.SenderDisplayName ?? row.SenderAddress)</td>
                            <td>@row.Subject</td>
                            @* A Sent item carries no received classification; the
                               scope's own word names its direction instead. *@
                            <td>@(row.Classification is { } classification
                                ? OperatorLabels.MailClassification(classification)
                                : row.Direction == MailDirection.Sent
                                    ? Pegasus.Web.Pages.Mail.IndexModel.FolderLabel(MailFolderScope.Sent)
                                    : OperatorLabels.CaseWorkspace.AbsentValue)</td>
                            <td class="row-actions nowrap">
                                <a class="btn btn--small" asp-page="/Mail/Message" asp-route-id="@row.RetainedMessageId" data-dialog-open="case-message-@row.RetainedMessageId.ToString("N")">@OperatorLabels.CaseWorkspace.OpenMessage</a>
                                @if (offersTag)
                                {
                                    <form method="post" asp-page="/Mail/Message" asp-route-id="@row.RetainedMessageId" asp-page-handler="CorrectClassification"
                                          class="inline-form" data-no-inplace data-tag-as-query="@row.RetainedMessageId">
                                        <input type="hidden" name="ClassificationKey" value="@MailClassificationSelection.QueryKey" />
                                        <input type="hidden" name="ExpectedClassificationVersion" value="@row.ClassificationVersion" />
                                        <input type="hidden" name="CorrectionReason" value="@MailClassificationSelection.TaggedAsQueryReason" />
                                        <input type="hidden" name="ReturnCaseId" value="@Model.TagAsQueryCaseId" />
                                        <button type="submit" class="btn btn--small" data-busy-label="@OperatorLabels.Busy.Tagging">@Frame.TagAsQuery</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @foreach (var row in emails)
        {
            <partial name="Cases/Shared/_CaseMessageDialog" model="@(new Pegasus.Web.Pages.Cases.CaseMessageDialogView(row, Model.CaseReference))" />
        }
    }
</div>
