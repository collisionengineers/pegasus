@model Pegasus.Web.Pages.Cases.CaseCorrespondenceView
@using Pegasus.Core.Intake
@using Pegasus.Web.Presentation
@using FilesLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Files
@using Frame = Pegasus.Web.Presentation.CaseWorkspaceLabels.Frame
@{
    var emails = Model.Emails;
}

@* The Files section's Correspondence tab: every retained email
   associated with the Case - polled mail, uploaded .eml files and the Sent
   items of mail Pegasus sent for it. The Subject opens the message in a
   dialog over the Case; without script the link opens that record. Open
   query, once the report is sent, opens a query on a received e-mail that
   holds none. The Case record and the Triage Case both draw the tab; only
   the Case record offers Open query. *@
<div class="correspondence" data-correspondence>
    @if (emails.Count == 0)
    {
        <p class="muted" data-correspondence-empty>@FilesLabels.NoCorrespondence</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--compact">
                <thead>
                    <tr>
                        <th>@OperatorLabels.CaseWorkspace.Received</th>
                        <th>@OperatorLabels.CaseWorkspace.Sender</th>
                        <th>@OperatorLabels.CaseWorkspace.Subject</th>
                        <th>@OperatorLabels.CaseWorkspace.Type</th>
                        <th><span class="sr-only">Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in emails)
                    {
                        var offersOpen = Model.OpenQueryCaseId is not null
                            && !row.IsSent
                            && row.Query is null;
                        <tr data-correspondence-row="@row.RetainedMessageId">
                            <td><time datetime="@row.ReceivedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(row.ReceivedAtUtc)</time></td>
                            <td>@(row.EffectiveSenderAddress ?? row.SenderDisplayName ?? row.SenderAddress)</td>
                            <td class="wrap">
                                <a class="correspondence-subject-link" asp-page="/Mail/Message" asp-route-id="@row.RetainedMessageId" data-dialog-open="case-message-@row.RetainedMessageId.ToString("N")">@(string.IsNullOrWhiteSpace(row.Subject) ? OperatorLabels.CaseWorkspace.AbsentValue : row.Subject)</a>
                            </td>
                            @* A Sent item carries no received classification; the
                               scope's own word names its direction instead. *@
                            <td>
                                @(row.Classification is { } classification
                                    ? OperatorLabels.MailClassification(classification)
                                    : row.IsSent
                                        ? Pegasus.Web.Pages.Mail.IndexModel.FolderLabel(MailFolderScope.Sent)
                                        : OperatorLabels.Inbox.Correspondence)
                                @if (row.Query is { } query)
                                {
                                    <partial name="Shared/_StatusChip" model="@(query.IsOpen ? CaseWorkspaceLabels.Queries.Open : CaseWorkspaceLabels.Queries.Done)" />
                                }
                            </td>
                            <td class="row-actions nowrap">
                                <span class="cluster">
                                    @if (offersOpen)
                                    {
                                        <form method="post" asp-page="/Cases/Details" asp-route-id="@Model.OpenQueryCaseId" asp-page-handler="OpenQuery" class="inline-form" data-open-query="@row.RetainedMessageId">
                                            <input type="hidden" name="retainedMessageId" value="@row.RetainedMessageId" />
                                            <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                                            <input type="hidden" name="section" value="files" />
                                            <button class="btn btn--small" type="submit" data-busy-label="@OperatorLabels.Busy.Saving">@Frame.OpenQuery</button>
                                        </form>
                                    }
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @foreach (var row in emails)
        {
            <partial name="Cases/Shared/_CaseMessageDialog" model="@(new Pegasus.Web.Pages.Cases.CaseMessageDialogView(row, Model.CaseReference))" />
        }
    }
</div>
