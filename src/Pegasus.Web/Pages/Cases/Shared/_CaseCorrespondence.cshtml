@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Intake
@using Pegasus.Web.Presentation
<section class="section-gap" aria-labelledby="case-queries-title">
    <div class="blockhead">
        <h2 id="case-queries-title">@OperatorLabels.MailOperationalDestinationLabel(MailOperationalDestination.Queries)</h2>
        @if (Model.StaffMailAvailable)
        {
            <a class="btn" asp-page="/Mail/Compose" asp-route-caseReference="@Model.Case!.Summary.Reference">
                <svg class="icon" aria-hidden="true"><use href="#icon-send" /></svg>
                <span>Compose</span>
            </a>
        }
    </div>
    @if (Model.Case!.QueryEmails.Count == 0)
    {
        <p class="muted">No retained correspondence is associated with this Case.</p>
    }
    else
    {
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>@OperatorLabels.CaseWorkspace.Received</th>
                    <th>@OperatorLabels.CaseWorkspace.Sender</th>
                    <th>@OperatorLabels.CaseWorkspace.Subject</th>
                    <th>@OperatorLabels.CaseWorkspace.Classification</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Case!.QueryEmails)
                {
                    <tr>
                        <td><time datetime="@row.ReceivedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(row.ReceivedAtUtc)</time></td>
                        <td>@(row.EffectiveSenderAddress ?? row.SenderDisplayName ?? row.SenderAddress)</td>
                        <td>@row.Subject</td>
                        <td>@OperatorLabels.MailClassification(row.Classification)</td>
                        <td><a asp-page="/Mail/Message" asp-route-id="@row.RetainedMessageId">@OperatorLabels.CaseWorkspace.OpenMessage</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
</section>
