@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Intake
@using Pegasus.Web.Presentation
@using FilesLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Files
@{
    var emails = Model.FilesSection?.CorrespondenceEmails ?? [];
    var summary = Model.CurrentSummary!;
}

@* The Files section's Correspondence tab: every retained email
   associated with the Case - polled mail and uploaded .eml files - and
   Compose where staff mail is available. Open message shows the message in
   a dialog over the Case, its content fetched from the Inbox record on
   first open, with the record's Reply, Reply all and Forward for this Case
   where the record offers them; without script the link opens that record. *@
<div class="correspondence" data-correspondence>
    @if (Model.StaffMailAvailable)
    {
        <div class="button-row">
            <a class="btn btn--small" asp-page="/Mail/Compose" asp-route-caseReference="@summary.Reference" data-compose>
                <svg class="icon" aria-hidden="true"><use href="#icon-send" /></svg>
                <span>@FilesLabels.Compose</span>
            </a>
        </div>
    }
    @if (emails.Count == 0)
    {
        <p class="muted" data-correspondence-empty>@FilesLabels.NoCorrespondence</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--compact">
                <thead>
                    <tr>
                        <th>@OperatorLabels.CaseWorkspace.Received</th>
                        <th>@OperatorLabels.CaseWorkspace.Sender</th>
                        <th>@OperatorLabels.CaseWorkspace.Subject</th>
                        <th>@OperatorLabels.CaseWorkspace.Classification</th>
                        <th><span class="sr-only">Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in emails)
                    {
                        <tr data-correspondence-row="@row.RetainedMessageId">
                            <td><time datetime="@row.ReceivedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(row.ReceivedAtUtc)</time></td>
                            <td>@(row.EffectiveSenderAddress ?? row.SenderDisplayName ?? row.SenderAddress)</td>
                            <td>@row.Subject</td>
                            <td>@(row.Classification is { } classification ? OperatorLabels.MailClassification(classification) : OperatorLabels.CaseWorkspace.AbsentValue)</td>
                            <td class="row-actions nowrap"><a class="btn btn--small" asp-page="/Mail/Message" asp-route-id="@row.RetainedMessageId" data-dialog-open="case-message-@row.RetainedMessageId.ToString("N")">@OperatorLabels.CaseWorkspace.OpenMessage</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @foreach (var row in emails)
        {
            var dialogId = $"case-message-{row.RetainedMessageId:N}";
            <div id="@dialogId" class="dialog-backdrop" data-dialog="@dialogId" data-case-message-dialog
                 data-case-message-url="@Url.Page("/Mail/Message", "Content", new { id = row.RetainedMessageId, correspondenceCaseReference = summary.Reference })" hidden>
                <section class="dialog dialog--wide" role="dialog" aria-modal="true" aria-labelledby="@dialogId-title">
                    <div class="dialog-head">
                        <h2 id="@dialogId-title" class="wrap" tabindex="-1">@Pegasus.Web.Pages.Mail.IndexModel.SubjectLine(row.Subject)</h2>
                        <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                            <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                        </button>
                    </div>
                    <div class="dialog-body" data-case-message-body aria-busy="true">
                        <div class="spinner" aria-hidden="true"></div>
                    </div>
                    <div class="dialog-foot" data-case-message-foot>
                        <a class="btn btn--dark" asp-page="/Mail/Message" asp-route-id="@row.RetainedMessageId" data-case-message-record>
                            <svg class="icon" aria-hidden="true"><use href="#icon-external-link" /></svg>
                            <span>@OperatorLabels.Inbox.OpenFullMessage</span>
                        </a>
                    </div>
                </section>
            </div>
        }
    }
</div>
