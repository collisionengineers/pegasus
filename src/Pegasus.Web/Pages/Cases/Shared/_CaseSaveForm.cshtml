@*
    The record's one Save form, #case-edit-form, and the hidden fields the
    other sections' controls join by their form attribute. The Overview
    renders it in place, and a commit answered in place renders it again so
    the script can carry the new authority into the one the operator keeps
    typing in. It stands wherever Case data edits.
*@
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var workflow = Model.Case!.Workflow;
    var data = Model.Case.Data;
}
@if (Model.CanEditCaseData && data is not null)
{
    @* Submitted workspace sections retain unshown accepted values;
       these hidden controls also use Confirmed then Fact, never the
       suggestion fallback. `vehicleMileage`, `vehicleMileageUnit`,
       `inspectionAddress` and the assessment fields are not hidden
       here: each has one visible control in its own section,
       associated with this form. *@
    @* A commit consumes the version, lease and operation key it carries;
       the script copies each carry-forward input from the response into
       this form, which stays on the page while the operator edits. *@
    <form method="post" asp-page="/Cases/Details" asp-page-handler="Save"
          asp-route-id="@workflow.CaseId" id="case-edit-form" data-edit-save>
        <input type="hidden" name="id" value="@workflow.CaseId" />
        <input type="hidden" name="expectedVersion" value="@workflow.Version" data-carry-forward />
        <input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" data-carry-forward />
        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" data-carry-forward />
        <input type="hidden" name="section" value="@Model.Section" data-case-section-field />
        <input type="hidden" name="inspectionDeadline" value="@(Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data!.Inspection.Deadline)?.Value.ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="inspectionMode" value="@(Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data!.Inspection.Mode)?.Value)" />
    </form>
}
