@*
    Queries: every query raised on the Case, open ones first, then the Done
    ones. A mail query's Subject opens the message. Assigned to is the compact
    assignee control; Take assigns the viewer. Row actions are Reply and Mark
    done, Mark done, or Reopen. No edit lease.
*@
@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Notifications
@using Pegasus.Core.Workflow
@using Pegasus.Web.Presentation
@using QueryLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Queries
@{
    var section = Model.QueriesSection;
    var workflow = section?.Frame.Workflow ?? Model.Case!.Workflow;
    var caseId = workflow.CaseId;
    var reference = workflow.Identity.Reference;
    var queries = section?.Queries ?? [];
    var open = queries.Where(query => query.IsOpen).ToArray();
    var done = queries.Where(query => !query.IsOpen).ToArray();
    var viewer = Model.AssignEngineerChoices?.ViewerStaffId;
    var assignees = Model.AssignEngineerChoices;
}

<section class="record-section panel @Model.CollapsedClass("case.queries")" id="section-queries" data-section="queries" data-collapse="case.queries" aria-labelledby="section-queries-title">
    <div class="panel-head">
        <h2 id="section-queries-title">Queries</h2>
        <div class="panel-actions">
            <partial name="Cases/Shared/_CaseSectionHeadTools" model='new Pegasus.Web.Pages.Cases.CaseSectionHeadView(Model, "queries")' />
        </div>
    </div>
    <div class="panel-body stack" data-case-queries>
        @if (open.Length == 0)
        {
            <p class="muted" data-queries-empty>@QueryLabels.Empty</p>
        }
        @if (queries.Count > 0)
        {
            <div class="table-wrap">
                <table class="table table--compact" data-queries-table>
                    <thead>
                        <tr>
                            <th>@QueryLabels.State</th>
                            <th>@QueryLabels.Raised</th>
                            <th>@QueryLabels.RaisedBy</th>
                            <th>@CaseWorkspaceLabels.Frame.Channel</th>
                            <th>@QueryLabels.Message</th>
                            <th>@QueryLabels.AssignedTo</th>
                            <th>@QueryLabels.Done</th>
                            <th><span class="sr-only">Action</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var query in open.Concat(done))
                        {
                            var currentAssignee = query.AssigneeStaffId?.ToString("D") ?? "unassigned";
                            <tr data-case-query="@query.Id" data-case-query-open="@(query.IsOpen ? "true" : "false")">
                                <td><partial name="Shared/_StatusChip" model="@(query.IsOpen ? QueryLabels.Open : QueryLabels.Done)" /></td>
                                <td><time datetime="@query.RaisedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(query.RaisedAtUtc)</time></td>
                                <td>@query.RaisedByDisplayName</td>
                                <td>@(query.Source == CaseQuerySource.Mail
                                    ? CaseWorkspaceLabels.Queries.Channel(CaseQueryChannel.Email)
                                    : query.Channel is { } channel ? CaseWorkspaceLabels.Queries.Channel(channel) : OperatorLabels.CaseWorkspace.AbsentValue)</td>
                                <td class="wrap">
                                    @if (query.Message is { } message)
                                    {
                                        <a class="query-subject-link" asp-page="/Mail/Message" asp-route-id="@message.RetainedMessageId" data-dialog-open="case-message-@message.RetainedMessageId.ToString("N")">@(string.IsNullOrWhiteSpace(message.Subject) ? OperatorLabels.CaseWorkspace.AbsentValue : message.Subject)</a>
                                        <br />
                                        <span>@(message.EffectiveSenderAddress ?? message.SenderDisplayName ?? message.SenderAddress)</span>
                                    }
                                    else
                                    {
                                        @(string.IsNullOrWhiteSpace(query.Details) ? OperatorLabels.CaseWorkspace.AbsentValue : query.Details)
                                    }
                                </td>
                                <td>
                                    @if (query.IsOpen && assignees is not null)
                                    {
                                        <span class="query-assignee-control">
                                            <button type="button" class="btn btn--small" data-dialog-open="case-assign-query-dialog" data-assign-query="@query.Id" data-assign-current="@currentAssignee">
                                                <span>@(query.AssignedTo ?? QueryLabels.Unassigned)</span>
                                                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-chevron-down")" /></svg>
                                            </button>
                                            @if (viewer is { } takeId && query.AssigneeStaffId != takeId)
                                            {
                                                <form method="post" asp-page="/Cases/Details" asp-route-id="@caseId" asp-page-handler="AssignQuery" class="inline-form" data-take-query="@query.Id">
                                                    <input type="hidden" name="queryId" value="@query.Id" />
                                                    <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                                                    <input type="hidden" name="assignee" value="@takeId" />
                                                    <button type="submit" class="btn btn--small" data-busy-label="@OperatorLabels.Busy.Assigning">@QueryLabels.Take</button>
                                                </form>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        @(query.AssignedTo ?? QueryLabels.Unassigned)
                                    }
                                </td>
                                <td>
                                    @if (query.ClosedAtUtc is { } closedAt)
                                    {
                                        <time datetime="@closedAt.ToString("O")">@OperatorLabels.OfficeTime(closedAt)</time>
                                        <br />
                                        <span>@query.ClosedByDisplayName</span>
                                    }
                                    else
                                    {
                                        @OperatorLabels.CaseWorkspace.AbsentValue
                                    }
                                </td>
                                <td class="row-actions">
                                    <span class="cluster">
                                        @if (query.IsOpen && query.Message is { } row && Model.StaffMailAvailable)
                                        {
                                            <a class="btn btn--small" asp-page="/Mail/Index" asp-route-open="@row.RetainedMessageId" asp-route-compose="reply" asp-route-correspondenceCaseReference="@reference" asp-route-markQueryDone="true" data-query-reply="@row.RetainedMessageId">@OperatorLabels.StaffMail.Reply</a>
                                        }
                                        @if (query.IsOpen)
                                        {
                                            <form method="post" asp-page="/Cases/Details" asp-route-id="@caseId" asp-page-handler="MarkQueryDone" class="inline-form" data-mark-query-done="@query.Id">
                                                <input type="hidden" name="queryId" value="@query.Id" />
                                                <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                                                <button class="btn btn--small" type="submit" data-busy-label="@OperatorLabels.Busy.Saving">@QueryLabels.MarkDone</button>
                                            </form>
                                        }
                                        else if (query.ClosedAs == CaseQueryClosure.Resolved && workflow.Archive is null && !Pegasus.Core.Lifecycle.CaseLifecycleRules.IsTerminal(workflow.State))
                                        {
                                            <form method="post" asp-page="/Cases/Details" asp-route-id="@caseId" asp-page-handler="ReopenQuery" class="inline-form" data-reopen-query="@query.Id">
                                                <input type="hidden" name="queryId" value="@query.Id" />
                                                <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                                                <button class="btn btn--small" type="submit" data-busy-label="@OperatorLabels.Busy.Saving">@QueryLabels.Reopen</button>
                                            </form>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @foreach (var query in queries.Where(query => query.Message is not null))
            {
                <partial name="Cases/Shared/_CaseMessageDialog" model="@(new Pegasus.Web.Pages.Cases.CaseMessageDialogView(query.Message!, reference))" />
            }
        }
    </div>
</section>
