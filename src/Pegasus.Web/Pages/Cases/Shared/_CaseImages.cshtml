@model Pegasus.Web.Pages.Cases.DetailsModel
@using System.Globalization
@using Microsoft.AspNetCore.Html
@using Pegasus.Core.Documents
@using Pegasus.Web.Pages.Cases
@using Pegasus.Web.Presentation
@using TagLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.ImageTags
@using ReportImageLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.ReportImages
@using FilesLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Files
@{
    var workflow = Model.CurrentWorkflow!;
    var leaseToken = Model.RenderLeaseToken;
    var mayEdit = Model.CanEditCaseData;
    var mayPrepareImages = Model.MayPrepareImages;
    // The Case's own image files: one grid, from the same current-file rule the
    // Documents tab reads. Custody does not filter it: an image still being
    // stored, or whose storage failed, is on the Case and draws as the
    // placeholder tile.
    var vocabulary = Model.TagVocabulary;
    // v28 P50: whether the report uses an image and its order live on its
    // tile, with the count of what the report uses under the grid. The tag
    // decides how an image in the report prints (operator, 26 September
    // 2026), so the tile has no role of its own. Only an image that can
    // print is counted: one still being stored joins when it confirms.
    var printableCount = Model.AssetPreparations.Count(item => item.CanPrint);
    // Each tile's order number is where it prints, so an image nobody has
    // ordered shows its place at once. The Overview and the Close-up hold
    // places 1 and 2 by their tags (operator, 7 October 2026).
    var reportImages = Model.ReportImagesByOccurrence;
    var images = Model.ReportOrderedCaseImageFiles(reportImages);
    var includedCount = reportImages.Count;

    // The tile is the image's preparation card (v26 § Crop and tag): the crop
    // taken on the viewer stage, the Report section's card and this tile all
    // stage into the same one Case form, so a crop taken anywhere is the crop
    // the report shows.
    IHtmlContent? PreparationMetadata(CaseAssetPreparation? item, PreparedReportImage? placed, bool placeFixed, string previewHref) =>
        item is null || !mayPrepareImages ? null : new HtmlString($"""data-preparation-card="" data-preparation-occurrence="{item.OccurrenceId:D}" data-preparation-version="{item.PreparationVersion}" data-preparation-in-report="{(item.InReport ? "true" : "false")}" data-preparation-order="{placed?.Order?.ToString(CultureInfo.InvariantCulture) ?? string.Empty}" data-preparation-fixed="{(placeFixed ? "true" : "false")}" data-preparation-rotation="{(int)item.Rotation}" data-preparation-crop-left="{item.Crop.Left.ToString(CultureInfo.InvariantCulture)}" data-preparation-crop-top="{item.Crop.Top.ToString(CultureInfo.InvariantCulture)}" data-preparation-crop-width="{item.Crop.Width.ToString(CultureInfo.InvariantCulture)}" data-preparation-crop-height="{item.Crop.Height.ToString(CultureInfo.InvariantCulture)}" data-preparation-full-page="{(item.FullPage ? "true" : "false")}" data-preparation-preview="{previewHref}""" + "\"");
}

@if (images.Count == 0 && Model.ImageIntakes.Count == 0)
{
    <p class="muted" data-images-empty>@FilesLabels.NoImages</p>
}
else
{
    <ul class="thumbs image-grid" data-evidence-set data-image-grid>
        @foreach (var file in images)
        {
            var occurrence = file.Occurrence;
            var version = file.Version;
            if (version.CustodyStatus != DocumentCustodyStatus.Confirmed)
            {
                @* The image is on the Case but its bytes are not readable:
                   still arriving, or storage failed. The tile names the file
                   and its state and offers nothing that would act on content
                   that cannot be read. *@
                <li class="image-tile" data-image-tile="@occurrence.Id">
                    <span class="gallery-item th th--placeholder" data-gallery-placeholder>
                        <span class="gallery-caption">
                            <strong>@version.FileName</strong>
                            <small>@(version.CustodyStatus == DocumentCustodyStatus.Failed ? FilesLabels.StorageNotReady : OperatorLabels.CustodyState(version.CustodyStatus))</small>
                        </span>
                    </span>
                </li>
                continue;
            }

            var previewHref = Model.PreviewUrl(file);
            var downloadHref = Model.DownloadUrl(file);
            var thumbnailHref = Model.ThumbnailUrl(file);
            var preparation = Model.PreparationFor(occurrence.Id);
            var placed = reportImages.GetValueOrDefault(occurrence.Id);
            var placeFixed = placed is { Role: not CaseAssetReportRole.Supporting };
            var mayCrop = mayPrepareImages && preparation is not null;
            var isRotated = preparation is not null && preparation.Rotation != CaseAssetRotation.None;
            var rotationBadge = isRotated ? ((int)preparation!.Rotation).ToString(CultureInfo.InvariantCulture) + "°" : string.Empty;
            var firstTag = occurrence.Tags.FirstOrDefault();
            var visibleTags = occurrence.Tags.Take(TagLabels.VisibleChips).ToArray();
            var hiddenTagCount = occurrence.Tags.Count - visibleTags.Length;
            <li class="image-tile@(mayEdit ? " image-tile--tools" : null)" data-image-tile="@occurrence.Id" @PreparationMetadata(preparation, placed, placeFixed, previewHref)>
                <a href="@previewHref"
                   class="th"
                   data-evidence-item
                   data-download-href="@downloadHref"
                   data-media-type="@version.MediaType"
                   data-file-name="@version.FileName"
                   data-thumb="@thumbnailHref"
                   data-tag="@firstTag?.Name"
                   data-evidence-occurrence="@occurrence.Id"
                   data-evidence-preparation-occurrence="@(mayCrop ? occurrence.Id.ToString() : null)">
                    <img src="@thumbnailHref" alt="@version.FileName" loading="lazy" data-gallery-image />
                    @if (firstTag is not null)
                    {
                        <span class="tag">@firstTag.Name</span>
                    }
                    <span class="rot" data-tile-rotation hidden="@(isRotated ? null : "hidden")">@rotationBadge</span>
                    <span class="th-name">@version.FileName</span>
                </a>
                @if (mayEdit)
                {
                    @* While editing, the tile's tools are one panel under the
                       image: the report decision and its order, then one
                       toolbar. In report is posted at once like a tag
                       (operator, 26 September 2026); the viewer's In report
                       box presses it too, and a click on the image opens the
                       viewer (operator, 7 October 2026). The order, the
                       drag handle, Rotate and Full page stage into the one
                       Case form (P41, P50), so they show once the script has
                       seeded them; without script the form below edits them.
                       The Overview's and the Close-up's places are their
                       tags', so their order is read-only and they have no
                       drag handle. *@
                    <div class="image-tile-panel image-tile-actions">
                        @if (preparation is not null)
                        {
                            <div class="image-tile-row">
                                <form method="post" asp-page="/Cases/Custody" asp-route-id="@workflow.CaseId"
                                      asp-page-handler="SetImageInReport" data-image-in-report-form="@occurrence.Id" data-document-action>
                                    <input type="hidden" name="id" value="@workflow.CaseId" />
                                    <input type="hidden" name="occurrenceId" value="@occurrence.Id" />
                                    <input type="hidden" name="inReport" value="@(preparation.InReport ? "false" : "true")" />
                                    <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                                    <input type="hidden" name="operationKey" value="@DetailsModel.NewOperationKey()" />
                                    <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                                    <input type="hidden" name="view" value="@Model.ViewRoute" />
                                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Saving" class="image-tile-toggle" aria-pressed="@(preparation.InReport ? "true" : "false")" data-image-in-report>
                                        <svg class="icon" aria-hidden="true"><use href="@(preparation.InReport ? "#icon-square-check" : "#icon-square")" /></svg>
                                        <span>@ReportImageLabels.InReport</span>
                                    </button>
                                </form>
                                <label class="image-tile-order" title="@ReportImageLabels.Order" data-image-report data-image-order-cell hidden>
                                    <span>@ReportImageLabels.Order</span>
                                    <input class="fi num" type="number" min="1" step="1" value="@placed?.Order" readonly="@placeFixed" data-preparation-order />
                                </label>
                            </div>
                        }
                        <div class="image-tile-row image-tile-toolbar">
                            <partial name="Cases/Shared/_CaseImageTagPicker"
                                     model="@(new CaseImageTagPickerView(
                                         workflow.CaseId,
                                         workflow.Version,
                                         occurrence.Id,
                                         leaseToken,
                                         vocabulary,
                                         occurrence.Tags,
                                         Model.ViewRoute))" />
                            @if (mayCrop)
                            {
                                <button type="button" class="icon-button" data-preparation-crop data-preparation-crop-occurrence="@occurrence.Id" title="@TagLabels.Crop" aria-label="@TagLabels.Crop"><svg class="icon" aria-hidden="true"><use href="#icon-crop" /></svg></button>
                            }
                            @if (preparation is not null)
                            {
                                <span class="image-tile-tools" data-image-report data-image-tools hidden>
                                    <button type="button" class="icon-button" data-preparation-rotate="90" title="@ReportImageLabels.Rotate" aria-label="@ReportImageLabels.Rotate"><svg class="icon" aria-hidden="true"><use href="#icon-rotate-cw" /></svg></button>
                                    <button type="button" class="icon-button" data-image-full-page hidden="@(preparation.InReport ? null : "hidden")" aria-pressed="@(preparation.FullPage ? "true" : "false")" title="@ReportImageLabels.PrintOnItsOwnPage" aria-label="@ReportImageLabels.PrintOnItsOwnPage"><svg class="icon" aria-hidden="true"><use href="#icon-file-image" /></svg></button>
                                </span>
                                @if (!placeFixed)
                                {
                                    <span class="grip" data-image-report hidden draggable="true" title="@ReportImageLabels.DragToReorder" aria-hidden="true"><svg class="icon"><use href="#icon-grip-vertical" /></svg></span>
                                }
                            }
                        </div>
                    </div>
                }
                @if (occurrence.Tags.Count > 0)
                {
                    <span class="tag-chips">
                        @foreach (var tag in visibleTags)
                        {
                            <span class="tag-chip tag-chip--@TagLabels.ColourToken(tag.Colour)">@tag.Name</span>
                        }
                        @if (hiddenTagCount > 0)
                        {
                            <span class="tag-chip tag-chip--more">@TagLabels.MoreChips(hiddenTagCount)</span>
                        }
                    </span>
                }
                @if (!mayEdit)
                {
                    @* Out of edit mode the tile states, in one line, whether
                       the report uses the image, its order and Full page. *@
                    <p class="image-tile-status" data-image-report-read>
                        @if (preparation is { InReport: true })
                        {
                            <span class="image-tile-status-in">@ReportImageLabels.InReport</span>
                            @if (placed?.Order is { } order)
                            {
                                <span>@ReportImageLabels.Order @order</span>
                            }
                            @if (preparation.FullPage)
                            {
                                <span data-image-full-chip>@ReportImageLabels.FullPage</span>
                            }
                        }
                        else
                        {
                            <span>@ReportImageLabels.NotInReport</span>
                        }
                    </p>
                }
                @if (mayPrepareImages && preparation is not null)
                {
                    <noscript>
                        <form method="post" asp-page-handler="Save" asp-route-id="@workflow.CaseId" class="stack">
                            <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                            <input type="hidden" name="operationKey" value="@DetailsModel.NewOperationKey()" />
                            <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                            <input type="hidden" name="view" value="@Model.ViewRoute" />
                            <input type="hidden" name="section" value="files" />
                            <input type="hidden" name="preparationEdits[0].OccurrenceId" value="@occurrence.Id" />
                            <input type="hidden" name="preparationEdits[0].ExpectedPreparationVersion" value="@preparation.PreparationVersion" />
                            <input type="hidden" name="preparationEdits[0].CropLeft" value="@preparation.Crop.Left.ToString(CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="preparationEdits[0].CropTop" value="@preparation.Crop.Top.ToString(CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="preparationEdits[0].CropWidth" value="@preparation.Crop.Width.ToString(CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="preparationEdits[0].CropHeight" value="@preparation.Crop.Height.ToString(CultureInfo.InvariantCulture)" />
                            @if (preparation.InReport)
                            {
                                <label>@ReportImageLabels.Order
                                    <input name="preparationEdits[0].Order" type="number" min="1" step="1" value="@placed?.Order" readonly="@placeFixed" />
                                </label>
                            }
                            <label>@ReportImageLabels.Rotation
                                <select name="preparationEdits[0].Rotation">
                                    @foreach (var rotation in new[] { CaseAssetRotation.None, CaseAssetRotation.Clockwise90, CaseAssetRotation.Half, CaseAssetRotation.Clockwise270 })
                                    {
                                        <option value="@((int)rotation)" selected="@(preparation.Rotation == rotation)">@((int)rotation)°</option>
                                    }
                                </select>
                            </label>
                            <label>@ReportImageLabels.PrintOnItsOwnPage
                                <select name="preparationEdits[0].FullPage">
                                    <option value="false" selected="@(!preparation.FullPage)">No</option>
                                    <option value="true" selected="@(preparation.FullPage)">Yes</option>
                                </select>
                            </label>
                            <button type="submit" data-busy-label="@OperatorLabels.Busy.Saving" class="btn btn--small">Save image preparation</button>
                        </form>
                    </noscript>
                }
            </li>
        }
    </ul>
    <p class="muted image-grid-count"><b data-image-report-count>@ReportImageLabels.InReportCount(includedCount, printableCount)</b></p>

    @* The photographs of a Vehicle images record associated with the Case and
       not yet merged into it, under the record they arrived on. They are not
       Case images yet, so they carry no tags and no preparation here. The
       merge files them as Case images, and the record's group goes. *@
    @foreach (var intake in Model.ImageIntakes)
    {
        var intakeImages = Model.ImagesByIntake.GetValueOrDefault(intake.Id, []);
        <div class="sub-panel intake-group" data-intake-group="@intake.Id">
            <h3>
                <a asp-page="/ImageIntake/Details" asp-route-id="@intake.Id">@FilesLabels.ImageIntake @intake.ImageIntakeReference</a>
                <span class="rt">@intakeImages.Count @FilesLabels.Photographs</span>
            </h3>
            <ul class="thumbs" data-evidence-set>
                @foreach (var item in intakeImages)
                {
                    var href = item.AssetId is { } assetId
                        ? Url.Page("/Intake/Asset", new { id = item.ReceiptId, assetId, v = item.ContentHash })!
                        : Url.Page("/Intake/Image", new { id = item.ReceiptId })!;
                    @* A photograph nobody has prepared is drawn as its rendering at
                       tile size, not the original. One with a crop or rotation recorded
                       on its record keeps the address it always had here, the original,
                       so this page shows it whole, as before: the tile route draws a
                       recorded crop for any tile address, and showing it here is not
                       decided. The link and the download keep the original. *@
                    var tileHref = item.Preparation is { IsPrepared: true }
                        ? href
                        : new GalleryImage(
                            href,
                            href,
                            item.FileName,
                            item.MediaType,
                            IntakeAssetId: item.AssetId,
                            IntakeReceiptId: item.ReceiptId,
                            ContentHash: item.ContentHash).TileHref;
                    <li class="image-tile">
                        <a href="@href"
                           class="th"
                           data-evidence-item
                           data-download-href="@href"
                           data-media-type="@item.MediaType"
                           data-file-name="@item.FileName"
                           data-thumb="@tileHref">
                            <img src="@tileHref" alt="@item.FileName" loading="lazy" data-gallery-image />
                            <span class="th-name">@item.FileName</span>
                        </a>
                        <div class="image-tile-source">
                            <a asp-page="/ImageIntake/Details" asp-route-id="@intake.Id">@intake.ImageIntakeReference</a>
                        </div>
                    </li>
                }
            </ul>
        </div>
    }
}
