@model Pegasus.Web.Pages.Cases.DetailsModel
@using System.Globalization
@using Microsoft.AspNetCore.Html
@using Pegasus.Core.Documents
@using Pegasus.Web.Pages.Cases
@using Pegasus.Web.Presentation
@using TagLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.ImageTags
@using ReportImageLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.ReportImages
@using FilesLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Files
@{
    var workflow = Model.CurrentWorkflow!;
    var leaseToken = Model.RenderLeaseToken;
    var mayEdit = Model.CanEditCaseData;
    var mayPrepareImages = Model.MayPrepareImages;
    // The Case's own image files: one grid, from the same current-file rule the
    // Documents tab reads. Custody does not filter it: an image still being
    // stored, or whose storage failed, is on the Case and draws as the
    // placeholder tile.
    var images = Model.ReportOrderedCaseImageFiles;
    var vocabulary = Model.TagVocabulary;
    // v28 P50: an image's report role and order live on its tile, with the
    // count of what the report uses under the grid. The Report section no
    // longer carries an image surface of its own.
    var reportRoles = new[]
    {
        CaseAssetReportRole.NotUsed, CaseAssetReportRole.CloseUp,
        CaseAssetReportRole.Overview, CaseAssetReportRole.Supporting,
    };
    var preparations = Model.AssetPreparations;
    var includedCount = preparations.Count(item => item.Role != CaseAssetReportRole.NotUsed);

    // The tile is the image's preparation card (v26 § Crop and tag): the crop
    // taken on the viewer stage, the Report section's card and this tile all
    // stage into the same one Case form, so a crop taken anywhere is the crop
    // the report shows.
    IHtmlContent? PreparationMetadata(CaseAssetPreparation? item, string previewHref) =>
        item is null || !mayPrepareImages ? null : new HtmlString($"""data-preparation-card="" data-preparation-occurrence="{item.OccurrenceId:D}" data-preparation-version="{item.PreparationVersion}" data-preparation-role="{item.Role}" data-preparation-order="{item.Order?.ToString(CultureInfo.InvariantCulture) ?? string.Empty}" data-preparation-rotation="{(int)item.Rotation}" data-preparation-crop-left="{item.Crop.Left.ToString(CultureInfo.InvariantCulture)}" data-preparation-crop-top="{item.Crop.Top.ToString(CultureInfo.InvariantCulture)}" data-preparation-crop-width="{item.Crop.Width.ToString(CultureInfo.InvariantCulture)}" data-preparation-crop-height="{item.Crop.Height.ToString(CultureInfo.InvariantCulture)}" data-preparation-full-page="{(item.FullPage ? "true" : "false")}" data-preparation-preview="{previewHref}""" + "\"");
}

@if (images.Count == 0 && Model.ImageIntakes.Count == 0)
{
    <p class="muted" data-images-empty>@FilesLabels.NoImages</p>
}
else
{
    <ul class="thumbs image-grid" data-evidence-set data-image-grid>
        @foreach (var file in images)
        {
            var occurrence = file.Occurrence;
            var version = file.Version;
            if (version.CustodyStatus != DocumentCustodyStatus.Confirmed)
            {
                @* The image is on the Case but its bytes are not readable:
                   still arriving, or storage failed. The tile names the file
                   and its state and offers nothing that would act on content
                   that cannot be read. *@
                <li class="image-tile" data-image-tile="@occurrence.Id">
                    <span class="gallery-item th th--placeholder" data-gallery-placeholder>
                        <span class="gallery-caption">
                            <strong>@version.FileName</strong>
                            <small>@(version.CustodyStatus == DocumentCustodyStatus.Failed ? FilesLabels.StorageNotReady : OperatorLabels.CustodyState(version.CustodyStatus))</small>
                        </span>
                    </span>
                </li>
                continue;
            }

            var previewHref = Model.PreviewUrl(file);
            var downloadHref = Model.DownloadUrl(file);
            var thumbnailHref = Model.ThumbnailUrl(file);
            var preparation = Model.PreparationFor(occurrence.Id);
            var mayCrop = mayPrepareImages && preparation is not null;
            var isRotated = preparation is not null && preparation.Rotation != CaseAssetRotation.None;
            var rotationBadge = isRotated ? ((int)preparation!.Rotation).ToString(CultureInfo.InvariantCulture) + "°" : string.Empty;
            var firstTag = occurrence.Tags.FirstOrDefault();
            var visibleTags = occurrence.Tags.Take(TagLabels.VisibleChips).ToArray();
            var hiddenTagCount = occurrence.Tags.Count - visibleTags.Length;
            <li class="image-tile" data-image-tile="@occurrence.Id" @PreparationMetadata(preparation, previewHref)>
                <a href="@previewHref"
                   class="th"
                   data-evidence-item
                   data-download-href="@downloadHref"
                   data-media-type="@version.MediaType"
                   data-file-name="@version.FileName"
                   data-thumb="@thumbnailHref"
                   data-tag="@firstTag?.Name"
                   data-evidence-preparation-occurrence="@(mayCrop ? occurrence.Id.ToString() : null)">
                    <img src="@thumbnailHref" alt="@version.FileName" loading="lazy" data-gallery-image />
                    @if (firstTag is not null)
                    {
                        <span class="tag">@firstTag.Name</span>
                    }
                    <span class="rot" data-tile-rotation hidden="@(isRotated ? null : "hidden")">@rotationBadge</span>
                    <span class="th-name">@version.FileName</span>
                </a>
                @if (occurrence.Tags.Count > 0)
                {
                    <span class="tag-chips">
                        @foreach (var tag in visibleTags)
                        {
                            <span class="tag-chip tag-chip--@TagLabels.ColourToken(tag.Colour)">@tag.Name</span>
                        }
                        @if (hiddenTagCount > 0)
                        {
                            <span class="tag-chip tag-chip--more">@TagLabels.MoreChips(hiddenTagCount)</span>
                        }
                    </span>
                }
                @* P50: the report role and its order, staged into the one Case
                   form by the same contract the preparation card used. P41 adds
                   the tools beside them. *@
                <div class="image-tile-report" data-image-report hidden="@(mayPrepareImages && preparation is not null ? "hidden" : null)">
                    @if (mayPrepareImages && preparation is not null)
                    {
                        <label class="fc">
                            <span class="lbl">@ReportImageLabels.InReport</span>
                            <select class="fi" data-preparation-role-select aria-label="@ReportImageLabels.Role">
                                @foreach (var role in reportRoles)
                                {
                                    <option value="@role" selected="@(preparation.Role == role ? "selected" : null)">@(role == CaseAssetReportRole.NotUsed ? ReportImageLabels.NotInReport : ReportImageLabels.RoleLabel(role))</option>
                                }
                            </select>
                        </label>
                        <label class="fc" data-image-order-cell hidden="@(preparation.Role == CaseAssetReportRole.Supporting ? null : "hidden")">
                            <span class="lbl">@ReportImageLabels.Order</span>
                            <input class="fi num" type="number" min="1" step="1" value="@preparation.Order" data-preparation-order aria-label="@ReportImageLabels.Order" />
                        </label>
                        <div class="image-tile-tools" data-image-tools>
                            <span class="grip" draggable="true" title="@ReportImageLabels.DragToReorder" aria-hidden="true"><svg class="icon"><use href="#icon-grip-vertical" /></svg></span>
                            <button type="button" class="icon-button" data-preparation-rotate="90" title="@ReportImageLabels.Rotate" aria-label="@ReportImageLabels.Rotate"><svg class="icon" aria-hidden="true"><use href="#icon-rotate-cw" /></svg></button>
                            <button type="button" class="icon-button" data-image-full-page hidden="@(preparation.Role == CaseAssetReportRole.NotUsed ? "hidden" : null)" aria-pressed="@(preparation.FullPage ? "true" : "false")" title="@ReportImageLabels.PrintOnItsOwnPage" aria-label="@ReportImageLabels.FullPage"><svg class="icon" aria-hidden="true"><use href="#icon-image" /></svg></button>
                            <button type="button" class="icon-button" data-image-remove data-undo-title="@ReportImageLabels.ImageRemoved" data-undo-label="@ReportImageLabels.Undo" hidden="@(preparation.Role == CaseAssetReportRole.NotUsed ? "hidden" : null)" title="@ReportImageLabels.Remove" aria-label="@ReportImageLabels.Remove"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
                        </div>
                        <span class="status status--plain status--navy" data-image-full-chip hidden="@(preparation.FullPage ? null : "hidden")">@ReportImageLabels.FullPage</span>
                    }
                    else
                    {
                        <span class="@(preparation is { Role: not CaseAssetReportRole.NotUsed } ? "status status--plain status--navy" : "muted")" data-image-report-read>@(preparation is { Role: not CaseAssetReportRole.NotUsed } included
                            ? ReportImageLabels.RoleLabel(included.Role) + (included.Role == CaseAssetReportRole.Supporting && included.Order is { } order ? " " + order.ToString(CultureInfo.InvariantCulture) : string.Empty)
                            : ReportImageLabels.NotInReport)</span>
                        @if (preparation is { FullPage: true })
                        {
                            <span class="status status--plain status--navy" data-image-full-chip>@ReportImageLabels.FullPage</span>
                        }
                    }
                </div>
                @if (mayPrepareImages && preparation is not null)
                {
                    <noscript>
                        <form method="post" asp-page-handler="Save" asp-route-id="@workflow.CaseId" class="stack">
                            <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                            <input type="hidden" name="operationKey" value="@DetailsModel.NewOperationKey()" />
                            <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                            <input type="hidden" name="section" value="files" />
                            <input type="hidden" name="preparationEdits[0].OccurrenceId" value="@occurrence.Id" />
                            <input type="hidden" name="preparationEdits[0].ExpectedPreparationVersion" value="@preparation.PreparationVersion" />
                            <input type="hidden" name="preparationEdits[0].CropLeft" value="@preparation.Crop.Left.ToString(CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="preparationEdits[0].CropTop" value="@preparation.Crop.Top.ToString(CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="preparationEdits[0].CropWidth" value="@preparation.Crop.Width.ToString(CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="preparationEdits[0].CropHeight" value="@preparation.Crop.Height.ToString(CultureInfo.InvariantCulture)" />
                            <label>@ReportImageLabels.Role
                                <select name="preparationEdits[0].Role">
                                    @foreach (var role in reportRoles)
                                    {
                                        <option value="@role" selected="@(preparation.Role == role)">@ReportImageLabels.RoleLabel(role)</option>
                                    }
                                </select>
                            </label>
                            <label>@ReportImageLabels.Order
                                <input name="preparationEdits[0].Order" type="number" min="1" step="1" value="@preparation.Order" />
                            </label>
                            <label>@ReportImageLabels.Rotation
                                <select name="preparationEdits[0].Rotation">
                                    @foreach (var rotation in new[] { CaseAssetRotation.None, CaseAssetRotation.Clockwise90, CaseAssetRotation.Half, CaseAssetRotation.Clockwise270 })
                                    {
                                        <option value="@((int)rotation)" selected="@(preparation.Rotation == rotation)">@((int)rotation)°</option>
                                    }
                                </select>
                            </label>
                            <label>@ReportImageLabels.PrintOnItsOwnPage
                                <select name="preparationEdits[0].FullPage">
                                    <option value="false" selected="@(!preparation.FullPage)">No</option>
                                    <option value="true" selected="@(preparation.FullPage)">Yes</option>
                                </select>
                            </label>
                            <button type="submit" class="btn btn--small">Save image preparation</button>
                        </form>
                        @if (preparation.Role != CaseAssetReportRole.NotUsed)
                        {
                            <form method="post" asp-page-handler="Save" asp-route-id="@workflow.CaseId">
                                <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                                <input type="hidden" name="operationKey" value="@DetailsModel.NewOperationKey()" />
                                <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                                <input type="hidden" name="section" value="files" />
                                <input type="hidden" name="preparationEdits[0].OccurrenceId" value="@occurrence.Id" />
                                <input type="hidden" name="preparationEdits[0].ExpectedPreparationVersion" value="@preparation.PreparationVersion" />
                                <input type="hidden" name="preparationEdits[0].Role" value="NotUsed" />
                                <input type="hidden" name="preparationEdits[0].Rotation" value="@((int)preparation.Rotation)" />
                                <input type="hidden" name="preparationEdits[0].CropLeft" value="@preparation.Crop.Left.ToString(CultureInfo.InvariantCulture)" />
                                <input type="hidden" name="preparationEdits[0].CropTop" value="@preparation.Crop.Top.ToString(CultureInfo.InvariantCulture)" />
                                <input type="hidden" name="preparationEdits[0].CropWidth" value="@preparation.Crop.Width.ToString(CultureInfo.InvariantCulture)" />
                                <input type="hidden" name="preparationEdits[0].CropHeight" value="@preparation.Crop.Height.ToString(CultureInfo.InvariantCulture)" />
                                <input type="hidden" name="preparationEdits[0].FullPage" value="false" />
                                <button type="submit" class="btn btn--small">Remove from report</button>
                            </form>
                        }
                    </noscript>
                }
                @if (mayEdit)
                {
                    <div class="image-tile-actions">
                        <partial name="Cases/Shared/_CaseImageTagPicker"
                                 model="@(new CaseImageTagPickerView(
                                     workflow.CaseId,
                                     workflow.Version,
                                     occurrence.Id,
                                     leaseToken,
                                     vocabulary,
                                     occurrence.Tags))" />
                        @if (mayCrop)
                        {
                            <button type="button" class="btn btn--small" data-preparation-crop data-preparation-crop-occurrence="@occurrence.Id">@TagLabels.Crop</button>
                        }
                    </div>
                }
            </li>
        }
    </ul>
    <p class="muted image-grid-count"><b data-image-report-count>@ReportImageLabels.InReportCount(includedCount, images.Count)</b></p>

    @* The associated Image-initiated Cases' photographs, each naming the
       intake it arrived on. They are receipts, not case documents, so they
       carry no tags and no preparation. *@
    @foreach (var intake in Model.ImageIntakes)
    {
        var intakeImages = Model.ImagesByIntake.GetValueOrDefault(intake.Id, []);
        <div class="sub-panel intake-group" data-intake-group="@intake.Id">
            <h3>
                <a asp-page="/ImageIntake/Details" asp-route-id="@intake.Id">@FilesLabels.ImageIntake @intake.ImageIntakeReference</a>
                <span class="rt">@intakeImages.Count @FilesLabels.Photographs</span>
            </h3>
            <ul class="thumbs" data-evidence-set>
                @foreach (var item in intakeImages)
                {
                    var href = item.AssetId is { } assetId
                        ? Url.Page("/Intake/Asset", new { id = item.ReceiptId, assetId })!
                        : Url.Page("/Intake/Image", new { id = item.ReceiptId })!;
                    <li class="image-tile">
                        <a href="@href"
                           class="th"
                           data-evidence-item
                           data-download-href="@href"
                           data-media-type="@item.MediaType"
                           data-file-name="@item.FileName"
                           data-thumb="@href">
                            <img src="@href" alt="@item.FileName" loading="lazy" data-gallery-image />
                            <span class="th-name">@item.FileName</span>
                        </a>
                        <div class="image-tile-source">
                            <a asp-page="/ImageIntake/Details" asp-route-id="@intake.Id">@intake.ImageIntakeReference</a>
                        </div>
                    </li>
                }
            </ul>
        </div>
    }
}
