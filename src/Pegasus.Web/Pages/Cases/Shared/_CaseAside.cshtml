@model Pegasus.Web.Pages.Cases.DetailsModel
@using System.Globalization
@using Pegasus.Core.AiWork
@using Pegasus.Core.Assessment
@using Pegasus.Core.Reports
@using Pegasus.Web.Pages.Cases
@using Pegasus.Web.Presentation
@using Frame = Pegasus.Web.Presentation.CaseWorkspaceLabels.Frame
@{
    var workflow = Model.Case!.Workflow;
    var staleGeneration = Model.CurrentReportGeneration is { State: CaseReportGenerationState.Stale };
    var next = Model.NextAction;
    var reportBlockers = Model.ReportNotReadyBlockers;
    var requirements = Model.ReportNotReadyRequirements;
    var engineerValue = Model.EngineerValue;
    var repairCost = Model.RepairCostIncVat;
    const string ReportNotReadyFold = "case.aside.report";
    const string StepButton = "btn next-step-go";
    const string BlockerLink = "blocker-name";
    string FormatMoney(decimal value) => "£" + value.ToString("N2", CultureInfo.GetCultureInfo("en-GB"));
    string SectionLabel(string key) => OperatorLabels.CaseWorkspace.Sections.First(section => section.Key == key).Label;
    var repairSpecLabel = SectionLabel("estimate");
    string RequirementSource(DetailsModel.CaseRequirement requirement) =>
        requirement.Why is { Length: > 0 } why ? $"{requirement.Source} · {why}" : requirement.Source;
    // The blockers under the section that clears each, in page order: the
    // list already runs section by section, so a section's rows sit together.
    // A blocker no section clears comes last, under Accounts where it opens.
    List<(string Key, string? Heading, List<AssessmentReadinessItem> Items)> BlockerGroups()
    {
        var groups = new List<(string Key, string? Heading, List<AssessmentReadinessItem> Items)>();
        foreach (var reason in reportBlockers)
        {
            var section = Model.BlockerSectionKey(reason);
            var key = section ?? (Model.BlockerOpensAccounts(reason) ? "accounts" : "none");
            if (groups.Count == 0 || groups[^1].Key != key)
            {
                var heading = section is not null ? SectionLabel(section) : key == "accounts" ? OperatorLabels.Admin.Accounts : null;
                groups.Add((key, heading, new List<AssessmentReadinessItem>()));
            }
            groups[^1].Items.Add(reason);
        }
        return groups;
    }
}
@* The aside (v25 decision 7): Figures and Next action. Current
   position is gone because the ribbon carries it. Next action is one
   step, beside a stale generation's notice; everything else that stands
   between the Case and its report is the Report not ready card's (v35
   design 8, operator, 8 October 2026). *@
<aside class="workspace-aside" aria-label="Case context" data-case-aside>
    @* Views (v29 option 4): once the Case has its Audit, its two views,
       each named by the reference its report carries; the current one
       plain, the other a link. The Audit row reads the Case's state
       chip exactly as the ribbon does. *@
    @if (Model.Works is { HasAudit: true })
    {
        var inspectionName = $"{Frame.InspectionView} · {workflow.Identity.Reference}";
        var auditName = $"{Frame.AuditView} · {Model.AuditReportReference}";
        <section class="panel context-card" data-case-views>
            <div class="panel-head"><h2>@Frame.Views</h2></div>
            <div class="panel-body stack">
                <div class="next-row" data-case-view-row="inspection">
                    @if (Model.IsInspectionView)
                    {
                        <span aria-current="page">@inspectionName</span>
                    }
                    else
                    {
                        <a asp-page="/Cases/Details" asp-route-id="@workflow.CaseId" asp-route-view="@DetailsModel.InspectionViewKey">@inspectionName</a>
                    }
                    @if (Model.Works?.Primary.ReportSentEvidence is not null)
                    {
                        @* No chip when the Audit was created before the Inspection
                           report was sent (operator, 1 October 2026). *@
                        <span class="status status--plain status--green">@Frame.Sent</span>
                    }
                </div>
                <div class="next-row" data-case-view-row="audit">
                    @if (Model.IsInspectionView)
                    {
                        <a asp-page="/Cases/Details" asp-route-id="@workflow.CaseId">@auditName</a>
                    }
                    else
                    {
                        <span aria-current="page">@auditName</span>
                    }
                    <partial name="Shared/_StatusChip" model="@Model.StateChipText" />
                </div>
            </div>
        </section>
    }
    @* Linked cases (operator, 7 October 2026): every Triage Case linked to
       this Case, its t. Case/PO as a link, its state chip and its current
       finding. Absent while nothing is linked. *@
    @if (Model.Case!.LinkedTriage is { Count: > 0 } linkedTriage)
    {
        <section class="panel context-card" data-case-linked-triage>
            <div class="panel-head"><h2>@Frame.LinkedCases</h2></div>
            <div class="panel-body stack">
                @foreach (var triage in linkedTriage)
                {
                    var finding = string.Join(" · ", new[]
                    {
                        triage.Roadworthiness is { } roadworthiness ? TriageCaseView.RoadworthinessLabel(roadworthiness) : null,
                        triage.Assessment is { } assessment ? TriageCaseView.AssessmentLabel(assessment) : null
                    }.OfType<string>());
                    <div class="next-row" data-case-linked-triage-row="@triage.CaseId.ToString("D")">
                        <a asp-page="/Cases/Details" asp-route-id="@triage.CaseId">@triage.Reference</a>
                        <partial name="Shared/_StatusChip" model="@TriageCaseView.StateLabel(triage.State)" />
                        @if (finding.Length > 0)
                        {
                            <span class="linked-finding">@finding</span>
                        }
                    </div>
                }
            </div>
        </section>
    }
    <section class="panel context-card" data-figures>
        <div class="panel-head"><h2>@Frame.Figures</h2></div>
        <div class="panel-body">
            <dl class="figures">
                @* An absent figure is one glyph in one weight (v36 f06). *@
                <div class="figure figure--big"><dt>@Frame.RepairCostIncVat</dt><dd class="mono @(repairCost is null ? "absent" : null)">@(repairCost is { } cost ? FormatMoney(cost) : "—")</dd></div>
                <div class="figure"><dt>@Frame.EngineersValue</dt><dd class="mono @(engineerValue is null ? "absent" : null)">@(engineerValue is { } ev ? FormatMoney(ev) : "—")</dd></div>
                <div class="figure"><dt>@Frame.RepairCostOfValue</dt><dd class="mono @(repairCost is { } rc && engineerValue is { } evr && evr > 0 ? null : "absent")">@(repairCost is { } c && engineerValue is { } v && v > 0 ? $"{Math.Round(c / v * 100)}%" : "—")</dd></div>
            </dl>
        </div>
    </section>
    <section class="panel context-card" data-next-action>
        <div class="panel-head"><h2>@Frame.NextAction</h2></div>
        <div class="panel-body">
            @foreach (var draft in Model.AiDrafts)
            {
                var (label, action) = draft.Action switch
                {
                    AiDraftAction.ReviewEstimate => (OperatorLabels.AiJobs.AiProposalReady, Frame.ReviewEstimate),
                    AiDraftAction.OpenQuery => ("Query response draft ready", Frame.OpenQuery),
                    _ => ("Unidentified resolution draft ready", Frame.Review)
                };
                <div class="next-row ai-next" data-ai-draft="@draft.Job.JobId">
                    <span><span class="src-tag src-tag--ai">AI</span> @label</span>
                    @if (!string.IsNullOrWhiteSpace(draft.Route))
                    {
                        <a class="btn btn--small btn--primary" href="@draft.Route">@action</a>
                    }
                </div>
            }
            @* FRD-13 "Cancellation messages": while a linked message is currently
               classified a cancellation and the Case is open, the Next action
               names it and opens the message. Hold and Principal cancelled stay
               in the Actions menu; nothing changes by itself. *@
            @if (Model.Case!.CancellationMessageId is { } cancellationMessageId)
            {
                <div class="next-row" data-cancellation-received="@cancellationMessageId">
                    <span>@Frame.CancellationReceived</span>
                    <a class="btn btn--small" asp-page="/Mail/Message" asp-route-id="@cancellationMessageId">@OperatorLabels.CaseWorkspace.OpenMessage</a>
                </div>
            }
            @if (staleGeneration)
            {
                <div class="notice notice--warning" role="status" data-dismissable data-report-stale>
                    <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                    <span>@CaseWorkspaceLabels.ReportDelivery.GenerationStaleNotice</span>
                    <button type="button" class="dismiss" data-dismiss aria-label="Dismiss"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
                </div>
            }
            @* The one step (v35 design 8, operator, 8 October 2026). A Case
               requirement or a report blocker is drawn in full: what is
               missing, its source and reason, what clears it, and one
               full-width control to where it is cleared. A step whose control
               says what the step says is that control alone; any other names
               itself above its section's control. The step is the viewed
               work's and its link stays in that view (operator, 2 October
               2026). Assign Engineer and Create audit open the Actions menu's
               own dialogs, Create audit greyed with its reason as the menu
               item is; where the menu does not offer Assign Engineer the step
               is its words alone (issue 1025). *@
            @if (next is { } nextRow)
            {
                if (nextRow.Blocker is { } first)
                {
                    var firstSection = Model.BlockerSectionKey(first);
                    var firstFocus = Model.BlockerEditFocus(first);
                    <div class="next-step next-step--item" data-next-step data-report-blocker="@firstSection">
                        <strong data-next-label>@first.Requirement</strong>
                        <small>@first.Source · @first.WhyOutstanding</small>
                        @* No sentence on how to resolve it: the control below is the how (v36 item AB, 9 October 2026). *@
                        @if (firstFocus is not null)
                        {
                            <partial name="Cases/Shared/_CaseBlockerEdit" model="new CaseBlockerEditView(Model, firstFocus, repairSpecLabel, StepButton)" />
                        }
                        else if (firstSection is not null)
                        {
                            <a class="@StepButton" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId"
                               asp-route-section="@firstSection" asp-route-view="@Model.ViewRoute" asp-fragment="section-@firstSection"
                               data-section-jump="@firstSection"
                               data-section-tab="@CaseWorkspaceLabels.Report.BlockerTab(first)"
                               data-section-field="@CaseWorkspaceLabels.Report.BlockerField(first)">@SectionLabel(firstSection)</a>
                        }
                        else if (Model.BlockerOpensAccounts(first))
                        {
                            <a class="@StepButton" asp-page="/Administration/Accounts/Index" data-blocker-accounts>@OperatorLabels.Admin.Accounts</a>
                        }
                    </div>
                }
                else if (Model.NextActionRequirement is { } requirement)
                {
                    <div class="next-step next-step--item" data-next-step data-case-requirement>
                        <strong data-next-label>@requirement.Title</strong>
                        <small>@RequirementSource(requirement)</small>
                        <a class="@StepButton" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId" asp-route-section="@requirement.SectionKey" asp-route-view="@Model.ViewRoute" asp-fragment="section-@requirement.SectionKey" data-section-jump="@requirement.SectionKey">@SectionLabel(requirement.SectionKey)</a>
                    </div>
                }
                else if (nextRow.OpensAssignEngineer)
                {
                    <div class="next-step" data-next-step>
                        @if (Model.CanAssignEngineer)
                        {
                            <button type="button" class="@StepButton" data-dialog-open="case-handoff-dialog" data-next-assign-engineer>@CaseWorkspaceLabels.AssignEngineer</button>
                        }
                        else
                        {
                            <strong data-next-label>@nextRow.Label</strong>
                        }
                    </div>
                }
                else if (nextRow.OpensCreateAudit)
                {
                    <div class="next-step" data-next-step>
                        @if (Model.CreateAuditCondition is { } createAuditCondition)
                        {
                            <span class="menu-gated" title="@createAuditCondition" data-create-audit-condition="@createAuditCondition">
                                <button type="button" class="@StepButton" disabled aria-disabled="true" data-next-create-audit>@Frame.CreateAudit</button>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="@StepButton" data-dialog-open="case-create-audit-dialog" data-next-create-audit>@Frame.CreateAudit</button>
                        }
                    </div>
                }
                else if (workflow.State == Pegasus.Core.Workflow.CaseLifecycleState.Held)
                {
                    @* A Held Case's step names the hold with its review date, as
                       the ribbon's chip does, and its control is Release Hold, the
                       Actions menu's own dialog (v36 item D, 9 October 2026). *@
                    <div class="next-step" data-next-step data-next-held>
                        <strong data-next-label>@Model.StateChipText</strong>
                        @if (!Model.ColleagueIsEditing && !Model.IsPostReportReadOnly)
                        {
                            <button type="button" class="@StepButton" data-dialog-open="case-release-hold-dialog" data-next-release-hold>@Frame.ReleaseHold</button>
                        }
                    </div>
                }
                else
                {
                    <div class="next-step" data-next-step>
                        <strong data-next-label>@nextRow.Label</strong>
                        <a class="@StepButton" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId" asp-route-section="@nextRow.SectionKey" asp-route-view="@Model.ViewRoute" asp-fragment="section-@nextRow.SectionKey" data-section-jump="@nextRow.SectionKey">@SectionLabel(nextRow.SectionKey)</a>
                    </div>
                }
            }
        </div>
    </section>
    @* Report not ready (v35 design 8, operator, 8 October 2026): everything
       outstanding, the step's own item included, in a card of its own,
       folded until this browser opens it. The Case requirements come first,
       then every report blocker under the section that clears it, in page
       order (FRD-13: what is missing, where it comes from, why, what clears
       it; no count). The requirement is the link; the Report section's head
       keeps the one Not ready availability label. *@
    @if (requirements.Count > 0 || reportBlockers.Count > 0)
    {
        var fold = Model.FoldedUntilOpened(ReportNotReadyFold);
        var both = requirements.Count > 0 && reportBlockers.Count > 0;
        <section class="panel context-card report-not-ready @(fold.Collapsed ? "is-collapsed" : null)" data-collapse="@fold.Key" data-collapse-folded data-report-not-ready>
            <div class="panel-head">
                <h2><svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>@(reportBlockers.Count > 0 ? CaseWorkspaceLabels.Report.NotReady : Frame.OutstandingRequirements)</h2>
                <partial name="Cases/Shared/_SubPanelToggle" model="fold" />
            </div>
            <div class="panel-body">
                @if (requirements.Count > 0)
                {
                    <div class="outstanding-block" data-case-requirements>
                        @if (both)
                        {
                            <h3><svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>@Frame.OutstandingRequirements</h3>
                        }
                        <ul class="blocker-list">
                            @foreach (var requirement in requirements)
                            {
                                <li class="blocker" data-case-requirement>
                                    <a class="blocker-name" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId" asp-route-section="@requirement.SectionKey" asp-route-view="@Model.ViewRoute" asp-fragment="section-@requirement.SectionKey" data-section-jump="@requirement.SectionKey">@requirement.Title</a>
                                    <small>@RequirementSource(requirement)</small>
                                </li>
                            }
                        </ul>
                    </div>
                }
                @if (reportBlockers.Count > 0)
                {
                    <div class="outstanding-block" data-report-blockers>
                        @if (both)
                        {
                            <h3><svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>@CaseWorkspaceLabels.Report.NotReady</h3>
                        }
                        @foreach (var group in BlockerGroups())
                        {
                            <div class="blocker-group" data-blocker-group="@group.Key">
                                @if (group.Heading is { } heading)
                                {
                                    <div class="blocker-group-head">@heading</div>
                                }
                                <ul class="blocker-list">
                                    @foreach (var reason in group.Items)
                                    {
                                        var blockerSection = Model.BlockerSectionKey(reason);
                                        var blockerFocus = Model.BlockerEditFocus(reason);
                                        <li class="blocker" data-report-blocker="@blockerSection">
                                            @if (blockerFocus is not null)
                                            {
                                                <partial name="Cases/Shared/_CaseBlockerEdit" model="new CaseBlockerEditView(Model, blockerFocus, reason.Requirement, BlockerLink)" />
                                            }
                                            else if (blockerSection is not null)
                                            {
                                                <a class="@BlockerLink" asp-page="/Cases/Details" asp-route-id="@workflow.CaseId"
                                                   asp-route-section="@blockerSection" asp-route-view="@Model.ViewRoute" asp-fragment="section-@blockerSection"
                                                   data-section-jump="@blockerSection"
                                                   data-section-tab="@CaseWorkspaceLabels.Report.BlockerTab(reason)"
                                                   data-section-field="@CaseWorkspaceLabels.Report.BlockerField(reason)">@reason.Requirement</a>
                                            }
                                            else if (Model.BlockerOpensAccounts(reason))
                                            {
                                                <a class="@BlockerLink" asp-page="/Administration/Accounts/Index" data-blocker-accounts>@reason.Requirement</a>
                                            }
                                            else
                                            {
                                                <span class="blocker-name">@reason.Requirement</span>
                                            }
                                            <small>@reason.Source · @reason.WhyOutstanding</small>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }
</aside>
