@model Pegasus.Web.Pages.Cases.CaseImageTagPickerView
@using Pegasus.Core.Documents
@using Pegasus.Web.Presentation
@using TagLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.ImageTags
@{
    var view = Model;
    var slug = view.OccurrenceId.ToString("N");
}
@* One form holds the tile's tag rows: each row is a button whose value is the
   tag, posting to the apply handler or, for an applied tag, the remove handler
   by its own formaction. Pressing one applies or removes that tag and the page
   comes back with the chips redrawn. A row is busy on its own (data-busy-solo):
   the others stay pressable, as when each row was a form of its own. The disclosure is the browser's;
   data-menu gives it the frame's outside-click and Escape closing. *@
<details class="tag-picker" data-tag-picker data-menu>
    <summary class="icon-button" title="@TagLabels.Tag"><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-tag")" /></svg><span class="sr-only">@TagLabels.Tag</span></summary>
    <div class="tag-picker-body">
        <form method="post"
              action="@view.TagAction"
              asp-antiforgery="true"
              data-document-action>
            <input type="hidden" name="id" value="@view.CaseId" />
            <input type="hidden" name="occurrenceId" value="@view.OccurrenceId" />
            <input type="hidden" name="expectedVersion" value="@view.CaseVersion" />
            <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
            <input type="hidden" name="editLeaseToken" value="@view.EditLeaseToken" />
            <input type="hidden" name="view" value="@view.View" />
            @foreach (var tag in view.Vocabulary)
            {
                var applied = view.IsApplied(tag.Id);
                <button type="submit" name="tagId" value="@tag.Id"
                        formaction="@(applied ? view.UntagAction : null)"
                        data-busy-label="@OperatorLabels.Busy.Tagging"
                        data-busy-solo
                        class="tag-option"
                        aria-pressed="@(applied ? "true" : "false")">
                    <span class="tag-swatch tag-swatch--@TagLabels.ColourToken(tag.Colour)" aria-hidden="true"></span>
                    <span>@tag.Name</span>
                    @if (applied)
                    {
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-check")" /></svg>
                    }
                </button>
            }
        </form>
        <form method="post"
              class="tag-picker-new"
              action="@view.CreateAction"
              asp-antiforgery="true"
              data-document-action>
            <input type="hidden" name="id" value="@view.CaseId" />
            <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
            <input type="hidden" name="editLeaseToken" value="@view.EditLeaseToken" />
            <input type="hidden" name="view" value="@view.View" />
            <label class="sr-only" for="tag-name-@slug">@TagLabels.Name</label>
            <input id="tag-name-@slug"
                   name="name"
                   maxlength="@ImageTagVocabulary.MaximumNameLength"
                   placeholder="@TagLabels.NewTag" />
            <label class="sr-only" for="tag-colour-@slug">@TagLabels.Colour</label>
            <select id="tag-colour-@slug" name="colour">
                @foreach (var colour in Enum.GetValues<ImageTagColour>())
                {
                    <option value="@colour">@TagLabels.ColourLabel(colour)</option>
                }
            </select>
            <button type="submit" data-busy-label="@OperatorLabels.Busy.Creating" class="btn btn--small">@TagLabels.Create</button>
        </form>
    </div>
</details>
