@*
    Report (v26 § Report). Head: one primary (Generate report, gated by the
    readiness the projection states; the report always ends with its fee
    note) and one More menu (the previews, and Generate for each companion
    document).
    Body: the preview card (when the report was generated, where its file
    stands, and Open report and Open fee note once each is stored), the
    delivery form with its one Send report, and the report fields. The readiness
    list and the stale notice are the aside's Next action's (issue 899).
    Mark report sent is the ribbon's Actions item and
    Unlink report evidence is Overview's Lifecycle actions; neither is
    repeated here.
*@
@using System.Globalization
@using Pegasus.Core.Assessment
@using Pegasus.Core.Reports
@using Pegasus.Web.Pages.Cases
@using Pegasus.Web.Presentation
@using EngineerLabels = Pegasus.Web.Presentation.OperatorLabels.CaseWorkspace.EngineerSections
@using ReportLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.ReportDelivery
@using Words = Pegasus.Web.Presentation.CaseWorkspaceLabels.Report
@using WordingLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.ReportWording
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var caseId = workflow.CaseId;
    var editing = Model.SectionIsEditable("report");
    // One report per work (v29 P4): each view's card is its own work's report,
    // generated and sent under the same rules, the Inspection's
    // before and after it is sent (operator, 1 and 2 October 2026). The Audit
    // view shows the Audit report alone (operator, 2 October 2026); only its
    // send form also offers the Inspection report (operator, 12 October 2026).
    var auditView = !Model.IsInspectionView && Model.Works is { HasAudit: true };
    var generation = Model.CurrentReportGeneration;
    // The delivery form is the Send report dialog (v48), rendered among the
    // Case dialogs; this section keeps the preview card and the Already sent
    // line, which lists every address of the last send, To then Cc.
    var lastSent = Model.ReportSendHistory.LastSentAtUtc is { } sentAt
        ? Pegasus.Core.LondonCalendar.TimeAt(sentAt).ToString("d MMM yyyy HH:mm", CultureInfo.InvariantCulture)
        : null;
    var lastRecipients = string.Join(", ", (Model.ReportSendHistory.LastTo ?? []).Concat(Model.ReportSendHistory.LastCc ?? []));
    var labels = CaseWorkspaceLabels.Editors.Report;
    var draftPreparation = Model.ReportDraftPreparation;
    var draftCondition = Model.ReportDraftCondition;
    var offersHead = !Model.AssessmentIsReadOnly && draftPreparation is not null;
    // The lease a Report command runs under: the section's edit.
    var leaseForReport = editing;
    var reportArtifact = generation?.Artifacts.FirstOrDefault(artifact =>
        artifact.Kind == CaseReportArtifactKind.AssessmentReport);
    // Where the report's file stands, as Core reads it from the row.
    var reportFiling = reportArtifact?.Filing ?? CaseReportArtifactFiling.NotProduced;
    var reportRetryArtifact = generation is not { State: CaseReportGenerationState.Stale }
        && reportArtifact?.Status != CaseReportArtifactStatus.Confirmed
        ? reportArtifact
        : null;
    var reportAlreadyConfirmed = generation is not { State: CaseReportGenerationState.Stale }
        && reportArtifact?.Status == CaseReportArtifactStatus.Confirmed;
    // Generate report and its companion documents are offered in and out of
    // edit mode (operator, 26 and 28 September 2026). Outside it the handler
    // claims the lease for the one generation, so they are not offered while
    // someone holds the lease; inside it the report's form saves the Case
    // first (data-case-save-first).
    var canClaimGeneration = offersHead && (leaseForReport || Model.CurrentEditLease is null);
    var feeNoteArtifact = generation?.Artifacts
        .FirstOrDefault(artifact => artifact.Kind == CaseReportArtifactKind.FeeNote);
    var canGenerateCompanion = canClaimGeneration
        && generation is { State: CaseReportGenerationState.Confirmed };
    // Generate report makes the report and then its separate fee note
    // (operator, 7 October 2026), so it is offered again for a confirmed
    // report whose fee note is not: the report's own key replays the report
    // and the fee note is made.
    var feeNoteOutstanding = canGenerateCompanion
        && reportAlreadyConfirmed
        && feeNoteArtifact?.Status != CaseReportArtifactStatus.Confirmed;
    var canGenerate = canClaimGeneration
        && (reportRetryArtifact is not null
            || feeNoteOutstanding
            || !reportAlreadyConfirmed && draftCondition is null);
    var reportOperationKey = (feeNoteOutstanding ? reportArtifact : reportRetryArtifact)?.OperationKey
        ?? Model.GenerateReportOperationKey;
    // Only a retry of this generation's fee note reuses its key; a new
    // generation's fee note is a new operation.
    var feeNoteOperationKey = (feeNoteOutstanding ? feeNoteArtifact : null)?.OperationKey
        ?? Model.GenerateFeeNoteOperationKey;
    // What the preview card opens: the stored report, and a separate fee
    // note once it is confirmed (the Fee tab's own rule).
    var cardReport = reportArtifact is { Filing: CaseReportArtifactFiling.Stored } ? reportArtifact : null;
    var cardFeeNote = feeNoteArtifact is { Status: CaseReportArtifactStatus.Confirmed } ? feeNoteArtifact : null;
    // The working draft is the current work's projection; the Inspection view
    // has its generated file to open instead.
    var canPreview = offersHead && !Model.IsInspectionView && draftCondition is null;
    var generatedAt = generation is null
        ? null
        : Pegasus.Core.LondonCalendar.TimeAt(generation.GeneratedAtUtc).ToString("d MMMM yyyy HH:mm", CultureInfo.InvariantCulture);
    var draftFileName = Model.ReportTitle + Words.DraftSuffix;
    var previewHref = Url.Page("/Cases/Details", "PreviewReportDraft", new { id = caseId })!;
    // P50 moved the image surface to Files, so what the report uses is
    // counted from the preparations that grid reads. The Preview images
    // offer still depends on there being at least one.
    var inReport = Pegasus.Core.Documents.CaseAssetPreparationPolicy.ForReport(Model.AssetPreparations).Count;

    // Send report is offered again after a send, so the same report can be
    // sent again (operator, 6 October 2026); the dialog is offered only to
    // the lease-holding session (v48 item H). Model.CanSendReport is the one
    // answer the head, the aside's step and the dialog read.
    var repairSpecArtifact = generation?.Artifacts.FirstOrDefault(artifact =>
        artifact.Kind == CaseReportArtifactKind.RepairSpecification);
    var imagePackArtifact = generation?.Artifacts.FirstOrDefault(artifact =>
        artifact.Kind == CaseReportArtifactKind.ImagePack);
    var frozenImageCount = generation?.Snapshot.Images.Count ?? 0;
    var canGenerateRepairSpec = canGenerateCompanion
        && repairSpecArtifact?.Status != CaseReportArtifactStatus.Confirmed;
    var canGenerateImagePack = canGenerateCompanion
        && imagePackArtifact?.Status != CaseReportArtifactStatus.Confirmed
        && (imagePackArtifact is not null || frozenImageCount > 0);
    var repairSpecOperationKey = repairSpecArtifact?.OperationKey ?? Model.GenerateRepairSpecOperationKey;
    var imagePackOperationKey = imagePackArtifact?.OperationKey ?? Model.GenerateImagePackOperationKey;
    var specificationId = Model.CurrentSpecification?.SpecificationId;
    var imagePackHref = Url.Page("/Cases/Details", "PreviewImagePack", new { id = caseId })!;
    var reportDate = Model.AssessmentEditorValue(AssessmentVocabulary.ReportDate);
    // A recorded Report date is the date the report prints; without one, the
    // current report carries the day it was generated (operator, 7 October 2026).
    var reportDateShown = DateOnly.TryParseExact(Model.Assessment?.Field(AssessmentVocabulary.ReportDate)?.Value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var reportDateValue)
        ? reportDateValue
        : generation?.Snapshot.ReportDate;
    var reportDateText = reportDateShown?.ToString("d MMM yyyy", CultureInfo.InvariantCulture);
    var feeNote = Model.FeeNote;
    var culture = CultureInfo.GetCultureInfo("en-GB");
    string FeeMoney(decimal value) => "£" + value.ToString("N2", culture);
}

<section class="record-section panel @Model.CollapsedClass("case.report") @(Model.IsEditing && !Model.SectionIsEditable("report") ? "is-locked" : null)" id="section-report" data-section="report" data-collapse="case.report" aria-labelledby="section-report-title" data-report>
    <div class="panel-head">
        <h2 id="section-report-title">@EngineerLabels.Report</h2>
        <div class="panel-actions">
            @if (Model.CanSendReport)
            {
                @* Send report opens the composer dialog (v48 item A; operator,
                   4 November 2026), while editing with the report stored. *@
                <button type="button" class="btn btn--small btn--primary" data-dialog-open="case-send-report-dialog" data-report-send-open>
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-send")" /></svg>
                    <span>@ReportLabels.SendReport</span>
                </button>
            }
            @if (canGenerate)
            {
                @* In edit mode the script lets a change not yet sent land
                   first, then posts this form with the Case's new version. *@
                <form method="post" asp-page="/Cases/Details" asp-page-handler="GenerateReport"
                      asp-route-id="@caseId" asp-route-section="report" id="case-generate-report-form" data-generate-report>
                    <input type="hidden" name="operationKey" value="@reportOperationKey" />
                    <input type="hidden" name="feeNoteOperationKey" value="@feeNoteOperationKey" />
                    @if (leaseForReport)
                    {
                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                    }
                    <input type="hidden" name="expectedCaseVersion" value="@workflow.Version" />
                    <input type="hidden" name="view" value="@Model.ViewRoute" />
                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Generating" data-busy-done="@OperatorLabels.Busy.Done.Generated" class="btn btn--small btn--primary">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-file-text")" /></svg>
                        <span>@ReportLabels.GenerateReport</span>
                    </button>
                </form>
            }
            else if (offersHead && draftCondition is not null)
            {
                <span class="gated" data-report-gate>
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-lock")" /></svg>
                    @* One availability label in the head; the aside's Next action names every missing item and links each to its section. *@
                    <span>@Words.NotReady</span>
                </span>
            }
            @if (offersHead && (canPreview || leaseForReport || canGenerateRepairSpec || canGenerateImagePack))
            {
                <details class="menu" data-menu data-report-menu>
                    <summary class="btn btn--small"><span>@Words.More</span><svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-chevron-down")" /></svg></summary>
                    <div class="menu-body">
                        @if (canPreview)
                        {
                            @* The working draft in the page's document viewer with
                               Download draft (script); the link itself opens the PDF
                               without script. *@
                            <a class="btn" href="@previewHref" target="_blank" rel="noopener"
                           data-report-preview data-document-preview data-busy-label="@OperatorLabels.Busy.Loading" data-file-name="@draftFileName" data-no-inplace>
                                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-eye")" /></svg>
                                <span>@Words.PreviewDraft</span>
                            </a>
                        }
                        @if (canPreview && specificationId is { } currentSpecification)
                        {
                            @* P42: the Repair Spec as it will print, the same
                               document the specification section opens. *@
                            <a class="btn" asp-page="/Cases/Details" asp-page-handler="EstimateDocument"
                               asp-route-id="@caseId" asp-route-estimateId="@currentSpecification"
                               target="_blank" rel="noopener" data-document-preview data-busy-label="@OperatorLabels.Busy.Loading" data-no-inplace
                               data-report-preview-spec>
                                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-file-text")" /></svg>
                                <span>@ReportLabels.PreviewRepairSpec</span>
                            </a>
                        }
                        @if (canPreview && inReport > 0)
                        {
                            <a class="btn" href="@imagePackHref" target="_blank" rel="noopener"
                               data-document-preview data-busy-label="@OperatorLabels.Busy.Loading" data-no-inplace data-report-preview-images>
                                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-images")" /></svg>
                                <span>@ReportLabels.PreviewImages</span>
                            </a>
                        }
                        @if (canGenerateRepairSpec)
                        {
                            <form method="post" asp-page="/Cases/Details" asp-page-handler="GenerateRepairSpec"
                                  asp-route-id="@caseId" asp-route-section="report">
                                <input type="hidden" name="operationKey" value="@repairSpecOperationKey" />
                                @if (leaseForReport)
                                {
                                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                                }
                                <input type="hidden" name="expectedCaseVersion" value="@workflow.Version" />
                                <input type="hidden" name="targetGenerationId" value="@generation!.Id" />
                                <input type="hidden" name="view" value="@Model.ViewRoute" />
                                <button type="submit" data-busy-label="@OperatorLabels.Busy.Generating" data-busy-done="@OperatorLabels.Busy.Done.Generated" class="btn" data-generate-repair-spec>
                                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-file-text")" /></svg>
                                    <span>@ReportLabels.GenerateRepairSpec</span>
                                </button>
                            </form>
                        }
                        @if (canGenerateImagePack)
                        {
                            <form method="post" asp-page="/Cases/Details" asp-page-handler="GenerateImagePack"
                                  asp-route-id="@caseId" asp-route-section="report">
                                <input type="hidden" name="operationKey" value="@imagePackOperationKey" />
                                @if (leaseForReport)
                                {
                                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                                }
                                <input type="hidden" name="expectedCaseVersion" value="@workflow.Version" />
                                <input type="hidden" name="targetGenerationId" value="@generation!.Id" />
                                <input type="hidden" name="view" value="@Model.ViewRoute" />
                                <button type="submit" data-busy-label="@OperatorLabels.Busy.Generating" class="btn" data-generate-image-pack>
                                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-images")" /></svg>
                                    <span>@ReportLabels.GenerateImages</span>
                                </button>
                            </form>
                        }
                    </div>
                </details>
            }
            <partial name="Cases/Shared/_CaseSectionHeadTools" model='new Pegasus.Web.Pages.Cases.CaseSectionHeadView(Model, "report")' />
        </div>
    </div>
    <div class="panel-body stack">
        @* P24: the section reads in two tabs. Report is everything the
           report itself carries; Fee is the fee note the agreed fee makes.
           Without script both panes stand, so nothing is out of reach. *@
        <div class="report-tabs" role="tablist" aria-label="@EngineerLabels.Report" data-report-tabs hidden>
            <button type="button" class="report-tab" role="tab" aria-selected="true" aria-controls="report-pane-report" data-report-tab="report">@Words.ReportTab</button>
            <button type="button" class="report-tab" role="tab" aria-selected="false" aria-controls="report-pane-fee" data-report-tab="fee">@Words.FeeTab</button>
        </div>
        <div id="report-pane-report" class="stack" role="tabpanel" aria-label="@Words.ReportTab" data-report-pane="report">
        @* The preview card: what the report is and where its generation stands. *@
        <div class="pv" data-report-preview-card>
            <div class="pv-thumb" aria-hidden="true"></div>
            <div class="pv-meta">
                <div class="pt" data-report-title>@Model.ReportTitle</div>
                <div class="ps" data-report-status>
                    @if (auditView)
                    {
                        <span class="mono" data-report-reference>@Model.AuditReportReference · </span>
                    }
                    @if (generation is null)
                    {
                        <span>@Words.NoGeneration</span>
                    }
                    else
                    {
                        @* When it was generated and where its file stands.
                           A report that was never drawn has no date to give. *@
                        @if (reportFiling != CaseReportArtifactFiling.NotProduced)
                        {
                            <span>@Words.Generated <b>@generatedAt</b> · </span>
                        }
                        <span class="status status--plain @FilingTone(reportFiling)" data-report-filing>@ReportLabels.Filing(reportFiling)</span>
                    }
                </div>
            </div>
            @if (generation is not null && (cardReport is not null || cardFeeNote is not null))
            {
                <div class="cluster">
                    @if (cardReport is { } storedReport)
                    {
                        @* The stored report in the page's document viewer, as
                           Preview opens the draft; without script the link
                           itself gives the file. The report Generate has just
                           made is opened once, by the script, on the page that
                           follows. The mark is always written, true or false:
                           Razor writes an omitted attribute as an empty one here. *@
                        var storedReportHref = Url.Page(
                            "/Cases/Details",
                            "GeneratedArtifact",
                            new { id = caseId, generationId = generation.Id, artifactId = storedReport.Id, view = Model.ViewRoute })!;
                        <a class="btn btn--small" href="@storedReportHref"
                           target="_blank" rel="noopener" data-report-artifact="@storedReport.Kind"
                           data-document-preview data-busy-label="@OperatorLabels.Busy.Loading" data-file-name="@storedReport.FileName" data-no-inplace
                           data-open-on-arrival="@(Model.OpenReportArtifactId == storedReport.Id ? "true" : "false")">
                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-eye")" /></svg>
                            <span>@ReportLabels.OpenReport</span>
                        </a>
                    }
                    @if (cardFeeNote is { } separateFeeNote)
                    {
                        @* The separate fee note beside the report it goes with
                           (issue 912); the Fee tab keeps its own link. *@
                        <a class="btn btn--small" asp-page="/Cases/Details" asp-page-handler="GeneratedArtifact"
                           asp-route-id="@caseId" asp-route-generationId="@generation.Id"
                           asp-route-artifactId="@separateFeeNote.Id" asp-route-view="@Model.ViewRoute"
                           target="_blank" rel="noopener" data-report-fee-card
                           data-document-preview data-busy-label="@OperatorLabels.Busy.Loading" data-file-name="@separateFeeNote.FileName" data-no-inplace>
                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-eye")" /></svg>
                            <span>@ReportLabels.OpenFeeNote</span>
                        </a>
                    }
                </div>
            }
        </div>

        @* v48 (operator, 4 November 2026): the delivery form is the Send
           report dialog, opened from the head while editing; reading repeats
           no delivery cells. A report already sent says so here too (item N),
           read and edit alike. *@
        @if (generation is not null && lastSent is not null)
        {
            <p class="muted" data-report-already-sent>@ReportLabels.AlreadySent(lastSent, lastRecipients)</p>
        }

        <div class="fg g4">
            <div class="fc @(editing ? null : "ro")" data-field="@AssessmentVocabulary.ReportDate">
                @if (editing)
                {
                    <label for="f-report-date">@Words.ReportDate</label>
                }
                else
                {
                    <span class="lbl">@Words.ReportDate</span>
                }
                <div class="fv derived @(reportDateText is null ? "empty" : null)">@(reportDateText ?? "—")</div>
                @if (editing)
                {
                    <input id="f-report-date" class="fi" type="date" name="reportDate" form="case-edit-form" value="@reportDate" />
                }
            </div>
            @* The comments take a full row (v36 f38). *@
            @{ await Field(AssessmentVocabulary.EngineersComments, labels[AssessmentVocabulary.EngineersComments], multi: true, extraClass: "span4");
            }
        </div>

        @* Report wording (v28 P30; v45, operator, 2 November 2026): every
           choice of what the report says is here. One settings checklist opens
           the panel: each offered block in print order, then Disclose guide
           source, FAO The Court and Include statement of truth, each as it
           defaults today. A block has no on/off of its own and is drawn only
           while its item is ticked. Valuation commentary and Unrelated damage
           are their switches (v45 A); the commentary's words are its field
           (v45 E). The Statement of truth closes the panel read-only, the
           guide sentence in its print place (v45 D, I). While the report
           cannot be projected the settings hold the five switches alone
           (v45 B). *@
        <div class="sub-panel wording" data-report-wording>
            <h3>@WordingLabels.PanelTitle<span class="rt">@WordingLabels.InPrintOrder</span></h3>
            <div class="wording-settings" data-wording-settings>
                @if (Model.ReportWording.Count > 0)
                {
                    for (var index = 0; index < Model.ReportWording.Count; index++)
                    {
                        var block = Model.ReportWording[index];
                        var slot = index.ToString(CultureInfo.InvariantCulture);
                        switch (block.Key)
                        {
                            case ReportWordingComposition.ValuationCommentary:
                                SwitchSetting(AssessmentVocabulary.ReportValuationCommentary, block.Key, Words.ValuationCommentary, editing);
                                break;
                            case ReportWordingComposition.UnrelatedDamage:
                                SwitchSetting(AssessmentVocabulary.ReportIncludeUnrelatedDamage, block.Key, Words.UnrelatedDamage, editing);
                                break;
                            default:
                                BlockSetting(block, slot, editing);
                                break;
                        }
                    }
                }
                else
                {
                    SwitchSetting(AssessmentVocabulary.ReportValuationCommentary, ReportWordingComposition.ValuationCommentary, Words.ValuationCommentary, editing);
                    SwitchSetting(AssessmentVocabulary.ReportIncludeUnrelatedDamage, ReportWordingComposition.UnrelatedDamage, Words.UnrelatedDamage, editing);
                }
                @{
                    SwitchSetting(AssessmentVocabulary.ReportDiscloseGuideSource, "guide", Words.DiscloseGuideSource, editing);
                    SwitchSetting(AssessmentVocabulary.ReportFaoTheCourt, "fao", Words.FaoTheCourt, editing);
                    SwitchSetting(AssessmentVocabulary.ReportIncludeStatementOfTruth, "statement", Words.IncludeStatementOfTruth, editing);
                }
            </div>
            @if (Model.ReportWording.Count > 0)
            {
                if (editing)
                {
                    <div class="stack" data-wording-list>
                        @for (var index = 0; index < Model.ReportWording.Count; index++)
                        {
                            await WordingRow(Model.ReportWording[index], index.ToString(CultureInfo.InvariantCulture));
                        }
                    </div>
                    @* A paragraph the Engineer adds is cloned from here with its
                       own slot and key, and posts through the same names; the
                       script gives it its tick in the settings. *@
                    <template data-wording-template>
                        @{ await WordingRow(
                               new ReportWordingBlock("__key__", WordingLabels.NewParagraph, string.Empty, 0, HandEdited: true, Manual: true),
                               "__i__"); }
                    </template>
                    <div class="button-row">
                        <button type="button" class="btn btn--small" data-wording-new>
                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-plus")" /></svg>
                            <span>@WordingLabels.NewParagraph</span>
                        </button>
                    </div>
                }
                else
                {
                    @* Reading, every block on the report draws in the row it
                       edits in, its heading and wording in greyed boxes. *@
                    <div class="stack">
                        @foreach (var block in Model.ReportWording.Where(block => block.Included))
                        {
                            <div class="wb" data-wording-block="@block.Key">
                                <div class="wbh">
                                    <div class="fc ro wbt"><div class="fv">@block.Title</div></div>
                                    <span class="src-tag @(block.HandEdited ? "src-tag--warn" : null)">@WordingChip(block)</span>
                                </div>
                                <div class="fc ro"><div class="fv multi">@block.Text</div></div>
                            </div>
                        }
                    </div>
                }
            }
            @if (Model.StatementParts is { } statement)
            {
                var court = SwitchOn(AssessmentVocabulary.ReportIncludeStatementOfTruth);
                var guide = SwitchOn(AssessmentVocabulary.ReportDiscloseGuideSource);
                <div class="stack" data-wording-fixed>
                    <div class="wb wb-fixed" data-wording-block="statement-of-truth">
                        <div class="wbh"><div class="fc ro wbt"><div class="fv">@EngineerLabels.StatementOfTruth</div></div></div>
                        <div class="fc ro" data-sot-court hidden="@(!court)"><div class="fv derived multi">@string.Join("\n\n", statement.Court)</div></div>
                        @if (statement.Guide is { } guideSentence)
                        {
                            <div class="wb wb-fixed" data-wording-block="guide" hidden="@(!guide)">
                                <div class="wbh"><div class="fc ro wbt"><div class="fv">@Words.DiscloseGuideSource</div></div></div>
                                <div class="fc ro"><div class="fv derived multi">@guideSentence</div></div>
                            </div>
                        }
                        <div class="fc ro"><div class="fv derived multi">@string.Join("\n\n", statement.Closing)</div></div>
                    </div>
                </div>
            }
        </div>

        @* P50: an image has one place. Whether the report uses it, its order and the
           tools that change it are on its tile under Files; the Report
           section no longer repeats the strip or the preparation cards. *@
        </div>
        <div id="report-pane-fee" class="stack" role="tabpanel" aria-label="@Words.FeeTab" data-report-pane="fee">
            @* The agreed fee is recorded once; the fee note's VAT and total
               are read from it beside it (23 September 2026). *@
            <div class="fg g3" data-report-fee-fields>
                @{ await Field(AssessmentVocabulary.AgreedFee, labels[AssessmentVocabulary.AgreedFee]); }
                <div class="fc ro" data-report-fee-note="vat">
                    <span class="lbl">@Words.FeeVat</span>
                    <div class="fv mono derived @(feeNote is null ? "empty" : null)">@(feeNote is { } vatFee ? FeeMoney(vatFee.Vat) : OperatorLabels.CaseWorkspace.AbsentValue)</div>
                </div>
                <div class="fc ro" data-report-fee-note="total">
                    <span class="lbl">@Words.FeeTotal</span>
                    <div class="fv mono derived @(feeNote is null ? "empty" : null)">@(feeNote is { } totalFee ? FeeMoney(totalFee.Total) : OperatorLabels.CaseWorkspace.AbsentValue)</div>
                </div>
            </div>
            <div class="fg">
                @{ await Field(AssessmentVocabulary.FeeDescriptionLines, labels[AssessmentVocabulary.FeeDescriptionLines], multi: true); }
            </div>
            @if (feeNoteArtifact is { Status: CaseReportArtifactStatus.Confirmed } confirmedFeeNote && generation is not null)
            {
                <div class="cluster">
                    <a class="btn btn--small" asp-page="/Cases/Details" asp-page-handler="GeneratedArtifact"
                       asp-route-id="@caseId" asp-route-generationId="@generation.Id"
                       asp-route-artifactId="@confirmedFeeNote.Id" asp-route-view="@Model.ViewRoute"
                       target="_blank" rel="noopener" data-report-fee-artifact>
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-download")" /></svg>
                        <span>@ReportLabels.DownloadFeeNote</span>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

@functions {
    // The chip tone for where the report's file stands: green only once it is
    // stored, amber while it is not there yet, red for a failure.
    private static string FilingTone(CaseReportArtifactFiling filing) => filing switch
    {
        CaseReportArtifactFiling.Stored => "status--green",
        CaseReportArtifactFiling.StorageFailed => "status--red",
        CaseReportArtifactFiling.Unconfirmed => "status--neutral",
        _ => "status--amber"
    };

    // Which source a block's wording came from, as the chip states it.
    private static string WordingChip(ReportWordingBlock block) => block.Manual
        ? WordingLabels.ManualBlock
        : block.HandEdited
            ? WordingLabels.Edited
            : block.Key switch
            {
                ReportWordingComposition.SupplementaryDamage => WordingLabels.FromEstimate,
                ReportWordingComposition.VehicleHistoryCheck => WordingLabels.PassThrough,
                _ => WordingLabels.TracksFields
            };

    // Whether a report content switch is on, as the Case records it: the
    // court line and the statement until recorded off (R611).
    private bool SwitchOn(string path) =>
        CaseReportContentSwitches.IsOn(path, Model.AssessmentEditorValue(path));

    // One report content switch in Report wording's settings (v45): a tick
    // joining the record's one Save form while the section edits, a static
    // tick while reading. A checkbox posts "true" ahead of its hidden "false",
    // so an unticked switch still records No.
    private void SwitchSetting(string path, string key, string label, bool editable)
    {
        var on = SwitchOn(path);
        if (editable)
        {
            var name = CaseWorkspaceLabels.Editors.FormName(path);
            <label class="choice" data-field="@path">
                <input type="checkbox" name="@name" value="true" form="case-edit-form" checked="@on" data-report-switch="@path" data-wording-toggle="@key" />
                <input type="hidden" name="@name" value="false" form="case-edit-form" />
                <span>@label</span>
            </label>
        }
        else
        {
            StaticTick(key, label, on);
        }
    }

    // One wording block's tick in the settings (v45 R3): it posts the block's
    // own on/off under the block's slot.
    private void BlockSetting(ReportWordingBlock block, string slot, bool editable)
    {
        if (editable)
        {
            var name = $"wordingEdits[{slot}].Included";
            <label class="choice">
                <input type="checkbox" name="@name" value="true" form="case-edit-form" checked="@block.Included" data-wording-included data-wording-toggle="@block.Key" />
                <input type="hidden" name="@name" value="false" form="case-edit-form" />
                <span>@block.Title</span>
            </label>
        }
        else
        {
            StaticTick(block.Key, block.Title, block.Included);
        }
    }

    private void StaticTick(string key, string label, bool on)
    {
        <span class="choice is-static" data-on="@(on ? "true" : "false")" data-wording-toggle="@key">
            <span class="tick">
                @if (on)
                {
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-check")" /></svg>
                }
            </span>
            <span>@label</span>
        </span>
    }

    // One wording block while the section edits: its heading, its wording and
    // the controls that move it. Its tick is in the settings and a block off
    // the report is not drawn (v45 R3). Every control joins the record's one
    // Save form. The order is carried rather than typed: the move buttons
    // rewrite it. The commentary's text box is the Valuation commentary field
    // itself (v45 E), so it has nothing to recompose.
    private async Task WordingRow(ReportWordingBlock block, string slot)
    {
        var name = $"wordingEdits[{slot}]";
        var id = $"f-wording-{slot}";
        var composed = Model.ReportWordingComposed.GetValueOrDefault(block.Key, string.Empty);
        var commentary = block.Key == ReportWordingComposition.ValuationCommentary;
        <div class="wb" hidden="@(!block.Included)" data-wording-row data-wording-block="@block.Key"
             data-wording-composed="@composed">
            <input type="hidden" name="@(name).Key" value="@block.Key" form="case-edit-form" data-wording-key />
            <input type="hidden" name="@(name).Manual" value="@(block.Manual ? "true" : "false")" form="case-edit-form" />
            <input type="hidden" name="@(name).Order" value="@block.Order" form="case-edit-form" data-wording-order />
            <div class="wbh">
                <input id="@(id)-title" class="fi wbt" name="@(name).Title" value="@block.Title" form="case-edit-form"
                       maxlength="@ReportWordingComposition.MaximumTitleLength" aria-label="@WordingLabels.Heading" />
                <span class="src-tag @(block.HandEdited ? "src-tag--warn" : null)" data-wording-chip>@WordingChip(block)</span>
                @if (!block.Manual && !commentary)
                {
                    <button type="button" class="icon-button" data-wording-recompose aria-label="@WordingLabels.Recompose" title="@WordingLabels.Recompose">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-undo")" /></svg>
                    </button>
                }
                <span class="wb-tools">
                    <button type="button" class="icon-button" data-wording-up aria-label="@WordingLabels.MoveUp" title="@WordingLabels.MoveUp">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-up")" /></svg>
                    </button>
                    <button type="button" class="icon-button" data-wording-down aria-label="@WordingLabels.MoveDown" title="@WordingLabels.MoveDown">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-arrow-down")" /></svg>
                    </button>
                </span>
            </div>
            @if (commentary)
            {
                var path = AssessmentVocabulary.ReportValuationCommentaryText;
                <label class="sr-only" for="@(id)-text">@WordingLabels.Wording</label>
                @* The cell a readiness blocker's link lands on (FRD-13). *@
                <div data-field="@path">
                    @if (Model.CanEditAssessmentField(path))
                    {
                        <textarea id="@(id)-text" class="fi" rows="3" name="@CaseWorkspaceLabels.Editors.FormName(path)" form="case-edit-form"
                                  maxlength="@AssessmentVocabulary.Definitions[path].MaximumLength">@Model.AssessmentEditorValue(path)</textarea>
                    }
                    else
                    {
                        <div class="fc ro"><div class="fv multi">@block.Text</div></div>
                    }
                </div>
            }
            else
            {
                <label class="sr-only" for="@(id)-text">@WordingLabels.Wording</label>
                <textarea id="@(id)-text" class="fi" rows="3" name="@(name).Text" form="case-edit-form"
                          maxlength="@ReportWordingComposition.MaximumTextLength" data-wording-text>@block.Text</textarea>
            }
        </div>
    }

    // One assessment cell on the vocabulary's own type, the control joining
    // the record's one Save form while the section edits.
    private async Task Field(string path, string label, bool multi = false, string? extraClass = null)
    {
        var definition = AssessmentVocabulary.Definitions[path];
        var editable = Model.SectionIsEditable("report") && Model.CanEditAssessmentField(path);
        var value = Model.AssessmentEditorValue(path);
        var absent = Model.AssessmentIsAbsent(path);
        var name = CaseWorkspaceLabels.Editors.FormName(path);
        var id = "f-" + path.Replace('.', '-').Replace('_', '-');
        var mono = definition.Type is AssessmentFieldType.Money or AssessmentFieldType.WholeNumber;
        var tag = Model.AssessmentSourceTag(path);
        <div class="fc @extraClass @(editable ? null : "ro")" data-field="@path">
            @if (editable)
            {
                <label for="@id">@label@(tag?.Render())</label>
            }
            else
            {
                <span class="lbl">@label@(tag?.Render())</span>
            }
            <div class="fv @(mono ? "mono" : null) @(multi ? "multi" : null) @(absent ? "empty" : null)">@Model.AssessmentDisplay(path)</div>
            @if (editable)
            {
                if (definition.Type == AssessmentFieldType.Flag)
                {
                    <select id="@id" class="fi" name="@name" form="case-edit-form">
                        <option value="" selected="@(value is null)"></option>
                        <option value="true" selected="@(value == "true")">Yes</option>
                        <option value="false" selected="@(value == "false")">No</option>
                    </select>
                }
                else if (multi)
                {
                    <textarea id="@id" class="fi" name="@name" form="case-edit-form" maxlength="@definition.MaximumLength">@value</textarea>
                }
                else
                {
                    <input id="@id" class="fi @(mono ? "mono" : null)" name="@name" form="case-edit-form" value="@value"
                           type="@(definition.Type == AssessmentFieldType.Date ? "date" : mono ? "number" : "text")"
                           step="@(definition.Type == AssessmentFieldType.Money ? "0.01" : null)"
                           maxlength="@(definition.Type == AssessmentFieldType.Text ? definition.MaximumLength : null)" />
                }
            }
        </div>
    }
}
