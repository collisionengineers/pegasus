@using Pegasus.Core.Assessment
@using Pegasus.Core.Reports
@using Pegasus.Web.Pages.Cases
@using EngineerLabels = Pegasus.Web.Presentation.OperatorLabels.CaseWorkspace.EngineerSections
@using ReportLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.ReportDelivery
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var caseId = Model.Case!.Workflow.CaseId;
    var generation = Model.CurrentReportGeneration;
    var preparation = Model.CurrentDeliveryPreparation;
    var suggestedRecipients = Model.DeliveryRecipientSuggestions is { } suggestions
        ? CaseReportDeliveryPolicy.SuggestedReview(suggestions)
        : new ReportRecipientReview([], []);
}

<section class="panel" aria-labelledby="section-report-title">
    <div class="panel-head">
        <h2 id="section-report-title">@EngineerLabels.Report</h2>
        @if (!Model.AssessmentIsReadOnly && Model.ReportDraftPreparation is not null)
        {
            <div class="button-row">
                @if (Model.ReportDraftCondition is null)
                {
                    <form method="post" asp-page="/Cases/Details" asp-page-handler="GenerateReportDraft"
                          asp-route-id="@caseId" asp-route-section="estimate">
                        <input type="hidden" name="operationKey" value="@Model.ReportDraftOperationKey" />
                        <button type="submit" class="btn">
                            <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                            <span>@EngineerLabels.GenerateReportDraft</span>
                        </button>
                    </form>
                    <a class="btn" asp-page="/Cases/Details" asp-page-handler="PreviewReportDraft"
                       asp-route-id="@caseId" target="_blank" rel="noopener">
                        <svg class="icon" aria-hidden="true"><use href="#icon-eye" /></svg>
                        <span>@EngineerLabels.PreviewReportDraft</span>
                    </a>
                    <form method="post" asp-page="/Cases/Details" asp-page-handler="GenerateReport"
                          asp-route-id="@caseId" asp-route-section="report">
                        <input type="hidden" name="operationKey" value="@Model.GenerateReportOperationKey" />
                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                        <button type="submit" class="btn">
                            <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                            <span>@ReportLabels.GenerateReport</span>
                        </button>
                    </form>
                    <form method="post" asp-page="/Cases/Details" asp-page-handler="GenerateFeeNote"
                          asp-route-id="@caseId" asp-route-section="report">
                        <input type="hidden" name="operationKey" value="@Model.GenerateReportOperationKey" />
                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                        <button type="submit" class="btn">
                            <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                            <span>@ReportLabels.GenerateFeeNote</span>
                        </button>
                    </form>
                }
                else
                {
                    <span class="gated" data-condition="@Model.ReportDraftCondition">
                        <button type="button" class="btn" disabled aria-disabled="true">
                            <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                            <span>@EngineerLabels.GenerateReportDraft</span>
                        </button>
                    </span>
                }
            </div>
        }
    </div>
    <div class="panel-body stack">
        @if (!Model.AssessmentIsReadOnly && Model.ReportDraftNotReady)
        {
            <div class="notice notice--warning" role="status">
                <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                <span>
                    @EngineerLabels.ReportDraftNotReady: @string.Join("; ", Model.ReportDraftReasons.Select(reason => reason.Requirement)).
                </span>
            </div>
        }
        @if (generation is not null)
        {
            <div class="detail-list">
                <div>
                    <dt>@ReportLabels.CurrentGeneration</dt>
                    <dd>@Pegasus.Core.LondonCalendar.TimeAt(generation.GeneratedAtUtc).ToString("d MMMM yyyy HH:mm")</dd>
                </div>
                <div>
                    <dt>@ReportLabels.GenerationState</dt>
                    <dd>@generation.State</dd>
                </div>
            </div>
            <div class="button-row">
                @foreach (var artifact in generation.Artifacts)
                {
                    if (artifact.Status == CaseReportArtifactStatus.Confirmed)
                    {
                        <a class="btn" asp-page="/Cases/Details" asp-page-handler="GeneratedArtifact"
                           asp-route-id="@caseId" asp-route-generationId="@generation.Id"
                           asp-route-artifactId="@artifact.Id" target="_blank" rel="noopener">
                            <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                            <span>@(artifact.Kind == CaseReportArtifactKind.FeeNote ? ReportLabels.DownloadFeeNote : ReportLabels.DownloadReport)</span>
                        </a>
                    }
                }
            </div>
            @if (generation.State == CaseReportGenerationState.Stale)
            {
                <div class="notice notice--warning" role="status">
                    <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                    <span>@ReportLabels.GenerationStaleNotice</span>
                </div>
            }
            @if (!Model.AssessmentIsReadOnly
                && preparation is null
                && generation.State == CaseReportGenerationState.Confirmed
                && generation.Artifacts.All(artifact => artifact.Status == CaseReportArtifactStatus.Confirmed))
            {
                <form method="post" asp-page="/Cases/Details" asp-page-handler="PrepareReportDelivery"
                      asp-route-id="@caseId" asp-route-section="report">
                    <input type="hidden" name="operationKey" value="@Model.PrepareDeliveryOperationKey" />
                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                    <input type="hidden" name="generationId" value="@generation.Id" />
                    <input type="hidden" name="expectedGenerationVersion" value="@generation.Version" />
                    <fieldset class="field">
                        <legend>Reviewed recipients</legend>
                        <label for="report-recipient-to">To</label>
                        <div id="report-recipient-to" class="stack">
                            @foreach (var recipient in suggestedRecipients.To.DefaultIfEmpty(string.Empty))
                            {
                                <input name="toRecipients" type="email" value="@recipient" autocomplete="email" aria-label="Report recipient" />
                            }
                        </div>
                        <button type="button" class="btn" data-add-report-recipient="report-recipient-to" data-report-recipient-name="toRecipients">Add To recipient</button>
                        <label for="report-recipient-cc">Cc</label>
                        <div id="report-recipient-cc" class="stack">
                            @foreach (var recipient in suggestedRecipients.Cc.DefaultIfEmpty(string.Empty))
                            {
                                <input name="ccRecipients" type="email" value="@recipient" autocomplete="email" aria-label="Report copy recipient" />
                            }
                        </div>
                        <button type="button" class="btn" data-add-report-recipient="report-recipient-cc" data-report-recipient-name="ccRecipients">Add Cc recipient</button>
                    </fieldset>
                    <button type="submit" class="btn">
                        <svg class="icon" aria-hidden="true"><use href="#icon-send" /></svg>
                        <span>@ReportLabels.PrepareDelivery</span>
                    </button>
                </form>
            }
            @if (preparation is not null && !Model.AssessmentIsReadOnly)
            {
                <div class="detail-list">
                    <div>
                        <dt>@ReportLabels.DeliveryPrepared</dt>
                        <dd>@string.Join(", ", preparation.Addressing.To.Select(recipient => recipient.Address))</dd>
                    </div>
                </div>
                <form method="post" asp-page="/Cases/Details" asp-page-handler="SendPreparedReport"
                      asp-route-id="@caseId" asp-route-section="report">
                    <input type="hidden" name="preparationId" value="@preparation.Preparation.Id" />
                    <input type="hidden" name="expectedPreparationVersion" value="@preparation.Preparation.Version" />
                    <button type="submit" class="btn">
                        <svg class="icon" aria-hidden="true"><use href="#icon-send" /></svg>
                        <span>@ReportLabels.SendPreparedReport</span>
                    </button>
                </form>
            }
        }
        @* B06/B08: the prepared images exactly as the report will use them —
           Close-up, Overview, then Supporting in order, Not used omitted —
           and, in edit mode, the same preparation controls the Files section
           offers, from the one shared partial. A card here and a card there
           can never state different preparation, or offer a different
           control, for one image. *@
        @if (Model.PreparedReportImages.Count > 0)
        {
            <partial name="Cases/Shared/_CaseReportImagePreparation"
                     model="ReportImagePreparationView.Report(Model)" />
        }
        <div class="grid grid-2">
            @foreach (var field in CaseWorkspaceLabels.Editors.Report)
            {
                var definition = AssessmentVocabulary.Definitions[field.Key];
                var value = Model.AssessmentEditorValue(field.Key);
                var name = CaseWorkspaceLabels.Editors.FormName(field.Key);
                if (Model.CanEditAssessmentField(field.Key))
                {
                    <div class="field">
                        <label for="edit-@field.Key">@field.Value</label>
                        @if (definition.Type == AssessmentFieldType.Flag)
                        {
                            <select id="edit-@field.Key" name="@name" form="case-edit-form">
                                <option value="" selected="@(value is null)"></option>
                                <option value="true" selected="@(value == "true")">Yes</option>
                                <option value="false" selected="@(value == "false")">No</option>
                            </select>
                        }
                        else if (definition.Type == AssessmentFieldType.Money)
                        {
                            <input type="number" step="0.01" id="edit-@field.Key" name="@name" value="@value" form="case-edit-form" />
                        }
                        else
                        {
                            <textarea id="edit-@field.Key" name="@name" form="case-edit-form" rows="4" maxlength="@definition.MaximumLength">@value</textarea>
                        }
                    </div>
                }
                else
                {
                    <dl class="detail-list"><div><dt>@field.Value</dt><dd>@Model.AssessmentValue(field.Key)</dd></div></dl>
                }
            }
            @if (Model.CanEditEngineering)
            {
                <div class="field">
                    <label for="edit-sign-off-engineer">Sign-off Engineer</label>
                    <select id="edit-sign-off-engineer" name="signOffEngineerId" form="case-edit-form">
                        <option value="" disabled selected="@(Model.SelectedSignOffEngineerId is null)"></option>
                        @foreach (var engineer in Model.EligibleSignOffEngineers)
                        {
                            <option value="@engineer.StaffId" selected="@(engineer.StaffId == Model.SelectedSignOffEngineerId)">@engineer.PrintedName</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="edit-report-date">Report date</label>
                    <input type="date" id="edit-report-date" name="reportDate" form="case-edit-form" value="@Model.AssessmentEditorValue(AssessmentVocabulary.ReportDate)" />
                </div>
            }
            else
            {
                <dl class="detail-list">
                    <div><dt>Sign-off Engineer</dt><dd>@Model.SignOffEngineerDisplayName</dd></div>
                    <div><dt>Report date</dt><dd>@Model.AssessmentValue(AssessmentVocabulary.ReportDate)</dd></div>
                </dl>
            }
        </div>
        <dl class="detail-list">
            <div><dt>@EngineerLabels.StatementOfTruth</dt><dd>@Model.AssessmentValue(AssessmentVocabulary.StatementOfTruth)</dd></div>
        </dl>
    </div>
</section>
