@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Cases
@using Pegasus.Core.Address
@using Pegasus.Web.Presentation
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var data = details.Data;
    var leaseToken = Model.LeaseToken;
    var mayEdit = Model.CanEditCaseData && data is not null;

    var address = data?.Inspection.Address;
    var recorded = address?.Current;

    // The Principal's own setting reaches the case as a field value sourced
    // ProviderSetting (CaseDataSnapshotFactory); it is the default until a
    // member of staff records something else.
    var providerDefault = new[] { address?.Confirmed, address?.Fact, address?.Suggestion }
        .FirstOrDefault(value => value?.Source.Kind == CaseDataSourceKind.ProviderSetting);
    var mode = data?.Inspection.Mode.Current;
    var storage = data?.Inspection.StorageLocation?.Current;
    var repairerName = data?.Inspection.RepairerName?.Current;
    var repairerAddress = data?.Inspection.RepairerAddress?.Current;
    var linkedRepairerId = data?.Workspace?.Repairer?.DirectoryOrganizationId;
    var choices = Model.InspectionAddressChoices;
    var selectedChoice = choices.FirstOrDefault(choice =>
        recorded is not null
        && choice.Address is not null
        && string.Equals(choice.Address, recorded.Value, StringComparison.OrdinalIgnoreCase))
        ?? choices.FirstOrDefault(choice => choice.Kind == InspectionAddressChoiceKind.ManualEntry);
    // What the read view still has to say once the value itself is on the
    // page: the Principal's default only where the Case does not already hold
    // it, and the mode only where its words are not the value already shown.
    var showProviderDefault = providerDefault is not null
        && !string.Equals(providerDefault.Value, recorded?.Value, StringComparison.OrdinalIgnoreCase);
    var modeLabel = mode is null ? null : OperatorLabels.InspectionMode(mode.Value);
    var showModeChip = modeLabel is not null
        && !string.Equals(modeLabel, recorded?.Value, StringComparison.OrdinalIgnoreCase);
    var isPhysicalAddress = mode?.Value == CaseInspectionMode.PhysicalAddress;
    var addressLines = recorded is null
        ? Array.Empty<string>()
        : recorded.Value
            .Split([',', '\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    string ChoiceLabel(InspectionAddressChoice choice) => choice.Kind switch
    {
        InspectionAddressChoiceKind.ImageBasedAssessment => OperatorLabels.CaseWorkspace.ImageBasedAssessment,
        InspectionAddressChoiceKind.ClaimantAddress => OperatorLabels.CaseWorkspace.ClaimantAddress,
        InspectionAddressChoiceKind.RepairerLocation => choice.SourceLabel is null
            ? OperatorLabels.CaseWorkspace.RepairerLocation
            : $"{OperatorLabels.CaseWorkspace.RepairerLocation} · {choice.SourceLabel}",
        InspectionAddressChoiceKind.StorageLocation => OperatorLabels.CaseWorkspace.StorageLocation,
        InspectionAddressChoiceKind.PreviousAddress => $"{OperatorLabels.CaseWorkspace.PreviousAddress} · {choice.Address}",
        InspectionAddressChoiceKind.ManualEntry => OperatorLabels.CaseWorkspace.ManualEntry,
        _ => throw new InvalidOperationException("The inspection-address choice is invalid.")
    };
}

<div class="stack">
    @if (!mayEdit)
    {
        @* One row per fact the operator cannot derive from the row above it:
           the recorded address (with the mode beside it only when the mode
           says something the address does not), the Principal's default only
           where it differs from what the Case holds, the storage location and
           the repairer. The chosen source and the mode restated the address
           itself on an image-based Case, which read as four copies of one
           value. *@
        <section class="panel" aria-labelledby="case-inspection-address-title">
            <div class="panel-head">
                <h2 id="case-inspection-address-title">@OperatorLabels.CaseWorkspace.InspectionAddressPanel</h2>
            </div>
            <div class="panel-body">
                <div class="definition-list">
                    <dl class="definition">
                        <dt>@OperatorLabels.CaseWorkspace.InspectAt</dt>
                        <dd>
                            @if (recorded is null)
                            {
                                @OperatorLabels.CaseWorkspace.NotRecorded
                            }
                            else if (isPhysicalAddress)
                            {
                                <div class="address-lines">
                                    @foreach (var line in addressLines)
                                    {
                                        <div>@line</div>
                                    }
                                </div>
                            }
                            else
                            {
                                @recorded.Value
                            }
                            @if (recorded is not null)
                            {
                                <partial name="Shared/_Provenance" model="recorded.Source" />
                            }
                            @if (showModeChip)
                            {
                                <partial name="Shared/_StatusChip" model="@modeLabel" />
                            }
                        </dd>
                    </dl>
                    @if (showProviderDefault)
                    {
                        <dl class="definition">
                            <dt>@OperatorLabels.CaseWorkspace.PrincipalDefaultInspectionAddress</dt>
                            <dd>@providerDefault!.Value</dd>
                        </dl>
                    }
                    <dl class="definition">
                        <dt>@OperatorLabels.CaseWorkspace.StorageLocation</dt>
                        <dd>@(storage?.Value ?? OperatorLabels.CaseWorkspace.NotRecorded)</dd>
                    </dl>
                    <dl class="definition">
                        <dt>@OperatorLabels.CaseWorkspace.Repairer</dt>
                        <dd>@(repairerName?.Value ?? OperatorLabels.CaseWorkspace.NotRecorded)</dd>
                    </dl>
                    <dl class="definition">
                        <dt>@OperatorLabels.CaseWorkspace.RepairerLocation</dt>
                        <dd>@(repairerAddress?.Value ?? OperatorLabels.CaseWorkspace.NotRecorded)</dd>
                    </dl>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="panel" aria-labelledby="case-inspection-address-edit-title">
            <div class="panel-head">
                <h2 id="case-inspection-address-edit-title">@OperatorLabels.CaseWorkspace.InspectionAddressPanel</h2>
            </div>
            <div class="panel-body">
                @* CASE-038: the record renders every section at once, so a
                   second whole-record form here would post the case's stored
                   values over whatever the Overview editor is holding unsaved.
                   The section contributes its control to the one record form
                   instead — one edit mode over one lease, one Save. The
                   Overview form no longer carries a hidden `inspectionAddress`,
                   so this input is the only entry for that name and the address
                   shown here is the address that is saved. *@
                <div class="form-grid form-grid--2 case-inspection-form">
                <div class="field">
                    <label for="inspection-address-choice">@OperatorLabels.CaseWorkspace.InspectAt</label>
                    <select id="inspection-address-choice" data-inspection-address-choice form="case-edit-form">
                        @foreach (var choice in choices)
                        {
                            var label = ChoiceLabel(choice);
                            <option value="@choice.Kind" data-address="@choice.Address"
                                    selected="@(choice == selectedChoice ? "selected" : null)"
                                    disabled="@(!choice.IsAvailable ? "disabled" : null)">@label@(!choice.IsAvailable ? OperatorLabels.CaseWorkspace.NotRecordedSuffix : null)</option>
                        }
                    </select>
                </div>
                <div class="field field-wide" data-inspection-address-field>
                    <label for="inspection-address">@OperatorLabels.CaseWorkspace.InspectionAddressPanel</label>
                    <input id="inspection-address" name="inspectionAddress" form="case-edit-form"
                           maxlength="1000" value="@recorded?.Value" data-inspection-address-input />
                </div>
                <div class="field field-wide" data-inspection-provider-default hidden>
                    <span class="label">@OperatorLabels.CaseWorkspace.PrincipalDefaultInspectionAddress</span>
                    <span class="value">@providerDefault?.Value</span>
                </div>
                <div class="field">
                    <label for="storage-location">@OperatorLabels.CaseWorkspace.StorageLocation</label>
                    <input id="storage-location" name="storageLocation" form="case-edit-form"
                           maxlength="1000" value="@storage?.Value" />
                </div>
                @* INTK-058: the Case's repairer. Selecting a maintained
                   Contacts organisation copies its name and address onto the
                   Case; leaving it unlinked keeps the extracted or keyed
                   text. Either way the Save is the staff confirmation, and
                   the confirmed address is what the Inspect-at repairer
                   option offers. *@
                <div class="field">
                    <label for="repairer-directory">@OperatorLabels.CaseWorkspace.RepairerDirectory</label>
                    <select id="repairer-directory" name="repairerDirectoryId" form="case-edit-form">
                        <option value="">@OperatorLabels.CaseWorkspace.NotLinked</option>
                        @foreach (var contact in Model.RepairerChoices)
                        {
                            <option value="@contact.OrganizationId"
                                    selected="@(contact.OrganizationId == linkedRepairerId ? "selected" : null)">@contact.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="repairer-name">@OperatorLabels.CaseWorkspace.Repairer</label>
                    <input id="repairer-name" name="repairerName" form="case-edit-form"
                           maxlength="300" value="@repairerName?.Value" />
                </div>
                <div class="field field-wide">
                    <label for="repairer-address">@OperatorLabels.CaseWorkspace.RepairerLocation</label>
                    <input id="repairer-address" name="repairerAddress" form="case-edit-form"
                           maxlength="1000" value="@repairerAddress?.Value" />
                </div>
                </div>
            </div>
        </section>
    }
</div>
