@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Vehicle
@using Pegasus.Web.Presentation
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var data = details.Data;
    var leaseToken = Model.LeaseToken;
    var mayEdit = !string.IsNullOrWhiteSpace(leaseToken) && workflow.Archive is null;
    string Value(string? text) => string.IsNullOrWhiteSpace(text)
        ? OperatorLabels.CaseWorkspace.AbsentValue : text;
    var registration = details.VehicleEvidence?.Confirmed?.Registration.Value
        ?? data?.Vehicle.Registration.Current?.Value ?? details.Summary.Registration;
    // Confirmed ?? Fact only — CaseField<T>.Current also falls through to an
    // unaccepted suggestion, which would render with no marker distinguishing
    // it from a recorded value while the chip beside it still offers "Use …".
    var make = data?.Vehicle.Make.Confirmed?.Value ?? data?.Vehicle.Make.Fact?.Value;
    var model = data?.Vehicle.Model.Confirmed?.Value ?? data?.Vehicle.Model.Fact?.Value;
    var mileage = data?.Vehicle.Mileage.Confirmed?.Value ?? data?.Vehicle.Mileage.Fact?.Value;
    var unit = data?.Vehicle.MileageUnit.Confirmed?.Value ?? data?.Vehicle.MileageUnit.Fact?.Value;
    var makeSuggestion = data?.Vehicle.Make.Suggestion;
    var modelSuggestion = data?.Vehicle.Model.Suggestion;
    var mileageSuggestion = data?.Vehicle.Mileage.Suggestion;
    var unitSuggestion = data?.Vehicle.MileageUnit.Suggestion;
    var showMake = makeSuggestion is not null
        && !string.IsNullOrWhiteSpace(makeSuggestion.Value)
        && !string.Equals(makeSuggestion.Value,
            data?.Vehicle.Make.Confirmed?.Value ?? data?.Vehicle.Make.Fact?.Value,
            StringComparison.OrdinalIgnoreCase);
    var showModel = modelSuggestion is not null
        && !string.IsNullOrWhiteSpace(modelSuggestion.Value)
        && !string.Equals(modelSuggestion.Value,
            data?.Vehicle.Model.Confirmed?.Value ?? data?.Vehicle.Model.Fact?.Value,
            StringComparison.OrdinalIgnoreCase);
    var showMileage = mileageSuggestion is not null && unitSuggestion is not null
        && (mileageSuggestion.Value != (data?.Vehicle.Mileage.Confirmed?.Value ?? data?.Vehicle.Mileage.Fact?.Value)
            || !string.Equals(unitSuggestion.Value,
                data?.Vehicle.MileageUnit.Confirmed?.Value ?? data?.Vehicle.MileageUnit.Fact?.Value,
                StringComparison.Ordinal));
    var mileageText = mileage is { } figure
        ? string.IsNullOrWhiteSpace(unit) ? figure.ToString("N0") : $"{figure:N0} {unit}"
        : null;
    var mileageSource = (data?.Vehicle.Mileage.Confirmed ?? data?.Vehicle.Mileage.Fact) is { } mileageValue
        ? OperatorLabels.Provenance(mileageValue.Source).Word : null;
    var year = details.VehicleEvidence?.LatestObservation?.Vehicle?.ManufactureYear;
}

<section class="panel" aria-labelledby="case-vehicle-title">
    <div class="panel-head">
        <h2 id="case-vehicle-title">@OperatorLabels.CaseWorkspace.VehicleFactsPanel</h2>
        <div class="button-row">
            @if (mayEdit)
            {
                <form method="post" asp-page="/Cases/Vehicle" asp-route-id="@workflow.CaseId" asp-page-handler="RequestVehicleLookup">
                    <input type="hidden" name="id" value="@workflow.CaseId" />
                    <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                    <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                    <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                    <input type="hidden" name="registration" value="@registration" />
                    @if (!string.IsNullOrWhiteSpace(registration))
                    {
                        <button type="submit" class="btn btn--small">@CaseWorkspaceLabels.Vehicle.LookupDvlaMot</button>
                    }
                    else
                    {
                        <span class="gated" data-condition="@OperatorLabels.CaseWorkspace.NoRegistrationCondition">
                            <button type="submit" class="btn btn--small" disabled aria-disabled="true">@CaseWorkspaceLabels.Vehicle.LookupDvlaMot</button>
                        </span>
                    }
                </form>
            }
            <span class="gated" data-condition="@OperatorLabels.CaseWorkspace.ExperianSeamCondition">
                <button type="button" class="btn btn--small" disabled aria-disabled="true">@OperatorLabels.CaseWorkspace.RunExperianCheck</button>
            </span>
        </div>
    </div>
    <div class="panel-body">
        <div class="overview-facts">
            <dl><dt>Registration</dt><dd>@Value(registration)</dd></dl>
            <dl><dt>Make</dt><dd>@Value(make)</dd>@if (mayEdit && showMake){<form method="post" asp-page="/Cases/Vehicle" asp-route-id="@workflow.CaseId" asp-page-handler="AcceptVehicleSuggestion"><input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="lookupObservationId" value="@makeSuggestion!.Source.Identity" /><input type="hidden" name="field" value="Make" /><input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" /><button type="submit" class="suggestion-chip">@CaseWorkspaceLabels.Vehicle.UseSuggestion(makeSuggestion.Value)</button></form>}</dl>
            <dl><dt>Model</dt><dd>@Value(model)</dd>@if (mayEdit && showModel){<form method="post" asp-page="/Cases/Vehicle" asp-route-id="@workflow.CaseId" asp-page-handler="AcceptVehicleSuggestion"><input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="lookupObservationId" value="@modelSuggestion!.Source.Identity" /><input type="hidden" name="field" value="Model" /><input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" /><button type="submit" class="suggestion-chip">@CaseWorkspaceLabels.Vehicle.UseSuggestion(modelSuggestion.Value)</button></form>}</dl>
            <dl><dt>Year</dt><dd>@Value(year?.ToString())</dd></dl>
            <dl><dt>Mileage</dt><dd>@Value(mileageText)</dd>@if (mayEdit && showMileage){<form method="post" asp-page="/Cases/Vehicle" asp-route-id="@workflow.CaseId" asp-page-handler="AcceptVehicleSuggestion"><input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="lookupObservationId" value="@mileageSuggestion!.Source.Identity" /><input type="hidden" name="field" value="Mileage" /><input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" /><button type="submit" class="suggestion-chip">@CaseWorkspaceLabels.Vehicle.UseSuggestion($"{mileageSuggestion.Value:N0} {unitSuggestion!.Value}")</button></form>}</dl>
            <dl><dt>Mileage source</dt><dd>@Value(mileageSource)</dd></dl>
        </div>
    </div>
</section>
