@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Cases
@using Pegasus.Core.Assessment
@using Pegasus.Web.Presentation
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var data = details.Data;
    var leaseToken = Model.LeaseToken;
    var mayEdit = Model.CanEditCaseData;
    // The record's one Save form is rendered by the Overview section, and only
    // when there is Case data to edit; these controls join that form.
    var editFields = mayEdit && data is not null;
    string Value(string? text) => string.IsNullOrWhiteSpace(text)
        ? OperatorLabels.CaseWorkspace.AbsentValue : text;
    // Confirmed ?? Fact only. A lookup now fills an empty field as a fact
    // carrying its own provenance, so no row has an unaccepted suggestion left
    // to render and nothing is offered for acceptance beside one.
    var registrationValue = data?.Vehicle.Registration.Confirmed ?? data?.Vehicle.Registration.Fact;
    var registration = registrationValue?.Value
        // The list-summary value is only the identity when no Case-data
        // projection is available.
        ?? (data is null ? details.Summary.Registration : null);
    var makeValue = data?.Vehicle.Make.Confirmed ?? data?.Vehicle.Make.Fact;
    var modelValue = data?.Vehicle.Model.Confirmed ?? data?.Vehicle.Model.Fact;
    var yearValue = data?.Vehicle.Year.Confirmed ?? data?.Vehicle.Year.Fact;
    var mileageValue = data?.Vehicle.Mileage.Confirmed ?? data?.Vehicle.Mileage.Fact;
    var unit = (data?.Vehicle.MileageUnit.Confirmed ?? data?.Vehicle.MileageUnit.Fact)?.Value;
    var mileageText = mileageValue is { } odometer
        ? string.IsNullOrWhiteSpace(unit) ? odometer.Value.ToString("N0") : $"{odometer.Value:N0} {unit}"
        : null;
    // Who told staff the figure is theirs to state. The pick is kept beside
    // the box whenever the box is editable, because the figure typed into it
    // may be the one it describes; every other provenance resolves itself.
    var mileageSource = Model.AssessmentEditorValue(AssessmentVocabulary.VehicleMileageSource);
    // What the lookup itself did, so one that ran and found nothing is never
    // read as one that never ran (WP8).
    var observation = details.VehicleEvidence?.LatestObservation;
}

<section class="panel" aria-labelledby="case-vehicle-title">
    <div class="panel-head">
        <h2 id="case-vehicle-title">@OperatorLabels.CaseWorkspace.VehicleFactsPanel</h2>
        <div class="button-row">
            @if (mayEdit)
            {
                <form method="post" asp-page="/Cases/Vehicle" asp-route-id="@workflow.CaseId" asp-page-handler="RequestVehicleLookup">
                    <input type="hidden" name="id" value="@workflow.CaseId" />
                    <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                    <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                    <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                    <input type="hidden" name="registration" value="@registration" />
                    @if (!string.IsNullOrWhiteSpace(registration))
                    {
                        <button type="submit" class="btn btn--small">@CaseWorkspaceLabels.Vehicle.LookupDvlaMot</button>
                    }
                    else
                    {
                        <span class="gated" data-condition="@OperatorLabels.CaseWorkspace.NoRegistrationCondition">
                            <button type="submit" class="btn btn--small" disabled aria-disabled="true">@CaseWorkspaceLabels.Vehicle.LookupDvlaMot</button>
                        </span>
                    }
                </form>
            }
            <span class="gated" data-condition="@OperatorLabels.CaseWorkspace.ExperianSeamCondition">
                <button type="button" class="btn btn--small" disabled aria-disabled="true">@OperatorLabels.CaseWorkspace.RunExperianCheck</button>
            </span>
        </div>
    </div>
    <div class="panel-body">
        <div class="overview-facts">
            @* WP6: the vehicle's own identity is edited where it is read. The
               controls belong to the record's one Save form, as every other
               section's do, and every value states where it came from. *@
            <dl><dt>@if (editFields){<label for="edit-registration">Registration</label>} else {<text>Registration</text>}</dt><dd>@if (editFields){<input id="edit-registration" name="vehicleRegistration" form="case-edit-form" maxlength="20" value="@registrationValue?.Value" />} else {@Value(registration)}@if (registrationValue is not null){<partial name="Shared/_Provenance" model="registrationValue.Source" />}</dd></dl>
            <dl><dt>@if (editFields){<label for="edit-make">Make</label>} else {<text>Make</text>}</dt><dd>@if (editFields){<input id="edit-make" name="vehicleMake" form="case-edit-form" maxlength="100" value="@makeValue?.Value" />} else {@Value(makeValue?.Value)}@if (makeValue is not null){<partial name="Shared/_Provenance" model="makeValue.Source" />}</dd></dl>
            <dl><dt>@if (editFields){<label for="edit-model">Model</label>} else {<text>Model</text>}</dt><dd>@if (editFields){<input id="edit-model" name="vehicleModel" form="case-edit-form" maxlength="100" value="@modelValue?.Value" />} else {@Value(modelValue?.Value)}@if (modelValue is not null){<partial name="Shared/_Provenance" model="modelValue.Source" />}</dd></dl>
            <dl><dt>@if (editFields){<label for="edit-year">Year</label>} else {<text>Year</text>}</dt><dd>@if (editFields){<input id="edit-year" name="vehicleYear" form="case-edit-form" maxlength="10" inputmode="numeric" value="@yearValue?.Value" />} else {@Value(yearValue?.Value)}@if (yearValue is not null){<partial name="Shared/_Provenance" model="yearValue.Source" />}</dd></dl>
            @* One mileage row, with the provenance the report's source code is
               read from. The staff pick rides beside the box while it is
               editable, and is ignored unless staff supplied the figure. *@
            <dl><dt>@if (editFields){<label for="edit-mileage">Mileage</label>} else {<text>Mileage</text>}</dt><dd>@if (editFields){<input id="edit-mileage" name="vehicleMileage" type="number" min="0" step="1" inputmode="numeric" form="case-edit-form" value="@mileageValue?.Value" />} else {@Value(mileageText)}@if (editFields){<select id="edit-mileage-source" name="vehicleMileageSource" form="case-edit-form" aria-label="Mileage source">@foreach (var code in CaseVehicleMileageSourcePolicy.StaffChoices){<option value="@code" selected="@(string.Equals(code, mileageSource ?? CaseVehicleMileageSourcePolicy.StaffChoices[0], StringComparison.Ordinal) ? "selected" : null)">@CaseWorkspaceLabels.Vehicle.MileageSource(code)</option>}</select>}@if (mileageValue is not null){<partial name="Shared/_Provenance" model="mileageValue.Source" />}</dd></dl>
            <dl><dt>@OperatorLabels.VehicleLookup.OutcomeTitle</dt><dd>@OperatorLabels.VehicleLookup.Outcome(observation)</dd></dl>
        </div>
        @* The history check is prose about the vehicle rather than one of its
           facts, so it reads as its own area under the grid. *@
        <div class="field vehicle-history">
            <h3 id="case-vehicle-history-title" class="eyebrow">Vehicle history</h3>
            @if (Model.CanEditAssessmentField(AssessmentVocabulary.HistoryCheck))
            {
                <textarea id="edit-vehicle-history" name="@CaseWorkspaceLabels.Editors.FormName(AssessmentVocabulary.HistoryCheck)"
                          form="case-edit-form" aria-labelledby="case-vehicle-history-title" rows="4"
                          maxlength="@AssessmentVocabulary.Definitions[AssessmentVocabulary.HistoryCheck].MaximumLength">@Model.AssessmentEditorValue(AssessmentVocabulary.HistoryCheck)</textarea>
            }
            else
            {
                <p>@Model.AssessmentValue(AssessmentVocabulary.HistoryCheck)</p>
            }
        </div>
    </div>
</section>
