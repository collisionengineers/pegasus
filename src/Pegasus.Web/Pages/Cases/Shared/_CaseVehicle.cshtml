@*
    Vehicle (v26): the vehicle's identity and the lookup's provenance rows as
    one geometry, one mileage box with its source chip (v25 decision 6), the
    pre-incident condition and the history check. The head carries the lookup
    line and the lookup itself; Experian is a seam and reads as one.

    WP6: the vehicle's identity is edited where it is read. The controls
    belong to the record's one Save form, as every other section's do, and
    every value states where it came from.
*@
@model Pegasus.Web.Pages.Cases.DetailsModel
@using System.Globalization
@using Pegasus.Core.Cases
@using Pegasus.Core.Assessment
@using Pegasus.Web.Presentation
@using VehicleLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Vehicle
@{
    var section = Model.VehicleSection;
    var workflow = section?.Frame.Workflow ?? Model.Case!.Workflow;
    var summary = section?.Frame.Summary ?? Model.Case!.Summary;
    var data = section?.Data ?? Model.Case!.Data;
    var leaseToken = Model.LeaseToken;
    var mayEdit = Model.CanEditCaseData;
    // The record's one Save form is rendered by the Overview section, and only
    // when there is Case data to edit; these controls join that form.
    var editFields = mayEdit && data is not null;
    var headTools = new Pegasus.Web.Pages.Cases.CaseSectionHeadView(Model, "vehicle");

    // Confirmed ?? Fact only. A lookup now fills an empty field as a fact
    // carrying its own provenance, so no row has an unaccepted suggestion left
    // to render and nothing is offered for acceptance beside one.
    var registrationValue = data?.Vehicle.Registration.Confirmed ?? data?.Vehicle.Registration.Fact;
    var registration = registrationValue?.Value
        // The list-summary value is only the identity when no Case-data
        // projection is available.
        ?? (data is null ? summary.Registration : null);
    var makeValue = data?.Vehicle.Make.Confirmed ?? data?.Vehicle.Make.Fact;
    var modelValue = data?.Vehicle.Model.Confirmed ?? data?.Vehicle.Model.Fact;
    var yearValue = data?.Vehicle.Year.Confirmed ?? data?.Vehicle.Year.Fact;
    var mileageValue = data?.Vehicle.Mileage.Confirmed ?? data?.Vehicle.Mileage.Fact;
    var unit = (data?.Vehicle.MileageUnit.Confirmed ?? data?.Vehicle.MileageUnit.Fact)?.Value;
    var unitWord = string.IsNullOrWhiteSpace(unit) ? null
        : unit.Equals("km", StringComparison.OrdinalIgnoreCase) || unit.StartsWith("kilo", StringComparison.OrdinalIgnoreCase)
            ? "km" : "mi";
    var mileageText = mileageValue is { } odometer
        ? unitWord is null ? odometer.Value.ToString("N0") : $"{odometer.Value:N0} {unitWord}"
        : null;
    // Who told staff the figure is theirs to state. The pick is kept beside
    // the box whenever the box is editable, because the figure typed into it
    // may be the one it describes; every other provenance resolves itself.
    var mileageSource = Model.AssessmentEditorValue(AssessmentVocabulary.VehicleMileageSource);
    var staffPicked = mileageSource is not null && CaseVehicleMileageSourcePolicy.StaffChoices.Contains(mileageSource);
    var mileageSourceWord = staffPicked
        ? VehicleLabels.MileageSource(mileageSource!)
        : mileageValue is not null ? OperatorLabels.SourceTag(mileageValue.Source)?.Word : null;
    // The select opens on what the box reads: the staff pick, else the
    // figure's own source (no staff pick), else the first staff choice.
    var selectedMileageSource = staffPicked ? mileageSource : mileageSourceWord is null ? CaseVehicleMileageSourcePolicy.StaffChoices[0] : null;
    var condition = Model.AssessmentEditorValue(AssessmentVocabulary.VehicleCondition);
    var conditionCodes = AssessmentVocabulary.Definitions[AssessmentVocabulary.VehicleCondition].Codes ?? [];
    var canEditCondition = Model.CanEditAssessmentField(AssessmentVocabulary.VehicleCondition);
    var canEditHistory = Model.CanEditAssessmentField(AssessmentVocabulary.HistoryCheck);
    // What the lookup itself did, so one that ran and found nothing is never
    // read as one that never ran (WP8).
    var observation = section?.LatestVehicleObservation;
    var lookupLine = VehicleLabels.LookupLine(observation);
    var offersLookup = mayEdit && !string.IsNullOrWhiteSpace(registration);

    string Value(string? text) => string.IsNullOrWhiteSpace(text) ? OperatorLabels.CaseWorkspace.AbsentValue : text;
    string ValueClass(string? text) => string.IsNullOrWhiteSpace(text) ? "fv empty" : "fv";
    // A cell without a control is .ro, so its value stays while the record edits.
    string? Ro(bool editable) => editable ? null : "ro";

    // The vehicle's facts in the v29 order, one geometry in read and edit. A row
    // the Vehicle editor records (CaseWorkspaceLabels.Editors.Vehicle: VIN, type,
    // body and the transmission no approved lookup returns) is edited in place;
    // every other row is a fact only the DVLA/DVSA lookup records
    // (AssessmentVocabulary.LookupDerivedPaths): read-only, tagged Lookup, always
    // drawn and "Not recorded" until a lookup answers, so an answer never
    // reflows the grid.
    (string Path, string Label)[] vehicleRows =
    [
        (AssessmentVocabulary.VehicleVin, VehicleLabels.Vin),
        (AssessmentVocabulary.VehicleType, VehicleLabels.VehicleType),
        (AssessmentVocabulary.VehicleBody, VehicleLabels.BodyType),
        (AssessmentVocabulary.VehicleEngineCc, VehicleLabels.EngineCc),
        (AssessmentVocabulary.VehicleFuel, VehicleLabels.Fuel),
        (AssessmentVocabulary.VehicleColour, VehicleLabels.Colour),
        (AssessmentVocabulary.VehicleTransmission, VehicleLabels.Transmission),
        (AssessmentVocabulary.VehicleTaxExpiry, VehicleLabels.TaxExpiry),
        (AssessmentVocabulary.VehicleMotExpiry, VehicleLabels.MotExpiry)
    ];
}

<section class="record-section panel @Model.CollapsedClass("case.vehicle") @Model.ActiveTabClass("vehicle") @(Model.IsEditing && !Model.SectionIsEditable("vehicle") ? "is-locked" : null)" id="section-vehicle" data-section="vehicle" data-collapse="case.vehicle" aria-labelledby="section-vehicle-title">
    <div class="panel-head">
        <h2 id="section-vehicle-title">@OperatorLabels.CaseWorkspace.VehicleFactsPanel</h2>
        <span class="meta @(observation is null ? "quiet" : null)" data-vehicle-lookup-line>@lookupLine</span>
        <div class="panel-actions">
            @if (offersLookup)
            {
                @* Absent, never disabled, without a registration to search on. *@
                <form method="post" asp-page="/Cases/Vehicle" asp-route-id="@workflow.CaseId" asp-page-handler="RequestVehicleLookup" data-vehicle-lookup>
                    <input type="hidden" name="id" value="@workflow.CaseId" />
                    <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                    <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                    <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                    <input type="hidden" name="registration" value="@registration" />
                    <button type="submit" class="btn btn--small">
                        <svg class="icon" aria-hidden="true"><use href="#icon-search" /></svg>
                        <span>@VehicleLabels.LookupDvlaMot</span>
                    </button>
                </form>
            }
            <span class="gated" data-vehicle-experian-seam>
                <svg class="icon" aria-hidden="true"><use href="#icon-lock" /></svg>
                <span>@OperatorLabels.CaseWorkspace.ExperianSeamCondition</span>
            </span>
            <partial name="Cases/Shared/_CaseSectionHeadTools" model="headTools" />
        </div>
    </div>
    <div class="panel-body stack">
        <div class="fg g4" data-vehicle-facts>
            <div class="fc @Ro(editFields)">
                @{ Lbl(editFields, "edit-registration", VehicleLabels.Registration, OperatorLabels.SourceTag(registrationValue?.Source)); }
                <div class="@ValueClass(registration) mono">@Value(registration)</div>
                @if (editFields)
                {
                    <input id="edit-registration" class="fi mono" name="vehicleRegistration" form="case-edit-form" maxlength="20" value="@registrationValue?.Value" />
                }
            </div>
            <div class="fc @Ro(editFields)">
                @{ Lbl(editFields, "edit-make", VehicleLabels.Make, OperatorLabels.SourceTag(makeValue?.Source)); }
                <div class="@ValueClass(makeValue?.Value)">@Value(makeValue?.Value)</div>
                @if (editFields)
                {
                    <input id="edit-make" class="fi" name="vehicleMake" form="case-edit-form" maxlength="100" value="@makeValue?.Value" />
                }
            </div>
            <div class="fc @Ro(editFields)">
                @{ Lbl(editFields, "edit-model", VehicleLabels.Model, OperatorLabels.SourceTag(modelValue?.Source)); }
                <div class="@ValueClass(modelValue?.Value)">@Value(modelValue?.Value)</div>
                @if (editFields)
                {
                    <input id="edit-model" class="fi" name="vehicleModel" form="case-edit-form" maxlength="100" value="@modelValue?.Value" />
                }
            </div>
            <div class="fc @Ro(editFields)">
                @{ Lbl(editFields, "edit-year", VehicleLabels.Year, OperatorLabels.SourceTag(yearValue?.Source)); }
                <div class="@ValueClass(yearValue?.Value)">@Value(yearValue?.Value)</div>
                @if (editFields)
                {
                    <input id="edit-year" class="fi" name="vehicleYear" form="case-edit-form" maxlength="10" inputmode="numeric" value="@yearValue?.Value" />
                }
            </div>
            @foreach (var (path, label) in vehicleRows)
            {
                var recorded = Model.Assessment?.Field(path);
                var raw = recorded?.Value;
                if (CaseWorkspaceLabels.Editors.Vehicle.ContainsKey(path))
                {
                    @* A fact the Vehicle editor records: edited wherever the
                       registration is, each value tagged by who recorded it; a
                       staff save re-stamps it as staff's. *@
                    var definition = AssessmentVocabulary.Definitions[path];
                    var controlId = "edit-" + path.Replace('.', '-').Replace('_', '-');
                    <div class="fc @Ro(editFields)" data-vehicle-identity="@path">
                        @{ Lbl(editFields, controlId, label, OperatorLabels.SourceTag(recorded)); }
                        <div class="@ValueClass(raw) @(path == AssessmentVocabulary.VehicleVin ? "mono" : null)">@(string.IsNullOrWhiteSpace(raw) ? OperatorLabels.CaseWorkspace.AbsentValue : VehicleLabels.AssessmentValue(path, raw))</div>
                        @if (editFields && definition.Type == AssessmentFieldType.Enumerated)
                        {
                            <select id="@controlId" class="fi" name="@CaseWorkspaceLabels.Editors.FormName(path)" form="case-edit-form">
                                <option value="" selected="@(raw is null)"></option>
                                @foreach (var code in definition.Codes ?? [])
                                {
                                    <option value="@code" selected="@(raw == code)">@VehicleLabels.AssessmentValue(path, code)</option>
                                }
                            </select>
                        }
                        else if (editFields)
                        {
                            <input id="@controlId" class="fi @(path == AssessmentVocabulary.VehicleVin ? "mono" : null)" name="@CaseWorkspaceLabels.Editors.FormName(path)" form="case-edit-form"
                                   maxlength="@(path == AssessmentVocabulary.VehicleVin ? 17 : definition.MaximumLength)"
                                   pattern="@(path == AssessmentVocabulary.VehicleVin ? "[A-HJ-NPR-Za-hj-npr-z0-9]{17}" : null)" value="@raw" />
                        }
                    </div>
                }
                else
                {
                    <div class="fc ro" data-vehicle-provenance-row="@path">
                        @{ Lbl(false, string.Empty, label, OperatorLabels.SourceTag(recorded)); }
                        <div class="@ValueClass(raw)">@(string.IsNullOrWhiteSpace(raw) ? OperatorLabels.CaseWorkspace.AbsentValue : VehicleLabels.AssessmentValue(path, raw))</div>
                    </div>
                }
            }
        </div>

        <div class="sub-panel @Model.CollapsedClass("case.vehicle.mileage")" data-vehicle-mileage data-collapse="case.vehicle.mileage"><h3>@VehicleLabels.MileageAndCondition <partial name="Shared/_SubPanelToggle" model="@Model.SubPanel("case.vehicle.mileage")" /></h3>
            <div class="fg g4">
                @* One mileage box, with the provenance the report's source code
                   is read from. The staff pick rides beside the box while it is
                   editable, and is ignored unless staff supplied the figure. *@
                <div class="fc @Ro(editFields)">
                    @{ Lbl(editFields, "edit-mileage", VehicleLabels.Mileage, OperatorLabels.SourceTag(mileageValue?.Source)); }
                    <div class="@ValueClass(mileageText) mono" data-vehicle-mileage-read>@Value(mileageText)</div>
                    @if (editFields)
                    {
                        <input id="edit-mileage" class="fi mono" name="vehicleMileage" type="number" min="0" step="1" inputmode="numeric" form="case-edit-form" value="@mileageValue?.Value" />
                    }
                </div>
                <div class="fc @Ro(editFields)">
                    @{ Lbl(editFields, "edit-mileage-source", VehicleLabels.MileageSourceLabel); }
                    <div class="@ValueClass(mileageSourceWord)">@Value(mileageSourceWord)</div>
                    @if (editFields)
                    {
                        <select id="edit-mileage-source" class="fi" name="vehicleMileageSource" form="case-edit-form">
                            @if (!staffPicked && mileageSourceWord is not null)
                            {
                                <option value="" selected>@mileageSourceWord</option>
                            }
                            @foreach (var code in CaseVehicleMileageSourcePolicy.StaffChoices)
                            {
                                <option value="@code" selected="@(code == selectedMileageSource ? "selected" : null)">@VehicleLabels.MileageSource(code)</option>
                            }
                        </select>
                    }
                </div>
                <div class="fc @Ro(canEditCondition)">
                    @{ Lbl(canEditCondition, "edit-vehicle-condition", VehicleLabels.PreIncidentCondition, Model.AssessmentSourceTag(AssessmentVocabulary.VehicleCondition)); }
                    <div class="@ValueClass(condition)">@(condition is null ? OperatorLabels.CaseWorkspace.AbsentValue : VehicleLabels.ConditionLabel(condition))</div>
                    @if (canEditCondition)
                    {
                        <select id="edit-vehicle-condition" class="fi" name="@CaseWorkspaceLabels.Editors.FormName(AssessmentVocabulary.VehicleCondition)" form="case-edit-form">
                            <option value="" selected="@(condition is null ? "selected" : null)"></option>
                            @foreach (var code in conditionCodes)
                            {
                                <option value="@code" selected="@(condition == code ? "selected" : null)">@VehicleLabels.ConditionLabel(code)</option>
                            }
                        </select>
                    }
                </div>
                <div class="fc @Ro(editFields)">
                    @{ Lbl(editFields, "edit-mileage-unit", VehicleLabels.OdometerUnit); }
                    <div class="@ValueClass(unit)">@(unitWord is null ? OperatorLabels.CaseWorkspace.AbsentValue : unitWord == "km" ? VehicleLabels.Kilometres : VehicleLabels.Miles)</div>
                    @if (editFields)
                    {
                        <select id="edit-mileage-unit" class="fi" name="vehicleMileageUnit" form="case-edit-form">
                            <option value="miles" selected="@(unitWord != "km" ? "selected" : null)">@VehicleLabels.Miles</option>
                            <option value="kilometres" selected="@(unitWord == "km" ? "selected" : null)">@VehicleLabels.Kilometres</option>
                        </select>
                    }
                </div>
            </div>
        </div>

        @* The history check is prose about the vehicle rather than one of its
           facts, so it reads as its own area under the grid. *@
        <div class="sub-panel vehicle-history @Model.CollapsedClass("case.vehicle.history")" data-collapse="case.vehicle.history" data-vehicle-history><h3>@VehicleLabels.History <span class="rt">@OperatorLabels.CaseWorkspace.ExperianSeamCondition</span> <partial name="Shared/_SubPanelToggle" model="@Model.SubPanel("case.vehicle.history")" /></h3>
            <div class="fc @Ro(canEditHistory)">
                @{ Lbl(canEditHistory, "edit-vehicle-history", VehicleLabels.History, Model.AssessmentSourceTag(AssessmentVocabulary.HistoryCheck)); }
                <div class="@ValueClass(Model.AssessmentEditorValue(AssessmentVocabulary.HistoryCheck)) multi">@Model.AssessmentValue(AssessmentVocabulary.HistoryCheck)</div>
                @if (canEditHistory)
                {
                    <textarea id="edit-vehicle-history" class="fi" name="@CaseWorkspaceLabels.Editors.FormName(AssessmentVocabulary.HistoryCheck)"
                              form="case-edit-form" rows="4"
                              maxlength="@AssessmentVocabulary.Definitions[AssessmentVocabulary.HistoryCheck].MaximumLength">@Model.AssessmentEditorValue(AssessmentVocabulary.HistoryCheck)</textarea>
                }
            </div>
        </div>
    </div>
</section>

@functions {
    // The cell's label: a real <label> for the control while editing, the
    // same words as a plain caption while reading, with the value's source
    // tag in the label line in both.
    private void Lbl(bool editable, string id, string text, OperatorLabels.SourceTagWord? tag = null)
    {
        if (editable)
        {
            <label for="@id">@text@(tag?.Render())</label>
        }
        else
        {
            <span class="lbl">@text@(tag?.Render())</span>
        }
    }
}
