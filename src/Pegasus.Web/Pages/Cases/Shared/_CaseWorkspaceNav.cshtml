@*
    The Case record's section nav (D29): one link per section in D30 order.
    Without script each link requests and reaches its section on the scrolling
    record. Script preserves that Scroll view and may enhance it to Tabs using
    the same section hosts; it never creates another Case form. The section
    list is `OperatorLabels.CaseWorkspace.Sections`.
*@
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Cases.DetailsModel
<div class="case-section-navigation">
    <nav class="section-nav case-section-nav" aria-label="@OperatorLabels.CaseWorkspace.SectionNav" data-section-nav>
        @foreach (var entry in OperatorLabels.CaseWorkspace.Sections)
        {
            <a class="section-link" asp-page="/Cases/Details" asp-route-id="@Model.Case!.Workflow.CaseId"
               asp-route-section="@entry.Key" asp-fragment="section-@entry.Key" data-section-link="@entry.Key"
               aria-current="@(Model.Section == entry.Key ? "true" : "false")">
                <svg class="icon" aria-hidden="true"><use href="#@entry.Icon" /></svg>
                <span>@entry.Label</span>
            </a>
        }
    </nav>
    <div class="layout-switch case-layout-switch" role="group" aria-label="Case layout" data-case-layout-switch hidden>
        <button type="button" data-case-layout="scroll" aria-pressed="true">Scroll</button>
        <button type="button" data-case-layout="tabs" aria-pressed="false">Tabs</button>
    </div>
</div>
