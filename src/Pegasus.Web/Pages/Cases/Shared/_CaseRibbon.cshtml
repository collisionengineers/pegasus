@*
    The Case ribbon (v26 frame rule 1): the 56px row of the Case's facts and
    chips, and the actions (Edit Case, or Editing with its status word and
    Done, and the one Actions menu). Its two halves are swap roots of
    case-workspace.js, redrawn after every commit. The section row below it
    belongs to the page.
*@
@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Lifecycle
@using Pegasus.Core.Reports
@using Pegasus.Core.Workflow
@using Pegasus.Web.Presentation
@using Frame = Pegasus.Web.Presentation.CaseWorkspaceLabels.Frame
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var summary = details.Summary;
    var state = workflow.State;
    var isClosed = CaseLifecycleRules.IsTerminal(state);
    var isHeld = state == CaseLifecycleState.Held;
    var isReview = state == CaseLifecycleState.Review;
    var isComplete = state == CaseLifecycleState.PostReportComplete;
    var isQuery = state == CaseLifecycleState.Query;
    var editing = Model.IsEditing;
    var editingCaseData = editing && !Model.IsPostReportReadOnly;
    // The Actions menu is offered in and out of an edit session (operator,
    // 29 September 2026): an item taken outside one runs under a lease
    // claimed for it. While a colleague holds the lease nothing that needs
    // one is offered; the ribbon names them and offers Take over.
    var mayAct = !Model.ColleagueIsEditing;
    var mayActOnCaseData = mayAct && !Model.IsPostReportReadOnly;
    var registration = string.IsNullOrWhiteSpace(summary.Registration)
        ? "No registration"
        : summary.Registration!;
    var canHandToEngineer = mayActOnCaseData && isReview
        && Model.EvaHandoff is { EngineerOptions.Count: > 0 };
    var canSendToEva = (Model.EvaHandoff?.ReportGenerationPolicy is PrincipalReportGenerationPolicy.EvaZip or PrincipalReportGenerationPolicy.EvaManualApi
        || Model.EvaHandoff?.CanRetryAutomaticFailure == true)
        && state is CaseLifecycleState.Review or CaseLifecycleState.ReportPreparation or CaseLifecycleState.PostReport;
    // The confirmation is a lease-carrying Core action; without detected
    // evidence there is nothing to confirm (D10: a send is never asserted here).
    // The Inspection view marks the Inspection report sent on its own work
    // while it awaits sending after Create audit (operator, 1 October 2026).
    var canConfirmReportSent = mayAct
        && details.AvailableReportSentEvidence.Count > 0
        && (Model.InspectionReportAwaitsSend || state == CaseLifecycleState.ReportPreparation);
    var canMarkCompleted = mayAct && state == CaseLifecycleState.PostReport;
    var canReturnToReview = mayActOnCaseData
        && state is CaseLifecycleState.ReportPreparation or CaseLifecycleState.PostReport;
    var canReturnToEngineer = mayAct && (isComplete || isQuery);
    var canArchive = mayAct && isClosed && workflow.Archive is null;
    var canUnlinkEvidence = mayActOnCaseData && workflow.ReportSentEvidence is not null
        && state is not CaseLifecycleState.Held && !isClosed;
    // Review point 12: the adverse dispositions Core will accept for this
    // state, decided in the page model from Core's own closure rules.
    var closureOutcomes = Model.AvailableClosureOutcomes;
    var offersAdverseClosure = mayAct && closureOutcomes.Count > 0;
    var offersHoldGroup = mayActOnCaseData && !isClosed;
    var offersCreateAudit = Model.OffersCreateAudit;
    // The menu shows whenever it has an item to offer.
    var offersActionsMenu = canUnlinkEvidence || canSendToEva || canHandToEngineer || canConfirmReportSent || canMarkCompleted
        || canReturnToReview || canReturnToEngineer || canArchive || offersHoldGroup
        || offersCreateAudit || offersAdverseClosure;
    var outcome = Model.AssessmentEditorValue(Pegasus.Core.Assessment.AssessmentVocabulary.Outcome)
        ?? Model.Assessment?.Field(Pegasus.Core.Assessment.AssessmentVocabulary.Outcome)?.Value;
    var salvageCategory = Model.Assessment?.Field(Pegasus.Core.Assessment.AssessmentVocabulary.SalvageCategory)?.Value;
    var legalStatus = Model.Assessment?.Field(Pegasus.Core.Assessment.AssessmentVocabulary.LegalStatus)?.Value;
    var engineerValue = Model.EngineerValue;
    var repairCost = Model.RepairCostIncVat;
}
<div class="ribbon" aria-label="Case identity">
    <div class="ribbon-facts" data-case-ribbon-facts>
        <div class="ribbon-item ribbon-ref">
            <div class="ribbon-label">Case workspace · @registration</div>
            <h1 class="ribbon-value">@workflow.Identity.Reference</h1>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">@OperatorLabels.CaseWorkspace.RibbonClaimant</div>
            <div class="ribbon-value"><span>@(string.IsNullOrWhiteSpace(summary.Claimant) ? OperatorLabels.CaseWorkspace.AbsentValue : summary.Claimant)</span></div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">@OperatorLabels.CaseWorkspace.RibbonPrincipal</div>
            <div class="ribbon-value"><span>@workflow.Identity.PrincipalCode</span></div>
        </div>
        <div class="ribbon-item">
            <div class="ribbon-label">@OperatorLabels.CaseWorkspace.RibbonEngineer</div>
            <div class="ribbon-value"><span>@(Model.EngineerDisplayName ?? OperatorLabels.CaseWorkspace.AbsentValue)</span></div>
        </div>
        <div class="ribbon-chips" aria-label="@OperatorLabels.CaseWorkspace.RibbonState" data-case-ribbon-chips>
            <partial name="Shared/_StatusChip" model="@Model.StateChipText" />
            @if (Model.CaseTypeChip is { } caseTypeChip)
            {
                <span class="status status--navy status--plain" data-case-type-chip>@caseTypeChip</span>
            }
            @* The Engineer's decisions read on the ribbon (v28 P25): the
               outcome, the roadworthiness, and the repair cost as a
               share of the value once both are known. *@
            @if (outcome is not null)
            {
                var outcomeText = outcome == "total_loss" && !string.IsNullOrWhiteSpace(salvageCategory)
                    ? $"Total loss · Cat {salvageCategory}"
                    : OperatorLabels.Humanise(outcome);
                <span class="status @(outcome == "total_loss" ? "status--red" : "status--blue")" data-outcome-chip>@outcomeText</span>
            }
            @if (legalStatus is not null)
            {
                <span class="status @(legalStatus == "unroadworthy" ? "status--red" : "status--green")" data-legal-chip>@OperatorLabels.Humanise(legalStatus)</span>
            }
            @if (repairCost is { } ribbonCost && engineerValue is { } ribbonValue && ribbonValue > 0)
            {
                var share = (int)Math.Round(ribbonCost / ribbonValue * 100);
                <span class="status @(share >= 80 ? "status--red" : share >= 66 ? "status--amber" : "status--green")" data-repairs-of-value-chip>@Frame.RepairsOfValue(share)</span>
            }
            @if (workflow.Archive is not null)
            {
                <span class="status status--red status--plain">@Frame.Archived</span>
            }
            @if (Model.ColleagueIsEditing && Model.EditAuthorityHolder is { } holder)
            {
                <span class="status status--navy status--plain" data-edit-authority>
                    <svg class="icon" aria-hidden="true"><use href="#icon-lock" /></svg>
                    @EditModeDisplay.HolderName(holder) is editing
                </span>
            }
        </div>
    </div>
    <div class="ribbon-actions" data-case-ribbon-actions>
        @if (workflow.OriginalCaseId is { } originalCaseId)
        {
            <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@originalCaseId">@Frame.OriginalCase</a>
        }
        @if (workflow.ReplacementCaseId is { } replacementCaseId)
        {
            <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@replacementCaseId">@Frame.ReplacementCase</a>
        }
        @if (editing)
        {
            @* The status word of the session: what the last commit did,
               or that editing has expired (save as you go, operator,
               29 September 2026). *@
            <span class="lease-line" data-lease-line data-lease-expired-text="@Frame.EditingExpired"
                  data-lease-saving-text="@Frame.Saving" data-lease-saved-text="@Frame.Saved" hidden></span>
            @* Done ends editing and frees the Case; every change is
               already recorded, so there is nothing to discard. *@
            <form method="post" asp-page-handler="ReleaseLease" id="case-finish-editing-form" data-case-done-form hidden>
                <input type="hidden" name="id" value="@summary.CaseId" />
                <input type="hidden" name="operationKey" value="@Model.ReleaseLeaseOperationKey" />
                <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                <input type="hidden" name="section" value="@Model.Section" data-case-section-field />
            </form>
            @* Script hides this and beats instead; without script it is
               how editing is kept. *@
            <form method="post" asp-page-handler="RenewLease" data-case-renew>
                <input type="hidden" name="id" value="@summary.CaseId" />
                <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                <input type="hidden" name="operationKey" value="@Model.RenewLeaseOperationKey" />
                <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                <button type="submit" class="btn btn--small">
                    <svg class="icon" aria-hidden="true"><use href="#icon-clock" /></svg>
                    <span>@Frame.RenewEditing</span>
                </button>
            </form>
            <form method="post" asp-page-handler="HeartbeatLease" data-case-heartbeat
                  data-heartbeat-seconds="@((int)CaseEditAuthority.HeartbeatInterval.TotalSeconds)" hidden>
                <input type="hidden" name="id" value="@summary.CaseId" />
                <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
            </form>
            @* Script beacons this as the operator leaves the Case by a
               link, so leaving ends edit mode (FRD-14). *@
            <form method="post" asp-page-handler="ReleaseLeaseBeacon" data-case-release-beacon
                  data-case-id="@summary.CaseId" hidden>
                <input type="hidden" name="id" value="@summary.CaseId" />
                <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
            </form>
            <span class="status status--navy status--plain case-edit-badge">@Frame.Editing</span>
            @if (editingCaseData && details.Data is not null && !Model.IsInspectionView)
            {
                @* The Case form's default submit. With script it is the
                   commit Ctrl S and Enter reach, and the script hides it;
                   without script it is the save. It stands first so
                   Enter in a cell never lands on a Repair Spec line button. *@
                <button type="submit" form="case-edit-form" class="btn btn--small" data-case-save-now>
                    <svg class="icon" aria-hidden="true"><use href="#icon-save" /></svg>
                    <span>@Frame.SaveNow</span>
                </button>
            }
            <button type="submit" form="case-finish-editing-form" class="btn" data-case-done>
                <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                <span>@Frame.Done</span>
            </button>
        }
        else if (!Model.IsInspectionView && (!Model.IsPostReportReadOnly || Model.ColleagueIsEditing)
            && (details.ActiveEditLease is null || details.ActiveEditLease.HolderKind == Pegasus.Core.Identity.ActorKind.Staff))
        {
            @* A colleague's staff lease can be taken over by an authorised
               editor; the operation rotates its token and records the prior
               holder. The viewer's own lease is resumed, never taken over.
               The Inspection view offers no Edit (v29 P3), and neither does
               a Completed or Query Case: its sections read, and Return to
               Engineer is an Actions-menu item that needs no session. A
               colleague's lease there is still offered Take over
               (operator, 29 September 2026), since the Actions menu is
               withheld while it holds the Case. *@
            <form method="post" asp-page-handler="ClaimLease" data-case-edit-form>
                <input type="hidden" name="id" value="@summary.CaseId" />
                <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                <input type="hidden" name="operationKey" value="@Model.ClaimLeaseOperationKey" />
                @if (Model.ColleagueIsEditing)
                {
                    <input type="hidden" name="takeOver" value="true" />
                }
                <input type="hidden" name="section" value="@Model.Section" data-case-section-field />
                <button type="submit" class="btn btn--dark" data-case-edit>
                    <svg class="icon" aria-hidden="true"><use href="#icon-pencil" /></svg>
                    <span>@(Model.ColleagueIsEditing ? Frame.TakeOver : Frame.EditCase)</span>
                </button>
            </form>
        }
        @if (offersActionsMenu)
        {
            <details class="menu" data-menu data-case-actions>
                <summary class="btn"><span>@Frame.Actions</span><svg class="icon" aria-hidden="true"><use href="#icon-chevron-down" /></svg></summary>
                <div class="menu-body">
                    @if (canHandToEngineer)
                    {
                        <button type="button" class="btn" data-dialog-open="case-handoff-dialog">
                            <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
                            <span>@CaseWorkspaceLabels.HandToEngineer</span>
                        </button>
                    }
                    @if (canSendToEva)
                    {
                        @* A real link to the fallback page the dialog's own form
                           posts to (/Cases/Eva/Send), so the handoff is reachable
                           with script disabled and enhanced into a dialog. *@
                        <a class="btn" asp-page="/Cases/Eva/Send" asp-route-caseId="@workflow.CaseId" data-dialog-open="eva-handoff-dialog">
                            <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                            <span>@OperatorLabels.CaseWorkspace.SendToEva</span>
                        </a>
                    }
                    @if (canConfirmReportSent)
                    {
                        <button type="button" class="btn" data-dialog-open="case-report-sent-dialog">
                            <svg class="icon" aria-hidden="true"><use href="#icon-send" /></svg>
                            <span>@Frame.MarkReportSent</span>
                        </button>
                    }
                    @if (canMarkCompleted)
                    {
                        <button type="button" class="btn" data-dialog-open="case-complete-dialog">
                            <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                            <span>@Frame.MarkCompleted</span>
                        </button>
                    }
                    @if (canReturnToReview)
                    {
                        <button type="button" class="btn" data-dialog-open="case-return-review-dialog">
                            <svg class="icon" aria-hidden="true"><use href="#icon-chevron-left" /></svg>
                            <span>@Frame.ReturnToReview</span>
                        </button>
                    }
                    @if (canReturnToEngineer)
                    {
                        <button type="button" class="btn" data-dialog-open="case-return-engineer-dialog">
                            <svg class="icon" aria-hidden="true"><use href="#icon-chevron-left" /></svg>
                            <span>@Frame.ReturnToEngineer</span>
                        </button>
                    }
                    @if (canArchive)
                    {
                        <button type="button" class="btn" data-dialog-open="case-archive-dialog">
                            <svg class="icon" aria-hidden="true"><use href="#icon-archive" /></svg>
                            <span>@Frame.ArchiveCase</span>
                        </button>
                    }
                    @if (canUnlinkEvidence)
                    {
                        <button type="button" class="btn" data-dialog-open="case-unlink-evidence-dialog">
                            <svg class="icon" aria-hidden="true"><use href="#icon-unlink" /></svg>
                            <span>@Frame.UnlinkReportEvidence</span>
                        </button>
                    }
                    @if (offersHoldGroup || offersCreateAudit)
                    {
                        @if (canHandToEngineer || canSendToEva || canConfirmReportSent || canMarkCompleted || canReturnToReview || canReturnToEngineer || canArchive)
                        {
                            <div class="menu-sep"></div>
                        }
                        @if (offersHoldGroup)
                        {
                            @if (isHeld)
                            {
                                <button type="button" class="btn" data-dialog-open="case-release-hold-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-play" /></svg>
                                    <span>@Frame.ReleaseHold</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn" data-dialog-open="case-hold-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-pause" /></svg>
                                    <span>@Frame.PlaceOnHold</span>
                                </button>
                            }
                            <button type="button" class="btn" data-dialog-open="case-correct-principal-dialog">
                                <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                                <span>@Frame.CorrectPrincipal</span>
                            </button>
                        }
                        @if (offersCreateAudit)
                        {
                            @if (Model.CreateAuditCondition is { } createAuditCondition)
                            {
                                @* Listed on every Inspection + Audit Case; greyed out with
                                   its blocker on hover (operator, 1 October 2026). The
                                   wrapper carries the title: a disabled button takes no
                                   pointer events. *@
                                <span class="menu-gated" title="@createAuditCondition" data-create-audit-condition="@createAuditCondition">
                                    <button type="button" class="btn" disabled aria-disabled="true" data-create-audit>
                                        <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                                        <span>@Frame.CreateAudit</span>
                                    </button>
                                </span>
                            }
                            else
                            {
                                <button type="button" class="btn" data-dialog-open="case-create-audit-dialog" data-create-audit>
                                    <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                                    <span>@Frame.CreateAudit</span>
                                </button>
                            }
                        }
                    }
                    @if (offersAdverseClosure)
                    {
                        @* Review point 12: an adverse disposition is not a step
                           in the workflow, so it stands apart below a divider in
                           red. It closes the Case; it never deletes one. *@
                        <div class="menu-sep"></div>
                        <button type="button" class="btn btn--danger" data-dialog-open="case-close-dialog">
                            <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                            <span>@OperatorLabels.CaseWorkspace.CloseCase</span>
                        </button>
                    }
                </div>
            </details>
        }
    </div>
</div>
