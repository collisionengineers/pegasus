@*
    The valuation calculator's ordered lines (v25 decision 8), rendered from
    Core's own calculation: guide retail, commercial VAT, previous total loss,
    each addition, the condition deduction, the proposal. The PreviewValuation
    handler returns this for every change the calculator posts, and script
    fills the Engineer's Value box from the proposal; null means there is
    nothing to show: no basis chosen yet ("None yet"), or the posted selection
    could not be calculated, in which case ViewData["ValuationRefusal"] holds
    Core's own reason (deductions beyond the value, no retail to start from)
    and it is shown as an alert, never as "None yet".
*@
@using System.Globalization
@using Pegasus.Core.Assessment
@using ValuationLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Valuation
@model Pegasus.Core.Assessment.ValuationCalculation?
@{
    string Money(decimal value) => ValuationCalculationPolicy.FormatMoney(value);
}
<div class="lines" data-valuation-lines>
    @if (Model is null && ViewData["ValuationRefusal"] is string refusal)
    {
        <div class="notice notice--danger" role="alert" data-valuation-error>@refusal</div>
    }
    else if (Model is null)
    {
        <div class="ln"><span class="muted">@ValuationLabels.NoneYet</span></div>
    }
    else
    {
        <div class="ln"><span>@ValuationLabels.GuideRetail</span><b>@Money(Model.GuideRetailValue)</b></div>
        @if (Model.CommercialVatApplied)
        {
            <div class="ln"><span>@ValuationLabels.CommercialVat 20 %</span><b>+ @Money(Model.CommercialVatAmount)</b></div>
        }
        @if (Model.PriorTotalLossPercentage is { } percentage)
        {
            <div class="ln"><span>@ValuationLabels.PreviousTotalLoss −@((percentage * 100m).ToString("0", CultureInfo.InvariantCulture)) %</span><b>− @Money(Model.PriorTotalLossAmount)</b></div>
        }
        @foreach (var addition in Model.Additions)
        {
            <div class="ln"><span>@addition.Label</span><b>+ @Money(addition.Amount)</b></div>
        }
        @if (Model.ConditionDeduction > 0m)
        {
            <div class="ln"><span>@ValuationLabels.ConditionDeduction</span><b>− @Money(Model.ConditionDeduction)</b></div>
        }
        <div class="ln tot"><span>@ValuationLabels.ProposedEngineersValue</span><b data-valuation-proposal="@Model.Proposal.ToString("0.00", CultureInfo.InvariantCulture)">@Money(Model.Proposal)</b></div>
    }
</div>
