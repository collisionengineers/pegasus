                                    <td><span class="status status--plain @StateTone(compared.State, compared.IsCurrent)">@StateWord(compared)</span></td>
                                    <td class="num mono">@Money(comparedTotals.Net)</td>
                                    <td class="num mono">@Money(comparedTotals.Vat)</td>
