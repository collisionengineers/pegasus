@*
    Repair Spec (v26 § Estimate; renamed by v28 P31; the reference's bars
    since v38, operator, 12 October 2026). One section: the head carries
    Import (visible in read mode, where it opens the edit session first; an
    import lands on the spec in view, P3), the one Glass's / Resume slot, Send
    to AI, one More menu (New repair spec, Print Repair Spec, Versions,
    Compare — offered with two specs or a frozen version, P2) and Expand; the
    body carries the outcome notice, the tabs (the selected tab renames the
    spec by double-click, P32), the Glass's session line with its guarded
    Close, Use repair spec / Duplicate / Discard, the Supplementary panel an
    import opens above the grid (P3), the header cells, the grid with its
    Material column (P48) and trailing blank line — a cell the line type does
    not price reads as a dash (P1) — Add line and Delete all lines (P16), the
    labour rate bar with its rate-card segments (P5), the Target % of value
    bar as the reference scales (P6), the contract bar whose agreed sum
    previews the scaling (P4), the discount and VAT bars, the three
    work-lists and the rollup with its off-pattern line (P37). Reading and
    editing are one layout (operator, 23 September 2026): a spec that cannot
    be changed shows every field as a greyed value in its control's place
    (EstimateBody). The editor has no Save of its own (one Save, 23 September
    2026): its controls belong to the record's form, #case-edit-form, and the
    ribbon Save records the spec as it stands; Apply and Remove scaling save
    the Case first. Every other action is a plain posted form;
    case-workspace.js adds the phantom row, the full-screen toggle, the VAT
    reset, the range interaction, the tab rename, the rate bar and the Undo
    toast.
*@
@using System.Globalization
@using Pegasus.Core.Assessment
@using Pegasus.Web.Presentation
@using EngineerLabels = Pegasus.Web.Presentation.OperatorLabels.CaseWorkspace.EngineerSections
@using EstimateLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Estimate
@using TotalsLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.EstimateTotals
@using VatLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.EstimateVat
@using DiscountLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.EstimateDiscount
@using ImportLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.EstimateImport
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var caseId = Model.Case!.Workflow.CaseId;
    var caseVersion = Model.Case.Workflow.Version;
    // The section edits only inside the page-wide session (v26 J); an
    // estimate edits only while it is a Draft this staff member may change.
    var editing = Model.SectionIsEditable("estimate");
    var estimate = Model.SelectedEstimate;
    var editable = editing && Model.SelectedEstimateIsEditable;
    var canImport = editing && Model.ImportCondition is null;
    var offersImportFromRead = !editing && Model.SectionOffersEdit("estimate") && Model.ImportCondition is null;
    var canOfferImport = canImport || offersImportFromRead;
    var details = Model.EditorDetails;
    var totals = Model.EditorTotals;
    var printed = totals.Printed;
    var vatPolicy = details?.VatPolicy ?? totals.VatPolicy;
    var discounts = details?.AppliedDiscounts ?? EstimateDiscounts.None;
    var engineerValue = Model.EngineerValue;
    var targetBase = engineerValue is null
        ? string.Empty
        : engineerValue.Value.ToString("0.##", CultureInfo.InvariantCulture);
    var culture = CultureInfo.GetCultureInfo("en-GB");
    var headTools = new Pegasus.Web.Pages.Cases.CaseSectionHeadView(Model, "estimate");
    var rateCard = details?.Rate is { RateCardId: { } rateCardId, RateCardVersion: { } rateCardVersion }
        ? Model.LabourRateCards.FirstOrDefault(card => card.Id == rateCardId && card.Version == rateCardVersion)
        : null;
    var enabledCards = Model.LabourRateCards.Where(card => card.Enabled).ToArray();

    string Money(decimal value) => "£" + value.ToString("N2", culture);
    string MoneyOrAbsent(decimal? value) => value is { } present ? Money(present) : OperatorLabels.CaseWorkspace.AbsentValue;

    // What the line's Source column says: a line an import brought in (named
    // by its route, v28 P18), one a staff member changed since, or one keyed by
    // hand.
    string LineSource(CaseEstimateLineRecord line) =>
        line.AmendedBy is not null ? EstimateLabels.SourceAmended
        : line.Origin is not null || line.SourceDocumentIdentity is not null ? EstimateLabels.ImportedFrom(estimate?.Source.Route ?? RepairSpecificationSourceRoute.Manual)
        : EstimateLabels.SourceManual;

    // The off-pattern cells (v28 P37): Core's anomalies by line position and
    // the editor field each names.
    var offPattern = totals.OffPattern
        .Select(anomaly => (anomaly.Position, Field: anomaly.Field switch
        {
            "unit amount" => "linePartPounds",
            "paint hours" => "linePaintHours",
            "hours" => "lineLabourHours",
            _ => anomaly.Field
        }))
        .ToHashSet();
    string OffPatternClass(int position, string field) => offPattern.Contains((position, field)) ? "viol" : string.Empty;
    string? OffPatternLabel(int position, string field) => offPattern.Contains((position, field)) ? EstimateLabels.OffPattern : null;
    var upliftSuggestions = Model.RegionalUpliftSuggestions;
    var scaled = Model.SelectedEstimateIsScaled;
    var contractPath = AssessmentVocabulary.SettlementContractSum;
    var outcomeIsContract = Model.AssessmentEditorValue(AssessmentVocabulary.Outcome) == "contract_repair";
    var contractSumText = Model.AssessmentEditorValue(contractPath);
    var contractSum = decimal.TryParse(contractSumText, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsedContractSum) ? parsedContractSum : (decimal?)null;
    var contractPercent = outcomeIsContract && contractSum is > 0m && engineerValue is > 0m
        ? contractSum.Value / engineerValue.Value * 100m
        : (decimal?)null;
    // The slider runs from the floor-scaled minimum (v38 P6) to the spec's
    // own share of the Engineer's Value and goes no higher; scaling only
    // lowers prices (operator, 8 October 2026). An agreed sum below that
    // share is the starting target (P35).
    var specPercent = engineerValue is > 0m
        ? Math.Max(1m, RepairSpecificationScaling.PercentOfValue(engineerValue.Value, printed.Gross))
        : 100m;
    var floorPercent = Math.Min(Model.ScaleFloorPercent, specPercent);
    var suggestedPercent = contractPercent is { } agreedPercent && agreedPercent >= 1m && agreedPercent <= specPercent
        ? Math.Round(agreedPercent, 1, MidpointRounding.AwayFromZero)
        : specPercent;
    var specPercentText = specPercent.ToString("0.#", CultureInfo.InvariantCulture);
    var floorPercentText = floorPercent.ToString("0.#", CultureInfo.InvariantCulture);
    var scaleIdle = scaled && Model.ScaledFromGross is { } scaledFrom
        ? $"{Money(printed.Gross)} — {EstimateLabels.ScaledFromEstimate} {Money(scaledFrom)}"
        : $"{Money(printed.Gross)} — {EstimateLabels.AsEstimated}";
    string VersionOrigin(RepairSpecificationVersion version) =>
        $"Populated {OperatorLabels.OfficeTime(version.CreatedAtUtc)} by {Model.SpecAuthorName(version.CreatedBy)}, {RepairSpecificationRouteWords.Of(version.Source.Route)} · {EstimateLabels.LinesCount(version.Lines.Count)} · {EngineerLabels.LabourRate.ToLowerInvariant()} {Money(version.Details.HourlyRate)}/h";

    string StateTone(RepairSpecificationState state, bool isCurrent) =>
        isCurrent ? "status--green"
        : state == RepairSpecificationState.Draft ? "status--amber"
        : "status--neutral";

    string StateWord(RepairSpecificationVersion version) =>
        version.IsCurrent ? EngineerLabels.Current : EngineerLabels.EstimateState(version.State);

    var meta = estimate is null
        ? null
        : $"{RepairSpecificationRouteWords.Of(estimate.Source.Route)} · {OperatorLabels.OfficeTime(estimate.CreatedAtUtc)} · {estimate.Lines.Count} {(estimate.Lines.Count == 1 ? "line" : "lines")}";

    var editLineAction = Url.Page("/Cases/Details", "EditLine", new { id = caseId, section = "estimate", view = Model.ViewRoute });
    var lineOrigins = estimate?.Lines.ToDictionary(line => line.Id, line => line) ?? new Dictionary<Guid, CaseEstimateLineRecord>();
    var operations = new[]
    {
        ("Replace", EngineerLabels.Replace, EstimateOperation.Replace),
        ("Repair", EngineerLabels.Repair, EstimateOperation.Repair),
        ("RemoveAndRefit", EngineerLabels.RemoveAndRefit, EstimateOperation.RemoveAndRefit),
        ("Paint", EngineerLabels.PaintOperation, EstimateOperation.Paint),
        ("Blend", EstimateLabels.Blend, EstimateOperation.Blend),
        ("Specialist", TotalsLabels.Specialist, EstimateOperation.Specialist),
        ("Other", EngineerLabels.Other, EstimateOperation.Other)
    };
    // A line's Type reads in the words its control offers, in both modes.
    string OperationWord(string operation) =>
        operations.FirstOrDefault(item => item.Item1 == operation).Item2 ?? operation;
    // The columns a line's type prices (v38 P1): the editor draws a box for
    // those, a dash for the rest, and keeps a value sitting in one.
    EstimateLineColumns ColumnsOf(string operation) =>
        EstimateOperations.TryParse(operation, out var parsed) ? EstimateOperations.PricedColumns(parsed) : EstimateLineColumns.Hours;
    bool Prices(EstimateLineColumns columns, EstimateLineColumns column) => (columns & column) == column;
    var vatOverridden = vatPolicy.CategoriesOverridden;
    var readLines = estimate?.Lines.OrderBy(line => line.Position).ToArray() ?? [];
    var vatChargedOn = VatLabels.Categories.Where(vatPolicy.Charges).Select(VatLabels.CategoryLabel).ToArray();
    var estimateDocumentHref = estimate is null
        ? null
        : Url.Page("/Cases/Details", "EstimateDocument", new
        {
            id = caseId,
            estimateId = estimate.SpecificationId,
            view = Model.ViewRoute
        });
    string CompareHref(string from, string to) => Url.Page("/Cases/Details", null, new
    {
        id = caseId,
        section = "estimate",
        estimate = estimate?.SpecificationId,
        dialog = "compare-estimates",
        from,
        to,
        view = Model.ViewRoute
    })!;

    // The work-lists sort recorded lines by operation; a type the mapping
    // does not know lands with the additional operations rather than failing.
    string OperationOf(string lineType)
    {
        try
        {
            return EstimateOperations.FromLineType(lineType).ToString();
        }
        catch (InvalidOperationException)
        {
            return "Other";
        }
    }
}

@{
    // One layout for reading and editing (operator, 23 September 2026): the
    // same header cells, grid columns, bars and Supplementary panel in both.
    // Where the spec cannot be changed — reading, or a spec that is not this
    // staff member's Draft — each field reads as a greyed value where its
    // control sits; the tools (add and delete lines, the scale slider, Reset
    // to repairer status, Dismiss) are drawn only while it edits.
    async Task EstimateBody()
    {
        var d = details!;
        await Supplementary();
        <div class="est-head">
            <div class="fg g4">
                @if (editable)
                {
                    <div class="fc" data-estimate-name-cell><label for="estimate-name">@EngineerLabels.EstimateName</label><input id="estimate-name" class="fi" name="estimateName" form="case-edit-form" maxlength="100" required value="@(Model.PostedEstimateValue("estimateName") ?? d.Name)" /></div>
                    <div class="fc"><label for="estimate-other">@EngineerLabels.OtherCostsPounds</label><input id="estimate-other" class="fi mono" name="estimateOtherCosts" form="case-edit-form" type="number" min="0" step="0.01" inputmode="decimal" value="@(Model.PostedEstimateValue("estimateOtherCosts") ?? d.OtherCosts?.ToString(CultureInfo.InvariantCulture))" /></div>
                    <div class="fc"><label for="estimate-vat">@EngineerLabels.VatPercent</label><input id="estimate-vat" class="fi mono" name="estimateVatPercent" form="case-edit-form" type="number" min="0" max="100" step="0.01" inputmode="decimal" value="@(Model.PostedEstimateValue("estimateVatPercent") ?? d.VatPercent.ToString(CultureInfo.InvariantCulture))" /></div>
                    <div class="fc">
                        <label for="estimate-vat-status">@VatLabels.RepairerStatus</label>
                        <select id="estimate-vat-status" class="fi" name="estimateVatStatus" form="case-edit-form" data-vat-status>
                            @foreach (var status in Enum.GetValues<RepairerVatStatus>())
                            {
                                <option value="@status" selected="@((Model.PostedEstimateValue("estimateVatStatus") is { } postedStatus ? postedStatus == status.ToString() : vatPolicy.RepairerStatus == status) ? "selected" : null)">@VatLabels.StatusLabel(status)</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="fc ro" data-estimate-name-cell><span class="lbl">@EngineerLabels.EstimateName</span><div class="fv">@d.Name</div></div>
                    <div class="fc ro"><span class="lbl">@EngineerLabels.OtherCostsPounds</span><div class="@(d.OtherCosts is null ? "fv mono empty" : "fv mono")">@MoneyOrAbsent(d.OtherCosts)</div></div>
                    <div class="fc ro"><span class="lbl">@EngineerLabels.VatPercent</span><div class="fv mono">@d.VatPercent.ToString("0.##", CultureInfo.InvariantCulture) %</div></div>
                    <div class="fc ro"><span class="lbl">@VatLabels.RepairerStatus</span><div class="fv">@VatLabels.StatusLabel(vatPolicy.RepairerStatus)</div></div>
                }
            </div>
        </div>
        if (editable)
        {
            @* The blank line script keeps at the foot of the grid (v26):
               cloned from this template, posted with the same names,
               dropped by the save when it stays blank. A blank line starts
               as Replace, so it prices a part (v38 P1). *@
            <template data-estimate-line-template>
                <tr class="phantom" data-estimate-phantom>
                    <td>
                        <input type="hidden" name="lineId" value="" form="case-edit-form" />
                        <select name="lineOperation" form="case-edit-form" aria-label="@EngineerLabels.Operation" data-line-operation>@foreach (var (value, label, operation) in operations) {<option value="@value" data-cols="@((int)EstimateOperations.PricedColumns(operation))">@label</option>}</select>
                    </td>
                    <td><input name="lineDescription" form="case-edit-form" placeholder="@EstimateLabels.AddALine" aria-label="@EngineerLabels.Description" /></td>
                    <td data-col="@((int)EstimateLineColumns.PartNumber)"><input class="mono" name="linePartNumber" form="case-edit-form" aria-label="@EngineerLabels.PartNumber" /></td>
                    <td class="num" data-col="@((int)EstimateLineColumns.Quantity)"><input class="num" name="lineQuantity" form="case-edit-form" type="number" min="1" step="1" inputmode="numeric" aria-label="@EngineerLabels.Quantity" /></td>
                    <td class="num" data-col="@((int)EstimateLineColumns.UnitAmount)"><input class="num" name="linePartPounds" form="case-edit-form" type="number" min="0" step="0.01" inputmode="decimal" aria-label="@EngineerLabels.PartAmount" /></td>
                    <td class="num" data-col="@((int)EstimateLineColumns.Hours)"><input class="num" name="lineLabourHours" form="case-edit-form" type="number" min="0" step="0.1" inputmode="decimal" aria-label="@EngineerLabels.LabourHours" /></td>
                    <td class="num na" data-col="@((int)EstimateLineColumns.PaintHours)"><input class="num" name="linePaintHours" form="case-edit-form" type="number" min="0" step="0.1" inputmode="decimal" aria-label="@EngineerLabels.PaintHours" /></td>
                    <td class="num" data-col="@((int)EstimateLineColumns.Materials)"><input class="num" name="lineMaterials" form="case-edit-form" type="number" min="0" step="0.01" inputmode="decimal" aria-label="@EngineerLabels.MaterialPounds" /></td>
                    <td><span class="src-tag">@EstimateLabels.SourceManual</span></td>
                    <td><button type="submit" class="del" name="removeLine" value="" form="case-edit-form" formaction="@editLineAction" aria-label="@EstimateLabels.RemoveThisLine">×</button></td>
                </tr>
            </template>
        }
        <div class="grid" data-estimate-grid>
            <table>
                <thead>
                    <tr>
                        <th scope="col" class="col-type">@EngineerLabels.Type</th>
                        <th scope="col">@EngineerLabels.Description</th>
                        <th scope="col" class="col-part">@EstimateLabels.PartNumberShort</th>
                        <th scope="col" class="num col-qty">@EngineerLabels.QuantityShort</th>
                        <th scope="col" class="num col-money">@EstimateLabels.UnitPounds</th>
                        <th scope="col" class="num col-hours">@EstimateLabels.Hours</th>
                        <th scope="col" class="num col-hours">@EngineerLabels.PaintHoursShort</th>
                        <th scope="col" class="num col-money">@EngineerLabels.MaterialPounds</th>
                        <th scope="col" class="col-source">@EngineerLabels.Source</th>
                        <th scope="col" class="col-del"><span class="sr-only">@EngineerLabels.Action</span></th>
                    </tr>
                </thead>
                <tbody data-estimate-grid-body>
                    @if (editable)
                    {
                        for (var index = 0; index < Model.EditorLines.Count; index++)
                        {
                            var row = Model.EditorLines[index];
                            var lineNumber = index + 1;
                            var recordedLine = row.ExistingLineId is { } lineId && lineOrigins.TryGetValue(lineId, out var recorded) ? recorded : null;
                            var origin = recordedLine is not null ? LineSource(recordedLine) : EstimateLabels.SourceManual;
                            // A Glass's included operation reads as included (v36 item AC):
                            // indented under its row, its note across the figure columns.
                            var included = recordedLine is not null && IncludedOperations.IsIncluded(recordedLine.Type, recordedLine.WorkUnits, recordedLine.Price, recordedLine.Justification);
                            var columns = ColumnsOf(row.Operation);
                            // A cell its type does not price is a dash until a value sits in it (v38 P1).
                            string Na(EstimateLineColumns column, string? value) =>
                                !Prices(columns, column) && string.IsNullOrWhiteSpace(value) ? " na" : string.Empty;
                            <tr data-estimate-line data-estimate-included="@(included ? "true" : null)">
                                <td>
                                    <input type="hidden" name="lineId" value="@row.ExistingLineId" form="case-edit-form" />
                                    <label class="sr-only" for="line-operation-@index">@EngineerLabels.LineField(EngineerLabels.Operation, lineNumber)</label>
                                    <select id="line-operation-@index" name="lineOperation" form="case-edit-form" data-line-operation>
                                        @foreach (var (value, label, operation) in operations)
                                        {
                                            <option value="@value" data-cols="@((int)EstimateOperations.PricedColumns(operation))" selected="@(row.Operation == value ? "selected" : null)">@label</option>
                                        }
                                    </select>
                                </td>
                                <td class="@(included ? "incl-indent" : null)"><label class="sr-only" for="line-description-@index">@EngineerLabels.LineField(EngineerLabels.Description, lineNumber)</label><input id="line-description-@index" name="lineDescription" form="case-edit-form" value="@row.Description" /></td>
                                @if (included)
                                {
                                    @* The posted arrays stay aligned: the figures post blank from hidden fields. *@
                                    <td><input type="hidden" name="linePartNumber" value="" form="case-edit-form" /></td>
                                    <td colspan="5" class="incl-note">@IncludedOperations.Sentence(recordedLine!.Justification!)<input type="hidden" name="lineQuantity" value="" form="case-edit-form" /><input type="hidden" name="linePartPounds" value="" form="case-edit-form" /><input type="hidden" name="lineLabourHours" value="" form="case-edit-form" /><input type="hidden" name="linePaintHours" value="" form="case-edit-form" /><input type="hidden" name="lineMaterials" value="" form="case-edit-form" /></td>
                                }
                                else
                                {
                                <td class="@Na(EstimateLineColumns.PartNumber, row.PartNumber)" data-col="@((int)EstimateLineColumns.PartNumber)"><label class="sr-only" for="line-part-@index">@EngineerLabels.LineField(EngineerLabels.PartNumber, lineNumber)</label><input id="line-part-@index" class="mono" name="linePartNumber" form="case-edit-form" value="@row.PartNumber" /></td>
                                <td class="num@(Na(EstimateLineColumns.Quantity, row.Quantity))" data-col="@((int)EstimateLineColumns.Quantity)"><label class="sr-only" for="line-quantity-@index">@EngineerLabels.LineField(EngineerLabels.Quantity, lineNumber)</label><input id="line-quantity-@index" class="num" name="lineQuantity" form="case-edit-form" type="number" min="1" step="1" inputmode="numeric" value="@row.Quantity" /></td>
                                <td class="num@(Na(EstimateLineColumns.UnitAmount, row.PartPounds))" data-col="@((int)EstimateLineColumns.UnitAmount)"><label class="sr-only" for="line-pounds-@index">@EngineerLabels.LineField(EngineerLabels.PartAmount, lineNumber)</label><input id="line-pounds-@index" class="num @OffPatternClass(lineNumber, "linePartPounds")" name="linePartPounds" form="case-edit-form" type="number" min="0" step="0.01" inputmode="decimal" value="@row.PartPounds" title="@OffPatternLabel(lineNumber, "linePartPounds")" /></td>
                                <td class="num@(Na(EstimateLineColumns.Hours, row.LabourHours))" data-col="@((int)EstimateLineColumns.Hours)"><label class="sr-only" for="line-labour-@index">@EngineerLabels.LineField(EngineerLabels.LabourHours, lineNumber)</label><input id="line-labour-@index" class="num @OffPatternClass(lineNumber, "lineLabourHours")" name="lineLabourHours" form="case-edit-form" type="number" min="0" step="0.1" inputmode="decimal" value="@row.LabourHours" title="@OffPatternLabel(lineNumber, "lineLabourHours")" /></td>
                                <td class="num@(Na(EstimateLineColumns.PaintHours, row.PaintHours))" data-col="@((int)EstimateLineColumns.PaintHours)"><label class="sr-only" for="line-paint-@index">@EngineerLabels.LineField(EngineerLabels.PaintHours, lineNumber)</label><input id="line-paint-@index" class="num @OffPatternClass(lineNumber, "linePaintHours")" name="linePaintHours" form="case-edit-form" type="number" min="0" step="0.1" inputmode="decimal" value="@row.PaintHours" title="@OffPatternLabel(lineNumber, "linePaintHours")" /></td>
                                <td class="num@(Na(EstimateLineColumns.Materials, row.Materials))" data-col="@((int)EstimateLineColumns.Materials)"><label class="sr-only" for="line-materials-@index">@EngineerLabels.LineField(EngineerLabels.MaterialPounds, lineNumber)</label><input id="line-materials-@index" class="num" name="lineMaterials" form="case-edit-form" type="number" min="0" step="0.01" inputmode="decimal" value="@row.Materials" /></td>
                                }
                                <td><span class="src-tag @(origin == EstimateLabels.SourceAmended ? "src-tag--ai" : null)">@origin</span></td>
                                <td><button type="submit" class="del" name="removeLine" value="@index" form="case-edit-form" formaction="@editLineAction" aria-label="@EngineerLabels.RemoveLine(lineNumber)">×</button></td>
                            </tr>
                        }
                    }
                    else if (readLines.Length == 0)
                    {
                        <tr><td colspan="10" class="muted">@EngineerLabels.NoneRecorded</td></tr>
                    }
                    else
                    {
                        for (var index = 0; index < readLines.Length; index++)
                        {
                            var line = readLines[index];
                            var lineNumber = index + 1;
                            var source = LineSource(line);
                            var included = IncludedOperations.IsIncluded(line.Type, line.WorkUnits, line.Price, line.Justification);
                            var columns = EstimateOperations.PricedColumnsOf(line.Type);
                            <tr data-estimate-line data-estimate-included="@(included ? "true" : null)">
                                <td><span class="gv">@OperationWord(OperationOf(line.Type))</span></td>
                                <td class="@(included ? "incl-indent" : null)"><span class="gv">@(line.Description ?? string.Empty)</span></td>
                                @if (included)
                                {
                                    <td></td>
                                    <td colspan="5" class="incl-note">@IncludedOperations.Sentence(line.Justification!)</td>
                                }
                                else
                                {
                                @if (!Prices(columns, EstimateLineColumns.PartNumber) && string.IsNullOrWhiteSpace(line.PartNumber)) { <td class="na">—</td> } else { <td><span class="gv mono">@(line.PartNumber ?? "—")</span></td> }
                                @if (!Prices(columns, EstimateLineColumns.Quantity) && line.Quantity is null) { <td class="num na">—</td> } else { <td class="num"><span class="gv">@(line.Quantity?.ToString(CultureInfo.InvariantCulture) ?? "—")</span></td> }
                                @if (!Prices(columns, EstimateLineColumns.UnitAmount) && line.Price is null && !line.Unpriced) { <td class="num na">—</td> } else { <td class="num"><span class="gv @OffPatternClass(lineNumber, "linePartPounds")" title="@OffPatternLabel(lineNumber, "linePartPounds")">@(line.Price is { } price ? Money(price) : line.Unpriced ? EngineerLabels.ToBeConfirmed : "—")</span></td> }
                                @if (!Prices(columns, EstimateLineColumns.Hours) && line.WorkUnits is null) { <td class="num na">—</td> } else { <td class="num"><span class="gv @OffPatternClass(lineNumber, "lineLabourHours")" title="@OffPatternLabel(lineNumber, "lineLabourHours")">@(line.WorkUnits is { } workUnits ? workUnits.ToString("0.0", CultureInfo.InvariantCulture) : "—")</span></td> }
                                @if (!Prices(columns, EstimateLineColumns.PaintHours) && line.PaintWorkUnits is null) { <td class="num na">—</td> } else { <td class="num"><span class="gv @OffPatternClass(lineNumber, "linePaintHours")" title="@OffPatternLabel(lineNumber, "linePaintHours")">@(line.PaintWorkUnits is { } paintUnits ? paintUnits.ToString("0.0", CultureInfo.InvariantCulture) : "—")</span></td> }
                                @if (!Prices(columns, EstimateLineColumns.Materials) && line.Materials is null) { <td class="num na">—</td> } else { <td class="num"><span class="gv">@(line.Materials is { } lineMaterials ? Money(lineMaterials) : "—")</span></td> }
                                }
                                <td><span class="src-tag @(source == EstimateLabels.SourceAmended ? "src-tag--ai" : null)">@source</span></td>
                                <td></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        if (editable)
        {
            <div class="cluster est-add-line">
                <button type="submit" class="btn btn--small btn--danger" name="clearLines" value="true" form="case-edit-form" formaction="@editLineAction" data-estimate-delete-all data-undo-label="@EstimateLabels.Undo">
                    <svg class="icon" aria-hidden="true"><use href="#icon-trash-2" /></svg>
                    <span>@EngineerLabels.DeleteAllLines</span>
                </button>
                <button type="submit" class="btn btn--small" name="addLine" value="true" form="case-edit-form" formaction="@editLineAction" data-estimate-add-line>
                    <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                    <span>@EngineerLabels.AddLine</span>
                </button>
            </div>
        }
        RateBar(d);
        if (estimate is not null && !Model.EditingNewEstimate)
        {
            if (editable)
            {
                @* Target % of value as the reference scales (v38 P6; v28 P34):
                   the slider runs from the floor-scaled minimum to the spec's
                   share of the Engineer's Value; moving it previews Core's
                   result in the cells, the rollup and the readout (issue 897)
                   and offers Apply and Remove scaling; Apply saves the Case
                   first and scales the saved spec, and Core writes the
                   authoritative result; Remove scaling drops a preview, or
                   returns an applied scaling to the version frozen before.
                   The floors stand under the slider. A tool, so it is drawn
                   only while the spec edits. *@
                <div class="bar est-scale" data-estimate-scale
                     data-scale-preview-url="@(engineerValue is null ? null : Url.Page("/Cases/Details", "PreviewEstimateScale", new { id = caseId }))"
                     data-scale-engineer-value="@targetBase">
                    <span class="bl">@EstimateLabels.TargetPercentOfValue</span>
                    @if (scaled)
                    {
                        <span class="status status--amber status--plain" data-estimate-scaled>@EstimateLabels.Scaled</span>
                    }
                    @if (engineerValue is null)
                    {
                        <span class="muted">@CaseWorkspaceLabels.Settlement.SetInValuation</span>
                    }
                    else
                    {
                        <input type="range" min="@floorPercentText" max="@specPercentText" step="0.1" value="@suggestedPercent.ToString("0.#", CultureInfo.InvariantCulture)" aria-label="@EstimateLabels.TargetPercentOfValue" data-scale-range />
                        <button type="submit" data-busy-label="@OperatorLabels.Busy.Removing" class="btn btn--small" form="remove-scaling-form" data-scale-remove hidden="@(scaled ? null : "hidden")">
                            <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                            <span>@EstimateLabels.RemoveScaling</span>
                        </button>
                        <span class="dsc"><input type="number" name="targetPercent" form="case-estimate-scale-form" min="@floorPercentText" max="@specPercentText" step="0.1" value="@suggestedPercent.ToString("0.#", CultureInfo.InvariantCulture)" inputmode="decimal" aria-label="@EstimateLabels.TargetPercentOfValue" data-scale-percent /><label>%</label></span>
                        <span class="mono" data-scale-read data-scale-idle="@scaleIdle" aria-live="polite">@scaleIdle</span>
                        <span class="status status--navy status--plain" data-scale-preview hidden>@EstimateLabels.ScalePreview</span>
                    }
                    <div class="est-scale-row">
                        <span class="est-floors">@EstimateLabels.Floors
                            <span class="dsc"><label for="estimate-floor-rate">@EstimateLabels.FloorLabour</label><input id="estimate-floor-rate" name="floorRate" form="case-estimate-scale-form" type="number" min="0" step="1" inputmode="decimal" value="@ScalingFloors.Default.LabourRatePerHour.ToString("0.##", CultureInfo.InvariantCulture)" data-scale-floor-rate /></span>
                            <span class="dsc"><label for="estimate-floor-price">@EstimateLabels.FloorPrices</label><input id="estimate-floor-price" name="floorPrice" form="case-estimate-scale-form" type="number" min="0" max="100" step="5" inputmode="decimal" value="@ScalingFloors.Default.PricePercent.ToString("0.##", CultureInfo.InvariantCulture)" data-scale-floor-price /></span>
                        </span>
                        @if (contractPercent is { } shownPercent && shownPercent >= 1m && shownPercent <= specPercent)
                        {
                            <span class="muted">Agreed sum suggests @suggestedPercent.ToString("0.#", CultureInfo.InvariantCulture)%.</span>
                        }
                        else if (contractPercent > specPercent)
                        {
                            <span class="muted">Scaling cannot raise the repair spec to the agreed sum.</span>
                        }
                        @if (engineerValue is not null)
                        {
                            <button type="submit" data-busy-label="@OperatorLabels.Busy.Applying" class="btn btn--small btn--primary" form="case-estimate-scale-form" data-scale-apply hidden><span>@EstimateLabels.Apply</span></button>
                        }
                    </div>
                </div>
            }
            else if (scaled)
            {
                @* Reading a scaled spec (operator, 23 September 2026): the
                   bar stands in its place with the Scaled state. The target
                   and floors the editor offers are suggestions, not recorded
                   values, so they are not read here. *@
                <div class="bar est-scale" data-estimate-scale-read>
                    <span class="bl">@EstimateLabels.TargetPercentOfValue</span>
                    <span class="status status--amber status--plain" data-estimate-scaled>@EstimateLabels.Scaled</span>
                    <span class="mono" data-scale-read>@scaleIdle</span>
                </div>
            }
            @* Contract repair (v28 P35; v38 P4): the agreed sum is Case data
               saved with the page-wide Save, held by Decisions' cell; ticking
               sets the outcome in Decisions and seeds the sum from the
               specification. The bar's own box mirrors that cell, and typing
               in it previews the scaling to the sum as the slider does; once
               the spec drifts from the sum again, the chip rescales it on
               press. Reading, the same bar holds the tick and the sum as they stand. *@
            <div class="bar est-contract" data-estimate-contract data-estimate-outcome-control="f-assessment-outcome" data-estimate-contract-sum-control="f-settlement-contract-sum">
                <span class="bl">@EstimateLabels.ContractRepair</span>
                @if (editable)
                {
                    <label class="choice"><input type="checkbox" checked="@(outcomeIsContract ? "checked" : null)" data-contract-agreed /><span>@EstimateLabels.ContractRepairAgreed</span></label>
                    <span class="dsc"><label for="estimate-contract-sum">@EstimateLabels.AgreedTotalSum</label><input id="estimate-contract-sum" class="fi mono" type="number" min="0" step="0.01" inputmode="decimal" value="@(contractSum?.ToString("0.00", CultureInfo.InvariantCulture))" disabled="@(outcomeIsContract ? null : "disabled")" aria-label="@EstimateLabels.AgreedTotalSum" data-contract-sum /></span>
                }
                else
                {
                    StaticChoice(outcomeIsContract, EstimateLabels.ContractRepairAgreed);
                    <span class="dsc"><span class="lbl">@EstimateLabels.AgreedTotalSum</span><b class="mono" data-contract-sum-read>@(contractSum is { } shown ? Money(shown) : OperatorLabels.CaseWorkspace.AbsentValue)</b></span>
                }
                @if (outcomeIsContract && contractSum is { } agreed && Math.Abs(printed.Gross - agreed) > 0.5m)
                {
                    var mismatch = printed.Gross > agreed ? EstimateLabels.SpecAboveAgreed(Money(printed.Gross)) : EstimateLabels.SpecBelowAgreed(Money(printed.Gross));
                    if (editable && engineerValue is not null)
                    {
                        <button type="button" class="status status--amber status--plain chip-button" data-contract-mismatch data-contract-rescale>@mismatch · @EstimateLabels.Rescale</button>
                    }
                    else
                    {
                        <span class="status status--amber status--plain" data-contract-mismatch>@mismatch</span>
                    }
                }
                @if (outcomeIsContract && contractSum is { } sentenceSum)
                {
                    <div class="fc ro est-contract-sentence"><span class="lbl">@EstimateLabels.ContractRepair</span><div class="fv derived" data-contract-sentence>@Pegasus.Core.Reports.ReportWordingComposition.ContractRepairSentence(sentenceSum)</div></div>
                }
            </div>
        }
        <div class="bar" data-estimate-discounts>
            <span class="bl">@EstimateLabels.DiscountsPercent</span>
            @if (editable)
            {
                <span class="dsc"><label for="estimate-discount-parts">@EngineerLabels.Parts</label><input id="estimate-discount-parts" name="estimateDiscountParts" form="case-edit-form" type="number" min="0" max="100" step="0.01" inputmode="decimal" value="@(Model.PostedEstimateValue("estimateDiscountParts") ?? DiscountLabels.PercentValue(discounts.Parts))" /></span>
                <span class="dsc"><label for="estimate-discount-materials">@TotalsLabels.Materials</label><input id="estimate-discount-materials" name="estimateDiscountMaterials" form="case-edit-form" type="number" min="0" max="100" step="0.01" inputmode="decimal" value="@(Model.PostedEstimateValue("estimateDiscountMaterials") ?? DiscountLabels.PercentValue(discounts.Materials))" /></span>
                <span class="dsc"><label for="estimate-discount-specialist">@TotalsLabels.Specialist</label><input id="estimate-discount-specialist" name="estimateDiscountSpecialist" form="case-edit-form" type="number" min="0" max="100" step="0.01" inputmode="decimal" value="@(Model.PostedEstimateValue("estimateDiscountSpecialist") ?? DiscountLabels.PercentValue(discounts.Specialist))" /></span>
                <span class="dsc"><label for="estimate-discount-overall">@EstimateLabels.Overall</label><input id="estimate-discount-overall" name="estimateDiscountOverall" form="case-edit-form" type="number" min="0" max="100" step="0.01" inputmode="decimal" value="@(Model.PostedEstimateValue("estimateDiscountOverall") ?? DiscountLabels.PercentValue(discounts.Overall))" /></span>
            }
            else
            {
                <span class="dsc"><span class="dsl">@EngineerLabels.Parts</span><span class="gv">@DiscountLabels.Value(discounts.Parts)</span></span>
                <span class="dsc"><span class="dsl">@TotalsLabels.Materials</span><span class="gv">@DiscountLabels.Value(discounts.Materials)</span></span>
                <span class="dsc"><span class="dsl">@TotalsLabels.Specialist</span><span class="gv">@DiscountLabels.Value(discounts.Specialist)</span></span>
                <span class="dsc"><span class="dsl">@EstimateLabels.Overall</span><span class="gv">@DiscountLabels.Value(discounts.Overall)</span></span>
            }
        </div>
        <div class="bar" data-estimate-vat>
            <span class="bl">@VatLabels.ChargedOn</span>
            @foreach (var category in VatLabels.Categories)
            {
                if (editable)
                {
                    var field = Pegasus.Web.Pages.Cases.DetailsModel.VatCategoryField(category);
                    <label class="choice">
                        <input id="@field" name="@field" form="case-edit-form" type="checkbox" value="true" data-vat-category="@category"
                               checked="@(vatPolicy.Charges(category) ? "checked" : null)" />
                        <input type="hidden" name="@field" value="false" form="case-edit-form" />
                        <span>@VatLabels.CategoryLabel(category)</span>
                    </label>
                }
                else
                {
                    StaticChoice(vatPolicy.Charges(category), VatLabels.CategoryLabel(category));
                }
            }
            <span class="status status--amber status--plain" data-vat-overridden hidden="@(vatOverridden ? null : "hidden")">@EstimateLabels.Overridden</span>
            @if (editable)
            {
                <button type="button" class="btn btn--small vat-reset" data-vat-reset hidden="@(vatOverridden ? null : "hidden")">@EstimateLabels.ResetToRepairerStatus</button>
            }
        </div>
        RenderBottom(
            editable
                ? Model.EditorLines.Select(row => (row.Operation, row.Description ?? string.Empty)).ToArray()
                : readLines.Select(line => (OperationOf(line.Type), line.Description ?? string.Empty)).ToArray(),
            printed, totals, vatChargedOn, discounts, estimate?.IsCurrent == true);
    }

    // The labour rate bar under the grid, as the reference draws it (v38 P5;
    // v28 P33, P17): one segment per enabled rate card and Custom · typed,
    // all selectable; the regional uplift tick with its chip; the rate the
    // spec prices at in the box at the right, with its working when the
    // uplift is on and Manual when the figure was typed. The segments post
    // the card, the hidden figure posts the base rate, so a chosen card is
    // kept while the figure is the card's (RetainEditorRate).
    void RateBar(EstimateDetails d)
    {
        var selectedKey = rateCard is { } chosen ? $"{chosen.Id:D}:{chosen.Version}" : string.Empty;
        var postedKey = Model.PostedEstimateValue("selectedRateCard");
        if (postedKey is not null) { selectedKey = postedKey; }
        var custom = string.IsNullOrEmpty(selectedKey);
        var baseRate = d.BaseHourlyRate;
        // The uplift as recorded, so a typed rate or a card no longer current
        // or enabled keeps it through a save and reads at the rate it prices.
        var uplifted = d.RegionalUplift;
        var effective = uplifted ? decimal.Round(baseRate * EstimateDetails.RegionalUpliftFactor, 2, MidpointRounding.AwayFromZero) : baseRate;
        var work = uplifted ? $"{Money(baseRate)} × {EstimateDetails.RegionalUpliftFactor.ToString("0.00", CultureInfo.InvariantCulture)} =" : string.Empty;
        var chip = upliftSuggestions.Count > 0 ? EstimateLabels.Suggested + " · " + string.Join(", ", upliftSuggestions) : EstimateLabels.LondonAndHomeCounties;
        <div class="bar est-rate" data-estimate-rate data-uplift-factor="@EstimateDetails.RegionalUpliftFactor.ToString("0.00", CultureInfo.InvariantCulture)">
            <span class="bl">@EngineerLabels.LabourRate</span>
            @if (editable)
            {
                <div class="rseg" role="radiogroup" aria-label="@EstimateLabels.LabourRateCard" data-rate-cards>
                    @foreach (var card in enabledCards)
                    {
                        var cardKey = $"{card.Id:D}:{card.Version}";
                        <label class="rseg-btn"><input type="radio" name="selectedRateCard" form="case-edit-form" value="@cardKey" data-rate="@card.HourlyRate.ToString("0.##", CultureInfo.InvariantCulture)" checked="@(selectedKey == cardKey ? "checked" : null)" /><span>@card.Name</span><small>@Money(card.HourlyRate)@EstimateLabels.PerHour</small></label>
                    }
                    <label class="rseg-btn"><input type="radio" name="selectedRateCard" form="case-edit-form" value="" checked="@(custom ? "checked" : null)" data-rate-custom /><span>@EstimateLabels.Custom</span><small>@EstimateLabels.Typed</small></label>
                </div>
                <label class="choice"><input id="estimate-regional-uplift" type="checkbox" name="estimateRegionalUplift" form="case-edit-form" value="true" checked="@(uplifted ? "checked" : null)" disabled="@(custom && !uplifted ? "disabled" : null)" data-uplift /><input type="hidden" name="estimateRegionalUplift" value="false" form="case-edit-form" /><span>@EstimateLabels.RegionalUpliftTick</span></label>
                <span class="src-tag @(upliftSuggestions.Count > 0 ? "src-tag--ai" : null)" data-estimate-uplift-chip>@chip</span>
                <span class="dsc ratebox">
                    <span class="mono muted" data-rate-work>@work</span>
                    <input id="estimate-labour-rate" class="fi mono" type="number" min="0" step="0.01" inputmode="decimal" value="@effective.ToString("0.00", CultureInfo.InvariantCulture)" aria-label="@EngineerLabels.LabourRatePerHour" data-rate-display />
                    <input type="hidden" name="estimateLabourRate" form="case-edit-form" value="@(Model.PostedEstimateValue("estimateLabourRate") ?? d.LabourRate?.ToString("0.00", CultureInfo.InvariantCulture))" data-rate-input />
                    <span class="muted">@EstimateLabels.PerHour</span>
                    <span class="status status--amber status--plain" data-rate-manual hidden="@(custom ? null : "hidden")">@EstimateLabels.Manual</span>
                </span>
            }
            else
            {
                <div class="rseg" data-rate-cards>
                    @foreach (var card in enabledCards)
                    {
                        <span class="rseg-btn is-static" aria-current="@(rateCard?.Id == card.Id && rateCard?.Version == card.Version ? "true" : "false")"><span>@card.Name</span><small>@Money(card.HourlyRate)@EstimateLabels.PerHour</small></span>
                    }
                    <span class="rseg-btn is-static" aria-current="@(rateCard is null ? "true" : "false")"><span>@EstimateLabels.Custom</span><small>@EstimateLabels.Typed</small></span>
                </div>
                StaticChoice(uplifted, EstimateLabels.RegionalUpliftTick);
                <span class="src-tag @(upliftSuggestions.Count > 0 ? "src-tag--ai" : null)" data-estimate-uplift-chip>@chip</span>
                <span class="dsc ratebox">
                    <span class="mono muted" data-rate-work>@work</span>
                    <span class="gv mono">@Money(effective)</span>
                    <span class="muted">@EstimateLabels.PerHour</span>
                    @if (rateCard is null)
                    {
                        <span class="status status--amber status--plain" data-rate-manual>@EstimateLabels.Manual</span>
                    }
                </span>
            }
        </div>
    }

    // The Supplementary panel at the top of the section, as the reference
    // draws it (v38 P3; v28 P20): what an import onto the spec changed
    // against the version the last sent report used, else the grid the import
    // replaced — the version with its Sent on report mark, the cost movement
    // and a link to the full comparison; one line per change with its value;
    // then Explain the change on the report, the reason and Dismiss. The
    // statement shows once Explain is ticked, and prints on the report. Dismiss
    // clears what the spec supplements; the versions keep the history.
    async Task Supplementary()
    {
        var supplementary = estimate?.Supplementary;
        var baseVersion = Model.SupplementaryBase;
        var diff = Model.SupplementaryDiff;
        if (estimate is null || Model.EditingNewEstimate || supplementary is null || baseVersion is null || diff is null)
        {
            return;
        }
        var reason = supplementary.Reason;
        var delta = diff.GrossDelta >= 0 ? "+" + Money(diff.GrossDelta) : "−" + Money(Math.Abs(diff.GrossDelta));
        var fromKey = Pegasus.Web.Pages.Cases.DetailsModel.ComparisonKey(estimate.SpecificationId, baseVersion.Id);
        var toKey = Pegasus.Web.Pages.Cases.DetailsModel.ComparisonKey(estimate.SpecificationId, null);
        string Field(string field) => field switch
        {
            "quantity" => EngineerLabels.QuantityShort.ToLowerInvariant(),
            "unit amount" => EstimateLabels.UnitPounds.ToLowerInvariant(),
            "paint hours" => EngineerLabels.PaintHoursShort.ToLowerInvariant(),
            "part number" => EstimateLabels.PartNumberShort.ToLowerInvariant(),
            _ => field
        };
        string Value(CaseEstimateLineRecord line, string field) => field switch
        {
            "type" => OperationWord(OperationOf(line.Type)),
            "part number" => line.PartNumber ?? "—",
            "quantity" => (line.Quantity ?? 1).ToString(CultureInfo.InvariantCulture),
            "unit amount" => line.Price is { } price ? Money(price) : "—",
            "hours" => (line.WorkUnits ?? 0m).ToString("0.#", CultureInfo.InvariantCulture),
            "paint hours" => (line.PaintWorkUnits ?? 0m).ToString("0.#", CultureInfo.InvariantCulture),
            "materials" => line.Materials is { } materials ? Money(materials) : "—",
            _ => line.Description ?? string.Empty
        };
        <div class="sub-panel est-supp" data-estimate-supplementary>
            <h3>@EstimateLabels.Supplementary <span class="rt">@EstimateLabels.ChangesVsVersion(baseVersion.Number)@if (baseVersion.SentOnReport) { <span class="status status--plain status--green">@EstimateLabels.SentOnReport</span> }</span><span class="rt est-supp-sum mono">@Money(diff.GrossFrom) → <b>@Money(diff.GrossTo)</b> (@delta) · <a href="@CompareHref(fromKey, toKey)" data-no-inplace data-supp-compare>@EstimateLabels.FullComparison</a></span></h3>
            <ul class="est-supp-list">
                @foreach (var line in diff.Added)
                {
                    <li class="added"><span class="est-supp-tag">@EstimateLabels.Added</span><span class="est-supp-desc">@line.Description</span><span class="mono est-supp-num">@Money(RepairSpecificationComparison.LineValue(line, diff.RateTo))</span></li>
                }
                @foreach (var change in diff.Changed)
                {
                    <li class="changed"><span class="est-supp-tag">@EstimateLabels.Changed</span><span class="est-supp-desc">@change.To.Description<span class="muted"> — @string.Join(", ", change.ChangedFields.Where(field => field != "description").Select(field => $"{Field(field)} {Value(change.From, field)} → {Value(change.To, field)}"))</span></span><span class="mono est-supp-num">@Money(RepairSpecificationComparison.LineValue(change.To, diff.RateTo))</span></li>
                }
                @foreach (var line in diff.Removed)
                {
                    <li class="removed"><span class="est-supp-tag">@EstimateLabels.Removed</span><span class="est-supp-desc">@line.Description</span><span class="mono est-supp-num">@Money(RepairSpecificationComparison.LineValue(line, diff.RateFrom))</span></li>
                }
            </ul>
            @if (editable)
            {
                <div class="cluster est-supp-row">
                    <input type="hidden" name="supplementaryOf" form="case-edit-form" value="@baseVersion.Id" data-supp-of />
                    <label class="choice"><input type="checkbox" name="supplementaryExplain" form="case-edit-form" value="true" checked="@(supplementary.ExplainOnReport ? "checked" : null)" data-supp-explain /><input type="hidden" name="supplementaryExplain" value="false" form="case-edit-form" /><span>@EstimateLabels.ExplainOnReport</span></label>
                    <select class="fi" name="supplementaryReason" form="case-edit-form" aria-label="@EngineerLabels.Reason" data-supp-reason>
                        @foreach (var (code, label, _) in RepairSpecificationComparison.SupplementaryReasons)
                        {
                            <option value="@code" selected="@(reason == code ? "selected" : null)">@label</option>
                        }
                    </select>
                    <button type="button" class="btn btn--small" data-supp-dismiss>
                        <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                        <span>@EstimateLabels.Dismiss</span>
                    </button>
                </div>
            }
            else
            {
                <div class="cluster est-supp-row">
                    @{ StaticChoice(supplementary.ExplainOnReport, EstimateLabels.ExplainOnReport); }
                    <span class="muted">@(RepairSpecificationComparison.SupplementaryReasons.FirstOrDefault(item => item.Code == reason).Label ?? reason)</span>
                </div>
            }
            <div class="fc ro" data-supplementary-statement-cell hidden="@(supplementary.ExplainOnReport ? null : "hidden")"><span class="lbl">@EstimateLabels.SupplementaryDamage</span><div class="fv derived multi" data-supplementary-statement>@supplementary.Statement</div></div>
        </div>
        await Task.CompletedTask;
    }

    // A choice the spec cannot change here reads as its box, ticked or not,
    // beside its words: the control's shape, never a disabled control.
    void StaticChoice(bool on, string label)
    {
        <span class="choice is-static" data-on="@(on ? "true" : "false")"><span class="tick" role="img" aria-label="@(on ? "Yes" : "No")">@if (on){<svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>}</span><span>@label</span></span>
    }
}

<section class="record-section panel @Model.CollapsedClass("case.estimate") @(Model.IsEditing && !Model.SectionIsEditable("estimate") ? "is-locked" : null)" id="section-estimate" data-section="estimate" data-collapse="case.estimate" aria-labelledby="section-estimate-title" data-estimate-section data-estimate-drop-target>
    @if (editing)
    {
        @* The lines' identities as the last commit left them, which the
           script carries into the grid after every commit. *@
        <partial name="Cases/Shared/_CaseEstimateLineIdentities" model="Model" />
    }
    <div class="panel-head">
        <h2 id="section-estimate-title">@EngineerLabels.Estimate</h2>
        @if (meta is not null)
        {
            <span class="meta" data-estimate-meta>@meta</span>
        }
        <div class="panel-actions">
            @if (canOfferImport)
            {
                <form id="case-estimate-import-form" method="post" enctype="multipart/form-data"
                      asp-page="/Cases/Details" asp-page-handler="ImportEstimate"
                      asp-route-id="@caseId" asp-route-section="estimate"
                      data-estimate-import-form
                      data-estimate-import-one-file="@ImportLabels.ExactlyOneFile"
                      data-estimate-import-non-empty="@ImportLabels.NonEmptyFile"
                      data-estimate-import-too-large="@ImportLabels.FileTooLarge"
                      data-estimate-import-max-bytes="@Model.EstimateImportMaximumBytes"
                      data-estimate-import-extensions="@Model.EstimateImportExtensions"
                      data-estimate-import-unsupported="@ImportLabels.UnsupportedFile"
                      data-estimate-import-busy="@ImportLabels.ActionInProgress">
                    <input type="hidden" name="id" value="@caseId" />
                    <input type="hidden" name="expectedVersion" value="@caseVersion" />
                    <input type="hidden" name="operationKey" value="@Model.ImportOperationKey" />
                    <input type="hidden" name="editLeaseToken" value="@(canImport ? Model.LeaseToken : string.Empty)" />
                    <input type="hidden" name="section" value="estimate" />
                    <input type="hidden" name="view" value="@Model.ViewRoute" />
                    @if (estimate is not null && !Model.EditingNewEstimate)
                    {
                        @* The import lands on the spec in view (v38 P3). *@
                        <input type="hidden" name="estimateId" value="@estimate.SpecificationId" />
                    }
                    <div class="estimate-import-control">
                        <div class="estimate-import-fallback" data-estimate-import-fallback>
                            <label for="estimate-import-file">@ImportLabels.FileLabel</label>
                            <input id="estimate-import-file" type="file" name="estimateFile"
                                   accept="@Model.EstimateImportExtensions"
                                   required data-estimate-import-input />
                            <button type="submit" data-busy-label="@OperatorLabels.Busy.Importing" class="btn btn--small">
                                <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                                <span>@EngineerLabels.ImportEstimate</span>
                            </button>
                        </div>
                        <button type="button" data-busy-label="@OperatorLabels.Busy.Importing" class="btn btn--small" hidden data-estimate-import-picker>
                            <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                            <span>@EstimateLabels.Import</span>
                        </button>
                        <span class="estimate-import-status" role="status" aria-live="polite" hidden
                              data-estimate-import-status data-importing-text="@ImportLabels.Importing"></span>
                    </div>
                </form>
            }
            <partial name="/Pages/Cases/Shared/_GlassLaunchControl.cshtml" model="Model" />
            @if (editing && Model.SendToClaudeCondition is null)
            {
                <a class="btn btn--small btn--primary" asp-page="/Cases/Details" asp-route-id="@caseId"
                   asp-route-section="estimate" asp-route-dialog="send-to-claude" asp-route-view="@Model.ViewRoute"
                   data-dialog-open="send-to-ai-dialog" data-estimate-send-to-ai>
                    <svg class="icon" aria-hidden="true"><use href="#icon-sparkles" /></svg>
                    <span>@EstimateLabels.SendToAi</span>
                </a>
            }
            @{
                var offersNewEstimate = editing && Model.AssessmentCanOpen;
                var offersPrint = estimate is { Lines.Count: > 0 } && !Model.EditingNewEstimate;
                var offersCompare = Model.ComparisonOffered;
            }
            @if (offersNewEstimate || estimate is not null)
            {
                @* More (v28 P9): New repair spec while editing, Print Repair
                   Spec for a saved spec with lines, Versions, and Compare —
                   offered with two specs or a frozen version (v38 P2). *@
                <details class="menu" data-menu data-estimate-more>
                    <summary class="btn btn--small"><span>@CaseWorkspaceLabels.Frame.More</span><svg class="icon" aria-hidden="true"><use href="#icon-chevron-down" /></svg></summary>
                    <div class="menu-body">
                        @if (offersNewEstimate)
                        {
                            <a class="btn" asp-page="/Cases/Details" asp-route-id="@caseId"
                               asp-route-section="estimate" asp-route-estimate="new" asp-route-view="@Model.ViewRoute" data-estimate-new>
                                <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                                <span>@EngineerLabels.NewEstimate</span>
                            </a>
                        }
                        @if (offersPrint)
                        {
                            <a class="btn" href="@estimateDocumentHref" target="_blank" rel="noopener"
                               data-document-preview data-busy-label="@OperatorLabels.Busy.Loading" data-file-name="@EstimateLabels.PrintRepairSpec" data-no-inplace data-estimate-print>
                                <svg class="icon" aria-hidden="true"><use href="#icon-file-text" /></svg>
                                <span>@EstimateLabels.PrintRepairSpec</span>
                            </a>
                        }
                        @if (estimate is not null && !Model.EditingNewEstimate)
                        {
                            <a class="btn" asp-page="/Cases/Details" asp-route-id="@caseId"
                               asp-route-section="estimate" asp-route-estimate="@estimate.SpecificationId"
                               asp-route-dialog="versions" asp-route-view="@Model.ViewRoute"
                               data-dialog-open="versions-dialog" data-estimate-versions>
                                <svg class="icon" aria-hidden="true"><use href="#icon-history" /></svg>
                                <span>@EstimateLabels.VersionsCount(Model.SelectedEstimateSnapshots.Count)</span>
                            </a>
                        }
                        @if (offersCompare)
                        {
                            <a class="btn" asp-page="/Cases/Details" asp-route-id="@caseId"
                               asp-route-section="estimate" asp-route-estimate="@estimate?.SpecificationId"
                               asp-route-dialog="compare-estimates" asp-route-view="@Model.ViewRoute"
                               data-dialog-open="compare-estimates-dialog" data-estimate-compare>
                                <svg class="icon" aria-hidden="true"><use href="#icon-list" /></svg>
                                <span>@EngineerLabels.Compare</span>
                            </a>
                        }
                        @* With nothing to compare the item is absent, never disabled (v36 item Y). *@
                    </div>
                </details>
            }
            <button type="button" class="btn btn--small btn--icon" data-estimate-expand
                    title="@EstimateLabels.Expand" aria-label="@EstimateLabels.ExpandEstimate"
                    data-label-expand="@EstimateLabels.Expand" data-label-close="@EstimateLabels.CloseFullScreen">
                <svg class="icon" aria-hidden="true"><use href="#icon-external-link" /></svg>
            </button>
            <partial name="Cases/Shared/_CaseSectionHeadTools" model="headTools" />
        </div>
    </div>
    <div class="panel-body stack">
        <partial name="/Pages/Cases/Shared/_GlassOutcomeControl.cshtml" model="Model" />

        @if (Model.Estimates.Count > 0 || Model.EditingNewEstimate)
        {
            <div class="estimate-tabs" role="tablist" aria-label="@EngineerLabels.Estimates" data-estimate-tabs>
                @foreach (var version in Model.Estimates)
                {
                    var isSelected = estimate?.SpecificationId == version.SpecificationId && !Model.EditingNewEstimate;
                    <a class="estimate-tab" role="tab" asp-page="/Cases/Details"
                       asp-route-id="@caseId" asp-route-section="estimate"
                       asp-route-estimate="@version.SpecificationId" asp-route-view="@Model.ViewRoute"
                       aria-selected="@(isSelected ? "true" : "false")"
                       data-estimate-tab="@version.SpecificationId">
                        <span data-estimate-tab-label>@version.Details.Name</span>
                        <span class="src-tag">@EstimateLabels.RouteTag(version.Source.Route)</span>
                        <span class="status status--plain @StateTone(version.State, version.IsCurrent)">@StateWord(version)</span>
                    </a>
                }
                @if (Model.EditingNewEstimate)
                {
                    <a class="estimate-tab" role="tab" aria-selected="true"
                       asp-page="/Cases/Details" asp-route-id="@caseId"
                       asp-route-section="estimate" asp-route-estimate="new" asp-route-view="@Model.ViewRoute" data-estimate-tab="new">
                        <span>@EngineerLabels.NewEstimate</span>
                        <span class="status status--plain status--amber">@EngineerLabels.EstimateState(RepairSpecificationState.Draft)</span>
                    </a>
                }
            </div>
            @if (estimate is not null && !Model.EditingNewEstimate)
            {
                <p class="muted est-origin" data-estimate-origin>@VersionOrigin(estimate)</p>
            }
        }
        else
        {
            <div class="empty estimate-empty" data-estimate-empty>@EngineerLabels.NoEstimatesRecorded</div>
        }

        <partial name="/Pages/Cases/Shared/_GlassSessionControl.cshtml" model="Model" />

        @if (editing && estimate is not null && !Model.EditingNewEstimate)
        {
            @* Use repair spec / Duplicate / Discard for the selected version
               (Print Repair Spec sits under More, v28 P9; Use repair spec is
               never gated on the repairer's VAT status, P10). *@
            <div class="est-actions" data-estimate-actions>
                @if (Model.SelectedEstimateCanBeCurrent)
                {
                    <form method="post" asp-page="/Cases/Details" asp-page-handler="SetCurrentEstimate"
                          asp-route-id="@caseId" asp-route-section="estimate">
                        <input type="hidden" name="operationKey" value="@Model.UseEstimateOperationKey" />
                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                        <input type="hidden" name="view" value="@Model.ViewRoute" />
                        <input type="hidden" name="estimateId" value="@estimate.SpecificationId" />
                        <button type="submit" data-busy-label="@OperatorLabels.Busy.Applying" class="btn btn--small btn--primary" data-estimate-use>
                            <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                            <span>@EngineerLabels.UseEstimate</span>
                        </button>
                    </form>
                }
                @if (Model.SelectedEstimateCanBeDuplicated)
                {
                    <form method="post" asp-page="/Cases/Details" asp-page-handler="DuplicateEstimate"
                          asp-route-id="@caseId" asp-route-section="estimate">
                        <input type="hidden" name="operationKey" value="@Model.DuplicateOperationKey" />
                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                        <input type="hidden" name="view" value="@Model.ViewRoute" />
                        <input type="hidden" name="estimateId" value="@estimate.SpecificationId" />
                        <button type="submit" data-busy-label="@OperatorLabels.Busy.Duplicating" class="btn btn--small" data-estimate-duplicate>
                            <svg class="icon" aria-hidden="true"><use href="#icon-copy" /></svg>
                            <span>@EngineerLabels.Duplicate</span>
                        </button>
                    </form>
                }
                @if (editable && !estimate.IsCurrent)
                {
                    <a class="btn btn--small btn--danger" asp-page="/Cases/Details"
                       asp-route-id="@caseId" asp-route-section="estimate"
                       asp-route-estimate="@estimate.SpecificationId"
                       asp-route-dialog="delete-estimate" asp-route-view="@Model.ViewRoute" data-dialog-open="delete-estimate-dialog" data-estimate-discard>
                        <svg class="icon" aria-hidden="true"><use href="#icon-trash-2" /></svg>
                        <span>@EstimateLabels.Discard</span>
                    </a>
                }
            </div>
        }

        @if (details is not null && (estimate is not null || Model.EditingNewEstimate))
        {
            if (editable)
            {
                @* The editor's controls belong to the Case form; each commit
                   records the spec with the rest of the Case. *@
                <div class="stack" data-estimate-form
                     data-line-removed-label="@EstimateLabels.LineRemoved" data-lines-removed-label="@EstimateLabels.LinesRemoved(2).Replace("2 ", string.Empty)">
                    <input type="hidden" name="estimateId" value="@(estimate?.SpecificationId)" form="case-edit-form" />
                    @{ await EstimateBody(); }
                </div>
                if (estimate is not null && !Model.EditingNewEstimate && engineerValue is not null)
                {
                    <form id="case-estimate-scale-form" method="post" asp-page="/Cases/Details" asp-page-handler="ScaleEstimate"
                          asp-route-id="@caseId" asp-route-section="estimate">
                        <input type="hidden" name="expectedVersion" value="@caseVersion" />
                        <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                        <input type="hidden" name="view" value="@Model.ViewRoute" />
                        <input type="hidden" name="estimateId" value="@estimate.SpecificationId" />
                    </form>
                }
                if (scaled && estimate is not null)
                {
                    <form id="remove-scaling-form" method="post" asp-page="/Cases/Details" asp-page-handler="RemoveEstimateScaling"
                          asp-route-id="@caseId" asp-route-section="estimate">
                        <input type="hidden" name="expectedVersion" value="@caseVersion" />
                        <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                        <input type="hidden" name="view" value="@Model.ViewRoute" />
                        <input type="hidden" name="estimateId" value="@estimate.SpecificationId" />
                    </form>
                }
            }
            else
            {
                @* Reading, or a spec that is not this staff member's Draft: the
                   same layout, every field a greyed value in its place. *@
                <div class="stack" data-estimate-read>
                    @{ await EstimateBody(); }
                </div>
            }
        }
    </div>
    <div class="estimate-import-drop-overlay" hidden data-estimate-import-overlay aria-hidden="true">
        <div class="estimate-import-drop-card">
            <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
            <strong>@ImportLabels.DropEstimate</strong>
            <span>@ImportLabels.DropHint</span>
        </div>
    </div>
</section>

@if (Model.ComparisonOffered)
{
    var openOnLoad = Model.OpenDialog == "compare-estimates"
        ? Html.Raw(" data-dialog-open-on-load=\"true\"")
        : Html.Raw(" hidden");
    string SideName(Pegasus.Web.Pages.Cases.DetailsModel.CompareOption option) =>
        option.Version is { } version ? EstimateLabels.VersionWord(version.Number)
        : option.Specification.SpecificationId == estimate?.SpecificationId ? EstimateLabels.Working
        : option.Specification.Details.Name;
    <div id="compare-estimates-dialog" class="dialog-backdrop" data-dialog="compare-estimates-dialog"
         @openOnLoad>
        <section class="dialog dialog--wide dialog--compare" role="dialog" aria-modal="true"
                 aria-labelledby="compare-estimates-dialog-title">
            <div class="dialog-head">
                <h2 id="compare-estimates-dialog-title" tabindex="-1">@EngineerLabels.CompareEstimates</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="@EngineerLabels.CloseDialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </div>
            <div class="dialog-body noprint">
                <div class="table-wrap">
                    <table class="table table--compact cmp-table" data-estimate-compare-table>
                        <thead>
                            <tr>
                                <th scope="col">@EngineerLabels.Estimate</th>
                                <th scope="col">@EngineerLabels.State</th>
                                <th scope="col" class="num">@TotalsLabels.Net</th>
                                <th scope="col" class="num">@EngineerLabels.Vat</th>
                                <th scope="col" class="num">@TotalsLabels.Gross</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var compared in Model.Estimates)
                            {
                                var comparedTotals = EstimateTotals.Compute(compared).Printed;
                                <tr>
                                    <td>@compared.Details.Name<br /><small class="muted">@EstimateLabels.RouteTag(compared.Source.Route) · @OperatorLabels.OfficeTime(compared.CreatedAtUtc)</small></td>
                                    <td><span class="status status--plain @StateTone(compared.State, compared.IsCurrent)">@StateWord(compared)</span></td>
                                    <td class="num mono">@Money(comparedTotals.Net)</td>
                                    <td class="num mono">@Money(comparedTotals.Vat)</td>
                                    <td class="num mono">@Money(comparedTotals.Gross)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="dialog-body stack" data-estimate-compare-diff>
                @* From and To list the selected spec's working draft and its
                   versions, then the other specs and theirs (v38 P2). *@
                <form method="get" asp-page="/Cases/Details" asp-route-id="@caseId" class="cluster noprint" data-estimate-compare-form>
                    <input type="hidden" name="section" value="estimate" />
                    <input type="hidden" name="estimate" value="@estimate?.SpecificationId" />
                    <input type="hidden" name="dialog" value="compare-estimates" />
                    @if (Model.IsInspectionView)
                    {
                        <input type="hidden" name="view" value="@Pegasus.Web.Pages.Cases.DetailsModel.InspectionViewKey" />
                    }
                    <label class="dsc">@EstimateLabels.From
                        <select class="fi" name="from" aria-label="@EstimateLabels.From">
                            <option value="">@EstimateLabels.Choose</option>
                            @foreach (var option in Model.ComparisonOptions)
                            {
                                <option value="@option.Key" selected="@(Model.ComparisonFrom?.Key == option.Key ? "selected" : null)">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label class="dsc">@EstimateLabels.To
                        <select class="fi" name="to" aria-label="@EstimateLabels.To">
                            <option value="">@EstimateLabels.Choose</option>
                            @foreach (var option in Model.ComparisonOptions)
                            {
                                <option value="@option.Key" selected="@(Model.ComparisonTo?.Key == option.Key ? "selected" : null)">@option.Label</option>
                            }
                        </select>
                    </label>
                    <button type="submit" class="btn btn--small" data-estimate-compare-go>@EngineerLabels.Compare</button>
                </form>
                @if (Model.Comparison is { } comparison && Model.ComparisonFrom is { } fromSide && Model.ComparisonTo is { } toSide)
                {
                    <partial name="Cases/Shared/_RepairSpecDiff" model="new Pegasus.Web.Pages.Cases.RepairSpecDiffView(comparison, SideName(fromSide), SideName(toSide))" />
                }
            </div>
            <div class="dialog-foot noprint">
                @if (Model.Comparison is not null)
                {
                    <button type="button" class="btn" data-compare-print>
                        <svg class="icon" aria-hidden="true"><use href="#icon-file-text" /></svg>
                        <span>@EstimateLabels.PrintComparisonSheet</span>
                    </button>
                }
                <button type="button" class="btn" data-dialog-close>@EngineerLabels.CloseDialog</button>
            </div>
        </section>
    </div>
}

@if (estimate is not null && !Model.EditingNewEstimate)
{
    var openOnLoad = Model.OpenDialog == "versions"
        ? Html.Raw(" data-dialog-open-on-load=\"true\"")
        : Html.Raw(" hidden");
    var draftGross = printed.Gross;
    <div id="versions-dialog" class="dialog-backdrop" data-dialog="versions-dialog" @openOnLoad>
        <section class="dialog dialog--wide" role="dialog" aria-modal="true" aria-labelledby="versions-dialog-title">
            <div class="dialog-head">
                <h2 id="versions-dialog-title" tabindex="-1">@EstimateLabels.VersionsTitle</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="@EngineerLabels.CloseDialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </div>
            <div class="dialog-body">
                <div class="table-wrap">
                    <table class="table table--compact versions-table" data-estimate-versions-table>
                        <thead>
                            <tr>
                                <th scope="col">@EstimateLabels.Version</th>
                                <th scope="col">@EstimateLabels.When</th>
                                <th scope="col">@EstimateLabels.HowItCameAbout</th>
                                <th scope="col" class="num">@EstimateLabels.Lines</th>
                                <th scope="col" class="num">@EstimateLabels.Rate</th>
                                <th scope="col" class="num">@EstimateLabels.TotalIncVat</th>
                                <th scope="col"><span class="sr-only">@EngineerLabels.Action</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="cur" data-estimate-version="draft">
                                <td><span class="mono">@EngineerLabels.EstimateState(RepairSpecificationState.Draft)</span> <span class="status status--plain status--amber">@EstimateLabels.Working</span></td>
                                <td>@EstimateLabels.Now</td>
                                <td>@EstimateLabels.TheDraftBeingEdited</td>
                                <td class="num mono">@estimate.Lines.Count</td>
                                <td class="num mono">@Money(estimate.Details.HourlyRate)</td>
                                <td class="num mono"><b>@Money(draftGross)</b></td>
                                <td></td>
                            </tr>
                            @foreach (var version in Model.SelectedEstimateSnapshots.OrderByDescending(item => item.Number))
                            {
                                <tr data-estimate-version="@version.Number">
                                    <td><span class="mono">v@(version.Number)</span> @if (version.SentOnReport) { <span class="status status--plain status--green">@EstimateLabels.SentOnReport</span> }</td>
                                    <td>@OperatorLabels.OfficeTime(version.CreatedAtUtc)<br /><span class="muted">@version.CreatedBy</span></td>
                                    <td>@version.Origin</td>
                                    <td class="num mono">@version.Lines.Count</td>
                                    <td class="num mono">@Money(version.Details.HourlyRate)</td>
                                    <td class="num mono"><b>@Money(version.Gross)</b></td>
                                    <td>
                                        <div class="cluster version-acts">
                                            @* Compare with current (v38 P2): this version against the working draft. *@
                                            <a class="btn btn--small" href="@CompareHref(Pegasus.Web.Pages.Cases.DetailsModel.ComparisonKey(estimate.SpecificationId, version.Id), Pegasus.Web.Pages.Cases.DetailsModel.ComparisonKey(estimate.SpecificationId, null))" data-no-inplace data-estimate-version-compare="@version.Number">@EstimateLabels.CompareWithCurrent</a>
                                            @if (editable)
                                            {
                                                <form method="post" asp-page="/Cases/Details" asp-page-handler="RestoreEstimateSnapshot" asp-route-id="@caseId" asp-route-section="estimate">
                                                    <input type="hidden" name="operationKey" value="@Model.RestoreOperationKey" />
                                                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                                                    <input type="hidden" name="view" value="@Model.ViewRoute" />
                                                    <input type="hidden" name="estimateId" value="@estimate.SpecificationId" />
                                                    <input type="hidden" name="snapshotId" value="@version.Id" />
                                                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Restoring" class="btn btn--small" data-estimate-restore="@version.Number">@EstimateLabels.Restore</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="dialog-foot">
                <button type="button" class="btn" data-dialog-close>@EngineerLabels.CloseDialog</button>
            </div>
        </section>
    </div>
}

@if (editable)
{
    <div id="delete-lines-dialog" class="dialog-backdrop" data-dialog="delete-lines-dialog" hidden>
        <section class="dialog dialog--compact" role="alertdialog" aria-modal="true" aria-labelledby="delete-lines-dialog-title">
            <div class="dialog-head">
                <h2 id="delete-lines-dialog-title" tabindex="-1">@EngineerLabels.DeleteAllLines</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="@EngineerLabels.CloseDialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </div>
            <div class="dialog-body stack">
                <p class="consequence"><span data-delete-lines-count>@Model.EditorLines.Count</span> @EngineerLabels.LinesWord</p>
            </div>
            <div class="dialog-foot">
                <button type="button" class="btn" data-dialog-close>@EngineerLabels.Cancel</button>
                <button type="button" class="btn btn--danger" data-delete-lines-confirm data-dialog-close>@EngineerLabels.DeleteAllLines</button>
            </div>
        </section>
    </div>
}

@if (editable && estimate is { IsCurrent: false } discardable && !Model.EditingNewEstimate)
{
    var openOnLoad = Model.OpenDialog == "delete-estimate"
        ? Html.Raw(" data-dialog-open-on-load=\"true\"")
        : Html.Raw(" hidden");
    <div id="delete-estimate-dialog" class="dialog-backdrop" data-dialog="delete-estimate-dialog"
         @openOnLoad>
        <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="delete-estimate-dialog-title">
            <div class="dialog-head">
                <h2 id="delete-estimate-dialog-title" tabindex="-1">@EstimateLabels.DiscardEstimate</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="@EngineerLabels.CloseDialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </div>
            <form method="post" asp-page="/Cases/Details" asp-page-handler="DiscardEstimate"
                  asp-route-id="@caseId" asp-route-section="estimate">
                <input type="hidden" name="operationKey" value="@Model.DiscardOperationKey" />
                <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                <input type="hidden" name="view" value="@Model.ViewRoute" />
                <input type="hidden" name="estimateId" value="@discardable.SpecificationId" />
                <div class="dialog-body stack">
                    <p class="consequence">@EstimateLabels.DiscardPrompt(discardable.Details.Name)</p>
                    <div class="field">
                        <label class="req" for="delete-reason">@EngineerLabels.Reason</label>
                        <input type="text" id="delete-reason" name="reason" maxlength="500" required data-dialog-initial-focus />
                    </div>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>@EngineerLabels.Cancel</button>
                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Discarding" class="btn btn--danger">@EstimateLabels.Discard</button>
                </div>
            </form>
        </section>
    </div>
}

@if (editing && Model.SendToClaudeCondition is null)
{
    var openOnLoad = Model.OpenDialog == "send-to-claude"
        ? Html.Raw(" data-dialog-open-on-load=\"true\"")
        : Html.Raw(" hidden");
    <div id="send-to-ai-dialog" class="dialog-backdrop" data-dialog="send-to-ai-dialog"
         @openOnLoad>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="send-to-ai-dialog-title">
            <div class="dialog-head">
                <h2 id="send-to-ai-dialog-title" tabindex="-1">@EstimateLabels.SendToAi</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="@EngineerLabels.CloseDialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </div>
            <form method="post" asp-page="/Cases/Details" asp-page-handler="SendToClaude"
                  asp-route-id="@caseId" asp-route-section="estimate" data-estimate-send-to-ai-form>
                <input type="hidden" name="operationKey" value="@Model.SendOperationKey" />
                <input type="hidden" name="view" value="@Model.ViewRoute" />
                <div class="dialog-body stack">
                    <div class="field">
                        <label for="ai-direction">@EngineerLabels.Direction</label>
                        <textarea id="ai-direction" name="direction" rows="4" maxlength="1000" data-dialog-initial-focus></textarea>
                    </div>
                    <div class="field">
                        <label for="ai-target">@EngineerLabels.TargetEstimate <output id="ai-target-value" for="ai-target">—</output></label>
                        <input type="number" id="ai-target" name="targetPercent" min="0" max="80" step="1" inputmode="numeric"
                               data-estimate-range data-estimate-range-output="ai-target-value" data-estimate-range-base="@targetBase"
                               data-estimate-range-amount="ai-target-amount" />
                    </div>
                    <dl class="audit-facts">
                        <dt>@EngineerLabels.CaseValuation</dt>
                        <dd class="mono">@(engineerValue is { } valuation ? Money(valuation) : "—")</dd>
                        <dt>@EngineerLabels.TargetAmount</dt>
                        <dd class="mono" id="ai-target-amount">—</dd>
                    </dl>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>@EngineerLabels.Cancel</button>
                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Sending" class="btn btn--primary">
                        <svg class="icon" aria-hidden="true"><use href="#icon-sparkles" /></svg>
                        <span>@EstimateLabels.SendToAi</span>
                    </button>
                </div>
            </form>
        </section>
    </div>
}

@functions {
    /// <summary>
    /// The three work-lists and the rollup (B04): every figure is the one
    /// totals owner's printed breakdown; the lists sort the lines by their
    /// operation. Discount rows read the percentage the estimate carries —
    /// the printed components are already net of them.
    /// </summary>
    private void RenderBottom(
        (string Operation, string Description)[] lines,
        EstimatePrintedTotals printed,
        EstimateTotals totals,
        string[] vatChargedOn,
        EstimateDiscounts discounts,
        bool isCurrent)
    {
        var culture = CultureInfo.GetCultureInfo("en-GB");
        string Money(decimal value) => "£" + value.ToString("N2", culture);
        var newParts = lines.Where(line => line.Operation == "Replace").Select(line => line.Description).Where(text => !string.IsNullOrWhiteSpace(text)).ToArray();
        var repairs = lines.Where(line => line.Operation is "Repair" or "RemoveAndRefit").Select(line => line.Description).Where(text => !string.IsNullOrWhiteSpace(text)).ToArray();
        var operations = lines.Where(line => line.Operation is "Paint" or "Blend" or "Specialist" or "Other").Select(line => line.Description).Where(text => !string.IsNullOrWhiteSpace(text)).ToArray();
        <div class="est-bottom">
            <div class="wl" data-estimate-worklists>
                <div class="wcol"><div class="wt">@CaseWorkspaceLabels.Estimate.MainNewParts</div><ul>@if (newParts.Length == 0) {<li class="muted">@CaseWorkspaceLabels.Estimate.None</li>} @foreach (var text in newParts) {<li>@text</li>}</ul></div>
                <div class="wcol"><div class="wt">@CaseWorkspaceLabels.Estimate.RepairsRequired</div><ul>@if (repairs.Length == 0) {<li class="muted">@CaseWorkspaceLabels.Estimate.None</li>} @foreach (var text in repairs) {<li>@text</li>}</ul></div>
                <div class="wcol"><div class="wt">@CaseWorkspaceLabels.Estimate.AdditionalOperations</div><ul>@if (operations.Length == 0) {<li class="muted">@CaseWorkspaceLabels.Estimate.None</li>} @foreach (var text in operations) {<li>@text</li>}</ul></div>
            </div>
            <dl class="rollup" data-estimate-rollup>
                <div class="rr"><dt>@OperatorLabels.CaseWorkspace.EngineerSections.Parts</dt><dd data-rollup="parts">@Money(printed.Parts)</dd></div>
                <div class="rr"><dt>@CaseWorkspaceLabels.EstimateTotals.PanelLabour</dt><dd data-rollup="panelLabour">@Money(printed.PanelLabour)</dd></div>
                <div class="rr"><dt>@CaseWorkspaceLabels.EstimateTotals.PaintLabour</dt><dd data-rollup="paintLabour">@Money(printed.PaintLabour)</dd></div>
                <div class="rr"><dt>@CaseWorkspaceLabels.EstimateTotals.Materials</dt><dd data-rollup="materials">@Money(printed.Materials)</dd></div>
                <div class="rr"><dt>@CaseWorkspaceLabels.EstimateTotals.Specialist</dt><dd data-rollup="specialist">@Money(printed.Specialist)</dd></div>
                @if (discounts.Parts > 0m) {<div class="rr"><dt>@CaseWorkspaceLabels.EstimateDiscount.Parts</dt><dd>−@CaseWorkspaceLabels.EstimateDiscount.Value(discounts.Parts)</dd></div>}
                @if (discounts.Materials > 0m) {<div class="rr"><dt>@CaseWorkspaceLabels.EstimateDiscount.Materials</dt><dd>−@CaseWorkspaceLabels.EstimateDiscount.Value(discounts.Materials)</dd></div>}
                @if (discounts.Specialist > 0m) {<div class="rr"><dt>@CaseWorkspaceLabels.EstimateDiscount.Specialist</dt><dd>−@CaseWorkspaceLabels.EstimateDiscount.Value(discounts.Specialist)</dd></div>}
                @if (discounts.Overall > 0m) {<div class="rr"><dt>@CaseWorkspaceLabels.EstimateDiscount.Overall</dt><dd>−@CaseWorkspaceLabels.EstimateDiscount.Value(discounts.Overall)</dd></div>}
                @if (totals.Raw.OffPattern > 0m) {<div class="rr" data-estimate-off-pattern><dt>@CaseWorkspaceLabels.EstimateTotals.OffPatternItems</dt><dd data-rollup="offPattern">@Money(decimal.Round(totals.Raw.OffPattern, 2, MidpointRounding.AwayFromZero))</dd></div>}
                <div class="rr"><dt>@CaseWorkspaceLabels.EstimateTotals.Net</dt><dd data-rollup="net">@Money(printed.Net)</dd></div>
                <div class="rr"><dt>@OperatorLabels.CaseWorkspace.EngineerSections.Vat @totals.VatPercent.ToString("0.##", CultureInfo.InvariantCulture) % @CaseWorkspaceLabels.Estimate.On @(vatChargedOn.Length == 0 ? CaseWorkspaceLabels.EstimateVat.NoCategories.ToLowerInvariant() : string.Join(", ", vatChargedOn).ToLowerInvariant())</dt><dd data-rollup="vat">@Money(printed.Vat)</dd></div>
                <div class="rr tot"><dt>@CaseWorkspaceLabels.Estimate.RepairCostIncVat@(isCurrent ? null : " · " + CaseWorkspaceLabels.Estimate.DraftSuffix)</dt><dd data-estimate-gross data-rollup="gross">@Money(printed.Gross)</dd></div>
            </dl>
        </div>
    }
}
