                        <dd class="mono" id="ai-target-amount">@(engineerValue is { } target ? Money(Math.Round(target * 0.75m, 0, MidpointRounding.AwayFromZero)) : "—")</dd>
                    </dl>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close data-dialog-dismiss>@EngineerLabels.Cancel</button>
