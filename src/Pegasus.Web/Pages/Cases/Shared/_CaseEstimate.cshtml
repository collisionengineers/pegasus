                    }
                    <label class="dsc">@EstimateLabels.From
                        <select class="fi" name="from" aria-label="@EstimateLabels.From">
                            <option value="">@EstimateLabels.Choose</option>
                            @foreach (var option in Model.Estimates)
                            {
                                <option value="@option.SpecificationId" selected="@(Model.ComparisonFrom?.SpecificationId == option.SpecificationId ? "selected" : null)">@option.Details.Name</option>
                            }
                        </select>
                    </label>
                    <label class="dsc">@EstimateLabels.To
                        <select class="fi" name="to" aria-label="@EstimateLabels.To">
                            <option value="">@EstimateLabels.Choose</option>
                            @foreach (var option in Model.Estimates)
                            {
                                <option value="@option.SpecificationId" selected="@(Model.ComparisonTo?.SpecificationId == option.SpecificationId ? "selected" : null)">@option.Details.Name</option>
                            }
                        </select>
                    </label>
                    <button type="submit" class="btn btn--small" data-estimate-compare-go>@EngineerLabels.Compare</button>
                </form>
