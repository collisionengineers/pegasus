@*
    Repair Spec (v26 § Estimate; renamed by v28 P31). One section: the head
    carries Import (visible in read mode, where it opens the edit session
    first), the one Glass's / Resume slot, Send to AI, one More menu (New
    repair spec, Print Repair Spec, Compare — greyed out with one spec) and
    Expand; the body carries the outcome notice, the tabs (the selected tab
    renames the spec by double-click, P32), the Glass's session line with its
    guarded Close, Use repair spec / Duplicate / Discard, one summary line in
    read mode (the header grid returns on Edit), the grid with its Material
    column (P48) and trailing blank line, Add line and Delete all lines
    (P16), the discount and VAT bars, the three work-lists and the rollup
    with its off-pattern line (P37). Every action is a plain posted form;
    case-workspace.js adds the phantom row, the full-screen toggle, the VAT
    reset, the range interaction, the tab rename, the one labour-rate control
    (P33) and the Undo toast.
*@
@using System.Globalization
@using Pegasus.Core.Assessment
@using Pegasus.Web.Presentation
@using EngineerLabels = Pegasus.Web.Presentation.OperatorLabels.CaseWorkspace.EngineerSections
@using EstimateLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Estimate
@using GlassLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.GlassSession
@using TotalsLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.EstimateTotals
@using VatLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.EstimateVat
@using DiscountLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.EstimateDiscount
@using ImportLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.EstimateImport
@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var caseId = Model.Case!.Workflow.CaseId;
    var caseVersion = Model.Case.Workflow.Version;
    // The section edits only inside the page-wide session (v26 J); an
    // estimate edits only while it is a Draft this staff member may change.
    var editing = Model.SectionIsEditable("estimate");
    var estimate = Model.SelectedEstimate;
    var editable = editing && Model.SelectedEstimateIsEditable;
    var canImport = editing && Model.ImportCondition is null;
    var offersImportFromRead = !editing && Model.SectionOffersEdit("estimate") && Model.ImportCondition is null;
    var details = Model.EditorDetails;
    var totals = Model.EditorTotals;
    var printed = totals.Printed;
    var vatPolicy = details?.VatPolicy ?? totals.VatPolicy;
    var discounts = details?.AppliedDiscounts ?? EstimateDiscounts.None;
    var engineerValue = Model.EngineerValue;
    var targetBase = engineerValue is null
        ? string.Empty
        : engineerValue.Value.ToString("0.##", CultureInfo.InvariantCulture);
    var glassSession = Model.GlassSession;
    var glassOccupies = glassSession is not null
        && GlassRepairEstimateSessionPolicy.OccupiesAccount(glassSession.State);
    var showGlassLine = Model.GlassSessionElsewhere is not null
        || (glassSession is not null && (glassOccupies || glassSession.State == GlassRepairEstimateSessionState.Failed));
    var culture = CultureInfo.GetCultureInfo("en-GB");
    var headTools = new Pegasus.Web.Pages.Cases.CaseSectionHeadView(Model, "estimate");
    var rateCardName = details?.Rate is { RateCardId: { } rateCardId, RateCardVersion: { } rateCardVersion }
        ? Model.LabourRateCards.FirstOrDefault(card => card.Id == rateCardId && card.Version == rateCardVersion)?.Name
        : null;

    string Money(decimal value) => "£" + value.ToString("N2", culture);
    string MoneyOrAbsent(decimal? value) => value is { } present ? Money(present) : OperatorLabels.CaseWorkspace.AbsentValue;

    // What the line's Source column says: a line an import brought in (named
    // by its route, v28 P18), one a staff member changed since, or one keyed by
    // hand.
    string LineSource(CaseEstimateLineRecord line) =>
        line.AmendedBy is not null ? EstimateLabels.SourceAmended
        : line.Origin is not null || line.SourceDocumentIdentity is not null ? EstimateLabels.ImportedFrom(estimate?.Source.Route ?? RepairSpecificationSourceRoute.Manual)
        : EstimateLabels.SourceManual;

    // The off-pattern cells (v28 P37): Core's anomalies by line position and
    // the editor field each names.
    var offPattern = totals.OffPattern
        .Select(anomaly => (anomaly.Position, Field: anomaly.Field switch
        {
            "unit amount" => "linePartPounds",
            "paint hours" => "linePaintHours",
            "hours" => "lineLabourHours",
            _ => anomaly.Field
        }))
        .ToHashSet();
    string OffPatternClass(int position, string field) => offPattern.Contains((position, field)) ? "viol" : string.Empty;
    string? OffPatternLabel(int position, string field) => offPattern.Contains((position, field)) ? EstimateLabels.OffPattern : null;
    var upliftSuggestions = Model.RegionalUpliftSuggestions;
    var scaled = Model.SelectedEstimateIsScaled;
    var contractPath = AssessmentVocabulary.SettlementContractSum;
    var contractSumText = Model.AssessmentEditorValue(contractPath);
    var contractSum = decimal.TryParse(contractSumText, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsedContractSum) ? parsedContractSum : (decimal?)null;
    var outcomeIsContract = Model.AssessmentEditorValue(AssessmentVocabulary.Outcome) == "contract_repair";
    var others = Model.Estimates.Where(item => item.SpecificationId != estimate?.SpecificationId).ToArray();
    string VersionOrigin(RepairSpecificationVersion version) =>
        $"Populated {OperatorLabels.OfficeTime(version.CreatedAtUtc)} by {version.CreatedBy}, {RepairSpecificationRouteWords.Of(version.Source.Route)} · {EstimateLabels.LinesCount(version.Lines.Count)} · {EngineerLabels.LabourRate.ToLowerInvariant()} {Money(version.Details.HourlyRate)}/h";

    string RouteTag(RepairSpecificationSourceRoute route) => route switch
    {
        RepairSpecificationSourceRoute.Manual => EstimateLabels.RouteManual,
        RepairSpecificationSourceRoute.Glasses => EstimateLabels.RouteGlasses,
        RepairSpecificationSourceRoute.AudatexPdf => EstimateLabels.RouteAudatex,
        RepairSpecificationSourceRoute.Json => EstimateLabels.RouteJson,
        RepairSpecificationSourceRoute.ApprovedAiProposal or RepairSpecificationSourceRoute.AiDraft => EstimateLabels.RouteAi,
        _ => EstimateLabels.RouteUnknown
    };

    string StateTone(RepairSpecificationState state, bool isCurrent) =>
        isCurrent ? "status--green"
        : state == RepairSpecificationState.Draft ? "status--amber"
        : "status--neutral";

    string StateWord(RepairSpecificationVersion version) =>
        version.IsCurrent ? EngineerLabels.Current : EngineerLabels.EstimateState(version.State);

    var meta = estimate is null
        ? null
        : $"{OperatorLabels.RepairSpecificationRoute(estimate.Source.Route)} · {OperatorLabels.OfficeTime(estimate.CreatedAtUtc)} · {estimate.Lines.Count} {(estimate.Lines.Count == 1 ? "line" : "lines")}";

    // The Glass's outcome notice at the top of the section, one sentence per
    // settled state; absent while a session is simply open.
    string? glassNoticeTone = null;
    string? glassNoticeText = null;
    if (glassSession is not null)
    {
        switch (glassSession.State)
        {
            case GlassRepairEstimateSessionState.Completed:
                glassNoticeTone = "notice--success";
                glassNoticeText = GlassLabels.OutcomeMessage(glassSession.State);
                break;
            case GlassRepairEstimateSessionState.AwaitingImport:
            case GlassRepairEstimateSessionState.Unknown:
            case GlassRepairEstimateSessionState.Failed:
                glassNoticeTone = "notice--warning";
                glassNoticeText = GlassLabels.OutcomeMessage(glassSession.State);
                break;
            case GlassRepairEstimateSessionState.Cancelled:
                glassNoticeTone = "";
                glassNoticeText = GlassLabels.Closed;
                break;
        }
    }

    string GlassChipTone(GlassRepairEstimateSessionState state) => state switch
    {
        GlassRepairEstimateSessionState.Failed => "status--red",
        GlassRepairEstimateSessionState.Unknown or GlassRepairEstimateSessionState.AwaitingImport => "status--amber",
        _ => "status--blue"
    };

    var editLineAction = Url.Page("/Cases/Details", "EditLine", new { id = caseId, section = "estimate" });
    var lineOrigins = estimate?.Lines.ToDictionary(line => line.Id, line => line) ?? new Dictionary<Guid, CaseEstimateLineRecord>();
    var operations = new[]
    {
        ("Replace", EngineerLabels.Replace),
        ("Repair", EngineerLabels.Repair),
        ("RemoveAndRefit", EngineerLabels.RemoveAndRefit),
        ("Paint", EngineerLabels.PaintOperation),
        ("Blend", EstimateLabels.Blend),
        ("Specialist", TotalsLabels.Specialist),
        ("Other", EngineerLabels.Other)
    };
    var vatOverridden = vatPolicy.CategoriesOverridden;
    var readLines = estimate?.Lines.OrderBy(line => line.Position).ToArray() ?? [];
    var vatChargedOn = VatLabels.Categories.Where(vatPolicy.Charges).Select(VatLabels.CategoryLabel).ToArray();
    var estimateDocumentHref = estimate is null
        ? null
        : Url.Page("/Cases/Details", "EstimateDocument", new
        {
            id = caseId,
            estimateId = estimate.SpecificationId
        });

    // The work-lists sort recorded lines by operation; a type the mapping
    // does not know lands with the additional operations rather than failing.
    string OperationOf(string lineType)
    {
        try
        {
            return EstimateOperations.FromLineType(lineType).ToString();
        }
        catch (InvalidOperationException)
        {
            return "Other";
        }
    }
}

<section class="record-section panel @Model.CollapsedClass("case.estimate") @Model.ActiveTabClass("estimate") @(Model.IsEditing && !Model.SectionIsEditable("estimate") ? "is-locked" : null)" id="section-estimate" data-section="estimate" data-collapse="case.estimate" aria-labelledby="section-estimate-title" data-estimate-section>
    <div class="panel-head">
        <h2 id="section-estimate-title">@EngineerLabels.Estimate</h2>
        @if (meta is not null)
        {
            <span class="meta" data-estimate-meta>@meta</span>
        }
        <div class="panel-actions">
            @if (canImport)
            {
                <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@caseId"
                   asp-route-section="estimate" asp-route-dialog="import-estimate"
                   data-dialog-open="import-estimate-dialog" data-estimate-import>
                    <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                    <span>@EstimateLabels.Import</span>
                </a>
            }
            else if (offersImportFromRead)
            {
                @* Import stays visible in read mode and opens the edit session
                   first (v26); the operator then presses Import again. Without
                   script this is the same claim the section-head Edit posts. *@
                <form method="post" asp-page="/Cases/Details" asp-page-handler="ClaimLease" asp-route-id="@caseId" data-case-edit-form>
                    <input type="hidden" name="id" value="@caseId" />
                    <input type="hidden" name="expectedVersion" value="@caseVersion" />
                    <input type="hidden" name="operationKey" value="@Model.ClaimLeaseOperationKey" />
                    <input type="hidden" name="section" value="estimate" />
                    <button type="submit" class="btn btn--small" data-section-edit="estimate" data-estimate-import>
                        <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                        <span>@EstimateLabels.Import</span>
                    </button>
                </form>
            }
            @* The one Glass's slot (v26 G) — Glass's while the
               account is free, Resume while this staff member's session holds it;
               absent without an enabled account, and absent while the account
               is held from another Case. The estimator opens in its own
               window (case-workspace.js names it; target is the no-script
               path) and this record keeps its edit session. *@
            @if (editing && Model.CanResumeGlass && glassSession is not null)
            {
                <form method="post" asp-page="/Cases/Details" asp-page-handler="ResumeGlass"
                      asp-route-id="@caseId" asp-route-section="estimate"
                      target="_blank" data-glass-window data-glass-slot="resume">
                    <input type="hidden" name="operationKey" value="@Model.ResumeGlassOperationKey" />
                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                    <input type="hidden" name="sessionId" value="@glassSession.Id" />
                    <input type="hidden" name="expectedSessionVersion" value="@glassSession.Version" />
                    <button type="submit" class="btn btn--small">
                        <svg class="icon" aria-hidden="true"><use href="#icon-play" /></svg>
                        <span>@GlassLabels.Resume</span>
                    </button>
                </form>
            }
            else if (editing && Model.CanLaunchGlass)
            {
                <form method="post" asp-page="/Cases/Details" asp-page-handler="LaunchGlass"
                      asp-route-id="@caseId" asp-route-section="estimate"
                      target="_blank" data-glass-window data-glass-slot="launch">
                    <input type="hidden" name="operationKey" value="@Model.LaunchGlassOperationKey" />
                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                    <button type="submit" class="btn btn--small">
                        <svg class="icon" aria-hidden="true"><use href="#icon-external-link" /></svg>
                        <span>@GlassLabels.Launch</span>
                    </button>
                </form>
            }
            @if (editing && Model.SendToClaudeCondition is null)
            {
                <a class="btn btn--small btn--primary" asp-page="/Cases/Details" asp-route-id="@caseId"
                   asp-route-section="estimate" asp-route-dialog="send-to-claude"
                   data-dialog-open="send-to-ai-dialog" data-estimate-send-to-ai>
                    <svg class="icon" aria-hidden="true"><use href="#icon-sparkles" /></svg>
                    <span>@EstimateLabels.SendToAi</span>
                </a>
            }
            @{
                var offersNewEstimate = editing && Model.AssessmentCanOpen;
                var offersPrint = estimate is { Lines.Count: > 0 } && !Model.EditingNewEstimate;
                var offersCompare = Model.Estimates.Count >= 2;
            }
            @if (offersNewEstimate || estimate is not null)
            {
                @* More (v28 P9): New repair spec while editing, Print Repair
                   Spec for a saved spec with lines, and Compare — greyed out
                   until the Case holds two specs. *@
                <details class="menu" data-menu data-estimate-more>
                    <summary class="btn btn--small"><span>@CaseWorkspaceLabels.Frame.More</span><svg class="icon" aria-hidden="true"><use href="#icon-chevron-down" /></svg></summary>
                    <div class="menu-body">
                        @if (offersNewEstimate)
                        {
                            <a class="btn" asp-page="/Cases/Details" asp-route-id="@caseId"
                               asp-route-section="estimate" asp-route-estimate="new" data-estimate-new>
                                <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                                <span>@EngineerLabels.NewEstimate</span>
                            </a>
                        }
                        @if (offersPrint)
                        {
                            <a class="btn" href="@estimateDocumentHref" target="_blank" rel="noopener"
                               data-document-preview data-file-name="@EstimateLabels.PrintRepairSpec" data-no-inplace data-estimate-print>
                                <svg class="icon" aria-hidden="true"><use href="#icon-file-text" /></svg>
                                <span>@EstimateLabels.PrintRepairSpec</span>
                            </a>
                        }
                        @if (estimate is not null && !Model.EditingNewEstimate)
                        {
                            <a class="btn" asp-page="/Cases/Details" asp-route-id="@caseId"
                               asp-route-section="estimate" asp-route-estimate="@estimate.SpecificationId"
                               asp-route-dialog="versions" data-dialog-open="versions-dialog" data-estimate-versions>
                                <svg class="icon" aria-hidden="true"><use href="#icon-history" /></svg>
                                <span>@EstimateLabels.VersionsCount(Model.SelectedEstimateSnapshots.Count)</span>
                            </a>
                        }
                        @if (offersCompare)
                        {
                            <a class="btn" asp-page="/Cases/Details" asp-route-id="@caseId"
                               asp-route-section="estimate" asp-route-estimate="@estimate?.SpecificationId"
                               asp-route-dialog="compare-estimates" data-dialog-open="compare-estimates-dialog" data-estimate-compare>
                                <svg class="icon" aria-hidden="true"><use href="#icon-list" /></svg>
                                <span>@EngineerLabels.Compare</span>
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn" disabled data-estimate-compare>
                                <svg class="icon" aria-hidden="true"><use href="#icon-list" /></svg>
                                <span>@EngineerLabels.Compare</span>
                            </button>
                        }
                    </div>
                </details>
            }
            <button type="button" class="btn btn--small btn--icon" data-estimate-expand
                    title="@EstimateLabels.Expand" aria-label="@EstimateLabels.ExpandEstimate"
                    data-label-expand="@EstimateLabels.Expand" data-label-close="@EstimateLabels.CloseFullScreen">
                <svg class="icon" aria-hidden="true"><use href="#icon-external-link" /></svg>
            </button>
            <partial name="Cases/Shared/_CaseSectionHeadTools" model="headTools" />
        </div>
    </div>
    <div class="panel-body stack">
        @if (glassNoticeText is not null)
        {
            <div class="notice @glassNoticeTone" role="status" data-estimate-notice>
                <svg class="icon" aria-hidden="true"><use href="#icon-info" /></svg>
                <span>@glassNoticeText</span>
                <button type="button" class="dismiss" data-dismiss aria-label="Dismiss"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
            </div>
        }

        @if (Model.Estimates.Count > 0 || Model.EditingNewEstimate)
        {
            <div class="estimate-tabs" role="tablist" aria-label="@EngineerLabels.Estimates" data-estimate-tabs>
                @foreach (var version in Model.Estimates)
                {
                    var isSelected = estimate?.SpecificationId == version.SpecificationId && !Model.EditingNewEstimate;
                    <a class="estimate-tab" role="tab" asp-page="/Cases/Details"
                       asp-route-id="@caseId" asp-route-section="estimate"
                       asp-route-estimate="@version.SpecificationId"
                       aria-selected="@(isSelected ? "true" : "false")"
                       data-estimate-tab="@version.SpecificationId">
                        <span data-estimate-tab-label>@version.Details.Name</span>
                        <span class="src-tag">@RouteTag(version.Source.Route)</span>
                        <span class="status status--plain @StateTone(version.State, version.IsCurrent)">@StateWord(version)</span>
                    </a>
                }
                @if (Model.EditingNewEstimate)
                {
                    <a class="estimate-tab" role="tab" aria-selected="true"
                       asp-page="/Cases/Details" asp-route-id="@caseId"
                       asp-route-section="estimate" asp-route-estimate="new" data-estimate-tab="new">
                        <span>@EngineerLabels.NewEstimate</span>
                        <span class="status status--plain status--amber">@EngineerLabels.EstimateState(RepairSpecificationState.Draft)</span>
                    </a>
                }
            </div>
            @if (estimate is not null && !Model.EditingNewEstimate)
            {
                <p class="muted est-origin" data-estimate-origin>@VersionOrigin(estimate)</p>
            }
        }
        else
        {
            <div class="empty estimate-empty" data-estimate-empty>@EngineerLabels.NoEstimatesRecorded</div>
        }

        @* The Glass's session line: only while this staff member's session holds
           the account or has failed, or while the account is held from
           another Case (v26 § Glass's). *@
        @if (Model.GlassSessionElsewhere is { } elsewhere)
        {
            <div class="glass-session" data-glass-session="elsewhere" data-glass-elsewhere="@elsewhere.Session.CaseId">
                <span class="status status--blue">@GlassLabels.Launch session · @GlassLabels.StateLabel(elsewhere.Session.State)</span>
                <span class="muted grow">@EstimateLabels.HeldFromAnotherCase</span>
                <a class="btn btn--small" asp-page="/Cases/Details" asp-route-id="@elsewhere.Session.CaseId" asp-route-section="estimate">
                    <span>@GlassLabels.OpenOn @elsewhere.CaseReference</span>
                    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
                </a>
            </div>
        }
        else if (showGlassLine && glassSession is not null)
        {
            <div class="glass-session" data-glass-session="@glassSession.State.ToString().ToLowerInvariant()">
                <span class="status @GlassChipTone(glassSession.State)">@GlassLabels.Launch session · @GlassLabels.StateLabel(glassSession.State)</span>
                <span class="muted grow">@EstimateLabels.Started @OperatorLabels.OfficeClock(glassSession.CreatedAtUtc)</span>
                @if (glassSession.FailureCode is { Length: > 0 } glassFailure)
                {
                    <span class="glass-fail" data-glass-failure>@glassFailure</span>
                }
                @if (glassSession.State == GlassRepairEstimateSessionState.AwaitingImport)
                {
                    @* Waiting: the retained result lands as a Draft once the
                       Case's edit authority is back (PendingEstimateSources). *@
                    @if (editing && Model.ImportCondition is null && Model.PendingEstimateSources.Count > 0)
                    {
                        foreach (var source in Model.PendingEstimateSources)
                        {
                            <form method="post" asp-page="/Cases/Details" asp-page-handler="CompleteEstimateImport"
                                  asp-route-id="@caseId" asp-route-section="estimate" data-glass-complete-import>
                                <input type="hidden" name="expectedVersion" value="@caseVersion" />
                                <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                                <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                                <input type="hidden" name="occurrenceId" value="@source.Occurrence.Id" />
                                <input type="hidden" name="documentVersionId" value="@source.Version.Id" />
                                <input type="hidden" name="sha256" value="@source.Version.Sha256" />
                                <button type="submit" class="btn btn--small btn--primary">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                                    <span>@ImportLabels.Complete</span>
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <span class="gated"><svg class="icon" aria-hidden="true"><use href="#icon-lock" /></svg><span>@EstimateLabels.AvailableWhileEditing</span></span>
                    }
                }
                @if (Model.CanCloseGlass)
                {
                    @* The guarded close (FRD-25): a reason, the confirmation
                       that Glass's is closed, one consequence, red Close. Never
                       offered mid-import (Recording). *@
                    <details class="glass-close" data-glass-close>
                        <summary><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>@GlassLabels.Close</summary>
                        <form method="post" asp-page="/Cases/Details" asp-page-handler="CloseGlass"
                              asp-route-id="@caseId" asp-route-section="estimate" class="glass-close-form">
                            <input type="hidden" name="sessionId" value="@glassSession.Id" />
                            <input type="hidden" name="expectedSessionVersion" value="@glassSession.Version" />
                            <div class="fc">
                                <label for="glass-close-reason">@GlassLabels.CloseReason</label>
                                <input id="glass-close-reason" class="fi" name="reason" maxlength="2000" required aria-required="true" />
                            </div>
                            <label class="choice" for="glass-external-closed">
                                <input id="glass-external-closed" type="checkbox" name="externalSessionClosed"
                                       value="true" required aria-required="true" />
                                <span>@GlassLabels.ExternalClosedConfirmation</span>
                            </label>
                            <p class="consequence">@GlassLabels.CloseConsequence</p>
                            <button type="submit" class="btn btn--danger">@GlassLabels.Close</button>
                        </form>
                    </details>
                }
            </div>
        }

        @* A retained source not yet imported (an import whose custody was
           still pending, or a Glass's result held for edit authority) lands
           as a Draft from here; the Waiting line above already offers it
           while the Glass's session is Waiting. *@
        @if (Model.PendingEstimateSources.Count > 0 && glassSession?.State != GlassRepairEstimateSessionState.AwaitingImport)
        {
            <div class="sub-panel" data-estimate-sources>
                <h3>@ImportLabels.Sources</h3>
                <div class="stack">
                    @foreach (var source in Model.PendingEstimateSources)
                    {
                        <div class="cluster">
                            <span class="mono">@source.Version.FileName</span>
                            @if (editing && Model.ImportCondition is null)
                            {
                                <form method="post" asp-page="/Cases/Details" asp-page-handler="CompleteEstimateImport"
                                      asp-route-id="@caseId" asp-route-section="estimate" data-estimate-complete-import>
                                    <input type="hidden" name="expectedVersion" value="@caseVersion" />
                                    <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                                    <input type="hidden" name="occurrenceId" value="@source.Occurrence.Id" />
                                    <input type="hidden" name="documentVersionId" value="@source.Version.Id" />
                                    <input type="hidden" name="sha256" value="@source.Version.Sha256" />
                                    <button type="submit" class="btn btn--small">@ImportLabels.Complete</button>
                                </form>
                            }
                            else
                            {
                                <span class="gated"><svg class="icon" aria-hidden="true"><use href="#icon-lock" /></svg><span>@EstimateLabels.AvailableWhileEditing</span></span>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (editing && estimate is not null && !Model.EditingNewEstimate)
        {
            @* Use repair spec / Duplicate / Discard for the selected version
               (Print Repair Spec sits under More, v28 P9; Use repair spec is
               never gated on the repairer's VAT status, P10). *@
            <div class="est-actions" data-estimate-actions>
                @if (Model.SelectedEstimateCanBeCurrent)
                {
                    <form method="post" asp-page="/Cases/Details" asp-page-handler="SetCurrentEstimate"
                          asp-route-id="@caseId" asp-route-section="estimate">
                        <input type="hidden" name="operationKey" value="@Model.UseEstimateOperationKey" />
                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                        <input type="hidden" name="estimateId" value="@estimate.SpecificationId" />
                        <button type="submit" class="btn btn--small btn--primary" data-estimate-use>
                            <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                            <span>@EngineerLabels.UseEstimate</span>
                        </button>
                    </form>
                }
                @if (Model.SelectedEstimateCanBeDuplicated)
                {
                    <form method="post" asp-page="/Cases/Details" asp-page-handler="DuplicateEstimate"
                          asp-route-id="@caseId" asp-route-section="estimate">
                        <input type="hidden" name="operationKey" value="@Model.DuplicateOperationKey" />
                        <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                        <input type="hidden" name="estimateId" value="@estimate.SpecificationId" />
                        <button type="submit" class="btn btn--small" data-estimate-duplicate>
                            <svg class="icon" aria-hidden="true"><use href="#icon-copy" /></svg>
                            <span>@EngineerLabels.Duplicate</span>
                        </button>
                    </form>
                }
                @if (editable && !estimate.IsCurrent)
                {
                    <a class="btn btn--small btn--danger" asp-page="/Cases/Details"
                       asp-route-id="@caseId" asp-route-section="estimate"
                       asp-route-estimate="@estimate.SpecificationId"
                       asp-route-dialog="delete-estimate" data-dialog-open="delete-estimate-dialog" data-estimate-discard>
                        <svg class="icon" aria-hidden="true"><use href="#icon-trash-2" /></svg>
                        <span>@EstimateLabels.Discard</span>
                    </a>
                }
            </div>
        }

        @if (details is not null && (estimate is not null || Model.EditingNewEstimate))
        {
            @if (editable)
            {
                <form method="post" asp-page="/Cases/Details" asp-page-handler="SaveEstimate"
                      asp-route-id="@caseId" asp-route-section="estimate" id="case-estimate-form" class="stack" data-estimate-form
                      data-line-removed-label="@EstimateLabels.LineRemoved" data-lines-removed-label="@EstimateLabels.LinesRemoved(2).Replace("2 ", string.Empty)">
                    <input type="hidden" name="expectedVersion" value="@caseVersion" />
                    <input type="hidden" name="operationKey" value="@Model.SaveEstimateOperationKey" />
                    <input type="hidden" name="editLeaseToken" value="@Model.LeaseToken" />
                    <input type="hidden" name="estimateId" value="@(estimate?.SpecificationId)" />
                    <div class="est-head">
                        <div class="fg g4">
                            @* The name is edited on its tab by double-click (v28
                               P32); script hides this cell and writes the input. *@
                            <div class="fc" data-estimate-name-cell><label for="estimate-name">@EngineerLabels.EstimateName</label><input id="estimate-name" class="fi" name="estimateName" maxlength="100" required value="@details.Name" /></div>
                            @* One labour rate control (v28 P33): the card chooses the
                               figure, the figure can be typed, typing keeps the entered rate. *@
                            <div class="fc">
                                <label for="estimate-labour-rate">@EngineerLabels.LabourRatePerHour</label>
                                <div class="rate-pair" data-estimate-rate-pair>
                                    <select id="estimate-rate-card" class="fi" name="selectedRateCard" aria-label="@EstimateLabels.LabourRateCard">
                                        <option value="">@EstimateLabels.KeepEnteredRate</option>
                                        @foreach (var card in Model.LabourRateCards.Where(card => card.Enabled))
                                        {
                                            var cardKey = $"{card.Id:D}:{card.Version}";
                                            var selected = Context.Request.HasFormContentType
                                                ? Context.Request.Form["selectedRateCard"] == cardKey
                                                : details.Rate is { RateCardId: { } selectedCardId, RateCardVersion: { } selectedCardVersion }
                                                    && selectedCardId == card.Id && selectedCardVersion == card.Version;
                                            <option value="@cardKey" data-rate="@card.HourlyRate.ToString("0.##", CultureInfo.InvariantCulture)" selected="@(selected ? "selected" : null)">@card.Name — £@card.HourlyRate.ToString("N2", culture)/h</option>
                                        }
                                    </select>
                                    <input id="estimate-labour-rate" class="fi mono" name="estimateLabourRate" type="number" min="0" step="0.01" inputmode="decimal" value="@details.LabourRate" />
                                </div>
                            </div>
                            @* Regional uplift (v28 P17): + 15 % on the rate, suggested
                               from the repairer, claimant and storage postcodes. *@
                            <div class="fc">
                                <label for="estimate-regional-uplift">@EngineerLabels.RegionalUplift</label>
                                <div class="uplift" data-estimate-uplift>
                                    <label class="choice">
                                        <input id="estimate-regional-uplift" type="checkbox" name="estimateRegionalUplift" value="true" checked="@(details.RegionalUplift ? "checked" : null)" />
                                        <input type="hidden" name="estimateRegionalUplift" value="false" />
                                        <span>@EstimateLabels.UpliftPercent</span>
                                    </label>
                                    <span class="src-tag @(upliftSuggestions.Count > 0 ? "src-tag--ai" : null)" data-estimate-uplift-chip>@(upliftSuggestions.Count > 0 ? EstimateLabels.Suggested + " · " + string.Join(", ", upliftSuggestions) : EstimateLabels.LondonAndHomeCounties)</span>
                                </div>
                            </div>
                            <div class="fc"><label for="estimate-other">@EngineerLabels.OtherCostsPounds</label><input id="estimate-other" class="fi mono" name="estimateOtherCosts" type="number" min="0" step="0.01" inputmode="decimal" value="@details.OtherCosts" /></div>
                            <div class="fc"><label for="estimate-vat">@EngineerLabels.VatPercent</label><input id="estimate-vat" class="fi mono" name="estimateVatPercent" type="number" min="0" max="100" step="0.01" inputmode="decimal" value="@details.VatPercent" /></div>
                            <div class="fc">
                                <label for="estimate-vat-status">@VatLabels.RepairerStatus</label>
                                <select id="estimate-vat-status" class="fi" name="estimateVatStatus" data-vat-status>
                                    @foreach (var status in Enum.GetValues<RepairerVatStatus>())
                                    {
                                        <option value="@status" selected="@(vatPolicy.RepairerStatus == status ? "selected" : null)">@VatLabels.StatusLabel(status)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    @* The blank line script keeps at the foot of the grid (v26):
                       cloned from this template, posted with the same names,
                       dropped by the save when it stays blank. *@
                    <template data-estimate-line-template>
                        <tr class="phantom" data-estimate-phantom>
                            <td>
                                <input type="hidden" name="lineId" value="" />
                                <select name="lineOperation" aria-label="@EngineerLabels.Operation">@foreach (var (value, label) in operations) {<option value="@value">@label</option>}</select>
                            </td>
                            <td><input name="lineDescription" placeholder="@EstimateLabels.AddALine" aria-label="@EngineerLabels.Description" /></td>
                            <td><input class="mono" name="linePartNumber" aria-label="@EngineerLabels.PartNumber" /></td>
                            <td><input class="num" name="lineQuantity" type="number" min="1" step="1" inputmode="numeric" aria-label="@EngineerLabels.Quantity" /></td>
                            <td><input class="num" name="linePartPounds" type="number" min="0" step="0.01" inputmode="decimal" aria-label="@EngineerLabels.PartAmount" /></td>
                            <td><input class="num" name="lineLabourHours" type="number" min="0" step="0.1" inputmode="decimal" aria-label="@EngineerLabels.LabourHours" /></td>
                            <td><input class="num" name="linePaintHours" type="number" min="0" step="0.1" inputmode="decimal" aria-label="@EngineerLabels.PaintHours" /></td>
                            <td><input class="num" name="lineMaterials" type="number" min="0" step="0.01" inputmode="decimal" aria-label="@EngineerLabels.MaterialPounds" /></td>
                            <td><span class="src-tag">@EstimateLabels.SourceManual</span></td>
                            <td><button type="submit" class="del" name="removeLine" value="" formaction="@editLineAction" aria-label="@EstimateLabels.RemoveThisLine">×</button></td>
                        </tr>
                    </template>
                    <div class="grid" data-estimate-grid>
                        <table>
                            <thead>
                                <tr>
                                    <th scope="col" class="col-type">@EngineerLabels.Type</th>
                                    <th scope="col">@EngineerLabels.Description</th>
                                    <th scope="col" class="col-part">@EstimateLabels.PartNumberShort</th>
                                    <th scope="col" class="num col-qty">@EngineerLabels.QuantityShort</th>
                                    <th scope="col" class="num col-money">@EstimateLabels.UnitPounds</th>
                                    <th scope="col" class="num col-hours">@EstimateLabels.Hours</th>
                                    <th scope="col" class="num col-hours">@EngineerLabels.PaintHoursShort</th>
                                    <th scope="col" class="num col-money">@EngineerLabels.MaterialPounds</th>
                                    <th scope="col" class="col-source">@EngineerLabels.Source</th>
                                    <th scope="col" class="col-del"><span class="sr-only">@EngineerLabels.Action</span></th>
                                </tr>
                            </thead>
                            <tbody data-estimate-grid-body>
                                @for (var index = 0; index < Model.EditorLines.Count; index++)
                                {
                                    var row = Model.EditorLines[index];
                                    var lineNumber = index + 1;
                                    var origin = row.ExistingLineId is { } lineId && lineOrigins.TryGetValue(lineId, out var recordedLine)
                                        ? LineSource(recordedLine)
                                        : EstimateLabels.SourceManual;
                                    <tr data-estimate-line>
                                        <td>
                                            <input type="hidden" name="lineId" value="@row.ExistingLineId" />
                                            <label class="sr-only" for="line-operation-@index">@EngineerLabels.LineField(EngineerLabels.Operation, lineNumber)</label>
                                            <select id="line-operation-@index" name="lineOperation">
                                                @foreach (var (value, label) in operations)
                                                {
                                                    <option value="@value" selected="@(row.Operation == value ? "selected" : null)">@label</option>
                                                }
                                            </select>
                                        </td>
                                        <td><label class="sr-only" for="line-description-@index">@EngineerLabels.LineField(EngineerLabels.Description, lineNumber)</label><input id="line-description-@index" name="lineDescription" value="@row.Description" /></td>
                                        <td><label class="sr-only" for="line-part-@index">@EngineerLabels.LineField(EngineerLabels.PartNumber, lineNumber)</label><input id="line-part-@index" class="mono" name="linePartNumber" value="@row.PartNumber" /></td>
                                        <td><label class="sr-only" for="line-quantity-@index">@EngineerLabels.LineField(EngineerLabels.Quantity, lineNumber)</label><input id="line-quantity-@index" class="num" name="lineQuantity" type="number" min="1" step="1" inputmode="numeric" value="@row.Quantity" /></td>
                                        <td><label class="sr-only" for="line-pounds-@index">@EngineerLabels.LineField(EngineerLabels.PartAmount, lineNumber)</label><input id="line-pounds-@index" class="num @OffPatternClass(lineNumber, "linePartPounds")" name="linePartPounds" type="number" min="0" step="0.01" inputmode="decimal" value="@row.PartPounds" title="@OffPatternLabel(lineNumber, "linePartPounds")" /></td>
                                        <td><label class="sr-only" for="line-labour-@index">@EngineerLabels.LineField(EngineerLabels.LabourHours, lineNumber)</label><input id="line-labour-@index" class="num @OffPatternClass(lineNumber, "lineLabourHours")" name="lineLabourHours" type="number" min="0" step="0.1" inputmode="decimal" value="@row.LabourHours" title="@OffPatternLabel(lineNumber, "lineLabourHours")" /></td>
                                        <td><label class="sr-only" for="line-paint-@index">@EngineerLabels.LineField(EngineerLabels.PaintHours, lineNumber)</label><input id="line-paint-@index" class="num @OffPatternClass(lineNumber, "linePaintHours")" name="linePaintHours" type="number" min="0" step="0.1" inputmode="decimal" value="@row.PaintHours" title="@OffPatternLabel(lineNumber, "linePaintHours")" /></td>
                                        <td><label class="sr-only" for="line-materials-@index">@EngineerLabels.LineField(EngineerLabels.MaterialPounds, lineNumber)</label><input id="line-materials-@index" class="num" name="lineMaterials" type="number" min="0" step="0.01" inputmode="decimal" value="@row.Materials" /></td>
                                        <td><span class="src-tag @(origin == EstimateLabels.SourceAmended ? "src-tag--ai" : null)">@origin</span></td>
                                        <td><button type="submit" class="del" name="removeLine" value="@index" formaction="@editLineAction" aria-label="@EngineerLabels.RemoveLine(lineNumber)">×</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="cluster est-add-line">
                        <button type="submit" class="btn btn--small btn--danger" name="clearLines" value="true" formaction="@editLineAction" data-estimate-delete-all data-undo-label="@EstimateLabels.Undo">
                            <svg class="icon" aria-hidden="true"><use href="#icon-trash-2" /></svg>
                            <span>@EngineerLabels.DeleteAllLines</span>
                        </button>
                        <button type="submit" class="btn btn--small" name="addLine" value="true" formaction="@editLineAction" data-estimate-add-line>
                            <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                            <span>@EngineerLabels.AddLine</span>
                        </button>
                    </div>
                    @if (estimate is not null && !Model.EditingNewEstimate)
                    {
                        @* Target % of value (v28 P34): one factor lowers prices,
                           materials and the rate to their floors; hours never
                           move. Apply saves the editor and scales the saved
                           spec; Core writes the authoritative result. *@
                        <div class="bar est-scale" data-estimate-scale>
                            <span class="bl">@EstimateLabels.TargetPercentOfValue</span>
                            @if (scaled)
                            {
                                <span class="status status--amber status--plain" data-estimate-scaled>@EstimateLabels.Scaled</span>
                            }
                            @if (engineerValue is null)
                            {
                                <span class="muted">@CaseWorkspaceLabels.Settlement.ApplyInValuation</span>
                            }
                            else
                            {
                                <input type="range" min="1" max="100" step="1" value="100" aria-label="@EstimateLabels.TargetPercentOfValue" data-scale-range />
                                <span class="dsc"><input type="number" name="targetPercent" min="1" max="100" step="0.1" value="100" inputmode="decimal" aria-label="@EstimateLabels.TargetPercentOfValue" data-scale-percent /><label>%</label></span>
                            }
                            <span class="est-floors">@EstimateLabels.Floors
                                <span class="dsc"><label for="estimate-floor-rate">@EstimateLabels.FloorLabour</label><input id="estimate-floor-rate" name="floorRate" type="number" min="0" step="1" inputmode="decimal" value="@ScalingFloors.Default.LabourRatePerHour.ToString("0.##", CultureInfo.InvariantCulture)" data-scale-floor-rate /></span>
                                <span class="dsc"><label for="estimate-floor-price">@EstimateLabels.FloorPrices</label><input id="estimate-floor-price" name="floorPrice" type="number" min="0" max="100" step="5" inputmode="decimal" value="@ScalingFloors.Default.PricePercent.ToString("0.##", CultureInfo.InvariantCulture)" data-scale-floor-price /></span>
                            </span>
                            @if (outcomeIsContract && contractSum is { } targetSum && Math.Abs(printed.Gross - targetSum) > 0.5m)
                            {
                                <input type="hidden" name="contractTarget" value="true" />
                            }
                            @if (engineerValue is not null)
                            {
                                <button type="submit" class="btn btn--small btn--primary" formaction="@Url.Page("/Cases/Details", "ScaleEstimate", new { id = caseId, section = "estimate" })" data-scale-apply><span>@EstimateLabels.Apply</span></button>
                            }
                            <button type="submit" class="btn btn--small" formaction="@Url.Page("/Cases/Details", "RemoveEstimateScaling", new { id = caseId, section = "estimate" })" formnovalidate data-scale-remove disabled="@(scaled ? null : "disabled")"><span>@EstimateLabels.RemoveScaling</span></button>
                        </div>
                        @* Contract repair (v28 P35): the agreed sum is Case data
                           saved with the page-wide Save; ticking sets the outcome
                           in Decisions and seeds the sum from the specification. *@
                        <div class="bar est-contract" data-estimate-contract data-estimate-outcome-control="f-assessment-outcome" data-estimate-contract-sum-control="f-settlement-contract-sum">
                            <span class="bl">@EstimateLabels.ContractRepair</span>
                            <label class="choice"><input type="checkbox" checked="@(outcomeIsContract ? "checked" : null)" data-contract-agreed /><span>@EstimateLabels.ContractRepairAgreed</span></label>
                            <span class="dsc"><span class="lbl">@EstimateLabels.AgreedTotalSum</span><b class="mono" data-contract-sum-read>@(contractSum is { } shown ? Money(shown) : OperatorLabels.CaseWorkspace.AbsentValue)</b></span>
                            @if (outcomeIsContract && contractSum is { } agreed && Math.Abs(printed.Gross - agreed) > 0.5m)
                            {
                                <span class="status status--amber status--plain" data-contract-mismatch>@(printed.Gross > agreed ? EstimateLabels.SpecAboveAgreed(Money(printed.Gross)) : EstimateLabels.SpecBelowAgreed(Money(printed.Gross)))</span>
                            }
                            @if (outcomeIsContract && contractSum is { } sentenceSum)
                            {
                                <div class="fc ro est-contract-sentence"><span class="lbl">@EstimateLabels.ContractRepair</span><div class="fv derived" data-contract-sentence>@RepairSpecificationWording.ContractRepair(sentenceSum)</div></div>
                            }
                        </div>
                    }
                    <div class="bar" data-estimate-discounts>
                        <span class="bl">@EstimateLabels.DiscountsPercent</span>
                        <span class="dsc"><label for="estimate-discount-parts">@EngineerLabels.Parts</label><input id="estimate-discount-parts" name="estimateDiscountParts" type="number" min="0" max="100" step="0.01" inputmode="decimal" value="@DiscountLabels.PercentValue(discounts.Parts)" /></span>
                        <span class="dsc"><label for="estimate-discount-materials">@TotalsLabels.Materials</label><input id="estimate-discount-materials" name="estimateDiscountMaterials" type="number" min="0" max="100" step="0.01" inputmode="decimal" value="@DiscountLabels.PercentValue(discounts.Materials)" /></span>
                        <span class="dsc"><label for="estimate-discount-specialist">@TotalsLabels.Specialist</label><input id="estimate-discount-specialist" name="estimateDiscountSpecialist" type="number" min="0" max="100" step="0.01" inputmode="decimal" value="@DiscountLabels.PercentValue(discounts.Specialist)" /></span>
                        <span class="dsc"><label for="estimate-discount-overall">@EstimateLabels.Overall</label><input id="estimate-discount-overall" name="estimateDiscountOverall" type="number" min="0" max="100" step="0.01" inputmode="decimal" value="@DiscountLabels.PercentValue(discounts.Overall)" /></span>
                    </div>
                    <div class="bar" data-estimate-vat>
                        <span class="bl">@VatLabels.ChargedOn</span>
                        @foreach (var category in VatLabels.Categories)
                        {
                            var field = Pegasus.Web.Pages.Cases.DetailsModel.VatCategoryField(category);
                            <label class="choice">
                                <input id="@field" name="@field" type="checkbox" value="true" data-vat-category="@category"
                                       checked="@(vatPolicy.Charges(category) ? "checked" : null)" />
                                <input type="hidden" name="@field" value="false" />
                                <span>@VatLabels.CategoryLabel(category)</span>
                            </label>
                        }
                        <span class="status status--amber status--plain" data-vat-overridden hidden="@(vatOverridden ? null : "hidden")">@EstimateLabels.Overridden</span>
                        <button type="button" class="btn btn--small vat-reset" data-vat-reset hidden="@(vatOverridden ? null : "hidden")">@EstimateLabels.ResetToRepairerStatus</button>
                    </div>
                    @if (others.Length > 0 && estimate is not null && !Model.EditingNewEstimate)
                    {
                        var supplementary = estimate.Supplementary;
                        <div class="sub-panel" data-estimate-supplementary>
                            <h3>@EstimateLabels.Supplementary</h3>
                            <div class="fg g4">
                                <div class="fc">
                                    <label for="estimate-supplementary-of">@EstimateLabels.ChangesVs</label>
                                    <select id="estimate-supplementary-of" class="fi" name="supplementaryOf">
                                        <option value="" selected="@(supplementary is null ? "selected" : null)">@EstimateLabels.Choose</option>
                                        @foreach (var other in others)
                                        {
                                            <option value="@other.SpecificationId" selected="@(supplementary?.OfSpecificationId == other.SpecificationId ? "selected" : null)">@other.Details.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="fc">
                                    <label for="estimate-supplementary-reason">@EngineerLabels.Reason</label>
                                    <select id="estimate-supplementary-reason" class="fi" name="supplementaryReason">
                                        @foreach (var (code, label, _) in RepairSpecificationComparison.SupplementaryReasons)
                                        {
                                            <option value="@code" selected="@(supplementary?.Reason == code ? "selected" : null)">@label</option>
                                        }
                                    </select>
                                </div>
                                <div class="fc">
                                    <span class="lbl">@EngineerLabels.Report</span>
                                    <label class="choice"><input type="checkbox" name="supplementaryExplain" value="true" checked="@(supplementary?.ExplainOnReport == true ? "checked" : null)" /><input type="hidden" name="supplementaryExplain" value="false" /><span>@EstimateLabels.ExplainOnReport</span></label>
                                </div>
                            </div>
                            @if (supplementary is not null && Model.SupplementaryDiff is { } diff)
                            {
                                <partial name="Cases/Shared/_RepairSpecDiff" model="diff" />
                                <div class="fc ro"><span class="lbl">@EstimateLabels.SupplementaryDamage</span><div class="fv derived multi" data-supplementary-statement>@supplementary.Statement</div></div>
                            }
                        </div>
                    }
                    @{ RenderBottom(Model.EditorLines.Select(row => (row.Operation, row.Description ?? string.Empty)).ToArray(), printed, totals, vatChargedOn, discounts, estimate?.IsCurrent == true); }
                    <div class="button-row">
                        <button type="submit" class="btn btn--primary" data-estimate-save>
                            <svg class="icon" aria-hidden="true"><use href="#icon-save" /></svg>
                            <span>@EngineerLabels.SaveEstimate</span>
                        </button>
                    </div>
                </form>
            }
            else
            {
                @* Read mode (v26): one summary line instead of eight header
                   fields; the lines read-only in the same grid. *@
                <div class="est-head">
                    <div class="est-head-read" data-estimate-summary>
                        <span>@EngineerLabels.Labour <b>@(details.LabourRate is { } labourRate ? Money(details.HourlyRate) + "/h" : "—")</b>@(rateCardName is null ? null : " · " + rateCardName)@(details.RegionalUplift ? " · " + EngineerLabels.RegionalUplift + " " + EstimateLabels.UpliftPercent : null)</span>
                        <span>@EngineerLabels.OtherCosts <b>@MoneyOrAbsent(details.OtherCosts)</b></span>
                        <span>@EngineerLabels.Vat <b>@totals.VatPercent.ToString("0.##", CultureInfo.InvariantCulture) %</b></span>
                        <span>@VatLabels.RepairerStatus <b>@VatLabels.StatusLabel(vatPolicy.RepairerStatus)</b></span>
                    </div>
                </div>
                <div class="grid" data-estimate-grid>
                    <table>
                        <thead>
                            <tr>
                                <th scope="col" class="col-type">@EngineerLabels.Type</th>
                                <th scope="col">@EngineerLabels.Description</th>
                                <th scope="col" class="col-part">@EstimateLabels.PartNumberShort</th>
                                <th scope="col" class="num col-qty">@EngineerLabels.QuantityShort</th>
                                <th scope="col" class="num col-money">@EstimateLabels.UnitPounds</th>
                                <th scope="col" class="num col-hours">@EstimateLabels.Hours</th>
                                <th scope="col" class="num col-hours">@EngineerLabels.PaintHoursShort</th>
                                <th scope="col" class="num col-money">@EngineerLabels.MaterialPounds</th>
                                <th scope="col" class="col-source">@EngineerLabels.Source</th>
                            </tr>
                        </thead>
                        <tbody data-estimate-grid-body>
                            @if (readLines.Length == 0)
                            {
                                <tr><td colspan="9" class="muted">@EngineerLabels.NoneRecorded</td></tr>
                            }
                            @foreach (var line in readLines)
                            {
                                var source = LineSource(line);
                                <tr data-estimate-line>
                                    <td>@OperatorLabels.EstimateLineType(line.Type)</td>
                                    <td>@(line.Description ?? string.Empty)</td>
                                    <td class="mono">@(line.PartNumber ?? "—")</td>
                                    <td class="num">@(line.Quantity?.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
                                    <td class="num mono">@(line.Price is { } price ? Money(price) : line.Unpriced ? EngineerLabels.ToBeConfirmed : "—")</td>
                                    <td class="num mono">@(line.WorkUnits is { } workUnits ? workUnits.ToString("0.0", CultureInfo.InvariantCulture) : "—")</td>
                                    <td class="num mono">@(line.PaintWorkUnits is { } paintUnits ? paintUnits.ToString("0.0", CultureInfo.InvariantCulture) : "—")</td>
                                    <td class="num mono">@(line.Materials is { } lineMaterials ? Money(lineMaterials) : "—")</td>
                                    <td><span class="src-tag @(source == EstimateLabels.SourceAmended ? "src-tag--ai" : null)">@source</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (discounts != EstimateDiscounts.None)
                {
                    <div class="bar" data-estimate-discounts>
                        <span class="bl">@EstimateLabels.DiscountsPercent</span>
                        <span class="dsc">@EngineerLabels.Parts <b class="mono">@DiscountLabels.Value(discounts.Parts)</b></span>
                        <span class="dsc">@TotalsLabels.Materials <b class="mono">@DiscountLabels.Value(discounts.Materials)</b></span>
                        <span class="dsc">@TotalsLabels.Specialist <b class="mono">@DiscountLabels.Value(discounts.Specialist)</b></span>
                        <span class="dsc">@EstimateLabels.Overall <b class="mono">@DiscountLabels.Value(discounts.Overall)</b></span>
                    </div>
                }
                <div class="bar" data-estimate-vat>
                    <span class="bl">@VatLabels.ChargedOn</span>
                    <span>@VatLabels.ChargedLabel(vatPolicy)</span>
                    @if (vatOverridden)
                    {
                        <span class="status status--amber status--plain" data-vat-overridden>@EstimateLabels.Overridden</span>
                    }
                </div>
                @if (outcomeIsContract && contractSum is { } readSum)
                {
                    <div class="fc ro"><span class="lbl">@EstimateLabels.ContractRepair</span><div class="fv derived" data-contract-sentence>@RepairSpecificationWording.ContractRepair(readSum)</div></div>
                }
                @if (estimate?.Supplementary is { } readSupplementary && Model.SupplementaryDiff is { } readDiff)
                {
                    <div class="sub-panel" data-estimate-supplementary>
                        <h3>@EstimateLabels.Supplementary</h3>
                        <p class="muted">@EstimateLabels.ChangesVs @(Model.SupplementaryBase?.Details.Name)</p>
                        <partial name="Cases/Shared/_RepairSpecDiff" model="readDiff" />
                        @if (readSupplementary.ExplainOnReport)
                        {
                            <div class="fc ro"><span class="lbl">@EstimateLabels.SupplementaryDamage</span><div class="fv derived multi" data-supplementary-statement>@readSupplementary.Statement</div></div>
                        }
                    </div>
                }
                RenderBottom(readLines.Select(line => (OperationOf(line.Type), line.Description ?? string.Empty)).ToArray(), printed, totals, vatChargedOn, discounts, estimate?.IsCurrent == true);
            }
        }
    </div>
</section>

