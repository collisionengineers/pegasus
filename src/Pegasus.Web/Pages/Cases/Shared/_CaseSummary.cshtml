@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Web.Presentation
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var summary = details.Summary;
    var data = details.Data;

    string Value(string? text) => string.IsNullOrWhiteSpace(text) ? "Not recorded" : text;
    var vehicle = string.Join(
        " ",
        new[] { data?.Vehicle.Make.Confirmed?.Value, data?.Vehicle.Model.Confirmed?.Value }
            .Where(part => !string.IsNullOrWhiteSpace(part)));
    var registration = Value(data?.Vehicle.Registration.Confirmed?.Value ?? summary.Registration);
}

@* The one place the case's facts are read: the work the case is, the parties
   it involves, and the accident it is about. Values only — where a value came
   from is carried by the case data projection and is not restated here. *@
<section class="panel case-overview-panel" aria-labelledby="case-overview-title">
    <div class="panel-head"><h2 id="case-overview-title">Case overview</h2></div>
    <div class="panel-body">
        <div class="case-overview-grid">
            <section aria-labelledby="case-overview-work">
                <h3 id="case-overview-work">Work</h3>
                <div class="overview-facts">
                    <dl><dt>Case type</dt><dd>@OperatorLabels.CaseTypeName(summary.CaseType)</dd></dl>
                    <dl><dt>Provider reference</dt><dd>@Value(data?.Claim.Number.Confirmed?.Value ?? summary.ClaimNumber)</dd></dl>
                    <dl><dt>Inspection</dt><dd>@Value(data?.Inspection.Address.Confirmed?.Value)</dd></dl>
                    <dl><dt>Engineer</dt><dd>@(Model.EngineerDisplayName ?? "Unassigned")</dd></dl>
                    <dl><dt>@OperatorLabels.CaseWorkspace.SignOffEngineer</dt><dd>@Model.SignOffEngineerDisplayName</dd></dl>
                    <dl><dt>Received</dt><dd>@OperatorLabels.OfficeTime(summary.ReceivedAtUtc)</dd></dl>
                    <dl><dt>Due</dt><dd>@(workflow.DueWork?.DueBy?.ToString("d MMM yyyy") ?? "Not recorded")</dd></dl>
                    @if (workflow.ReportSentEvidence is { } sentEvidence)
                    {
                        @* Inherited scope (PLAT-015): the mailbox address and the
                           authoritative time, never the retained identifiers or
                           digests the evidence record also carries. *@
                        <dl><dt>Report sent</dt><dd>@sentEvidence.MailboxIdentity · @OperatorLabels.OfficeTime(sentEvidence.SentAtUtc)</dd></dl>
                    }
                </div>
            </section>
            <section aria-labelledby="case-overview-parties">
                <h3 id="case-overview-parties">Parties</h3>
                <div class="overview-facts">
                    <dl><dt>Principal</dt><dd>@workflow.Identity.PrincipalCode</dd></dl>
                    <dl><dt>Claimant</dt><dd>@Value(data?.Claimant.Name.Confirmed?.Value ?? summary.Claimant)</dd></dl>
                    <dl><dt>Repairer / holder</dt><dd>Not recorded</dd></dl>
                    <dl><dt>Intermediary</dt><dd>Not recorded</dd></dl>
                    <dl><dt>Origin</dt><dd>@OperatorLabels.SourceChannel(summary.Origin)</dd></dl>
                </div>
            </section>
        </div>
        <section class="accident-card" aria-labelledby="case-accident-title">
            <div class="accident-card-title">
                <svg class="icon" aria-hidden="true"><use href="#icon-file-text" /></svg>
                <h3 id="case-accident-title">Accident circumstances</h3>
            </div>
            <p>@Value(data?.Accident.Circumstances.Confirmed?.Value)</p>
            <div class="accident-meta">
                <span><b>Incident detail</b>@(data?.Accident.IncidentDate.Confirmed?.Value.ToString("d MMM yyyy") ?? "Not recorded")</span>
                <span><b>Vehicle</b>@(vehicle.Length > 0 ? $"{registration} · {vehicle}" : registration)</span>
            </div>
        </section>
    </div>
</section>
