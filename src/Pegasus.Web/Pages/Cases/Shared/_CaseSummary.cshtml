@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Web.Presentation
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var summary = details.Summary;
    var data = details.Data;

    string Value(string? text) => string.IsNullOrWhiteSpace(text) ? "Not recorded" : text;
}

@* The one place the case's facts are read: the work the case is, the parties
   it involves, and the accident it is about. Values only — where a value came
   from is carried by the case data projection and is not restated here. *@
<section class="panel case-overview-panel" aria-labelledby="case-overview-title">
    <div class="panel-head"><h2 id="case-overview-title">Case overview</h2></div>
    <div class="panel-body">
        <div class="case-overview-grid">
            <section class="case-overview-group case-overview-group--case" aria-labelledby="case-overview-case">
                <h3 id="case-overview-case">Case</h3>
                <div class="overview-facts">
                    <dl><dt>Case type</dt><dd>@OperatorLabels.CaseTypeName(summary.CaseType)</dd></dl>
                    <dl><dt>Our ref</dt><dd>@workflow.Identity.Reference</dd></dl>
                    <dl><dt>Claim reference</dt><dd>@Value(Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Claim.Number)?.Value ?? (data is null ? summary.ClaimNumber : null))</dd></dl>
                    <dl><dt>Incident date</dt><dd>@Value(Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Accident.IncidentDate)?.Value.ToString("d MMM yyyy"))</dd></dl>
                    <dl><dt>Engineer</dt><dd>@(Model.EngineerDisplayName ?? "Unassigned")</dd></dl>
                    <dl><dt>@OperatorLabels.CaseWorkspace.SignOffEngineer</dt><dd>@Model.SignOffEngineerDisplayName</dd></dl>
                    <dl><dt>Received</dt><dd>@OperatorLabels.OfficeTime(summary.ReceivedAtUtc)</dd></dl>
                    <dl><dt>Due</dt><dd>@(workflow.DueWork?.DueBy?.ToString("d MMM yyyy") ?? "Not recorded")</dd></dl>
                    @if (workflow.ReportSentEvidence is { } sentEvidence)
                    {
                        @* Inherited scope (PLAT-015): the mailbox address and the
                           authoritative time, never the retained identifiers or
                           digests the evidence record also carries. *@
                        <dl><dt>Report sent</dt><dd>@sentEvidence.MailboxIdentity · @OperatorLabels.OfficeTime(sentEvidence.SentAtUtc)</dd></dl>
                    }
                </div>
            </section>
            <section class="case-overview-group case-overview-group--principal" aria-labelledby="case-overview-principal">
                <h3 id="case-overview-principal">Principal</h3>
                <div class="overview-facts">
                    <dl><dt>Principal</dt><dd>@workflow.Identity.PrincipalCode</dd></dl>
                    <dl><dt>Claim source</dt><dd>@Value(data?.Workspace?.ClaimSource?.Name)</dd></dl>
                    <dl><dt>Claim source contact</dt><dd>@Value(data?.Workspace?.ClaimSource?.ContactName)</dd></dl>
                </div>
            </section>
            <section class="case-overview-group case-overview-group--claimant" aria-labelledby="case-overview-claimant">
                <h3 id="case-overview-claimant">Claimant</h3>
                <div class="overview-facts">
                    <dl><dt>Claimant</dt><dd>@Value(Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Claimant.Name)?.Value ?? (data is null ? summary.Claimant : null))</dd></dl>
                    <dl><dt>Contact</dt><dd>@Value(Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Contact.Name)?.Value)</dd></dl>
                    <dl><dt>@OperatorLabels.CaseWorkspace.Repairer</dt><dd>@Value(Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Inspection.RepairerName)?.Value)</dd></dl>
                    <dl><dt>@OperatorLabels.CaseWorkspace.RepairerLocation</dt><dd>@Value(Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Inspection.RepairerAddress)?.Value)</dd></dl>
                </div>
            </section>
        </div>
        <section class="accident-card case-overview-accident" aria-labelledby="case-accident-title">
            <div class="accident-card-title">
                <svg class="icon" aria-hidden="true"><use href="#icon-file-text" /></svg>
                <h3 id="case-accident-title">Accident circumstances</h3>
            </div>
            <p>@Value(Pegasus.Web.Pages.Cases.DetailsModel.Accepted(data?.Accident.Circumstances)?.Value)</p>
        </section>
    </div>
</section>
