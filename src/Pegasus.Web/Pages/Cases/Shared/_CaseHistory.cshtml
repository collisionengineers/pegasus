@model Pegasus.Web.Pages.Cases.DetailsModel
@{
    var details = Model.Case!;
}

<section class="panel" aria-labelledby="case-history-title">
    <h2 id="case-history-title" class="section-label">Case history</h2>
    @if (details.History.Count == 0)
    {
        <p class="empty-state">No case workflow events are recorded.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>When</th><th>Event</th><th>Actor</th><th>Reason</th></tr></thead>
                <tbody>
                @foreach (var entry in details.History)
                {
                    <tr>
                        <td>@OperatorLabels.OfficeTime(entry.OccurredAtUtc)</td>
                        <td>@Pegasus.Web.Presentation.OperatorLabels.HistoryEvent(entry.EventType)</td>
                        <td>
                            @if (entry.ActorKind == nameof(Pegasus.Core.Identity.ActorKind.Automation))
                            {
                                <span class="status-chip status-chip--review">@entry.ActorDisplayName</span>
                            }
                            else
                            {
                                @entry.ActorDisplayName
                            }
                        </td>
                        <td>@entry.Reason</td>
                        
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
