@*
    Notes (v26, v53): the Case note form at the top, Record chase beside it,
    then two tabs drawn with one row. Notes is what was written about the
    Case; History is everything else Pegasus recorded. Each shows 50 entries
    at a time under a heading for each day (operator, 25 November 2026,
    R1253 to R1260). The tabs are the Files section's: every panel is in the
    page and the shell's tab script shows one. Tasks are the Actions menu's
    Tasks dialog (CASE-20). A note takes no edit lease; a chase carries the
    lease and is offered while a chase is scheduled.
*@
@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Cases
@using Pegasus.Core.Identity
@using Pegasus.Web.Presentation
@using Frame = Pegasus.Web.Presentation.CaseWorkspaceLabels.Frame
@using NotesLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.Notes
@{
    var section = Model.NotesSection;
    var workflow = section?.Frame.Workflow ?? Model.Case!.Workflow;
    var leaseToken = Model.RenderLeaseToken;
    var mayEdit = Model.CanEditCaseData;
    var notes = section?.Notes ?? CaseTimelinePage.Empty;
    var history = section?.History ?? CaseTimelinePage.Empty;
    var offersNote = workflow.Archive is null;
    var offersChase = mayEdit && workflow.DueWork is { State: Pegasus.Core.Tasks.CaseDueWorkState.Scheduled };

    // A page of one tab keeps the other tab's page, and names its tab in the # part.
    string? PageHref(string tab, int page)
    {
        var notesPage = tab == NotesLabels.NotesKey ? page : notes.Page;
        var historyPage = tab == NotesLabels.HistoryKey ? page : history.Page;
        return Url.Page(
            "/Cases/Details",
            pageHandler: null,
            values: new
            {
                id = workflow.CaseId,
                section = "notes",
                view = Model.ViewRoute,
                notesPage = notesPage > 1 ? notesPage : (int?)null,
                historyPage = historyPage > 1 ? historyPage : (int?)null
            },
            protocol: null,
            host: null,
            fragment: NotesLabels.HashPrefix + tab);
    }

    void Who(string name, bool automation)
    {
        <span class="note-actor"><b>@name</b>@if (automation) { <text> @OperatorLabels.SourceTagWord.Ai.Render()</text> }</span>
    }

    // The one row of both tabs: the time, who, then the words. A note's words
    // sit under its author; an entry's label and reason sit beside the actor.
    void Entry(CaseHistoryEntry entry)
    {
        var clock = OperatorLabels.OfficeClock(entry.OccurredAtUtc);
        var automation = entry.ActorKind == nameof(ActorKind.Automation);
        if (entry.EventType == AddCaseNote.EventType)
        {
            <div class="note" data-history-event="@entry.EventType">
                <span class="nw">@clock</span>
                <div class="nb">@{ Who(entry.ActorDisplayName, automation); }<div class="note-text">@entry.Reason</div></div>
            </div>
            return;
        }
        if (entry.EventType != "case_guidance_applied")
        {
            // An Original report entry is its reason alone (R295).
            var words = entry.EventType == "original_report_recorded"
                ? entry.Reason
                : NotesLabels.Words(OperatorLabels.HistoryEvent(entry.EventType), entry.Reason);
            <div class="note sys" data-history-event="@entry.EventType">
                <span class="nw">@clock</span>
                <div class="nb">@{ Who(entry.ActorDisplayName, automation); } — @words</div>
            </div>
        }
        foreach (var guidance in entry.Guidance)
        {
            <div class="note sys" data-history-event="@guidance.EventType">
                <span class="nw">@clock</span>
                <div class="nb"><b>@guidance.OrganizationName</b> — @OperatorLabels.HistoryEvent(guidance.EventType) — @guidance.Text</div>
            </div>
        }
    }

    void Panel(string tab, string title, string empty, CaseTimelinePage shown)
    {
        <div id="@(NotesLabels.HashPrefix + tab)" role="tabpanel" data-file-tab-panel="@tab" data-notes-total="@shown.Total">
            <h3 class="tab-panel-title">@title</h3>
            @if (shown.Items.Count == 0)
            {
                @* One empty state across the page: a muted sentence in a row (v36 f46). *@
                <p class="empty-line" data-notes-empty="@tab">@empty</p>
            }
            else
            {
                <div class="notes-timeline" data-case-history="@tab">
                    @foreach (var day in shown.Items.GroupBy(entry => OperatorLabels.OfficeDate(entry.OccurredAtUtc)))
                    {
                        <div class="notes-day">
                            <h4 class="notes-day-title">@day.Key</h4>
                            @foreach (var entry in day)
                            {
                                Entry(entry);
                            }
                        </div>
                    }
                </div>
            }
            @if (shown.PageCount > 1)
            {
                <nav class="pagination" aria-label="@NotesLabels.Pages(title)" data-notes-pager="@tab">
                    <span>@NotesLabels.Range(shown)</span>
                    <div class="button-row">
                        @if (shown.Page > 1)
                        {
                            <a class="btn btn--small" href="@PageHref(tab, shown.Page - 1)" data-notes-page>@NotesLabels.Newer</a>
                        }
                        @if (shown.Page < shown.PageCount)
                        {
                            <a class="btn btn--small" href="@PageHref(tab, shown.Page + 1)" data-notes-page>@NotesLabels.Older</a>
                        }
                    </div>
                </nav>
            }
        </div>
    }
}

<section class="record-section panel @Model.CollapsedClass("case.notes") @(Model.IsEditing && !Model.SectionIsEditable("notes") ? "is-locked" : null)" id="section-notes" data-section="notes" data-collapse="case.notes" aria-labelledby="section-notes-title">
    <div class="panel-head">
        <h2 id="section-notes-title">Notes</h2>
        <div class="panel-actions">
            <partial name="Cases/Shared/_CaseSectionHeadTools" model='new Pegasus.Web.Pages.Cases.CaseSectionHeadView(Model, "notes")' />
        </div>
    </div>
    <div class="panel-body stack">
        @if (offersNote)
        {
            <form method="post" asp-page="/Cases/Tasks" asp-route-id="@workflow.CaseId"
                  asp-page-handler="AddNote" class="note-form" data-case-note-form>
                <input type="hidden" name="id" value="@workflow.CaseId" />
                <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                <input type="hidden" name="view" value="@Model.ViewRoute" />
                <label class="lbl" for="case-note">Case note</label>
                <textarea id="case-note" name="note" rows="2" required
                          maxlength="@Pegasus.Core.Cases.AddCaseNote.MaximumLength"></textarea>
                <div class="button-row">
                    @* A secondary button: Files' Add evidence is the one red primary on this screen (v36 item Q, 9 October 2026). *@
                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Adding" class="btn">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-plus")" /></svg>
                        <span>Add Case note</span>
                    </button>
                    @if (offersChase)
                    {
                        <button type="button" class="btn" data-dialog-open="case-chase-dialog">
                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-clock")" /></svg>
                            <span>@CaseWorkspaceLabels.Chase.RecordChase</span>
                        </button>
                    }
                </div>
            </form>
        }

        <div class="notes-tabs" data-file-tabs-wrap data-file-tabs-hash="@NotesLabels.HashPrefix" data-case-notes-tabs>
            <div class="tabs" role="tablist" aria-label="@NotesLabels.NotesTab" data-file-tabs hidden>
                <button type="button" class="tab" role="tab" aria-selected="true" aria-controls="@(NotesLabels.HashPrefix + NotesLabels.NotesKey)" data-file-tab="@NotesLabels.NotesKey">@NotesLabels.NotesTab · @notes.Total</button>
                <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="@(NotesLabels.HashPrefix + NotesLabels.HistoryKey)" data-file-tab="@NotesLabels.HistoryKey">@NotesLabels.HistoryTab · @history.Total</button>
            </div>
            @{
                Panel(NotesLabels.NotesKey, NotesLabels.NotesTab, NotesLabels.NoNotes, notes);
                Panel(NotesLabels.HistoryKey, NotesLabels.HistoryTab, NotesLabels.NoHistory, history);
            }
        </div>
    </div>
</section>

@if (offersChase)
{
    @* A recorded chase is an attributable manual assertion; it does not
       send correspondence. *@
    <div id="case-chase-dialog" class="dialog-backdrop" data-dialog="case-chase-dialog" hidden>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="case-chase-dialog-title">
            <div class="dialog-head">
                <h2 id="case-chase-dialog-title" tabindex="-1">@CaseWorkspaceLabels.Chase.RecordChase</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                </button>
            </div>
            <form method="post" asp-page="/Cases/Tasks" asp-route-id="@workflow.CaseId" asp-page-handler="RecordManualChase">
                <input type="hidden" name="id" value="@workflow.CaseId" />
                <input type="hidden" name="expectedVersion" value="@workflow.Version" />
                <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.Cases.CaseMutationPageModel.NewOperationKey()" />
                <input type="hidden" name="editLeaseToken" value="@leaseToken" />
                <input type="hidden" name="view" value="@Model.ViewRoute" />
                <div class="dialog-body stack">
                    <div class="form-grid form-grid--2">
                        <div class="field"><label class="req" for="chase-recipient">@CaseWorkspaceLabels.Chase.Recipient</label><input id="chase-recipient" name="recipient" required maxlength="500" data-dialog-initial-focus /></div>
                        <div class="field"><label class="req" for="chase-channel">Channel</label><input id="chase-channel" name="channel" required maxlength="100" /></div>
                        <div class="field"><label for="chase-content">@CaseWorkspaceLabels.Chase.Content</label><input id="chase-content" name="content" maxlength="1000" /></div>
                        <div class="field"><label class="req" for="chase-outcome">Outcome</label><input id="chase-outcome" name="outcome" required maxlength="500" /></div>
                    </div>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>Cancel</button>
                    <button type="submit" data-busy-label="@OperatorLabels.Busy.Recording" class="btn btn--primary">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-send")" /></svg>
                        <span>@CaseWorkspaceLabels.Chase.RecordChase</span>
                    </button>
                </div>
            </form>
        </section>
    </div>
}
