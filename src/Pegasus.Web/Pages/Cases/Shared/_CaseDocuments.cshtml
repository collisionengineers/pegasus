@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Documents
@using Pegasus.Core.Cases
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var leaseToken = Model.LeaseToken;
    var mayEdit = !string.IsNullOrWhiteSpace(leaseToken) && workflow.Archive is null;
    // "If they show here, they should be on box" — the operator's rule, and the
    // same filter the evidence gallery already applies. A version still storing,
    // or one whose storage failed, is not case evidence yet; case custody state,
    // its reason and the retry action are on the Workflow tab (DOCS-012).
    //
    // One row per occurrence, joined on the occurrence's own version. The old
    // loop nested documents × occurrences × versions and rendered their
    // cartesian product, so a document with two occurrences and three versions
    // produced six rows.
    var files = details.Documents
        .SelectMany(document => document.Occurrences
            .Select(occurrence => new
            {
                Occurrence = occurrence,
                Version = document.Versions.FirstOrDefault(version =>
                    version.Id == occurrence.VersionId
                    && version.IsCurrent
                    && !version.IsLogicallyRemoved
                    && version.CustodyStatus == DocumentCustodyStatus.Confirmed)
            }))
        .Where(entry => entry.Version is not null)
        .ToArray();
    var mayConfirmThirdParty = (DocumentOccurrence occurrence, DocumentVersion version) =>
        occurrence.SemanticRole == DocumentSemanticRole.Image
        && occurrence.ThirdPartyVehicleConfirmedAtUtc is null
        && (version.MediaType.Equals("image/jpeg", StringComparison.OrdinalIgnoreCase)
            || version.MediaType.Equals("image/png", StringComparison.OrdinalIgnoreCase));
}

<section class="panel form-panel" aria-labelledby="case-documents-title">
    <h2 id="case-documents-title" class="section-label">Files</h2>
    <p>
        @if (details.CustodyState == CaseCustodyState.Confirmed
             && !string.IsNullOrWhiteSpace(details.CustodyFolderRemoteId))
        {
            <a class="btn btn--dark" href="https://app.box.com/folder/@(details.CustodyFolderRemoteId)" target="_blank" rel="noopener">
                <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right"/></svg>
                <span>Open Box case folder</span>
            </a>
        }
        else
        {
            @OperatorLabels.CustodyFolderState(details.CustodyState)
        }
    </p>
    @if (files.Length > 0)
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>File</th><th>Type</th><th>From</th><th>Size</th><th>Added</th>@if (mayEdit){<th>Action</th>}</tr></thead>
                <tbody>
                @foreach (var entry in files)
                {
                    var occurrence = entry.Occurrence;
                    var version = entry.Version!;
                    <tr>
                        <td><a asp-page="/Cases/Documents/Download" asp-route-caseId="@workflow.CaseId" asp-route-occurrenceId="@occurrence.Id" asp-route-versionId="@version.Id">@version.FileName</a></td>
                        <td>
                            @OperatorLabels.DocumentRole(occurrence.SemanticRole)
                            @if (occurrence.ThirdPartyVehicleConfirmedAtUtc is not null)
                            {
                                <span class="status-chip status-chip--amber">Third-party vehicle</span>
                            }
                        </td>
                        <td>@OperatorLabels.DocumentOrigin(occurrence.Source)</td>
                        <td>@OperatorLabels.FileSize(version.ContentLength)</td>
                        <td>@OperatorLabels.OfficeTime(occurrence.RecordedAtUtc)</td>
                        @if (mayEdit)
                        {
                            <td>
                                <button type="button" class="btn btn--icon" data-dialog-open="remove-doc-@occurrence.Id" aria-label="Remove @version.FileName">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-trash-2"/></svg>
                                </button>
                                @if (mayConfirmThirdParty(occurrence, version))
                                {
                                    <button type="button" class="secondary-action" data-dialog-open="third-party-@occurrence.Id">Third-party vehicle</button>
                                }
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (mayEdit)
        {
            @foreach (var entry in files)
            {
                var occurrence = entry.Occurrence;
                var version = entry.Version!;
                <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
                {
                    ["DialogId"] = $"remove-doc-{occurrence.Id}",
                    ["DialogTitle"] = "Remove file",
                    ["DialogActionUrl"] = Url.Page("/Cases/Custody", "RemoveDocument", new { id = workflow.CaseId }),
                    ["DialogHiddenFields"] = new Dictionary<string, string?>
                    {
                        ["id"] = workflow.CaseId.ToString(),
                        ["occurrenceId"] = occurrence.Id.ToString(),
                        ["expectedVersion"] = workflow.Version.ToString(),
                        ["operationKey"] = CaseMutationPageModel.NewOperationKey(),
                        ["editLeaseToken"] = leaseToken
                    }
                })" />
                @if (mayConfirmThirdParty(occurrence, version))
                {
                    <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
                    {
                        ["DialogId"] = $"third-party-{occurrence.Id}",
                        ["DialogTitle"] = "Third-party vehicle",
                        ["DialogActionUrl"] = Url.Page("/Cases/Custody", "ConfirmThirdPartyVehicleEvidence", new { id = workflow.CaseId }),
                        ["DialogHiddenFields"] = new Dictionary<string, string?>
                        {
                            ["id"] = workflow.CaseId.ToString(),
                            ["occurrenceId"] = occurrence.Id.ToString(),
                            ["expectedVersion"] = workflow.Version.ToString(),
                            ["operationKey"] = CaseMutationPageModel.NewOperationKey(),
                            ["editLeaseToken"] = leaseToken
                        }
                    })" />
                }
            }
        }
    }
</section>

<section class="panel form-panel" aria-labelledby="case-upload-requests-title">
    <h2 id="case-upload-requests-title" class="section-label">Public upload requests</h2>
    @if (details.RequestUploadLinks.Count == 0)
    {
        <p class="empty-state">No public upload request is recorded. Availability is not assumed.</p>
    }
    else
    {
        <ul>
        @foreach (var request in details.RequestUploadLinks)
        {
            <li>
                <strong>@OperatorLabels.UploadRequestState(request.Status)</strong> — created @OperatorLabels.OfficeTime(request.CreatedAtUtc) — @request.AcceptedFileCount @(request.AcceptedFileCount == 1 ? "file" : "files") accepted, @OperatorLabels.FileSize(request.AcceptedByteCount)
                @if (mayEdit && request.RevokedAtUtc is null)
                {
                    <form method="post" asp-page="/Cases/Custody" asp-route-id="@workflow.CaseId" asp-page-handler="RevokeRequestUploadLink">
                        <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="requestId" value="@request.Id" /><input type="hidden" name="expectedRequestVersion" value="@request.Version" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                        <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Revoke upload request</button>
                    </form>
                }
            </li>
        }
        </ul>
    }
    @if (mayEdit)
    {
        <form method="post" asp-page="/Cases/Custody" asp-route-id="@workflow.CaseId" asp-page-handler="CreateRequestUploadLink">
            <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@CaseMutationPageModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
            <button type="submit" class="primary-action">Create public upload request</button>
        </form>
    }
</section>
