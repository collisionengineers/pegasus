@model Pegasus.Web.Pages.Cases.DetailsModel
@using Pegasus.Core.Documents
@using Pegasus.Core.Cases
@{
    var details = Model.Case!;
    var workflow = details.Workflow;
    var leaseToken = Model.LeaseToken;
    var mayEdit = !string.IsNullOrWhiteSpace(leaseToken) && workflow.Archive is null;
}

<section class="panel form-panel" aria-labelledby="case-documents-title">
    <h2 id="case-documents-title" class="section-label">Document custody</h2>
    <p>
        @if (details.CustodyState == CaseCustodyState.Confirmed
             && !string.IsNullOrWhiteSpace(details.CustodyFolderRemoteId))
        {
            <a href="https://app.box.com/folder/@(details.CustodyFolderRemoteId)" target="_blank" rel="noopener">Open Box case folder</a>
        }
        else
        {
            @OperatorLabels.CustodyFolderState(details.CustodyState)
        }
    </p>
    @if (details.Documents.Count == 0)
    {
        <p class="empty-state">No document occurrences are retained for this case.</p>
    }
    else
    {
        <form method="post" asp-page="/Cases/Documents/Export" asp-route-caseId="@workflow.CaseId">
            <input type="hidden" name="expectedVersion" value="@workflow.Version" />
            <input type="hidden" name="operationKey" value="@DetailsModel.NewOperationKey()" />
            <input type="hidden" name="editLeaseToken" value="@leaseToken" />
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Export</th><th>Role / source</th><th>Revision state</th><th>File</th><th>Custody</th><th>EVA eligibility</th><th>Action</th></tr></thead>
                    <tbody>
                    @foreach (var document in details.Documents)
                    {
                        @foreach (var occurrence in document.Occurrences)
                        {
                            @foreach (var version in document.Versions)
                            {
                                <tr>
                                    <td><input type="checkbox" name="selection" value="@occurrence.Id:@version.Id" disabled="@(!mayEdit)" aria-label="Select @version.FileName @(version.IsCurrent ? "current revision" : "historical revision")" /></td>
                                    <td>@occurrence.SemanticRole / @occurrence.Source</td>
                                    <td>@(version.IsCurrent ? "Current" : "Historical") @(version.IsLogicallyRemoved ? "— logically removed" : null)</td>
                                    <td><a asp-page="/Cases/Documents/Download" asp-route-caseId="@workflow.CaseId" asp-route-documentId="@occurrence.Id" asp-route-versionId="@version.Id">@version.FileName</a></td>
                                    <td>@OperatorLabels.CustodyState(version.CustodyStatus) — @OperatorLabels.FileSize(version.ContentLength)</td>
                                    <td>
                                        @if (occurrence.ThirdPartyVehicleConfirmedAtUtc is not null)
                                        {
                                            <span>Excluded — staff confirmed third-party vehicle evidence</span>
                                        }
                                        else if (occurrence.SemanticRole == DocumentSemanticRole.Image)
                                        {
                                            <span>Eligible unless staff confirms third-party vehicle evidence</span>
                                        }
                                        else
                                        {
                                            <span>Not an image</span>
                                        }
                                    </td>
                                    <td>
                                        @if (mayEdit && !version.IsLogicallyRemoved && version.IsCurrent)
                                        {
                                            <label>Removal reason<input name="reason" form="remove-@occurrence.Id" required maxlength="500" /></label>
                                            <button type="submit" form="remove-@occurrence.Id" class="secondary-action">Remove occurrence</button>
                                        }
                                        @if (mayEdit
                                             && occurrence.SemanticRole == DocumentSemanticRole.Image
                                             && occurrence.ThirdPartyVehicleConfirmedAtUtc is null
                                             && !version.IsLogicallyRemoved
                                             && version.IsCurrent
                                             && version.CustodyStatus == DocumentCustodyStatus.Confirmed
                                             && (version.MediaType.Equals("image/jpeg", StringComparison.OrdinalIgnoreCase)
                                                 || version.MediaType.Equals("image/png", StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <label>Confirmation reason<input name="reason" form="confirm-third-party-@occurrence.Id" required maxlength="500" /></label>
                                            <button type="submit" form="confirm-third-party-@occurrence.Id" class="secondary-action">Confirm third-party vehicle evidence</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    }
                    </tbody>
                </table>
            </div>
            @if (mayEdit)
            {
                <button type="submit" class="primary-action">Export selected versions</button>
            }
        </form>

        @if (mayEdit)
        {
            @foreach (var document in details.Documents)
            {
                @foreach (var occurrence in document.Occurrences.Where(item => document.Versions.Any(version => version.IsCurrent && !version.IsLogicallyRemoved)))
                {
                    <form id="remove-@occurrence.Id" method="post" asp-page="/Cases/Custody" asp-route-id="@workflow.CaseId" asp-page-handler="RemoveDocument">
                        <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="occurrenceId" value="@occurrence.Id" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@DetailsModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                    </form>
                    @if (occurrence.SemanticRole == DocumentSemanticRole.Image && occurrence.ThirdPartyVehicleConfirmedAtUtc is null)
                    {
                        <form id="confirm-third-party-@occurrence.Id" method="post" asp-page="/Cases/Custody" asp-route-id="@workflow.CaseId" asp-page-handler="ConfirmThirdPartyVehicleEvidence">
                            <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="occurrenceId" value="@occurrence.Id" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@DetailsModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                        </form>
                    }
                }
            }
        }
    }

    @if (mayEdit)
    {
        <form method="post" enctype="multipart/form-data" asp-page="/Cases/Custody" asp-route-id="@workflow.CaseId" asp-page-handler="UploadDocument" class="form-grid">
            <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@DetailsModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
            <label>Document<input type="file" name="upload" required /></label>
            <label>Semantic role<select name="semanticRole">@foreach (var role in Model.DocumentSemanticRoles){<option value="@role">@role</option>}</select></label>
            <button type="submit" class="primary-action">Retain document</button>
        </form>
    }
</section>

<section class="panel form-panel" aria-labelledby="case-upload-requests-title">
    <h2 id="case-upload-requests-title" class="section-label">Public upload requests</h2>
    @if (details.RequestUploadLinks.Count == 0)
    {
        <p class="empty-state">No public upload request is recorded. Availability is not assumed.</p>
    }
    else
    {
        <ul>
        @foreach (var request in details.RequestUploadLinks)
        {
            <li>
                <strong>@OperatorLabels.UploadRequestState(request.Status)</strong> — created @OperatorLabels.OfficeTime(request.CreatedAtUtc) — @request.AcceptedFileCount @(request.AcceptedFileCount == 1 ? "file" : "files") accepted, @OperatorLabels.FileSize(request.AcceptedByteCount)
                @if (mayEdit && request.RevokedAtUtc is null)
                {
                    <form method="post" asp-page="/Cases/Custody" asp-route-id="@workflow.CaseId" asp-page-handler="RevokeRequestUploadLink">
                        <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="requestId" value="@request.Id" /><input type="hidden" name="expectedRequestVersion" value="@request.Version" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@DetailsModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
                        <label>Reason<input name="reason" required maxlength="500" /></label><button type="submit" class="secondary-action">Revoke upload request</button>
                    </form>
                }
            </li>
        }
        </ul>
    }
    @if (mayEdit)
    {
        <form method="post" asp-page="/Cases/Custody" asp-route-id="@workflow.CaseId" asp-page-handler="CreateRequestUploadLink">
            <input type="hidden" name="id" value="@workflow.CaseId" /><input type="hidden" name="expectedVersion" value="@workflow.Version" /><input type="hidden" name="operationKey" value="@DetailsModel.NewOperationKey()" /><input type="hidden" name="editLeaseToken" value="@leaseToken" />
            <button type="submit" class="primary-action">Create public upload request</button>
        </form>
    }
</section>
