@page
@model Pegasus.Web.Pages.Cases.CreateModel
@using Pegasus.Core.Cases
@using Pegasus.Core.Intake
@{
    ViewData["Title"] = "New case";

    var draft = Model.IsManual ? null : Model.DraftFields.Draft;
}

@*
    The second half of one operator action: a file was dropped on Upload, it
    was read while they waited, and this is where what came out of it becomes
    a case. The route carries no "intake" — the operator notes forbid the word
    in the interface — and no identifier, hash or version is printed as text.

    Each read value is a definition row carrying its own provenance glyph:
    where a value came from is one word on the icon's accessible name, never a
    sentence, a source label or a third column. The row still reads with the
    icon ignored, so provenance stays supplementary.
*@
@{
    void Row(string label, string? value, string fieldName)
    {
        var word = Model.DraftFields.ProvenanceWord(fieldName);
        var icon = word == "Extracted" ? "icon-file-text" : "icon-user";
        var recorded = !string.IsNullOrWhiteSpace(value);
        <dl class="definition">
            <dt>@label</dt>
            <dd class="@(recorded ? null : "quiet")">
                @(recorded ? value : "Not recorded")
                <span class="prov" tabindex="0" role="img" aria-label="@word" data-word="@word">
                    <svg class="icon" aria-hidden="true"><use href="#@icon" /></svg>
                </span>
            </dd>
        </dl>
    }
}

@if (Model.IsManual)
{
    <header class="page-header">
        <div class="page-title">
            <p class="eyebrow">New case</p>
            <h1>Create case</h1>
        </div>
    </header>

    <form method="post" asp-page-handler="Create" class="stack">
        <input asp-for="IsManual" type="hidden" />
        <input asp-for="OperationId" type="hidden" />
        <partial name="Shared/_ErrorSummary" />

        <section class="panel" aria-labelledby="case-title">
            <div class="panel-head"><h2 id="case-title">Case</h2></div>
            <div class="panel-body stack">
                <div class="grid grid-2">
                    <div class="field">
                        <label class="req" asp-for="PrincipalCode">Principal code</label>
                        <input asp-for="PrincipalCode" maxlength="20" autocomplete="off" required />
                        <span asp-validation-for="PrincipalCode" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="ClaimSourceId">Claim Source</label>
                        <select asp-for="ClaimSourceId">
                            <option value="">Not recorded</option>
                            @foreach (var claimSource in Model.ClaimSourceChoices)
                            {
                                <option value="@claimSource.OrganizationId">@claimSource.Name</option>
                            }
                        </select>
                        <span asp-validation-for="ClaimSourceId" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="CaseType">Case type</label>
                        <select asp-for="CaseType">
                            <option value="@CaseType.Inspection">Inspection</option>
                            <option value="@CaseType.InspectionAndAudit">Inspection and Audit</option>
                        </select>
                        <span asp-validation-for="CaseType" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label class="req" asp-for="ClaimantName">Claimant</label>
                        <input asp-for="ClaimantName" maxlength="300" required />
                        <span asp-validation-for="ClaimantName" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label class="req" asp-for="ClaimNumber">Claim number</label>
                        <input asp-for="ClaimNumber" maxlength="100" required />
                        <span asp-validation-for="ClaimNumber" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label class="req" asp-for="VehicleRegistration">Registration</label>
                        <input asp-for="VehicleRegistration" maxlength="20" required />
                        <span asp-validation-for="VehicleRegistration" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="InstructionDate">Instruction date</label>
                        <input asp-for="InstructionDate" type="date" />
                        <span asp-validation-for="InstructionDate" class="field-error"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="panel" aria-labelledby="vehicle-title">
            <div class="panel-head"><h2 id="vehicle-title">Vehicle and inspection</h2></div>
            <div class="panel-body stack">
                <div class="grid grid-2">
                    <div class="field"><label asp-for="VehicleMake">Make</label><input asp-for="VehicleMake" maxlength="100" /></div>
                    <div class="field"><label asp-for="VehicleModel">Model</label><input asp-for="VehicleModel" maxlength="100" /></div>
                    <div class="field"><label asp-for="VehicleMileage">Mileage</label><input asp-for="VehicleMileage" type="number" min="0" /></div>
                    <div class="field">
                        <label asp-for="VehicleMileageUnit">Mileage unit</label>
                        <select asp-for="VehicleMileageUnit"><option value="">Not recorded</option><option value="miles">Miles</option><option value="kilometres">Kilometres</option></select>
                    </div>
                    <div class="field"><label asp-for="DateOfIncident">Incident date</label><input asp-for="DateOfIncident" type="date" /></div>
                    <div class="field"><label asp-for="InspectionDate">Inspection date</label><input asp-for="InspectionDate" type="date" /></div>
                </div>
                <div class="field"><label asp-for="InspectionAddress">Inspection address</label><textarea asp-for="InspectionAddress" maxlength="1000" rows="3"></textarea></div>
                <div class="field"><label asp-for="AccidentCircumstances">Accident circumstances</label><textarea asp-for="AccidentCircumstances" maxlength="2000" rows="4"></textarea></div>
            </div>
        </section>

        <div class="cluster">
            <button type="submit" class="btn btn--primary">Create case</button>
            <a class="btn" asp-page="/Cases/Index">Cancel</a>
        </div>
    </form>
}
else
{

@* The heading names the file this case is being made from. "New case" was the
   eyebrow, the H1 and the start of the lede — three lines saying it once. *@
<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">New case</p>
        <h1>From @Model.Receipt.SourceFileName</h1>
    </div>
    <div class="page-actions">
        <a class="btn" asp-page="/Upload">
            <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
            <span>Upload another</span>
        </a>
    </div>
</header>

@if (Model.RefusalMessage is { } refusal)
{
    <section class="panel" aria-labelledby="refusal-title">
        <div class="panel-head">
            <h2 id="refusal-title">This item cannot become a case</h2>
        </div>
        <div class="panel-body stack">
            <div class="notice notice--danger" role="alert">
                <svg class="icon" aria-hidden="true"><use href="#icon-alert-circle" /></svg>
                <span>@refusal</span>
            </div>
            <div class="cluster">
                <a class="btn" asp-page="/Intake/Details" asp-route-id="@Model.Receipt.Id">Open the received item</a>
            </div>
        </div>
    </section>
}
else
{
    <form method="post" asp-page-handler="Create" class="stack">
        <input asp-for="ReceiptId" type="hidden" />
        <input asp-for="OperationId" type="hidden" />
        <input asp-for="ExpectedReceiptVersion" type="hidden" />
        <input asp-for="AddressSuggestionFingerprint" type="hidden" />
        <input asp-for="RequiresAddressResolution" type="hidden" />
        <partial name="Shared/_ErrorSummary" />

        @* Read first, edit on demand. Eleven boxes asked the operator to check
           every one; the rows state what was read, and the fields open only
           when something is wrong. The inputs still post either way, so
           nothing depends on the disclosure being open. *@
        <section class="panel" aria-labelledby="details-title">
            <div class="panel-head">
                <h2 id="details-title">Details</h2>
            </div>
            <div class="panel-body stack">
                <div class="definition-list">
                    @{
                        Row("Claimant", draft?.ClaimantName, "Claimant name");
                        Row("Claim number", draft?.ClaimNumber, "Claim number");
                        Row("Registration", draft?.VehicleRegistration, "Vehicle registration");
                        Row(
                            "Vehicle",
                            string.Join(
                                " ",
                                new[] { draft?.VehicleMake, draft?.VehicleModel }
                                    .Where(part => !string.IsNullOrWhiteSpace(part))),
                            "Vehicle make");
                        Row(
                            "Incident date",
                            draft?.DateOfIncident?.ToString("d MMM yyyy"),
                            "Date of incident");
                        Row(
                            "Instruction date",
                            draft?.InstructionDate?.ToString("d MMM yyyy"),
                            "Instruction date");
                    }
                </div>
                <details>
                    <summary class="btn">Change a value</summary>
                    <partial name="_InstructionDraftFields" model="Model.DraftFields" />
                </details>
            </div>
        </section>

        <section class="panel" aria-labelledby="address-title">
            <div class="panel-head">
                <h2 id="address-title">Inspection address</h2>
            </div>
            <div class="panel-body stack">
                @if (Model.ProviderIsImageBased)
                {
                    @* A rule that overrides whatever the instruction says, so it
                       is a notice rather than a paragraph. *@
                    <div class="notice notice--warning">
                        <svg class="icon" aria-hidden="true"><use href="#icon-info" /></svg>
                        <span>Image Based Assessment: the inspection address is recorded as &ldquo;Image Based Assessment&rdquo;.</span>
                    </div>
                }
                else if (Model.AddressAlreadySettled)
                {
                    <div class="definition-list">
                        <dl class="definition">
                            <dt>Inspection address</dt>
                            <dd>@Model.AddressResolution.ResolvedValue</dd>
                        </dl>
                        <dl class="definition">
                            <dt>Status</dt>
                            <dd>@Pegasus.Web.Pages.Cases.CreateModel.AddressStateLabel(Model.AddressResolution.State)</dd>
                        </dl>
                    </div>
                }
                else if (Model.AddressSuggestion is { } suggestion)
                {
                    <div class="definition-list">
                        <dl class="definition">
                            <dt>Address found in the document</dt>
                            <dd>@suggestion.Value</dd>
                        </dl>
                        <dl class="definition">
                            <dt>Status</dt>
                            <dd>@Pegasus.Web.Pages.Cases.CreateModel.AddressStateLabel(Model.AddressResolution.State)</dd>
                        </dl>
                        @foreach (var provenance in suggestion.Provenance)
                        {
                            <dl class="definition">
                                <dt>Extracted from</dt>
                                <dd>@provenance.SourceLabel</dd>
                            </dl>
                        }
                    </div>
                    @* The choice is always explicit: Pegasus will not decide for
                       itself which of two addresses is the right one. *@
                    <fieldset class="field">
                        <legend>Inspection address</legend>
                        <label class="choice">
                            <input type="radio" asp-for="AddressChoice" value="@Pegasus.Web.Pages.Cases.CreateModel.AddressChoiceKind.UseFoundAddress" required />
                            <span>Use the address found</span>
                        </label>
                        <label class="choice">
                            <input type="radio" asp-for="AddressChoice" value="@Pegasus.Web.Pages.Cases.CreateModel.AddressChoiceKind.UseEnteredAddress" />
                            <span>Use this address instead</span>
                        </label>
                    </fieldset>
                    <div class="field">
                        <label asp-for="InspectionAddress">Inspection address to use instead</label>
                        <textarea asp-for="InspectionAddress" maxlength="1000" rows="3"></textarea>
                        <span asp-validation-for="InspectionAddress" class="field-error"></span>
                    </div>
                }
                else
                {
                    <div class="notice notice--warning">
                        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                        <span>Nothing in this file said where the vehicle is.</span>
                    </div>
                    @if (Model.AddressResolution.Evaluation.ConflictingEvidence.Count > 0)
                    {
                        <div class="definition-list">
                            @foreach (var evidence in Model.AddressResolution.Evaluation.ConflictingEvidence)
                            {
                                <dl class="definition">
                                    <dt>Conflicting · @evidence.Provenance.SourceLabel</dt>
                                    <dd>@evidence.Value</dd>
                                </dl>
                            }
                        </div>
                    }
                    <div class="field">
                        <label class="req" asp-for="InspectionAddress">Inspection address</label>
                        <textarea asp-for="InspectionAddress" maxlength="1000" rows="3" required></textarea>
                        <span asp-validation-for="InspectionAddress" class="field-error"></span>
                    </div>
                }
            </div>
        </section>

        @* Evidence completeness is derived from the reviewed receipt and the
           current policy; an operator does not certify it with checkboxes. *@
        <section class="panel" aria-labelledby="case-title">
            <div class="panel-head">
                <h2 id="case-title">Case</h2>
            </div>
            <div class="panel-body stack">
                <div class="grid grid-2">
                    <div class="field">
                        <label asp-for="PrincipalCode">Confirmed principal code</label>
                        <input asp-for="PrincipalCode" maxlength="20" autocomplete="off" />
                        <span asp-validation-for="PrincipalCode" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="CaseType">Case type</label>
                        <select asp-for="CaseType" data-case-type-selector>
                            <option value="@CaseType.Inspection">Inspection</option>
                            <option value="@CaseType.InspectionAndAudit">Inspection and Audit</option>
                            @if (Model.IsRetainedClassifiedAudit)
                            {
                                <option value="@CaseType.Audit">Audit</option>
                            }
                        </select>
                        <span asp-validation-for="CaseType" class="field-error"></span>
                    </div>
                </div>

                @* One committed action, and the way out beside it. *@
                <div class="cluster">
                    <button type="submit" class="btn btn--primary">Accept and create case</button>
                    <a class="btn" asp-page="/Intake/Details" asp-route-id="@Model.ReceiptId">Reject proposal</a>
                </div>
            </div>
        </section>
    </form>
}
}
