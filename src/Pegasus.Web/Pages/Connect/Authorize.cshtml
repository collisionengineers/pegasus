@page "/connect/authorize"
@model Pegasus.Web.Pages.Connect.AuthorizeModel
@{
    ViewData["Title"] = "Authorize staff MCP access";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Staff MCP authorization</p>
        <h1>Review access for @Model.ClientName</h1>
        <p class="lede">Approve only if you started this connection. Pegasus will apply your current account status and role to every tool call.</p>
    </div>
</header>

<section class="panel form-panel" aria-labelledby="consent-title">
    <h2 id="consent-title" class="section-label">Requested access</h2>
    <dl class="detail-list">
        <div>
            <dt>Client</dt>
            <dd>@Model.ClientName</dd>
        </div>
        <div>
            <dt>Protected resource</dt>
            <dd><code>@Model.Resource</code></dd>
        </div>
    </dl>

    <h3>Permissions</h3>
    <ul class="plain-list">
        @foreach (var scope in Model.RequestedScopes)
        {
            <li><strong>@scope.Name</strong><br />@scope.Description</li>
        }
    </ul>

    <p>Approval creates an individual grant for this client, your staff account and exactly these permissions. It does not grant access to account administration, configuration, credentials, cloud operations or permanent deletion.</p>

    <form id="staff-mcp-consent" method="post" asp-page="/Connect/Authorize">
        @foreach (var parameter in Model.AuthorizationParameters)
        {
            <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
        }
        <div class="form-actions">
            <button class="primary-action" type="submit" name="decision" value="approve">Approve access</button>
            <button class="secondary-action" type="submit" name="decision" value="deny">Deny</button>
        </div>
    </form>
</section>
