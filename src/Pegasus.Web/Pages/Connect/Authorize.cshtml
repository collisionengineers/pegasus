@page "/authorize"
@model Pegasus.Web.Pages.Connect.AuthorizeModel
@{
    // The consent screen is not a place in the application: the navless card
    // frame (v26 shell mockup, Pages/Connect/Authorize), wide for the scope list.
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Authorise an automation connector";
    ViewData["AuthCardClass"] = "auth-card--wide consent-card";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<p class="eyebrow">Administration</p>
<h1>Authorise an automation connector</h1>

<div class="notice" data-connector-notice>
    <svg class="icon" aria-hidden="true"><use href="#icon-shield" /></svg>
    <span>The connector never receives staff rights; every action it takes runs as <strong>@Model.ClientDisplayName</strong> through the approved tool inventory, within the scopes below, and both the action and your decision are permanently recorded.</span>
</div>

<section class="panel" aria-labelledby="connector-heading">
    <div class="panel-head"><h2 id="connector-heading">Connection request</h2></div>
    <div class="panel-body">
        <dl class="detail-list">
            <div><dt>Connector</dt><dd>@Model.ConnectorOrigin</dd></div>
            <div><dt>Acts as</dt><dd>@Model.ClientDisplayName</dd></div>
            <div>
                <dt>Requested access</dt>
                <dd>
                    @if (Model.RequestedScopes.Count == 0)
                    {
                        <span>No granted scope was requested; the connector would be unable to call any tool.</span>
                    }
                    else
                    {
                        <ul class="plain">
                            @foreach (var (scope, description) in Model.RequestedScopes)
                            {
                                <li><code>@scope</code> — @description</li>
                            }
                        </ul>
                    }
                </dd>
            </div>
        </dl>

        <form method="post" class="cluster mt-2">
            @foreach (var parameter in Model.RequestParameters)
            {
                <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
            }
            <input type="hidden" asp-for="OperationKey" />
            <button type="submit" asp-page-handler="Accept" class="btn btn--primary">Authorise the connector</button>
            <button type="submit" asp-page-handler="Deny" class="btn">Refuse</button>
        </form>
    </div>
</section>
