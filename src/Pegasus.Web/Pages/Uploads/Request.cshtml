@page "/Uploads/{token}"
@model Pegasus.Web.Pages.Uploads.RequestModel
@{
    ViewData["Title"] = "Upload requested documents";
}

@* The heading carries the eyebrow and the title alone. The sentence that was a
   lede is ordinary body copy: it is an instruction to the person uploading, not
   a description of the screen. *@
<div class="form-column form-column--narrow">
    <header class="page-heading">
        <div>
            <p class="eyebrow">Secure document request</p>
            <h1>Upload requested documents</h1>
        </div>
    </header>

    <p>Documents submitted here go directly to Collision Engineers against the request you received. Do not upload material unrelated to that request.</p>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status-card" role="status">@Model.StatusMessage</div>
    }

    @if (Model.UploadPolicy is not null)
    {
        <section class="panel section-gap" aria-labelledby="request-upload-title">
            <h2 id="request-upload-title" class="section-label">Choose a document</h2>
            <form method="post" enctype="multipart/form-data">
                <input asp-for="Token" type="hidden" />
                <input asp-for="OperationKey" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <div class="dropzone dropzone--compact" data-dropzone>
                    <span class="dropzone__glyph" aria-hidden="true"><svg class="icon"><use href="#icon-upload" /></svg></span>
                    <label asp-for="Upload">Drag a file here, or choose one</label>
                    <span class="field-hint">Up to @Model.MaximumFileSize.</span>
                    <input asp-for="Upload" type="file" accept="@Model.AcceptedMediaTypes" />
                    <button type="button" class="btn dropzone__browse" hidden
                            data-dropzone-browse
                            data-label-choose="Choose file"
                            data-label-change="Choose a different file">Choose file</button>
                    <p class="dropzone__file" role="status" aria-live="polite" hidden data-dropzone-file></p>
                </div>
                <span asp-validation-for="Upload" class="field-validation"></span>
                <button type="submit" class="primary-action primary-action--block">Upload document</button>
            </form>
        </section>
    }
</div>
