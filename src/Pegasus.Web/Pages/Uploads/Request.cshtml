@page "/Uploads/{token}"
@model Pegasus.Web.Pages.Uploads.RequestModel
@using Pegasus.Core.Documents
@{
    ViewData["Title"] = OperatorLabels.Upload.RequestTitle;
}

@* The one screen a third party outside Collision Engineers sees. The external
   layout supplies the card and the company logo; this is its whole content.
   No request reference, no expiry and no case identity appear here: FRD-02
   binds the public page to the upload fields and its own success or failure,
   and RequestUploadPublicView carries nothing else. *@
<p class="eyebrow">@OperatorLabels.Upload.RequestEyebrow</p>
<h1>@OperatorLabels.Upload.RequestTitle</h1>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice notice--success" role="status">
        <svg class="icon" aria-hidden="true"><use href="#icon-check-circle" /></svg>
        <span>@Model.StatusMessage</span>
    </div>
}

@if (Model.UploadPolicy is not null)
{
    @if (Model.UploadPolicy.Files.Count > 0)
    {
        <ul class="section-gap">
            @foreach (var file in Model.UploadPolicy.Files)
            {
                <li>
                    <span>@file.FileName</span>
                    @if (Model.UploadPolicy.SessionState == PublicUploadSessionState.Open)
                    {
                        <form method="post" enctype="multipart/form-data" asp-page-handler="Upload">
                            <input asp-for="Token" type="hidden" />
                            <input asp-for="OperationKey" type="hidden" />
                            <input name="ReplacementOccurrenceId" value="@file.Id" type="hidden" />
                            <label for="replacement-@file.Id">@OperatorLabels.Upload.RequestReplace</label>
                            <input id="replacement-@file.Id" name="Upload" type="file" accept="@Model.AcceptedMediaTypes" />
                            <button type="submit" class="btn btn--secondary">@OperatorLabels.Upload.RequestReplace</button>
                        </form>
                    }
                </li>
            }
        </ul>
    }

    @if (Model.UploadPolicy.SessionState is PublicUploadSessionState.NotStarted or PublicUploadSessionState.Open)
    {
    <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" class="section-gap">
        <input asp-for="Token" type="hidden" />
        <input asp-for="OperationKey" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="dropzone" data-dropzone>
            <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
            <div>
                <h2><label asp-for="Upload">@OperatorLabels.Upload.RequestDropzone</label></h2>
                <p>@OperatorLabels.Upload.RequestLimit(Model.MaximumFileSize)</p>
                <button type="button" class="btn btn--primary" hidden data-dropzone-browse>@OperatorLabels.Upload.RequestChoose</button>
                <input asp-for="Upload" type="file" accept="@Model.AcceptedMediaTypes" />
            </div>
        </div>
        <div class="file-list section-gap" role="status" aria-live="polite" hidden data-dropzone-file></div>
        <span asp-validation-for="Upload" class="field-error"></span>
        <div class="button-row section-gap">
            <button type="submit" class="btn btn--primary">@OperatorLabels.Upload.RequestSubmit</button>
        </div>
    </form>
    }

    @if (Model.UploadPolicy.SessionState == PublicUploadSessionState.Open)
    {
        <form method="post" asp-page-handler="Finalize" class="section-gap">
            <input asp-for="Token" type="hidden" />
            <div class="button-row">
                <button type="submit" class="btn btn--primary">@OperatorLabels.Upload.RequestFinish</button>
            </div>
        </form>
    }
}
