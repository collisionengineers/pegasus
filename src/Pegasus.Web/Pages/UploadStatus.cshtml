@page "/Upload/Status/{id:guid}"
@model Pegasus.Web.Pages.UploadStatusModel
@using Pegasus.Core.Intake
@{
    ViewData["Title"] = "Upload status";
}

@* The same bounded column as the Upload screen it follows: one receipt, a
   handful of facts and two actions do not want the full width of a monitor. *@
<div class="form-column form-column--wide">
<header class="page-heading">
    <div>
        <p class="eyebrow">Upload status</p>
        <h1>@Model.Heading</h1>
        @* Once the confirmation section below has something to say, it says
           it once — the generic "Processing is complete."/failure sentence
           here would otherwise repeat the same fact a second time. *@
        @if (Model.Outcome is null)
        {
            <p class="lede" aria-live="polite">@Model.Message</p>
        }
        else if (Model.IsDuplicate)
        {
            <p class="lede" aria-live="polite">@Model.Status.SourceFileName was already received. No duplicate was created.</p>
        }
    </div>
</header>

@if (TempData["UploadConfirmationStatus"] is string confirmationStatus)
{
    <div class="status-card" role="status">@confirmationStatus</div>
}
@if (TempData["UploadConfirmationError"] is string confirmationError)
{
    <div class="validation-summary" role="alert">@confirmationError</div>
}

@* The refresh attribute lives on the panel, not the layout's <main>: the
   external script reads it from wherever it is, and this page must not
   nest a second main landmark inside the shared shell. *@
<section class="panel"
         aria-labelledby="upload-file-heading"
         data-auto-refresh="@(Model.RefreshAutomatically ? "2000" : null)">
    <h2 id="upload-file-heading" class="section-label">@Model.Status.SourceFileName</h2>
    <dl class="detail-list">
        <div><dt>Received</dt><dd>@OperatorLabels.OfficeTime(Model.Status.ReceivedAtUtc)</dd></div>
    </dl>

    @if (Model.Outcome is { } outcome)
    {
        @* Processing has resolved: the confirmation decision replaces the
           plain status text — what already happened automatically, or the
           staff decision that is genuinely open. *@
        <partial name="Shared/_UploadOutcome" model="@outcome" />
    }

    <div class="button-row">
        <a class="secondary-action"
           asp-page="/UploadStatus"
           asp-route-id="@Model.Status.StagedReceiptId"
           asp-route-duplicate="@(Model.IsDuplicate ? "true" : null)">Refresh</a>
        <a class="secondary-action" asp-page="/Upload">Upload another file</a>
    </div>
</section>
</div>
