@page "/Upload/Status/{id:guid}"
@model Pegasus.Web.Pages.UploadStatusModel
@{
    ViewData["Title"] = "Upload";
    // The id is in the path; only the duplicate marker needs replaying so a
    // refresh keeps reporting the resubmission outcome.
    ViewData["RefreshFields"] = new Dictionary<string, string?>
    {
        ["duplicate"] = Model.IsDuplicate ? "true" : null
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/upload.css" asp-append-version="true" />
}

<partial name="Shared/_UploadReview" model="Model.Review" />

@section Scripts {
    <script src="~/js/upload.js" asp-append-version="true"></script>
}
