@*
    Evidence viewer (DOCS-011).

    An overlay, so the case page, its tab and its unsaved edits stay behind
    it; the enlarged view reads the same authorised URL as the thumbnail, so
    nothing is re-encoded. Render it once per page; the triggers are the
    [data-evidence-item] links inside a [data-evidence-set]. site.js owns the
    paging, the loading state, Escape, focus containment and focus return.

    PDFs use an <iframe> because the deployed CSP sets object-src 'none'.
*@
<div id="evidence-viewer"
     class="dialog-backdrop evidence-viewer"
     data-evidence-viewer
     hidden>
    <section class="dialog dialog--wide" role="dialog" aria-modal="true" aria-labelledby="evidence-viewer-name">
        <div class="dialog-head">
            <h2 id="evidence-viewer-name" class="wrap" data-evidence-name></h2>
            <span class="muted tabular" data-evidence-position></span>
            <a class="btn btn--small" data-evidence-download download>
                <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                <span>Save as</span>
            </a>
            <button type="button" class="btn btn--small" data-rotate aria-label="Rotate view">
                <svg class="icon" aria-hidden="true"><use href="#icon-rotate-cw" /></svg>
            </button>
            <button type="button" class="dialog-close" data-evidence-close>
                <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                <span class="sr-only">Close</span>
            </button>
        </div>
        <div class="dialog-body">
            <div class="viewer-stage" data-evidence-stage data-rotate-target>
                <img data-evidence-image alt="" hidden />
                <iframe data-evidence-document title="" hidden></iframe>
            </div>
        </div>
        <div class="dialog-foot cluster--between">
            <button type="button" class="btn" data-evidence-previous>
                <svg class="icon" aria-hidden="true"><use href="#icon-chevron-left" /></svg>
                <span>Previous</span>
            </button>
            <button type="button" class="btn" data-evidence-next>
                <span>Next</span>
                <svg class="icon" aria-hidden="true"><use href="#icon-chevron-right" /></svg>
            </button>
        </div>
    </section>
</div>
