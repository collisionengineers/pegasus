@*
    Evidence viewer.

    An overlay, so the case page, its tab and its unsaved edits stay behind
    it; the enlarged view reads the same authorised URL as the thumbnail, so
    nothing is re-encoded. Render it once per page; the triggers are the
    [data-evidence-item] links inside a [data-evidence-set]. site.js owns the
    paging, the loading state, Escape, focus containment and focus return.

    PDFs use an <iframe> because the deployed CSP sets object-src 'none'; the
    admitted MP4/MOV files use the browser's native video control.
*@
<div id="evidence-viewer"
     class="dialog-backdrop evidence-viewer"
     data-evidence-viewer
     hidden>
    <section class="dialog dialog--wide" role="dialog" aria-modal="true" aria-labelledby="evidence-viewer-name">
        <div class="dialog-head">
            <h2 id="evidence-viewer-name" class="wrap" data-evidence-name></h2>
            <span class="muted tabular" data-evidence-position></span>
            <a class="btn btn--small" data-evidence-download download>
                <svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg>
                <span>Save as</span>
            </a>
            <button type="button" class="btn btn--small" data-evidence-crop hidden>
                <span>Crop</span>
            </button>
            <button type="button" class="btn btn--small" data-rotate aria-label="Rotate view">
                <svg class="icon" aria-hidden="true"><use href="#icon-rotate-cw" /></svg>
            </button>
            <button type="button" class="dialog-close" data-evidence-close>
                <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                <span class="sr-only">Close</span>
            </button>
        </div>
        <div class="dialog-body">
            <div class="viewer-stage" data-evidence-stage data-rotate-target>
                <img data-evidence-image alt="" hidden />
                <iframe data-evidence-document title="" hidden></iframe>
                <video data-evidence-video controls preload="metadata" hidden></video>
            </div>
        </div>
        @if (ViewData["PreCaseImageTags"] is IReadOnlyList<Pegasus.Core.Documents.ImageTag> preCaseTags)
        {
            @* Pre-Case crop and tag (v26): shown by site.js for an item carrying
               data-precase-asset. Apply saves the drawn frame with the view's
               rotation, Clear restores the original, Cancel leaves crop mode;
               the Tag select puts a tag on and a chip's × takes it off. *@
            var returnUrl = Context.Request.Path + Context.Request.QueryString;
            <div class="evidence-precase" data-precase-tools hidden>
                <span class="evidence-precase-set" data-precase-view>
                    <button type="button" class="btn btn--small" data-precase-crop-start>@OperatorLabels.PreCaseImages.Crop</button>
                    <span class="muted" data-precase-crop-state></span>
                </span>
                <span class="evidence-precase-set" data-precase-cropping hidden>
                    <span class="muted">@OperatorLabels.PreCaseImages.DrawHint</span>
                    <button type="button" class="btn btn--small btn--primary" data-precase-crop-apply>@OperatorLabels.PreCaseImages.Apply</button>
                    <button type="button" class="btn btn--small" data-precase-crop-clear>@OperatorLabels.PreCaseImages.Clear</button>
                    <button type="button" class="btn btn--small" data-precase-crop-cancel>@OperatorLabels.PreCaseImages.Cancel</button>
                </span>
                <span class="evidence-precase-set">
                    <label class="sr-only" for="precase-tag-select">@OperatorLabels.PreCaseImages.Tag</label>
                    <select id="precase-tag-select" data-precase-tag-select>
                        <option value="">@OperatorLabels.PreCaseImages.AddTag</option>
                        @foreach (var tag in preCaseTags)
                        {
                            <option value="@tag.Id" data-colour="@tag.Colour.ToString().ToLowerInvariant()">@tag.Name</option>
                        }
                    </select>
                    <span class="precase-tags" data-precase-tag-list></span>
                </span>
            </div>
            <form method="post" asp-page="/PreCaseImages/Index" asp-page-handler="Crop" data-precase-crop-form hidden>
                <input type="hidden" name="intakeAssetId" />
                <input type="hidden" name="expectedVersion" />
                <input type="hidden" name="rotation" />
                <input type="hidden" name="cropLeft" />
                <input type="hidden" name="cropTop" />
                <input type="hidden" name="cropWidth" />
                <input type="hidden" name="cropHeight" />
                <input type="hidden" name="clear" value="false" />
                <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            </form>
            <form method="post" asp-page="/PreCaseImages/Index" asp-page-handler="Tag" data-precase-tag-form hidden>
                <input type="hidden" name="intakeAssetId" />
                <input type="hidden" name="tagId" />
                <input type="hidden" name="applied" />
                <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            </form>
        }
        <div class="dialog-foot cluster--between">
            <button type="button" class="btn" data-evidence-previous>
                <svg class="icon" aria-hidden="true"><use href="#icon-chevron-left" /></svg>
                <span>Previous</span>
            </button>
            <button type="button" class="btn" data-evidence-next>
                <span>Next</span>
                <svg class="icon" aria-hidden="true"><use href="#icon-chevron-right" /></svg>
            </button>
        </div>
    </section>
</div>
