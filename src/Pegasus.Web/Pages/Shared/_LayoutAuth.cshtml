<!DOCTYPE html>
@*
    The external frame (§1.13) for screens that are not a place in the
    application: sign in, signed out, the forced password change, access
    denied, the consent screen and the error/not-found family. Two planes on
    a common centre line (v30 sign-in B, 25 September 2026): the charcoal
    identity panel carries the Pegasus mark, the product name and the
    company; the white panel carries the page's one card. No navigation — a
    refusal must not offer a menu of destinations it has just declined.
*@
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Pegasus</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="Shared/_LucideSprite" />
    <div class="external-shell">
        <aside class="auth-identity">
            <div class="auth-brand">
                <img src="~/images/pegasus-mark-refined-256.png" asp-append-version="true" alt="" width="96" height="96" />
                <div class="brand-copy">
                    <strong>PEGASUS</strong>
                    <span>Case management</span>
                </div>
            </div>
            <p class="auth-company">Collision Engineers</p>
        </aside>
        <main id="main-content" class="auth-panel" tabindex="-1">
            <section class="auth-card @(ViewData["AuthCardClass"] as string)">
                @RenderBody()
            </section>
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
