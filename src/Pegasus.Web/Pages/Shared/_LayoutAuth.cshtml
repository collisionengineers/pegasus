<!DOCTYPE html>
@*
    The external frame (§1.13) for screens that are not a place in the
    application: sign in, signed out, access denied, and the error/not-found
    family. One card on the dark ground, the company logo and the product
    name, and no navigation — a refusal must not offer a menu of destinations
    it has just declined.
*@
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Pegasus</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="Shared/_LucideSprite" />
    <div class="external-shell">
        <main id="main-content" tabindex="-1">
            <section class="auth-card">
                <div class="auth-brand">
                    <img src="~/images/logo_no_margin.png" asp-append-version="true" alt="" />
                    <strong>PEGASUS</strong>
                </div>
                @RenderBody()
            </section>
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
