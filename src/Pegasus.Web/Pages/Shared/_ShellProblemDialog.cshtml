@*
    Report a problem (FRD-12): one text box and Send, answered by
    /Notifications?handler=ShellDialog&name=problem the first time the dialog
    opens. The page it was opened on names itself in the request (traceId and
    method), so the report carries the page's trace, not this fetch's. site.js
    fills the hidden browser facts (viewport, whether a record is being edited,
    the last script errors, the Case reference on screen) when the form is
    submitted.
*@
@model ShellProblemView
<section class="dialog" role="dialog" aria-modal="true" aria-labelledby="problem-dialog-title">
    <form method="post" asp-page="/ProblemReports" asp-page-handler="Report" data-problem-form
          data-problem-case-sections="@CaseSectionKeys">
        <input type="hidden" name="operationKey" value="@Pegasus.Web.Pages.StaffPageModel.NewOperationKey()" />
        <div class="dialog-head">
            <h2 id="problem-dialog-title" tabindex="-1">@OperatorLabels.Shell.ReportProblem</h2>
            <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
            </button>
        </div>
        <div class="dialog-body stack">
            <input type="hidden" name="returnUrl" value="" data-problem-return />
            <input type="hidden" name="route" value="" data-problem-route />
            <input type="hidden" name="method" value="@Model.Method" />
            <input type="hidden" name="traceId" value="@Model.TraceId" />
            <input type="hidden" name="caseReference" value="" data-problem-case />
            <input type="hidden" name="viewport" value="" data-problem-viewport />
            <input type="hidden" name="editing" value="false" data-problem-editing />
            <input type="hidden" name="errors" value="" data-problem-errors />
            <div class="field">
                <label for="problem-description">@OperatorLabels.ProblemReports.WhatHappened</label>
                <textarea id="problem-description" name="description" rows="6" maxlength="@Pegasus.Core.Support.ProblemReportPolicy.MaximumDescriptionLength" required></textarea>
            </div>
        </div>
        <div class="dialog-foot">
            <button type="button" class="btn" data-dialog-close>Cancel</button>
            <button type="submit" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Sending">@OperatorLabels.ProblemReports.Send</button>
        </div>
    </form>
</section>

@functions {
    // The Case sections never change while the process runs, so the list the
    // Report a problem script reads is joined once rather than on every fetch.
    private static readonly string CaseSectionKeys =
        string.Join(",", OperatorLabels.CaseWorkspace.Sections.Select(section => section.Key));
}
