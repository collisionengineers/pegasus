@model IReadOnlyList<Pegasus.Web.Presentation.GalleryImage>
@* Thumbnails are the full image CSS-constrained and lazy-loaded. Each tile
   stays a real link to the same authorised endpoint, so with no script it
   still opens the image exactly as it always did; site.js intercepts the
   click and opens the viewer over the page instead, paging within the
   [data-evidence-set] this list declares (DOCS-011). *@
@if (Model.Count > 0)
{
    <ul class="image-gallery" data-evidence-set>
        @foreach (var image in Model)
        {
            <li>
                <a href="@image.Href"
                   data-evidence-item
                   data-download-href="@image.DownloadHref"
                   data-media-type="@image.MediaType"
                   data-file-name="@image.FileName">
                    <img src="@image.Href" alt="@image.FileName" loading="lazy" />
                    <span class="image-gallery__name">@image.FileName</span>
                </a>
            </li>
        }
    </ul>
}
