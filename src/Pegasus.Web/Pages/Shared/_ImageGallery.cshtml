@model IReadOnlyList<Pegasus.Web.Presentation.GalleryImage>
@* Each tile stays a real link to the same authorised endpoint, so with no
   script it still opens the image exactly as it always did; site.js intercepts
   the click and opens the viewer over the page instead, paging within the
   [data-evidence-set] this list declares (DOCS-011).

   DOCS-015: the tile's img asks for the derived rendering where the route
   serves one, while the link the viewer and the download follow stays the full
   image. A file that has not reached durable custody yet has no image to ask
   for and renders as a placeholder naming it, rather than as a broken tile
   that changes on reload. *@
@if (Model.Count > 0)
{
    <ul class="gallery" data-evidence-set>
        @foreach (var image in Model)
        {
            <li>
                @if (!image.IsStored)
                {
                    <span class="gallery-item" data-gallery-placeholder>
                        <span class="gallery-image"></span>
                        <span class="gallery-caption">
                            <strong>@image.FileName</strong>
                            <small>Storing…</small>
                        </span>
                    </span>
                }
                else
                {
                    <a href="@image.Href"
                       class="gallery-item"
                       data-evidence-item
                       data-download-href="@image.DownloadHref"
                       data-media-type="@image.MediaType"
                       data-file-name="@image.FileName">
                        <span class="gallery-image"><img src="@(image.ThumbnailHref ?? image.Href)" alt="@image.FileName" loading="lazy" data-gallery-image /></span>
                        <span class="gallery-caption"><strong>@image.FileName</strong></span>
                    </a>
                }
            </li>
        }
    </ul>
}
