@*
    The single place a business or query state is drawn as a chip.

    Model: the exact state text to display. Business labels keep their settled
    casing (`Not ready`, `Review`, `With Engineer`, `Complete`, `Held`,
    `Unidentified`); this partial never rewrites the
    caller's words, it only picks a tone for them, through the one tone table
    in OperatorLabels.StatusTone, which the Inbox preview's JSON reads too so a
    chip repainted by script carries the same colour.

    ViewData["StatusCount"] — optional count appended in brackets.
    ViewData["StatusTone"]  — optional explicit tone override
                              (navy | amber | red | green | blue | neutral).

    Every chip carries its text label and the chip's own leading dot, so no
    state is conveyed by colour alone.
*@
@model string
@{
    var state = string.IsNullOrWhiteSpace(Model) ? "Unknown" : Model.Trim();
    var tone = Pegasus.Web.Presentation.OperatorLabels.StatusTone(state);

    if (ViewData["StatusTone"] is string toneOverride && !string.IsNullOrWhiteSpace(toneOverride))
    {
        tone = toneOverride;
    }

    var count = ViewData["StatusCount"] as int?;
    var displayText = count is { } suppliedCount && !state.Any(char.IsDigit)
        ? $"{state} ({suppliedCount})"
        : state;
}
<span class="status status--@tone">@displayText</span>
