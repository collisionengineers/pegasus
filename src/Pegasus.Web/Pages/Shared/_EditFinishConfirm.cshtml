@*
    Finishing edit mode with unsaved changes asks first.

    Rendered by the Case record. case-workspace.js finds this by id and asks
    it (Keep editing / Discard / Save) before an action would discard the
    Case's unsaved edits.
*@
<div id="edit-finish-confirm" class="reason-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="edit-finish-title" hidden>
    <div class="reason-dialog">
        <h2 id="edit-finish-title">Save your changes before finishing?</h2>
        <p>Values not saved are not kept.</p>
        <div class="button-row">
            <button type="button" class="btn" data-edit-finish-keep>Keep editing</button>
            <button type="button" class="btn" data-edit-finish-discard>Discard</button>
            <button type="button" class="btn btn--primary" data-edit-finish-save>Save changes</button>
        </div>
    </div>
</div>
