<!DOCTYPE html>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@{
    // A capability that is not composed in this deployment is absent, never a
    // disabled nav span: a permanently inert item says the product is broken
    // rather than that this deployment does not carry the feature.
    var inboxEnabled = Environment.IsProduction()
        || (Environment.IsDevelopment()
            && Configuration.GetValue<bool>("Features:LocalIntake"));

    // Marks the route the operator is on. aria-current is the accessible signal;
    // site.css pairs it with weight and an underline so it never relies on colour.
    var currentPage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    string? CurrentWhen(params string[] pagePrefixes) =>
        pagePrefixes.Any(prefix =>
            currentPage.Equals(prefix, StringComparison.OrdinalIgnoreCase)
            || currentPage.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase))
            ? "page"
            : null;
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Pegasus</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="Shared/_LucideSprite" />
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="app-nav">
        <div class="nav-inner">
            <a class="navbar-brand" asp-page="/Index" aria-label="Pegasus dashboard">
                <img src="~/images/logo_no_margin.png" asp-append-version="true" alt="Collision Engineers" />
                <span>Pegasus</span>
            </a>
            <nav class="nav-links" aria-label="Primary">
                <a class="nav-link" asp-page="/Index" aria-current="@CurrentWhen("/Index", "/Operations")">Dashboard</a>
                @if (inboxEnabled)
                {
                    <a class="nav-link" asp-page="/Intake/Index" aria-current="@CurrentWhen("/Intake", "/ImageIntake")">Inbox</a>
                    <a class="nav-link" asp-page="/Upload" aria-current="@CurrentWhen("/Upload")">Upload</a>
                }
                <a class="nav-link" asp-page="/Triage/Index" aria-current="@CurrentWhen("/Triage")">Queues</a>
                <a class="nav-link" asp-page="/Cases/Index" aria-current="@CurrentWhen("/Cases")">Cases</a>
                @if (User.IsInRole(Pegasus.Core.Identity.StaffRoleNames.Administrator))
                {
                    <a class="nav-link" asp-page="/Administration/Index" aria-current="@CurrentWhen("/Administration")">Administration</a>
                }
                @* Search is folded into Cases by the Cases page work; it keeps
                   its nav item until the redirect exists, because a page with
                   no way in is worse than one nav item too many. *@
                <a class="nav-link" asp-page="/Search/Index" aria-current="@CurrentWhen("/Search")">Search</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="user-menu" role="group" aria-label="User">
                        <span class="user-name">@User.Identity.Name</span>
                        <a class="nav-link" asp-page="/Account/PasswordChange">Change password</a>
                        <form method="post" asp-page="/Account/SignOut">
                            <button class="nav-link" type="submit">Sign out</button>
                        </form>
                    </span>
                }
                else
                {
                    <a class="nav-link" asp-page="/Account/SignIn">Sign in</a>
                }
            </nav>
        </div>
    </header>
    <div class="app-shell">
        <main id="main-content" tabindex="-1">
            @if (TempData["Confirmation"] is string confirmation)
            {
                @* One-time confirmation of an action completed on another page.
                   Green is the confirmed-completion role and is earned here. *@
                <p class="status-card status-card--done" role="status">
                    <svg class="icon" aria-hidden="true"><use href="#icon-check-circle" /></svg>
                    <span>@confirmation</span>
                </p>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="footer-inner">
            Pegasus · Collision Engineers case management
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
