<!DOCTYPE html>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@{
    var intakeEnabled = Environment.IsProduction()
        || (Environment.IsDevelopment()
            && Configuration.GetValue<bool>("Features:LocalIntake"));
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Pegasus</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="app-nav">
        <div class="nav-inner">
            <a class="navbar-brand" asp-page="/Index" aria-label="Pegasus Operations">
                <img src="~/images/logo_no_margin.png" asp-append-version="true" alt="Collision Engineers" />
                <span>Pegasus</span>
            </a>
            <nav class="nav-links" aria-label="Primary">
                <a class="nav-link" asp-page="/Index">Operations</a>
                @if (intakeEnabled)
                {
                    <a class="nav-link" asp-page="/Intake/Index">Intake</a>
                }
                else
                {
                    <span class="nav-link nav-link--unavailable" aria-disabled="true">Intake unavailable</span>
                }
                <a class="nav-link" asp-page="/Triage/Index">Triage</a>
                <a class="nav-link" asp-page="/Cases/Index">Cases</a>
                @if (User.IsInRole(Pegasus.Core.Identity.StaffRoleNames.Administrator))
                {
                    <a class="nav-link" asp-page="/Administration/Index">Administration</a>
                }
                <a class="nav-link" asp-page="/Search/Index">Search</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="user-menu" role="group" aria-label="User">
                        <span class="user-name">@User.Identity.Name</span>
                        <a class="nav-link" asp-page="/Account/PasswordChange">Change password</a>
                        <form method="post" asp-page="/Account/SignOut">
                            <button class="nav-link" type="submit">Sign out</button>
                        </form>
                    </span>
                }
                else
                {
                    <a class="nav-link" asp-page="/Account/SignIn">Sign in</a>
                }
            </nav>
        </div>
    </header>
    <div class="app-shell">
        <main id="main-content" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="footer-inner">
            Pegasus · Collision Engineers case management
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
