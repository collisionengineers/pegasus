<!DOCTYPE html>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@{
    // A capability that is not composed in this deployment is absent, never a
    // disabled nav span: a permanently inert item says the product is broken
    // rather than that this deployment does not carry the feature.
    var inboxEnabled = Environment.IsProduction()
        || (Environment.IsDevelopment()
            && Configuration.GetValue<bool>("Features:LocalIntake"));
    ViewData["ShellInboxEnabled"] = inboxEnabled;
    var isAdministrator = User.IsInRole(Pegasus.Core.Identity.StaffRoleNames.Administrator);

    // Marks the route the operator is on. aria-current is the accessible signal;
    // site.css pairs it with the white ground, the red left border and the red
    // icon well, so the current route is never signalled by colour alone.
    var currentPage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    string? CurrentWhen(params string[] pagePrefixes) =>
        pagePrefixes.Any(prefix =>
            currentPage.Equals(prefix, StringComparison.OrdinalIgnoreCase)
            || currentPage.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase))
            ? "page"
            : null;

    // A rail count is a real outstanding figure a page has already queried, not
    // a number the shell invents. FRD-12 forbids a stale zero placeholder, so an
    // absent count renders nothing at all rather than "0".
    var railCounts = ViewData["RailCounts"] as IReadOnlyDictionary<string, int>;
    int? CountFor(string key) =>
        railCounts is not null && railCounts.TryGetValue(key, out var value) ? value : null;

    // The request time is the freshness the shell can honestly state; it is
    // stamped by RailCountsPageFilter and falls back to now for the rare page
    // that renders outside the filter.
    var renderedAt = ViewData["ShellRenderedAtUtc"] as DateTimeOffset? ?? DateTimeOffset.UtcNow;
    var clock = OperatorLabels.OfficeClock(renderedAt);

    var userName = User.Identity?.Name ?? string.Empty;
    var role = OperatorLabels.StaffRole(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value);

    // A page that is a record announces itself so the workspace-tab strip can
    // remember it (site.js, max 4, LRU).
    var workspaceRecord = ViewData["WorkspaceRecord"] as (string Href, string Label)?;
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Pegasus</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/case-workspace.css" asp-append-version="true" />
</head>
<body>
    <partial name="Shared/_LucideSprite" />
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="app-shell" data-app-shell>
        <header class="app-rail">
            <a class="brand" asp-page="/Index" aria-label="Pegasus home">
                <img src="~/images/marks/pegasus-lockup.png" asp-append-version="true" alt="" aria-hidden="true" />
                <span class="brand-copy"><strong>PEGASUS</strong><span>Case management</span></span>
            </a>
            <nav class="primary-nav" aria-label="Primary">
                <div class="nav-label">@OperatorLabels.Nav.Work</div>
                <a class="nav-link" asp-page="/Index" aria-current="@CurrentWhen("/Index")">
                    <svg class="icon" aria-hidden="true"><use href="#icon-layout-dashboard" /></svg>
                    <span>@OperatorLabels.Nav.WorkCentre</span>
                </a>
                @if (inboxEnabled)
                {
                    <a class="nav-link" asp-page="/Mail/Index" aria-current="@CurrentWhen("/Mail")">
                        <svg class="icon" aria-hidden="true"><use href="#icon-inbox" /></svg>
                        <span>@OperatorLabels.Nav.Inbox</span>
                        @if (CountFor("Inbox") is { } inboxCount)
                        {
                            <span class="nav-count" aria-label="@inboxCount outstanding">@inboxCount</span>
                        }
                    </a>
                    <a class="nav-link" asp-page="/Upload" aria-current="@CurrentWhen("/Upload")">
                        <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                        <span>@OperatorLabels.Nav.Upload</span>
                    </a>
                }
                <a class="nav-link" asp-page="/Cases/Index" aria-current="@CurrentWhen("/Cases", "/Triage", "/Unidentified", "/ImageIntake", "/Intake")">
                    <svg class="icon" aria-hidden="true"><use href="#icon-list" /></svg>
                    <span>@OperatorLabels.Nav.Cases</span>
                    @if (CountFor("Cases") is { } casesCount)
                    {
                        <span class="nav-count" aria-label="@casesCount outstanding">@casesCount</span>
                    }
                </a>
                <a class="nav-link" asp-page="/Search/Index" aria-current="@CurrentWhen("/Search")">
                    <svg class="icon" aria-hidden="true"><use href="#icon-folder-open" /></svg>
                    <span>@OperatorLabels.Nav.Search</span>
                </a>
                @if (inboxEnabled)
                {
                    <a class="nav-link" asp-page="/Operations/Index" aria-current="@CurrentWhen("/Operations")">
                        <svg class="icon" aria-hidden="true"><use href="#icon-loader" /></svg>
                        <span>@OperatorLabels.Nav.Operations</span>
                        @if (CountFor("Operations") is { } operationsCount)
                        {
                            <span class="nav-count" aria-label="@operationsCount outstanding">@operationsCount</span>
                        }
                    </a>
                }
                @if (isAdministrator)
                {
                    <div class="nav-label">@OperatorLabels.Nav.Manage</div>
                    <a class="nav-link" asp-page="/Administration/Index" aria-current="@CurrentWhen("/Administration")">
                        <svg class="icon" aria-hidden="true"><use href="#icon-layout-grid" /></svg>
                        <span>@OperatorLabels.Nav.Administration</span>
                    </a>
                }
            </nav>
            <div class="rail-spacer"></div>
            <div class="rail-health">
                <div class="rail-health-line"><span class="health-dot"></span><span>@OperatorLabels.Freshness.Current · @clock</span></div>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="rail-user" role="group" aria-label="User">
                    <span class="avatar" aria-hidden="true">@OperatorLabels.Initials(userName)</span>
                    <div><strong>@userName</strong><small>@role</small></div>
                    <button type="button" class="icon-button" data-dialog-open="account-dialog" aria-label="Account menu">
                        <svg class="icon" aria-hidden="true"><use href="#icon-more-horizontal" /></svg>
                    </button>
                </div>
            }
        </header>
        <div class="app-column">
            <section class="utility-bar" aria-label="Utility bar">
                <div class="utility-freshness"><span class="health-dot"></span><span>@OperatorLabels.Freshness.Current · @clock</span></div>
                <form class="utility-search" role="search" method="get" action="/Search">
                    <label class="sr-only" for="global-search">Search Pegasus</label>
                    <svg class="icon" aria-hidden="true"><use href="#icon-search" /></svg>
                    <input id="global-search" type="search" name="query" data-command-input aria-label="Search Pegasus" autocomplete="off" />
                    <span class="shortcut-hint" aria-hidden="true">Ctrl K</span>
                </form>
                <div class="utility-actions">
                    <button type="button" class="btn btn--primary" data-dialog-open="add-dialog">
                        <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                        <span>Add</span>
                    </button>
                    <button type="button" class="icon-button" data-dialog-open="notifications-dialog" aria-label="Notifications">
                        <svg class="icon" aria-hidden="true"><use href="#icon-bell" /></svg>
                    </button>
                </div>
            </section>
            <nav class="workspace-tabs" aria-label="Open work" data-workspace-tabs>
                <a class="workspace-tab" asp-page="/Index" aria-current="@CurrentWhen("/Index")">
                    <svg class="icon" aria-hidden="true"><use href="#icon-layout-dashboard" /></svg>
                    <span>@OperatorLabels.Nav.WorkCentre</span>
                </a>
                <button type="button" class="workspace-tab" data-dialog-open="command-dialog" data-workspace-open aria-label="Open another record">
                    <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                    <span>Open</span>
                </button>
            </nav>
            @* Razor omits an attribute whose value is null, so a page that is
               not a record renders a plain main. *@
            <main id="main-content" class="app-main" tabindex="-1"
                  data-workspace-record="@(workspaceRecord is null ? null : "true")"
                  data-workspace-href="@workspaceRecord?.Href"
                  data-workspace-label="@workspaceRecord?.Label">
                <div class="content">
                    @if (TempData["Confirmation"] is string confirmation)
                    {
                        @* One-time confirmation of an action completed on another
                           page. Green is the confirmed-completion role and is
                           earned here; site.js also raises it as a toast. *@
                        <div class="notice notice--success mb-2" role="status" data-confirmation>
                            <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                            <span>@confirmation</span>
                        </div>
                    }
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
    <partial name="Shared/_ShellDialogs" />
    <div class="toast-region" aria-live="polite" data-toast-region></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
