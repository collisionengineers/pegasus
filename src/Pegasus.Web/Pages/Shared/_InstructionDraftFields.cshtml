@model Pegasus.Web.Presentation.InstructionDraftFieldsView
@*
    The eleven instruction values, once. The create screen and the correction
    form on a blocked received item both render this; a second copy would be a
    second place to forget a field or let the two screens disagree about what
    "required" means.
*@
@{
    var draft = Model.Draft;
}

@if (Model.IncludePrincipalCode)
{
    <label for="draft-suggested-principal-code">Suggested principal code</label>
    <input id="draft-suggested-principal-code" name="SuggestedPrincipalCode" value="@draft?.SuggestedPrincipalCode" maxlength="20" autocomplete="off" />
    @foreach (var candidate in Model.CandidatesFor("Suggested principal"))
    {
        <small>Extracted from @candidate.SourceLabel: @candidate.Value</small>
    }
}

<label for="draft-claimant-name">Claimant name</label>
<input id="draft-claimant-name" name="ClaimantName" value="@draft?.ClaimantName" maxlength="200" autocomplete="off" />
<small>@Model.ProvenanceWord("Claimant name")</small>
@foreach (var candidate in Model.CandidatesFor("Claimant name"))
{
    <small>Extracted from @candidate.SourceLabel: @candidate.Value</small>
}

<label for="draft-claim-number">Claim number</label>
<input id="draft-claim-number" name="ClaimNumber" value="@draft?.ClaimNumber" maxlength="100" autocomplete="off" />
<small>@Model.ProvenanceWord("Claim number")</small>
@foreach (var candidate in Model.CandidatesFor("Claim number"))
{
    <small>Extracted from @candidate.SourceLabel: @candidate.Value</small>
}

