@if (!ViewData.ModelState.IsValid)
{
    <div class="validation-summary" role="alert" aria-live="assertive" tabindex="-1">
        <h2 class="validation-summary__heading">
            <svg class="icon" aria-hidden="true"><use href="#icon-alert-circle"/></svg>
            <span>Please correct the following errors:</span>
        </h2>
        <ul class="validation-summary__list">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}
