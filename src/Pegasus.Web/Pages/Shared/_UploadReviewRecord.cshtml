@*
    The Image intake the upload registered automatically: a subordinate record
    link under the Case decision, never a second decision.

    Model: Pegasus.Web.Presentation.UploadReviewRecord
*@
@model Pegasus.Web.Presentation.UploadReviewRecord
@using Labels = Pegasus.Web.Presentation.OperatorLabels.Upload
<div class="up-record" data-upload-record>
    <svg class="icon" aria-hidden="true"><use href="#icon-images" /></svg>
    <div class="up-record-copy">
        <small>@Labels.ImageIntake</small>
        <a class="up-text-link mono" href="@Model.Url">@Model.Reference<svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg></a>
        <p>@Model.Detail</p>
    </div>
</div>
