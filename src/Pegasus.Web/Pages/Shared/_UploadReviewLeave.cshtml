@*
    Leave undecided returns to Upload and changes nothing (FRD-18 Cancel);
    Discard upload is separate from the primary flow and opens its own
    confirmation, offered only when the whole submission can be discarded.

    Model: Pegasus.Web.Presentation.UploadReviewView
*@
@model Pegasus.Web.Presentation.UploadReviewView
@using Labels = Pegasus.Web.Presentation.OperatorLabels.Upload
<div class="up-leave">
    <a class="btn" asp-page="/Upload" data-upload-leave>@Labels.LeaveUndecided</a>
    @if (Model.OffersDiscard)
    {
        <a class="up-discard" href="@Model.PageUrl?discard=true" data-upload-dialog="upload-discard">@Labels.Discard</a>
    }
</div>
