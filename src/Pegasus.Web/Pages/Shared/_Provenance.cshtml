@using Pegasus.Core.Cases
@using Pegasus.Web.Presentation
@*
    Where a value came from: a small icon whose tooltip — on hover and on
    keyboard focus, with a matching accessible name — is exactly one word.

    It replaces prose in a third column plus a policy key and a version
    integer, none of which an operator can act on. The row must still make
    sense with the icon ignored, so this is always supplementary: a value is
    still a value without it.

    The word-and-glyph map lives in OperatorLabels.Provenance so that views
    which cannot invoke a partial — a Razor local function rendering many rows —
    read from the same table rather than keeping a second copy of it.
*@
@model CaseDataSource?
@{
    var (word, icon) = OperatorLabels.Provenance(Model);
}
<span class="prov" tabindex="0" role="img" aria-label="@word" data-word="@word">
    <svg class="icon" aria-hidden="true"><use href="#@icon" /></svg>
</span>
