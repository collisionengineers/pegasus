@*
    Last-good time and the manual refresh that reruns the same filter.

    A compact corner element, not a full-width banner: a strip across the top of
    every screen spent the most valuable row on the page saying nothing changed.
    The redundant "Current" badge is gone with it — a loaded query says so by
    showing its number and its time. Only the states that are not current earn a
    chip.

    Model: the last successful load time, or null when nothing has loaded.
    ViewData["RefreshStatus"] — current | loading | stale | partial |
                               unavailable | failed.

    Times render in Europe/London because that is the day boundary the counts
    are taken against. When the platform carries no IANA database the zone
    cannot be resolved, and the label says UTC rather than claiming London for
    a time that is not London.
*@
@model DateTimeOffset?
@{
    var status = ViewData["RefreshStatus"] as string ?? "current";

    TimeZoneInfo londonZone;
    var zoneResolved = true;
    try
    {
        londonZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/London");
    }
    catch (TimeZoneNotFoundException)
    {
        londonZone = TimeZoneInfo.Utc;
        zoneResolved = false;
    }
    catch (InvalidTimeZoneException)
    {
        londonZone = TimeZoneInfo.Utc;
        zoneResolved = false;
    }

    var zoneLabel = zoneResolved ? "London" : "UTC";
    var london = Model.HasValue
        ? TimeZoneInfo.ConvertTime(Model.Value, londonZone)
        : (DateTimeOffset?)null;

    var statusLabel = status switch
    {
        "loading" => "Refreshing",
        "stale" => "Stale",
        "partial" => "Partial",
        "unavailable" => "Unavailable",
        "failed" => "Failed",
        _ => null
    };
}
<div class="refresh" data-refresh-region role="status" aria-live="polite">
    @if (london is { } lastGood)
    {
        <span>
            Updated
            <time datetime="@lastGood.ToString("O")">@lastGood.ToString("d MMM HH:mm")</time>
            @zoneLabel
        </span>
    }
    else
    {
        <span>Never updated</span>
    }
    @if (statusLabel is not null)
    {
        <partial name="Shared/_StatusChip" model="@statusLabel" />
    }
    <form method="get" data-refresh-form>
        <button type="submit" title="Refresh" aria-label="Refresh">
            <svg class="icon icon--spin" aria-hidden="true"><use href="#icon-refresh-cw" /></svg>
            <span class="vh" data-refresh-label>Refresh</span>
        </button>
    </form>
</div>
