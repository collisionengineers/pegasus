@*
    Freshness: the last-good time and the manual refresh that reruns the same
    filter. A dot and "Current · HH:MM" in the page actions; only a state that
    is not current earns a notice beside it.

    Model: the last successful load time, or null when nothing has loaded.
    ViewData["RefreshStatus"] — current | loading | stale | partial |
                               unavailable | failed.
    ViewData["RefreshFields"] — optional IReadOnlyDictionary<string, string?>
                                rendered as hidden inputs, so a GET refresh
                                reloads the filter and page the operator is on
                                rather than resetting the screen.

    Times render in Europe/London through OperatorLabels.OfficeClock, the one
    conversion every operator time surface uses.
*@
@model DateTimeOffset?
@{
    var status = ViewData["RefreshStatus"] as string ?? "current";
    var statusLabel = OperatorLabels.Freshness.Label(status);
    var dotModifier = status switch
    {
        "stale" or "partial" => "partial",
        "failed" or "unavailable" => "failed",
        _ => null
    };
    var text = Model is { } lastGood
        ? $"{statusLabel} · {OperatorLabels.OfficeClock(lastGood)}"
        : OperatorLabels.Freshness.Never;
    var noticeTone = status switch
    {
        "stale" or "partial" => "notice--warning",
        "failed" or "unavailable" => "notice--danger",
        _ => null
    };
}
<div class="freshness" data-refresh-region role="status" aria-live="polite">
    <span class="health-dot @dotModifier"></span>
    @if (Model is { } lastGoodTime)
    {
        <span><time datetime="@lastGoodTime.ToString("O")">@text</time></span>
    }
    else
    {
        <span>@text</span>
    }
    @if (noticeTone is not null)
    {
        <span class="status status--@(noticeTone == "notice--danger" ? "red" : "amber")">@statusLabel</span>
    }
    <form method="get" data-refresh-form>
        @if (ViewData["RefreshFields"] is IReadOnlyDictionary<string, string?> refreshFields)
        {
            @* A bare GET form submits nothing, so refreshing used to drop the
               active filter and page and drop the operator back on page one of
               everything. *@
            foreach (var field in refreshFields.Where(item => !string.IsNullOrWhiteSpace(item.Value)))
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
        }
        <button type="submit" class="btn btn--small" title="Refresh">
            <svg class="icon icon--spin" aria-hidden="true"><use href="#icon-refresh-cw" /></svg>
            <span data-refresh-label>Refresh</span>
        </button>
    </form>
</div>
