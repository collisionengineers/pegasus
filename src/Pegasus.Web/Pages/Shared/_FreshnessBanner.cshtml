@*
    Freshness: the last-good time and the manual refresh that reruns the same
    filter. A dot and "Current · HH:MM" in the page actions; only a state that
    is not current earns a notice beside it.

    Model: the last successful load time, or null when nothing has loaded.
    ViewData["RefreshStatus"] — current | loading | stale | partial |
                               unavailable | failed.
    ViewData["RefreshFields"] — passed through to Shared/_RefreshButton as the
                                hidden inputs that replay the current filter
                                and page on a GET refresh.

    Times render in Europe/London through OperatorLabels.OfficeClock, the one
    conversion every operator time surface uses.
*@
@model DateTimeOffset?
@{
    var status = ViewData["RefreshStatus"] as string ?? "current";
    var statusLabel = OperatorLabels.Freshness.Label(status);
    // Set by a caller whose header also carries its own action buttons
    // (e.g. Compose): keeps Refresh grouped with those buttons and moves
    // this status text to sit apart from them, rather than between two
    // buttons.
    var actionsFirst = ViewData["FreshnessActionsFirst"] is true;
    var dotModifier = status switch
    {
        "stale" or "partial" => "partial",
        "failed" or "unavailable" => "failed",
        _ => null
    };
    var noticeTone = status switch
    {
        "stale" or "partial" => "notice--warning",
        "failed" or "unavailable" => "notice--danger",
        _ => null
    };
}
<div class="freshness @(actionsFirst ? "freshness--actions-first" : null)">
    <span class="freshness-status">
        <span class="health-dot @dotModifier"></span>
        @if (Model is { } lastGoodTime)
        {
            <span><time datetime="@lastGoodTime.ToString("O")">@statusLabel · @OperatorLabels.OfficeClock(lastGoodTime)</time></span>
        }
        else
        {
            <span>@OperatorLabels.Freshness.Never</span>
        }
        @if (noticeTone is not null)
        {
            <span class="status status--@(noticeTone == "notice--danger" ? "red" : "amber")">@statusLabel</span>
        }
    </span>
    <partial name="Shared/_RefreshButton" />
</div>
