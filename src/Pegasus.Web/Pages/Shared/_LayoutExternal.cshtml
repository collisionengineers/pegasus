<!DOCTYPE html>
@*
    The frame for the one screen a third party outside Collision Engineers
    ever sees: the public upload link (§1.10). It carries the company, not the
    product: no product name, no navigation, no sign-in.
*@
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Collision Engineers</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="Shared/_LucideSprite" />
    <div class="external-shell">
        <main id="main-content" tabindex="-1">
            <section class="auth-card auth-card--wide">
                <div class="auth-brand">
                    <img src="~/images/logo_no_margin.png" asp-append-version="true" alt="Collision Engineers" />
                </div>
                @RenderBody()
            </section>
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
