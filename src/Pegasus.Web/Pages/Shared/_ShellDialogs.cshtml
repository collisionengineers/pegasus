@*
    The three shell dialogs: account menu, Notifications (the bell) and the
    command palette. Each is a hidden .dialog-backdrop that site.js opens from any
    [data-dialog-open="<id>"] control, closes on [data-dialog-close], Escape
    or a backdrop click, contains focus, sets inert on the shell while open,
    and returns focus to the invoking control. Rendered once per page by
    _Layout; the gating below mirrors the rail exactly.
*@
@{
    var inboxEnabled = ViewData["ShellInboxEnabled"] is true;
    var isAdministrator = User.IsInRole(Pegasus.Core.Identity.StaffRoleNames.Administrator);
    var userName = User.Identity?.Name ?? string.Empty;
    var role = OperatorLabels.StaffRole(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value);
    // The bell (Work Centre D10): the person's own notifications, newest
    // first, read once by RailCountsPageFilter. Each row is a form that opens
    // the notification (marks it read, lands on its route) so no script is
    // needed; Mark all read returns here.
    var notifications = ViewData["Notifications"] as IReadOnlyList<Pegasus.Core.Notifications.StaffNotification>;
    var notificationsUnavailable = ViewData["NotificationsUnavailable"] is true;
    var anyUnread = notifications?.Any(notification => notification.IsUnread) == true;
    var now = ViewData["ShellRenderedAtUtc"] as DateTimeOffset? ?? DateTimeOffset.UtcNow;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    // ?notifications=1 opens the dialog on load, so a link (or a screenshot)
    // can land on it.
    var openOnLoad = string.Equals(Context.Request.Query["notifications"], "1", StringComparison.Ordinal) ? "true" : null;
    // What's new (FRD-12): the newest published release note this person has
    // not acknowledged, read once by RailCountsPageFilter. It opens on load
    // until Got it is pressed; the page behind it is the one they asked for.
    var releaseNote = ViewData["ReleaseNote"] as Pegasus.Core.ReleaseNotes.ReleaseNote;
}

<div class="dialog-backdrop" data-dialog="account-dialog" hidden>
    <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="account-dialog-title">
        <div class="dialog-head">
            <h2 id="account-dialog-title" tabindex="-1">Account</h2>
            <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
            </button>
        </div>
        <div class="dialog-body">
            <div class="definition-list">
                <dl class="definition"><dt>Name</dt><dd>@userName</dd></dl>
                <dl class="definition"><dt>Role</dt><dd>@role</dd></dl>
                <dl class="definition"><dt>Idle lock</dt><dd>@OperatorLabels.Duration(Pegasus.Core.Actors.StaffSessionPolicy.IdleLifetime)</dd></dl>
            </div>
        </div>
        <div class="dialog-foot">
            <button type="button" class="btn" data-dialog-close>Close</button>
            <a class="btn" asp-page="/ReleaseNotes">
                <svg class="icon" aria-hidden="true"><use href="#icon-flag" /></svg>
                <span>@OperatorLabels.Shell.ReleaseNotes</span>
            </a>
            <a class="btn" asp-page="/Account/PasswordChange">
                <svg class="icon" aria-hidden="true"><use href="#icon-key" /></svg>
                <span>Change password</span>
            </a>
            <form method="post" asp-page="/Account/SignOut">
                <button type="submit" class="btn btn--danger">
                    <svg class="icon" aria-hidden="true"><use href="#icon-log-out" /></svg>
                    <span>Sign out</span>
                </button>
            </form>
        </div>
    </section>
</div>

<div class="dialog-backdrop" data-dialog="notifications-dialog" data-dialog-open-on-load="@openOnLoad" hidden>
    <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="notifications-dialog-title">
        <div class="dialog-head">
            <h2 id="notifications-dialog-title" tabindex="-1">@OperatorLabels.Shell.Notifications</h2>
            <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
            </button>
        </div>
        <div class="dialog-body dialog-body--list">
            @if (notificationsUnavailable)
            {
                <p class="empty-state" role="status">@OperatorLabels.Shell.NotificationsUnavailable</p>
            }
            else if (notifications is { Count: > 0 })
            {
                <div class="row-list" data-row-list data-notification-list>
                    @foreach (var notification in notifications)
                    {
                        <form method="post" asp-page="/Notifications" asp-page-handler="Open" asp-route-id="@notification.Id" class="row-form">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="row-button@(notification.IsUnread ? " row-button--unread" : "")" data-notification="@notification.Id">
                                <span class="title">@OperatorLabels.NotificationCause(notification)</span>
                                <span class="sub"><span class="ref">@notification.Reference</span>@if (!string.IsNullOrWhiteSpace(notification.Registration)){<text> · <span class="mono">@notification.Registration</span></text>}</span>
                                <span class="side">
                                    @if (notification.IsUnread)
                                    {
                                        <span class="status status--navy">@OperatorLabels.Shell.Unread</span>
                                    }
                                    <time datetime="@notification.RaisedAtUtc.ToString("O")" title="@OperatorLabels.OfficeTime(notification.RaisedAtUtc)">@OperatorLabels.RelativeTime(notification.RaisedAtUtc, now)</time>
                                </span>
                            </button>
                        </form>
                    }
                </div>
            }
            else
            {
                <p class="empty-state" role="status">@OperatorLabels.Shell.NoNotifications</p>
            }
        </div>
        <div class="dialog-foot">
            @if (anyUnread)
            {
                <form method="post" asp-page="/Notifications" asp-page-handler="MarkAllRead" class="left">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn">@OperatorLabels.Shell.MarkAllRead</button>
                </form>
            }
            <button type="button" class="btn btn--dark" data-dialog-close>Close</button>
        </div>
    </section>
</div>

<div class="dialog-backdrop" data-dialog="command-dialog" hidden>
    <section class="dialog command-dialog" role="dialog" aria-modal="true" aria-labelledby="command-dialog-title">
        <div class="dialog-head">
            <h2 id="command-dialog-title" tabindex="-1">Search Pegasus</h2>
            <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
            </button>
        </div>
        <div class="command-search">
            <label class="sr-only" for="command-input">Search</label>
            <input id="command-input" type="search" autocomplete="off" data-command-palette-input aria-controls="command-results" />
        </div>
        <div id="command-results" class="command-results" role="listbox" aria-label="Search results" data-command-results>
            <button type="button" class="command-result" role="option" aria-selected="false" data-route="/">
                <svg class="icon" aria-hidden="true"><use href="#icon-layout-dashboard" /></svg>
                <span><strong>@OperatorLabels.Nav.WorkCentre</strong></span>
            </button>
            @if (inboxEnabled)
            {
                <button type="button" class="command-result" role="option" aria-selected="false" data-route="/Inbox">
                    <svg class="icon" aria-hidden="true"><use href="#icon-inbox" /></svg>
                    <span><strong>@OperatorLabels.Nav.Inbox</strong></span>
                </button>
                <button type="button" class="command-result" role="option" aria-selected="false" data-route="/Upload">
                    <svg class="icon" aria-hidden="true"><use href="#icon-upload" /></svg>
                    <span><strong>@OperatorLabels.Nav.Upload</strong></span>
                </button>
            }
            <button type="button" class="command-result" role="option" aria-selected="false" data-route="/Cases">
                <svg class="icon" aria-hidden="true"><use href="#icon-list" /></svg>
                <span><strong>@OperatorLabels.Nav.Cases</strong></span>
            </button>
            <button type="button" class="command-result" role="option" aria-selected="false" data-route="/Search">
                <svg class="icon" aria-hidden="true"><use href="#icon-folder-open" /></svg>
                <span><strong>@OperatorLabels.Nav.Search</strong></span>
            </button>
            @if (inboxEnabled)
            {
                <button type="button" class="command-result" role="option" aria-selected="false" data-route="/Operations">
                    <svg class="icon" aria-hidden="true"><use href="#icon-loader" /></svg>
                    <span><strong>@OperatorLabels.Nav.Operations</strong></span>
                </button>
            }
            @if (isAdministrator)
            {
                <button type="button" class="command-result" role="option" aria-selected="false" data-route="/Administration">
                    <svg class="icon" aria-hidden="true"><use href="#icon-layout-grid" /></svg>
                    <span><strong>@OperatorLabels.Nav.Administration</strong></span>
                </button>
            }
            @* The fallback is always a match: it carries the typed text to
               /Search so Enter never dead-ends. *@
            <button type="button" class="command-result" role="option" aria-selected="false" data-route="/Search?query=" data-command-fallback>
                <svg class="icon" aria-hidden="true"><use href="#icon-search" /></svg>
                <span><strong>Search Cases for <span data-command-fallback-term></span></strong></span>
                <span class="kbd" aria-hidden="true">Enter</span>
            </button>
        </div>
    </section>
</div>

@if (releaseNote is not null)
{
    <div class="dialog-backdrop" data-dialog="whats-new-dialog" data-dialog-open-on-load="true" hidden>
        <section class="dialog release-note" role="dialog" aria-modal="true" aria-labelledby="whats-new-dialog-title" data-release-note="@releaseNote.Id">
            <div class="dialog-head">
                <h2 id="whats-new-dialog-title" tabindex="-1">@OperatorLabels.Shell.WhatsNew</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </div>
            <div class="dialog-body stack release-note__body">
                <h3>@releaseNote.Title</h3>
                <p class="muted"><time datetime="@releaseNote.PublishedAtUtc?.ToString("O")">@OperatorLabels.OfficeTime(releaseNote.PublishedAtUtc, string.Empty)</time>@if (!string.IsNullOrWhiteSpace(releaseNote.Version)){<text> · </text><span class="mono">@releaseNote.Version</span>}</p>
                <partial name="Shared/_ReleaseNoteBody" model="@releaseNote.Body" />
            </div>
            <div class="dialog-foot">
                <a class="btn left" asp-page="/ReleaseNotes">@OperatorLabels.Shell.ReleaseNotes</a>
                <form method="post" asp-page="/ReleaseNotes" asp-page-handler="Acknowledge" asp-route-id="@releaseNote.Id">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn--dark" data-release-note-acknowledge>@OperatorLabels.Shell.GotIt</button>
                </form>
            </div>
        </section>
    </div>
}
