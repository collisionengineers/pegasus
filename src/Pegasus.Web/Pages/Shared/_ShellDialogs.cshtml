@*
    The shell dialogs: account menu, Notifications (the bell), command palette,
    What's new and Report a problem. Each is a hidden .dialog-backdrop that
    site.js opens from any [data-dialog-open="<id>"] control, closes on
    [data-dialog-close], Escape or a backdrop click, contains focus, sets inert
    on the shell while open, and returns focus to the invoking control.
    Rendered once per page by _Layout; the gating mirrors the rail exactly.

    The Account, command palette and Report a problem dialogs are empty
    backdrops here: site.js fetches the one in [data-dialog-fragment] the first
    time it opens (/Notifications?handler=ShellDialog, drawn by
    _ShellAccountDialog, _ShellCommandDialog and _ShellProblemDialog), so a
    page carries a few attributes rather than their markup.
*@
@{
    // The bell (Work Centre D10): the person's own notifications. The page
    // carries the unread count ShellPageFilter counted; the list is fetched
    // when the bell opens (/Notifications?handler=List, drawn by
    // _NotificationList, whose rows are forms that open the notification so
    // no script is needed to act on one). Mark all read returns here.
    var notifications = ViewData["Notifications"] as IReadOnlyList<Pegasus.Core.Notifications.StaffNotification>;
    var notificationsUnavailable = ViewData["NotificationsUnavailable"] is true;
    var anyUnread = ViewData["NotificationsUnread"] is int unreadCount && unreadCount > 0;
    var now = ViewData["ShellRenderedAtUtc"] as DateTimeOffset? ?? DateTimeOffset.UtcNow;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    // ?notifications=1 opens the dialog on load, so a link (or a screenshot)
    // can land on it; that page draws the list itself rather than fetching it.
    var openOnLoad = string.Equals(Context.Request.Query["notifications"], "1", StringComparison.Ordinal) ? "true" : null;
    // What's new (FRD-12): the newest published release note this person has
    // not acknowledged, read once by ShellPageFilter. It opens on load
    // until Got it is pressed; the page behind it is the one they asked for.
    var releaseNote = ViewData["ReleaseNote"] as Pegasus.Core.ReleaseNotes.ReleaseNote;
    // The Report a problem report names the page it was opened on, not the
    // fetch that draws the dialog.
    var traceId = System.Diagnostics.Activity.Current?.Id ?? Context.TraceIdentifier;
    var accountDialogUrl = Url.Page("/Notifications", "ShellDialog", new { name = "account" });
    var commandDialogUrl = Url.Page("/Notifications", "ShellDialog", new { name = "command" });
    var problemDialogUrl = Url.Page("/Notifications", "ShellDialog", new { name = "problem", traceId, method = Context.Request.Method });
}

<div class="dialog-backdrop" data-dialog="account-dialog" data-dialog-fragment="@accountDialogUrl" hidden></div>

<div class="dialog-backdrop" data-dialog="notifications-dialog" data-dialog-open-on-load="@openOnLoad" data-notifications-url="@Url.Page("/Notifications", "List")" data-notifications-failed="@OperatorLabels.Shell.NotificationsUnavailable" hidden>
    <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="notifications-dialog-title">
        <div class="dialog-head">
            <h2 id="notifications-dialog-title" tabindex="-1">@OperatorLabels.Shell.Notifications</h2>
            @* Mark all read sits in the head (v41 S2); the foot keeps Close. *@
            @if (anyUnread)
            {
                <form method="post" asp-page="/Notifications" asp-page-handler="MarkAllRead">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn" data-busy-label="@OperatorLabels.Busy.Marking">@OperatorLabels.Shell.MarkAllRead</button>
                </form>
            }
            <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
            </button>
        </div>
        @if (notificationsUnavailable)
        {
            <div class="dialog-body dialog-body--list">
                <p class="empty-state" role="status">@OperatorLabels.Shell.NotificationsUnavailable</p>
            </div>
        }
        else if (notifications is not null)
        {
            <div class="dialog-body dialog-body--list" data-notifications-body>
                <partial name="Shared/_NotificationList" model="@(new NotificationListView(notifications, returnUrl, now))" />
            </div>
        }
        else
        {
            <div class="dialog-body dialog-body--list" data-notifications-body aria-busy="true">
                <div class="spinner" aria-hidden="true"></div>
            </div>
        }
        <div class="dialog-foot">
            <button type="button" class="btn btn--dark" data-dialog-close>Close</button>
        </div>
    </section>
</div>

<div class="dialog-backdrop" data-dialog="command-dialog" data-dialog-fragment="@commandDialogUrl" hidden></div>

@if (releaseNote is not null)
{
    <div class="dialog-backdrop" data-dialog="whats-new-dialog" data-dialog-open-on-load="true" hidden>
        <section class="dialog release-note" role="dialog" aria-modal="true" aria-labelledby="whats-new-dialog-title" data-release-note="@releaseNote.Id">
            <div class="dialog-head">
                <h2 id="whats-new-dialog-title" tabindex="-1">@OperatorLabels.Shell.WhatsNew</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-x")" /></svg>
                </button>
            </div>
            <div class="dialog-body stack release-note__body">
                <h3>@releaseNote.Title</h3>
                <p class="muted"><time datetime="@releaseNote.PublishedAtUtc?.ToString("O")">@OperatorLabels.OfficeTime(releaseNote.PublishedAtUtc, string.Empty)</time>@if (!string.IsNullOrWhiteSpace(releaseNote.Version)){<text> · </text><span class="mono">@releaseNote.Version</span>}</p>
                <partial name="Shared/_ReleaseNoteBody" model="@releaseNote.Body" />
            </div>
            <div class="dialog-foot">
                <a class="btn left" asp-page="/ReleaseNotes">@OperatorLabels.Shell.ReleaseNotes</a>
                <form method="post" asp-page="/ReleaseNotes" asp-page-handler="Acknowledge" asp-route-id="@releaseNote.Id">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn--dark" data-release-note-acknowledge data-busy-label="@OperatorLabels.Busy.Saving">@OperatorLabels.Shell.GotIt</button>
                </form>
            </div>
        </section>
    </div>
}

<div class="dialog-backdrop" data-dialog="problem-dialog" data-dialog-fragment="@problemDialogUrl" hidden></div>
