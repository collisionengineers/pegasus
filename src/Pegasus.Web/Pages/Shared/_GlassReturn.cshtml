@model string
@* Return to the owning Case in place, preserving its unsaved edits. A
   departed opener or a browser without script uses the server-rendered link. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Pegasus</title>
</head>
<body data-glass-return="@Model">
    <p>Returning to the Case. <a href="@Model">Open the Case</a>.</p>
    <script src="~/js/glass-return.js" asp-append-version="true"></script>
</body>
</html>
