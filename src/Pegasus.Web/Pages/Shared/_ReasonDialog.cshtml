@*
    Reason dialog.

    docs/design/README.md#ui-specification requires a named requirement and consequence, a
    labelled reason, confirmation and cancel, initial focus, focus containment,
    Escape where safe, and focus return to the invoking control.

    Open it from any control carrying `data-dialog-open="<DialogId>"`; the
    script below handles the rest and needs no inline handler.
*@
@{
    var dialogId = ViewData["DialogId"] as string ?? "reasonModal";
    var title = ViewData["DialogTitle"] as string ?? "Required Reason";
    var actionUrl = ViewData["DialogActionUrl"] as string ?? "#";
    var consequence = ViewData["DialogConsequence"] as string;
    var hiddenFields = ViewData["DialogHiddenFields"] as IReadOnlyDictionary<string, string?>
        ?? new Dictionary<string, string?>();
}
<div id="@dialogId" class="reason-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="@(dialogId)_title" data-reason-dialog hidden>
    <div class="reason-dialog">
        <h2 id="@(dialogId)_title" class="reason-dialog__title">
            <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle"/></svg>
            <span>@title</span>
        </h2>
        @if (!string.IsNullOrWhiteSpace(consequence))
        {
            <p class="notice">@consequence</p>
        }
        <form method="post" action="@actionUrl" class="form-grid">
            @Html.AntiForgeryToken()
            @foreach (var field in hiddenFields)
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
            <div>
                @* `--red` was never declared, so the required marker rendered in
                   the inherited text colour. It now uses the same approved dark
                   red as every other validation cue. *@
                <label for="@(dialogId)_reason">
                    Reason for action
                    <span class="field-validation" aria-hidden="true">*</span>
                </label>
                <textarea id="@(dialogId)_reason" name="Reason" rows="3" required></textarea>
            </div>
            <div class="button-row button-row--end">
                <button type="button" class="secondary-action" data-dialog-dismiss>Cancel</button>
                <button type="submit" class="primary-action">Confirm Action</button>
            </div>
        </form>
    </div>
</div>
