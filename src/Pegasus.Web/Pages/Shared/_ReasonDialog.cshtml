@{
    var dialogId = ViewData["DialogId"] as string ?? "reasonModal";
    var title = ViewData["DialogTitle"] as string ?? "Required Reason";
    var actionUrl = ViewData["DialogActionUrl"] as string ?? "#";
    var consequence = ViewData["DialogConsequence"] as string ?? "A reason is required to perform this permanent business action.";
}
<div id="@dialogId" class="reason-dialog-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="@(dialogId)_title">
    <div class="reason-dialog">
        <h2 id="@(dialogId)_title" style="margin-top: 0; display: flex; align-items: center; gap: 0.5rem;">
            <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle"/></svg>
            <span>@title</span>
        </h2>
        <p class="notice">@consequence</p>
        <form method="post" action="@actionUrl" class="form-grid">
            @Html.AntiForgeryToken()
            <div>
                <label for="@(dialogId)_reason">Reason for action <span style="color: var(--red);">*</span></label>
                <textarea id="@(dialogId)_reason" name="Reason" rows="3" required placeholder="Enter clear business reason…"></textarea>
            </div>
            <div class="button-row" style="justify-content: flex-end;">
                <button type="button" class="secondary-action" onclick="document.getElementById('@dialogId').style.display='none';">Cancel</button>
                <button type="submit" class="primary-action">Confirm Action</button>
            </div>
        </form>
    </div>
</div>
