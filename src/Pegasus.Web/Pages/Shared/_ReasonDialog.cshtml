@*
    Reason dialog.

    docs/design/README.md requires a named requirement and consequence, a
    labelled reason, confirmation and cancel, initial focus, focus containment,
    Escape where safe, and focus return to the invoking control.

    Open it from any control carrying `data-dialog-open="<DialogId>"`; the
    generalised [data-dialog] behaviour in site.js handles the rest (the
    [data-reason-dialog] alias is kept for the pages that still bind on it).
*@
@{
    var dialogId = ViewData["DialogId"] as string ?? "reasonModal";
    var title = ViewData["DialogTitle"] as string ?? "Required Reason";
    var actionUrl = ViewData["DialogActionUrl"] as string ?? "#";
    var hiddenFields = ViewData["DialogHiddenFields"] as IReadOnlyDictionary<string, string?>
        ?? new Dictionary<string, string?>();
    // Supplied only where an action has a consequence from the approved
    // necessary-copy list; absent otherwise (INTK-029).
    var consequence = ViewData["DialogConsequence"] as string;
    var reasonMaxLength = ViewData["DialogReasonMaxLength"] as int? ?? 500;
    var reason = ViewData["DialogReason"] as string ?? string.Empty;
}
<div id="@dialogId" class="dialog-backdrop" data-dialog="@dialogId" data-reason-dialog hidden>
    <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="@(dialogId)_title">
        <div class="dialog-head">
            <h2 id="@(dialogId)_title" tabindex="-1">@title</h2>
            <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
            </button>
        </div>
        <form method="post" action="@actionUrl">
            @Html.AntiForgeryToken()
            @foreach (var field in hiddenFields)
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
            <div class="dialog-body stack">
                @if (!string.IsNullOrWhiteSpace(consequence))
                {
                    <div class="notice notice--warning">
                        <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                        <span>@consequence</span>
                    </div>
                }
                <div class="field">
                    <label class="req" for="@(dialogId)_reason">Reason for action</label>
                    @* Schema-backed callers retain the 500-character default;
                       callers with a distinct Core policy supply its limit. *@
                    <textarea id="@(dialogId)_reason" name="Reason" rows="3" required maxlength="@reasonMaxLength">@reason</textarea>
                </div>
            </div>
            <div class="dialog-foot">
                <button type="button" class="btn" data-dialog-close data-dialog-dismiss>Cancel</button>
                <button type="submit" class="btn btn--primary">Confirm Action</button>
            </div>
        </form>
    </section>
</div>
