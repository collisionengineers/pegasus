@model Pegasus.Web.Pages.Integrations.Glass.GlassWaitingView
@using GlassLabels = Pegasus.Web.Presentation.CaseWorkspaceLabels.GlassSession
@* The Glass's window's one card, in the navless frame (v52, R1234): the
   title, the Case it belongs to, and a status whose words are the signal;
   the loader decorates them. No link and no control: the window moves on by
   itself. The script that owns the page reads its addresses from the status
   element. *@
<h1>@GlassLabels.Launch</h1>
@if (Model.CaseLine is { Length: > 0 } caseLine)
{
    <p class="glass-case">@caseLine</p>
}
<p class="glass-wait" role="status" data-glass-wait
   data-glass-opening-state="@Model.StateUrl" data-glass-opening-go="@Model.GoUrl" data-glass-return="@Model.ReturnUrl">
    <svg class="icon busy-spin" aria-hidden="true"><use href="@IconSprite.Href("icon-loader")" /></svg>
    <span data-glass-wait-words>@Model.Words</span>
</p>
@if (Model.KeepOpen)
{
    <p>@GlassLabels.KeepOpen</p>
}
