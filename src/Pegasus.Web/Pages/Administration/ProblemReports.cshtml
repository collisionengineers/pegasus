@page
@model Pegasus.Web.Pages.Administration.ProblemReportsModel
@{
    ViewData["Title"] = OperatorLabels.Admin.ProblemReports;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "problem-reports";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
<partial name="Shared/_PageHeader" />
<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        <section class="panel" aria-label="@OperatorLabels.Admin.ProblemReports">
            @if (Model.Reports.Count == 0)
            {
                <div class="empty"><p>@OperatorLabels.ProblemReports.None</p></div>
            }
            else
            {
            <div class="table-wrap no-border">
                <table class="table table--compact" data-problem-reports>
                    <thead>
                        <tr>
                            <th scope="col">@OperatorLabels.ProblemReports.When</th>
                            <th scope="col">@OperatorLabels.ProblemReports.Who</th>
                            <th scope="col">@OperatorLabels.ProblemReports.Page</th>
                            <th scope="col">@OperatorLabels.ProblemReports.Case</th>
                            <th scope="col">@OperatorLabels.ProblemReports.WhatHappened</th>
                            <th scope="col">@OperatorLabels.ProblemReports.Status</th>
                            <th scope="col">@OperatorLabels.ProblemReports.Issue</th>
                            <th scope="col"><span class="sr-only">@OperatorLabels.ProblemReports.Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var report in Model.Reports)
                    {
                        <tr data-problem-report="@report.Id">
                            <td>
                                <time datetime="@report.CreatedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(report.CreatedAtUtc)</time>
                                @if (report.Status == Pegasus.Core.Support.ProblemReportStatus.Unknown)
                                {
                                    <small class="mono">@report.Id</small>
                                }
                            </td>
                            <td>@Model.ReportedBy(report)</td>
                            <td>@OperatorLabels.ProblemReports.PageName(report.Snapshot.Route)</td>
                            <td class="mono">@(report.Snapshot.CaseReference ?? OperatorLabels.CaseWorkspace.AbsentValue)</td>
                            <td>@report.Description</td>
                            <td>
                                <partial name="Shared/_StatusChip" model="@OperatorLabels.ProblemReportStatus(report.Status)" />
                                @if (report.Failure is { Length: > 0 } failure)
                                {
                                    <span class="muted">@failure</span>
                                }
                            </td>
                            <td>
                                @if (report.IssueUrl is { Length: > 0 } url && report.IssueNumber is { } number)
                                {
                                    <a href="@url" rel="noopener" target="_blank">#@number</a>
                                }
                                else
                                {
                                    @OperatorLabels.CaseWorkspace.AbsentValue
                                }
                            </td>
                            <td>
                                @if (report.Status == Pegasus.Core.Support.ProblemReportStatus.NotSent)
                                {
                                    <form method="post" asp-page-handler="Retry" asp-route-id="@report.Id">
                                        <button type="submit" class="btn btn--small" data-busy-label="@OperatorLabels.Busy.Retrying">@OperatorLabels.ProblemReports.Retry</button>
                                    </form>
                                }
                                else if (report.Status == Pegasus.Core.Support.ProblemReportStatus.Unknown)
                                {
                                    <div class="cluster">
                                        <form method="post" asp-page-handler="ConfirmIssue" asp-route-id="@report.Id">
                                            <label for="issue-@report.Id">@OperatorLabels.ProblemReports.MatchingIssueNumber</label>
                                            <input id="issue-@report.Id" name="issueNumber" type="number" min="1" required />
                                            <button type="submit" class="btn btn--small" data-busy-label="@OperatorLabels.Busy.Confirming">@OperatorLabels.ProblemReports.ConfirmIssue</button>
                                        </form>
                                        <form method="post" asp-page-handler="ConfirmNoIssue" asp-route-id="@report.Id">
                                            <button type="submit" class="btn btn--small" data-busy-label="@OperatorLabels.Busy.Confirming">@OperatorLabels.ProblemReports.ConfirmNoIssue</button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            }
        </section>
    </div>
</div>
