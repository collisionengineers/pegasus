@page
@model Pegasus.Web.Pages.Administration.ReportsModel
@using Pegasus.Core.Reports
@{
    ViewData["Title"] = OperatorLabels.Admin.Reports;
    ViewData["Eyebrow"] = "Administration";
    ViewData["AdminArea"] = "reports";
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    string Money(decimal value) => value.ToString("£#,##0.00", invariant);
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
@functions {
    // A count against the largest beside it, in navy; the number is the fact.
    static Microsoft.AspNetCore.Html.IHtmlContent Measure(int value, int max) =>
        new Microsoft.AspNetCore.Html.HtmlString(
            $"<span class=\"admin-report-measure\"><meter min=\"0\" max=\"{Math.Max(max, 1)}\" value=\"{value}\" aria-hidden=\"true\"></meter><span class=\"tabular\">{value}</span></span>");
}
@{
    // The page's state rides every form as hidden fields, less the fields the form itself sets.
    void Hidden(params string[] except)
    {
        foreach (var (key, value) in Model.State().Where(item => !except.Contains(item.Key)))
        {
            <input type="hidden" name="@key" value="@value" />
        }
    }

    void Download(string handler, string label = "Download CSV", string icon = "icon-download", string css = "btn btn--small")
    {
        <a class="@css" href="@Url.Page("/Administration/Reports", handler, Model.State())" data-busy-download data-busy-label="@OperatorLabels.Busy.Downloading" data-busy-done="@OperatorLabels.Busy.Done.Downloaded" data-busy-download-failed="@OperatorLabels.Busy.DownloadFailed"><svg class="icon" aria-hidden="true"><use href="#@icon" /></svg><span>@label</span></a>
    }

    void Metric(string label, string value, string? previous)
    {
        <div class="metric"><span class="metric-label">@label</span><span class="metric-value">@value</span>@if (previous is not null) { <span class="metric-meta">Previous period @previous</span> }</div>
    }

    void SortHeader(string label, string column, bool numeric, bool principal)
    {
        var aria = principal ? Model.PrincipalAriaSort(column) : Model.AriaSort(column);
        var state = principal
            ? Model.State(("msort", column), ("mdir", Model.PrincipalSortDirectionFor(column)))
            : Model.State(("sort", column), ("dir", Model.SortDirectionFor(column)));
        <th scope="col" class="@(numeric ? "num" : null)" aria-sort="@aria"><a class="admin-report-sort" href="@Url.Page("/Administration/Reports", null, state)">@label</a></th>
    }

    async Task WorkChoice(string name, string current)
    {
        <form method="get" class="admin-report-head-field" data-auto-submit>
            @{ Hidden(name); }
            <label for="report-@name">Work</label>
            <select id="report-@name" name="@name">
                @foreach (var (value, label) in ReportsModel.Works)
                {
                    <option value="@value" selected="@(value == current)">@label</option>
                }
            </select>
            <noscript><button type="submit" class="btn btn--small">Apply</button></noscript>
        </form>
    }
}
<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">Administration</p>
        <h1>@OperatorLabels.Admin.Reports</h1>
    </div>
    @if (!Model.PeriodInvalid)
    {
        <div class="page-actions">@{ Download("Workbook", "Download workbook", "icon-file-spreadsheet", "btn"); }</div>
    }
</header>
<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        <form method="get" class="panel admin-report-period" aria-label="Period">
            <div class="panel-body">
                @{ Hidden("period", "from", "to"); }
                <div class="form-grid form-grid--auto admin-report-filter">
                    <div class="field">
                        <label for="report-period">Period</label>
                        <select id="report-period" name="period" data-period-preset>
                            @foreach (var (value, _, label) in ReportsModel.Periods)
                            {
                                <option value="@value" selected="@(value == Model.PeriodValue)">@label</option>
                            }
                        </select>
                    </div>
                    @* Minutes are the smallest unit a report is bounded by; the default
                       tag-helper format writes seconds and milliseconds into the value,
                       which the picker then shows. *@
                    <div class="field"><label for="report-from">From</label><input id="report-from" asp-for="From" asp-format="{0:yyyy-MM-ddTHH:mm}" name="from" type="datetime-local" step="60" data-period-custom /></div>
                    <div class="field"><label for="report-to">To</label><input id="report-to" asp-for="To" asp-format="{0:yyyy-MM-ddTHH:mm}" name="to" type="datetime-local" step="60" data-period-custom /></div>
                    <div class="cluster"><button class="btn btn--dark" type="submit">Apply</button></div>
                </div>
                @if (Model.PeriodInvalid)
                {
                    <div class="validation-summary validation-summary-errors" role="alert"><ul><li>Choose a valid date range.</li></ul></div>
                }
            </div>
        </form>

        @if (!Model.PeriodInvalid)
        {
            var engineerRows = Model.EngineerResult.Rows;
            var previousEngineer = Model.PreviousEngineer?.Rows;
            <section class="panel" aria-labelledby="mi01-title">
                <div class="panel-head">
                    <h2 id="mi01-title">Engineer activity</h2>
                    <div class="panel-actions">
                        <form method="get" class="admin-report-head-field" data-auto-submit>
                            @{ Hidden("engineerId"); }
                            <label for="report-engineer">Person</label>
                            <select id="report-engineer" name="engineerId">
                                <option value="">All people</option>
                                @foreach (var person in Model.People)
                                {
                                    <option value="@person.Id.ToString("D")" selected="@(person.Id == Model.EngineerId)">@person.Name</option>
                                }
                            </select>
                            <noscript><button type="submit" class="btn btn--small">Apply</button></noscript>
                        </form>
                        @{ Download("Csv"); }
                    </div>
                </div>
                <div class="panel-body">
                    <div class="metric-strip metric-strip--3" aria-label="Engineer activity totals">
                        @{
                            var unavailable = Model.EngineerActivityUnavailable;
                            Metric("Queries received", unavailable ? "Unavailable" : engineerRows.Sum(row => row.QueriesReceived).ToString(invariant), unavailable ? null : previousEngineer?.Sum(row => row.QueriesReceived).ToString(invariant));
                            Metric("Reports sent", unavailable ? "Unavailable" : engineerRows.Sum(row => row.ReportsSent).ToString(invariant), unavailable ? null : previousEngineer?.Sum(row => row.ReportsSent).ToString(invariant));
                            Metric("Audit reports sent", unavailable ? "Unavailable" : engineerRows.Sum(row => row.AuditReportsSent).ToString(invariant), unavailable ? null : previousEngineer?.Sum(row => row.AuditReportsSent).ToString(invariant));
                        }
                    </div>
                    <div class="table-wrap section-gap">
                        <table class="table table--compact">
                            <thead>
                                <tr>
                                    @{ SortHeader("Person", "person", numeric: false, principal: false); }
                                    @{ SortHeader("Queries received", "queries", numeric: true, principal: false); }
                                    <th scope="col" class="num">Amendment requests</th>
                                    @{ SortHeader("Reports sent", "reports", numeric: true, principal: false); }
                                    <th scope="col" class="num">Audit reports sent</th>
                                    <th scope="col">Received to sent</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.EngineerActivityUnavailable)
                            {
                                <tr><td colspan="6" class="muted">Unavailable</td></tr>
                            }
                            else if (engineerRows.Count == 0)
                            {
                                <tr><td colspan="6" class="muted">No engineer activity was recorded for this period.</td></tr>
                            }
                            else
                            {
                                var mostQueries = engineerRows.Max(row => row.QueriesReceived);
                                var mostSent = engineerRows.Max(row => row.ReportsSent);
                                @foreach (var row in engineerRows)
                                {
                                    <tr>
                                        <td>@row.DisplayName</td>
                                        <td class="num">@Measure(row.QueriesReceived, mostQueries)</td>
                                        <td class="num tabular">@row.AmendmentRequests</td>
                                        <td class="num">@Measure(row.ReportsSent, mostSent)</td>
                                        <td class="num tabular">@row.AuditReportsSent</td>
                                        <td>@OperatorLabels.ReportTurnaround(row.AverageReceivedToSent, "—")</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            var principal = Model.PrincipalActivity;
            var previousPrincipal = Model.PreviousPrincipal?.Rows;
            var principalRows = Model.PrincipalRows;
            <section class="panel" aria-labelledby="mi02-title">
                <div class="panel-head">
                    <h2 id="mi02-title">Reports by Principal</h2>
                    <div class="panel-actions">
                        @{ await WorkChoice("work", Model.WorkValue); }
                        @{ Download("PrincipalCsv"); }
                    </div>
                </div>
                <div class="panel-body">
                    <div class="metric-strip metric-strip--3" aria-label="Reports by Principal totals">
                        @{
                            Metric("Reports produced", principal is null ? "Unavailable" : principal.Rows.Sum(row => row.ReportsProduced).ToString(invariant), principal is null ? null : previousPrincipal?.Sum(row => row.ReportsProduced).ToString(invariant));
                            Metric("Reports sent", principal is null ? "Unavailable" : principal.Rows.Sum(row => row.Sent).ToString(invariant), principal is null ? null : previousPrincipal?.Sum(row => row.Sent).ToString(invariant));
                            Metric("Agreed fees", principal is null ? "Unavailable" : Money(principal.Rows.Sum(row => row.AgreedFeeTotal)), principal is null || previousPrincipal is null ? null : Money(previousPrincipal.Sum(row => row.AgreedFeeTotal)));
                        }
                    </div>
                    <div class="table-wrap section-gap">
                        <table class="table table--compact">
                            <thead>
                                <tr>
                                    @{ SortHeader("Principal", "code", numeric: false, principal: true); }
                                    @{ SortHeader("Reports produced", "produced", numeric: true, principal: true); }
                                    @{ SortHeader("Reports sent", "sent", numeric: true, principal: true); }
                                    @{ SortHeader("Agreed fees", "fees", numeric: true, principal: true); }
                                </tr>
                            </thead>
                            <tbody>
                            @if (principal is null)
                            {
                                <tr><td colspan="4" class="muted">Unavailable</td></tr>
                            }
                            else if (principalRows.Count == 0)
                            {
                                <tr><td colspan="4" class="muted">No reports were recorded for this period.</td></tr>
                            }
                            else
                            {
                                var mostProduced = principalRows.Max(Model.Produced);
                                var mostPrincipalSent = principalRows.Max(Model.Sent);
                                @foreach (var row in principalRows)
                                {
                                    <tr>
                                        <td class="mono">@row.PrincipalCode</td>
                                        <td class="num">@Measure(Model.Produced(row), mostProduced)</td>
                                        <td class="num">@Measure(Model.Sent(row), mostPrincipalSent)</td>
                                        <td class="num tabular">@Money(Model.Fees(row))</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="panel" aria-labelledby="months-title">
                <div class="panel-head">
                    <h2 id="months-title">By month</h2>
                    <div class="panel-actions">
                        @{ await WorkChoice("workm", Model.MonthWorkValue); }
                        @{ Download("MonthsCsv"); }
                    </div>
                </div>
                <div class="panel-body">
                    <div class="table-wrap">
                        <table class="table table--compact" aria-labelledby="months-title" data-reports-by-month>
                            <thead><tr><th scope="col">Month</th><th scope="col">Principal</th><th scope="col" class="num">Reports produced</th><th scope="col" class="num">Fee notes produced</th><th scope="col" class="num">Reports sent</th><th scope="col" class="num">Agreed fees</th></tr></thead>
                            <tbody>
                            @if (Model.Monthly is not { } months)
                            {
                                <tr><td colspan="6" class="muted">Unavailable</td></tr>
                            }
                            else if (months.Count == 0)
                            {
                                <tr><td colspan="6" class="muted">No reports were recorded for this period.</td></tr>
                            }
                            else
                            {
                                @foreach (var row in months)
                                {
                                    var figures = Model.MonthFigures(row);
                                    <tr>
                                        <td>@row.MonthLabel</td>
                                        <td class="mono">@row.PrincipalCode</td>
                                        <td class="num tabular">@figures.Produced</td>
                                        <td class="num tabular">@figures.FeeNotes</td>
                                        <td class="num tabular">@figures.Sent</td>
                                        <td class="num tabular">@Money(figures.Fees)</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="panel" aria-labelledby="outcomes-title">
                <div class="panel-head">
                    <h2 id="outcomes-title">Outcomes</h2>
                    <div class="panel-actions">@{ Download("OutcomesCsv"); }</div>
                </div>
                <div class="panel-body">
                    <div class="table-wrap">
                        <table class="table table--compact">
                            <thead>
                                <tr>
                                    <th scope="col">Principal</th>
                                    @foreach (var outcome in GetReportOutcomes.Order)
                                    {
                                        <th scope="col" class="num">@CaseReportDeliveryNaming.OutcomeWords(outcome)</th>
                                    }
                                    <th scope="col" class="num">@CaseListPolicy.Agrees</th>
                                    <th scope="col" class="num">@CaseListPolicy.Differs</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.Outcomes is not { } outcomes)
                            {
                                <tr><td colspan="7" class="muted">Unavailable</td></tr>
                            }
                            else if (outcomes.Rows.Count == 0)
                            {
                                <tr><td colspan="7" class="muted">No reports were recorded for this period.</td></tr>
                            }
                            else
                            {
                                @foreach (var row in outcomes.Rows)
                                {
                                    <tr>
                                        <td class="mono">@row.PrincipalCode</td>
                                        <td class="num tabular">@row.Repairable</td>
                                        <td class="num tabular">@row.TotalLoss</td>
                                        <td class="num tabular">@row.CashInLieu</td>
                                        <td class="num tabular">@row.ContractRepair</td>
                                        <td class="num tabular">@row.Agrees</td>
                                        <td class="num tabular">@row.Differs</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="panel" aria-labelledby="mi03-title">
                <div class="panel-head">
                    <h2 id="mi03-title">Turnaround</h2>
                    <div class="panel-actions">@{ Download("TurnaroundCsv"); }</div>
                </div>
                <div class="panel-body">
                    <div class="table-wrap">
                        <table class="table table--compact">
                            <thead><tr><th scope="col">Principal</th><th scope="col">Time to produce</th><th scope="col">Time to ready</th><th scope="col">Time to send</th></tr></thead>
                            <tbody>
                            @if (principal is null)
                            {
                                <tr><td colspan="4" class="muted">Unavailable</td></tr>
                            }
                            else
                            {
                                var turnaroundRows = AdministrationReportTables.TurnaroundRows(principal).ToArray();
                                @foreach (var row in turnaroundRows)
                                {
                                    <tr>
                                        <td class="mono">@row.PrincipalCode</td>
                                        <td>@OperatorLabels.ReportTurnaround(row.AverageReceivedToGeneration, "—")</td>
                                        <td>@OperatorLabels.ReportTurnaround(row.AverageReceivedToReady, "—")</td>
                                        <td>@OperatorLabels.ReportTurnaround(row.AverageReceivedToSent, "—")</td>
                                    </tr>
                                }
                                @if (turnaroundRows.Length == 0) { <tr><td colspan="4" class="muted">No holding or turnaround activity was recorded for this period.</td></tr> }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            var queueRows = principal is null ? Array.Empty<PrincipalReportActivity>() : AdministrationReportTables.QueueRows(principal).ToArray();
            <section class="panel" aria-labelledby="queues-title">
                <div class="panel-head">
                    <h2 id="queues-title">Queues</h2>
                    <span class="meta">Now</span>
                    <div class="panel-actions">@{ Download("QueuesCsv"); }</div>
                </div>
                <div class="panel-body">
                    <div class="metric-strip metric-strip--3" aria-label="Queues totals">
                        @{
                            Metric("Cases currently held", principal is null ? "Unavailable" : principal.Rows.Sum(row => row.CurrentHeldCases).ToString(invariant), null);
                            Metric("Triages", principal is null ? "Unavailable" : principal.Rows.Sum(row => row.CurrentTriage).ToString(invariant), null);
                        }
                        <div class="metric">
                            <span class="metric-label">Unidentified</span>
                            <span class="metric-value">@(Model.Unidentified is { } unidentified ? unidentified.Count.ToString(invariant) : "Unavailable")</span>
                            @if (Model.Unidentified is { OldestReceivedAtUtc: { } oldestUnidentified })
                            {
                                <span class="metric-meta">Oldest since @OperatorLabels.OfficeTime(oldestUnidentified)</span>
                            }
                        </div>
                    </div>
                    <div class="table-wrap section-gap">
                        <table class="table table--compact">
                            <thead><tr><th scope="col">Principal</th><th scope="col" class="num">Currently held</th><th scope="col">Oldest held since</th><th scope="col" class="num">Triages</th><th scope="col">Oldest Triage since</th></tr></thead>
                            <tbody>
                            @if (principal is null)
                            {
                                <tr><td colspan="5" class="muted">Unavailable</td></tr>
                            }
                            else
                            {
                                @foreach (var row in queueRows)
                                {
                                    <tr>
                                        <td class="mono">@row.PrincipalCode</td>
                                        <td class="num tabular">@row.CurrentHeldCases</td>
                                        <td>@OperatorLabels.OfficeTime(row.OldestHeldAtUtc, "—")</td>
                                        <td class="num tabular">@row.CurrentTriage</td>
                                        <td>@OperatorLabels.OfficeTime(row.OldestCurrentTriageCreatedAtUtc, "—")</td>
                                    </tr>
                                }
                                @if (queueRows.Length == 0) { <tr><td colspan="5" class="muted">Nothing is currently held.</td></tr> }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        }

        @{
            var caseList = Model.CaseList;
            var chosen = caseList.Columns.ToHashSet(StringComparer.Ordinal);
            var selectedPreset = Model.SelectedPreset;
        }
        <section class="panel" aria-labelledby="mi04-title" data-case-list>
            <div class="panel-head"><h2 id="mi04-title">@OperatorLabels.CaseList.Title</h2></div>
            <div class="panel-body stack">
                <p class="muted admin-report-note">@OperatorLabels.CaseList.Note</p>
                @if (Model.CaseListError is { } caseListError)
                {
                    <div class="notice notice--danger" role="alert">@caseListError</div>
                }
                @if (Model.CaseListPresets is { } presets)
                {
                    <form method="get" class="form-grid form-grid--auto admin-report-filter" aria-label="@OperatorLabels.CaseList.Preset">
                        @{ Hidden("preset"); }
                        <div class="field">
                            <label for="case-list-preset">@OperatorLabels.CaseList.Preset</label>
                            <select id="case-list-preset" name="preset">
                                <option value="">@OperatorLabels.CaseList.NoPreset</option>
                                @foreach (var preset in presets)
                                {
                                    <option value="@preset.Id.ToString("D")" selected="@(preset.Id == selectedPreset?.Id)">@preset.Name</option>
                                }
                            </select>
                        </div>
                        <div class="cluster"><button class="btn" type="submit">@OperatorLabels.CaseList.UsePreset</button></div>
                    </form>
                }
                else
                {
                    <p class="muted">@OperatorLabels.CaseList.PresetsUnavailable</p>
                }
                <form method="post" class="stack" aria-label="@OperatorLabels.CaseList.Title">
                    <input type="hidden" name="PresetId" value="@caseList.PresetId?.ToString("D")" />
                    <input type="hidden" name="ExpectedVersion" value="@caseList.ExpectedVersion" />
                    <input type="hidden" name="NewPresetId" value="@caseList.NewPresetId.ToString("D")" />
                    <input type="hidden" name="OperationKey" value="@caseList.OperationKey" />
                    <div class="form-grid form-grid--auto admin-report-filter">
                        <div class="field"><label for="case-list-from">@OperatorLabels.CaseList.ReceivedFrom</label><input id="case-list-from" name="ReceivedFrom" type="date" value="@caseList.ReceivedFrom?.ToString("yyyy-MM-dd", invariant)" /></div>
                        <div class="field"><label for="case-list-to">@OperatorLabels.CaseList.ReceivedTo</label><input id="case-list-to" name="ReceivedTo" type="date" value="@caseList.ReceivedTo?.ToString("yyyy-MM-dd", invariant)" /></div>
                        <label class="choice"><input type="checkbox" name="AllTime" value="true" checked="@caseList.AllTime" /> @OperatorLabels.CaseList.AllTime</label>
                        <label class="choice"><input type="checkbox" name="IncludeTriage" value="true" checked="@caseList.IncludeTriage" /> @OperatorLabels.CaseList.IncludeTriage</label>
                    </div>
                    @foreach (var group in CaseListColumns.All.GroupBy(column => column.Group))
                    {
                        <fieldset class="stack">
                            <legend>@OperatorLabels.CaseList.Group(group.Key)</legend>
                            <div class="form-grid form-grid--auto">
                                @foreach (var column in group)
                                {
                                    <label class="choice"><input type="checkbox" name="Columns" value="@column.Key" checked="@chosen.Contains(column.Key)" /> @column.Title</label>
                                }
                            </div>
                        </fieldset>
                    }
                    <div class="button-row">
                        <button class="btn btn--dark" type="submit" asp-page-handler="CaseListCsv" data-busy-download data-busy-label="@OperatorLabels.Busy.Downloading" data-busy-done="@OperatorLabels.Busy.Done.Downloaded" data-busy-download-failed="@OperatorLabels.Busy.DownloadFailed"><svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg><span>Download CSV</span></button>
                        <button class="btn" type="submit" asp-page-handler="CaseListWorkbook" data-busy-download data-busy-label="@OperatorLabels.Busy.Downloading" data-busy-done="@OperatorLabels.Busy.Done.Downloaded" data-busy-download-failed="@OperatorLabels.Busy.DownloadFailed"><svg class="icon" aria-hidden="true"><use href="#icon-file-spreadsheet" /></svg><span>Download workbook</span></button>
                    </div>
                    @if (Model.CaseListPresets is not null)
                    {
                        <div class="form-grid form-grid--auto admin-report-filter">
                            <div class="field"><label for="case-list-preset-name">@OperatorLabels.CaseList.PresetName</label><input id="case-list-preset-name" name="PresetName" maxlength="@CaseListPresetPolicy.MaximumNameLength" value="@caseList.PresetName" /></div>
                            <div class="button-row">
                                <button class="btn" type="submit" asp-page-handler="CaseListPresetCreate" data-busy-label="@OperatorLabels.Busy.Saving">@OperatorLabels.CaseList.SaveAsNewPreset</button>
                                @if (caseList.PresetId is not null)
                                {
                                    <button class="btn" type="submit" asp-page-handler="CaseListPresetSave" data-busy-label="@OperatorLabels.Busy.Saving">@OperatorLabels.CaseList.SavePreset</button>
                                    <button class="btn btn--danger" type="submit" asp-page-handler="CaseListPresetRemove" data-busy-label="@OperatorLabels.Busy.Removing">@OperatorLabels.CaseList.RemovePreset</button>
                                }
                            </div>
                        </div>
                    }
                </form>
            </div>
        </section>
    </div>
</div>
