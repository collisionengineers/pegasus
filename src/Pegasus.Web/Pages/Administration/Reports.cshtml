@page
@model Pegasus.Web.Pages.Administration.ReportsModel
@{ ViewData["Title"] = "Reports"; ViewData["Eyebrow"] = "Administration"; }
<partial name="Shared/_PageHeader" />
<div class="admin-layout"><partial name="Shared/_AdminNav" /><div class="stack">
<section class="panel" aria-labelledby="mi01-title">
    <div class="panel-head"><div><h2 id="mi01-title">Engineer activity</h2><span class="muted">MI01</span></div></div>
    <div class="panel-body">
        <p class="muted">Queries received are credited to the Engineer assigned to the Case. Reports sent are credited to the staff member recorded as the sender.</p>
        <form method="get" class="filter-bar" aria-label="Engineer activity filters">
            <div class="field"><label for="report-from">From London</label><input id="report-from" asp-for="From" name="from" type="datetime-local" /></div>
            <div class="field"><label for="report-to">To London</label><input id="report-to" asp-for="To" name="to" type="datetime-local" /></div>
            <div class="field"><label for="report-engineer">Person</label><select id="report-engineer" asp-for="EngineerId" name="engineerId"><option value="">All people</option>@foreach (var person in Model.People) { <option value="@person.Id">@person.UserName</option> }</select></div>
            <button class="btn btn--primary" type="submit">Apply</button>
            <a class="btn" asp-page="/Administration/Reports" asp-page-handler="Csv" asp-route-from="@Model.From?.ToString("yyyy-MM-ddTHH:mm")" asp-route-to="@Model.To?.ToString("yyyy-MM-ddTHH:mm")" asp-route-engineerId="@Model.EngineerId">Download CSV</a>
        </form>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="metric-strip metric-strip--2 section-gap" aria-label="Engineer activity totals">
            <div class="metric"><span class="metric-label">Queries received</span><span class="metric-value">@Model.EngineerResult.Rows.Sum(row => row.QueriesReceived)</span></div>
            <div class="metric"><span class="metric-label">Reports sent</span><span class="metric-value">@Model.EngineerResult.Rows.Sum(row => row.ReportsSent)</span></div>
        </div>
        <div class="table-wrap section-gap"><table><thead><tr><th>Person</th><th>Queries received</th><th>Reports sent</th></tr></thead><tbody>
        @foreach (var row in Model.EngineerResult.Rows) { <tr><td>@row.DisplayName</td><td class="tabular">@row.QueriesReceived</td><td class="tabular">@row.ReportsSent</td></tr> }
        @if (Model.EngineerResult.Rows.Count == 0) { <tr><td colspan="3" class="muted">No engineer activity was recorded for this period.</td></tr> }
        </tbody></table></div>
    </div>
</section>
</div></div>
