@page
@model Pegasus.Web.Pages.Administration.ReportsModel
@{
    ViewData["Title"] = OperatorLabels.Admin.Reports;
    ViewData["Eyebrow"] = "Administration";
    ViewData["AdminArea"] = "reports";
    var from = Model.From?.ToString("yyyy-MM-ddTHH:mm");
    var to = Model.To?.ToString("yyyy-MM-ddTHH:mm");
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    string Money(decimal value) => value.ToString("£#,##0.00", invariant);
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
<partial name="Shared/_PageHeader" />
<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        <section class="panel" aria-labelledby="mi01-title">
            <div class="panel-head"><h2 id="mi01-title">Engineer activity</h2><span class="meta">MI01</span></div>
            <div class="panel-body">
                <p class="muted admin-report-note">Queries received are credited to the Engineer assigned to the Case. Reports sent are credited to the staff member recorded as the sender.</p>
                <form method="get" class="form-grid form-grid--auto admin-report-filter" aria-label="Engineer activity filters">
                    @* Minutes are the smallest unit this report is bounded by; the default
                       tag-helper format writes seconds and milliseconds into the value,
                       which the picker then shows. The CSV link below already formats to
                       minutes, so the two agree. *@
                    <div class="field"><label for="report-from">From</label><input id="report-from" asp-for="From" asp-format="{0:yyyy-MM-ddTHH:mm}" name="from" type="datetime-local" step="60" /></div>
                    <div class="field"><label for="report-to">To</label><input id="report-to" asp-for="To" asp-format="{0:yyyy-MM-ddTHH:mm}" name="to" type="datetime-local" step="60" /></div>
                    <div class="field"><label for="report-engineer">Person</label><select id="report-engineer" asp-for="EngineerId" name="engineerId"><option value="">All people</option>@foreach (var person in Model.People) { <option value="@person.Id">@person.UserName</option> }</select></div>
                    <div class="cluster">
                        <button class="btn btn--dark" type="submit">Apply</button>
                        <a class="btn" asp-page="/Administration/Reports" asp-page-handler="Csv" asp-route-from="@from" asp-route-to="@to" asp-route-engineerId="@Model.EngineerId" data-busy-download data-busy-label="@OperatorLabels.Busy.Downloading" data-busy-done="@OperatorLabels.Busy.Done.Downloaded" data-busy-download-failed="@OperatorLabels.Busy.DownloadFailed"><svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg><span>Download CSV</span></a>
                        <a class="btn" asp-page="/Administration/Reports" asp-page-handler="Workbook" asp-route-from="@from" asp-route-to="@to" asp-route-engineerId="@Model.EngineerId" data-report-workbook data-busy-download data-busy-label="@OperatorLabels.Busy.Downloading" data-busy-done="@OperatorLabels.Busy.Done.Downloaded" data-busy-download-failed="@OperatorLabels.Busy.DownloadFailed"><svg class="icon" aria-hidden="true"><use href="#icon-file-spreadsheet" /></svg><span>Download workbook</span></a>
                    </div>
                </form>
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <div class="metric-strip metric-strip--3 section-gap" aria-label="Engineer activity totals">
                    <div class="metric"><span class="metric-label">Queries received</span><span class="metric-value">@(Model.EngineerActivityUnavailable ? "Unavailable" : Model.EngineerResult.Rows.Sum(row => row.QueriesReceived).ToString())</span></div>
                    <div class="metric"><span class="metric-label">Reports sent</span><span class="metric-value">@(Model.EngineerActivityUnavailable ? "Unavailable" : Model.EngineerResult.Rows.Sum(row => row.ReportsSent).ToString())</span></div>
                    <div class="metric"><span class="metric-label">Audit reports sent</span><span class="metric-value">@(Model.EngineerActivityUnavailable ? "Unavailable" : Model.EngineerResult.Rows.Sum(row => row.AuditReportsSent).ToString())</span></div>
                </div>
                <div class="table-wrap section-gap">
                    <table class="table table--compact" data-engineer-activity>
                        <thead>
                            <tr>
                                <th scope="col" aria-sort="@Model.AriaSort("person")"><a class="admin-report-sort" data-sort-toggle asp-page="/Administration/Reports" asp-route-from="@from" asp-route-to="@to" asp-route-engineerId="@Model.EngineerId" asp-route-sort="person" asp-route-dir="@Model.SortDirectionFor("person")">Person <span data-sort-arrow>@Model.SortArrow("person")</span></a></th>
                                <th scope="col" class="num" aria-sort="@Model.AriaSort("queries")"><a class="admin-report-sort" data-sort-toggle asp-page="/Administration/Reports" asp-route-from="@from" asp-route-to="@to" asp-route-engineerId="@Model.EngineerId" asp-route-sort="queries" asp-route-dir="@Model.SortDirectionFor("queries")">Queries received <span data-sort-arrow>@Model.SortArrow("queries")</span></a></th>
                                <th scope="col" class="num">Amendment requests</th>
                                <th scope="col" class="num" aria-sort="@Model.AriaSort("reports")"><a class="admin-report-sort" data-sort-toggle asp-page="/Administration/Reports" asp-route-from="@from" asp-route-to="@to" asp-route-engineerId="@Model.EngineerId" asp-route-sort="reports" asp-route-dir="@Model.SortDirectionFor("reports")">Reports sent <span data-sort-arrow>@Model.SortArrow("reports")</span></a></th>
                                <th scope="col" class="num">Audit reports sent</th>
                                <th scope="col">Received to sent</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.EngineerActivityUnavailable)
                        {
                            <tr><td colspan="6" class="muted">Unavailable</td></tr>
                        }
                        else
                        {
                            @foreach (var row in Model.EngineerResult.Rows)
                            {
                                <tr>
                                    <td>@row.DisplayName</td>
                                    <td class="num"><span class="admin-report-measure"><meter min="0" max="@Math.Max(Model.MostQueriesReceived, 1)" value="@row.QueriesReceived" aria-hidden="true"></meter><span class="tabular">@row.QueriesReceived</span></span></td>
                                    <td class="num tabular">@row.AmendmentRequests</td>
                                    <td class="num"><span class="admin-report-measure"><meter min="0" max="@Math.Max(Model.MostReportsSent, 1)" value="@row.ReportsSent" aria-hidden="true"></meter><span class="tabular">@row.ReportsSent</span></span></td>
                                    <td class="num tabular">@row.AuditReportsSent</td>
                                    <td>@OperatorLabels.ReportTurnaround(row.AverageReceivedToSent, "—")</td>
                                </tr>
                            }
                            @if (Model.EngineerResult.Rows.Count == 0) { <tr><td colspan="6" class="muted">No engineer activity was recorded for this period.</td></tr> }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="panel" aria-labelledby="mi02-title">
            <div class="panel-head">
                <h2 id="mi02-title">Reports by Principal</h2>
                <span class="meta">MI02</span>
                <div class="panel-actions">
                    <a class="btn btn--small" asp-page="/Administration/Reports" asp-page-handler="PrincipalCsv" asp-route-from="@from" asp-route-to="@to" data-busy-download data-busy-label="@OperatorLabels.Busy.Downloading" data-busy-done="@OperatorLabels.Busy.Done.Downloaded" data-busy-download-failed="@OperatorLabels.Busy.DownloadFailed"><svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg><span>Download CSV</span></a>
                </div>
            </div>
            <div class="panel-body">
                <div class="metric-strip metric-strip--3" aria-label="Reports by Principal totals">
                    <div class="metric"><span class="metric-label">Reports produced</span><span class="metric-value">@(Model.PrincipalActivity is { } mi02Totals ? mi02Totals.Rows.Sum(row => row.ReportsProduced).ToString() : "Unavailable")</span></div>
                    <div class="metric"><span class="metric-label">Reports sent</span><span class="metric-value">@(Model.PrincipalActivity is { } mi02SentTotals ? mi02SentTotals.Rows.Sum(row => row.Sent).ToString() : "Unavailable")</span></div>
                    <div class="metric"><span class="metric-label">Agreed fees</span><span class="metric-value">@(Model.PrincipalActivity is { } mi02FeeTotals ? Money(mi02FeeTotals.Rows.Sum(row => row.AgreedFeeTotal)) : "Unavailable")</span></div>
                </div>
                <div class="table-wrap section-gap">
                    <table class="table table--compact">
                        <thead><tr><th scope="col">Principal</th><th scope="col" class="num">Reports produced</th><th scope="col" class="num">@ReportsModel.InspectionColumn("Reports produced")</th><th scope="col" class="num">@ReportsModel.AuditColumn("Reports produced")</th><th scope="col" class="num">Reports sent</th><th scope="col" class="num">@ReportsModel.InspectionColumn("Reports sent")</th><th scope="col" class="num">@ReportsModel.AuditColumn("Reports sent")</th><th scope="col" class="num">Agreed fees</th><th scope="col" class="num">@ReportsModel.InspectionColumn("Agreed fees")</th><th scope="col" class="num">@ReportsModel.AuditColumn("Agreed fees")</th></tr></thead>
                        <tbody>
                        @if (Model.PrincipalActivity is { } mi02)
                        {
                            var mi02Rows = mi02.Rows.Where(row => row.ReportsProduced > 0 || row.Sent > 0).ToArray();
                            @foreach (var row in mi02Rows)
                            {
                                <tr>
                                    <td class="mono">@row.PrincipalCode</td>
                                    <td class="num tabular">@row.ReportsProduced</td>
                                    <td class="num tabular">@row.InspectionReportsProduced</td>
                                    <td class="num tabular">@row.AuditReportsProduced</td>
                                    <td class="num tabular">@row.Sent</td>
                                    <td class="num tabular">@row.InspectionSent</td>
                                    <td class="num tabular">@row.AuditSent</td>
                                    <td class="num tabular">@Money(row.AgreedFeeTotal)</td>
                                    <td class="num tabular">@Money(row.InspectionAgreedFeeTotal)</td>
                                    <td class="num tabular">@Money(row.AuditAgreedFeeTotal)</td>
                                </tr>
                            }
                            @if (mi02Rows.Length == 0) { <tr><td colspan="10" class="muted">No reports were recorded for this period.</td></tr> }
                        }
                        else
                        {
                            <tr><td colspan="10" class="muted">Unavailable</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
                <h3 id="mi02-months-title" class="section-gap">By month</h3>
                <div class="table-wrap">
                    <table class="table table--compact" aria-labelledby="mi02-months-title" data-reports-by-month>
                        <thead><tr><th scope="col">Month</th><th scope="col">Principal</th><th scope="col" class="num">Reports produced</th><th scope="col" class="num">@ReportsModel.InspectionColumn("Reports produced")</th><th scope="col" class="num">@ReportsModel.AuditColumn("Reports produced")</th><th scope="col" class="num">Fee notes produced</th><th scope="col" class="num">Reports sent</th><th scope="col" class="num">@ReportsModel.InspectionColumn("Reports sent")</th><th scope="col" class="num">@ReportsModel.AuditColumn("Reports sent")</th><th scope="col" class="num">Agreed fees</th><th scope="col" class="num">@ReportsModel.InspectionColumn("Agreed fees")</th><th scope="col" class="num">@ReportsModel.AuditColumn("Agreed fees")</th></tr></thead>
                        <tbody>
                        @if (Model.Monthly is { } months)
                        {
                            @foreach (var row in months)
                            {
                                <tr>
                                    <td>@row.MonthLabel</td>
                                    <td class="mono">@row.PrincipalCode</td>
                                    <td class="num tabular">@row.ReportsGenerated</td>
                                    <td class="num tabular">@row.InspectionReportsGenerated</td>
                                    <td class="num tabular">@row.AuditReportsGenerated</td>
                                    <td class="num tabular">@row.FeeNotesGenerated</td>
                                    <td class="num tabular">@row.Sent</td>
                                    <td class="num tabular">@row.InspectionSent</td>
                                    <td class="num tabular">@row.AuditSent</td>
                                    <td class="num tabular">@Money(row.AgreedFeeTotal)</td>
                                    <td class="num tabular">@Money(row.InspectionAgreedFeeTotal)</td>
                                    <td class="num tabular">@Money(row.AuditAgreedFeeTotal)</td>
                                </tr>
                            }
                            @if (months.Count == 0) { <tr><td colspan="12" class="muted">No reports were recorded for this period.</td></tr> }
                        }
                        else
                        {
                            <tr><td colspan="12" class="muted">Unavailable</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="panel" aria-labelledby="mi03-title">
            <div class="panel-head">
                <h2 id="mi03-title">Turnaround</h2>
                <span class="meta">MI03</span>
                <div class="panel-actions">
                    <a class="btn btn--small" asp-page="/Administration/Reports" asp-page-handler="TurnaroundCsv" asp-route-from="@from" asp-route-to="@to" data-busy-download data-busy-label="@OperatorLabels.Busy.Downloading" data-busy-done="@OperatorLabels.Busy.Done.Downloaded" data-busy-download-failed="@OperatorLabels.Busy.DownloadFailed"><svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg><span>Download CSV</span></a>
                </div>
            </div>
            <div class="panel-body">
                <div class="metric-strip" aria-label="Turnaround totals">
                    <div class="metric"><span class="metric-label">Cases currently held</span><span class="metric-value">@(Model.PrincipalActivity is { } mi03Totals ? mi03Totals.Rows.Sum(row => row.CurrentHeldCases).ToString() : "Unavailable")</span></div>
                </div>
                <div class="table-wrap section-gap">
                    <table class="table table--compact">
                        <thead><tr><th scope="col">Principal</th><th scope="col" class="num">Currently held</th><th scope="col">Oldest held since</th><th scope="col">Time to produce</th><th scope="col">Time to ready</th><th scope="col">Time to send</th></tr></thead>
                        <tbody>
                        @if (Model.PrincipalActivity is { } mi03)
                        {
                            var mi03Rows = mi03.Rows.Where(row =>
                                row.CurrentHeldCases > 0
                                || row.AverageReceivedToGeneration.HasValue
                                || row.AverageReceivedToReady.HasValue
                                || row.AverageReceivedToSent.HasValue).ToArray();
                            @foreach (var row in mi03Rows)
                            {
                                <tr>
                                    <td class="mono">@row.PrincipalCode</td>
                                    <td class="num tabular">@row.CurrentHeldCases</td>
                                    <td>@OperatorLabels.OfficeTime(row.OldestHeldAtUtc, "—")</td>
                                    <td>@OperatorLabels.ReportTurnaround(row.AverageReceivedToGeneration, "—")</td>
                                    <td>@OperatorLabels.ReportTurnaround(row.AverageReceivedToReady, "—")</td>
                                    <td>@OperatorLabels.ReportTurnaround(row.AverageReceivedToSent, "—")</td>
                                </tr>
                            }
                            @if (mi03Rows.Length == 0) { <tr><td colspan="6" class="muted">No holding or turnaround activity was recorded for this period.</td></tr> }
                        }
                        else
                        {
                            <tr><td colspan="6" class="muted">Unavailable</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        @{
            var caseList = Model.CaseList;
            var chosen = caseList.Columns.ToHashSet(StringComparer.Ordinal);
            var selectedPreset = Model.SelectedPreset;
        }
        <section class="panel" aria-labelledby="mi04-title" data-case-list>
            <div class="panel-head"><h2 id="mi04-title">@OperatorLabels.CaseList.Title</h2><span class="meta">MI04</span></div>
            <div class="panel-body stack">
                <p class="muted admin-report-note">@OperatorLabels.CaseList.Note</p>
                @if (Model.CaseListError is { } caseListError)
                {
                    <div class="notice notice--danger" role="alert">@caseListError</div>
                }
                @if (Model.CaseListPresets is { } presets)
                {
                    <form method="get" class="form-grid form-grid--auto admin-report-filter" aria-label="@OperatorLabels.CaseList.Preset">
                        <div class="field">
                            <label for="case-list-preset">@OperatorLabels.CaseList.Preset</label>
                            <select id="case-list-preset" name="preset">
                                <option value="">@OperatorLabels.CaseList.NoPreset</option>
                                @foreach (var preset in presets)
                                {
                                    <option value="@preset.Id.ToString("D")" selected="@(preset.Id == selectedPreset?.Id)">@preset.Name</option>
                                }
                            </select>
                        </div>
                        <div class="cluster"><button class="btn" type="submit">@OperatorLabels.CaseList.UsePreset</button></div>
                    </form>
                }
                else
                {
                    <p class="muted">@OperatorLabels.CaseList.PresetsUnavailable</p>
                }
                <form method="post" class="stack" aria-label="@OperatorLabels.CaseList.Title">
                    <input type="hidden" name="PresetId" value="@caseList.PresetId?.ToString("D")" />
                    <input type="hidden" name="ExpectedVersion" value="@caseList.ExpectedVersion" />
                    <input type="hidden" name="NewPresetId" value="@caseList.NewPresetId.ToString("D")" />
                    <input type="hidden" name="OperationKey" value="@caseList.OperationKey" />
                    <div class="form-grid form-grid--auto admin-report-filter">
                        <div class="field"><label for="case-list-from">@OperatorLabels.CaseList.ReceivedFrom</label><input id="case-list-from" name="ReceivedFrom" type="date" value="@caseList.ReceivedFrom?.ToString("yyyy-MM-dd", invariant)" /></div>
                        <div class="field"><label for="case-list-to">@OperatorLabels.CaseList.ReceivedTo</label><input id="case-list-to" name="ReceivedTo" type="date" value="@caseList.ReceivedTo?.ToString("yyyy-MM-dd", invariant)" /></div>
                        <label class="choice"><input type="checkbox" name="AllTime" value="true" checked="@caseList.AllTime" /> @OperatorLabels.CaseList.AllTime</label>
                        <label class="choice"><input type="checkbox" name="IncludeTriage" value="true" checked="@caseList.IncludeTriage" /> @OperatorLabels.CaseList.IncludeTriage</label>
                    </div>
                    @foreach (var group in Pegasus.Core.Reports.CaseListColumns.All.GroupBy(column => column.Group))
                    {
                        <fieldset class="stack">
                            <legend>@OperatorLabels.CaseList.Group(group.Key)</legend>
                            <div class="form-grid form-grid--auto">
                                @foreach (var column in group)
                                {
                                    <label class="choice"><input type="checkbox" name="Columns" value="@column.Key" checked="@chosen.Contains(column.Key)" /> @column.Title</label>
                                }
                            </div>
                        </fieldset>
                    }
                    <div class="button-row">
                        <button class="btn btn--dark" type="submit" asp-page-handler="CaseListCsv" data-busy-download data-busy-label="@OperatorLabels.Busy.Downloading" data-busy-done="@OperatorLabels.Busy.Done.Downloaded" data-busy-download-failed="@OperatorLabels.Busy.DownloadFailed"><svg class="icon" aria-hidden="true"><use href="#icon-download" /></svg><span>Download CSV</span></button>
                        <button class="btn" type="submit" asp-page-handler="CaseListWorkbook" data-busy-download data-busy-label="@OperatorLabels.Busy.Downloading" data-busy-done="@OperatorLabels.Busy.Done.Downloaded" data-busy-download-failed="@OperatorLabels.Busy.DownloadFailed"><svg class="icon" aria-hidden="true"><use href="#icon-file-spreadsheet" /></svg><span>Download workbook</span></button>
                    </div>
                    @if (Model.CaseListPresets is not null)
                    {
                        <div class="form-grid form-grid--auto admin-report-filter">
                            <div class="field"><label for="case-list-preset-name">@OperatorLabels.CaseList.PresetName</label><input id="case-list-preset-name" name="PresetName" maxlength="@Pegasus.Core.Reports.CaseListPresetPolicy.MaximumNameLength" value="@caseList.PresetName" /></div>
                            <div class="button-row">
                                <button class="btn" type="submit" asp-page-handler="CaseListPresetCreate" data-busy-label="@OperatorLabels.Busy.Saving">@OperatorLabels.CaseList.SaveAsNewPreset</button>
                                @if (caseList.PresetId is not null)
                                {
                                    <button class="btn" type="submit" asp-page-handler="CaseListPresetSave" data-busy-label="@OperatorLabels.Busy.Saving">@OperatorLabels.CaseList.SavePreset</button>
                                    <button class="btn btn--danger" type="submit" asp-page-handler="CaseListPresetRemove" data-busy-label="@OperatorLabels.Busy.Removing">@OperatorLabels.CaseList.RemovePreset</button>
                                }
                            </div>
                        </div>
                    }
                </form>
            </div>
        </section>
    </div>
</div>
