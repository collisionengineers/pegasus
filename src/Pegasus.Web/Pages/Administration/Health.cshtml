@page
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Administration.HealthModel
@{ ViewData["Title"] = "Service health"; ViewData["Eyebrow"] = "Administration"; }
<partial name="Shared/_PageHeader" />
<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
    @if (Model.Snapshot is { } snapshot)
    {
        <section class="panel">
            <div class="panel-head"><h2>Service health</h2></div>
            <div class="table-wrap no-border service-health-table">
                <table>
                    <thead><tr><th scope="col">Service</th><th scope="col">State</th><th scope="col">Last recorded</th><th scope="col">Dependency</th></tr></thead>
                    <tbody>
                    @foreach (var row in snapshot.Rows)
                    {
                        <tr>
                            <td>
                                <strong>@OperatorLabels.ServiceHealthServiceName(row.Service)</strong>
                                <span class="secondary">@OperatorLabels.ServiceHealthAreaName(row.Area)</span>
                            </td>
                            <td><partial name="Shared/_StatusChip" model="@OperatorLabels.ServiceHealthStateName(row.State)" /></td>
                            <td>@OperatorLabels.OfficeTime(row.LatestEvidenceAtUtc, "Not recorded")</td>
                            <td>@OperatorLabels.ServiceHealthDependencyName(row.Dependency)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
        <div class="notice" role="status">Service health is unavailable. Refresh to try again.</div>
    }
    </div>
</div>
