@page
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Administration.HealthModel
@{
    ViewData["Title"] = OperatorLabels.Admin.Health;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "health";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
<partial name="Shared/_PageHeader" />
<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
    @if (Model.Snapshot is { } snapshot)
    {
        <section class="panel" aria-label="@OperatorLabels.Admin.Health">
            <div class="table-wrap no-border service-health-table">
                <table class="table table--compact">
                    <caption class="sr-only">@OperatorLabels.Admin.Health</caption>
                    <thead><tr><th scope="col">Service</th><th scope="col">State</th><th scope="col">Last recorded</th><th scope="col">Dependency</th></tr></thead>
                    <tbody>
                    @foreach (var row in snapshot.Rows)
                    {
                        <tr>
                            <td>
                                <strong>@OperatorLabels.ServiceHealthServiceName(row.Service)</strong>
                                <small class="admin-service-area">@OperatorLabels.ServiceHealthAreaName(row.Area)</small>
                            </td>
                            <td>
                                <partial name="Shared/_StatusChip" model="@OperatorLabels.ServiceHealthStateName(row.State)" />
                                @if (!string.IsNullOrWhiteSpace(row.FailureCode))
                                {
                                    <small class="admin-service-area">@OperatorLabels.MailSettings.LastError(row.FailureCode)</small>
                                }
                            </td>
                            <td class="nowrap">@OperatorLabels.OfficeTime(row.LatestEvidenceAtUtc, "Not recorded")</td>
                            <td>@OperatorLabels.ServiceHealthDependencyName(row.Dependency)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
        <div class="notice notice--warning" role="status"><span>Service health is unavailable. Refresh to try again.</span></div>
    }
    </div>
</div>
