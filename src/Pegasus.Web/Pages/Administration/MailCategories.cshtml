@page
@model Pegasus.Web.Pages.Administration.MailCategoriesModel
@using Pegasus.Core.Intake
@{ ViewData["Title"] = "Outlook categories"; ViewData["Eyebrow"] = "Administration"; }

<a class="back-link" asp-page="/Administration/Index"><svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>Back to Administration</a>
<partial name="Shared/_PageHeader" />
@if (TempData["AdministrationStatus"] is string status) { <div class="status-card" role="status">@status</div> }
<div asp-validation-summary="All"></div>

<section aria-labelledby="current-categories"><h2 id="current-categories" class="section-label">Current categories</h2>
@if (Model.Categories.Count == 0) { <div class="panel empty-state">No Outlook categories are configured.</div> }
else { @foreach (var category in Model.Categories) {
    <div class="panel form-panel">
      <form method="post" asp-page-handler="Save">
        <input type="hidden" name="CategoryId" value="@category.Id" />
        <input type="hidden" name="ExpectedVersion" value="@category.Version" />
        <input type="hidden" name="OperationKey" value="@Guid.NewGuid().ToString("N")" />
        <label>Display name <input name="DisplayName" value="@category.DisplayName" required maxlength="255" /></label>
        <label>State <select name="SelectedState"><option value="Active" selected="@(category.State == ApprovedOutlookCategoryState.Active)">Active</option><option value="Disabled" selected="@(category.State == ApprovedOutlookCategoryState.Disabled)">Disabled</option></select></label>
        <label>Reason <input name="Reason" required maxlength="1000" /></label>
        <button type="submit" class="primary-action">Save category policy</button>
      </form>
    </div>
} }
</section>

<section class="section-gap" aria-labelledby="add-category"><h2 id="add-category" class="section-label">Add an approved category</h2>
  <div class="panel form-panel"><form method="post" asp-page-handler="Save">
    <input type="hidden" name="CategoryId" value="@Model.NewCategoryId" /><input type="hidden" name="ExpectedVersion" value="0" /><input type="hidden" name="OperationKey" value="@Model.OperationKey" />
    <label>Display name <input name="DisplayName" value="@(Model.ExpectedVersion == 0 ? Model.DisplayName : "")" required maxlength="255" /></label>
    <label>State <select name="SelectedState"><option value="Active">Active</option><option value="Disabled">Disabled</option></select></label>
    <label>Reason <input name="Reason" value="@(Model.ExpectedVersion == 0 ? Model.Reason : "")" required maxlength="1000" /></label>
    <button type="submit" class="primary-action">Add category policy</button>
  </form></div>
</section>
