@page
@model Pegasus.Web.Pages.Administration.ClaimSources.IndexModel
@{
    ViewData["Title"] = "Claim Sources";
    ViewData["Eyebrow"] = "Administration";
}

<a class="back-link" asp-page="/Administration/Index">
    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
    Back to Administration
</a>

<div class="page-heading">
    <div>
        <p class="eyebrow">Administration</p>
        <h1>Claim Sources</h1>
    </div>
</div>

@if (TempData["AdministrationStatus"] is string status)
{
    <div class="status-card" role="status">@status</div>
}

<div class="split-main">
    @if (Model.ClaimSources.Count > 0)
    {
        <section aria-labelledby="current-claim-sources-heading">
            <h2 id="current-claim-sources-heading" class="section-label">Current claim sources</h2>
            <div class="table-wrap">
                <table>
                    <caption class="vh">Claim sources and their contact details</caption>
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Contact</th>
                            <th scope="col">Telephone</th>
                            <th scope="col">Email</th>
                            <th scope="col">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var claimSource in Model.ClaimSources)
                    {
                        <tr>
                            <td>@claimSource.Name</td>
                            <td>@(claimSource.ContactName ?? "None")</td>
                            <td>@(claimSource.Telephone ?? "None")</td>
                            <td>@(claimSource.Email ?? "None")</td>
                            <td><partial name="Shared/_StatusChip" model="@(claimSource.Active ? "Active" : "Disabled")" /></td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@claimSource.Id">Edit</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section aria-labelledby="create-claim-source-heading">
        <h2 id="create-claim-source-heading" class="section-label">Create claim source</h2>
        <div class="panel form-panel form-panel--wide">
            <form method="post" asp-page-handler="Create">
                <div asp-validation-summary="ModelOnly"></div>
                <input asp-for="OperationKey" type="hidden" />
                <div>
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" autocomplete="off" />
                    <span asp-validation-for="Name"></span>
                </div>
                <div>
                    <label asp-for="ContactName">Contact name (optional)</label>
                    <input asp-for="ContactName" autocomplete="off" />
                </div>
                <div>
                    <label asp-for="Telephone">Telephone (optional)</label>
                    <input asp-for="Telephone" autocomplete="off" />
                </div>
                <div>
                    <label asp-for="Email">Email (optional)</label>
                    <input asp-for="Email" autocomplete="off" />
                </div>
                <div>
                    <label asp-for="Notes">Notes (optional)</label>
                    <textarea asp-for="Notes" rows="3"></textarea>
                </div>
                <input asp-for="Reason" type="hidden" />
                <div class="button-row">
                    <button type="submit" class="primary-action">Create claim source</button>
                </div>
            </form>
        </div>
    </section>
</div>
