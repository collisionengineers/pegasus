@page
@model Pegasus.Web.Pages.Administration.ClaimSources.IndexModel
@{
    ViewData["Title"] = OperatorLabels.Admin.ClaimSources;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "claim-sources";
}

<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">

@if (TempData["AdministrationStatus"] is string status)
{
    <div class="notice notice--success" role="status">@status</div>
}

    <section class="panel" aria-labelledby="current-claim-sources-heading">
        <div class="panel-head"><h2 id="current-claim-sources-heading">Current claim sources</h2></div>
        @if (Model.ClaimSources.Count == 0)
        {
            <div class="empty"><p>No claim sources are configured.</p></div>
        }
        else
        {
            <div class="table-wrap no-border">
                <table>
                    <caption class="sr-only">Claim sources and their contact details</caption>
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Contact</th>
                            <th scope="col">Telephone</th>
                            <th scope="col">Email</th>
                            <th scope="col">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var claimSource in Model.ClaimSources)
                    {
                        <tr>
                            <td>@claimSource.Name</td>
                            <td>@(claimSource.ContactName ?? "None")</td>
                            <td>@(claimSource.Telephone ?? "None")</td>
                            <td>@(claimSource.Email ?? "None")</td>
                            <td><partial name="Shared/_StatusChip" model="@(claimSource.Active ? "Active" : "Disabled")" /></td>
                            <td class="right"><a class="btn btn--small" asp-page="Edit" asp-route-id="@claimSource.Id">Edit</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel" aria-labelledby="create-claim-source-heading">
        <div class="panel-head"><h2 id="create-claim-source-heading">Create claim source</h2></div>
            <form method="post" asp-page-handler="Create" class="panel-body stack">
                <div asp-validation-summary="ModelOnly"></div>
                <input asp-for="OperationKey" type="hidden" />
                <div class="field">
                    <label class="req" asp-for="Name">Name</label>
                    <input asp-for="Name" autocomplete="off" />
                    <span asp-validation-for="Name"></span>
                </div>
                <div class="field">
                    <label asp-for="ContactName">Contact name (optional)</label>
                    <input asp-for="ContactName" autocomplete="off" />
                </div>
                <div class="field">
                    <label asp-for="Telephone">Telephone (optional)</label>
                    <input asp-for="Telephone" autocomplete="off" />
                </div>
                <div class="field">
                    <label asp-for="Email">Email (optional)</label>
                    <input asp-for="Email" autocomplete="off" />
                </div>
                <div class="field">
                    <label asp-for="Notes">Notes (optional)</label>
                    <textarea asp-for="Notes" rows="3"></textarea>
                </div>
                <div class="field">
                    <label class="req" asp-for="Reason">Reason</label>
                    <textarea asp-for="Reason" rows="3"></textarea>
                    <span asp-validation-for="Reason"></span>
                </div>
                <div class="button-row">
                    <button type="submit" class="btn btn--primary">Create claim source</button>
                </div>
            </form>
    </section>
</div>
</div>
