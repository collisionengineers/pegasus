@page
@using System.Globalization
@using Pegasus.Core.Assessment
@using Pegasus.Web.Pages.Administration.ValuationPresets
@model Pegasus.Web.Pages.Administration.ValuationPresets.IndexModel
@{
    ViewData["Title"] = ValuationPresetLabels.Title;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "valuation-presets";
    ViewData["AdminAutomationComposed"] = Model.AutomationComposed;
    var labelLimit = ValuationCalculationPolicy.MaximumAdditionLabelLength;
    var reasonLimit = ValuationCalculationPolicy.MaximumReasonLength;
    var editing = Model.EditingPresetId != Guid.Empty;
    var editingPreset = Model.Presets.SingleOrDefault(preset => preset.Id == Model.EditingPresetId);
    var usePostedValues = Model.RowPresetId == Model.EditingPresetId;
}

<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        <partial name="Shared/_ErrorSummary" />

        <section class="panel" aria-labelledby="valuation-presets-title">
            <div class="panel-head">
                <h2 id="valuation-presets-title">Fixed valuation additions</h2>
                <span class="muted">@Model.Presets.Count preset@(Model.Presets.Count == 1 ? string.Empty : "s")</span>
            </div>
            <div class="table-wrap no-border">
                <table class="preset-table">
                    <caption class="sr-only">@ValuationPresetLabels.Title</caption>
                    <thead>
                        <tr>
                            <th scope="col">@ValuationPresetLabels.PresetLabel</th>
                            <th scope="col">@ValuationPresetLabels.Amount</th>
                            <th scope="col">@ValuationPresetLabels.State</th>
                            <th scope="col"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Presets.Count == 0)
                    {
                        <tr><td colspan="4" class="muted">No valuation presets are recorded.</td></tr>
                    }
                    @foreach (var preset in Model.Presets)
                    {
                        @if (editing && editingPreset is not null && preset.Id == editingPreset.Id)
                        {
                            var presetId = editingPreset.Id.ToString("D");
                            var formId = $"preset-{presetId}";
                            <tr class="preset-row--editing">
                                <td>
                                    <label class="sr-only" for="preset-label-@presetId">@ValuationPresetLabels.PresetLabel</label>
                                    <input id="preset-label-@presetId" class="input" name="label" form="@formId" required maxlength="@labelLimit"
                                           value="@(usePostedValues ? Model.RowLabel : editingPreset.Label)" />
                                </td>
                                <td>
                                    <label class="sr-only" for="preset-amount-@presetId">@ValuationPresetLabels.Amount</label>
                                    <input id="preset-amount-@presetId" class="input-money" name="amount" type="number" inputmode="decimal" form="@formId" min="0" step="0.01" required
                                           value="@(usePostedValues ? Model.RowAmount : editingPreset.SuggestedAmount.ToString("0.00", CultureInfo.InvariantCulture))" />
                                </td>
                                <td>
                                    <label class="choice">
                                        <input name="active" type="checkbox" value="true" form="@formId"
                                               checked="@((usePostedValues ? Model.RowActive : editingPreset.Active) ? "checked" : null)" />
                                        <span>@ValuationPresetLabels.Enabled</span>
                                    </label>
                                </td>
                                <td>
                                    <span class="cluster">
                                        <button type="submit" form="@formId" class="btn btn--small">Cancel</button>
                                        <button type="submit" form="@formId" formaction="?handler=Save" class="btn btn--small btn--primary">Save</button>
                                    </span>
                                    <p id="preset-edit-heartbeat-@presetId" class="notice notice--error" role="alert" hidden></p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td><strong>@preset.Label</strong></td>
                                <td>@ValuationCalculationPolicy.FormatMoney(preset.SuggestedAmount)</td>
                                <td><partial name="Shared/_StatusChip" model="@ValuationPresetLabels.StateName(preset.Active)" /></td>
                                <td>
                                    <span class="cluster">
                                        <a class="btn btn--small" asp-page="/Administration/ValuationPresets/Index" asp-route-editPresetId="@preset.Id" asp-route-expectedVersion="@preset.Version">Edit</a>
                                        @* Offered only to the operator whose own other window still
                                           holds this preset; taking over rotates the token so that
                                           window can no longer save. *@
                                        @if (preset.Id == Model.TakeOverPresetId)
                                        {
                                            <form method="post" asp-page-handler="Edit">
                                                <input type="hidden" name="presetId" value="@preset.Id" />
                                                <input type="hidden" name="expectedVersion" value="@preset.Version" />
                                                <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                                <input type="hidden" name="takeOver" value="true" />
                                                <button type="submit" class="btn btn--small btn--primary">Take over</button>
                                            </form>
                                        }
                                        <button type="button" class="btn btn--small btn--danger" data-dialog-open="remove-preset-@preset.Id">@ValuationPresetLabels.Remove</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    <tr class="preset-row--add">
                        <td>
                            <label class="sr-only" for="create-label">@ValuationPresetLabels.PresetLabel</label>
                            <input id="create-label" class="input" name="label" form="preset-create" required maxlength="@labelLimit"
                                   value="@Model.CreateLabel" />
                        </td>
                        <td>
                            <label class="sr-only" for="create-amount">@ValuationPresetLabels.Amount</label>
                            <input id="create-amount" class="input-money" name="amount" type="number" inputmode="decimal" form="preset-create" min="0" step="0.01" required
                                   value="@(Model.CreateAmount?.ToString("0.00", CultureInfo.InvariantCulture))" />
                        </td>
                        <td>
                            <label class="choice">
                                <input name="active" type="checkbox" value="true" form="preset-create" checked="@(Model.CreateActive ? "checked" : null)" />
                                <span>@ValuationPresetLabels.Enabled</span>
                            </label>
                        </td>
                        <td>
                            <span class="cluster">
                                <a class="btn btn--small" asp-page="/Administration/ValuationPresets/Index">Cancel</a>
                                <button type="submit" form="preset-create" class="btn btn--small btn--primary">Add</button>
                            </span>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@* The add row's inputs live in the table above and post through this form via
   the HTML `form` attribute — a compact row rather than a separate creation
   panel, per the operator's request. *@
<form id="preset-create" method="post" asp-page-handler="Create" hidden>
    <input type="hidden" name="presetId" value="@Model.CreatePresetId.ToString("D")" />
    <input type="hidden" name="operationKey" value="@Model.CreateOperationKey" />
</form>

@* Removal is deliberate and reasoned, so it confirms in a compact dialog
   rather than inside the row. The dialogs live outside the presets table so
   the read surface stays a table; the row carries only the opener. A removed
   preset leaves the list and any new selection, and the valuations that
   already record it keep their own snapshot of what was selected. *@
@foreach (var preset in Model.Presets)
{
    var removeId = $"remove-preset-{preset.Id:D}";
    <div class="dialog-backdrop" data-dialog="@removeId" hidden>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="@removeId-title">
            <div class="dialog-head">
                <h2 id="@removeId-title" tabindex="-1" data-dialog-initial-focus>@ValuationPresetLabels.RemoveTitle</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
            </div>
            <form method="post" asp-page-handler="Remove">
                <input type="hidden" name="presetId" value="@preset.Id.ToString("D")" />
                <input type="hidden" name="expectedVersion" value="@preset.Version" />
                <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                <div class="dialog-body stack">
                    <p><strong>@preset.Label</strong> @ValuationCalculationPolicy.FormatMoney(preset.SuggestedAmount)</p>
                    <div class="field">
                        <label class="req" for="@removeId-reason">Reason</label>
                        <textarea id="@removeId-reason" name="reason" rows="2" required maxlength="@reasonLimit"></textarea>
                    </div>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>Cancel</button>
                    <button type="submit" class="btn btn--danger">@ValuationPresetLabels.Remove</button>
                </div>
            </form>
        </section>
    </div>
}

@if (editing && editingPreset is not null)
{
    var presetId = editingPreset.Id.ToString("D");
    var formId = $"preset-{presetId}";
    @* Likewise, the edited row's own inputs post through this form; Save and
       Cancel stay beside the changed values instead of a modal footer. *@
    <form id="@formId" method="post" asp-page-handler="CancelEdit"
          data-edit-heartbeat data-edit-heartbeat-url="?handler=HeartbeatEdit"
          data-edit-heartbeat-status="preset-edit-heartbeat-@presetId" hidden>
        <input type="hidden" name="presetId" value="@presetId" />
        <input type="hidden" name="expectedVersion" value="@Model.EditingPresetVersion" />
        <input type="hidden" name="editLeaseToken" value="@Model.EditingLeaseToken" />
        <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
    </form>
    @* Beaconed as the page unloads so an operator who navigates away is not
       refused by their own lease when they come back. *@
    <form method="post" asp-page-handler="ReleaseScopeBeacon" data-edit-scope-release hidden>
        <input type="hidden" name="presetId" value="@presetId" />
        <input type="hidden" name="editLeaseToken" value="@Model.EditingLeaseToken" />
    </form>
}
