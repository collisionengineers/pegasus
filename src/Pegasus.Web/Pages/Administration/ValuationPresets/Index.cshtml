@page
@using System.Globalization
@using Pegasus.Core.Assessment
@using Pegasus.Web.Pages.Administration.ValuationPresets
@model Pegasus.Web.Pages.Administration.ValuationPresets.IndexModel
@{
    ViewData["Title"] = ValuationPresetLabels.Title;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "valuation-presets";
    ViewData["AdminAutomationComposed"] = Model.AutomationComposed;
    var labelLimit = ValuationCalculationPolicy.MaximumAdditionLabelLength;
}

<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        <partial name="Shared/_ErrorSummary" />
        @if (TempData["Confirmation"] is string confirmation)
        {
            <div class="notice notice--success" role="status">@confirmation</div>
        }

        <section class="panel" aria-labelledby="valuation-presets-title">
            <div class="panel-head">
                <h2 id="valuation-presets-title">Fixed valuation additions</h2>
                <span class="meta">@Model.Presets.Count preset@(Model.Presets.Count == 1 ? string.Empty : "s")</span>
            </div>
            <div class="table-wrap no-border">
                <table class="table table--compact preset-table">
                    <caption class="sr-only">@ValuationPresetLabels.Title</caption>
                    <thead>
                        <tr>
                            <th scope="col">@ValuationPresetLabels.PresetLabel</th>
                            <th scope="col" class="num">@ValuationPresetLabels.Amount</th>
                            <th scope="col">@ValuationPresetLabels.State</th>
                            <th scope="col"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Presets.Count == 0)
                    {
                        <tr><td colspan="4" class="muted">No valuation presets are recorded.</td></tr>
                    }
                    @foreach (var preset in Model.Presets)
                    {
                        var presetId = preset.Id.ToString("D");
                        var saveFormId = "preset-save-" + preset.Id.ToString("N");
                        var removeFormId = "preset-remove-" + preset.Id.ToString("N");
                        var showingPostedValues = Model.RowPostFailed && Model.RowPresetId == preset.Id;
                        var rowLabel = showingPostedValues ? Model.RowLabel : preset.Label;
                        var rowAmount = showingPostedValues ? Model.RowAmount : preset.SuggestedAmount.ToString("0.00", CultureInfo.InvariantCulture);
                        var rowActive = showingPostedValues ? Model.RowActive : preset.Active;
                        var rowVersion = showingPostedValues ? Model.RowExpectedVersion : preset.Version;
                        var rowOperationKey = showingPostedValues ? Model.RowOperationKey : IndexModel.NewOperationKey();
                        <tr>
                            <td>
                                <label class="sr-only" for="preset-label-@presetId">@ValuationPresetLabels.PresetLabel</label>
                                <input id="preset-label-@presetId" class="input" name="label" form="@saveFormId" required maxlength="@labelLimit" value="@rowLabel" />
                            </td>
                            <td>
                                <label class="sr-only" for="preset-amount-@presetId">@ValuationPresetLabels.Amount</label>
                                <input id="preset-amount-@presetId" class="input-money" name="amount" type="number" inputmode="decimal" form="@saveFormId" min="0" step="0.01" required value="@rowAmount" />
                            </td>
                            <td>
                                <label class="choice">
                                    <input name="active" type="checkbox" value="true" form="@saveFormId" checked="@(rowActive ? "checked" : null)" />
                                    <span>@ValuationPresetLabels.Enabled</span>
                                </label>
                            </td>
                            <td>
                                <form id="@saveFormId" method="post" asp-page-handler="Save">
                                    <input type="hidden" name="presetId" value="@presetId" />
                                    <input type="hidden" name="expectedVersion" value="@rowVersion" />
                                    <input type="hidden" name="operationKey" value="@rowOperationKey" />
                                    <button type="reset" form="@saveFormId" class="btn btn--small">Reset</button>
                                    <button type="submit" class="btn btn--small btn--primary">@ValuationPresetLabels.Save</button>
                                </form>
                                <form id="@removeFormId" method="post" asp-page-handler="Remove">
                                    <input type="hidden" name="presetId" value="@presetId" />
                                    <input type="hidden" name="expectedVersion" value="@preset.Version" />
                                    <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                    <button type="submit" class="btn btn--small btn--danger">@ValuationPresetLabels.Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                    <tr class="preset-row--add">
                        <td>
                            <label class="sr-only" for="create-label">@ValuationPresetLabels.PresetLabel</label>
                            <input id="create-label" class="input" name="label" form="preset-create" required maxlength="@labelLimit" value="@Model.CreateLabel" />
                        </td>
                        <td>
                            <label class="sr-only" for="create-amount">@ValuationPresetLabels.Amount</label>
                            <input id="create-amount" class="input-money" name="amount" type="number" inputmode="decimal" form="preset-create" min="0" step="0.01" required value="@Model.CreateAmountInput" />
                        </td>
                        <td>
                            <label class="choice">
                                <input name="active" type="checkbox" value="true" form="preset-create" checked="@(Model.CreateActive ? "checked" : null)" />
                                <span>@ValuationPresetLabels.Enabled</span>
                            </label>
                        </td>
                        <td>
                            <form id="preset-create" method="post" asp-page-handler="Create">
                                <input type="hidden" name="presetId" value="@Model.CreatePresetId.ToString("D")" />
                                <input type="hidden" name="operationKey" value="@Model.CreateOperationKey" />
                                <a class="btn btn--small" asp-page="/Administration/ValuationPresets/Index">Cancel</a>
                                <button type="submit" class="btn btn--small btn--primary">Add</button>
                            </form>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>