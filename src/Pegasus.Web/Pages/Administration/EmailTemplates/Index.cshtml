@page
@using Pegasus.Core.Operations
@model Pegasus.Web.Pages.Administration.EmailTemplates.IndexModel
@using Labels = Pegasus.Web.Presentation.OperatorLabels.EmailTemplates
@using Templates = Pegasus.Core.Operations.EmailTemplates
@{
    ViewData["Title"] = Labels.Area;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "email-templates";
    ViewData["AdminAutomationComposed"] = Model.AutomationComposed;
}

<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        @if (TempData["Confirmation"] is string confirmation)
        {
            <div class="notice notice--success" role="status">@confirmation</div>
        }

        <section class="panel" aria-labelledby="email-templates-title">
            <div class="panel-head">
                <h2 id="email-templates-title">@Labels.Area</h2>
            </div>
            <div class="table-wrap no-border">
                <table class="table table--compact">
                    <caption class="sr-only">@Labels.Area</caption>
                    <thead>
                        <tr>
                            <th scope="col">@Labels.Template</th>
                            <th scope="col">@Labels.LastChanged</th>
                            <th scope="col"><span class="sr-only">@Labels.Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var template in Model.Templates)
                    {
                        <tr data-email-template="@template.Purpose">
                            <td>@Labels.Name(template.Purpose)</td>
                            <td>
                                @if (template.UpdatedAtUtc is { } changedAt)
                                {
                                    @($"{Model.ChangedBy(template)} · {OperatorLabels.OfficeTime(changedAt)}")
                                }
                                else
                                {
                                    <span class="muted">@OperatorLabels.CaseWorkspace.AbsentValue</span>
                                }
                            </td>
                            <td class="num">
                                <button type="button" class="btn btn--small" data-dialog-open="email-template-@template.Purpose">@Labels.Edit</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@foreach (var template in Model.Templates)
{
    var dialogId = $"email-template-{template.Purpose}";
    var bodyId = $"{dialogId}-body";
    var refused = Model.RefusedPurpose == template.Purpose;
    <div class="dialog-backdrop" data-dialog="@dialogId" data-dialog-open-on-load="@(refused ? "true" : null)" hidden>
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="@dialogId-title">
            <div class="dialog-head">
                <h2 id="@dialogId-title" tabindex="-1">@Labels.Name(template.Purpose)</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                </button>
            </div>
            <form method="post" asp-page-handler="Save">
                <input type="hidden" name="purpose" value="@template.Purpose" />
                <input type="hidden" name="expectedVersion" value="@(refused ? Model.RefusedVersion : template.Version)" />
                <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                <div class="dialog-body stack">
                    @if (refused)
                    {
                        <partial name="Shared/_ErrorSummary" />
                    }
                    <div class="field">
                        <label class="req" for="@bodyId">@Labels.Body</label>
                        <textarea id="@bodyId" name="body" rows="12" required maxlength="@Templates.MaximumBodyLength" data-dialog-initial-focus>@(refused ? Model.RefusedBody : template.Body)</textarea>
                    </div>
                    <div class="button-row" role="group" aria-label="@Labels.Placeholders">
                        @foreach (var placeholder in Templates.Placeholders(template.Purpose))
                        {
                            var token = "{" + placeholder + "}";
                            <button type="button" class="btn btn--small" data-insert-placeholder="@token" data-insert-target="@bodyId">@token</button>
                        }
                    </div>
                </div>
                <div class="dialog-foot">
                    <button type="button" class="btn" data-dialog-close>@Labels.Cancel</button>
                    <button type="submit" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Saving">@Labels.Save</button>
                </div>
            </form>
        </section>
    </div>
}

@section Scripts {
    <script src="~/js/email-templates.js" asp-append-version="true"></script>
}
