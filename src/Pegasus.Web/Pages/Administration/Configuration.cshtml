@page
@model Pegasus.Web.Pages.Administration.ConfigurationModel
@{
    ViewData["Title"] = OperatorLabels.Admin.Configuration;
    ViewData["AdminArea"] = "configuration";
    ViewData["AdminAutomationComposed"] = Model.AutomationComposed;
}

<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <section class="panel" aria-labelledby="workflow-configuration-title">
        <div class="panel-head">
            <div>
                <h2 id="workflow-configuration-title">@OperatorLabels.Admin.Configuration</h2>
                <div class="panel-title-meta">
                    @OperatorLabels.WorkflowConfiguration.Meta(Model.Configuration.PolicyVersion)
                </div>
            </div>
        </div>
        <div class="panel-body stack">
            <p class="empty-state">This workflow policy is fixed. There are no editable settings.</p>
            <dl class="definition-list">
                <div class="definition">
                    <dt>Policy</dt>
                    <dd>@Model.Configuration.PolicyKey</dd>
                </div>
                <div class="definition">
                    <dt>Current version</dt>
                    <dd>@Model.Configuration.PolicyVersion</dd>
                </div>
            </dl>
        </div>
    </section>
</div>
