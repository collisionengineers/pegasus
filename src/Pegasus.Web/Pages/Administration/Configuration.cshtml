@page
@using Pegasus.Core.Workflow
@model Pegasus.Web.Pages.Administration.ConfigurationModel
@{
    ViewData["Title"] = OperatorLabels.Admin.Configuration;
    ViewData["AdminArea"] = "configuration";
    ViewData["AdminAutomationComposed"] = Model.AutomationComposed;
    var workflowEditing = Model.EditingId == GetWorkflowConfiguration.RecordId;
}
<partial name="Shared/_PageHeader" />
<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        <partial name="Shared/_ErrorSummary" />
        <section class="panel" aria-labelledby="workflow-title">
            <div class="panel-head">
                <h2 id="workflow-title">Case workflow</h2>
                @if (!Model.IsEditing)
                {
                    <form method="post" asp-page-handler="Edit">
                        <input type="hidden" name="recordId" value="@GetWorkflowConfiguration.RecordId" />
                        @* Offered only to the operator whose own other window still holds this
                           record; taking over rotates the token so that window can no longer
                           save. *@
                        @if (Model.TakeOverRecordId == GetWorkflowConfiguration.RecordId)
                        {
                            <input type="hidden" name="takeOver" value="true" />
                            <button class="btn btn--primary" type="submit">Take over</button>
                        }
                        else
                        {
                            <button class="btn" type="submit">Edit</button>
                        }
                    </form>
                }
            </div>
            <div class="panel-body">
                @if (!workflowEditing)
                {
                    <dl class="definition-list definition-list--compact" data-workflow-settings>
                        <div class="definition"><dt>Instructions</dt><dd>@(Model.Configuration.RequireInstructions ? "Required" : "Not required")</dd></div>
                        <div class="definition"><dt>Images</dt><dd>@(Model.Configuration.RequireImages ? "Required" : "Not required")</dd></div>
                        @foreach (var setting in Model.WorkflowSettings)
                        {
                            <div class="definition" data-workflow-setting="@setting.Field"><dt>@setting.Label</dt><dd>@ConfigurationModel.Days(setting.Current)</dd></div>
                        }
                    </dl>
                }
                else
                {
                    <fieldset form="configuration-edit" class="stack">
                        <legend>Required before Review</legend>
                        <div class="form-grid form-grid--2">
                            <label class="choice"><input form="configuration-edit" type="checkbox" name="RequireInstructions" value="true" checked="@Model.RequireInstructions" /> Instructions</label>
                            <label class="choice"><input form="configuration-edit" type="checkbox" name="RequireImages" value="true" checked="@Model.RequireImages" /> Images</label>
                        </div>
                        <div class="form-grid form-grid--3" data-workflow-settings-edit>
                            @foreach (var setting in Model.WorkflowSettings)
                            {
                                var inputId = $"setting-{setting.Field}";
                                <div class="field">
                                    <label for="@inputId">@setting.Label (days)</label>
                                    <input form="configuration-edit" id="@inputId" name="@setting.Field" type="number" min="@setting.Minimum" max="@setting.Maximum" step="1" value="@setting.Posted" required class="@(setting.Field == nameof(ConfigurationModel.ChaseIntervalDays) ? "chase-interval-input" : null)" />
                                    <span class="field-hint">@setting.Minimum to @setting.Maximum</span>
                                    <span asp-validation-for="@setting.Field" class="field-error"></span>
                                </div>
                            }
                        </div>
                    </fieldset>
                }
            </div>
        </section>
        <section class="panel" aria-labelledby="rates-title">
            <div class="panel-head"><h2 id="rates-title">Labour-rate cards</h2>
                @if (!Model.IsEditing)
                {
                    <form method="post" asp-page-handler="NewCard"><button class="btn" type="submit">Add rate card</button></form>
                }
            </div>
            <div class="table-wrap no-border"><table>
                <thead><tr><th>Name</th><th>Panel and paint (£/hour)</th><th>Enabled</th><th></th></tr></thead>
                <tbody>
                @foreach (var card in Model.RateCards.Where(x => x.Id != Model.EditingId))
                {
                    <tr><td>@card.Name</td><td>@card.HourlyRate.ToString("N2")</td><td>@(card.Enabled ? "Yes" : "No")</td><td>
                    @if (!Model.IsEditing)
                    {
                        <form method="post" asp-page-handler="Edit"><input type="hidden" name="recordId" value="@card.Id" />@if (Model.TakeOverRecordId == card.Id) { <input type="hidden" name="takeOver" value="true" /><button class="btn btn--small btn--primary" type="submit">Take over</button> } else { <button class="btn btn--small" type="submit">Edit</button> }</form>
                    }
                    </td></tr>
                }
                @if (Model.IsEditing && !workflowEditing)
                {
                    <tr>
                        <td><input form="configuration-edit" aria-label="Name" name="CardName" value="@Model.CardName" maxlength="200" required /></td>
                        <td><input form="configuration-edit" aria-label="Hourly rate" name="HourlyRate" type="number" min="0" max="999999" step="0.01" value="@Model.HourlyRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></td>
                        <td><select form="configuration-edit" aria-label="Enabled" name="Enabled"><option value="true" selected="@Model.Enabled">Yes</option><option value="false" selected="@(!Model.Enabled)">No</option></select></td><td></td>
                    </tr>
                }
                </tbody>
            </table></div>
        </section>
        @if (Model.IsEditing)
        {
            <form id="configuration-edit" method="post" asp-page-handler="Save" data-config-editor data-heartbeat-ms="@EditScopeAuthority.HeartbeatInterval.TotalMilliseconds" data-existing="@(Model.ExpectedVersion > 0 ? "true" : "false")">
                <input type="hidden" asp-for="EditingId" /><input type="hidden" asp-for="ExpectedVersion" />
                <input type="hidden" asp-for="LeaseToken" /><input type="hidden" asp-for="OperationKey" />
                <div class="button-row">
                    <button type="submit" class="btn" asp-page-handler="Cancel" formnovalidate>Cancel</button>
                    <button type="submit" class="btn btn--primary">Save</button>
                </div>
                <p data-config-lease-message class="muted" role="status"></p>
            </form>
            @* Beaconed as the page unloads so an operator who navigates away is
               not refused by their own lease when they come back. A new rate
               card has no scope to release. *@
            if (Model.ExpectedVersion > 0)
            {
                <form method="post" asp-page-handler="ReleaseScopeBeacon" data-edit-scope-release hidden>
                    <input type="hidden" asp-for="EditingId" />
                    <input type="hidden" asp-for="LeaseToken" />
                </form>
            }
        }
    </div>
</div>
@section Scripts {
    <script src="~/js/workflow-configuration.js" asp-append-version="true"></script>
}
