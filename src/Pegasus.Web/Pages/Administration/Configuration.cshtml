@page
@model Pegasus.Web.Pages.Administration.ConfigurationModel
@{
    ViewData["Title"] = "Workflow configuration";
    ViewData["Eyebrow"] = "Administration";
}

<a class="back-link" asp-page="/Administration/Index">
    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
    Back to Administration
</a>

<partial name="Shared/_PageHeader" />

@if (TempData["AdministrationStatus"] is string status)
{
    <div class="status-card" role="status">@status</div>
}

@* What relaxing a gate does to work already assigned — the question an
   administrator has at the moment they reach for the checkbox. *@
<aside class="notice">
    <p>These versioned gates control whether a case can be assigned to an Engineer. Relaxing one applies to every case from the next version on — it does not reopen past assignments. This page contains no credentials, secrets or cloud controls.</p>
</aside>

<div class="split-main">
    <section aria-labelledby="current-workflow-configuration-heading">
        <h2 id="current-workflow-configuration-heading" class="section-label">Current configuration</h2>
        <div class="panel">
            <dl class="detail-list">
                <div>
                    <dt>Policy</dt>
                    <dd>@Model.Configuration.PolicyKey</dd>
                </div>
                <div>
                    <dt>Version</dt>
                    <dd class="tabular">@Model.Configuration.PolicyVersion</dd>
                </div>
                <div>
                    <dt>Complete instructions before Engineer assignment</dt>
                    <dd>@(Model.Configuration.RequireCompleteInstructionsBeforeEngineerAssignment ? "Required" : "Not required")</dd>
                </div>
                <div>
                    <dt>Complete images before Engineer assignment</dt>
                    <dd>@(Model.Configuration.RequireCompleteImagesBeforeEngineerAssignment ? "Required" : "Not required")</dd>
                </div>
                <div>
                    <dt>Staff instruction review before Engineer assignment</dt>
                    <dd>@(Model.Configuration.RequireStaffInstructionReviewBeforeEngineerAssignment ? "Required" : "Not required")</dd>
                </div>
                <div>
                    <dt>Staff image review before Engineer assignment</dt>
                    <dd>@(Model.Configuration.RequireStaffImageReviewBeforeEngineerAssignment ? "Required" : "Not required")</dd>
                </div>
            </dl>
        </div>
    </section>

    <section aria-labelledby="update-workflow-configuration-heading">
        <h2 id="update-workflow-configuration-heading" class="section-label">Update assignment gates</h2>
        <div class="panel form-panel form-panel--wide">
            <form method="post" asp-page="/Administration/Configuration">
                @* A rejected save is most often a stale version: another administrator
                   changed the policy since this page loaded. The summary carries that
                   exact outcome and the recovery is to reload and reapply. *@
                <div asp-validation-summary="All"></div>
                <input asp-for="ExpectedVersion" type="hidden" />
                <input asp-for="OperationKey" type="hidden" />
                <fieldset class="role-choices role-choices--stacked">
                    <legend>Required before Engineer assignment</legend>
                    <label class="choice">
                        <input asp-for="RequireCompleteInstructionsBeforeEngineerAssignment" />
                        <span>Instructions are complete</span>
                    </label>
                    <label class="choice">
                        <input asp-for="RequireCompleteImagesBeforeEngineerAssignment" />
                        <span>Images are complete</span>
                    </label>
                    <label class="choice">
                        <input asp-for="RequireStaffInstructionReviewBeforeEngineerAssignment" />
                        <span>A staff member reviewed the instructions</span>
                    </label>
                    <label class="choice">
                        <input asp-for="RequireStaffImageReviewBeforeEngineerAssignment" />
                        <span>A staff member reviewed the images</span>
                    </label>
                </fieldset>
                <div>
                    <label asp-for="Reason">Reason for this configuration change</label>
                    <textarea asp-for="Reason" required maxlength="1000" rows="3"></textarea>
                    <span asp-validation-for="Reason"></span>
                </div>
                <div class="button-row">
                    <button type="submit" class="primary-action">Save workflow configuration</button>
                </div>
            </form>
        </div>
    </section>
</div>
