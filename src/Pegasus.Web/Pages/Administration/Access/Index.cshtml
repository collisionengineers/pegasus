@page
@model Pegasus.Web.Pages.Administration.Access.IndexModel
@{
    ViewData["Title"] = "Access review";
    ViewData["Eyebrow"] = "Administration";
}

<a class="back-link" asp-page="/Administration/Index">
    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
    Back to Administration
</a>

<partial name="Shared/_PageHeader" />

@if (TempData["AdministrationStatus"] is string status)
{
    <div class="status-card" role="status">@status</div>
}

@* What recording a review does, and — just as important — what it does not. *@
<aside class="notice">
    <p>An access review records that a named administrator looked at who can sign in and what they can do. The decision is permanent and attributable; it changes nothing by itself.</p>
</aside>

<div asp-validation-summary="ModelOnly"></div>

@if (Model.Accounts.Count == 0)
{
    <div class="panel empty-state">No staff accounts are available for review.</div>
}
else
{
    <div class="table-wrap">
        <table>
            <caption class="vh">Current staff access and the last recorded review decision</caption>
            <thead>
                <tr>
                    <th scope="col">Username</th>
                    <th scope="col">Status</th>
                    <th scope="col">Roles</th>
                    <th scope="col">Last reviewed</th>
                    <th scope="col">Review state</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var account in Model.Accounts)
            {
                <tr>
                    <td>@account.UserName</td>
                    <td><partial name="Shared/_StatusChip" model="@(account.IsEnabled ? "Enabled" : "Disabled")" /></td>
                    <td>@string.Join(", ", account.CurrentRoles)</td>
                    <td>
                        @if (account.LastReviewedAtUtc is { } reviewedAtUtc)
                        {
                            <time datetime="@reviewedAtUtc.ToString("O")">@reviewedAtUtc.ToString("u")</time>
                        }
                        else
                        {
                            <span class="empty-state">Not recorded</span>
                        }
                    </td>
                    <td>
                        <partial name="Shared/_StatusChip" model="@(account.ReviewIsOutstanding ? "Due — no review recorded" : "Recorded")" /></td>
                    <td>
                        <form method="post">
                            <input type="hidden" name="StaffId" value="@account.StaffId" />
                            <input type="hidden" name="OperationKey" value="@Model.OperationKey" />
                            <label>
                                Reason
                                <input name="Reason" required maxlength="1000" />
                            </label>
                            <div class="button-row">
                                <button type="submit" class="primary-action" asp-page-handler="Review">Record reviewed</button>
                            </div>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
