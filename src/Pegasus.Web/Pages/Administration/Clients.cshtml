@page
@using Pegasus.Core.Identity
@model Pegasus.Web.Pages.Administration.ClientsModel
@{
    ViewData["Title"] = "Public MCP clients";
}

<h1>Public MCP clients</h1>
<p><a asp-page="/Administration/Index">Back to Administration</a></p>

@if (TempData["AdministrationStatus"] is string status)
{
    <div role="status">@status</div>
}

<div asp-validation-summary="ModelOnly"></div>

<section aria-labelledby="register-public-client-heading">
    <h2 id="register-public-client-heading">Register an approved public client</h2>
    <p>Registration works without a client secret. The public client is permanently constrained to authorization code, refresh token, explicit consent, and PKCE S256.</p>
    <form method="post" asp-page-handler="Register">
        <input asp-for="Registration.OperationKey" type="hidden" />
        <div>
            <label asp-for="Registration.ClientId">Client ID</label>
            <input asp-for="Registration.ClientId" autocomplete="off" />
            <span asp-validation-for="Registration.ClientId"></span>
        </div>
        <div>
            <label asp-for="Registration.DisplayName">Display name</label>
            <input asp-for="Registration.DisplayName" autocomplete="off" />
            <span asp-validation-for="Registration.DisplayName"></span>
        </div>
        <div>
            <label asp-for="Registration.RedirectUris">Exact redirect URIs, one per line</label>
            <textarea asp-for="Registration.RedirectUris" rows="4" spellcheck="false"></textarea>
            <span asp-validation-for="Registration.RedirectUris"></span>
        </div>
        <div>
            <label asp-for="Registration.Resource">Exact protected resource</label>
            <input asp-for="Registration.Resource" type="url" placeholder="https://example.invalid/mcp" />
            <span asp-validation-for="Registration.Resource"></span>
        </div>
        <fieldset>
            <legend>Approved scopes</legend>
            <label>
                <input type="checkbox" name="Registration.SelectedScopes" value="@StaffMcpClientContract.ReadScope" />
                @StaffMcpClientContract.ReadScope
            </label>
            <label>
                <input type="checkbox" name="Registration.SelectedScopes" value="@StaffMcpClientContract.WriteScope" />
                @StaffMcpClientContract.WriteScope
            </label>
        </fieldset>
        <div>
            <label asp-for="Registration.Reason">Reason</label>
            <textarea asp-for="Registration.Reason" rows="3"></textarea>
            <span asp-validation-for="Registration.Reason"></span>
        </div>
        <button type="submit">Register public client</button>
    </form>
</section>

<section aria-labelledby="revoke-public-client-heading">
    <h2 id="revoke-public-client-heading">Revoke a public client</h2>
    <p>Revocation removes the client and immediately revokes its authorizations and tokens.</p>
    <form method="post" asp-page-handler="Revoke">
        <input asp-for="Revocation.OperationKey" type="hidden" />
        <div>
            <label asp-for="Revocation.ClientId">Client ID</label>
            <input asp-for="Revocation.ClientId" autocomplete="off" />
            <span asp-validation-for="Revocation.ClientId"></span>
        </div>
        <div>
            <label asp-for="Revocation.Reason">Reason</label>
            <textarea asp-for="Revocation.Reason" rows="3"></textarea>
            <span asp-validation-for="Revocation.Reason"></span>
        </div>
        <button type="submit">Revoke public client</button>
    </form>
</section>
