@page "{id:guid}"
@model Pegasus.Web.Pages.Administration.Contacts.EditModel
@using Pegasus.Core.Cases
@using Pegasus.Core.Reports
@{
    ViewData["Title"] = Model.Contact!.Name;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "contacts";
}
<partial name="Shared/_PageHeader" />
<div class="admin-layout"><partial name="Shared/_AdminNav" /><div class="stack">
    @if (TempData["AdministrationStatus"] is string status) { <div class="notice notice--success" role="status">@status</div> }
    <section class="panel" aria-labelledby="contact-title">
        <div class="panel-head"><div><h2 id="contact-title">@Model.Contact!.Name</h2><p class="panel-title-meta">One organisation may have several contact types.</p></div><partial name="Shared/_StatusChip" model="@(Model.Contact.Active ? "Active" : "Disabled")" /></div>
        <form method="post" asp-page-handler="Save" asp-route-id="@Model.ContactId" class="panel-body stack contact-editor" data-contact-editor>
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <input asp-for="ContactId" type="hidden" /><input type="hidden" name="ExpectedVersion" value="@Model.ExpectedVersion" /><input asp-for="GuidanceTemplateVersion" type="hidden" /><input asp-for="OperationKey" type="hidden" />
            <fieldset class="stack">
            <div class="form-grid form-grid--2">
                <div class="field field-wide"><label class="req" asp-for="Name">Organisation name</label><input asp-for="Name" autocomplete="organization" /><span asp-validation-for="Name"></span></div>
                <div class="field"><label asp-for="ContactPerson">Contact person</label><input asp-for="ContactPerson" autocomplete="name" /></div>
                <div class="field"><label asp-for="Telephone">Phone</label><input asp-for="Telephone" type="tel" inputmode="tel" pattern="^\+?[0-9 ]+$" autocomplete="tel" /><span asp-validation-for="Telephone"></span></div>
                <div class="field field-wide"><label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="email" /></div>
                <div class="field"><label asp-for="Address">Address</label><textarea asp-for="Address" rows="3" autocomplete="street-address"></textarea></div>
                <div class="field"><label asp-for="Postcode">Postcode</label><input asp-for="Postcode" autocomplete="postal-code" /></div>
            </div>
            <section class="contact-section" aria-labelledby="contact-types-title">
                <h3 id="contact-types-title">Contact types</h3>
                <div class="contact-kind-grid">@foreach (var role in Enum.GetValues<ContactRole>()) { <label class="contact-kind"><input type="checkbox" name="Roles" value="@role" @(Model.Roles.Contains(role) ? "checked" : null) data-contact-role="@role" /> <span>@EditModel.RoleLabel(role)</span></label> }</div>
            </section>
            <section class="contact-section" data-principal-fields hidden="@(!Model.Roles.Contains(ContactRole.Principal))" aria-labelledby="principal-details-title">
                <h3 id="principal-details-title">Principal details</h3>
                <div class="form-grid form-grid--2"><div class="field"><label asp-for="PrincipalCode">@OperatorLabels.PrincipalAdministration.Code</label><input asp-for="PrincipalCode" autocomplete="off" data-principal-field-input disabled="@(!Model.Roles.Contains(ContactRole.Principal))" /><span asp-validation-for="PrincipalCode"></span></div><div class="field"><label asp-for="PrincipalInspectionMode">Inspection mode</label><select asp-for="PrincipalInspectionMode" data-principal-field-input disabled="@(!Model.Roles.Contains(ContactRole.Principal))"><option value="@CaseInspectionMode.PhysicalAddress">Physical address</option><option value="@CaseInspectionMode.ImageBasedAssessment">Image Based Assessment</option></select></div></div>
            </section>
            <section class="contact-section" data-case-guidance hidden="@(!(Model.Roles.Contains(ContactRole.Principal) || Model.Roles.Contains(ContactRole.ClaimSource)))" aria-labelledby="case-guidance-title">
                <h3 id="case-guidance-title">Case guidance</h3>
                <div class="field"><label asp-for="GuidanceTemplate">Guidance for new Cases</label><textarea asp-for="GuidanceTemplate" rows="4"></textarea><span asp-validation-for="GuidanceTemplate"></span></div>
                @* Record notes (13 September): stored once on the organisation, shown read-only on every Case of this Principal or from this Claim source. *@
                <div class="field" data-notes-on-every-case><label asp-for="NotesOnEveryCase">Notes on every Case</label><textarea asp-for="NotesOnEveryCase" rows="4" maxlength="@ContactDirectoryPolicy.MaximumNotesOnEveryCaseLength"></textarea><span asp-validation-for="NotesOnEveryCase"></span></div>
            </section>
            <section class="contact-section" aria-labelledby="linked-principals-title">
                <h3 id="linked-principals-title">Linked principals</h3><p class="hint">Choose the role this contact has for each principal. Principal contacts cannot link to themselves.</p>
                @foreach (var role in Enum.GetValues<ContactRole>().Where(role => role != ContactRole.Principal)) { var selected = Model.Roles.Contains(role); <div class="stack" data-principal-associations="@role" hidden="@(!selected)"><strong>@EditModel.RoleLabel(role)</strong>@foreach (var principal in Model.PrincipalChoices) { var key = $"{role}:{principal.Principal.Id:D}"; <label class="choice"><input type="checkbox" name="PrincipalAssociationKeys" value="@key" @(Model.PrincipalAssociationKeys.Contains(key) ? "checked" : null) data-principal-association-input disabled="@(!selected)" /> <span>@principal.Name (@principal.Principal.Code)</span></label> }</div> }
            </section>
            <label class="choice"><input asp-for="Active" /> <span>Active</span></label>
            </fieldset>
            <div class="button-row"><button type="submit" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Saving">Save contact</button><a asp-page="Index" class="btn">Cancel</a></div>
        </form>
    </section>

    @if (Model.Principal is not null)
    {
        <section class="panel" aria-labelledby="principal-settings-title">
            <div class="panel-head"><div><h2 id="principal-settings-title">Principal settings</h2><p class="panel-title-meta mono">@Model.Principal.Code</p></div><partial name="Shared/_StatusChip" model="@(Model.Principal.IsActive ? "Active" : "Disabled")" /></div>
            <div class="panel-body stack"><div asp-validation-summary="All" class="validation-summary" role="alert"></div>@if (Model.AcceptedIdentities.Count > 0) { <dl class="definition-list"><div class="definition"><dt>Accepted e-mail identities</dt><dd>@string.Join(", ", Model.AcceptedIdentities)</dd></div></dl> }</div>
        </section>
        @if (Model.Principal.IsActive)
        {
            <section class="panel" aria-labelledby="principal-report-title"><div class="panel-head"><h2 id="principal-report-title">Report generation</h2></div><form method="post" asp-page-handler="UpdateReportSettings" asp-route-id="@Model.ContactId" class="panel-body stack"><input type="hidden" name="ExpectedVersion" value="@Model.ExpectedVersion" /><input type="hidden" name="PrincipalExpectedVersion" value="@Model.PrincipalExpectedVersion" /><input asp-for="ReportSettingsOperationKey" type="hidden" /><fieldset class="stack"><div class="field"><label for="report-generation-route">Report generation</label><select id="report-generation-route" data-report-generation-route><option value="Pegasus" selected="@(!PrincipalReportGenerationPolicyRules.IsEva(Model.ReportGenerationPolicy))">Pegasus</option><option value="Eva" selected="@(PrincipalReportGenerationPolicyRules.IsEva(Model.ReportGenerationPolicy))">EVA</option></select></div><div class="field" data-report-generation-eva-delivery hidden="@(!PrincipalReportGenerationPolicyRules.IsEva(Model.ReportGenerationPolicy))"><label for="report-generation-eva-mode">EVA delivery</label><select id="report-generation-eva-mode" data-report-generation-eva-mode><option value="@PrincipalReportGenerationPolicy.EvaZip" selected="@(Model.ReportGenerationPolicy == PrincipalReportGenerationPolicy.EvaZip)">ZIP export</option><option value="@PrincipalReportGenerationPolicy.EvaManualApi" selected="@(Model.ReportGenerationPolicy == PrincipalReportGenerationPolicy.EvaManualApi)">Manual API submission</option><option value="@PrincipalReportGenerationPolicy.EvaAutomaticApiOnReview" selected="@(Model.ReportGenerationPolicy == PrincipalReportGenerationPolicy.EvaAutomaticApiOnReview)">Automatic API submission at Review</option></select></div><input type="hidden" asp-for="ReportGenerationPolicy" data-report-generation-value /><span asp-validation-for="ReportGenerationPolicy"></span><div class="field"><label for="principal-default-fee">@OperatorLabels.PrincipalAdministration.DefaultFee</label><input id="principal-default-fee" name="DefaultFee" type="number" inputmode="decimal" min="0.01" step="0.01" required value="@Model.DefaultFee?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" /></div><div class="button-row"><button type="submit" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Saving">Save report settings</button></div></fieldset></form></section>
            @* Report sending rules (Report Sending SOP v5): who the report goes to and from, who is copied, what goes with it, and what holds or stops delivery.
               A rule row left blank is ignored, so the list keeps one spare row to type into. *@
            @{
                var sending = Model.ReportSendingRules;
                var sendFromChoices = Model.SendFromChoices.ToList();
                if (!string.IsNullOrWhiteSpace(sending.SendFromMailbox) && !sendFromChoices.Contains(sending.SendFromMailbox, StringComparer.OrdinalIgnoreCase)) sendFromChoices.Add(sending.SendFromMailbox);
                var outcomeCodes = Pegasus.Core.Assessment.AssessmentVocabulary.Definitions[Pegasus.Core.Assessment.AssessmentVocabulary.Outcome].Codes!;
                var ruleRows = sending.Rules.Append(new ReportSendingRule(ReportSendingRuleMatch.All, [], ReportSendingActions.None)).ToArray();
                IEnumerable<(string Id, string Name)> ContactOptions(IReadOnlyList<ContactDirectoryRecord> choices, IEnumerable<string> selected)
                {
                    var options = choices.Select(choice => (choice.OrganizationId.ToString("D"), choice.Name)).ToList();
                    foreach (var id in selected)
                    {
                        if (!options.Any(option => string.Equals(option.Item1, id, StringComparison.OrdinalIgnoreCase))) options.Add((id, id));
                    }
                    return options;
                }
            }
            <section class="panel" aria-labelledby="principal-sending-title"><div class="panel-head"><h2 id="principal-sending-title">@OperatorLabels.PrincipalAdministration.ReportSending</h2></div><form method="post" asp-page-handler="UpdateReportSending" asp-route-id="@Model.ContactId" class="panel-body stack" data-report-sending-editor><input type="hidden" name="ExpectedVersion" value="@Model.ExpectedVersion" /><input type="hidden" name="PrincipalExpectedVersion" value="@Model.PrincipalExpectedVersion" /><input asp-for="ReportSendingOperationKey" type="hidden" /><fieldset class="stack">
                <div class="form-grid form-grid--2">
                    <div class="field"><label for="rs-send-from">@OperatorLabels.PrincipalAdministration.SendFrom</label><select id="rs-send-from" name="RsSendFrom"><option value="">@OperatorLabels.PrincipalAdministration.SendFromNone</option>@foreach (var address in sendFromChoices) { <option value="@address" selected="@string.Equals(address, sending.SendFromMailbox, StringComparison.OrdinalIgnoreCase)">@address</option> }</select></div>
                    <fieldset class="field"><legend>@OperatorLabels.PrincipalAdministration.SendTo</legend><div class="stack" data-rs-items="RsSendTo">@foreach (var address in sending.SendTo) { <input name="RsSendTo" type="email" value="@address" aria-label="@OperatorLabels.PrincipalAdministration.SendTo" autocomplete="off" /> }</div><button type="button" class="btn" data-rs-add="RsSendTo" data-rs-label="@OperatorLabels.PrincipalAdministration.SendTo" data-rs-type="email">@OperatorLabels.PrincipalAdministration.AddAddress</button><p class="hint">@OperatorLabels.PrincipalAdministration.SendToHint</p></fieldset>
                    <fieldset class="field"><legend>@OperatorLabels.PrincipalAdministration.Cc</legend><div class="stack" data-rs-items="RsCc">@foreach (var address in sending.Cc) { <input name="RsCc" type="email" value="@address" aria-label="@OperatorLabels.PrincipalAdministration.Cc" autocomplete="off" /> }</div><button type="button" class="btn" data-rs-add="RsCc" data-rs-label="@OperatorLabels.PrincipalAdministration.Cc" data-rs-type="email">@OperatorLabels.PrincipalAdministration.AddAddress</button></fieldset>
                    <fieldset class="field"><legend>@OperatorLabels.PrincipalAdministration.NeverCc</legend><div class="stack" data-rs-items="RsNeverCc">@foreach (var address in sending.NeverCc) { <input name="RsNeverCc" type="email" value="@address" aria-label="@OperatorLabels.PrincipalAdministration.NeverCc" autocomplete="off" /> }</div><button type="button" class="btn" data-rs-add="RsNeverCc" data-rs-label="@OperatorLabels.PrincipalAdministration.NeverCc" data-rs-type="email">@OperatorLabels.PrincipalAdministration.AddAddress</button></fieldset>
                    <div class="field stack"><label class="choice"><input type="checkbox" name="RsSendToOnly" value="true" checked="@sending.SendToOnly" /> <span>@OperatorLabels.PrincipalAdministration.SendToOnly</span></label><label class="choice"><input type="checkbox" name="RsReplyAll" value="true" checked="@sending.ReplyAll" /> <span>@OperatorLabels.PrincipalAdministration.ReplyAll</span></label><label class="choice"><input type="checkbox" name="RsGarageFigures" value="true" checked="@sending.GarageFigures" /> <span>@OperatorLabels.PrincipalAdministration.GarageFigures</span></label></div>
                    <fieldset class="field"><legend>@OperatorLabels.PrincipalAdministration.Attach</legend><div class="stack"><label class="choice"><input type="checkbox" name="RsFeeNoteSeparate" value="true" checked="@sending.Attach.FeeNoteSeparate" /> <span>@OperatorLabels.PrincipalAdministration.FeeNoteSeparate</span></label><label class="choice"><input type="checkbox" name="RsEstimate" value="true" checked="@sending.Attach.Estimate" /> <span>@OperatorLabels.PrincipalAdministration.AttachEstimate</span></label><label class="choice"><input type="checkbox" name="RsAudatex" value="true" checked="@sending.Attach.Audatex" /> <span>@OperatorLabels.PrincipalAdministration.AttachAudatex</span></label><label class="choice"><input type="checkbox" name="RsReportImages" value="true" checked="@sending.Attach.ReportImages" /> <span>@OperatorLabels.PrincipalAdministration.ReportImages</span></label><label class="choice"><input type="checkbox" name="RsVehicleImagesDocument" value="true" checked="@sending.Attach.VehicleImagesDocument" /> <span>@OperatorLabels.PrincipalAdministration.VehicleImagesDocument</span></label><label class="choice"><input type="checkbox" name="RsFigureBreakdown" value="true" checked="@sending.Attach.FigureBreakdown" /> <span>@OperatorLabels.PrincipalAdministration.FigureBreakdown</span></label></div></fieldset>
                    <div class="field"><label for="rs-hold">@OperatorLabels.PrincipalAdministration.Hold</label><input id="rs-hold" name="RsHold" value="@sending.Hold" autocomplete="off" /><p class="hint">@OperatorLabels.PrincipalAdministration.HoldHint</p></div>
                    <fieldset class="field"><legend>@OperatorLabels.PrincipalAdministration.Reminders</legend><div class="stack" data-rs-items="RsReminders">@foreach (var reminder in sending.Reminders) { <input name="RsReminders" value="@reminder" aria-label="@OperatorLabels.PrincipalAdministration.Reminders" autocomplete="off" /> }</div><button type="button" class="btn" data-rs-add="RsReminders" data-rs-label="@OperatorLabels.PrincipalAdministration.Reminders" data-rs-type="text">@OperatorLabels.PrincipalAdministration.AddReminder</button></fieldset>
                    <fieldset class="field"><legend>@OperatorLabels.PrincipalAdministration.AttachmentName</legend><div class="form-grid form-grid--2"><div class="field"><label for="rs-name-first">@OperatorLabels.PrincipalAdministration.AttachmentNameFirst</label><input id="rs-name-first" name="RsNameFirst" value="@(sending.AttachmentName?.First)" autocomplete="off" /></div><div class="field"><label for="rs-name-resend">@OperatorLabels.PrincipalAdministration.AttachmentNameResend</label><input id="rs-name-resend" name="RsNameResend" value="@(sending.AttachmentName?.Resend)" autocomplete="off" /></div></div><p class="hint">@OperatorLabels.PrincipalAdministration.AttachmentNameHint</p></fieldset>
                </div>
                <section class="contact-section stack" aria-labelledby="principal-sending-rules-title">
                    <h3 id="principal-sending-rules-title">@OperatorLabels.PrincipalAdministration.Rules</h3>
                    <div class="stack" data-rs-rules>
                    @for (var r = 0; r < ruleRows.Length; r++)
                    {
                        var rule = ruleRows[r];
                        var slots = Math.Max(3, rule.If.Count);
                        <fieldset class="contact-section stack" data-rs-rule>
                            <legend>@OperatorLabels.PrincipalAdministration.Rule</legend>
                            <input type="hidden" name="RuleIndex" value="@r" />
                            <div class="field"><label for="Rule@(r)Match">@OperatorLabels.PrincipalAdministration.RuleMatch</label><select id="Rule@(r)Match" name="Rule@(r)Match"><option value="@ReportSendingRuleMatch.All" selected="@(rule.Match == ReportSendingRuleMatch.All)">@OperatorLabels.PrincipalAdministration.RuleMatchAll</option><option value="@ReportSendingRuleMatch.Any" selected="@(rule.Match == ReportSendingRuleMatch.Any)">@OperatorLabels.PrincipalAdministration.RuleMatchAny</option></select></div>
                            @for (var s = 0; s < slots; s++)
                            {
                                var condition = s < rule.If.Count ? rule.If[s] : null;
                                var values = condition?.Values ?? [];
                                var isText = condition is not null && condition.Kind is ReportSendingConditionKind.ImagesFrom or ReportSendingConditionKind.Mentions or ReportSendingConditionKind.BodyshopMentions or ReportSendingConditionKind.SenderNot;
                                <div class="form-grid form-grid--2" data-rs-condition>
                                    <div class="field"><label for="Rule@(r)Cond@(s)Kind">@OperatorLabels.PrincipalAdministration.Condition</label><select id="Rule@(r)Cond@(s)Kind" name="Rule@(r)Cond@(s)Kind" data-rs-kind><option value="">@OperatorLabels.PrincipalAdministration.NoCondition</option>@foreach (var kind in Enum.GetValues<ReportSendingConditionKind>()) { <option value="@kind" selected="@(condition?.Kind == kind)">@OperatorLabels.PrincipalAdministration.ConditionKind(kind)</option> }</select></div>
                                    <div class="field" data-rs-value="ClaimSource" hidden="@(condition is not null && condition.Kind != ReportSendingConditionKind.ClaimSource)"><label for="Rule@(r)Cond@(s)ClaimSource">@OperatorLabels.PrincipalAdministration.ConditionKind(ReportSendingConditionKind.ClaimSource)</label><select id="Rule@(r)Cond@(s)ClaimSource" name="Rule@(r)Cond@(s)ClaimSource" multiple size="3">@foreach (var option in ContactOptions(Model.ClaimSourceChoices, condition?.Kind == ReportSendingConditionKind.ClaimSource ? values : [])) { <option value="@option.Id" selected="@(condition?.Kind == ReportSendingConditionKind.ClaimSource && values.Contains(option.Id, StringComparer.OrdinalIgnoreCase))">@option.Name</option> }</select></div>
                                    <div class="field" data-rs-value="Repairer" hidden="@(condition is not null && condition.Kind != ReportSendingConditionKind.Repairer)"><label for="Rule@(r)Cond@(s)Repairer">@OperatorLabels.PrincipalAdministration.ConditionKind(ReportSendingConditionKind.Repairer)</label><select id="Rule@(r)Cond@(s)Repairer" name="Rule@(r)Cond@(s)Repairer" multiple size="3">@foreach (var option in ContactOptions(Model.RepairerChoices, condition?.Kind == ReportSendingConditionKind.Repairer ? values : [])) { <option value="@option.Id" selected="@(condition?.Kind == ReportSendingConditionKind.Repairer && values.Contains(option.Id, StringComparer.OrdinalIgnoreCase))">@option.Name</option> }</select></div>
                                    <div class="field" data-rs-value="Outcome" hidden="@(condition is not null && condition.Kind != ReportSendingConditionKind.Outcome)"><label for="Rule@(r)Cond@(s)Outcome">@OperatorLabels.PrincipalAdministration.ConditionKind(ReportSendingConditionKind.Outcome)</label><select id="Rule@(r)Cond@(s)Outcome" name="Rule@(r)Cond@(s)Outcome" multiple size="4">@foreach (var code in outcomeCodes) { <option value="@code" selected="@(condition?.Kind == ReportSendingConditionKind.Outcome && values.Contains(code, StringComparer.Ordinal))">@OperatorLabels.Humanise(code)</option> }</select></div>
                                    <div class="field" data-rs-value="Text" hidden="@(condition is not null && !isText)"><label for="Rule@(r)Cond@(s)Text">@OperatorLabels.PrincipalAdministration.Condition</label><input id="Rule@(r)Cond@(s)Text" name="Rule@(r)Cond@(s)Text" value="@(isText ? string.Join(", ", values) : null)" autocomplete="off" /><p class="hint">@OperatorLabels.PrincipalAdministration.ConditionValueHint</p></div>
                                </div>
                            }
                            <div class="form-grid form-grid--2">
                                <div class="field"><label for="Rule@(r)CcAdd">@OperatorLabels.PrincipalAdministration.ActionCcAdd</label><input id="Rule@(r)CcAdd" name="Rule@(r)CcAdd" value="@string.Join(", ", rule.Then.CcAdd)" autocomplete="off" /></div>
                                <div class="field"><label for="Rule@(r)CcRemove">@OperatorLabels.PrincipalAdministration.ActionCcRemove</label><input id="Rule@(r)CcRemove" name="Rule@(r)CcRemove" value="@string.Join(", ", rule.Then.CcRemove)" autocomplete="off" /></div>
                                <div class="field"><label for="Rule@(r)Remind">@OperatorLabels.PrincipalAdministration.ActionRemind</label><input id="Rule@(r)Remind" name="Rule@(r)Remind" value="@rule.Then.Remind" autocomplete="off" /></div>
                                <div class="field"><label for="Rule@(r)Hold">@OperatorLabels.PrincipalAdministration.ActionHold</label><input id="Rule@(r)Hold" name="Rule@(r)Hold" value="@rule.Then.Hold" autocomplete="off" /></div>
                                <div class="field field-wide"><label for="Rule@(r)Stop">@OperatorLabels.PrincipalAdministration.ActionStop</label><input id="Rule@(r)Stop" name="Rule@(r)Stop" value="@rule.Then.Stop" autocomplete="off" /><p class="hint">@OperatorLabels.PrincipalAdministration.ActionStopHint</p></div>
                            </div>
                            <div class="button-row"><button type="button" class="btn btn--small" data-remove-rs-rule>@OperatorLabels.PrincipalAdministration.RemoveRule</button></div>
                        </fieldset>
                    }
                    </div>
                    <div class="button-row"><button type="button" class="btn" data-add-rs-rule>@OperatorLabels.PrincipalAdministration.AddRule</button></div>
                </section>
                <div class="button-row"><button type="submit" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Saving">@OperatorLabels.PrincipalAdministration.SaveReportSending</button></div></fieldset></form></section>
            @* The Principal's salvage matrix (29 September 2026): each category's
               Engineer's Value bands and the percentage paid. A blank row is
               ignored, so each table keeps one spare row to type into. *@
            <section class="panel" aria-labelledby="principal-salvage-title"><div class="panel-head"><h2 id="principal-salvage-title">@OperatorLabels.PrincipalAdministration.SalvageMatrix</h2></div><form method="post" asp-page-handler="UpdateSalvageMatrix" asp-route-id="@Model.ContactId" class="panel-body stack" data-salvage-matrix-editor><input type="hidden" name="ExpectedVersion" value="@Model.ExpectedVersion" /><input type="hidden" name="PrincipalExpectedVersion" value="@Model.PrincipalExpectedVersion" /><input asp-for="SalvageMatrixOperationKey" type="hidden" /><fieldset class="stack">
                @foreach (var category in Pegasus.Core.Assessment.SalvageMatrix.Categories)
                {
                    var categoryLabel = OperatorLabels.PrincipalAdministration.SalvageCategory(category);
                    var rows = Model.SalvageRows.Where(row => row.Category == category)
                        .Append(new Pegasus.Core.Assessment.SalvageMatrixEntry(category, null, null, null));
                    <section class="contact-section stack" aria-labelledby="salvage-category-@category-title">
                        <h3 id="salvage-category-@category-title">@categoryLabel</h3>
                        <div class="table-wrap no-border"><table>
                            <caption class="sr-only">@categoryLabel</caption>
                            <thead><tr><th scope="col">@OperatorLabels.PrincipalAdministration.SalvageFrom</th><th scope="col">@OperatorLabels.PrincipalAdministration.SalvageTo</th><th scope="col">@OperatorLabels.PrincipalAdministration.SalvagePercentage</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
                            <tbody data-salvage-bands="@category">
                            @foreach (var row in rows)
                            {
                                <tr><td><input type="hidden" name="SalvageBandCategory" value="@category" /><input name="SalvageBandFrom" type="number" inputmode="decimal" min="0" step="0.01" value="@row.From" aria-label="@categoryLabel @OperatorLabels.PrincipalAdministration.SalvageFrom" /></td><td><input name="SalvageBandTo" type="number" inputmode="decimal" min="0" step="0.01" value="@row.To" aria-label="@categoryLabel @OperatorLabels.PrincipalAdministration.SalvageTo" /></td><td><input name="SalvageBandPercentage" type="number" inputmode="decimal" min="0" max="100" step="0.01" value="@row.Percentage" aria-label="@categoryLabel @OperatorLabels.PrincipalAdministration.SalvagePercentage" /></td><td><button type="button" class="btn btn--small" data-remove-salvage-band>@OperatorLabels.PrincipalAdministration.RemoveSalvageBand</button></td></tr>
                            }
                            </tbody>
                        </table></div>
                        <div class="button-row"><button type="button" class="btn" data-add-salvage-band="@category">@OperatorLabels.PrincipalAdministration.AddSalvageBand</button></div>
                    </section>
                }
                <div class="button-row"><button type="submit" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Saving">@OperatorLabels.PrincipalAdministration.SaveSalvageMatrix</button></div></fieldset></form></section>
            <section class="panel" aria-labelledby="principal-location-title"><div class="panel-head"><h2 id="principal-location-title">Default inspection location</h2></div><form method="post" asp-page-handler="UpdateLocation" asp-route-id="@Model.ContactId" class="panel-body stack"><input type="hidden" name="ExpectedVersion" value="@Model.ExpectedVersion" /><input type="hidden" name="PrincipalExpectedVersion" value="@Model.PrincipalExpectedVersion" /><input asp-for="LocationOperationKey" type="hidden" /><fieldset class="stack"><label class="choice"><input asp-for="LocationIsImageBasedAssessment" type="checkbox" /> <span>Default to Image Based Assessment</span></label><div class="field" data-location-physical><label asp-for="LocationLabel">Location label (optional)</label><input asp-for="LocationLabel" autocomplete="off" /></div><div class="field" data-location-physical><label asp-for="LocationAddress">Address</label><input asp-for="LocationAddress" autocomplete="off" /><span asp-validation-for="LocationAddress"></span></div><div class="field" data-location-physical><label asp-for="LocationPostcode">Postcode (optional)</label><input asp-for="LocationPostcode" autocomplete="off" /></div><div class="button-row"><button type="submit" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Saving">Save default location</button></div></fieldset></form></section>
            <section class="panel" aria-labelledby="principal-api-title"><div class="panel-head"><h2 id="principal-api-title">@OperatorLabels.PrincipalAdministration.PrincipalApi</h2></div><div class="panel-body stack"><dl class="definition-list"><div class="definition"><dt>Submission endpoint</dt><dd><code>@Pegasus.Web.PrincipalApi.PrincipalApi.SubmissionsPath</code></dd></div><div class="definition"><dt>@OperatorLabels.PrincipalAdministration.State</dt><dd>@(Model.Credential?.State.ToString() ?? "Not issued")</dd></div></dl>@if (Model.IssuedSecret is not null) { <div class="field"><label for="issued-api-key">API key (shown once)</label><input id="issued-api-key" value="@Model.IssuedSecret" readonly autocomplete="off" /></div> }<form method="post" asp-route-id="@Model.ContactId" class="stack"><input type="hidden" name="ExpectedVersion" value="@Model.ExpectedVersion" /><input asp-for="CredentialVersion" type="hidden" /><input asp-for="CredentialOperationKey" type="hidden" /><fieldset class="stack">@if (Model.Credential is not null && Model.Credential.State != PrincipalCredentialState.Revoked) { <p>Resetting or revoking the API key stops the current key from working.</p> }<div class="button-row"><button type="submit" asp-page-handler="IssueCredential" class="btn btn--primary" data-busy-label="@(Model.Credential is null ? OperatorLabels.Busy.Generating : OperatorLabels.Busy.Resetting)">@(Model.Credential is null ? "Generate API key" : "Reset API key")</button>@if (Model.Credential?.State == PrincipalCredentialState.Active) { <button type="submit" asp-page-handler="PauseCredential" class="btn" data-busy-label="@OperatorLabels.Busy.Pausing">Pause</button> }@if (Model.Credential?.State == PrincipalCredentialState.Paused) { <button type="submit" asp-page-handler="ResumeCredential" class="btn" data-busy-label="@OperatorLabels.Busy.Resuming">Resume</button> }@if (Model.Credential is not null && Model.Credential.State != PrincipalCredentialState.Revoked) { <button type="submit" asp-page-handler="RevokeCredential" class="btn btn--danger" data-busy-label="@OperatorLabels.Busy.Revoking">Revoke</button> }</div></fieldset></form></div></section>
            <div class="button-row"><button class="btn btn--danger" type="button" data-dialog-open="replace-principal">@OperatorLabels.PrincipalAdministration.ReplaceCode</button></div>
            <dialog id="replace-principal" aria-labelledby="replace-principal-title"><form method="post" asp-page-handler="Replace" asp-route-id="@Model.ContactId" class="stack"><h2 id="replace-principal-title">Replace @Model.Principal.Code</h2><p>@Model.Principal.AllocatedCaseCount allocated cases remain with their existing references.</p><input type="hidden" name="ExpectedVersion" value="@Model.ExpectedVersion" /><input asp-for="ReplacementExpectedVersion" type="hidden" /><input asp-for="ReplacementOperationKey" type="hidden" /><fieldset class="stack"><div class="field"><label class="req" asp-for="SuccessorCode">New principal code</label><input asp-for="SuccessorCode" autocomplete="off" /><span asp-validation-for="SuccessorCode"></span></div><div class="button-row"><button class="btn" type="button" data-dialog-close="replace-principal">Cancel</button><button type="submit" class="btn btn--danger" data-busy-label="@OperatorLabels.Busy.Replacing">@OperatorLabels.PrincipalAdministration.ReplaceCode</button></div></fieldset></form></dialog>
        }
        else { <section class="panel"><div class="empty"><p>This principal is inactive. Change the settings on its successor.</p></div></section> }
    }
</div></div>
@section Scripts {
    <script src="~/js/contacts-edit.js" asp-append-version="true"></script>
}
