@page "{id:guid}"
@model Pegasus.Web.Pages.Administration.Contacts.EditModel
@using Pegasus.Core.Cases
@using Pegasus.Core.Reports
@{
    ViewData["Title"] = Model.Contact!.Name;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "contacts";
}
<partial name="Shared/_PageHeader" />
<div class="admin-layout"><partial name="Shared/_AdminNav" /><div class="stack">
    @if (TempData["AdministrationStatus"] is string status) { <div class="notice notice--success" role="status">@status</div> }
    <section class="panel" aria-labelledby="contact-title">
        <div class="panel-head"><div><h2 id="contact-title">@Model.Contact!.Name</h2><p class="panel-title-meta">One organisation may have several contact types.</p></div><partial name="Shared/_StatusChip" model="@(Model.Contact.Active ? "Active" : "Disabled")" /></div>
        <form method="post" asp-page-handler="Save" asp-route-id="@Model.ContactId" class="panel-body stack contact-editor" data-contact-editor>
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <input asp-for="ContactId" type="hidden" /><input asp-for="ExpectedVersion" type="hidden" /><input asp-for="GuidanceTemplateVersion" type="hidden" /><input asp-for="OperationKey" type="hidden" /><input asp-for="LeaseToken" type="hidden" />
            <fieldset class="stack" disabled="@(!Model.IsEditing)">
            <div class="form-grid form-grid--2">
                <div class="field field-wide"><label class="req" asp-for="Name">Organisation name</label><input asp-for="Name" autocomplete="organization" /><span asp-validation-for="Name"></span></div>
                <div class="field"><label asp-for="ContactPerson">Contact person</label><input asp-for="ContactPerson" autocomplete="name" /></div>
                <div class="field"><label asp-for="Telephone">Phone</label><input asp-for="Telephone" type="tel" inputmode="tel" pattern="^\+?[0-9 ]{6,20}$" autocomplete="tel" /><span asp-validation-for="Telephone"></span></div>
                <div class="field field-wide"><label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="email" /></div>
                <div class="field"><label asp-for="Address">Address</label><textarea asp-for="Address" rows="3" autocomplete="street-address"></textarea></div>
                <div class="field"><label asp-for="Postcode">Postcode</label><input asp-for="Postcode" autocomplete="postal-code" /></div>
            </div>
            <section class="contact-section" aria-labelledby="contact-types-title">
                <h3 id="contact-types-title">Contact types</h3>
                <div class="contact-kind-grid">@foreach (var role in Enum.GetValues<ContactRole>()) { <label class="contact-kind"><input type="checkbox" name="Roles" value="@role" @(Model.Roles.Contains(role) ? "checked" : null) data-contact-role="@role" /> <span>@EditModel.RoleLabel(role)</span></label> }</div>
            </section>
            <section class="contact-section" data-principal-fields hidden="@(!Model.Roles.Contains(ContactRole.Principal))" aria-labelledby="principal-details-title">
                <h3 id="principal-details-title">Principal details</h3>
                <div class="form-grid form-grid--2"><div class="field"><label asp-for="PrincipalCode">Principal code</label><input asp-for="PrincipalCode" autocomplete="off" data-principal-field-input disabled="@(!Model.Roles.Contains(ContactRole.Principal))" /><span asp-validation-for="PrincipalCode"></span></div><div class="field"><label asp-for="PrincipalInspectionMode">Inspection mode</label><select asp-for="PrincipalInspectionMode" data-principal-field-input disabled="@(!Model.Roles.Contains(ContactRole.Principal))"><option value="@CaseInspectionMode.PhysicalAddress">Physical address</option><option value="@CaseInspectionMode.ImageBasedAssessment">Image Based Assessment</option></select></div></div>
            </section>
            <section class="contact-section" data-case-guidance hidden="@(!(Model.Roles.Contains(ContactRole.Principal) || Model.Roles.Contains(ContactRole.ClaimSource)))" aria-labelledby="case-guidance-title">
                <h3 id="case-guidance-title">Case guidance</h3>
                <div class="field"><label asp-for="GuidanceTemplate">Guidance for new Cases</label><textarea asp-for="GuidanceTemplate" rows="4"></textarea><p class="hint">Applied once to new or reassigned Cases for this contact.</p><span asp-validation-for="GuidanceTemplate"></span></div>
            </section>
            <section class="contact-section" aria-labelledby="linked-principals-title">
                <h3 id="linked-principals-title">Linked principals</h3><p class="hint">Choose the role this contact has for each principal. Principal contacts cannot link to themselves.</p>
                @foreach (var role in Enum.GetValues<ContactRole>().Where(role => role != ContactRole.Principal)) { var selected = Model.Roles.Contains(role); <div class="stack" data-principal-associations="@role" hidden="@(!selected)"><strong>@EditModel.RoleLabel(role)</strong>@foreach (var principal in Model.PrincipalChoices) { var key = $"{role}:{principal.Principal.Id:D}"; <label class="choice"><input type="checkbox" name="PrincipalAssociationKeys" value="@key" @(Model.PrincipalAssociationKeys.Contains(key) ? "checked" : null) data-principal-association-input disabled="@(!selected)" /> <span>@principal.Name (@principal.Principal.Code)</span></label> }</div> }
            </section>
            <label class="choice"><input asp-for="Active" /> <span>Active</span></label>
            </fieldset>
            <div class="button-row">@if (Model.IsEditing) { <button type="submit" class="btn btn--primary">Save contact</button><button type="submit" asp-page-handler="Cancel" asp-route-id="@Model.ContactId" formnovalidate class="btn">Cancel</button> } else if (Model.CanTakeOverEdit) { @* Offered only to the operator whose own other window still holds this contact; taking over rotates the token so that window can no longer save. *@ <button type="submit" asp-page-handler="Edit" asp-route-id="@Model.ContactId" asp-route-takeOver="true" class="btn btn--primary">Take over</button> } else { <button type="submit" asp-page-handler="Edit" asp-route-id="@Model.ContactId" class="btn btn--primary">Edit contact</button> }</div>
        </form>
        @if (Model.IsEditing)
        {
            <form method="post" asp-page-handler="HeartbeatEdit" asp-route-id="@Model.ContactId" data-edit-heartbeat data-edit-heartbeat-status="contact-edit-heartbeat-status" hidden>
                <input type="hidden" name="ContactId" value="@Model.ContactId" /><input type="hidden" name="LeaseToken" value="@Model.LeaseToken" />
            </form>
            <p id="contact-edit-heartbeat-status" class="notice notice--error" role="alert" hidden></p>
            @* Beaconed as the page unloads so an operator who navigates away is
               not refused by their own lease when they come back. *@
            <form method="post" asp-page-handler="ReleaseScopeBeacon" asp-route-id="@Model.ContactId" data-edit-scope-release hidden>
                <input type="hidden" name="ContactId" value="@Model.ContactId" /><input type="hidden" name="LeaseToken" value="@Model.LeaseToken" />
            </form>
        }
    </section>

    @if (Model.Principal is not null)
    {
        <section class="panel" aria-labelledby="principal-settings-title">
            <div class="panel-head"><div><h2 id="principal-settings-title">Principal settings</h2><p class="panel-title-meta mono">@Model.Principal.Code</p></div><partial name="Shared/_StatusChip" model="@(Model.Principal.IsActive ? "Active" : "Disabled")" /></div>
            <div class="panel-body stack"><div asp-validation-summary="All" class="validation-summary" role="alert"></div>@if (Model.AcceptedIdentities.Count > 0) { <dl class="definition-list"><div class="definition"><dt>Accepted e-mail identities</dt><dd>@string.Join(", ", Model.AcceptedIdentities)</dd></div></dl> }</div>
        </section>
        @if (Model.Principal.IsActive)
        {
            <section class="panel" aria-labelledby="principal-report-title"><div class="panel-head"><h2 id="principal-report-title">Report generation</h2></div><form method="post" asp-page-handler="UpdateReportSettings" asp-route-id="@Model.ContactId" class="panel-body stack"><input asp-for="ExpectedVersion" type="hidden" /><input asp-for="LeaseToken" type="hidden" /><input asp-for="PrincipalExpectedVersion" type="hidden" /><input asp-for="ReportSettingsOperationKey" type="hidden" /><fieldset class="stack" disabled="@(!Model.IsEditing)"><div class="field"><label for="report-generation-route">Report generation</label><select id="report-generation-route" data-report-generation-route><option value="Pegasus" selected="@(!PrincipalReportGenerationPolicyRules.IsEva(Model.ReportGenerationPolicy))">Pegasus</option><option value="Eva" selected="@(PrincipalReportGenerationPolicyRules.IsEva(Model.ReportGenerationPolicy))">EVA</option></select></div><div class="field" data-report-generation-eva-delivery hidden="@(!PrincipalReportGenerationPolicyRules.IsEva(Model.ReportGenerationPolicy))"><label for="report-generation-eva-mode">EVA delivery</label><select id="report-generation-eva-mode" data-report-generation-eva-mode><option value="@PrincipalReportGenerationPolicy.EvaZip" selected="@(Model.ReportGenerationPolicy == PrincipalReportGenerationPolicy.EvaZip)">ZIP export</option><option value="@PrincipalReportGenerationPolicy.EvaManualApi" selected="@(Model.ReportGenerationPolicy == PrincipalReportGenerationPolicy.EvaManualApi)">Manual API submission</option><option value="@PrincipalReportGenerationPolicy.EvaAutomaticApiOnReview" selected="@(Model.ReportGenerationPolicy == PrincipalReportGenerationPolicy.EvaAutomaticApiOnReview)">Automatic API submission at Review</option></select></div><input type="hidden" asp-for="ReportGenerationPolicy" data-report-generation-value /><span asp-validation-for="ReportGenerationPolicy"></span><fieldset class="field"><legend>Report recipients</legend><label class="choice"><input asp-for="IncludeOriginalInstructionSender" /> <span>Original instruction sender</span></label><div id="additional-report-recipients" class="stack">@foreach (var address in Model.AdditionalReportRecipients) { <input name="AdditionalReportRecipients" type="email" value="@address" aria-label="Additional report recipient" autocomplete="email" /> }</div><button type="button" class="btn" data-add-report-recipient>Add recipient</button></fieldset><div class="button-row"><button type="submit" class="btn btn--primary">Save report settings</button></div></fieldset></form></section>
            <section class="panel" aria-labelledby="principal-location-title"><div class="panel-head"><h2 id="principal-location-title">Default inspection location</h2></div><form method="post" asp-page-handler="UpdateLocation" asp-route-id="@Model.ContactId" class="panel-body stack"><input asp-for="ExpectedVersion" type="hidden" /><input asp-for="LeaseToken" type="hidden" /><input asp-for="PrincipalExpectedVersion" type="hidden" /><input asp-for="LocationOperationKey" type="hidden" /><fieldset class="stack" disabled="@(!Model.IsEditing)"><label class="choice"><input asp-for="LocationIsImageBasedAssessment" type="checkbox" /> <span>Default to Image Based Assessment</span></label><div class="field" data-location-physical><label asp-for="LocationLabel">Location label (optional)</label><input asp-for="LocationLabel" autocomplete="off" /></div><div class="field" data-location-physical><label asp-for="LocationAddress">Address</label><input asp-for="LocationAddress" autocomplete="off" /><span asp-validation-for="LocationAddress"></span></div><div class="field" data-location-physical><label asp-for="LocationPostcode">Postcode (optional)</label><input asp-for="LocationPostcode" autocomplete="off" /></div><div class="button-row"><button type="submit" class="btn btn--primary">Save default location</button></div></fieldset></form></section>
            <section class="panel" aria-labelledby="principal-provider-api-title"><div class="panel-head"><h2 id="principal-provider-api-title">@OperatorLabels.PrincipalAdministration.ProviderApi</h2></div><div class="panel-body stack"><dl class="definition-list"><div class="definition"><dt>Submission endpoint</dt><dd><code>@Pegasus.Web.ProviderApi.ProviderApi.SubmissionsPath</code></dd></div><div class="definition"><dt>@OperatorLabels.PrincipalAdministration.State</dt><dd>@(Model.Credential?.State.ToString() ?? "Not issued")</dd></div></dl>@if (Model.IssuedSecret is not null) { <div class="field"><label for="issued-api-key">API key (shown once)</label><input id="issued-api-key" value="@Model.IssuedSecret" readonly autocomplete="off" /></div> }<form method="post" asp-route-id="@Model.ContactId" class="stack"><input asp-for="ExpectedVersion" type="hidden" /><input asp-for="LeaseToken" type="hidden" /><input asp-for="CredentialVersion" type="hidden" /><input asp-for="CredentialOperationKey" type="hidden" /><fieldset class="stack" disabled="@(!Model.IsEditing)"><div class="field"><label class="req" asp-for="CredentialReason">Reason</label><input asp-for="CredentialReason" autocomplete="off" /><span asp-validation-for="CredentialReason"></span></div>@if (Model.Credential is not null && Model.Credential.State != PrincipalCredentialState.Revoked) { <p>Resetting or revoking the API key stops the current key from working.</p> }<div class="button-row"><button type="submit" asp-page-handler="IssueCredential" class="btn btn--primary">@(Model.Credential is null ? "Generate API key" : "Reset API key")</button>@if (Model.Credential?.State == PrincipalCredentialState.Active) { <button type="submit" asp-page-handler="PauseCredential" class="btn">Pause</button> }@if (Model.Credential?.State == PrincipalCredentialState.Paused) { <button type="submit" asp-page-handler="ResumeCredential" class="btn">Resume</button> }@if (Model.Credential is not null && Model.Credential.State != PrincipalCredentialState.Revoked) { <button type="submit" asp-page-handler="RevokeCredential" class="btn btn--danger">Revoke</button> }</div></fieldset></form></div></section>
            <div class="button-row"><button class="btn btn--danger" type="button" data-dialog-open="replace-principal" disabled="@(!Model.IsEditing)">@OperatorLabels.PrincipalAdministration.ReplaceCode</button></div>
            <dialog id="replace-principal" aria-labelledby="replace-principal-title"><form method="post" asp-page-handler="Replace" asp-route-id="@Model.ContactId" class="stack"><h2 id="replace-principal-title">Replace @Model.Principal.Code</h2><p>@Model.Principal.AllocatedCaseCount allocated cases remain with their existing references.</p><input asp-for="ExpectedVersion" type="hidden" /><input asp-for="LeaseToken" type="hidden" /><input asp-for="ReplacementExpectedVersion" type="hidden" /><input asp-for="ReplacementOperationKey" type="hidden" /><fieldset class="stack" disabled="@(!Model.IsEditing)"><div class="field"><label class="req" asp-for="SuccessorCode">New principal code</label><input asp-for="SuccessorCode" autocomplete="off" /><span asp-validation-for="SuccessorCode"></span></div><div class="field"><label class="req" asp-for="ReplacementReason">Reason</label><textarea asp-for="ReplacementReason" rows="3"></textarea><span asp-validation-for="ReplacementReason"></span></div><div class="button-row"><button class="btn" type="button" data-dialog-close="replace-principal">Cancel</button><button type="submit" class="btn btn--danger">@OperatorLabels.PrincipalAdministration.ReplaceCode</button></div></fieldset></form></dialog>
        }
        else { <section class="panel"><div class="empty"><p>This principal is inactive. Change the settings on its successor.</p></div></section> }
    }
</div></div>
@section Scripts {
    <script src="~/js/contacts-edit.js" asp-append-version="true"></script>
}
