@page
@model Pegasus.Web.Pages.Administration.Contacts.IndexModel
@using Pegasus.Core.Cases
@{
    ViewData["Title"] = "Contacts";
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "contacts";
}
<partial name="Shared/_PageHeader" />
<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        @if (TempData["AdministrationStatus"] is string status)
        {
            <div class="notice notice--success" role="status">@status</div>
        }
        <section class="panel" aria-labelledby="contacts-title">
            <div class="panel-head">
                <div>
                    <h2 id="contacts-title">Contacts</h2>
                    <p class="panel-title-meta">Principals, claim sources, repairers, storage and third party engineers.</p>
                </div>
                <button class="btn btn--primary" type="button" data-dialog-open="contact-type-dialog">Add contact</button>
            </div>
            <form method="get" class="contact-toolbar" data-auto-submit>
                <div class="field"><label asp-for="Search">Name or contact</label><input asp-for="Search" type="search" autocomplete="off" autofocus="@(string.IsNullOrEmpty(Model.Search) ? null : "autofocus")" /></div>
                <div class="field"><label asp-for="Type">Type</label><select asp-for="Type"><option value="">All types</option>@foreach (var role in Enum.GetValues<ContactRole>()) { <option value="@role">@IndexModel.RoleLabel(role)</option> }</select></div>
                <div class="field"><label asp-for="Sort">Sort</label><select asp-for="Sort"><option value="@ContactSort.Name">Name</option><option value="@ContactSort.Type">Type</option><option value="@ContactSort.LastCase">Last case</option></select></div>
                <button class="btn" type="submit">Apply</button>
            </form>
            @if (Model.Contacts.Count == 0)
            {
                <div class="empty"><p>No contacts found.</p></div>
            }
            else
            {
                <div class="table-wrap no-border"><table><caption class="sr-only">Contact directory</caption><thead><tr><th>Name</th><th>Type</th><th>Contact person</th><th>Email</th><th>Phone</th><th>Last case</th><th>Status</th><th><span class="sr-only">Open</span></th></tr></thead><tbody>
                @foreach (var contact in Model.Contacts)
                {
                    <tr><td>@contact.Name</td><td>@string.Join(", ", contact.Roles.Select(IndexModel.RoleLabel))</td><td>@(contact.ContactPerson ?? "—")</td><td class="mono">@(contact.Email ?? "—")</td><td class="mono">@(contact.Telephone ?? "—")</td><td>@(contact.LastCaseReference ?? "—")</td><td><partial name="Shared/_StatusChip" model="@(contact.Active ? "Active" : "Disabled")" /></td><td class="right"><a class="btn btn--small" asp-page="Edit" asp-route-id="@contact.OrganizationId">Open</a></td></tr>
                }
                </tbody></table></div>
            }
        </section>
    </div>
</div>

<div class="dialog-backdrop" data-dialog="contact-type-dialog" hidden>
    <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="contact-type-title">
        <div class="dialog-head"><h2 id="contact-type-title" tabindex="-1" data-dialog-initial-focus>Add contact</h2><button class="dialog-close" type="button" data-dialog-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button></div>
        <div class="dialog-body"><div class="contact-kind-grid">@foreach (var role in Enum.GetValues<ContactRole>()) { <a class="contact-kind" asp-route-createType="@role" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-sort="@Model.Sort"><strong>@IndexModel.RoleLabel(role)</strong></a> }</div></div>
        <div class="dialog-foot"><button class="btn" type="button" data-dialog-close>Cancel</button></div>
    </section>
</div>

@if (Model.CreateDialogOpen)
{
    var role = Model.CreateType!.Value;
    var title = Model.EditingExisting ? $"Add {IndexModel.RoleLabel(role)}" : $"New {IndexModel.RoleLabel(role)}";
    <div class="dialog-backdrop" data-dialog="contact-create-dialog" data-dialog-open-on-load="true" data-dialog-cancel-form="@(Model.EditingExisting ? "contact-cancel-form" : null)" hidden>
    <section class="dialog dialog--wide dialog--contact" role="dialog" aria-modal="true" aria-labelledby="contact-create-title">
        <div class="dialog-head"><h2 id="contact-create-title" tabindex="-1" data-dialog-initial-focus>@title</h2>@if (Model.EditingExisting) { <button class="dialog-close" type="submit" form="contact-cancel-form" aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button> } else { <button class="dialog-close" type="button" data-dialog-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button> }</div>
        <form id="contact-create-form" method="post" asp-page-handler="Create">
            <input asp-for="Search" type="hidden" /><input asp-for="Type" type="hidden" /><input asp-for="Sort" type="hidden" />
            <input asp-for="CreateType" type="hidden" /><input asp-for="ContactId" type="hidden" /><input asp-for="ExistingContactId" type="hidden" />
            <input asp-for="ExpectedVersion" type="hidden" /><input asp-for="LeaseToken" type="hidden" /><input asp-for="OperationKey" type="hidden" />
            <div class="dialog-body stack">
                <partial name="Shared/_ErrorSummary" />
                @* Offered only to the operator whose own other window still holds
                   this contact; taking over rotates the token so that window can
                   no longer save. It submits the out-of-band form below, because
                   a form cannot nest inside this one. *@
                @if (Model.CanTakeOverEdit)
                {
                    <div class="button-row"><button class="btn btn--primary btn--small" type="submit" form="contact-take-over-form" formnovalidate>Take over</button></div>
                }
                @if (Model.EditingExisting)
                {
                    <p class="panel-title-meta">Adding <strong>@IndexModel.RoleLabel(role)</strong> to @Model.ExistingContact!.Name. Existing types, linked principals and settings are retained.</p>
                }
                else
                {
                    <p class="panel-title-meta">Enter the details for this @IndexModel.RoleLabel(role). You can add more types later.</p>
                }
                <div class="form-grid form-grid--2">
                    <div class="field field-wide"><label class="req" asp-for="Name">Organisation name</label><input asp-for="Name" autocomplete="organization" /><span asp-validation-for="Name"></span></div>
                    <div class="field"><label asp-for="ContactPerson">Contact person</label><input asp-for="ContactPerson" autocomplete="name" /><span asp-validation-for="ContactPerson"></span></div>
                    <div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
                    <div class="field"><label asp-for="Telephone">Telephone</label><input asp-for="Telephone" type="tel" inputmode="tel" pattern="^\+?[0-9 ]+$" autocomplete="tel" /><span asp-validation-for="Telephone"></span></div>
                    <div class="field field-tall"><label asp-for="Address">Address</label><textarea asp-for="Address" rows="2" autocomplete="street-address"></textarea><span asp-validation-for="Address"></span></div>
                    <div class="field"><label asp-for="Postcode">Postcode</label><input asp-for="Postcode" autocomplete="postal-code" /><span asp-validation-for="Postcode"></span></div>
                    @if (role == ContactRole.Principal)
                    {
                        <div class="field"><label class="req" asp-for="PrincipalCode">Principal code</label><input asp-for="PrincipalCode" autocomplete="off" /><span asp-validation-for="PrincipalCode"></span></div>
                        <div class="field"><label asp-for="PrincipalInspectionMode">Default inspection</label><select asp-for="PrincipalInspectionMode"><option value="@CaseInspectionMode.PhysicalAddress">Physical address</option><option value="@CaseInspectionMode.ImageBasedAssessment">Image based assessment</option></select></div>
                    }
                    @if (Model.CanAssociateSelectedType)
                    {
                        <div class="field"><label asp-for="AssociatedPrincipalIds">Linked principals</label><select asp-for="AssociatedPrincipalIds" multiple size="4">@foreach (var principal in Model.PrincipalChoices) { <option value="@principal.Principal.Id">@principal.Name · @principal.Principal.Code</option> }</select><small>Optional. Select every Principal this @(IndexModel.RoleLabel(role).ToLowerInvariant()) works with.</small></div>
                    }
                </div>
                @if (!Model.EditingExisting)
                {
                    <div class="button-row"><button class="btn btn--small" type="submit" formaction="?handler=FindMatches" formnovalidate>Check existing contacts</button></div>
                    @if (Model.PossibleMatches.Count > 0)
                    {
                        <section class="panel" aria-labelledby="possible-matches-title"><div class="panel-head"><h3 id="possible-matches-title">Possible existing contacts</h3></div><div class="panel-body stack">@foreach (var contact in Model.PossibleMatches) { var formId = "choose-contact-" + contact.OrganizationId.ToString("N"); <div class="button-row"><span>@contact.Name · @string.Join(", ", contact.Roles.Select(IndexModel.RoleLabel))</span><button class="btn btn--small" type="submit" form="@formId">Use this contact</button></div> }</div></section>
                    }
                }
            </div>
            <div class="dialog-foot"><button class="btn" type="submit" form="contact-cancel-form" formnovalidate>Cancel</button><button class="btn btn--primary" type="submit">Save @IndexModel.RoleLabel(role)</button></div>
        </form>
        @foreach (var contact in Model.PossibleMatches)
        {
            var formId = "choose-contact-" + contact.OrganizationId.ToString("N");
            <form id="@formId" method="post" asp-page-handler="ChooseExisting"><input asp-for="Search" type="hidden" /><input asp-for="Type" type="hidden" /><input asp-for="Sort" type="hidden" /><input asp-for="CreateType" type="hidden" /><input name="ExistingContactId" type="hidden" value="@contact.OrganizationId" /><input name="OperationKey" type="hidden" value="@IndexModel.NewOperationKey()" /></form>
        }
        <form id="contact-cancel-form" method="post" asp-page-handler="Cancel"><input asp-for="Search" type="hidden" /><input asp-for="Type" type="hidden" /><input asp-for="Sort" type="hidden" /><input asp-for="ExistingContactId" type="hidden" /><input asp-for="LeaseToken" type="hidden" /></form>
        @if (Model.CanTakeOverEdit)
        {
            <form id="contact-take-over-form" method="post" asp-page-handler="ChooseExisting"><input asp-for="Search" type="hidden" /><input asp-for="Type" type="hidden" /><input asp-for="Sort" type="hidden" /><input asp-for="CreateType" type="hidden" /><input asp-for="Name" type="hidden" /><input asp-for="ExistingContactId" type="hidden" /><input name="TakeOver" type="hidden" value="true" /><input name="OperationKey" type="hidden" value="@IndexModel.NewOperationKey()" /></form>
        }
        @if (Model.EditingExisting)
        {
            @* Beaconed as the page unloads so an operator who navigates away is
               not refused by their own lease when they come back. *@
            <form method="post" asp-page-handler="ReleaseScopeBeacon" data-edit-scope-release hidden><input asp-for="ExistingContactId" type="hidden" /><input asp-for="LeaseToken" type="hidden" /></form>
        }
    </section>
    </div>
}
