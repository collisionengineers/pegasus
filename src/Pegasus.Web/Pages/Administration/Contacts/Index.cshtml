@page
@model Pegasus.Web.Pages.Administration.Contacts.IndexModel
@using Pegasus.Core.Cases
@{
    ViewData["Title"] = "Contacts";
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "contacts";
}
<partial name="Shared/_PageHeader" />
<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        @if (TempData["AdministrationStatus"] is string status)
        {
            <div class="notice notice--success" role="status">@status</div>
        }
        <section class="panel" aria-labelledby="contacts-title">
            <div class="panel-head">
                <h2 id="contacts-title">Contacts</h2>
                <button class="btn btn--primary" type="button" data-dialog-open="contact-type-dialog">Add contact</button>
            </div>
            <form method="get" class="contact-toolbar" data-auto-submit>
                <div class="field"><label asp-for="Search">Name or contact</label><input asp-for="Search" type="search" autocomplete="off" autofocus="@(string.IsNullOrEmpty(Model.Search) ? null : "autofocus")" /></div>
                <div class="field"><label asp-for="Type">Type</label><select asp-for="Type"><option value="">All types</option>@foreach (var role in Enum.GetValues<ContactRole>()) { <option value="@role">@OperatorLabels.Contacts.Type(role)</option> }</select></div>
                <button class="btn" type="submit">Apply</button>
            </form>
            @if (Model.Contacts.Count == 0)
            {
                <div class="empty"><p>No contacts found.</p></div>
            }
        </section>
        @* One panel per type, in this order, each sorted by name; a type with no matching contact is absent (operator, 13 October 2026). *@
        @foreach (var role in Enum.GetValues<ContactRole>())
        {
            var rows = Model.Contacts.Where(contact => contact.Role == role).ToArray();
            if (rows.Length == 0) continue;
            var heading = OperatorLabels.Contacts.Plural(role);
            var isPrincipal = role == ContactRole.Principal;
            var hasPostcode = role is ContactRole.Repairer or ContactRole.Storage;
            <section class="panel" aria-labelledby="contacts-@role-title">
                <div class="panel-head"><h2 id="contacts-@role-title">@heading</h2></div>
                <div class="table-wrap no-border"><table><caption class="sr-only">@heading</caption><thead><tr>@if (isPrincipal) { <th>@OperatorLabels.PrincipalAdministration.Code</th> }<th>Name</th><th>Contact person</th><th>Email</th><th>Phone</th>@if (hasPostcode) { <th>Postcode</th> }@if (!isPrincipal) { <th>Linked principals</th> }<th>Last case</th><th>Status</th><th><span class="sr-only">Open</span></th></tr></thead><tbody>
                @foreach (var contact in rows)
                {
                    <tr>@if (isPrincipal) { <td class="mono">@(contact.PrincipalCode ?? "—")</td> }<td>@contact.Name</td><td>@(contact.ContactPerson ?? "—")</td><td class="mono">@(contact.Email ?? "—")</td><td class="mono">@(contact.Telephone ?? "—")</td>@if (hasPostcode) { <td>@(contact.Postcode ?? "—")</td> }@if (!isPrincipal) { var codes = Model.LinkedPrincipalCodes(contact); <td class="mono">@(codes.Length == 0 ? "—" : string.Join(", ", codes))</td> }<td>@(contact.LastCaseReference ?? "—")</td><td><partial name="Shared/_StatusChip" model="@(contact.Active ? "Active" : "Disabled")" /></td><td class="right"><a class="btn btn--small" asp-page="Edit" asp-route-id="@contact.OrganizationId">Open</a></td></tr>
                }
                </tbody></table></div>
            </section>
        }
    </div>
</div>

<div class="dialog-backdrop" data-dialog="contact-type-dialog" hidden>
    <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="contact-type-title">
        <div class="dialog-head"><h2 id="contact-type-title" tabindex="-1" data-dialog-initial-focus>Add contact</h2><button class="dialog-close" type="button" data-dialog-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button></div>
        <div class="dialog-body"><div class="contact-kind-grid">@foreach (var role in Enum.GetValues<ContactRole>()) { <a class="contact-kind" asp-route-createType="@role" asp-route-search="@Model.Search" asp-route-type="@Model.Type"><strong>@OperatorLabels.Contacts.Type(role)</strong></a> }</div></div>
        <div class="dialog-foot"><button class="btn" type="button" data-dialog-close>Cancel</button></div>
    </section>
</div>

@if (Model.CreateDialogOpen)
{
    var role = Model.CreateType!.Value;
    var title = $"New {OperatorLabels.Contacts.Type(role)}";
    <div class="dialog-backdrop" data-dialog="contact-create-dialog" data-dialog-open-on-load="true" hidden>
    <section class="dialog dialog--wide dialog--contact" role="dialog" aria-modal="true" aria-labelledby="contact-create-title">
        <div class="dialog-head"><h2 id="contact-create-title" tabindex="-1" data-dialog-initial-focus>@title</h2><a class="dialog-close" asp-page="Index" asp-route-search="@Model.Search" asp-route-type="@Model.Type" aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></a></div>
        <form id="contact-create-form" method="post" asp-page-handler="Create">
            <input asp-for="Search" type="hidden" /><input asp-for="Type" type="hidden" />
            <input asp-for="CreateType" type="hidden" /><input asp-for="ContactId" type="hidden" /><input asp-for="OperationKey" type="hidden" />
            <div class="dialog-body stack">
                <partial name="Shared/_ErrorSummary" />
                <div class="form-grid form-grid--2">
                    <div class="field field-wide"><label class="req" asp-for="Name">Organisation name</label><input asp-for="Name" autocomplete="organization" /><span asp-validation-for="Name"></span></div>
                    <div class="field"><label asp-for="ContactPerson">Contact person</label><input asp-for="ContactPerson" autocomplete="name" /><span asp-validation-for="ContactPerson"></span></div>
                    <div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
                    <div class="field"><label asp-for="Telephone">Phone</label><input asp-for="Telephone" type="tel" inputmode="tel" pattern="^\+?[0-9 ]+$" autocomplete="tel" /><span asp-validation-for="Telephone"></span></div>
                    <div class="field field-tall"><label asp-for="Address">Address</label><textarea asp-for="Address" rows="2" autocomplete="street-address"></textarea><span asp-validation-for="Address"></span></div>
                    <div class="field"><label asp-for="Postcode">Postcode</label><input asp-for="Postcode" autocomplete="postal-code" /><span asp-validation-for="Postcode"></span></div>
                    @if (role == ContactRole.Principal)
                    {
                        <div class="field"><label class="req" asp-for="PrincipalCode">@OperatorLabels.PrincipalAdministration.Code</label><input asp-for="PrincipalCode" autocomplete="off" /><span asp-validation-for="PrincipalCode"></span></div>
                        <div class="field"><label asp-for="PrincipalInspectionMode">Default inspection</label><select asp-for="PrincipalInspectionMode"><option value="@CaseInspectionMode.PhysicalAddress">Physical address</option><option value="@CaseInspectionMode.ImageBasedAssessment">Image based assessment</option></select></div>
                    }
                    @if (Model.CanAssociateSelectedType)
                    {
                        <div class="field"><label asp-for="AssociatedPrincipalIds">Linked principals</label><select asp-for="AssociatedPrincipalIds" multiple size="4">@foreach (var principal in Model.PrincipalChoices) { <option value="@principal.Principal.Id">@principal.Name · @principal.Principal.Code</option> }</select><small>Optional. Select every Principal this @(OperatorLabels.Contacts.Type(role).ToLowerInvariant()) works with.</small></div>
                    }
                </div>
                <div class="button-row"><button class="btn btn--small" type="submit" formaction="?handler=FindMatches" formnovalidate data-busy-label="@OperatorLabels.Busy.Checking">Check existing contacts</button></div>
                @if (Model.PossibleMatches.Count > 0)
                {
                    <section class="panel" aria-labelledby="possible-matches-title"><div class="panel-head"><h3 id="possible-matches-title">Possible existing contacts</h3></div><div class="panel-body stack">@foreach (var contact in Model.PossibleMatches) { <div class="button-row"><span>@contact.Name · @OperatorLabels.Contacts.Type(contact.Role)</span><a class="btn btn--small" asp-page="Edit" asp-route-id="@contact.OrganizationId">Open</a></div> }</div></section>
                }
            </div>
            <div class="dialog-foot"><a class="btn" asp-page="Index" asp-route-search="@Model.Search" asp-route-type="@Model.Type">Cancel</a><button class="btn btn--primary" type="submit" data-busy-label="@OperatorLabels.Busy.Saving">Save @OperatorLabels.Contacts.Type(role)</button></div>
        </form>
    </section>
    </div>
}
