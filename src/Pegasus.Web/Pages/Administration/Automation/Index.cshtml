@page
@using Pegasus.Core.AiWork
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Administration.Automation.IndexModel
@{
    ViewData["Title"] = OperatorLabels.Admin.Automation;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "automation";
    ViewData["AdminAutomationComposed"] = Model.IsComposed;

    var registration = Model.Status;
    var connector = Model.ConnectorSettings;
    var killSwitchLabel = registration is { IsEnabled: true }
        ? OperatorLabels.AutomationAdmin.Stop
        : OperatorLabels.AutomationAdmin.Start;
}

@* The rail is the way back, so the header carries the area name and nothing
   else. *@
<partial name="Shared/_PageHeader" />

@if (TempData["AdministrationStatus"] is string statusMessage)
{
    <div class="notice mb-2" role="status">
        <svg class="icon" aria-hidden="true"><use href="#icon-info" /></svg>
        <span>@statusMessage</span>
    </div>
}

<partial name="Shared/_ErrorSummary" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        @* A capability this deployment does not carry is absent, never an
           inert panel: the client registration is gated composition. *@
        @if (registration is not null)
        {
            <section class="panel" aria-labelledby="automation-panel-title">
                <div class="panel-head">
                    <h2 id="automation-panel-title">@OperatorLabels.AutomationAdmin.AutomationPanel</h2>
                    <partial name="Shared/_StatusChip" model="@OperatorLabels.AutomationAdmin.SwitchState(registration.IsEnabled)" />
                </div>
                <div class="panel-body">
                    @* One client is registered per deployment (ADR-0011), and
                       the job figures are the ledger's own counters. *@
                    <div class="fact-grid">
                        <dl class="fact">
                            <dt>@OperatorLabels.AutomationAdmin.RegisteredClients</dt>
                            <dd>@(registration.IsRegistered ? registration.DisplayName ?? registration.ClientId : "—")</dd>
                        </dl>
                        <dl class="fact">
                            <dt>@OperatorLabels.AutomationAdmin.ClientIdentifier</dt>
                            <dd>@registration.ClientId</dd>
                        </dl>
                        <dl class="fact">
                            <dt>@OperatorLabels.AutomationAdmin.GrantedScopes</dt>
                            <dd>
                                @if (registration.GrantedScopes.Count == 0)
                                {
                                    @:—
                                }
                                else
                                {
                                    for (var scopeIndex = 0; scopeIndex < registration.GrantedScopes.Count; scopeIndex++)
                                    {
                                        var scope = registration.GrantedScopes[scopeIndex];
                                        <span title="@scope">@OperatorLabels.AutomationAdmin.AutomationScope(scope)</span>@(scopeIndex < registration.GrantedScopes.Count - 1 ? ", " : "")
                                    }
                                }
                            </dd>
                        </dl>
                        <dl class="fact">
                            <dt>@OperatorLabels.AutomationAdmin.ActiveJobs</dt>
                            <dd class="tabular">@Model.JobCounts.Active</dd>
                        </dl>
                        <dl class="fact">
                            <dt>@OperatorLabels.AutomationAdmin.FailedJobs</dt>
                            <dd class="tabular">@Model.JobCounts.Failed</dd>
                        </dl>
                    </div>
                    @* The switch posts on its click. Stopping is the
                       destructive half, so only that direction carries the
                       danger styling and its consequence sentence. *@
                    <form method="post" asp-page-handler="SetEnabled" class="button-row section-gap">
                        <input type="hidden" name="TargetEnabled" value="@((!registration.IsEnabled).ToString())" />
                        <input type="hidden" name="OperationKey" value="@Model.OperationKey" />
                        @if (registration.IsEnabled)
                        {
                            <p class="muted">@OperatorLabels.AutomationAdmin.StopConsequence</p>
                        }
                        <button type="submit" class="btn @(registration.IsEnabled ? "btn--danger" : "btn--primary")">
                            <svg class="icon" aria-hidden="true"><use href="#icon-lock" /></svg>
                            <span>@killSwitchLabel</span>
                        </button>
                    </form>
                </div>
            </section>
        }

        @if (connector is not null)
        {
            <section class="panel" aria-labelledby="ai-settings-panel-title">
                <div class="panel-head">
                    <h2 id="ai-settings-panel-title">@OperatorLabels.AutomationAdmin.AiSettingsPanel</h2>
                    <partial name="Shared/_StatusChip" model="@OperatorLabels.AutomationAdmin.SwitchState(Model.SendToAiEnabledNow)" />
                </div>
                <div class="panel-body">
                    @* The token is write-only from entry onward, so the only
                       thing the page can state about it is that one is held
                       and when it last changed. *@
                    <dl class="definition-list">
                        <div class="definition">
                            <dt>@OperatorLabels.AutomationAdmin.ChannelToken</dt>
                            <dd>@(connector.TokenHeld
                                    ? OperatorLabels.AutomationAdmin.ChannelTokenEntered
                                    : OperatorLabels.AutomationAdmin.ChannelTokenStandard)</dd>
                        </div>
                        <div class="definition">
                            <dt>@OperatorLabels.AutomationAdmin.ChannelTokenChanged</dt>
                            <dd>
                                @if (connector.TokenRotatedAtUtc is { } rotated)
                                {
                                    <time datetime="@rotated.ToString("O")">@OperatorLabels.OfficeDate(rotated)</time>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </dd>
                        </div>
                    </dl>

                    <form method="post" asp-page-handler="SaveAiSettings" class="section-gap stack" autocomplete="off">
                        <input type="hidden" name="OperationKey" value="@Model.OperationKey" />
                        <div class="grid grid-2">
                            <div class="field">
                                <label for="ai-channel-address">@OperatorLabels.AutomationAdmin.ChannelAddress</label>
                                <input id="ai-channel-address" name="ChannelAddress" maxlength="200"
                                       value="@(Model.ChannelAddress ?? connector.ChannelBaseUrl)" />
                                <span asp-validation-for="ChannelAddress" class="field-validation-error"></span>
                            </div>
                            <div class="field">
                                <label for="ai-timeout">@OperatorLabels.AutomationAdmin.Timeout</label>
                                <input id="ai-timeout" name="ChannelTimeoutSeconds" type="number"
                                       min="@AiChannelConnectorRules.MinimumTimeoutSeconds"
                                       max="@AiChannelConnectorRules.MaximumTimeoutSeconds"
                                       step="1" value="@(Model.ChannelTimeoutSeconds ?? connector.TimeoutSeconds)" />
                                <span asp-validation-for="ChannelTimeoutSeconds" class="field-validation-error"></span>
                            </div>
                        </div>
                        <div class="field">
                            <label for="ai-channel-token">@OperatorLabels.AutomationAdmin.NewChannelToken</label>
                            <input id="ai-channel-token" name="NewChannelToken" type="password"
                                   minlength="@AiChannelConnectorRules.MinimumTokenLength"
                                   maxlength="200" autocomplete="new-password" />
                            <span asp-validation-for="NewChannelToken" class="field-validation-error"></span>
                        </div>
                        @* asp-for writes the unchecked fallback beside the box,
                           so a cleared checkbox reaches the handler as false. *@
                        <label class="cluster">
                            <input asp-for="SendToAiEnabled" type="checkbox" />
                            <span>@OperatorLabels.AutomationAdmin.SendToAiEnabled</span>
                        </label>
                        <div class="button-row">
                            <button type="submit" class="btn btn--primary">
                                <svg class="icon" aria-hidden="true"><use href="#icon-save" /></svg>
                                <span>@OperatorLabels.AutomationAdmin.Save</span>
                            </button>
                            @if (connector.TokenHeld)
                            {
                                <button type="submit" formaction="?handler=ClearChannelToken" formnovalidate class="btn btn--danger">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-trash-2" /></svg>
                                    <span>@OperatorLabels.AutomationAdmin.RemoveChannelToken</span>
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </section>
        }
        @if (!Model.IsComposed)
        {
            <section class="panel unavailable-panel" aria-labelledby="automation-unavailable-title">
                <div class="panel-head"><h2 id="automation-unavailable-title">Automation &amp; AI</h2></div>
                <div class="panel-body">
                    <p>This deployment does not have Automation or AI configuration available.</p>
                </div>
            </section>
        }
    </div>
</div>
