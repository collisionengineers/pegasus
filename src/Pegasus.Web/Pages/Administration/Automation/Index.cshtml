@page
@model Pegasus.Web.Pages.Administration.Automation.IndexModel
@{
    ViewData["Title"] = "Automation";
    ViewData["Eyebrow"] = "Administration";
}

<a class="back-link" asp-page="/Administration/Index">
    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
    Back to Administration
</a>

<partial name="Shared/_PageHeader" />

@if (TempData["AdministrationStatus"] is string status)
{
    <div role="status" class="status-card">@status</div>
}

@* What the Automation actor is and is not, kept from the lede it replaces. *@
<aside class="notice">
    <p>The Automation actor is not a staff account, holds no administration rights, and every action it takes is permanently recorded; client secrets are never shown here.</p>
</aside>

<div asp-validation-summary="All" class="validation-summary"></div>

<section class="panel" aria-labelledby="automation-registration-heading">
    <h2 id="automation-registration-heading" class="section-label">Client registration</h2>
    @if (!Model.IngressComposed)
    {
        <p>Automation is not part of this deployment: the configuration gate is off, no endpoint or token route exists, and no automation action is possible.</p>
    }
    else if (Model.Status is { } registration)
    {
        <dl class="detail-list">
            <div><dt>Client identifier</dt><dd>@registration.ClientId</dd></div>
            <div><dt>Display name</dt><dd>@(registration.DisplayName ?? "—")</dd></div>
            <div>
                <dt>State</dt>
                <dd>
                    @if (registration.IsEnabled)
                    {
                        <partial name="Shared/_StatusChip" model="@("Enabled")" />
                    }
                    else
                    {
                        <partial name="Shared/_StatusChip" model="@("Disabled")" />
                    }
                </dd>
            </div>
            <div><dt>Granted scopes</dt><dd>@string.Join(", ", registration.GrantedScopes)</dd></div>
        </dl>
        <form method="post" asp-page-handler="SetEnabled" class="section-gap">
            <input type="hidden" name="TargetEnabled" value="@((!registration.IsEnabled).ToString())" />
            <input type="hidden" name="OperationKey" value="@Model.OperationKey" />
            <label>
                Reason
                <input name="Reason" required maxlength="1000" />
            </label>
            <div class="button-row">
                @if (registration.IsEnabled)
                {
                    <button type="submit" class="primary-action">Disable the Automation client</button>
                }
                else
                {
                    <button type="submit" class="secondary-action">Enable the Automation client</button>
                }
            </div>
        </form>
        <p class="section-gap">Disabling refuses new tokens immediately and rejects an already-issued token within seconds; both changes are recorded as attributable administrator actions.</p>
    }
</section>

<section class="panel section-gap" aria-labelledby="send-to-ai-heading">
    <h2 id="send-to-ai-heading" class="section-label">Send to AI</h2>
    @if (!Model.SendToAiComposed)
    {
        <p>The Send to AI hand-off is not part of this deployment: the configuration gate is off and no outbound transport exists.</p>
    }
    else
    {
        <dl class="detail-list">
            <div>
                <dt>State</dt>
                <dd>
                    @if (Model.SendToAiEnabled)
                    {
                        <partial name="Shared/_StatusChip" model="@("Enabled")" />
                    }
                    else
                    {
                        <partial name="Shared/_StatusChip" model="@("Disabled")" />
                    }
                </dd>
            </div>
        </dl>
        <form method="post" asp-page-handler="SetSendToAiEnabled" class="section-gap">
            <input type="hidden" name="TargetEnabled" value="@((!Model.SendToAiEnabled).ToString())" />
            <input type="hidden" name="OperationKey" value="@Model.OperationKey" />
            <label>
                Reason
                <input name="Reason" required maxlength="1000" />
            </label>
            <div class="button-row">
                @if (Model.SendToAiEnabled)
                {
                    <button type="submit" class="primary-action">Disable sending to AI</button>
                }
                else
                {
                    <button type="submit" class="secondary-action">Enable sending to AI</button>
                }
            </div>
        </form>
        <p class="section-gap">Disabling refuses new hand-offs immediately; it does not touch the Automation client above, which has its own switch.</p>
    }
</section>

<section class="panel section-gap" aria-labelledby="automation-activity-link-heading">
    <h2 id="automation-activity-link-heading" class="section-label">Activity</h2>
    <p>Every Automation action and every denied automation request is recorded in permanent history.</p>
    <p><a asp-page="/Administration/Automation/Activity">Review Automation activity</a></p>
</section>
