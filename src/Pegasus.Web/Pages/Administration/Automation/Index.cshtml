@page
@using Pegasus.Core.AiWork
@model Pegasus.Web.Pages.Administration.Automation.IndexModel
@{
    ViewData["Title"] = OperatorLabels.Admin.Automation;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "automation";

    var registration = Model.Status;
    var killSwitchLabel = registration is { IsEnabled: true }
        ? OperatorLabels.AutomationAdmin.Stop
        : OperatorLabels.AutomationAdmin.Start;
    var registeredClient = registration is { IsRegistered: true }
        ? registration.DisplayName ?? registration.ClientId
        : null;
    var jobs = Model.Jobs;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

@* The rail is the way back, so the header carries the area name and nothing
   else. *@
<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        @if (Model.StatusMessage is { } statusMessage)
        {
            <div class="notice notice--success" role="status">
                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-check-circle")" /></svg>
                <span>@statusMessage</span>
            </div>
        }
        @if (Model.ErrorMessage is { } errorMessage)
        {
            <div class="notice notice--danger" role="alert"><span>@errorMessage</span></div>
        }
        <partial name="Shared/_ErrorSummary" />
        @* A capability this deployment does not carry is absent, never an
           inert panel: the client registration is gated composition. *@
        @if (registration is not null)
        {
            <section class="panel" aria-labelledby="automation-panel-title">
                <div class="panel-head">
                    <h2 id="automation-panel-title">@OperatorLabels.AutomationAdmin.AutomationPanel</h2>
                    <partial name="Shared/_StatusChip" model="@OperatorLabels.AutomationAdmin.SwitchState(registration.IsEnabled)" />
                </div>
                <div class="panel-body">
                    @* One client is registered per deployment (ADR-0011). The
                       job counts are the AI jobs panel's own, below. *@
                    <div class="fact-grid">
                        @* The client's name and its identifier are one fact when
                           they are the same string. *@
                        @if (registeredClient != registration.ClientId)
                        {
                            <dl class="fact">
                                <dt>@OperatorLabels.AutomationAdmin.RegisteredClients</dt>
                                <dd>@(registeredClient ?? "—")</dd>
                            </dl>
                        }
                        <dl class="fact">
                            <dt>@OperatorLabels.AutomationAdmin.ClientIdentifier</dt>
                            <dd class="mono">@registration.ClientId</dd>
                        </dl>
                        <dl class="fact">
                            <dt>@OperatorLabels.AutomationAdmin.GrantedScopes</dt>
                            <dd>
                                @if (registration.GrantedScopes.Count == 0)
                                {
                                    @:—
                                }
                                else
                                {
                                    for (var scopeIndex = 0; scopeIndex < registration.GrantedScopes.Count; scopeIndex++)
                                    {
                                        var scope = registration.GrantedScopes[scopeIndex];
                                        <span title="@scope">@OperatorLabels.AutomationAdmin.AutomationScope(scope)</span>@(scopeIndex < registration.GrantedScopes.Count - 1 ? ", " : "")
                                    }
                                }
                            </dd>
                        </dl>
                    </div>
                    @* The switch posts on its click. Stopping is the
                       destructive half, so only that direction carries the
                       danger styling and its consequence sentence. *@
                    <form method="post" asp-page-handler="SetEnabled" class="cluster admin-actions-end mt-2">
                        <input type="hidden" name="TargetEnabled" value="@((!registration.IsEnabled).ToString())" />
                        <input type="hidden" name="OperationKey" value="@Model.OperationKey" />
                        @if (registration.IsEnabled)
                        {
                            <span class="muted">@OperatorLabels.AutomationAdmin.StopConsequence</span>
                        }
                        <button type="submit" class="btn @(registration.IsEnabled ? "btn--danger" : "btn--primary")" data-busy-label="@(registration.IsEnabled ? OperatorLabels.Busy.Stopping : OperatorLabels.Busy.Starting)">
                            <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href(registration.IsEnabled ? "icon-pause" : "icon-play")" /></svg>
                            <span>@killSwitchLabel</span>
                        </button>
                    </form>
                </div>
            </section>

            <section class="panel" aria-labelledby="ai-settings-panel-title">
                <div class="panel-head">
                    <h2 id="ai-settings-panel-title">@OperatorLabels.AutomationAdmin.AiSettingsPanel</h2>
                </div>
                <div class="panel-body">
                    <form method="post" asp-page-handler="SaveAiSettings" class="stack" autocomplete="off">
                        <input type="hidden" name="OperationKey" value="@Model.OperationKey" />
                        @* asp-for writes the unchecked fallback beside the box,
                           so a cleared checkbox reaches the handler as false. *@
                        <label class="choice">
                            <input asp-for="SendToAiEnabled" type="checkbox" />
                            <span>@OperatorLabels.AutomationAdmin.SendToAi</span>
                        </label>
                        <label class="choice">
                            <input asp-for="AutomaticGlassValuationEnabled" type="checkbox" />
                            <span>@OperatorLabels.AutomationAdmin.AutomaticGlassValuation</span>
                        </label>
                        <div class="cluster admin-actions-end">
                            <button type="submit" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Saving">
                                <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-save")" /></svg>
                                <span>@OperatorLabels.AutomationAdmin.Save</span>
                            </button>
                        </div>
                    </form>
                </div>
            </section>
        }
        else
        {
            <section class="panel unavailable-panel" aria-labelledby="automation-unavailable-title">
                <div class="panel-head"><h2 id="automation-unavailable-title">@OperatorLabels.Admin.Automation</h2></div>
                <div class="panel-body">
                    <p>@OperatorLabels.AutomationAdmin.Unavailable</p>
                </div>
            </section>
        }

        @* The AI job ledger in pages (FRD-27), with its live counters, which
           every deployment carries. *@
        <section class="panel" aria-labelledby="ai-jobs-panel-title">
            <div class="panel-head">
                <h2 id="ai-jobs-panel-title">@OperatorLabels.Admin.AiJobs</h2>
                <span class="meta" data-ai-jobs-counts>@OperatorLabels.AiJobs.Counts(jobs.Counts, jobs.SendToAiSwitchEnabled)</span>
            </div>
            @if (jobs.Jobs.Count == 0)
            {
                <div class="empty"><p>@OperatorLabels.AiJobs.None</p></div>
            }
            else
            {
            <div class="table-wrap no-border">
                <table class="table table--compact" data-admin-ai-jobs>
                    <caption class="sr-only">@OperatorLabels.Admin.AiJobs</caption>
                    <thead><tr><th scope="col">@OperatorLabels.AiJobs.JobColumn</th><th scope="col">@OperatorLabels.AiJobs.SubjectColumn</th><th scope="col">@OperatorLabels.AiJobs.CreatedColumn</th><th scope="col">@OperatorLabels.AiJobs.StateColumn</th><th scope="col" class="right">@OperatorLabels.AiJobs.ActionColumn</th></tr></thead>
                    <tbody>
                    @foreach (var job in jobs.Jobs)
                    {
                        <tr>
                            <td>
                                <strong>@OperatorLabels.AiJobs.Kind(job.Kind)</strong>
                                @if (!string.IsNullOrWhiteSpace(job.Instruction))
                                {
                                    <small class="admin-job-detail">@OperatorLabels.AiJobs.Instruction(job)</small>
                                }
                            </td>
                            <td class="mono">
                                @if (job.SubjectKind == AiJobSubjectKind.Queue)
                                {
                                    @OperatorLabels.AiJobs.QueueRecord
                                }
                                else if (job.SubjectKind == AiJobSubjectKind.Case && job.SubjectId is { } caseId)
                                {
                                    <a asp-page="/Cases/Details" asp-route-id="@caseId">@job.SubjectReference</a>
                                }
                                else
                                {
                                    @job.SubjectReference
                                }
                            </td>
                            <td class="nowrap">@OperatorLabels.OfficeTime(job.CreatedAtUtc, "")</td>
                            <td><partial name="Shared/_StatusChip"
                                         model="@OperatorLabels.AiJobs.State(job.State)"
                                         view-data='new ViewDataDictionary(ViewData) { ["StatusTone"] = OperatorLabels.AiJobs.StateToneOverride(job.State) }' /></td>
                            <td class="row-actions">
                                @if (!AiJobStates.IsTerminal(job.State))
                                {
                                    <form method="post" asp-page-handler="Stop">
                                        <input type="hidden" name="jobId" value="@job.JobId" />
                                        <input type="hidden" name="expectedVersion" value="@job.Version" />
                                        <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                                        <input type="hidden" name="pageNumber" value="@Model.CurrentPage" />
                                        <button class="btn btn--small btn--danger" type="submit" data-busy-label="@OperatorLabels.Busy.Stopping">@OperatorLabels.AiJobs.Stop</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            }
            @if (Model.CurrentPage > 1 || jobs.HasMore)
            {
                <div class="panel-foot">
                    <nav class="pagination" aria-label="@OperatorLabels.AiJobs.Pages">
                        @if (Model.CurrentPage > 1)
                        {
                            <a class="btn btn--small" asp-page="/Administration/Automation/Index" asp-route-pageNumber="@(Model.CurrentPage - 1)">@OperatorLabels.AiJobs.Previous</a>
                        }
                        <span>@OperatorLabels.AiJobs.Page(Model.CurrentPage)</span>
                        @if (jobs.HasMore)
                        {
                            <a class="btn btn--small" asp-page="/Administration/Automation/Index" asp-route-pageNumber="@(Model.CurrentPage + 1)">@OperatorLabels.AiJobs.Next</a>
                        }
                    </nav>
                </div>
            }
        </section>
    </div>
</div>
