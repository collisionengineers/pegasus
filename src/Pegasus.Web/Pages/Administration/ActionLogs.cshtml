@page
@model Pegasus.Web.Pages.Administration.ActionLogsModel
@{ ViewData["Title"] = "Action logs"; ViewData["Eyebrow"] = "Administration"; }
<partial name="Shared/_PageHeader" />
<partial name="Shared/_ErrorSummary" />
<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        <section class="panel">
            <div class="panel-head"><h2>Action logs</h2></div>
            <div class="panel-body panel-body--compact">
                <form method="get" class="compact-log-filter">
                    <div class="field"><label for="search">Keywords</label><input id="search" asp-for="Search" /></div>
                    <div class="field"><label for="operation">Activity</label><input id="operation" asp-for="Operation" /></div>
                    <div class="field">
                        <label for="actor">Person</label>
                        <select id="actor" asp-for="Actor">
                            <option value="">All people</option>
                            @foreach (var person in Model.People)
                            {
                                <option value="@person.Id">@person.UserName</option>
                            }
                            @if (Model.AutomationActorSubjectId is { Length: > 0 } automationActor)
                            {
                                <option value="@automationActor">@Model.AutomationActorLabel</option>
                            }
                        </select>
                    </div>
                    <div class="field"><label for="record">Case/reference</label><input id="record" asp-for="Record" /></div>
                    <div class="field"><label for="result">Outcome</label><input id="result" name="Result" value="@Model.ResultFilter" /></div>
                    <div class="field"><label for="from">From</label><input id="from" asp-for="From" type="datetime-local" /></div>
                    <div class="field"><label for="to">To</label><input id="to" asp-for="To" type="datetime-local" /></div>
                    <div class="button-row">
                        <button class="btn btn--primary" type="submit">Apply</button>
                        <a class="btn" asp-page="/Administration/ActionLogs">Clear</a>
                    </div>
                </form>
                @if (Model.Result.Rows.Count > 0)
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th><a href="@Model.SortUrl">Time @(Model.OldestFirst ? "↑" : "↓")</a></th><th>Actor</th><th>Area</th><th>Action</th><th>Reference</th><th>Result</th></tr></thead>
                            <tbody>
                            @foreach (var row in Model.Result.Rows)
                            {
                                <tr><td>@row.OccurredAtUtc.ToString("u")</td><td>@Model.ActorLabel(row)</td><td>@row.Area</td><td>@row.Operation</td><td>@(Model.ReferenceLabel(row) ?? "—")</td><td>@row.Result</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                @if (Model.CurrentPage > 1 || Model.Result.HasMore)
                {
                    <nav class="pagination" aria-label="Action log pages">
                        @if (Model.CurrentPage > 1)
                        {
                            <a class="btn btn--small" href="@Model.PreviousPageUrl">Previous</a>
                        }
                        <span>Page @Model.CurrentPage</span>
                        @if (Model.Result.HasMore)
                        {
                            <a class="btn btn--small" href="@Model.NextPageUrl">Next</a>
                        }
                    </nav>
                }
                @if (Model.Result.Rows.Count == 0)
                {
                    <p class="muted section-gap" role="status">No actions match these filters.</p>
                }
            </div>
        </section>
        @if (Model.Metrics is { } metrics)
        {
            <details class="panel">
                <summary class="panel-head">Recorded counts and processing times</summary>
                <div class="panel-body grid grid-3">
                    <dl><dt class="muted">Mailbox failures</dt><dd>@metrics.MailboxFailures</dd></dl>
                    <dl><dt class="muted">Mailbox freshness</dt><dd>@metrics.MailboxFreshness.State (@OperatorLabels.OfficeTime(metrics.MailboxFreshness.LastSuccessfulUpdateAtUtc, ""))</dd></dl>
                    <dl><dt class="muted">Failed intake</dt><dd>@metrics.IntakeFailed</dd></dl>
                    <dl><dt class="muted">Oldest pending intake due</dt><dd>@OperatorLabels.OfficeTime(metrics.OldestPendingIntakeDueAtUtc, "")</dd></dl>
                    <dl><dt class="muted">Oldest pending custody</dt><dd>@OperatorLabels.OfficeTime(metrics.OldestPendingCustodyCreatedAtUtc, "")</dd></dl>
                    <dl><dt class="muted">Poisoned inbox messages</dt><dd>@metrics.PoisonedInboxMessages</dd></dl>
                    <dl><dt class="muted">Unknown sends</dt><dd>@metrics.UnknownSends</dd></dl>
                    <dl><dt class="muted">Oldest pending AI job</dt><dd>@OperatorLabels.OfficeTime(metrics.OldestPendingAiJobCreatedAtUtc, "")</dd></dl>
                    <dl><dt class="muted">Cache entries</dt><dd>@metrics.CacheEntries</dd></dl>
                    <dl><dt class="muted">Cache bytes</dt><dd>@metrics.CacheBytes</dd></dl>
                    <dl><dt class="muted">Next cache expiry</dt><dd>@OperatorLabels.OfficeTime(metrics.NextCacheExpiryAtUtc, "")</dd></dl>
                    <dl><dt class="muted">Active cache reads</dt><dd>@metrics.ActiveCacheReadLeases</dd></dl>
                    <dl><dt class="muted">Cache cleanup failures</dt><dd>@metrics.CacheCleanupFailures</dd></dl>
                    <dl><dt class="muted">Cache hits since Web start</dt><dd>@metrics.CacheHitsSinceStart</dd></dl>
                    <dl><dt class="muted">Cache misses since Web start</dt><dd>@metrics.CacheMissesSinceStart</dd></dl>
                </div>
            </details>
        }
    </div>
</div>
