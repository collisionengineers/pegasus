@page "{id:guid}"
@model Pegasus.Web.Pages.Administration.Accounts.EditModel
@{
    ViewData["Title"] = "Manage staff account";
}

<a class="back-link" asp-page="Index">
    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
    Back to Staff accounts
</a>

@* Defensive only: the handler returns 404 when the account is absent or
   unauthorised, so the not-found surface is owned by the error page. *@
@if (Model.Account is not null)
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Administration</p>
            <h1>Manage @Model.Account.UserName</h1>
        </div>
        <div class="page-heading-actions">
            <partial name="Shared/_StatusChip" model="@(Model.Account.IsEnabled ? "Enabled" : "Disabled")" />
        </div>
    </div>

    @if (TempData["AdministrationStatus"] is string status)
    {
        <div class="status-card" role="status">@status</div>
    }

    <div class="split-main">
        <section aria-labelledby="account-detail-heading">
            <h2 id="account-detail-heading" class="section-label">Account detail</h2>
            <div class="panel">
                <dl class="detail-list">
                    <div>
                        <dt>Status</dt>
                        <dd>@(Model.Account.IsEnabled ? "Enabled" : "Disabled")</dd>
                    </div>
                    <div>
                        <dt>First password change</dt>
                        <dd>@(Model.Account.MustChangePassword ? "Required" : "Complete")</dd>
                    </div>
                    <div>
                        <dt>Last access review</dt>
                        <dd>
                            @if (Model.Account.LastAccessReviewAtUtc is { } reviewedAtUtc)
                            {
                                <time datetime="@reviewedAtUtc.ToString("O")">@reviewedAtUtc.ToString("u")</time>
                            }
                            else
                            {
                                <span class="empty-state">Not recorded</span>
                            }
                        </dd>
                    </div>
                </dl>
            </div>
        </section>

        <section aria-labelledby="account-action-heading">
            <h2 id="account-action-heading" class="section-label">Account action</h2>
            @if (Model.Account.IsEnabled)
            {
                <div class="panel form-panel form-panel--wide">
                    <form method="post" asp-page-handler="Disable">
                        <div asp-validation-summary="ModelOnly"></div>
                        <input asp-for="OperationKey" type="hidden" />
                        <div>
                            <label asp-for="Reason">Reason</label>
                            <textarea asp-for="Reason" rows="3"></textarea>
                            <span asp-validation-for="Reason"></span>
                        </div>
                        <div class="button-row">
                            <button type="submit" class="primary-action">Disable account</button>
                        </div>
                    </form>
                    <p class="empty-state">Disabling revokes existing browser sessions. The account is retained permanently.</p>
                </div>
            }
            else
            {
                <div class="panel empty-state">This account is disabled and retained in permanent administration history. There is no delete or password-display action.</div>
            }
        </section>
    </div>
}
