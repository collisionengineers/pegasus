@page
@using Pegasus.Core.Identity
@model Pegasus.Web.Pages.Administration.Accounts.IndexModel
@{
    ViewData["Title"] = OperatorLabels.Admin.Accounts;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "accounts";
    ViewData["AdminAutomationComposed"] = Model.AutomationComposed;
}

<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        @if (!Model.CreatePostSubmitted && Model.SettingsPostStaffId == Guid.Empty)
        {
            <partial name="Shared/_ErrorSummary" />
        }
        <section class="panel" aria-labelledby="staff-accounts-title">
            <div class="panel-head">
                <div>
                    <h2 id="staff-accounts-title">Staff accounts</h2>
                    <p class="panel-title-meta">@Model.Rows.Count@(Model.HasMoreAccounts ? "+" : string.Empty) accounts</p>
                </div>
                <button type="button" class="btn btn--primary" data-dialog-open="create-account-dialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg><span>Create staff account</span>
                </button>
            </div>
            @if (Model.Rows.Count == 0)
            {
                <div class="empty"><h2>No staff accounts.</h2></div>
            }
            else
            {
                <div class="table-wrap no-border">
                    <table>
                        <caption class="sr-only">Staff accounts</caption>
                        <thead><tr><th scope="col">Username</th><th scope="col">Role</th><th scope="col">Sign-off</th><th scope="col">State</th><th scope="col"><span class="sr-only">Settings</span></th></tr></thead>
                        <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var account = row.Account;
                            <tr>
                                <td class="mono">@account.UserName</td>
                                <td>@OperatorLabels.Humanise(account.Role.ToString())</td>
                                <td>@OperatorLabels.StaffAccounts.SignOffState(account)</td>
                                <td>
                                    <partial name="Shared/_StatusChip" model="@OperatorLabels.StaffAccounts.State(account.IsEnabled)" />
                                    @if (account.MustChangePassword)
                                    { <partial name="Shared/_StatusChip" model="@OperatorLabels.StaffAccounts.PasswordChangeRequired" view-data="@(new ViewDataDictionary(ViewData) { ["StatusTone"] = "amber" })" /> }
                                </td>
                                <td class="right">
                                    <span class="cluster">
                                        <a class="btn btn--small" asp-page="Index" asp-route-editStaffId="@account.Id" asp-route-expectedVersion="@account.Version">Settings</a>
                                        @* Offered only to the operator whose own other window still
                                           holds this account; taking over rotates the token so that
                                           window can no longer save. *@
                                        @if (account.Id == Model.TakeOverStaffId)
                                        {
                                            <form method="post" asp-page-handler="Edit">
                                                <input type="hidden" name="staffId" value="@account.Id" />
                                                <input type="hidden" name="expectedVersion" value="@account.Version" />
                                                <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                                                <input type="hidden" name="takeOver" value="true" />
                                                <button type="submit" class="btn btn--small btn--primary">Take over</button>
                                            </form>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

@if (Model.ResetTemporaryPassword is { } temporaryPassword)
{
    <section class="panel" aria-labelledby="temporary-password-title"><div class="panel-head"><h2 id="temporary-password-title">Temporary password</h2></div><div class="panel-body stack"><p>Give this to the account holder. It is shown only for this response and must be changed at first sign-in.</p><output class="mono">@temporaryPassword</output></div></section>
}

<div class="dialog-backdrop" data-dialog="create-account-dialog" data-dialog-open-on-load="@(Model.CreatePostSubmitted ? "true" : "false")" hidden="@(!Model.CreatePostSubmitted)">
    <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="create-account-title">
        <div class="dialog-head"><h2 id="create-account-title" tabindex="-1" data-dialog-initial-focus>Create staff account</h2><button type="button" class="dialog-close" data-dialog-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button></div>
        <form method="post" asp-page-handler="Create">
            <input type="hidden" name="operationKey" value="@Model.CreateOperationKey" />
            <div class="dialog-body stack">
                @if (Model.CreatePostSubmitted) { <partial name="Shared/_ErrorSummary" /> }
                <div class="field"><label class="req" for="create-username">Username</label><input id="create-username" name="userName" value="@Model.NewUserName" required maxlength="@StaffAccountAdministrationPolicy.MaximumUserNameLength" autocomplete="off" /></div>
                <div class="field"><label class="req" for="create-password">Temporary password</label><input id="create-password" name="temporaryPassword" type="password" required minlength="@StaffAccountAdministrationPolicy.MinimumPasswordLength" maxlength="@StaffAccountAdministrationPolicy.MaximumPasswordLength" autocomplete="new-password" /></div>
            </div>
            <div class="dialog-foot"><button type="button" class="btn" data-dialog-close>Cancel</button><button type="submit" class="btn btn--primary">Create staff account</button></div>
        </form>
    </section>
</div>

@foreach (var row in Model.Rows.Where(item => item.Account.Id == Model.SettingsPostStaffId))
{
    var account = row.Account;
    var staffId = account.Id.ToString("D");
    var settingsId = "settings-" + staffId;
    var signatoryAllowed = Model.SettingsPostRole is StaffRole.Administrator or StaffRole.Engineer;
    <div class="dialog-backdrop" data-dialog="@settingsId" data-dialog-open-on-load="true">
        <section class="dialog dialog--wide account-settings-dialog" role="dialog" aria-modal="true" aria-labelledby="@settingsId-title">
            <div class="dialog-head"><h2 id="@settingsId-title" tabindex="-1" data-dialog-initial-focus>@account.UserName</h2><form method="post" asp-page-handler="CancelSettings"><input type="hidden" name="staffId" value="@staffId" /><input type="hidden" name="editLeaseToken" value="@Model.SettingsLeaseToken" /><input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" /><button type="submit" class="dialog-close" aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button></form></div>
            @* The renewal interval is the one Core value, rendered like the
               workflow configuration editor's; the script keeps no copy. *@
            <form method="post" asp-page-handler="Settings" enctype="multipart/form-data" data-account-settings data-account-staff-id="@staffId" data-heartbeat-ms="@Pegasus.Core.Workflow.EditScopeAuthority.HeartbeatInterval.TotalMilliseconds">
                <input type="hidden" name="staffId" value="@staffId" /><input type="hidden" name="expectedVersion" value="@Model.SettingsPostVersion" /><input type="hidden" name="editLeaseToken" value="@Model.SettingsLeaseToken" /><input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                <div class="dialog-body stack">
                    <partial name="Shared/_ErrorSummary" />
                    <dl class="fact-grid account-settings-facts"><div class="fact"><dt>Username</dt><dd class="mono">@account.UserName</dd></div><div class="fact"><dt>State</dt><dd>@OperatorLabels.StaffAccounts.State(account.IsEnabled)</dd></div></dl>
                    <div class="account-signoff-fields">
                        <div class="field"><label for="@settingsId-role">Role</label><select id="@settingsId-role" name="role" data-account-role disabled="@row.IsCurrentOperator">@foreach (var role in Enum.GetValues<StaffRole>()) { <option value="@role" selected="@(Model.SettingsPostRole == role)">@OperatorLabels.Humanise(role.ToString())</option> }</select>@if (row.IsCurrentOperator) { <input type="hidden" name="role" value="@Model.SettingsPostRole" /> }</div>
                        <div class="field"><label for="@settingsId-signoff">Sign-off Engineer</label>@if (!signatoryAllowed) { <input type="hidden" name="isSignOffEngineer" value="false" /> }<select id="@settingsId-signoff" name="isSignOffEngineer" data-account-signoff disabled="@(!signatoryAllowed)"><option value="false" selected="@(!Model.SettingsPostIsSignOffEngineer)">No</option><option value="true" selected="@Model.SettingsPostIsSignOffEngineer">Yes</option></select></div>
                        <div class="field" data-account-signoff-field><label for="@settingsId-name">Printed name</label><input id="@settingsId-name" name="printedName" value="@Model.SettingsPostPrintedName" maxlength="@StaffAccountAdministrationPolicy.MaximumSignOffPrintedNameLength" /></div>
                        <div class="field" data-account-signoff-field><label for="@settingsId-qualifications">Qualifications</label><input id="@settingsId-qualifications" name="qualifications" value="@Model.SettingsPostQualifications" maxlength="@StaffAccountAdministrationPolicy.MaximumSignOffQualificationsLength" /></div>
                    </div>
                    <section class="account-settings-section" aria-labelledby="@settingsId-glass-title"><div class="settings-line"><div><strong id="@settingsId-glass-title">Glass's repair estimates</strong><span class="meta">Manage this account's login.</span></div><a class="btn" asp-page="/Administration/Glass/Index" asp-route-staffId="@account.Id" data-account-glass-login>Manage login</a></div><p class="notice notice--error" data-account-glass-login-error role="alert" hidden></p></section>
                    <div class="field" data-account-signoff-field><label for="@settingsId-signature">@(account.SignOff.HasSignature ? "Replace signature" : "Signature image")</label><input id="@settingsId-signature" name="signature" type="file" accept="@SignOffSignaturePolicy.MediaType" /></div>
                    <label class="choice" for="@settingsId-default" data-account-signoff-field><input id="@settingsId-default" name="isDefaultSignOffEngineer" type="checkbox" value="true" checked="@Model.SettingsPostIsDefault" data-account-default disabled="@(!signatoryAllowed)" /><span>Default sign-off Engineer</span></label>
                </div>
                <div class="dialog-foot"><button type="submit" formaction="?handler=CancelSettings" formnovalidate class="btn">Cancel</button><button type="submit" class="btn btn--primary">Save settings</button></div>
            </form>
            @if (!row.IsCurrentOperator)
            {
                @* Each action posts on its click; there is no confirmation
                   step and no reason to type. *@
                var adverse = new[] { (account.IsEnabled ? "Disable" : "Enable", account.IsEnabled ? "btn btn--danger" : "btn"), ("Delete", "btn btn--danger") };
                var routine = account.IsEnabled ? new[] { ("ForceLogout", "Force logout"), ("ResetPassword", "Reset password") } : [];
                <div class="dialog-foot">
                    <div class="left">
                        @foreach (var (handler, buttonClass) in adverse)
                        {
                            <form method="post" asp-page-handler="@handler"><input type="hidden" name="staffId" value="@staffId" /><input type="hidden" name="expectedVersion" value="@Model.SettingsPostVersion" /><input type="hidden" name="editLeaseToken" value="@Model.SettingsLeaseToken" /><input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" /><button type="submit" class="@buttonClass">@handler</button></form>
                        }
                    </div>
                    @foreach (var (handler, label) in routine)
                    {
                        <form method="post" asp-page-handler="@handler"><input type="hidden" name="staffId" value="@staffId" /><input type="hidden" name="expectedVersion" value="@Model.SettingsPostVersion" /><input type="hidden" name="editLeaseToken" value="@Model.SettingsLeaseToken" /><input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" /><button type="submit" class="btn">@label</button></form>
                    }
                </div>
            }
        </section>
    </div>

    @* Beaconed as the page unloads so an operator who navigates away is not
       refused by their own lease when they come back. *@
    <form method="post" asp-page-handler="ReleaseScopeBeacon" data-edit-scope-release hidden>
        <input type="hidden" name="staffId" value="@staffId" />
        <input type="hidden" name="editLeaseToken" value="@Model.SettingsLeaseToken" />
    </form>
}

@section Scripts {
    <script src="~/js/accounts.js" asp-append-version="true"></script>
}
