@page
@using Pegasus.Core.Identity
@model Pegasus.Web.Pages.Administration.Accounts.IndexModel
@{
    ViewData["Title"] = OperatorLabels.Admin.Accounts;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "accounts";
    ViewData["AdminAutomationComposed"] = Model.AutomationComposed;
    var staffRoles = Enum.GetValues<StaffRole>();
    var reasonLimit = StaffAccountAdministrationPolicy.MaximumReasonLength;
}

<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        <partial name="Shared/_ErrorSummary" />
        <section class="panel" aria-labelledby="staff-accounts-title">
            <div class="panel-head">
                <div>
                    <h2 id="staff-accounts-title">Staff accounts</h2>
                    <p class="panel-title-meta">@Model.Rows.Count@(Model.HasMoreAccounts ? "+" : string.Empty) accounts</p>
                </div>
                <button type="button" class="btn btn--primary" data-dialog-open="create-account-dialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                    <span>Create staff account</span>
                </button>
            </div>
            @if (Model.Rows.Count == 0)
            {
                <div class="empty"><h2>No staff accounts are available.</h2></div>
            }
            else
            {
                <div class="table-wrap no-border">
                    <table>
                        <caption class="sr-only">Staff accounts with their roles and state</caption>
                        <thead>
                            <tr>
                                <th scope="col">Username</th>
                                <th scope="col">Roles</th>
                                <th scope="col">Sign-off Engineer</th>
                                <th scope="col">State</th>
                                <th scope="col"><span class="sr-only">Account settings</span></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var account = row.Account;
                            var staffId = account.Id.ToString("D");
                            <tr>
                                <td class="mono">@account.UserName</td>
                                <td>@string.Join(", ", account.Roles.Select(role => OperatorLabels.Humanise(role.ToString())))</td>
                                <td>@OperatorLabels.StaffAccounts.SignOffState(account)</td>
                                <td>
                                    <partial name="Shared/_StatusChip" model="@OperatorLabels.StaffAccounts.State(account.IsEnabled)" />
                                    @if (account.MustChangePassword)
                                    {
                                        <partial name="Shared/_StatusChip" model="@OperatorLabels.StaffAccounts.PasswordChangeRequired" view-data="@(new ViewDataDictionary(ViewData) { ["StatusTone"] = "amber" })" />
                                    }
                                    else
                                    {
                                        <partial name="Shared/_StatusChip" model="@OperatorLabels.StaffAccounts.PasswordChangeComplete" view-data="@(new ViewDataDictionary(ViewData) { ["StatusTone"] = "green" })" />
                                    }
                                </td>
                                <td class="right"><button type="button" class="btn btn--small" data-dialog-open="settings-@staffId">Settings</button></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

@if (Model.ResetTemporaryPassword is { } temporaryPassword)
{
    <section class="panel" aria-labelledby="temporary-password-title">
        <div class="panel-head"><h2 id="temporary-password-title">Temporary password</h2></div>
        <div class="panel-body stack">
            <p>Give this to the account holder. It is shown only for this response and must be changed at first sign-in.</p>
            <output class="mono">@temporaryPassword</output>
        </div>
    </section>
}

@* Dialogs remain outside the scrolling table so their fixed backdrop is never clipped. *@
<div class="dialog-backdrop" data-dialog="create-account-dialog"
     data-dialog-open-on-load="@(Model.CreatePostSubmitted ? "true" : "false")"
     hidden="@(!Model.CreatePostSubmitted)">
    <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="create-account-title">
        <div class="dialog-head">
            <h2 id="create-account-title" tabindex="-1">Create staff account</h2>
            <button type="button" class="dialog-close" data-dialog-close aria-label="@OperatorLabels.StaffAccounts.CloseDialog"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
        </div>
        <form method="post" asp-page-handler="Create">
            <input type="hidden" name="operationKey" value="@Model.CreateOperationKey" />
            <div class="dialog-body stack">
                <div class="field">
                    <label class="req" for="create-username">Username</label>
                    <input id="create-username" name="userName" value="@Model.NewUserName" required maxlength="@StaffAccountAdministrationPolicy.MaximumUserNameLength" autocomplete="off" data-dialog-initial-focus />
                </div>
                <div class="field">
                    <label class="req" for="create-password">Temporary password</label>
                    <input id="create-password" name="temporaryPassword" type="password" required minlength="@StaffAccountAdministrationPolicy.MinimumPasswordLength" maxlength="@StaffAccountAdministrationPolicy.MaximumPasswordLength" autocomplete="new-password" />
                </div>
                <div class="field">
                    <label class="req" for="create-reason">Reason</label>
                    <textarea id="create-reason" name="reason" rows="3" required maxlength="@reasonLimit">@Model.NewReason</textarea>
                </div>
            </div>
            <div class="dialog-foot">
                <button type="button" class="btn" data-dialog-close>@OperatorLabels.StaffAccounts.Cancel</button>
                <button type="submit" class="btn btn--primary"><svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg><span>Create staff account</span></button>
            </div>
        </form>
    </section>
</div>

@foreach (var row in Model.Rows)
{
    var account = row.Account;
    var staffId = account.Id.ToString("D");
    var settingsId = "settings-" + staffId;
    var roleForm = "roles-" + staffId;
    var roleSelect = roleForm + "-select";
    var roleReason = roleForm + "-reason";
    var reopenSettings = Model.RolePostStaffId == account.Id || Model.SignOffPostStaffId == account.Id;
    var settingsAutoOpen = reopenSettings ? "true" : "false";
    var roleReasonValue = Model.RolePostStaffId == account.Id ? Model.RoleReason : string.Empty;
    <div class="dialog-backdrop" data-dialog="@settingsId" data-dialog-open-on-load="@settingsAutoOpen" hidden="@(!reopenSettings)">
        <section class="dialog dialog--wide" role="dialog" aria-modal="true" aria-labelledby="@settingsId-title">
            <div class="dialog-head">
                <h2 id="@settingsId-title" tabindex="-1">@account.UserName</h2>
                <button type="button" class="dialog-close" data-dialog-close aria-label="@OperatorLabels.StaffAccounts.CloseDialog"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
            </div>
            <div class="dialog-body stack">
                <dl class="fact-grid">
                    <div class="fact"><dt>Username</dt><dd class="mono">@account.UserName</dd></div>
                    <div class="fact"><dt>State</dt><dd><partial name="Shared/_StatusChip" model="@OperatorLabels.StaffAccounts.State(account.IsEnabled)" /></dd></div>
                    <div class="fact"><dt>Password</dt><dd>@(account.MustChangePassword ? OperatorLabels.StaffAccounts.PasswordChangeRequired : OperatorLabels.StaffAccounts.PasswordChangeComplete)</dd></div>
                    <div class="fact"><dt>Sign-off Engineer</dt><dd>@OperatorLabels.StaffAccounts.SignOffState(account)</dd></div>
                </dl>

                <form id="@roleForm" method="post" asp-page-handler="Roles" class="stack">
                    <input type="hidden" name="staffId" value="@staffId" />
                    <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                    <fieldset class="role-choices" disabled="@row.IsCurrentOperator">
                        <legend>Roles</legend>
                        @foreach (var role in staffRoles)
                        {
                            <label class="choice">
                                <input id="@roleSelect-@role" type="checkbox" name="selectedRoles" value="@role" checked="@Model.IsRoleSelected(row, role)" />
                                <span>@OperatorLabels.Humanise(role.ToString())</span>
                            </label>
                        }
                    </fieldset>
                    @if (row.IsCurrentOperator)
                    {
                        <p class="muted">You cannot change your own roles.</p>
                    }
                    else
                    {
                        <div class="field">
                            <label class="req" for="@roleReason">@OperatorLabels.StaffAccounts.Reason</label>
                            <textarea id="@roleReason" name="reason" rows="3" required maxlength="@reasonLimit">@roleReasonValue</textarea>
                        </div>
                        <div class="button-row"><button type="submit" class="btn btn--primary">Save roles</button></div>
                    }
                </form>

                @if (account.Roles.Contains(StaffRole.Engineer))
                {
                    var usePostedValues = Model.SignOffPostStaffId == account.Id;
                    var isSignOffEngineer = usePostedValues ? Model.SignOffPostIsEnabled : account.SignOff.IsSignOffEngineer;
                    var printedName = usePostedValues ? Model.SignOffPostPrintedName : account.SignOff.PrintedName;
                    var qualifications = usePostedValues ? Model.SignOffPostQualifications : account.SignOff.Qualifications;
                    var isDefault = usePostedValues ? Model.SignOffPostIsDefault : account.SignOff.IsDefault;
                    <form method="post" asp-page-handler="SignOff" enctype="multipart/form-data" class="stack section-gap">
                        <input type="hidden" name="staffId" value="@staffId" />
                        <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                        <h3>Sign-off Engineer</h3>
                        <div class="field">
                            <label for="@settingsId-sign-off-enabled">@OperatorLabels.StaffAccounts.SignOffEngineer</label>
                            <select id="@settingsId-sign-off-enabled" name="isSignOffEngineer" data-dialog-initial-focus>
                                <option value="false" selected="@(!isSignOffEngineer)">@OperatorLabels.StaffAccounts.No</option>
                                <option value="true" selected="@isSignOffEngineer">@OperatorLabels.StaffAccounts.Yes</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="@settingsId-sign-off-name">@OperatorLabels.StaffAccounts.PrintedName</label>
                            <input id="@settingsId-sign-off-name" name="printedName" value="@printedName" maxlength="@StaffAccountAdministrationPolicy.MaximumSignOffPrintedNameLength" />
                        </div>
                        <div class="field">
                            <label for="@settingsId-sign-off-qualifications">@OperatorLabels.StaffAccounts.Qualifications</label>
                            <input id="@settingsId-sign-off-qualifications" name="qualifications" value="@qualifications" maxlength="@StaffAccountAdministrationPolicy.MaximumSignOffQualificationsLength" />
                        </div>
                        <div class="field">
                            <span class="label">@OperatorLabels.StaffAccounts.SignatureImage</span>
                            <span class="value">@(account.SignOff.HasSignature ? OperatorLabels.StaffAccounts.OnFile : OperatorLabels.StaffAccounts.NotOnFile)</span>
                            <label for="@settingsId-sign-off-signature">@(account.SignOff.HasSignature ? OperatorLabels.StaffAccounts.ReplaceSignature : OperatorLabels.StaffAccounts.UploadSignature)</label>
                            <input id="@settingsId-sign-off-signature" name="signature" type="file" accept="@SignOffSignaturePolicy.MediaType" />
                        </div>
                        <label class="choice" for="@settingsId-sign-off-default">
                            <input id="@settingsId-sign-off-default" name="isDefault" type="checkbox" value="true" checked="@isDefault" />
                            <span>@OperatorLabels.StaffAccounts.DefaultSignOffEngineer</span>
                        </label>
                        <div class="field">
                            <label class="req" for="@settingsId-sign-off-reason">@OperatorLabels.StaffAccounts.Reason</label>
                            <textarea id="@settingsId-sign-off-reason" name="reason" rows="3" required maxlength="@reasonLimit">@(usePostedValues ? Model.SignOffPostReason : string.Empty)</textarea>
                        </div>
                        <div class="button-row"><button type="submit" class="btn btn--primary">@OperatorLabels.StaffAccounts.Save</button></div>
                    </form>
                }

                @if (!row.IsCurrentOperator)
                {
                    <section class="section-gap" aria-labelledby="@settingsId-actions-title">
                        <h3 id="@settingsId-actions-title">Account actions</h3>
                        <div class="button-row">
                            @if (account.Roles.Contains(StaffRole.Engineer))
                            {
                                <a asp-page="/Administration/Glass/Index" asp-route-staffId="@account.Id" class="btn">Glass's</a>
                            }
                            @if (account.IsEnabled)
                            {
                                <a asp-page="/Administration/Accounts/Confirm" asp-route-operation="Disable" asp-route-staffId="@account.Id" class="btn btn--danger">Disable</a>
                                <a asp-page="/Administration/Accounts/Confirm" asp-route-operation="ForceLogout" asp-route-staffId="@account.Id" class="btn">Force logout</a>
                                <a asp-page="/Administration/Accounts/Confirm" asp-route-operation="ResetPassword" asp-route-staffId="@account.Id" class="btn">Reset password</a>
                            }
                            else
                            {
                                <a asp-page="/Administration/Accounts/Confirm" asp-route-operation="Enable" asp-route-staffId="@account.Id" class="btn">Enable</a>
                            }
                            <a asp-page="/Administration/Accounts/Confirm" asp-route-operation="Delete" asp-route-staffId="@account.Id" class="btn btn--danger">Delete</a>
                        </div>
                    </section>
                }
            </div>
            <div class="dialog-foot"><button type="button" class="btn" data-dialog-close>@OperatorLabels.StaffAccounts.CloseDialog</button></div>
        </section>
    </div>
}
