@page
@using Pegasus.Core.Identity
@model Pegasus.Web.Pages.Administration.Accounts.IndexModel
@{
    ViewData["Title"] = OperatorLabels.Admin.Accounts;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "accounts";
    ViewData["AdminAutomationComposed"] = Model.AutomationComposed;
}

<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        @if (!Model.CreatePostSubmitted && Model.SettingsRow is null && Model.GlassAccount is null)
        {
            <partial name="Shared/_ErrorSummary" />
        }
        <section class="panel" aria-labelledby="staff-accounts-title">
            <div class="panel-head">
                <div>
                    <h2 id="staff-accounts-title">Staff accounts</h2>
                    <p class="panel-title-meta">@Model.Rows.Count@(Model.HasMoreAccounts ? "+" : string.Empty) accounts</p>
                </div>
                <button type="button" class="btn btn--primary" data-dialog-open="create-account-dialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg><span>Create staff account</span>
                </button>
            </div>
            @if (Model.Rows.Count == 0)
            {
                <div class="empty"><h2>No staff accounts.</h2></div>
            }
            else
            {
                <div class="table-wrap no-border">
                    <table>
                        <caption class="sr-only">Staff accounts</caption>
                        <thead><tr><th scope="col">Username</th><th scope="col">Role</th><th scope="col">Sign-off</th><th scope="col">Glass's</th><th scope="col">State</th><th scope="col"><span class="sr-only">@OperatorLabels.StaffAccounts.Settings</span></th></tr></thead>
                        <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var account = row.Account;
                            <tr>
                                <td class="mono">@account.UserName</td>
                                <td>@OperatorLabels.Humanise(account.Role.ToString())</td>
                                <td>@OperatorLabels.StaffAccounts.SignOffState(account)</td>
                                <td data-account-glass="@account.Id">
                                    <span class="cluster">
                                        <span class="@(row.Glass is { Configured: true } ? "mono" : "muted")">@row.GlassLabel</span>
                                        <a class="link-button" asp-page="Index" asp-route-glassStaffId="@account.Id">Manage login</a>
                                    </span>
                                </td>
                                <td>
                                    <partial name="Shared/_StatusChip" model="@OperatorLabels.StaffAccounts.State(account.IsEnabled)" />
                                    @if (account.MustChangePassword)
                                    { <partial name="Shared/_StatusChip" model="@OperatorLabels.StaffAccounts.PasswordChangeRequired" view-data="@(new ViewDataDictionary(ViewData) { ["StatusTone"] = "amber" })" /> }
                                </td>
                                <td class="right">
                                    <span class="cluster">
                                        <a class="btn btn--small" asp-page="Index" asp-route-editStaffId="@account.Id" asp-route-expectedVersion="@account.Version">@OperatorLabels.StaffAccounts.Settings</a>
                                    </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

@if (Model.ResetTemporaryPassword is { } temporaryPassword)
{
    <section class="panel" aria-labelledby="temporary-password-title"><div class="panel-head"><h2 id="temporary-password-title">Temporary password</h2></div><div class="panel-body stack"><p>Give this to the account holder. It is shown only for this response and must be changed at first sign-in.</p><output class="mono">@temporaryPassword</output></div></section>
}

<div class="dialog-backdrop" data-dialog="create-account-dialog" data-dialog-open-on-load="@(Model.CreatePostSubmitted ? "true" : "false")" hidden="@(!Model.CreatePostSubmitted)">
    <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="create-account-title">
        <div class="dialog-head"><h2 id="create-account-title" tabindex="-1" data-dialog-initial-focus>Create staff account</h2><button type="button" class="dialog-close" data-dialog-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button></div>
        <form method="post" asp-page-handler="Create">
            <input type="hidden" name="operationKey" value="@Model.CreateOperationKey" />
            <div class="dialog-body stack">
                @if (Model.CreatePostSubmitted) { <partial name="Shared/_ErrorSummary" /> }
                <div class="field"><label class="req" for="create-username">Username</label><input id="create-username" name="userName" value="@Model.NewUserName" required maxlength="@StaffAccountAdministrationPolicy.MaximumUserNameLength" autocomplete="off" /></div>
                <div class="field"><label class="req" for="create-password">Temporary password</label><input id="create-password" name="temporaryPassword" type="password" required minlength="@StaffAccountAdministrationPolicy.MinimumPasswordLength" maxlength="@StaffAccountAdministrationPolicy.MaximumPasswordLength" autocomplete="new-password" /></div>
            </div>
            <div class="dialog-foot"><button type="button" class="btn" data-dialog-close>@OperatorLabels.StaffAccounts.Cancel</button><button type="submit" class="btn btn--primary">Create staff account</button></div>
        </form>
    </section>
</div>

@if (Model.SettingsRow is not null)
{
    var row = Model.SettingsRow;
    var account = row.Account;
    var staffId = account.Id.ToString("D");
    var settingsId = "settings-" + staffId;
    <div class="dialog-backdrop" data-dialog="@settingsId" data-dialog-open-on-load="true">
        <section class="dialog dialog--wide account-settings-dialog" role="dialog" aria-modal="true" aria-labelledby="@settingsId-title">
            <div class="dialog-head"><h2 id="@settingsId-title" tabindex="-1" data-dialog-initial-focus>@account.UserName</h2><button type="button" class="dialog-close" data-dialog-close data-account-settings-cancel aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button></div>
            <form method="post" asp-page-handler="Settings" enctype="multipart/form-data" data-account-settings>
                <input type="hidden" name="staffId" value="@staffId" /><input type="hidden" name="expectedVersion" value="@Model.SettingsPostVersion" /><input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                <div class="dialog-body stack">
                    <partial name="Shared/_ErrorSummary" />
                    <dl class="fact-grid account-settings-facts"><div class="fact"><dt>Username</dt><dd class="mono">@account.UserName</dd></div><div class="fact"><dt>State</dt><dd>@OperatorLabels.StaffAccounts.State(account.IsEnabled)</dd></div></dl>
                    <div class="account-signoff-fields">
                        <div class="field"><label for="@settingsId-role">Role</label><select id="@settingsId-role" name="role" data-account-role disabled="@row.IsCurrentOperator">@foreach (var role in Enum.GetValues<StaffRole>()) { <option value="@role" selected="@(Model.SettingsPostRole == role)">@OperatorLabels.Humanise(role.ToString())</option> }</select>@if (row.IsCurrentOperator) { <input type="hidden" name="role" value="@Model.SettingsPostRole" /> }</div>
                        <div class="field"><label for="@settingsId-signoff">@OperatorLabels.StaffAccounts.SignOffEngineer</label><select id="@settingsId-signoff" name="isSignOffEngineer" data-account-signoff><option value="false" selected="@(!Model.SettingsPostIsSignOffEngineer)">No</option><option value="true" selected="@Model.SettingsPostIsSignOffEngineer">Yes</option></select></div>
                        <div class="field" data-account-signoff-field><label for="@settingsId-name">@OperatorLabels.StaffAccounts.PrintedName</label><input id="@settingsId-name" name="printedName" value="@Model.SettingsPostPrintedName" maxlength="@StaffAccountAdministrationPolicy.MaximumSignOffPrintedNameLength" /></div>
                        <div class="field" data-account-signoff-field><label for="@settingsId-qualifications">@OperatorLabels.StaffAccounts.Qualifications</label><input id="@settingsId-qualifications" name="qualifications" value="@Model.SettingsPostQualifications" maxlength="@StaffAccountAdministrationPolicy.MaximumSignOffQualificationsLength" /></div>
                    </div>
                    <section class="account-settings-section" aria-labelledby="@settingsId-glass-title"><div class="settings-line"><div><strong id="@settingsId-glass-title">Glass's repair estimates</strong><span class="meta">Manage this account's login.</span></div><a class="btn" asp-page="Index" asp-route-glassStaffId="@account.Id" data-account-glass-login>Manage login</a></div></section>
                    <div class="field" data-account-signoff-field><label for="@settingsId-signature">@(account.SignOff.HasSignature ? OperatorLabels.StaffAccounts.ReplaceSignature : OperatorLabels.StaffAccounts.SignatureImage)</label><input id="@settingsId-signature" name="signature" type="file" accept="@SignOffSignaturePolicy.MediaType" /></div>
                    <label class="choice" for="@settingsId-default" data-account-signoff-field><input id="@settingsId-default" name="isDefaultSignOffEngineer" type="checkbox" value="true" checked="@Model.SettingsPostIsDefault" data-account-default /><span>@OperatorLabels.StaffAccounts.DefaultSignOffEngineer</span></label>
                </div>
                <div class="dialog-foot"><button type="button" class="btn" data-dialog-close data-account-settings-cancel>@OperatorLabels.StaffAccounts.Cancel</button><button type="submit" class="btn btn--primary">Save settings</button></div>
            </form>
            @if (!row.IsCurrentOperator)
            {
                @* Each action posts on its click with no reason to type. Delete
                   alone confirms first: the row is removed, not disabled. *@
                var adverse = new[] { (account.IsEnabled ? "Disable" : "Enable", account.IsEnabled ? "btn btn--danger" : "btn") };
                var routine = account.IsEnabled ? new[] { ("ForceLogout", "Force logout"), ("ResetPassword", "Reset password") } : [];
                <div class="dialog-foot">
                    <div class="left">
                        @foreach (var (handler, buttonClass) in adverse)
                        {
                            <form method="post" asp-page-handler="@handler"><input type="hidden" name="staffId" value="@staffId" /><input type="hidden" name="expectedVersion" value="@Model.SettingsPostVersion" /><input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" /><button type="submit" class="@buttonClass">@handler</button></form>
                        }
                        <button type="button" class="btn btn--danger" data-dialog-open="@settingsId-delete">Delete</button>
                    </div>
                    @foreach (var (handler, label) in routine)
                    {
                        <form method="post" asp-page-handler="@handler"><input type="hidden" name="staffId" value="@staffId" /><input type="hidden" name="expectedVersion" value="@Model.SettingsPostVersion" /><input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" /><button type="submit" class="btn">@label</button></form>
                    }
                </div>
            }
        </section>
    </div>
    @if (!row.IsCurrentOperator)
    {
        <dialog id="@settingsId-delete" aria-labelledby="@settingsId-delete-title">
            <form method="post" asp-page-handler="Delete" class="stack">
                <h2 id="@settingsId-delete-title" tabindex="-1" data-dialog-initial-focus>Delete @account.UserName</h2>
                <input type="hidden" name="staffId" value="@staffId" /><input type="hidden" name="expectedVersion" value="@Model.SettingsPostVersion" /><input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                <div class="button-row"><button class="btn" type="button" data-dialog-close>@OperatorLabels.StaffAccounts.Cancel</button><button type="submit" class="btn btn--danger">Delete</button></div>
            </form>
        </dialog>
    }

}

@if (Model.GlassAccount is { } glassAccount && Model.GlassStatus is { } glassStatus)
{
    <div class="dialog-backdrop" data-dialog="glass-credential-dialog" data-dialog-open-on-load="true" data-dialog-cancel-form="glass-close-form">
        <section class="dialog dialog--compact glass-credential-dialog" role="dialog" aria-modal="true" aria-labelledby="glass-credential-title">
            <div class="dialog-head">
                <h2 id="glass-credential-title">Glass's login</h2>
                <partial name="Shared/_StatusChip" model="@Model.GlassStateName" />
                <form id="glass-close-form" method="get" asp-page="Index"><input type="hidden" name="editStaffId" value="@glassAccount.Id" /><input type="hidden" name="expectedVersion" value="@glassAccount.Version" /></form>
                <button type="submit" form="glass-close-form" class="dialog-close" aria-label="Back to account"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
            </div>
            <div class="dialog-body stack">
                <partial name="Shared/_ErrorSummary" />
                <dl class="detail-list credentials-summary">
                    <div>
                        <dt>@CaseWorkspaceLabels.GlassCredential.Account</dt>
                        <dd>@glassAccount.UserName</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(glassStatus.Username))
                    {
                        <div>
                            <dt>@CaseWorkspaceLabels.GlassCredential.Username</dt>
                            <dd>@glassStatus.Username</dd>
                        </div>
                    }
                    @if (glassStatus.Configured)
                    {
                        <div>
                            <dt>@CaseWorkspaceLabels.GlassCredential.Generation</dt>
                            <dd class="tabular">@glassStatus.CredentialGeneration</dd>
                        </div>
                        <div>
                            <dt>@CaseWorkspaceLabels.GlassCredential.Version</dt>
                            <dd class="tabular">@glassStatus.Version</dd>
                        </div>
                    }
                    @if (glassStatus.UpdatedAtUtc is { } updatedAtUtc)
                    {
                        <div>
                            <dt>@CaseWorkspaceLabels.GlassCredential.Updated</dt>
                            <dd>
                                <time datetime="@updatedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(updatedAtUtc)</time>
                            </dd>
                        </div>
                    }
                </dl>
                <form id="glass-save-form" method="post" asp-page-handler="SaveGlass" class="stack">
                    <input type="hidden" name="staffId" value="@glassAccount.Id" />
                    <input type="hidden" name="ExpectedVersion" value="@Model.GlassExpectedVersion" />
                    <input type="hidden" name="ExpectedStaffAccountVersion" value="@Model.GlassExpectedStaffAccountVersion" />
                    <fieldset class="stack">
                    <div class="field">
                        <label class="req" for="glass-username">@CaseWorkspaceLabels.GlassCredential.Username</label>
                        <input id="glass-username" name="username" required maxlength="256"
                               autocomplete="off" value="@Model.GlassUsername" />
                    </div>
                    @* No tag helper and no value attribute: the submitted secret
                       is never written back into this field. *@
                    <div class="field">
                        <label class="req" for="glass-password">@CaseWorkspaceLabels.GlassCredential.Password</label>
                        <input id="glass-password" name="password" type="password" required
                               maxlength="256" autocomplete="new-password" />
                    </div>
                    </fieldset>
                </form>
            </div>
            <div class="dialog-foot">
                @if (glassStatus.Configured)
                {
                    <div class="left"><form method="post" asp-page-handler="ClearGlass"><input type="hidden" name="staffId" value="@glassAccount.Id" /><input type="hidden" name="ExpectedVersion" value="@Model.GlassExpectedVersion" /><input type="hidden" name="ExpectedStaffAccountVersion" value="@Model.GlassExpectedStaffAccountVersion" /><button type="submit" class="btn btn--danger">@CaseWorkspaceLabels.GlassCredential.Clear</button></form></div>
                }
                <button type="submit" form="glass-close-form" class="btn">Back to account</button>
                <button type="submit" form="glass-save-form" class="btn btn--primary"><svg class="icon" aria-hidden="true"><use href="#icon-save" /></svg><span>@CaseWorkspaceLabels.GlassCredential.Save</span></button>
            </div>
        </section>
    </div>
}

@section Scripts {
    <script src="~/js/accounts.js" asp-append-version="true"></script>
}
