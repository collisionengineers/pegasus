@page
@model Pegasus.Web.Pages.Administration.Accounts.IndexModel
@{
    ViewData["Title"] = "Staff accounts";
    ViewData["Eyebrow"] = "Administration";
}

<a class="back-link" asp-page="/Administration/Index">
    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
    Back to Administration
</a>

<partial name="Shared/_PageHeader" />

@if (TempData["AdministrationStatus"] is string status)
{
    <div class="status-card" role="status">@status</div>
}

<div class="split-main">
    <section aria-labelledby="current-accounts-heading">
        <h2 id="current-accounts-heading" class="section-label">Current accounts</h2>
        @if (Model.Accounts.Count == 0)
        {
            <div class="panel empty-state">No staff accounts are available. Application initialization must complete before ordinary administration can begin.</div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <caption class="vh">Staff accounts and their current access</caption>
                    <thead>
                        <tr>
                            <th scope="col">Username</th>
                            <th scope="col">Status</th>
                            <th scope="col">Roles</th>
                            <th scope="col">First password change</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var account in Model.Accounts)
                    {
                        <tr>
                            <td>@account.UserName</td>
                            <td><partial name="Shared/_StatusChip" model="@(account.IsEnabled ? "Enabled" : "Disabled")" /></td>
                            <td>@string.Join(", ", account.Roles)</td>
                            <td>@(account.MustChangePassword ? "Required" : "Complete")</td>
                            <td><a asp-page="Edit" asp-route-id="@account.Id">Manage</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section aria-labelledby="create-account-heading">
        <h2 id="create-account-heading" class="section-label">Create staff account</h2>
        <div class="panel form-panel form-panel--wide">
            <form method="post" asp-page-handler="Create">
                <div asp-validation-summary="ModelOnly"></div>
                <input asp-for="OperationKey" type="hidden" />
                <div>
                    <label asp-for="UserName">Username</label>
                    <input asp-for="UserName" autocomplete="off" />
                    <span asp-validation-for="UserName"></span>
                </div>
                <div>
                    <label asp-for="TemporaryPassword">Temporary password</label>
                    <input asp-for="TemporaryPassword" autocomplete="new-password" />
                    <span asp-validation-for="TemporaryPassword"></span>
                    <small class="empty-state">At least eight characters. The staff member must replace it at first sign-in.</small>
                </div>
                <div>
                    <label asp-for="Reason">Reason</label>
                    <textarea asp-for="Reason" rows="3"></textarea>
                    <span asp-validation-for="Reason"></span>
                </div>
                <div class="button-row">
                    <button type="submit" class="primary-action">Create account</button>
                </div>
            </form>
        </div>
    </section>
</div>
