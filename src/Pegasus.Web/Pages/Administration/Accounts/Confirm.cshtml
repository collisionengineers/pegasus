@page "{operation}/{staffId:guid}"
@model Pegasus.Web.Pages.Administration.Accounts.ConfirmModel
@using Pegasus.Core.Identity
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
}

<partial name="Shared/_PageHeader" />

<a class="back-link" asp-page="/Administration/Accounts/Index">Back to staff accounts</a>

<section class="panel" aria-labelledby="account-action-title">
    <div class="panel-head">
        <h2 id="account-action-title">@Model.Heading</h2>
    </div>
    <div class="panel-body">
        <dl class="detail-list"><div><dt>Account</dt><dd>@Model.Account!.UserName</dd></div></dl>
        <div class="notice notice--warning">
            <span>@(Model.Operation switch
                {
                    "Disable" => OperatorLabels.StaffAccounts.DisableConsequence,
                    "Delete" => "This permanently removes the account's active access and credentials. It does not delete any Case.",
                    "ForceLogout" => "Existing browser sessions will be revoked. Open Case edit holds are not cleared.",
                    "ResetPassword" => "A temporary password will be generated and shown once. The account must change it at next sign-in.",
                    "Enable" => "The account will be able to sign in again.",
                    _ => "The Case edit hold will be cleared. The holder must reload before saving further changes."
                })</span>
        </div>
        <form method="post" asp-page="/Administration/Accounts/Index"
              asp-page-handler="@Model.HandlerName" class="stack">
            <input type="hidden" name="staffId" value="@Model.StaffId" />
            <input type="hidden" name="operationKey" value="@Model.OperationKey" />
            @if (Model.Operation == "ClearLease")
            {
                <input type="hidden" name="caseId" value="@Model.CaseId" />
                <input type="hidden" name="expectedLeaseGeneration" value="@Model.LeaseGeneration" />
            }
            <div class="field field--narrow">
                <label class="req" for="confirm-reason">@OperatorLabels.StaffAccounts.Reason</label>
                <textarea id="confirm-reason" name="reason" rows="3" required
                          maxlength="@StaffAccountAdministrationPolicy.MaximumReasonLength"></textarea>
            </div>
            <div>
                <button type="submit" class="btn btn--primary">
                    <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                    <span>@OperatorLabels.StaffAccounts.Confirm</span>
                </button>
            </div>
        </form>
    </div>
</section>

@if (Model.Operation != "ClearLease" && Model.Leases.Count > 0)
{
    <section class="panel" aria-labelledby="held-case-edits-title">
        <div class="panel-head"><h2 id="held-case-edits-title">Open case edits</h2></div>
        <div class="panel-body"><ul class="accepted-list">
        @foreach (var lease in Model.Leases)
        {
            <li>@lease.CaseReference <a asp-page="/Administration/Accounts/Confirm" asp-route-operation="ClearLease" asp-route-staffId="@Model.StaffId" asp-route-caseId="@lease.CaseId" asp-route-leaseGeneration="@lease.LeaseGeneration">Clear</a></li>
        }
        </ul></div>
    </section>
}
