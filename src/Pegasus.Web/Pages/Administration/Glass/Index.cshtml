@page "/Administration/Glass/{staffId:guid}"
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Administration.Glass.IndexModel
@{
    ViewData["Title"] = CaseWorkspaceLabels.GlassCredential.Title;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "accounts";
    ViewData["AdminAutomationComposed"] = Model.AutomationComposed;
}

<partial name="Shared/_PageHeader" />

@* Defensive only: the handler returns 404 when the account is absent, so the
   not-found surface is owned by the error page. *@
@if (Model.Account is { } account && Model.Status is { } status)
{
    <div class="dialog-backdrop" data-dialog="glass-credential-dialog" data-dialog-open-on-load="true" data-dialog-cancel-form="glass-close-form">
        <section class="dialog dialog--compact glass-credential-dialog" role="dialog" aria-modal="true" aria-labelledby="glass-credential-title">
            <div class="dialog-head">
                <h2 id="glass-credential-title">Glass's login</h2>
                <partial name="Shared/_StatusChip" model="@Model.StateName" />
                @if (Model.IsEditing)
                {
                    <form id="glass-close-form" method="post" asp-page-handler="CancelEdit"><input type="hidden" name="staffId" value="@account.Id" /><input type="hidden" name="editLeaseToken" value="@Model.EditLeaseToken" /><input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" /></form>
                }
                else
                {
                    <form id="glass-close-form" method="get" asp-page="/Administration/Accounts/Index"><input type="hidden" name="editStaffId" value="@account.Id" /><input type="hidden" name="expectedVersion" value="@account.Version" /></form>
                }
                <button type="submit" form="glass-close-form" class="dialog-close" aria-label="Back to account"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button>
            </div>
            <div class="dialog-body stack">
                <partial name="Shared/_ErrorSummary" />
                <dl class="detail-list credentials-summary">
                    <div>
                        <dt>@CaseWorkspaceLabels.GlassCredential.Account</dt>
                        <dd>@account.UserName</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(status.Username))
                    {
                        <div>
                            <dt>@CaseWorkspaceLabels.GlassCredential.Username</dt>
                            <dd>@status.Username</dd>
                        </div>
                    }
                    @if (status.Configured)
                    {
                        <div>
                            <dt>@CaseWorkspaceLabels.GlassCredential.Generation</dt>
                            <dd class="tabular">@status.CredentialGeneration</dd>
                        </div>
                        <div>
                            <dt>@CaseWorkspaceLabels.GlassCredential.Version</dt>
                            <dd class="tabular">@status.Version</dd>
                        </div>
                    }
                    @if (status.UpdatedAtUtc is { } updatedAtUtc)
                    {
                        <div>
                            <dt>@CaseWorkspaceLabels.GlassCredential.Updated</dt>
                            <dd>
                                <time datetime="@updatedAtUtc.ToString("O")">@OperatorLabels.OfficeTime(updatedAtUtc)</time>
                            </dd>
                        </div>
                    }
                </dl>
                <form id="glass-save-form" method="post" asp-page-handler="Save" class="stack">
                    @* Plain, not asp-for: a redisplay must carry the version the
                       store holds now, never the stale one the refused post sent. *@
                    <input type="hidden" name="ExpectedVersion" value="@status.Version" />
                    <input type="hidden" name="ExpectedStaffAccountVersion" value="@account.Version" />
                    <input type="hidden" name="EditLeaseToken" value="@Model.EditLeaseToken" />
                    <fieldset class="stack" disabled="@(!Model.IsEditing)">
                    <div class="field">
                        <label class="req" for="glass-username">@CaseWorkspaceLabels.GlassCredential.Username</label>
                        <input id="glass-username" name="username" required maxlength="256"
                               autocomplete="off" value="@Model.Username" />
                    </div>
                    @* No tag helper and no value attribute: the submitted secret
                       is never written back into this field. *@
                    <div class="field">
                        <label class="req" for="glass-password">@CaseWorkspaceLabels.GlassCredential.Password</label>
                        <input id="glass-password" name="password" type="password" required
                               maxlength="256" autocomplete="new-password" />
                    </div>
                    </fieldset>
                </form>
            </div>
            <div class="dialog-foot">
                @if (status.Configured)
                {
                    <div class="left"><button type="button" class="btn btn--danger" data-dialog-open="glass-clear-confirm" disabled="@(!Model.IsEditing)">@CaseWorkspaceLabels.GlassCredential.Clear</button></div>
                }
                @if (Model.IsEditing)
                {
                    <button type="submit" form="glass-close-form" class="btn">Cancel</button>
                    <button type="submit" form="glass-save-form" class="btn btn--primary"><svg class="icon" aria-hidden="true"><use href="#icon-save" /></svg><span>@CaseWorkspaceLabels.GlassCredential.Save</span></button>
                }
                else
                {
                    @* Offered only to the operator whose own other window still
                       holds this staff account's scope; taking over rotates the
                       token so that window can no longer save. *@
                    if (Model.CanTakeOverEdit)
                    {
                        <form method="post" asp-page-handler="Edit">
                            <input type="hidden" name="staffId" value="@account.Id" />
                            <input type="hidden" name="expectedStaffAccountVersion" value="@account.Version" />
                            <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                            <input type="hidden" name="takeOver" value="true" />
                            <button type="submit" class="btn btn--primary">Take over</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Edit">
                            <input type="hidden" name="staffId" value="@account.Id" />
                            <input type="hidden" name="expectedStaffAccountVersion" value="@account.Version" />
                            <input type="hidden" name="operationKey" value="@IndexModel.NewOperationKey()" />
                            <button type="submit" class="btn btn--primary">Edit credential</button>
                        </form>
                    }
                    <button type="submit" form="glass-close-form" class="btn">Back to account</button>
                }
            </div>
            @if (Model.IsEditing)
            {
                <form method="post" asp-page-handler="HeartbeatEdit" data-edit-heartbeat data-edit-heartbeat-status="glass-credential-edit-heartbeat-status" hidden>
                    <input type="hidden" name="staffId" value="@account.Id" />
                    <input type="hidden" name="editLeaseToken" value="@Model.EditLeaseToken" />
                </form>
                <p id="glass-credential-edit-heartbeat-status" class="notice notice--error" role="alert" hidden></p>
                @* Beaconed as the page unloads so an operator who navigates away
                   is not refused by their own lease when they come back. *@
                <form method="post" asp-page-handler="ReleaseScopeBeacon" data-edit-scope-release hidden>
                    <input type="hidden" name="staffId" value="@account.Id" />
                    <input type="hidden" name="editLeaseToken" value="@Model.EditLeaseToken" />
                </form>
            }
        </section>
    </div>
    @if (status.Configured)
    {
        <div class="dialog-backdrop" data-dialog="glass-clear-confirm" hidden>
            <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="glass-clear-confirm-title">
                <div class="dialog-head"><h2 id="glass-clear-confirm-title">Clear Glass's login?</h2><button type="button" class="dialog-close" data-dialog-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg></button></div>
                <form method="post" asp-page-handler="Clear"><input type="hidden" name="ExpectedVersion" value="@status.Version" /><input type="hidden" name="ExpectedStaffAccountVersion" value="@account.Version" /><input type="hidden" name="EditLeaseToken" value="@Model.EditLeaseToken" /><div class="dialog-body"><dl class="detail-list"><div><dt>@CaseWorkspaceLabels.GlassCredential.Account</dt><dd>@account.UserName</dd></div></dl></div><div class="dialog-foot"><button type="button" class="btn" data-dialog-close>Cancel</button><button type="submit" class="btn btn--danger">@CaseWorkspaceLabels.GlassCredential.Clear</button></div></form>
            </section>
        </div>
    }
}
