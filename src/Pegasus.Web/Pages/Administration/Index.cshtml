@page
@model Pegasus.Web.Pages.Administration.IndexModel
@{
    ViewData["Title"] = OperatorLabels.Nav.Administration;
}

<partial name="Shared/_PageHeader" />

@* The cards are the hub's navigation, so the side navigation is not repeated here (v41 A1). *@
<div class="stack admin-content">
    <section class="panel" aria-labelledby="admin-identity-title">
        <div class="panel-head"><h2 id="admin-identity-title">People and access</h2></div>
        <div class="panel-body">
            <div class="admin-grid">
                <a class="admin-card" asp-page="/Administration/Accounts/Index">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-user")" /></svg>
                    <h3>@OperatorLabels.Admin.Accounts</h3>
                </a>
                <a class="admin-card" asp-page="/Administration/Contacts/Index">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-shield")" /></svg>
                    <h3>Contacts</h3>
                </a>
            </div>
        </div>
    </section>

    <section class="panel" aria-labelledby="admin-configuration-title">
        <div class="panel-head"><h2 id="admin-configuration-title">Configuration</h2></div>
        <div class="panel-body">
            <div class="admin-grid">
                <a class="admin-card" asp-page="/Administration/Configuration">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-settings")" /></svg>
                    <h3>@OperatorLabels.Admin.Configuration</h3>
                </a>
                <a class="admin-card" asp-page="/Administration/Mailboxes">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-mail")" /></svg>
                    <h3>@OperatorLabels.Admin.Mail</h3>
                </a>
                <a class="admin-card" asp-page="/Administration/EmailTemplates/Index">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-mail-open")" /></svg>
                    <h3>@OperatorLabels.EmailTemplates.Area</h3>
                </a>
                <a class="admin-card" asp-page="/Administration/ValuationPresets/Index">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-pound-sterling")" /></svg>
                    <h3>@OperatorLabels.Admin.ValuationPresets</h3>
                </a>
            </div>
        </div>
    </section>

    <section class="panel" aria-labelledby="admin-oversight-title">
        <div class="panel-head"><h2 id="admin-oversight-title">Operations and oversight</h2></div>
        <div class="panel-body">
            <div class="admin-grid">
                <a class="admin-card" asp-page="/Administration/Health">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-heart-pulse")" /></svg>
                    <h3>@OperatorLabels.Admin.Health</h3>
                </a>
                <a class="admin-card" asp-page="/Administration/Logs">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-scroll-text")" /></svg>
                    <h3>@OperatorLabels.IntakeLog.Logs</h3>
                </a>
                <a class="admin-card" asp-page="/Administration/Reports">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-bar-chart")" /></svg>
                    <h3>@OperatorLabels.Admin.Reports</h3>
                </a>
                <a class="admin-card" asp-page="/Administration/ReleaseNotes/Index">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-flag")" /></svg>
                    <h3>@OperatorLabels.Admin.ReleaseNotes</h3>
                </a>
                <a class="admin-card" asp-page="/Administration/ProblemReports">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-alert-triangle")" /></svg>
                    <h3>@OperatorLabels.Admin.ProblemReports</h3>
                </a>
                <a class="admin-card" asp-page="/Administration/Automation/Index">
                    <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-bot")" /></svg>
                    <h3>@OperatorLabels.Admin.Automation</h3>
                </a>
            </div>
        </div>
    </section>
</div>
