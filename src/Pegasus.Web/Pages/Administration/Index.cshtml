@page
@model Pegasus.Web.Pages.Administration.IndexModel
@{
    ViewData["Title"] = "Administration";
    ViewData["Lede"] = "Manage staff access, organizations, principals, workflow configuration, and approved mailbox routes through authenticated, permanently recorded administration callers.";
}

<partial name="Shared/_PageHeader" />

<div class="admin-workspaces">
    <section class="admin-card">
        <span class="admin-card__icon" aria-hidden="true"><svg class="icon icon--lg"><use href="#icon-user" /></svg></span>
        <div>
            <h2><a asp-page="/Administration/Accounts/Index">Staff accounts</a></h2>
            <p>Create staff accounts, permanently disable access, and require a password change at first sign-in.</p>
        </div>
    </section>
    <section class="admin-card">
        <span class="admin-card__icon" aria-hidden="true"><svg class="icon icon--lg"><use href="#icon-shield" /></svg></span>
        <div>
            <h2><a asp-page="/Administration/Roles/Index">Staff roles</a></h2>
            <p>Assign the Administrator, Engineer, and User roles without allowing the final enabled Administrator to be removed.</p>
        </div>
    </section>
    <section class="admin-card">
        <span class="admin-card__icon" aria-hidden="true"><svg class="icon icon--lg"><use href="#icon-check-circle" /></svg></span>
        <div>
            <h2><a asp-page="/Administration/Access/Index">Access review</a></h2>
            <p>Review current staff access and record an attributable review decision.</p>
        </div>
    </section>
    <section class="admin-card">
        <span class="admin-card__icon" aria-hidden="true"><svg class="icon icon--lg"><use href="#icon-file-text" /></svg></span>
        <div>
            <h2><a asp-page="/Administration/Organizations/Index">Organizations</a></h2>
            <p>Manage independently selectable Work Provider and Instruction Intermediary roles.</p>
        </div>
    </section>
    <section class="admin-card">
        <span class="admin-card__icon" aria-hidden="true"><svg class="icon icon--lg"><use href="#icon-lock" /></svg></span>
        <div>
            <h2><a asp-page="/Administration/Principals/Index">Principals</a></h2>
            <p>Create immutable principal identities and replace them through a linked, sequence-preserving successor.</p>
        </div>
    </section>
    <section class="admin-card">
        <span class="admin-card__icon" aria-hidden="true"><svg class="icon icon--lg"><use href="#icon-filter" /></svg></span>
        <div>
            <h2><a asp-page="/Administration/Configuration">Workflow configuration</a></h2>
            <p>Manage the versioned completeness and staff-review gates required before Engineer assignment.</p>
        </div>
    </section>
    <section class="admin-card">
        <span class="admin-card__icon" aria-hidden="true"><svg class="icon icon--lg"><use href="#icon-info" /></svg></span>
        <div>
            <h2><a asp-page="/Administration/Mailboxes">Approved mailboxes</a></h2>
            <p>Approve mailbox addresses for the fixed inbound Intake and exact Sent-evidence routes.</p>
        </div>
    </section>
    @* A capability a deployment has not composed is absent. The Automation
       ingress gate is set in no shipped configuration, so this card led to a
       page that could only ever say "not composed in this deployment". *@
    @if (Model.AutomationComposed)
    {
        <section class="admin-card">
            <span class="admin-card__icon" aria-hidden="true"><svg class="icon icon--lg"><use href="#icon-refresh-cw" /></svg></span>
            <div>
                <h2><a asp-page="/Administration/Automation/Index">Automation</a></h2>
                <p>Its recorded activity, and its client registration.</p>
            </div>
        </section>
    }
</div>
