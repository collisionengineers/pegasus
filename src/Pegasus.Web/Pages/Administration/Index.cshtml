@page
@model Pegasus.Web.Pages.Administration.IndexModel
@{
    ViewData["Title"] = OperatorLabels.Nav.Administration;
    ViewData["AdminAutomationComposed"] = Model.AutomationComposed;
}

<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <section class="panel" aria-labelledby="admin-areas-title">
        <div class="panel-head"><h2 id="admin-areas-title">Areas</h2></div>
        <div class="panel-body">
            <div class="admin-grid">
                <a class="admin-card" asp-page="/Administration/Accounts/Index">
                    <svg class="icon" aria-hidden="true"><use href="#icon-user" /></svg>
                    <h3>@OperatorLabels.Admin.Accounts</h3>
                </a>
                <a class="admin-card" asp-page="/Administration/Principals/Index">
                    <svg class="icon" aria-hidden="true"><use href="#icon-shield" /></svg>
                    <h3>@OperatorLabels.Admin.Principals</h3>
                </a>
                <a class="admin-card" asp-page="/Administration/Configuration">
                    <svg class="icon" aria-hidden="true"><use href="#icon-settings" /></svg>
                    <h3>@OperatorLabels.Admin.Configuration</h3>
                </a>
                <a class="admin-card" asp-page="/Administration/Mailboxes">
                    <svg class="icon" aria-hidden="true"><use href="#icon-mail" /></svg>
                    <h3>@OperatorLabels.Admin.Mail</h3>
                </a>
                @* Organisations stays reachable from the landing until PLAT-028
                   folds it into Principals (D2); it is not in the area rail. *@
                <a class="admin-card" asp-page="/Administration/Organizations/Index">
                    <svg class="icon" aria-hidden="true"><use href="#icon-folder" /></svg>
                    <h3>Organisations</h3>
                </a>
                @* A capability a deployment has not composed is absent. *@
                @if (Model.AutomationComposed)
                {
                    <a class="admin-card" asp-page="/Administration/Automation/Index">
                        <svg class="icon" aria-hidden="true"><use href="#icon-sparkles" /></svg>
                        <h3>@OperatorLabels.Admin.Automation</h3>
                    </a>
                }
            </div>
        </div>
    </section>
</div>
