@page
@model Pegasus.Web.Pages.Administration.Principals.CreateModel
@using Pegasus.Core.Cases
@{
    ViewData["Title"] = "Create principal";
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "principals";
}

<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <section class="panel" aria-labelledby="create-principal-title">
        <div class="panel-head"><h2 id="create-principal-title">@OperatorLabels.PrincipalAdministration.Create</h2></div>
        <form method="post" asp-page-handler="Create" class="panel-body stack">
            <div asp-validation-summary="ModelOnly"></div>
            <input asp-for="OperationKey" type="hidden" />
            <div class="field">
                <label class="req" asp-for="Name">@OperatorLabels.PrincipalAdministration.Name</label>
                <input asp-for="Name" autocomplete="organization" />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="field">
                <label class="req" asp-for="Code">@OperatorLabels.PrincipalAdministration.Code</label>
                <input asp-for="Code" autocomplete="off" />
                <span asp-validation-for="Code"></span>
            </div>
            <div class="field">
                <label asp-for="InspectionMode">Inspection mode</label>
                <select asp-for="InspectionMode">
                    <option value="@CaseInspectionMode.PhysicalAddress">Physical address</option>
                    <option value="@CaseInspectionMode.ImageBasedAssessment">Image Based Assessment</option>
                </select>
                <span asp-validation-for="InspectionMode"></span>
            </div>
            <label class="choice"><input asp-for="EvaManualSubmission" /> <span>Manual EVA API submission</span></label>
            <div class="button-row">
                <a class="btn" asp-page="Index">Cancel</a>
                <button type="submit" class="btn btn--primary">@OperatorLabels.PrincipalAdministration.Create</button>
            </div>
        </form>
    </section>
</div>
