@page
@model Pegasus.Web.Pages.Administration.Principals.IndexModel
@{
    ViewData["Title"] = OperatorLabels.Admin.Principals;
}
<div class="page-heading">
    <h1>@OperatorLabels.Admin.Principals</h1>
    <a class="btn btn--primary" asp-page="Create">@OperatorLabels.PrincipalAdministration.Create</a>
</div>
@if (TempData["AdministrationStatus"] is string status)
{
    <div class="status-card" role="status">@status</div>
}
<div class="table-wrap">
    <table>
        <caption class="vh">@OperatorLabels.Admin.Principals</caption>
        <thead><tr>
            <th scope="col">@OperatorLabels.PrincipalAdministration.Name</th>
            <th scope="col">@OperatorLabels.PrincipalAdministration.Code</th>
            <th scope="col">@OperatorLabels.PrincipalAdministration.State</th>
            <th scope="col">@OperatorLabels.PrincipalAdministration.Settings</th>
        </tr></thead>
        <tbody>
        @foreach (var customer in Model.Customers.Principals)
        {
            <tr>
                <td>@customer.Name</td>
                <td>@customer.Principal.Code</td>
                <td><partial name="Shared/_StatusChip" model="@(customer.Principal.IsActive ? "Active" : "Disabled")" /></td>
                <td><a asp-page="Settings" asp-route-principalId="@customer.Principal.Id">@OperatorLabels.PrincipalAdministration.Settings</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (Model.PageNumber > 1 || Model.Customers.HasMore)
{
    <nav class="pager" aria-label="@OperatorLabels.Admin.Principals">
        @if (Model.PageNumber > 1)
        {
            <a asp-page="Index" asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a>
        }
        <span class="pager__context">Page @Model.PageNumber</span>
        @if (Model.Customers.HasMore)
        {
            <a asp-page="Index" asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
        }
    </nav>
}
