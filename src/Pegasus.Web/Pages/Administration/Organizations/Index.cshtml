@page
@model Pegasus.Web.Pages.Administration.Organizations.IndexModel
@using Pegasus.Core.Cases
@{
    ViewData["Title"] = "Organizations";
    ViewData["Eyebrow"] = "Administration";
    ViewData["Lede"] = "Organization roles are independent. A Work Provider can own principals; an Instruction Intermediary can route work without becoming the principal.";
}

<a class="back-link" asp-page="/Administration/Index">
    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
    Back to Administration
</a>

<partial name="Shared/_PageHeader" />

@if (TempData["AdministrationStatus"] is string status)
{
    <div class="status-card" role="status">@status</div>
}

<div class="split-main">
    <section aria-labelledby="current-organizations-heading">
        <h2 id="current-organizations-heading" class="section-label">Current organizations</h2>
        @if (Model.Organizations.Organizations.Count == 0)
        {
            <div class="panel empty-state">No organizations are available on this page.</div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <caption class="vh">Organizations and their independently selectable roles</caption>
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Roles</th>
                            <th scope="col">Active principals</th>
                            <th scope="col">Version</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var organization in Model.Organizations.Organizations)
                    {
                        <tr>
                            <td>@organization.Name</td>
                            <td>@string.Join(", ", organization.Roles.Select(role => role == OrganizationRole.WorkProvider ? "Work Provider" : "Instruction Intermediary"))</td>
                            <td>
                                <span class="tabular">@organization.Principals.Count(principal => principal.IsActive)</span>
                                @if (organization.HasMorePrincipals)
                                {
                                    <small class="empty-state">Bounded view; more exist</small>
                                }
                            </td>
                            <td class="tabular">@organization.Version</td>
                            <td>
                                <span class="action-list">
                                    <a asp-page="Edit" asp-route-id="@organization.Id">Manage roles</a>
                                    @if (organization.Roles.Contains(OrganizationRole.WorkProvider))
                                    {
                                        <a asp-page="/Administration/Principals/Create"
                                           asp-route-organizationId="@organization.Id">Create principal</a>
                                    }
                                </span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <nav class="pager" aria-label="Organization pages">
            @if (Model.Organizations.HasPreviousPage)
            {
                <a asp-page="Index" asp-route-pageNumber="@(Model.Organizations.PageNumber - 1)">Previous</a>
            }
            <span class="pager__context">Page @Model.Organizations.PageNumber</span>
            @if (Model.Organizations.HasMoreOrganizations)
            {
                <a asp-page="Index" asp-route-pageNumber="@(Model.Organizations.PageNumber + 1)">Next</a>
            }
        </nav>
    </section>

    <section aria-labelledby="create-organization-heading">
        <h2 id="create-organization-heading" class="section-label">Create organization</h2>
        <div class="panel form-panel form-panel--wide">
            <form method="post" asp-page-handler="Create">
                <div asp-validation-summary="ModelOnly"></div>
                <input asp-for="OperationKey" type="hidden" />
                <div>
                    <label asp-for="OrganizationName">Organization name</label>
                    <input asp-for="OrganizationName" autocomplete="organization" />
                    <span asp-validation-for="OrganizationName"></span>
                </div>
                <fieldset class="role-choices role-choices--stacked">
                    <legend>Organization roles</legend>
                    <label class="choice"><input asp-for="WorkProvider" /> <span>Work Provider</span></label>
                    <label class="choice"><input asp-for="InstructionIntermediary" /> <span>Instruction Intermediary</span></label>
                </fieldset>
                <div class="button-row">
                    <button type="submit" class="primary-action">Create organization</button>
                </div>
            </form>
        </div>
    </section>
</div>
