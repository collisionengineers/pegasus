@page
@model Pegasus.Web.Pages.Administration.ReleaseNotes.IndexModel
@{
    ViewData["Title"] = OperatorLabels.Admin.ReleaseNotes;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "release-notes";
}
<partial name="Shared/_PageHeader" />
<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        <section class="panel" aria-label="@OperatorLabels.Admin.ReleaseNotes">
            <div class="panel-head">
                <div class="panel-actions">
                    <a class="btn btn--small btn--primary" asp-page="/Administration/ReleaseNotes/Edit">
                        <svg class="icon" aria-hidden="true"><use href="@IconSprite.Href("icon-plus")" /></svg>
                        <span>@OperatorLabels.ReleaseNotes.New</span>
                    </a>
                </div>
            </div>
            @if (Model.Notes.Count == 0)
            {
                <div class="empty"><p>@OperatorLabels.ReleaseNotes.None</p></div>
            }
            else
            {
            <div class="table-wrap no-border">
                <table class="table table--compact" data-release-notes>
                    <caption class="sr-only">@OperatorLabels.Admin.ReleaseNotes</caption>
                    <thead>
                        <tr>
                            <th scope="col">@OperatorLabels.ReleaseNotes.Title</th>
                            <th scope="col">@OperatorLabels.ReleaseNotes.Status</th>
                            <th scope="col">@OperatorLabels.ReleaseNotes.Version</th>
                            <th scope="col">@OperatorLabels.ReleaseNotes.Published</th>
                            <th scope="col">@OperatorLabels.ReleaseNotes.PublishedBy</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var note in Model.Notes)
                    {
                        <tr data-release-note="@note.Id">
                            <td><a asp-page="/Administration/ReleaseNotes/Edit" asp-route-id="@note.Id">@note.Title</a></td>
                            <td><partial name="Shared/_StatusChip" model="@OperatorLabels.ReleaseNoteStatus(note.Status)" /></td>
                            <td class="mono">@(note.Version ?? "—")</td>
                            <td>@OperatorLabels.OfficeTime(note.PublishedAtUtc, "—")</td>
                            <td>@Model.PublishedBy(note)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            }
        </section>
    </div>
</div>
