@page
@model Pegasus.Web.Pages.Administration.ReleaseNotes.IndexModel
@{
    ViewData["Title"] = OperatorLabels.Admin.ReleaseNotes;
    ViewData["Eyebrow"] = "Administration";
    ViewData["AdminArea"] = "release-notes";
}
<partial name="Shared/_PageHeader" />
<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        @if (TempData["Confirmation"] is string confirmation)
        {
            <div class="notice notice--success" role="status">@confirmation</div>
        }
        <section class="panel" aria-labelledby="release-notes-title">
            <div class="panel-head">
                <h2 id="release-notes-title">@OperatorLabels.Admin.ReleaseNotes</h2>
                <div class="panel-actions">
                    <a class="btn btn--small btn--primary" asp-page="/Administration/ReleaseNotes/Edit">
                        <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                        <span>@OperatorLabels.ReleaseNotes.New</span>
                    </a>
                </div>
            </div>
            <div class="table-wrap no-border">
                <table class="table table--compact" data-release-notes>
                    <caption class="sr-only">@OperatorLabels.Admin.ReleaseNotes</caption>
                    <thead>
                        <tr>
                            <th scope="col">Title</th>
                            <th scope="col">Status</th>
                            <th scope="col">Version</th>
                            <th scope="col">Published</th>
                            <th scope="col">Published by</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var note in Model.Notes)
                    {
                        <tr data-release-note="@note.Id">
                            <td><a asp-page="/Administration/ReleaseNotes/Edit" asp-route-id="@note.Id">@note.Title</a></td>
                            <td><partial name="Shared/_StatusChip" model="@OperatorLabels.ReleaseNoteStatus(note.Status)" /></td>
                            <td class="mono">@(note.Version ?? OperatorLabels.CaseWorkspace.AbsentValue)</td>
                            <td>@OperatorLabels.OfficeTime(note.PublishedAtUtc, OperatorLabels.CaseWorkspace.AbsentValue)</td>
                            <td>@Model.PublishedBy(note)</td>
                        </tr>
                    }
                    @if (Model.Notes.Count == 0)
                    {
                        <tr><td colspan="5" class="muted">@OperatorLabels.ReleaseNotes.None</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
