@page
@using Pegasus.Core.Identity
@using Pegasus.Core.Intake
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Administration.MailboxesModel
@{
    ViewData["Title"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "mail";
    ViewData["AdminAutomationComposed"] = Model.AutomationComposed;
}

<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <section class="panel" aria-labelledby="mail-settings-title">
        <div class="panel-head">
            <div>
                <h2 id="mail-settings-title">@OperatorLabels.Admin.Mail</h2>
                <div class="muted">@OperatorLabels.MailSettings.Description</div>
                <div class="panel-title-meta">
                    @OperatorLabels.MailSettings.Meta(Model.Mailboxes.Count, Model.Categories.Count)
                </div>
            </div>
        </div>
        <div class="panel-body stack">
            @if (TempData["AdministrationStatus"] is string status)
            {
                <div class="notice notice--success" role="status">
                    <svg class="icon" aria-hidden="true"><use href="#icon-check-circle" /></svg>
                    <span>@status</span>
                </div>
            }

            <div asp-validation-summary="All"></div>

            <section aria-labelledby="approved-mailboxes-title">
                <div class="cluster cluster--between">
                    <h3 id="approved-mailboxes-title">@OperatorLabels.MailSettings.ApprovedMailboxes</h3>
                    <a href="https://github.com/collisionengineers/pegasus/blob/dev/docs/runbook.md#approved-mailbox-estate">Mailbox setup</a>
                </div>
                <div class="table-wrap no-border">
                    <table>
                        <caption class="sr-only">@OperatorLabels.MailSettings.ApprovedMailboxes</caption>
                        <thead>
                            <tr>
                                <th scope="col">@OperatorLabels.MailSettings.Mailbox</th>
                                <th scope="col">@OperatorLabels.MailSettings.Scope</th>
                                <th scope="col">@OperatorLabels.MailSettings.LastUpdate</th>
                                <th scope="col">@OperatorLabels.MailSettings.State</th>
                                <th scope="col">@OperatorLabels.MailSettings.Activated</th>
                                <th scope="col">@OperatorLabels.MailSettings.Subscription</th>
                                <th scope="col">@OperatorLabels.MailSettings.ReviewFoldersRefresh</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.Mailboxes.Count == 0)
                        {
                            <tr>
                                <td colspan="7">@OperatorLabels.MailSettings.NoApprovedMailboxes</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var mailbox in Model.Mailboxes)
                            {
                                var addressId = $"mailbox-address-{mailbox.Id}";
                                var reasonId = $"mailbox-reason-{mailbox.Id}";
                                var stateId = $"mailbox-state-{mailbox.Id}";
                                var reviewFolders = OperatorLabels.MailSettings.ReviewFoldersProgress(
                                    mailbox.FolderBindings.Count,
                                    MailLogicalFolders.All.Count);
                                <tr>
                                    <td>@mailbox.Address</td>
                                    <td>@string.Join(", ", mailbox.RouteScopes.Select(OperatorLabels.RouteScope))</td>
                                    <td>
                                        @Model.PollStatusFor(mailbox)
                                        @if (Model.PollStatusForMailbox(mailbox) is { } poll)
                                        {
                                            <details>
                                                <summary class="btn btn--small">Health</summary>
                                                <dl class="definition-list">
                                                    <dt>Start boundary</dt><dd>@OperatorLabels.OfficeTime(poll.StartBoundaryUtc, "Not recorded")</dd>
                                                    <dt>Generation</dt><dd>@poll.Generation</dd>
                                                    <dt>Last success</dt><dd>@OperatorLabels.OfficeTime(poll.LastCompletedAtUtc, "Not yet polled")</dd>
                                                    <dt>Last error</dt><dd>@(poll.LastFailureCode ?? "None")</dd>
                                                    <dt>Freshness</dt><dd>@Model.PollFreshnessFor(poll)</dd>
                                                    <dt>Subscription expiry</dt><dd>@OperatorLabels.OfficeTime(poll.SubscriptionExpiresAtUtc, "None")</dd>
                                                    <dt>Capabilities</dt><dd>@string.Join(", ", (poll.Capabilities ?? mailbox.RouteScopes).Select(OperatorLabels.RouteScope))</dd>
                                                </dl>
                                            </details>
                                        }
                                    </td>
                                    <td>
                                        <partial name="Shared/_StatusChip"
                                                 model="@OperatorLabels.MailSettings.MailboxState(mailbox.State)" />
                                    </td>
                                    <td>@OperatorLabels.OfficeTime(mailbox.ActivatedAtUtc, OperatorLabels.MailSettings.NotActivated)</td>
                                    <td>@Model.SubscriptionStatusFor(mailbox)</td>
                                    <td>
                                        <details>
                                            <summary class="btn btn--small">@reviewFolders</summary>
                                            <div class="stack section-gap">
                                                <div class="definition-list">
                                                    @foreach (var folder in MailLogicalFolders.All)
                                                    {
                                                        var configured = mailbox.FolderBindings.Any(
                                                            item => item.FolderType == folder.Type);
                                                        <dl class="definition">
                                                            <dt>@folder.Label</dt>
                                                            <dd>@OperatorLabels.MailSettings.FolderState(configured)</dd>
                                                        </dl>
                                                    }
                                                </div>
                                                <form method="post" asp-page-handler="Update" class="stack">
                                                    <input type="hidden" name="MailboxForm.MailboxId" value="@mailbox.Id" />
                                                    <input type="hidden" name="MailboxForm.ExpectedVersion" value="@mailbox.Version" />
                                                    <input type="hidden" name="MailboxForm.OperationKey" value="@Model.OperationKeyFor(mailbox)" />
                                                    <div class="field">
                                                        <label class="req" for="@addressId">@OperatorLabels.MailSettings.ApprovedAddress</label>
                                                        <input id="@addressId" name="MailboxForm.Address" value="@Model.AddressFor(mailbox)"
                                                               required maxlength="320" inputmode="email" readonly="@(mailbox.IdentityIsBound && mailbox.State != ApprovedMailboxState.Disabled)" />
                                                    </div>
                                                    <fieldset class="stack">
                                                        <legend>@OperatorLabels.MailSettings.RouteScope</legend>
                                                        <label class="cluster">
                                                            <input type="checkbox" name="MailboxForm.SelectedRouteScopes"
                                                                   value="InboundIntake"
                                                                   checked="@Model.IsRouteSelected(mailbox, ApprovedMailboxRouteScope.InboundIntake)" />
                                                            <span>@OperatorLabels.RouteScope(ApprovedMailboxRouteScope.InboundIntake)</span>
                                                        </label>
                                                        <label class="cluster">
                                                            <input type="checkbox" name="MailboxForm.SelectedRouteScopes"
                                                                   value="SentEvidence"
                                                                   checked="@Model.IsRouteSelected(mailbox, ApprovedMailboxRouteScope.SentEvidence)" />
                                                            <span>@OperatorLabels.RouteScope(ApprovedMailboxRouteScope.SentEvidence)</span>
                                                        </label>
                                                        <label class="cluster">
                                                            <input type="checkbox" name="MailboxForm.SelectedRouteScopes"
                                                                   value="StaffSend"
                                                                   checked="@Model.IsRouteSelected(mailbox, ApprovedMailboxRouteScope.StaffSend)" />
                                                            <span>Staff send</span>
                                                        </label>
                                                    </fieldset>
                                                    <div class="field">
                                                        <label for="mailbox-send-limit-@mailbox.Id">Verified encoded-message size limit (bytes)</label>
                                                        <input id="mailbox-send-limit-@mailbox.Id" name="MailboxForm.VerifiedEncodedMessageSizeLimit"
                                                               value="@Model.VerifiedSendLimitFor(mailbox)" type="number" min="1" step="1" />
                                                    </div>
                                                    <div class="field">
                                                        <label for="@stateId">@OperatorLabels.MailSettings.State</label>
                                                        <select id="@stateId" name="MailboxForm.SelectedState">
                                                            <option value="Approved" selected="@Model.IsStateSelected(mailbox, ApprovedMailboxState.Approved)">@OperatorLabels.MailSettings.MailboxState(ApprovedMailboxState.Approved)</option>
                                                            <option value="Disabled" selected="@Model.IsStateSelected(mailbox, ApprovedMailboxState.Disabled)">@OperatorLabels.MailSettings.MailboxState(ApprovedMailboxState.Disabled)</option>
                                                        </select>
                                                    </div>
                                                    <div class="field">
                                                        <label class="req" for="@reasonId">@OperatorLabels.MailSettings.Reason</label>
                                                        <input id="@reasonId" name="MailboxForm.Reason" value="@Model.ReasonFor(mailbox)"
                                                               required maxlength="1000" />
                                                    </div>
                                                    <button type="submit" class="btn btn--dark">
                                                        @OperatorLabels.MailSettings.SaveMailbox
                                                    </button>
                                                </form>
                                                @if (mailbox.IdentityIsBound)
                                                {
                                                    <form method="post" asp-page-handler="ResolveFolders">
                                                        <input type="hidden" name="MailboxForm.MailboxId" value="@mailbox.Id" />
                                                        <input type="hidden" name="MailboxForm.ExpectedVersion" value="@mailbox.Version" />
                                                        <input type="hidden" name="MailboxForm.OperationKey" value="@StaffPageModel.NewOperationKey()" />
                                                        <input type="hidden" name="MailboxForm.Address" value="@mailbox.Address" />
                                                        <input type="hidden" name="MailboxForm.SelectedState" value="@mailbox.State" />
                                                        <input type="hidden" name="MailboxForm.Reason" value="Refresh approved logical folder bindings" />
                                                        <button type="submit" class="btn btn--small">
                                                            <svg class="icon" aria-hidden="true"><use href="#icon-refresh-cw" /></svg>
                                                            <span>@OperatorLabels.MailSettings.Refresh</span>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </details>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>

                <details class="section-gap">
                    <summary class="btn btn--dark">
                        <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                        <span>@OperatorLabels.MailSettings.AddMailbox</span>
                    </summary>
                    <form method="post" asp-page-handler="Update" class="grid grid-2 section-gap">
                        <input type="hidden" name="MailboxForm.MailboxId" value="@Model.NewMailboxId" />
                        <input type="hidden" name="MailboxForm.ExpectedVersion" value="0" />
                        <input type="hidden" name="MailboxForm.OperationKey" value="@Model.NewMailboxOperationKey" />
                        <div class="field">
                            <label class="req" for="new-mailbox-address">@OperatorLabels.MailSettings.ApprovedAddress</label>
                            <input id="new-mailbox-address" name="MailboxForm.Address" value="@Model.NewAddress"
                                   required maxlength="320" inputmode="email" />
                        </div>
                        <fieldset class="stack">
                            <legend>@OperatorLabels.MailSettings.RouteScope</legend>
                            <label class="cluster">
                                <input type="checkbox" name="MailboxForm.SelectedRouteScopes" value="InboundIntake"
                                       checked="@Model.IsNewRouteSelected(ApprovedMailboxRouteScope.InboundIntake)" />
                                <span>@OperatorLabels.RouteScope(ApprovedMailboxRouteScope.InboundIntake)</span>
                            </label>
                            <label class="cluster">
                                <input type="checkbox" name="MailboxForm.SelectedRouteScopes" value="SentEvidence"
                                       checked="@Model.IsNewRouteSelected(ApprovedMailboxRouteScope.SentEvidence)" />
                                <span>@OperatorLabels.RouteScope(ApprovedMailboxRouteScope.SentEvidence)</span>
                            </label>
                            <label class="cluster">
                                <input type="checkbox" name="MailboxForm.SelectedRouteScopes" value="StaffSend"
                                       checked="@Model.IsNewRouteSelected(ApprovedMailboxRouteScope.StaffSend)" />
                                <span>Staff send</span>
                            </label>
                        </fieldset>
                        <div class="field">
                            <label for="new-mailbox-send-limit">Verified encoded-message size limit (bytes)</label>
                            <input id="new-mailbox-send-limit" name="MailboxForm.VerifiedEncodedMessageSizeLimit"
                                   value="@Model.NewVerifiedSendLimit" type="number" min="1" step="1" />
                        </div>
                        <div class="field">
                            <label for="new-mailbox-state">@OperatorLabels.MailSettings.State</label>
                            <select id="new-mailbox-state" name="MailboxForm.SelectedState">
                                <option value="Approved" selected="@Model.IsNewStateSelected(ApprovedMailboxState.Approved)">@OperatorLabels.MailSettings.MailboxState(ApprovedMailboxState.Approved)</option>
                                <option value="Disabled" selected="@Model.IsNewStateSelected(ApprovedMailboxState.Disabled)">@OperatorLabels.MailSettings.MailboxState(ApprovedMailboxState.Disabled)</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="req" for="new-mailbox-reason">@OperatorLabels.MailSettings.Reason</label>
                            <input id="new-mailbox-reason" name="MailboxForm.Reason" value="@Model.NewReason"
                                   required maxlength="1000" />
                        </div>
                        <div class="button-row">
                            <button type="submit" class="btn btn--primary">
                                @OperatorLabels.MailSettings.AddMailbox
                            </button>
                        </div>
                    </form>
                </details>
            </section>

            <section class="section-gap" aria-labelledby="mail-categories-title">
                <h3 id="mail-categories-title">@OperatorLabels.MailSettings.MailCategories</h3>
                <div class="table-wrap no-border">
                    <table>
                        <caption class="sr-only">@OperatorLabels.MailSettings.MailCategories</caption>
                        <thead>
                            <tr>
                                <th scope="col">@OperatorLabels.MailSettings.Category</th>
                                <th scope="col">@OperatorLabels.MailSettings.State</th>
                                <th scope="col">@OperatorLabels.MailSettings.Review</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.Categories.Count == 0)
                        {
                            <tr>
                                <td colspan="3">@OperatorLabels.MailSettings.NoMailCategories</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var category in Model.Categories)
                            {
                                var displayNameId = $"category-display-name-{category.Id}";
                                var reasonId = $"category-reason-{category.Id}";
                                var stateId = $"category-state-{category.Id}";
                                <tr>
                                    <td>@category.DisplayName</td>
                                    <td>
                                        <partial name="Shared/_StatusChip"
                                                 model="@OperatorLabels.MailSettings.CategoryState(category.State)" />
                                    </td>
                                    <td>
                                        <details>
                                            <summary class="btn btn--small">@OperatorLabels.MailSettings.Review</summary>
                                            <form method="post" asp-page-handler="SaveCategory" class="stack section-gap">
                                                <input type="hidden" name="CategoryForm.CategoryId" value="@category.Id" />
                                                <input type="hidden" name="CategoryForm.ExpectedVersion" value="@category.Version" />
                                                <input type="hidden" name="CategoryForm.OperationKey" value="@Model.CategoryOperationKeyFor(category)" />
                                                <div class="field">
                                                    <label class="req" for="@displayNameId">@OperatorLabels.MailSettings.DisplayName</label>
                                                    <input id="@displayNameId" name="CategoryForm.DisplayName"
                                                           value="@Model.CategoryDisplayNameFor(category)" required maxlength="255" />
                                                </div>
                                                <div class="field">
                                                    <label for="@stateId">@OperatorLabels.MailSettings.State</label>
                                                    <select id="@stateId" name="CategoryForm.SelectedState">
                                                        <option value="Active" selected="@Model.IsCategoryStateSelected(category, ApprovedOutlookCategoryState.Active)">@OperatorLabels.MailSettings.CategoryState(ApprovedOutlookCategoryState.Active)</option>
                                                        <option value="Disabled" selected="@Model.IsCategoryStateSelected(category, ApprovedOutlookCategoryState.Disabled)">@OperatorLabels.MailSettings.CategoryState(ApprovedOutlookCategoryState.Disabled)</option>
                                                    </select>
                                                </div>
                                                <div class="field">
                                                    <label class="req" for="@reasonId">@OperatorLabels.MailSettings.Reason</label>
                                                    <input id="@reasonId" name="CategoryForm.Reason"
                                                           value="@Model.CategoryReasonFor(category)" required maxlength="1000" />
                                                </div>
                                                <button type="submit" class="btn btn--dark">
                                                    @OperatorLabels.MailSettings.SaveCategory
                                                </button>
                                            </form>
                                        </details>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>

                <details class="section-gap">
                    <summary class="btn btn--dark">
                        <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                        <span>@OperatorLabels.MailSettings.AddCategory</span>
                    </summary>
                    <form method="post" asp-page-handler="SaveCategory" class="grid grid-2 section-gap">
                        <input type="hidden" name="CategoryForm.CategoryId" value="@Model.NewCategoryId" />
                        <input type="hidden" name="CategoryForm.ExpectedVersion" value="0" />
                        <input type="hidden" name="CategoryForm.OperationKey" value="@Model.NewCategoryOperationKey" />
                        <div class="field">
                            <label class="req" for="new-category-display-name">@OperatorLabels.MailSettings.DisplayName</label>
                            <input id="new-category-display-name" name="CategoryForm.DisplayName"
                                   value="@Model.NewCategoryDisplayName" required maxlength="255" />
                        </div>
                        <div class="field">
                            <label for="new-category-state">@OperatorLabels.MailSettings.State</label>
                            <select id="new-category-state" name="CategoryForm.SelectedState">
                                <option value="Active" selected="@Model.IsNewCategoryStateSelected(ApprovedOutlookCategoryState.Active)">@OperatorLabels.MailSettings.CategoryState(ApprovedOutlookCategoryState.Active)</option>
                                <option value="Disabled" selected="@Model.IsNewCategoryStateSelected(ApprovedOutlookCategoryState.Disabled)">@OperatorLabels.MailSettings.CategoryState(ApprovedOutlookCategoryState.Disabled)</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="req" for="new-category-reason">@OperatorLabels.MailSettings.Reason</label>
                            <input id="new-category-reason" name="CategoryForm.Reason"
                                   value="@Model.NewCategoryReason" required maxlength="1000" />
                        </div>
                        <div class="button-row">
                            <button type="submit" class="btn btn--primary">
                                @OperatorLabels.MailSettings.AddCategory
                            </button>
                        </div>
                    </form>
                </details>
            </section>
        </div>
    </section>
</div>
