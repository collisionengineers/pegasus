@page
@using Pegasus.Core.Identity
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Administration.MailboxesModel
@{
    ViewData["Title"] = OperatorLabels.Admin.Mail;
    ViewData["Eyebrow"] = OperatorLabels.Nav.Administration;
    ViewData["AdminArea"] = "mail";
    ViewData["AdminAutomationComposed"] = Model.AutomationComposed;
}

<partial name="Shared/_PageHeader" />

<div class="admin-layout">
    <partial name="Shared/_AdminNav" />
    <div class="stack">
        @if (TempData["AdministrationStatus"] is string status)
        {
            <div class="notice notice--success" role="status">
                <svg class="icon" aria-hidden="true"><use href="#icon-check-circle" /></svg>
                <span>@status</span>
            </div>
        }
        <partial name="Shared/_ErrorSummary" />

        <section class="panel" aria-labelledby="approved-mailboxes-title">
            <div class="panel-head">
                <h2 id="approved-mailboxes-title">@OperatorLabels.MailSettings.ApprovedMailboxes</h2>
                <button type="button" class="btn btn--small btn--dark" data-dialog-open="new-mailbox-dialog">
                    <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                    <span>@OperatorLabels.MailSettings.AddMailbox</span>
                </button>
            </div>
            <div class="table-wrap no-border">
                <table class="table table--compact mailbox-table">
                    <caption class="sr-only">@OperatorLabels.MailSettings.ApprovedMailboxes</caption>
                    <thead>
                        <tr>
                            <th scope="col">@OperatorLabels.MailSettings.Mailbox</th>
                            <th scope="col">@OperatorLabels.MailSettings.RouteScope</th>
                            <th scope="col">Last checked</th>
                            <th scope="col">@OperatorLabels.MailSettings.State</th>
                            <th scope="col"><span class="sr-only">Settings</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Mailboxes.Count == 0)
                    {
                        <tr><td colspan="5">@OperatorLabels.MailSettings.NoApprovedMailboxes</td></tr>
                    }
                    else
                    {
                        @foreach (var mailbox in Model.Mailboxes)
                        {
                            <tr>
                                <td><strong>@mailbox.Address</strong></td>
                                <td>@string.Join(", ", mailbox.RouteScopes.Select(OperatorLabels.RouteScope))</td>
                                <td class="nowrap">@Model.PollStatusFor(mailbox)</td>
                                <td><partial name="Shared/_StatusChip" model="@OperatorLabels.MailSettings.MailboxState(mailbox.State)" /></td>
                                <td>
                                    <a class="btn btn--small" asp-page="./Mailboxes" asp-route-mailboxId="@mailbox.Id" asp-route-expectedVersion="@mailbox.Version">Settings</a>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<div class="dialog-backdrop" data-dialog="new-mailbox-dialog"
     data-dialog-open-on-load="@(Model.IsNewMailboxEditorOpen ? "true" : null)"
     hidden="@(Model.IsNewMailboxEditorOpen ? null : "hidden")">
    <section class="dialog dialog--compact" role="dialog" aria-modal="true" aria-labelledby="new-mailbox-dialog-title">
        <form method="post" asp-page-handler="Update">
            <div class="dialog-head"><h2 id="new-mailbox-dialog-title" tabindex="-1">@OperatorLabels.MailSettings.AddMailbox</h2><button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">×</button></div>
            <div class="dialog-body">
                <partial name="Shared/_ErrorSummary" />
                <input type="hidden" name="MailboxForm.MailboxId" value="@Model.NewMailboxId" /><input type="hidden" name="MailboxForm.ExpectedVersion" value="0" /><input type="hidden" name="MailboxForm.OperationKey" value="@Model.NewMailboxOperationKey" />
                <div class="field"><label class="req" for="new-mailbox-address">@OperatorLabels.MailSettings.ApprovedAddress</label><input id="new-mailbox-address" name="MailboxForm.Address" value="@Model.NewAddress" required maxlength="320" inputmode="email" /></div>
                <fieldset class="stack"><legend>@OperatorLabels.MailSettings.RouteScope</legend><label class="cluster"><input type="checkbox" name="MailboxForm.SelectedRouteScopes" value="Incoming" checked="@Model.IsNewRouteSelected(ApprovedMailboxRouteScope.Incoming)" /><span>@OperatorLabels.RouteScope(ApprovedMailboxRouteScope.Incoming)</span></label><label class="cluster"><input type="checkbox" name="MailboxForm.SelectedRouteScopes" value="Outgoing" checked="@Model.IsNewRouteSelected(ApprovedMailboxRouteScope.Outgoing)" /><span>@OperatorLabels.RouteScope(ApprovedMailboxRouteScope.Outgoing)</span></label></fieldset>
                <div class="field"><label for="new-mailbox-state">@OperatorLabels.MailSettings.State</label><select id="new-mailbox-state" name="MailboxForm.SelectedState"><option value="Approved" selected="@Model.IsNewStateSelected(ApprovedMailboxState.Approved)">@OperatorLabels.MailSettings.MailboxState(ApprovedMailboxState.Approved)</option><option value="Disabled" selected="@Model.IsNewStateSelected(ApprovedMailboxState.Disabled)">@OperatorLabels.MailSettings.MailboxState(ApprovedMailboxState.Disabled)</option></select></div>
            </div>
            <div class="dialog-foot"><button type="button" class="btn" data-dialog-close>Cancel</button><button type="submit" class="btn btn--primary" data-busy-label="@OperatorLabels.Busy.Adding">@OperatorLabels.MailSettings.AddMailbox</button></div>
        </form>
    </section>
</div>

@foreach (var mailbox in Model.Mailboxes.Where(Model.IsEditingMailbox))
{
    var addressId = $"mailbox-address-{mailbox.Id}";
    var stateId = $"mailbox-state-{mailbox.Id}";
    var dialogId = $"mailbox-settings-{mailbox.Id}";
    <div class="dialog-backdrop" data-dialog="@dialogId" data-dialog-open-on-load="true">
        <section class="dialog dialog--contact" role="dialog" aria-modal="true" aria-labelledby="@dialogId-title">
            <form id="mailbox-settings-form-@mailbox.Id" method="post" asp-page-handler="Update">
                <div class="dialog-head"><h2 id="@dialogId-title" tabindex="-1">Mailbox settings</h2><button type="reset" class="dialog-close" data-dialog-close aria-label="Close dialog">×</button></div>
                <div class="dialog-body stack">
                    <partial name="Shared/_ErrorSummary" />
                    <input type="hidden" name="MailboxForm.MailboxId" value="@mailbox.Id" /><input type="hidden" name="MailboxForm.ExpectedVersion" value="@Model.ExpectedVersionFor(mailbox)" /><input type="hidden" name="MailboxForm.OperationKey" value="@Model.OperationKeyFor(mailbox)" />
                    <div class="field"><label class="req" for="@addressId">@OperatorLabels.MailSettings.ApprovedAddress</label><input id="@addressId" name="MailboxForm.Address" value="@Model.AddressFor(mailbox)" required maxlength="320" inputmode="email" readonly="@(mailbox.IdentityIsBound && mailbox.State != ApprovedMailboxState.Disabled)" /></div>
                    <fieldset class="stack"><legend>@OperatorLabels.MailSettings.RouteScope</legend><label class="cluster"><input type="checkbox" name="MailboxForm.SelectedRouteScopes" value="Incoming" checked="@Model.IsRouteSelected(mailbox, ApprovedMailboxRouteScope.Incoming)" /><span>@OperatorLabels.RouteScope(ApprovedMailboxRouteScope.Incoming)</span></label><label class="cluster"><input type="checkbox" name="MailboxForm.SelectedRouteScopes" value="Outgoing" checked="@Model.IsRouteSelected(mailbox, ApprovedMailboxRouteScope.Outgoing)" /><span>@OperatorLabels.RouteScope(ApprovedMailboxRouteScope.Outgoing)</span></label></fieldset>
                    <div class="field"><label for="@stateId">@OperatorLabels.MailSettings.State</label><select id="@stateId" name="MailboxForm.SelectedState"><option value="Approved" selected="@Model.IsStateSelected(mailbox, ApprovedMailboxState.Approved)">@OperatorLabels.MailSettings.MailboxState(ApprovedMailboxState.Approved)</option><option value="Disabled" selected="@Model.IsStateSelected(mailbox, ApprovedMailboxState.Disabled)">@OperatorLabels.MailSettings.MailboxState(ApprovedMailboxState.Disabled)</option></select></div>
                    <section class="contact-section" aria-labelledby="@dialogId-access"><h3 id="@dialogId-access">Access and polling</h3><dl class="definition-list"><div class="definition"><dt>Activation</dt><dd>@OperatorLabels.OfficeTime(mailbox.ActivatedAtUtc, OperatorLabels.MailSettings.NotActivated)</dd></div><div class="definition"><dt>@OperatorLabels.MailSettings.Subscription</dt><dd>@Model.SubscriptionStatusFor(mailbox)</dd></div>@if (Model.PollStatusForMailbox(mailbox) is { } poll) { <div class="definition"><dt>Last success</dt><dd>@OperatorLabels.OfficeTime(poll.LastCompletedAtUtc, "Not yet polled")</dd></div><div class="definition"><dt>Freshness</dt><dd>@Model.PollFreshnessFor(poll)</dd></div><div class="definition"><dt>Last error</dt><dd>@(poll.LastFailureCode ?? "None")</dd></div> }</dl></section>
                </div>
                <div class="dialog-foot"><button type="reset" class="btn" data-dialog-close>Cancel</button><button type="submit" class="btn btn--primary" formaction="@Url.Page(null, "Update")" data-busy-label="@OperatorLabels.Busy.Saving">@OperatorLabels.MailSettings.SaveMailbox</button></div>
            </form>
        </section>
    </div>
}
