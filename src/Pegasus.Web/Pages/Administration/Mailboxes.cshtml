@page
@model Pegasus.Web.Pages.Administration.MailboxesModel
@using Pegasus.Core.Identity
@{
    ViewData["Title"] = "Approved mailboxes";
    ViewData["Eyebrow"] = "Administration";
}

<a class="back-link" asp-page="/Administration/Index">
    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
    Back to Administration
</a>

<partial name="Shared/_PageHeader" />

@if (TempData["AdministrationStatus"] is string status)
{
    <div class="status-card" role="status">@status</div>
}

@* A rejected save is most often a stale version: the policy moved since this
   page loaded. The summary carries the exact outcome; recovery is to reload
   and reapply against the current version. *@
<div asp-validation-summary="All"></div>

<section aria-labelledby="approved-mailboxes-heading">
    <h2 id="approved-mailboxes-heading" class="section-label">Current policies</h2>
    @if (Model.Mailboxes.Count == 0)
    {
        <div class="panel empty-state">No mailbox addresses are approved.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <caption class="vh">Versioned approved-mailbox policies</caption>
                <thead>
                    <tr>
                        <th scope="col">Address</th>
                        <th scope="col">Route scope</th>
                        <th scope="col">State</th>
                        <th scope="col">Polling</th>
                        <th scope="col">Version</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var mailbox in Model.Mailboxes)
                {
                    <tr>
                        <td>@mailbox.Address</td>
                        <td>@string.Join(", ", mailbox.RouteScopes.Select(scope => Pegasus.Web.Presentation.OperatorLabels.Humanise(scope.ToString())))</td>
                        <td><partial name="Shared/_StatusChip" model="@mailbox.State.ToString()" /></td>
                        <td>@Model.PollStatusFor(mailbox)</td>
                        <td class="tabular">@mailbox.Version</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.Mailboxes.Count > 0)
{
    <section class="section-gap" aria-labelledby="update-policies-heading">
        <h2 id="update-policies-heading" class="section-label">Update policies</h2>
        @foreach (var mailbox in Model.Mailboxes)
        {
            var operationKey = mailbox.Id == Model.MailboxId && Model.ExpectedVersion > 0
                ? Model.OperationKey
                : Guid.NewGuid().ToString("N");
            var headingId = $"mailbox-update-heading-{mailbox.Id}";
            <div class="panel form-panel" aria-labelledby="@headingId">
                <h3 id="@headingId">@mailbox.Address</h3>
                <form method="post" asp-page-handler="Update" class="role-form">
                    <input type="hidden" name="MailboxId" value="@mailbox.Id" />
                    <input type="hidden" name="ExpectedVersion" value="@mailbox.Version" />
                    <input type="hidden" name="OperationKey" value="@operationKey" />
                    <label>
                        Approved address
                        <input name="Address" value="@Model.AddressFor(mailbox)" required maxlength="320" inputmode="email" readonly="@mailbox.IdentityIsBound" />
                    </label>
                    @* Once an identity is saved it is the primary key of this
                       mailbox's cursor row, so rebinding it would orphan or
                       alias that cursor. Saved identities are shown, not edited. *@
                    <label>
                        Mailbox identity
                        <input name="MailboxIdentity" value="@Model.MailboxIdentityFor(mailbox)" maxlength="100" spellcheck="false" readonly="@(mailbox.MailboxIdentity is not null)" />
                    </label>
                    <label>
                        Inbox folder identity
                        <input name="InboxFolderIdentity" value="@Model.InboxFolderIdentityFor(mailbox)" maxlength="200" spellcheck="false" readonly="@(mailbox.InboxFolderIdentity is not null)" />
                    </label>
                    <label>
                        Sent folder identity
                        <input name="SentFolderIdentity" value="@Model.SentFolderIdentityFor(mailbox)" maxlength="200" spellcheck="false" readonly="@(mailbox.SentFolderIdentity is not null)" />
                    </label>
                    <fieldset class="role-choices role-choices--stacked">
                        <legend>Read-only route scope</legend>
                        <label class="choice">
                            <input type="checkbox" name="SelectedRouteScopes" value="InboundIntake" checked="@Model.IsRouteSelected(mailbox, ApprovedMailboxRouteScope.InboundIntake)" />
                            <span>New instructions and Triage mail (Inbox)</span>
                        </label>
                        <label class="choice">
                            <input type="checkbox" name="SelectedRouteScopes" value="SentEvidence" checked="@Model.IsRouteSelected(mailbox, ApprovedMailboxRouteScope.SentEvidence)" />
                            <span>Exact report and Triage evidence (Sent Items)</span>
                        </label>
                    </fieldset>
                    <label>
                        State
                        <select name="SelectedState">
                            <option value="Approved" selected="@Model.IsStateSelected(mailbox, ApprovedMailboxState.Approved)">Approved</option>
                            <option value="Disabled" selected="@Model.IsStateSelected(mailbox, ApprovedMailboxState.Disabled)">Disabled</option>
                        </select>
                    </label>
                    <label>
                        Reason
                        <input name="Reason" value="@Model.ReasonFor(mailbox)" required maxlength="1000" />
                    </label>
                    <div class="button-row">
                        <button type="submit" class="primary-action">Save mailbox policy</button>
                    </div>
                </form>
            </div>
        }
    </section>
}

<section class="section-gap" aria-labelledby="add-approved-mailbox-heading">
    <h2 id="add-approved-mailbox-heading" class="section-label">Add an approved address</h2>
    <div class="panel form-panel">
        <form method="post" asp-page-handler="Update">
            <input type="hidden" name="MailboxId" value="@Model.NewMailboxId" />
            <input type="hidden" name="ExpectedVersion" value="0" />
            <input type="hidden" name="OperationKey" value="@Model.OperationKey" />
            <label>
                Approved address
                <input name="Address" value="@Model.NewAddress" required maxlength="320" inputmode="email" />
            </label>
            <p class="field-hint">Identities cannot be changed once saved: disable this row and add a new one to move a mailbox.</p>
            <label>
                Mailbox identity
                <input name="MailboxIdentity" value="@Model.NewMailboxIdentity" maxlength="100" spellcheck="false" />
            </label>
            <label>
                Inbox folder identity
                <input name="InboxFolderIdentity" value="@Model.NewInboxFolderIdentity" maxlength="200" spellcheck="false" />
            </label>
            <label>
                Sent folder identity
                <input name="SentFolderIdentity" value="@Model.NewSentFolderIdentity" maxlength="200" spellcheck="false" />
            </label>
            <fieldset class="role-choices role-choices--stacked">
                <legend>Read-only route scope</legend>
                <label class="choice">
                    <input type="checkbox" name="SelectedRouteScopes" value="InboundIntake" checked="@Model.IsNewRouteSelected(ApprovedMailboxRouteScope.InboundIntake)" />
                    <span>New instructions and Triage mail (Inbox)</span>
                </label>
                <label class="choice">
                    <input type="checkbox" name="SelectedRouteScopes" value="SentEvidence" checked="@Model.IsNewRouteSelected(ApprovedMailboxRouteScope.SentEvidence)" />
                    <span>Exact report and Triage evidence (Sent Items)</span>
                </label>
            </fieldset>
            <label>
                State
                <select name="SelectedState">
                    <option value="Approved" selected="@Model.IsNewStateSelected(ApprovedMailboxState.Approved)">Approved</option>
                    <option value="Disabled" selected="@Model.IsNewStateSelected(ApprovedMailboxState.Disabled)">Disabled</option>
                </select>
            </label>
            <label>
                Reason
                <input name="Reason" value="@Model.NewReason" required maxlength="1000" />
            </label>
            <div class="button-row">
                <button type="submit" class="primary-action">Add mailbox policy</button>
            </div>
        </form>
    </div>
</section>
