@page "/Account/SignIn"
@model Pegasus.Web.Pages.Account.SignInModel
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    ViewData["Title"] = "Sign in";
}
<main class="page-shell narrow-shell">
    <header class="page-heading"><p class="eyebrow">Operations</p><h1>Sign in</h1></header>
    <form method="post" class="panel stack-lg">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Input.UserName"></label>
        <input asp-for="Input.UserName" autocomplete="username" />
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" type="password" autocomplete="current-password" />
        <label class="checkbox-row"><input asp-for="Input.RememberMe" /> Remember me</label>
        <button type="submit" class="button button-primary">Sign in</button>
    </form>
</main>
