@page
@model Pegasus.Web.Pages.Account.SignInModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-panel">
    <div class="panel">
        <p class="eyebrow">Collision Engineers</p>
        <h1>Sign in to Pegasus</h1>
        <p class="lede">Use the staff account issued to you. Contact an administrator if your access has changed.</p>
        <form method="post">
            <div asp-validation-summary="ModelOnly"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <label asp-for="UserName">
                Username
                <input asp-for="UserName" autocomplete="username" autofocus />
            </label>
            <span asp-validation-for="UserName"></span>
            <label asp-for="Password">
                Password
                <input asp-for="Password" autocomplete="current-password" />
            </label>
            <span asp-validation-for="Password"></span>
            <button type="submit" class="primary-action">Sign in</button>
        </form>
    </div>
</div>
