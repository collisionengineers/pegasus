@page
@model Pegasus.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = OperatorLabels.Shell.AccessDenied;
    Layout = "Shared/_LayoutAuth";
}

@* The refusal reads in the navless frame with the rest of the error family
   (v28 P6-D): the area as the eyebrow, "Access denied", one sentence, and the
   way back. No alarm chip: the heading already states the fact. *@
<div role="alert">
    @if (Model.Area is { } area)
    {
        <p class="eyebrow">@area</p>
    }
    <h1>@OperatorLabels.Shell.AccessDenied</h1>
    <p>@Model.Sentence</p>
    <div class="button-row">
        <a class="btn btn--primary" asp-page="/Index">Return to @OperatorLabels.Nav.WorkCentre</a>
    </div>
</div>
