@page
@model Pegasus.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="auth-panel">
    <div class="panel">
        <span class="status-chip status-chip--red">
            <svg class="icon" aria-hidden="true"><use href="#icon-lock" /></svg>
            <span>Denied</span>
        </span>
        <h1>Access denied</h1>
        <p class="lede">Your current staff role does not authorize this page or action. If your access was changed, sign out and sign in again.</p>
        <div class="button-row">
            <a class="secondary-action" asp-page="/Index">Return to Pegasus</a>
        </div>
    </div>
</div>
