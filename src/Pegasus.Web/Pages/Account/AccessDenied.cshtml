@page
@model Pegasus.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = OperatorLabels.Shell.AccessDenied;
}

@* No alarm chip. A permission boundary is routine, and the heading already
   states the fact; a red "Denied" pill beside an "Access denied" heading says
   the same thing twice and treats a policy outcome as an incident. *@
<div class="page-header">
    <div class="page-title">
        @if (Model.Area is { } area)
        {
            <p class="eyebrow">@area</p>
        }
        <h1>@OperatorLabels.Shell.AccessDenied</h1>
    </div>
</div>
<section class="panel">
    <div class="panel-body"><p class="empty-state">@Model.Sentence</p></div>
</section>
