@page
@model Pegasus.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
    Layout = "Shared/_LayoutAuth";
}

@* No alarm chip. A permission boundary is routine, and the heading already
   states the fact; a red "Denied" pill beside an "Access denied" heading says
   the same thing twice and treats a policy outcome as an incident. *@
<h1>Access denied</h1>
<p>Your account does not have access to this page.</p>
<div class="button-row">
    <a class="btn" asp-page="/Index">Return to @OperatorLabels.Nav.WorkCentre</a>
</div>
