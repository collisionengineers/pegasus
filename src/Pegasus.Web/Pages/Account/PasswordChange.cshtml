@page
@model Pegasus.Web.Pages.Account.PasswordChangeModel
@{
    ViewData["Title"] = Model.Forced ? "Set a new password" : "Change password";

    // Forced: the middleware has already locked every other destination, so a
    // navigation menu would offer a list of places this operator cannot go.
    // Voluntary: the operator arrived from inside the application and keeps it.
    Layout = Model.Forced ? "Shared/_LayoutAuth" : "_Layout";
}

<div class="auth-card @(Model.Forced ? string.Empty : "auth-card--wide")">
    @if (Model.Forced)
    {
        <p class="auth-card__mark">COLLISION ENGINEERS</p>
        <h1>Set a new password before continuing</h1>
        <p>You cannot use Pegasus until the password issued to you is replaced.</p>
    }
    else
    {
        <h1>Change password</h1>
    }
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
    <form method="post">
        <input asp-for="OperationKey" type="hidden" />
        <label asp-for="CurrentPassword">
            Current password
            <input asp-for="CurrentPassword" autocomplete="current-password" />
        </label>
        <span asp-validation-for="CurrentPassword"></span>
        <label asp-for="NewPassword">
            New password
            @* The requirement is stated once, beside the field it governs. *@
            <span class="field-hint">At least 8 characters. Any characters are allowed.</span>
            <input asp-for="NewPassword" autocomplete="new-password" />
        </label>
        <span asp-validation-for="NewPassword"></span>
        <label asp-for="ConfirmPassword">
            Confirm new password
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
        </label>
        <span asp-validation-for="ConfirmPassword"></span>
        <button type="submit" class="primary-action">Change password</button>
    </form>
</div>
