@page "/Account/PasswordChange"
@model Pegasus.Web.Pages.Account.PasswordChangeModel
@{
    ViewData["Title"] = "Change password";
}
<main class="page-shell narrow-shell">
    <header class="page-heading"><p class="eyebrow">Account</p><h1>Change password</h1></header>
    <form method="post" class="panel stack-lg">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Input.CurrentPassword"></label><input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" />
        <label asp-for="Input.NewPassword"></label><input asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
        <label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        <button class="button button-primary" type="submit">Update password</button>
    </form>
</main>
