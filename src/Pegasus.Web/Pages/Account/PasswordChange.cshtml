@page
@model Pegasus.Web.Pages.Account.PasswordChangeModel
@{
    ViewData["Title"] = Model.Forced ? "Set a new password" : "Change password";

    // Forced: the middleware has already locked every other destination, so a
    // navigation menu would offer a list of places this operator cannot go.
    // Voluntary: the operator arrived from inside the application and keeps it.
    Layout = Model.Forced ? "Shared/_LayoutAuth" : "_Layout";
}

@if (Model.Forced)
{
    <h1>Set a new password before continuing</h1>
    <p>You cannot use Pegasus until the password issued to you is replaced.</p>
}
else
{
    <header class="page-header">
        <div class="page-title"><h1>Change password</h1></div>
    </header>
}
<section class="@(Model.Forced ? string.Empty : "panel field--narrow")">
    <div class="@(Model.Forced ? string.Empty : "panel-body")">
        <div asp-validation-summary="ModelOnly" class="validation-summary mb-2" role="alert"></div>
        <form method="post" class="stack">
            <input asp-for="OperationKey" type="hidden" />
            <div class="field">
                <label asp-for="CurrentPassword">Current password</label>
                <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="NewPassword">New password</label>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword">Confirm new password</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <div class="button-row">
                <button type="submit" class="btn btn--primary">Change password</button>
            </div>
        </form>
    </div>
</section>
