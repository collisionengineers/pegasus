@page "/Development/EmailEvaluation"
@model Pegasus.Web.Pages.Development.EmailEvaluationModel
@using Pegasus.Core.Intake
@{
    ViewData["Title"] = "Evaluate email campaign";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Local evaluation</p>
        <h1>Evaluate email campaign</h1>
        <p class="lede">Run one guarded, local batch through the production reader, mail-route policy, and instruction policy. Sources are not retained; the source-labelled JSON report is retained by content hash.</p>
    </div>
    <a class="secondary-action" asp-page="/Intake/Index">Back to intake</a>
</header>

<section class="panel form-panel" aria-labelledby="evaluation-title">
    <h2 id="evaluation-title" class="section-label">Campaign sources</h2>
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Upload">.eml emails</label>
        <input asp-for="Upload" type="file" accept=".eml,message/rfc822" multiple />
        <span asp-validation-for="Upload" class="field-validation"></span>
        <p class="field-help">Up to 50 emails, 10 MB per email and 50 MB for the campaign. Processing is local and performs no mailbox, case, Triage, EVA, or external write.</p>
        <button type="submit" class="primary-action">Evaluate campaign</button>
    </form>
</section>

@if (Model.ActivationBlocked)
{
    <section class="panel section-gap" aria-labelledby="campaign-title">
        <h2 id="campaign-title" class="section-label">Campaign report</h2>
        <p class="empty-state">Activation blocked. Exact cohort approval, independent human review evidence, and an approved acceptance threshold have not been provided. This report cannot activate mailbox processing or satisfy a downstream approval gate.</p>
        <dl class="detail-list">
            <div><dt>Campaign identity</dt><dd>@Model.CampaignId</dd></div>
            <div><dt>Evaluated emails</dt><dd>@Model.Evaluations.Count</dd></div>
            <div><dt>Accepted mail routes</dt><dd>@Model.AcceptedRouteCount</dd></div>
            <div><dt>Applicable instructions</dt><dd>@Model.ApplicableInstructionCount</dd></div>
            <div><dt>Duplicate source content</dt><dd>@Model.DuplicateSourceCount</dd></div>
            <div><dt>Approval evidence</dt><dd>Not provided</dd></div>
            <div><dt>Activation</dt><dd>Blocked</dd></div>
        </dl>
        @if (Model.ReportKey is not null)
        {
            <a class="secondary-action"
               asp-page-handler="Report"
               asp-route-reportKey="@Model.ReportKey">Download deterministic JSON report</a>
        }
        else
        {
            <p class="failure-detail">The report was not retained and no acceptance claim was created.</p>
        }
    </section>
}

@for (var evaluationIndex = 0; evaluationIndex < Model.Evaluations.Count; evaluationIndex++)
{
    var evaluation = Model.Evaluations[evaluationIndex];
    <section class="panel section-gap" aria-labelledby="source-@evaluationIndex">
        <h2 id="source-@evaluationIndex" class="section-label">@evaluation.FileName</h2>
        <dl class="detail-list">
            <div><dt>Source SHA-256</dt><dd>@evaluation.ContentSha256</dd></div>
            <div><dt>Replay identity</dt><dd>@evaluation.ReplayIdentity</dd></div>
        </dl>

        @if (evaluation.TechnicalFailureReason is not null)
        {
            <p class="failure-detail">@evaluation.TechnicalFailureReason</p>
        }
        else if (evaluation.ReadResult is { } readResult)
        {
            <h3 class="section-label">Reader result</h3>
            <dl class="detail-list">
                <div><dt>Status</dt><dd>@readResult.Status</dd></div>
                <div><dt>Reader key</dt><dd>@readResult.ReaderKey</dd></div>
                <div><dt>Reader version</dt><dd>@readResult.ReaderVersion</dd></div>
                <div><dt>Incomplete</dt><dd>@readResult.IsIncomplete</dd></div>
                <div><dt>Requires OCR</dt><dd>@readResult.RequiresOcr</dd></div>
            </dl>
            @if (readResult.FailureCode is not null || readResult.FailureReason is not null)
            {
                <div class="failure-detail">
                    @if (readResult.FailureCode is not null)
                    {
                        <strong>@readResult.FailureCode</strong>
                    }
                    @if (readResult.FailureReason is not null)
                    {
                        <span>@readResult.FailureReason</span>
                    }
                </div>
            }

            @if (readResult.Content.Count > 0)
            {
                <h3 class="section-label">Readable content</h3>
                <div class="field-grid">
                    @foreach (var fragment in readResult.Content)
                    {
                        <article class="field-card">
                            <h3>@fragment.SourceLabel</h3>
                            <p>@fragment.Text</p>
                        </article>
                    }
                </div>
            }

            @if (readResult.TransportEvidence.Count > 0)
            {
                <h3 class="section-label">Transport evidence</h3>
                <ul class="plain-list">
                    @foreach (var evidence in readResult.TransportEvidence)
                    {
                        <li><strong>@evidence.Source</strong>: @evidence.Value</li>
                    }
                </ul>
            }

            @if (readResult.Issues.Count > 0)
            {
                <h3 class="section-label">Reader issues</h3>
                <ul class="evidence-list">
                    @foreach (var issue in readResult.Issues)
                    {
                        <li><strong>@issue.Code</strong><span>@issue.Source: @issue.Reason</span></li>
                    }
                </ul>
            }
        }

        <h3 class="section-label">Mail route</h3>
        @if (evaluation.RouteResult is not { } routeResult)
        {
            <p class="empty-state">Not evaluated because the source was unreadable or incomplete.</p>
        }
        else
        {
            <dl class="detail-list">
                <div><dt>Disposition</dt><dd>@routeResult.Disposition</dd></div>
                <div><dt>Route owner</dt><dd>@(routeResult.SelectedRoute?.RouteOwnerCode ?? "Not selected")</dd></div>
                <div><dt>Work provider</dt><dd>@(routeResult.SelectedRoute?.WorkProviderCode ?? "Not selected")</dd></div>
                <div><dt>Policy</dt><dd>@routeResult.PolicyKey v@routeResult.PolicyVersion</dd></div>
                <div><dt>Reason</dt><dd>@routeResult.Reason</dd></div>
            </dl>
            <ul class="evidence-list">
                @foreach (var predicate in routeResult.Predicates)
                {
                    <li><strong>@predicate.Key: @(predicate.Matched ? "matched" : "not matched")</strong><span>@predicate.Detail</span></li>
                }
            </ul>
        }

        <h3 class="section-label">Instruction extraction</h3>
        @if (evaluation.ExtractionResult is not { } extractionResult)
        {
            <p class="empty-state">Not evaluated. Extraction runs only after an accepted, unambiguous mail route.</p>
        }
        else
        {
            <dl class="detail-list">
                <div><dt>Applicability</dt><dd>@extractionResult.Applicability</dd></div>
                <div><dt>Policy key</dt><dd>@extractionResult.PolicyKey</dd></div>
                <div><dt>Policy version</dt><dd>@extractionResult.PolicyVersion</dd></div>
            </dl>

            @if (extractionResult.InstructionDraft is { } draft)
            {
                <h4 class="section-label">Suggested draft</h4>
                <dl class="detail-list">
                    <div><dt>Suggested principal</dt><dd>@(draft.SuggestedPrincipalCode ?? "Not suggested")</dd></div>
                    <div><dt>Claimant name</dt><dd>@(draft.ClaimantName ?? "Not resolved")</dd></div>
                    <div><dt>Claim number</dt><dd>@(draft.ClaimNumber ?? "Not resolved")</dd></div>
                    <div><dt>Vehicle registration</dt><dd>@(draft.VehicleRegistration ?? "Not resolved")</dd></div>
                    <div><dt>Vehicle make/model</dt><dd>@(string.IsNullOrWhiteSpace($"{draft.VehicleMake} {draft.VehicleModel}") ? "Not resolved" : $"{draft.VehicleMake} {draft.VehicleModel}".Trim())</dd></div>
                    <div><dt>Inspection address</dt><dd>@(draft.InspectionAddress ?? "Not resolved")</dd></div>
                </dl>
            }

            @if (extractionResult.MissingFields.Count > 0)
            {
                <h4 class="section-label">Missing fields</h4>
                <ul class="plain-list">
                    @foreach (var field in extractionResult.MissingFields)
                    {
                        <li>@field</li>
                    }
                </ul>
            }

            <h4 class="section-label">Extraction evidence</h4>
            @if (extractionResult.Evidence.Count == 0)
            {
                <p class="empty-state">No policy evidence was identified.</p>
            }
            else
            {
                <ul class="evidence-list">
                    @foreach (var item in extractionResult.Evidence)
                    {
                        <li><strong>@item.Signal</strong><span>@item.Source: @item.Strength; @item.Finding; @item.Detail</span></li>
                    }
                </ul>
            }
        }
    </section>
}
