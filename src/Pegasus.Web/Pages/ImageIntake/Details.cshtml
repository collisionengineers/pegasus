@* The folder is the internal domain name; the route is the operator's. *@
@page "/VehicleImages/{id:guid}"
@model Pegasus.Web.Pages.ImageIntake.DetailsModel
@using Pegasus.Core.ImageIntake
@{
    ViewData["Title"] = $"Image-initiated Case {Model.Detail.Record.ImageIntakeReference}";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Image-initiated Case</p>
        <h1>@Model.Detail.Record.ImageIntakeReference</h1>
        <partial name="Shared/_StatusChip" model="@OperatorLabels.ImageIntakeLifecycleState(Model.Detail.State)" />
    </div>
    <a class="secondary-action" asp-page="/ImageIntake/Index">All Image-initiated Cases</a>
</header>

<div class="review-grid">
    <section class="panel" aria-labelledby="image-intake-record-title">
        <h2 id="image-intake-record-title" class="section-label">Record</h2>
        <dl class="detail-list">
            <div><dt>Image-initiated reference</dt><dd>@Model.Detail.Record.ImageIntakeReference</dd></div>
            <div><dt>Vehicle registration</dt><dd>@Model.Detail.Record.NormalizedVehicleRegistration</dd></div>
            <div><dt>Registered</dt><dd>@OperatorLabels.OfficeTime(Model.Detail.RegisteredAtUtc)</dd></div>
            <div><dt>Lifecycle state</dt><dd>@OperatorLabels.ImageIntakeLifecycleState(Model.Detail.State)</dd></div>
            <div>
                <dt>Case association</dt>
                <dd>
                    @if (Model.Detail.AssociatedCaseId is { } caseId)
                    {
                        <a asp-page="/Cases/Details" asp-route-id="@caseId">@(Model.Detail.AssociatedCaseReference ?? caseId.ToString())</a>
                    }
                    else
                    {
                        <text>None — @OperatorLabels.ImageIntakeLifecycleStateContinuation(Model.Detail.State)</text>
                    }
                </dd>
            </div>
            @if (Model.Detail.State == ImageInitiatedCaseState.StaffClosed)
            {
                <div><dt>Closure reason</dt><dd>@Model.Detail.ClosureReason</dd></div>
            }
        </dl>
    </section>

    <section class="panel" aria-labelledby="image-intake-origin-title">
        <h2 id="image-intake-origin-title" class="section-label">Preserved origin</h2>
        @* The receipt identifier, source-receipt token, source hash and
           evaluation revision are internal handles, not operator identity —
           design README :168. The link below is the operator's route to the
           origin receipt; nothing here needs to show its raw identifiers. *@
        <dl class="detail-list">
            <div><dt>Source channel</dt><dd>@Pegasus.Web.Pages.Intake.DetailsModel.SourceChannelLabel(Model.Detail.Record.Origin.SourceIdentity.Channel)</dd></div>
        </dl>
        <p>Association, reversal and re-linking are reasoned actions on the origin receipt; the reference above is permanent either way.</p>
        <a class="secondary-action" asp-page="/Intake/Details" asp-route-id="@Model.Detail.Record.Origin.ReceiptId">Open the origin receipt to link or unlink</a>
    </section>
</div>

@if (Model.Detail.State == ImageInitiatedCaseState.AwaitingInstruction)
{
    <section class="panel section-gap" aria-labelledby="image-initiated-close-title">
        <h2 id="image-initiated-close-title" class="section-label">Close Image-initiated Case</h2>
        <p>Use only when formal instructions will not arrive; a reason is required and the record becomes read-only.</p>
        <form method="post" asp-page-handler="Close" asp-route-id="@Model.Detail.Record.Id">
            <input type="hidden" name="expectedVersion" value="@Model.Detail.LifecycleVersion" />
            <label for="image-initiated-close-reason">Reason</label>
            <textarea id="image-initiated-close-reason" name="reason" maxlength="500" required></textarea>
            <button type="submit" class="secondary-action">Record staff closure</button>
        </form>
    </section>
}

@if (Model.History.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="image-initiated-history-title">
        <h2 id="image-initiated-history-title" class="section-label">Image-initiated Case history</h2>
        <ol class="plain-list">
            @foreach (var entry in Model.History)
            {
                <li><strong>@OperatorLabels.HistoryEvent(entry.EventType)</strong> · @OperatorLabels.OfficeTime(entry.OccurredAtUtc) · @entry.Reason</li>
            }
        </ol>
    </section>
}

@if (Model.AssociationCandidates.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="image-intake-candidates-title">
        <h2 id="image-intake-candidates-title" class="section-label">Eligible case candidates</h2>
        <p>Pre-report instructed cases whose confirmed registration matches this Image-initiated Case; linking is a reasoned staff action.</p>
        <ul class="plain-list">
            @foreach (var candidate in Model.AssociationCandidates)
            {
                <li><a asp-page="/Cases/Details" asp-route-id="@candidate.CaseId">@candidate.CaseReference</a> · version @candidate.CaseVersion</li>
            }
        </ul>
    </section>
}

@if (Model.Suggestions.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="image-intake-suggestions-title">
        <h2 id="image-intake-suggestions-title" class="section-label">Registration reading results</h2>
        <ul class="evidence-list">
            @foreach (var suggestion in Model.Suggestions)
            {
                <li>
                    <strong>@Pegasus.Web.Pages.Intake.DetailsModel.SuggestionOutcomeLabel(suggestion)</strong>
                    <span>@suggestion.EngineKey v@(suggestion.EngineVersion) · @OperatorLabels.OfficeTime(suggestion.OccurredAtUtc) · @suggestion.Disposition.ToString().ToLowerInvariant()</span>
                </li>
            }
        </ul>
    </section>
}
