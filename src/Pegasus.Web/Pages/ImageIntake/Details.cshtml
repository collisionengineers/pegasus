@* The folder is the internal domain name; the route is the operator's. *@
@page "/VehicleImages/{id:guid}"
@model Pegasus.Web.Pages.ImageIntake.DetailsModel
@using Pegasus.Core.ImageIntake
@using Pegasus.Web.Presentation
@using Record = Pegasus.Web.Pages.ImageIntake.DetailsModel
@{
    ViewData["Title"] = $"Image-initiated Case {Model.Detail.Record.ImageIntakeReference}";
    var awaiting = Model.Detail.State == ImageInitiatedCaseState.AwaitingInstruction;
}

@section Styles {
    <link rel="stylesheet" href="~/css/image-record.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pre-case-images.css" asp-append-version="true" />
}

<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">Image-initiated Case</p>
        <h1>@Model.Detail.Record.ImageIntakeReference</h1>
    </div>
    <div class="page-actions">
        <a class="btn" asp-page="/Cases/Index"
           asp-route-tab="@(awaiting ? "awaiting" : null)"
           asp-route-selected="@(awaiting ? Model.Detail.Record.Id : null)">
            <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
            <span>Back to Cases</span>
        </a>
        <partial name="Shared/_RefreshButton" />
    </div>
</header>

<div asp-validation-summary="All" class="validation-summary" role="alert"></div>

<article class="record image-record" data-image-record data-image-record-state="@Model.Detail.State">
    <div class="ribbon" aria-label="Image-initiated Case">
        <div class="ribbon-facts">
            <div class="ribbon-item ribbon-ref"><span class="ribbon-label">Image reference</span><span class="ribbon-value mono">@Model.Detail.Record.ImageIntakeReference</span></div>
            <div class="ribbon-item"><span class="ribbon-label">Registration</span><span class="ribbon-value mono">@Model.Detail.Record.NormalizedVehicleRegistration</span></div>
            <div class="ribbon-item"><span class="ribbon-label">Registered</span><span class="ribbon-value">@OperatorLabels.OfficeTime(Model.Detail.RegisteredAtUtc)</span></div>
            <div class="ribbon-item"><span class="ribbon-label">Images</span><span class="ribbon-value">@Model.Images.Count</span></div>
            <div class="ribbon-item"><span class="ribbon-label">@OperatorLabels.Principal</span><span class="ribbon-value" data-image-principal>@(Model.Detail.PrincipalCode ?? OperatorLabels.PrincipalNotKnown)</span></div>
        </div>
        <div class="ribbon-chips">
            <partial name="Shared/_StatusChip" model="@OperatorLabels.ImageIntakeLifecycleState(Model.Detail.State)" />
        </div>
    </div>

    <div class="image-record-bar">
        @if (Model.OpenFileHref is { } fileHref)
        {
            <a class="btn" href="@fileHref" target="_blank" rel="noopener" data-image-action="open-file">
                <svg class="icon" aria-hidden="true"><use href="#icon-eye" /></svg><span>Open file</span>
            </a>
        }
        else if (Model.SourceAsset is { } unavailableSource)
        {
            <span class="muted" data-image-source-unavailable>
                Original file unavailable — @Record.CustodyLabel(unavailableSource.CustodyState).
            </span>
        }
        @if (Model.SourceMessageId is { } messageId)
        {
            <a class="btn" href="/Inbox/@messageId.ToString("D")" data-image-action="open-message">
                <svg class="icon" aria-hidden="true"><use href="#icon-mail" /></svg><span>Open message</span>
            </a>
        }
        @if (Model.Triage is { } triage)
        {
            <a class="btn" asp-page="/Triage/Details" asp-route-id="@triage.Id">
                <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg><span>Open Triage</span>
            </a>
        }
        @if (awaiting)
        {
            @* The Cases list's Awaiting instruction attach owns choosing the
               Case and the reasoned association; this record enters it. *@
            <a class="btn btn--dark" href="@Model.AddToCaseHref" data-image-action="add-to-case">
                <svg class="icon" aria-hidden="true"><use href="#icon-link" /></svg><span>Add to an existing case</span>
            </a>
        }
        <span class="image-record-bar-end">
            @if (!Model.IsEditing)
            {
                <form method="post" asp-page-handler="Edit" asp-route-id="@Model.Detail.Record.Id">
                    <input type="hidden" name="expectedVersion" value="@Model.Detail.LifecycleVersion" />
                    @if (Model.CanTakeOverEdit)
                    {
                        <input type="hidden" name="takeOver" value="true" />
                        <button type="submit" class="btn btn--primary">Take over</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn--primary">Edit record</button>
                    }
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="CancelEdit" asp-route-id="@Model.Detail.Record.Id">
                    <input type="hidden" name="editLeaseToken" value="@Model.EditLease!.Token" />
                    <button type="submit" class="btn">Cancel</button>
                </form>
                <form method="post" asp-page-handler="HeartbeatEdit" asp-route-id="@Model.Detail.Record.Id" data-edit-heartbeat data-edit-heartbeat-status="image-intake-edit-heartbeat-status" hidden>
                    <input type="hidden" name="editLeaseToken" value="@Model.EditLease!.Token" />
                </form>
                <form method="post" asp-page-handler="ReleaseScopeBeacon" asp-route-id="@Model.Detail.Record.Id" data-edit-scope-release hidden>
                    <input type="hidden" name="editLeaseToken" value="@Model.EditLease!.Token" />
                </form>
                <p id="image-intake-edit-heartbeat-status" class="notice notice--danger" role="alert" hidden></p>
                @if (awaiting)
                {
                    <button type="button" class="btn btn--danger" data-dialog-open="image-intake-close-dialog">Close with reason</button>
                }
            }
        </span>
    </div>

    <div class="image-record-body">
        <div class="image-record-grid">
            <section class="panel" aria-labelledby="image-intake-record-title">
                <div class="panel-head"><h2 id="image-intake-record-title">Record</h2></div>
                <dl class="fact-grid image-record-facts">
                    <div class="fact"><dt>Image-initiated reference</dt><dd class="mono">@Model.Detail.Record.ImageIntakeReference</dd></div>
                    <div class="fact"><dt>Vehicle registration</dt><dd class="mono">@Model.Detail.Record.NormalizedVehicleRegistration</dd></div>
                    <div class="fact"><dt>Registered</dt><dd>@OperatorLabels.OfficeTime(Model.Detail.RegisteredAtUtc)</dd></div>
                    <div class="fact"><dt>Lifecycle state</dt><dd>@OperatorLabels.ImageIntakeLifecycleState(Model.Detail.State)</dd></div>
                    <div class="fact"><dt>Source</dt><dd>@OperatorLabels.SourceChannel(Model.Detail.Record.Origin.SourceIdentity.Channel)</dd></div>
                    @if (Model.SourceAsset is { } sourceAsset)
                    {
                        <div class="fact"><dt>Original file</dt><dd>@sourceAsset.FileName · @Record.CustodyLabel(sourceAsset.CustodyState)</dd></div>
                    }
                    <div class="fact">
                        <dt>Case association</dt>
                        <dd>
                            @if (Model.Detail.AssociatedCaseId is { } caseId)
                            {
                                <a asp-page="/Cases/Details" asp-route-id="@caseId">@(Model.Detail.AssociatedCaseReference ?? caseId.ToString())</a>
                            }
                            else
                            {
                                <text>None — @OperatorLabels.ImageIntakeLifecycleStateContinuation(Model.Detail.State)</text>
                            }
                        </dd>
                    </div>
                    @if (Model.Detail.State == ImageInitiatedCaseState.StaffClosed)
                    {
                        <div class="fact"><dt>Closure reason</dt><dd>@Model.Detail.ClosureReason</dd></div>
                    }
                </dl>
            </section>

            <section class="panel" aria-labelledby="image-intake-principal-title">
                <div class="panel-head"><h2 id="image-intake-principal-title">@OperatorLabels.Principal</h2></div>
                <div class="panel-section">
                    @if (Model.IsEditing)
                    {
                        <form method="post" asp-page-handler="Principal" asp-route-id="@Model.Detail.Record.Id" class="stack">
                            <div class="field">
                                <label for="image-intake-principal">@OperatorLabels.Principal</label>
                                @* "Not known" is a real, selectable state, not a
                                   placeholder: clearing a recorded principal is a
                                   legitimate staff decision. *@
                                <select id="image-intake-principal" name="principalId">
                                    <option value="" selected="@(Model.Detail.Record.PrincipalId is null ? "selected" : null)">@OperatorLabels.PrincipalNotKnown</option>
                                    @foreach (var principal in Model.PrincipalOptions)
                                    {
                                        <option value="@principal.Id" selected="@(Model.Detail.Record.PrincipalId == principal.Id ? "selected" : null)">@principal.Code</option>
                                    }
                                </select>
                            </div>
                            <input type="hidden" name="expectedVersion" value="@Model.Detail.LifecycleVersion" />
                            <input type="hidden" name="editLeaseToken" value="@Model.EditLease!.Token" />
                            <div class="button-row"><button type="submit" class="btn btn--primary">Save</button></div>
                        </form>
                    }
                    else
                    {
                        <p class="image-record-value">@(Model.Detail.PrincipalCode ?? OperatorLabels.PrincipalNotKnown)</p>
                    }
                </div>
            </section>
        </div>

        @if (Model.RetainedFiles.Count > 0)
        {
            <section class="panel" aria-labelledby="image-intake-files-title" data-image-retained-files>
                <div class="panel-head"><h2 id="image-intake-files-title">Retained files</h2></div>
                <div class="panel-section stack">
                    @foreach (var file in Model.RetainedFiles)
                    {
                        <p>
                            <strong>@(file.IsSource ? "Original file" : "Attached file")</strong> ·
                            @if (file.IsStored)
                            {
                                <a href="@file.Href" target="_blank" rel="noopener">@file.Asset.FileName</a>
                            }
                            else
                            {
                                <span>@file.Asset.FileName</span>
                            }
                            · @Record.CustodyLabel(file.Asset.CustodyState)
                        </p>
                    }
                </div>
            </section>
        }

        @if (Model.Suggestions.Count > 0)
        {
            <section class="panel" aria-labelledby="image-intake-suggestions-title">
                <div class="panel-head"><h2 id="image-intake-suggestions-title">Registration reading</h2></div>
                <table class="table table--compact">
                    <thead><tr><th scope="col">Read</th><th scope="col">Result</th><th scope="col">Decision</th></tr></thead>
                    <tbody>
                        @foreach (var suggestion in Model.Suggestions)
                        {
                            <tr>
                                <td class="nowrap">@OperatorLabels.OfficeTime(suggestion.OccurredAtUtc)</td>
                                <td class="@(suggestion.Outcome == VrmRecognitionOutcomeKind.Suggested ? "mono" : null)">@Pegasus.Web.Pages.Unidentified.DetailsModel.ReadingLabel(suggestion)</td>
                                <td>@Pegasus.Web.Pages.Unidentified.DetailsModel.DispositionLabel(suggestion.Disposition)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        @if (Model.Images.Count > 0)
        {
            <section class="panel" aria-labelledby="image-initiated-images-title">
                <div class="panel-head">
                    <h2 id="image-initiated-images-title">Images</h2>
                    <span class="meta">@Model.Images.Count image@(Model.Images.Count == 1 ? string.Empty : "s")</span>
                </div>
                <div class="panel-section">
                    @{
                        var gallery = Model.Images
                            .Select(item =>
                            {
                                var href = item.AssetId is { } assetId
                                    ? Url.Page("/Intake/Asset", new { id = item.ReceiptId, assetId })!
                                    : Url.Page("/Intake/Image", new { id = item.ReceiptId })!;
                                return new GalleryImage(
                                    href,
                                    href,
                                    item.FileName,
                                    item.MediaType,
                                    IsStored: item.CustodyState == Pegasus.Core.Intake.IncomingArtifactCustodyState.Confirmed,
                                    IntakeAssetId: item.AssetId,
                                    IntakeReceiptId: item.ReceiptId,
                                    Preparation: item.AssetId is { } preparationAssetId ? Model.Preparations.GetValueOrDefault(preparationAssetId) : null,
                                    CustodyState: item.CustodyState);
                            })
                            .ToArray();
                        ViewData["PreCaseImageTags"] = Model.ImageTags;
                    }
                    <partial name="Shared/_ImageGallery" model="gallery" />
                </div>
            </section>
        }

        @if (Model.AssociationCandidates.Count > 0)
        {
            <section class="panel" aria-labelledby="image-intake-candidates-title">
                <div class="panel-head"><h2 id="image-intake-candidates-title">Eligible case candidates</h2></div>
                <table class="table table--compact">
                    <thead><tr><th scope="col">Case/PO</th></tr></thead>
                    <tbody>
                        @foreach (var candidate in Model.AssociationCandidates)
                        {
                            <tr><td class="mono"><a asp-page="/Cases/Details" asp-route-id="@candidate.CaseId">@candidate.CaseReference</a></td></tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        @if (Model.History.Count > 0)
        {
            <section class="panel" aria-labelledby="image-initiated-history-title">
                <div class="panel-head"><h2 id="image-initiated-history-title">History</h2></div>
                <div class="panel-section">
                    <div class="timeline">
                        @foreach (var entry in Model.History.OrderByDescending(history => history.OccurredAtUtc))
                        {
                            <div class="timeline-item">
                                <div class="timeline-title">@OperatorLabels.HistoryEvent(entry.EventType)</div>
                                <div class="timeline-meta">@OperatorLabels.OfficeTime(entry.OccurredAtUtc) · @entry.Reason</div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
    </div>
</article>

@if (Model.IsEditing && awaiting)
{
    <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
    {
        ["DialogId"] = "image-intake-close-dialog",
        ["DialogTitle"] = "Close Image-initiated Case",
        ["DialogConsequence"] = "Use only when formal instructions will not arrive; the record becomes read-only.",
        ["DialogActionUrl"] = Url.Page("/ImageIntake/Details", "Close", new { id = Model.Detail.Record.Id }),
        ["DialogHiddenFields"] = new Dictionary<string, string?>
        {
            ["expectedVersion"] = Model.Detail.LifecycleVersion.ToString(System.Globalization.CultureInfo.InvariantCulture),
            ["editLeaseToken"] = Model.EditLease!.Token
        }
    })" />
}

<partial name="Shared/_EvidenceViewer" />
