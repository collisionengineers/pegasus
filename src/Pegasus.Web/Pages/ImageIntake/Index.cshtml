@* The folder is the internal domain name; the route is the operator's. *@
@page "/VehicleImages"
@model Pegasus.Web.Pages.ImageIntake.IndexModel
@{
    ViewData["Title"] = "Image-initiated Cases";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Image-initiated Cases</p>
        <h1>Image-initiated Cases</h1>
    </div>
</header>

<section class="panel form-panel" aria-labelledby="image-intake-search-title">
    <h2 id="image-intake-search-title" class="section-label">Search</h2>
    <form method="get">
        <label for="image-intake-query">Image Intake Reference or vehicle registration</label>
        <input id="image-intake-query" name="query" value="@Model.Query" maxlength="30" autocomplete="off" />
        <input type="hidden" name="associated" value="@Model.AssociatedFilter" />
        <button type="submit" class="primary-action">Search</button>
    </form>
</section>

<nav class="queue-filters section-gap" aria-label="Image-initiated Case filters">
    <a asp-page="/ImageIntake/Index" asp-route-query="@Model.Query">All</a>
    <a asp-page="/ImageIntake/Index" asp-route-associated="no" asp-route-query="@Model.Query">Awaiting instruction</a>
    <a asp-page="/ImageIntake/Index" asp-route-associated="yes" asp-route-query="@Model.Query">Merged into formal Case</a>
</nav>

<section class="panel">
    @if (Model.Results.Count == 0)
    {
        <p class="empty-state">No Image-initiated Cases match this view.</p>
    }
    else
    {
        <div class="queue-list">
            @foreach (var item in Model.Results)
            {
                <a asp-page="/ImageIntake/Details" asp-route-id="@item.Id">
                    <span><strong>@item.ImageIntakeReference</strong><small>@item.NormalizedVehicleRegistration</small></span>
                    <span><strong>@IndexModel.OutcomeLabel(item)</strong><small>@OperatorLabels.OfficeDate(item.RegisteredAtUtc) @OperatorLabels.OfficeClock(item.RegisteredAtUtc)</small></span>
                </a>
            }
        </div>
    }
</section>
