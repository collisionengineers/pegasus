@page
@model Pegasus.Web.Pages.Intake.EmailEvaluationModel
@using Pegasus.Core.Intake
@{
    ViewData["Title"] = "Evaluate email";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Local evaluation</p>
        <h1>Evaluate email</h1>
        <p class="lede">Extract readable text from one .eml file and apply the existing QDOS instruction policy without storing the source or result.</p>
    </div>
    <a class="secondary-action" asp-page="/Intake/Upload">Back to intake upload</a>
</header>

<section class="panel form-panel" aria-labelledby="evaluation-title">
    <h2 id="evaluation-title" class="section-label">Email source</h2>
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Upload">.eml email</label>
        <input asp-for="Upload" type="file" accept=".eml,message/rfc822" />
        <span asp-validation-for="Upload" class="field-validation"></span>
        <button type="submit" class="primary-action">Evaluate email</button>
    </form>
</section>

@if (Model.ReadResult is { } readResult)
{
    <section class="panel section-gap" aria-labelledby="reader-title">
        <h2 id="reader-title" class="section-label">Reader result</h2>
        <dl class="detail-list">
            <div><dt>Status</dt><dd>@readResult.Status</dd></div>
            <div><dt>Reader key</dt><dd>@readResult.ReaderKey</dd></div>
            <div><dt>Reader version</dt><dd>@readResult.ReaderVersion</dd></div>
            <div><dt>Incomplete</dt><dd>@readResult.IsIncomplete</dd></div>
            <div><dt>Requires OCR</dt><dd>@readResult.RequiresOcr</dd></div>
        </dl>
        @if (readResult.FailureCode is not null || readResult.FailureReason is not null)
        {
            <div class="failure-detail">
                @if (readResult.FailureCode is not null)
                {
                    <strong>@readResult.FailureCode</strong>
                }
                @if (readResult.FailureReason is not null)
                {
                    <span>@readResult.FailureReason</span>
                }
            </div>
        }
    </section>

    <section class="panel section-gap" aria-labelledby="content-title">
        <h2 id="content-title" class="section-label">Readable content</h2>
        @if (readResult.Content.Count == 0)
        {
            <p class="empty-state">No readable content was extracted.</p>
        }
        else
        {
            <div class="field-grid">
                @foreach (var fragment in readResult.Content)
                {
                    <article class="field-card">
                        <h3>@fragment.SourceLabel</h3>
                        <p>@fragment.Text</p>
                    </article>
                }
            </div>
        }
    </section>

    @if (readResult.TransportEvidence.Count > 0)
    {
        <section class="panel section-gap" aria-labelledby="transport-title">
            <h2 id="transport-title" class="section-label">Transport evidence</h2>
            <ul class="plain-list">
                @foreach (var item in readResult.TransportEvidence)
                {
                    <li><strong>@item.Source</strong>: @item.Value</li>
                }
            </ul>
        </section>
    }

    @if (readResult.Issues.Count > 0)
    {
        <section class="panel section-gap" aria-labelledby="issues-title">
            <h2 id="issues-title" class="section-label">Reader issues</h2>
            <ul class="evidence-list">
                @foreach (var issue in readResult.Issues)
                {
                    <li><strong>@issue.Code</strong><span>@issue.Source: @issue.Reason</span></li>
                }
            </ul>
        </section>
    }

    <section class="panel section-gap" aria-labelledby="extraction-title">
        <h2 id="extraction-title" class="section-label">Instruction extraction</h2>
        @if (Model.ExtractionResult is not { } extractionResult)
        {
            <p class="empty-state">Not evaluated</p>
        }
        else
        {
            <dl class="detail-list">
                <div><dt>Applicability</dt><dd>@extractionResult.Applicability</dd></div>
                <div><dt>Policy key</dt><dd>@extractionResult.PolicyKey</dd></div>
                <div><dt>Policy version</dt><dd>@extractionResult.PolicyVersion</dd></div>
            </dl>

            @if (extractionResult.InstructionDraft is { } draft)
            {
                <h3 class="section-label">Suggested draft</h3>
                <dl class="detail-list">
                    <div><dt>Suggested principal</dt><dd>@(draft.SuggestedPrincipalCode ?? "Not suggested")</dd></div>
                    <div><dt>Claimant name</dt><dd>@(draft.ClaimantName ?? "Not resolved")</dd></div>
                    <div><dt>Claim number</dt><dd>@(draft.ClaimNumber ?? "Not resolved")</dd></div>
                    <div><dt>Vehicle registration</dt><dd>@(draft.VehicleRegistration ?? "Not resolved")</dd></div>
                    <div><dt>Vehicle make</dt><dd>@(draft.VehicleMake ?? "Not resolved")</dd></div>
                    <div><dt>Vehicle model</dt><dd>@(draft.VehicleModel ?? "Not resolved")</dd></div>
                    <div><dt>Vehicle mileage</dt><dd>@(draft.VehicleMileage?.ToString("N0") ?? "Not resolved")</dd></div>
                    <div><dt>Accident circumstances</dt><dd>@(draft.AccidentCircumstances ?? "Not resolved")</dd></div>
                    <div><dt>Date of incident</dt><dd>@(draft.DateOfIncident?.ToString("dd MMM yyyy") ?? "Not resolved")</dd></div>
                    <div><dt>Instruction date</dt><dd>@(draft.InstructionDate?.ToString("dd MMM yyyy") ?? "Not resolved")</dd></div>
                    <div><dt>Inspection address</dt><dd>@(draft.InspectionAddress ?? "Not resolved")</dd></div>
                </dl>
            }

            @if (extractionResult.Fields.Count > 0)
            {
                <h3 class="section-label">Review fields</h3>
                <div class="field-grid">
                    @foreach (var field in extractionResult.Fields)
                    {
                        <article class="field-card @(field.HasConflict ? "field-card--conflict" : string.Empty)">
                            <h3>@field.Name</h3>
                            <strong>@(field.SuggestedValue ?? (field.HasConflict ? "Conflicting suggestions" : "Not found"))</strong>
                            @if (field.IsDefaulted)
                            {
                                <small>Defaulted from processing date</small>
                            }
                            @foreach (var candidate in field.Candidates)
                            {
                                <small>@candidate.SourceLabel: @candidate.Value</small>
                            }
                        </article>
                    }
                </div>
            }

            @if (extractionResult.MissingFields.Count > 0)
            {
                <h3 class="section-label">Missing fields</h3>
                <ul class="plain-list">
                    @foreach (var field in extractionResult.MissingFields)
                    {
                        <li>@field</li>
                    }
                </ul>
            }

            <h3 class="section-label">Extraction evidence</h3>
            @if (extractionResult.Evidence.Count == 0)
            {
                <p class="empty-state">No policy evidence was identified.</p>
            }
            else
            {
                <ul class="evidence-list">
                    @foreach (var item in extractionResult.Evidence)
                    {
                        <li><strong>@item.Signal</strong><span>@item.Source: @item.Strength; @item.Finding; @item.Detail</span></li>
                    }
                </ul>
            }
        }
    </section>
}
