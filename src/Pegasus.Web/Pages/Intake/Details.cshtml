@* The folder is the internal domain name; the route is the operator's. *@
@page "/Received/{id:guid}"
@model Pegasus.Web.Pages.Intake.DetailsModel
@using Pegasus.Core.ImageIntake
@using Pegasus.Core.Intake
@{
    ViewData["Title"] = "Received review";

    @* Allocation runs after the decision is persisted and is deliberately
       non-blocking, so a definitive receipt can exist with no case behind it —
       an unknown Principal or an exhausted reference sequence both land here.
       The stored decision and reason are written before that is known, so on
       their own they claim a case that may not exist. Say what is true. *@
    var allocationIncomplete = Model.Receipt.Decision == IntakeDecision.CaseCreated
        && Model.Receipt.CurrentCaseId is null;
    var allocationSucceeded = Model.Receipt.CurrentCaseId is not null;
}

<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">Received review</p>
        @if (allocationSucceeded)
        {
            <h1>Case created</h1>
        }
        else if (allocationIncomplete)
        {
            <h1>Case not created</h1>
        }
        else
        {
            <h1>@DetailsModel.DecisionLabel(Model.Receipt)</h1>
        }
    </div>
    <div class="page-actions">
        <a class="btn" asp-page="/Operations/Index">
            <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
            <span>Back to Operations</span>
        </a>
    </div>
</header>

@if (allocationIncomplete)
{
    @* The create-case form renders for Unidentified material only (below), and
       the handler refuses anything else, so this copy describes what exists
       today rather than pointing at a control that is not on the page. The
       recovery action belongs to the upload/inbox claim. *@
    <div class="notice notice--warning mb-2" role="status">No case reference was allocated; ask an Administrator to check that its Principal exists and is active.</div>
}
@if (!allocationSucceeded && !allocationIncomplete && !string.IsNullOrEmpty(Model.Receipt.DecisionReason))
{
    <div class="notice mb-2" role="status">@Model.Receipt.DecisionReason</div>
}

@if (Model.IsDuplicate)
{
    <div class="notice mb-2" role="status">This file was already received. The existing record is shown.</div>
}
@if (TempData["InspectionAddressStatus"] is string inspectionAddressStatus)
{
    <div class="notice mb-2" role="status">@inspectionAddressStatus</div>
}
@if (TempData["IntakeDetailsStatus"] is string intakeDetailsStatus)
{
    <div class="notice notice--success mb-2" role="status" data-confirmation>@intakeDetailsStatus</div>
}
@if (TempData["IntakeDetailsError"] is string intakeDetailsError)
{
    <div class="validation-summary mb-2" role="alert">@intakeDetailsError</div>
}

@if (Model.Receipt.AllocationState is { } allocation
    && allocation.Status is IntakeAllocationProjectionStatus.FailedRecoverable
        or IntakeAllocationProjectionStatus.FailedBlocked)
{
    <section class="panel section-gap" aria-labelledby="allocation-failure-title">
        <div class="panel-head"><h2 id="allocation-failure-title">Case not created</h2></div>
        <div class="panel-body stack">
            <div class="notice notice--danger" role="status">
                <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                <span>@(allocation.SafeReason ?? "No case reference was allocated.")</span>
            </div>
            <div class="definition-list">
                <dl class="definition"><dt>Attempted case type</dt><dd>@DetailsModel.CaseTypeLabel(allocation.AttemptedCaseType)</dd></dl>
                <dl class="definition"><dt>Recorded</dt><dd>@OperatorLabels.OfficeTime(allocation.OccurredAtUtc)</dd></dl>
            </div>
            @if (allocation.FailureKind == IntakeAllocationFailureKind.PrincipalUnavailable)
            {
                <div class="button-row">
                    <a class="btn" asp-page="/Administration/Principals/Index">Open Principal administration</a>
                </div>
            }
            @if (Model.CanRetryAllocation)
            {
                <form method="post" asp-page-handler="RetryAllocation" asp-route-id="@Model.Receipt.Id" class="stack">
                    <input type="hidden" name="expectedVersion" value="@Model.Receipt.Version" />
                    <input type="hidden" name="expectedAttemptId" value="@allocation.AttemptId" />
                    <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                    <div class="field">
                        <label class="req" for="allocation-retry-reason">Reason for retrying case creation</label>
                        <textarea id="allocation-retry-reason" name="reason" maxlength="500" rows="3" required></textarea>
                    </div>
                    <div class="button-row">
                        <button type="submit" class="btn btn--primary">Retry case creation</button>
                    </div>
                </form>
            }
        </div>
    </section>
}

<div class="grid grid-2 section-gap">
    <section class="panel" aria-labelledby="result-title">
        <div class="panel-head"><h2 id="result-title">Result</h2></div>
        <div class="panel-body stack">
            @if (Model.Receipt.MediaType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                var imageHref = $"/Received/{Model.Receipt.Id:D}/Image";
                <partial name="Shared/_ImageGallery" model="@new[] { new GalleryImage(
                    imageHref, imageHref, Model.Receipt.SourceFileName, Model.Receipt.MediaType) }" />
            }
            <div class="definition-list">
                <dl class="definition"><dt>Decision</dt><dd>@DetailsModel.DecisionLabel(Model.Receipt)</dd></dl>
                <dl class="definition"><dt>Source</dt><dd>@Model.Receipt.SourceFileName</dd></dl>
                <dl class="definition"><dt>Channel</dt><dd>@DetailsModel.SourceChannelLabel(Model.Receipt.SourceIdentity.Channel)</dd></dl>
                <dl class="definition"><dt>Received</dt><dd>@OperatorLabels.OfficeTime(Model.Receipt.ReceivedAtUtc)</dd></dl>
            </div>
            @* The source-receipt token was printed here in full in an earlier
               port: a Graph message identifier the operator can neither read,
               act on, nor quote to anyone. The channel above already says
               where the message came from. *@
            @if (Model.Receipt.FailureReason is not null)
            {
                @* The failure code led this block in its persisted snake_case
                   form. The distinction it carries is the point of the screen —
                   an operator has to know whether the document was unreadable
                   or simply too large — so it stays, in words. *@
                <div class="notice notice--danger" role="status">
                    <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                    <span>@OperatorLabels.IntakeFailure(Model.Receipt.FailureCode) — @Model.Receipt.FailureReason</span>
                </div>
            }
        </div>
    </section>

    @if (Model.Receipt.MissingFields.Count > 0)
    {
        <section class="panel" aria-labelledby="missing-title">
            <div class="panel-head"><h2 id="missing-title">Missing fields</h2></div>
            <div class="panel-body">
                <ul class="stack">
                    @foreach (var field in Model.Receipt.MissingFields)
                    {
                        <li>@field</li>
                    }
                </ul>
            </div>
        </section>
    }
</div>

@if (Model.ImageIntake is { } imageIntake)
{
    <section class="panel section-gap" aria-labelledby="image-intake-title">
        <div class="panel-head"><h2 id="image-intake-title">Image intake</h2></div>
        <div class="panel-body stack">
            <div class="definition-list">
                <dl class="definition">
                    <dt>Image Intake Reference</dt>
                    <dd><a asp-page="/ImageIntake/Details" asp-route-id="@imageIntake.Record.Id">@imageIntake.Record.ImageIntakeReference</a></dd>
                </dl>
                <dl class="definition"><dt>Vehicle registration</dt><dd>@imageIntake.Record.NormalizedVehicleRegistration</dd></dl>
                <dl class="definition"><dt>Registered</dt><dd>@OperatorLabels.OfficeTime(imageIntake.RegisteredAtUtc)</dd></dl>
                <dl class="definition">
                    <dt>Status</dt>
                    <dd>
                        @if (imageIntake.AssociatedCaseId is { } associatedCase)
                        {
                            <text>Associated with Case </text><a asp-page="/Cases/Details" asp-route-id="@associatedCase">@(imageIntake.AssociatedCaseReference ?? associatedCase.ToString())</a>
                        }
                        else
                        {
                            <text>Image intake registered</text>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </section>
}

@if (Model.CanRegisterImageIntake)
{
    <section class="panel section-gap" aria-labelledby="register-image-intake-title">
        <div class="panel-head"><h2 id="register-image-intake-title">Register Image intake</h2></div>
        <div class="panel-body">
            <form method="post" asp-page-handler="RegisterImageIntake" asp-route-id="@Model.Receipt.Id" class="stack">
                <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                <div class="field">
                    <label class="req" for="register-vrm">Vehicle registration</label>
                    <input id="register-vrm" name="vehicleRegistration" value="@Model.RegistrationPrefill" maxlength="20" required autocomplete="off" />
                </div>
                <div class="field">
                    <label class="req" for="register-reason">Reason for registering</label>
                    <textarea id="register-reason" name="reason" maxlength="500" rows="2" required></textarea>
                </div>
                <div class="button-row">
                    <button type="submit" class="btn btn--primary">Register Image intake</button>
                </div>
            </form>
        </div>
    </section>
}

@if (Model.Triage is { } triage)
{
    <section class="panel section-gap" aria-labelledby="triage-title">
        <div class="panel-head"><h2 id="triage-title">Triage</h2></div>
        <div class="panel-body stack">
            <div class="definition-list">
                <dl class="definition">
                    <dt>Vehicle registration</dt>
                    <dd><a asp-page="/Triage/Details" asp-route-id="@triage.Id">@triage.NormalizedVehicleRegistration</a></dd>
                </dl>
                @if (triage.Reference is { Length: > 0 } triageReference)
                {
                    <dl class="definition"><dt>Triage reference</dt><dd>@triageReference</dd></dl>
                }
                <dl class="definition"><dt>Status</dt><dd>@OperatorLabels.TriageState(triage.State)</dd></dl>
                <dl class="definition"><dt>Opened</dt><dd>@OperatorLabels.OfficeTime(triage.CreatedAtUtc)</dd></dl>
            </div>
        </div>
    </section>
}

@if (Model.CanOpenTriage)
{
    <section class="panel section-gap" aria-labelledby="open-triage-title">
        <div class="panel-head"><h2 id="open-triage-title">Open the Triage</h2></div>
        <div class="panel-body">
            <form method="post" asp-page-handler="OpenTriage" asp-route-id="@Model.Receipt.Id" class="stack">
                <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                <div class="field">
                    <label class="req" for="open-triage-vrm">Vehicle registration</label>
                    <input id="open-triage-vrm" name="vehicleRegistration" maxlength="20" required autocomplete="off" />
                </div>
                <div class="button-row">
                    <button type="submit" class="btn btn--primary">Open the Triage</button>
                </div>
            </form>
        </div>
    </section>
}

@if (Model.VrmSuggestions.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="vrm-suggestions-title">
        <div class="panel-head"><h2 id="vrm-suggestions-title">Registration reading results</h2></div>
        <div class="panel-body stack">
            @foreach (var suggestion in Model.VrmSuggestions)
            {
                <div class="stack">
                    <div class="decision-row">
                        <span>@OperatorLabels.OfficeTime(suggestion.OccurredAtUtc)</span>
                        <strong>@DetailsModel.SuggestionOutcomeLabel(suggestion)</strong>
                    </div>
                    <div class="decision-row">
                        <span>Engine</span>
                        <strong>@suggestion.EngineKey v@(suggestion.EngineVersion) · @suggestion.Disposition.ToString().ToLowerInvariant()</strong>
                    </div>
                    @if (suggestion.FailureReason is not null)
                    {
                        <div class="decision-row">
                            <span>Failure</span>
                            <strong>@suggestion.FailureReason</strong>
                        </div>
                    }
                    @if (suggestion.Disposition == ImageVrmSuggestionDisposition.Pending
                        && suggestion.Outcome == VrmRecognitionOutcomeKind.Suggested)
                    {
                        <form method="post" asp-page-handler="DismissSuggestion" asp-route-id="@Model.Receipt.Id" class="stack">
                            <input type="hidden" name="suggestionId" value="@suggestion.Id" />
                            <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                            <div class="field">
                                <label class="req" for="dismiss-reason-@suggestion.Id">Reason for dismissing this suggestion</label>
                                <textarea id="dismiss-reason-@suggestion.Id" name="reason" maxlength="500" rows="2" required></textarea>
                            </div>
                            <div class="button-row">
                                <button type="submit" class="btn">Dismiss suggestion</button>
                            </div>
                        </form>
                    }
                </div>
            }
        </div>
    </section>
}

@if (Model.Receipt.AcceptedCaseId is null)
{
    <section class="panel section-gap" aria-labelledby="intake-resolution-title">
        <div class="panel-head"><h2 id="intake-resolution-title">Resolution</h2></div>
        <div class="panel-body stack">
            @* Correcting the detail belongs on the create screen now, where the
               same values are confirmed on the way to a case. It survives here
               for one reason: a blocked item has no other route forward, and
               deleting this form would strand it. The field markup itself
               lives once, in the shared partial both screens render. *@
            @if (Model.Receipt.Decision == IntakeDecision.BlockedIntake)
            {
                <form method="post" asp-page-handler="CorrectDraft" asp-route-id="@Model.Receipt.Id" class="stack">
                    <input type="hidden" name="expectedVersion" value="@Model.Receipt.Version" />
                    <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                    <div class="field">
                        <label class="req" for="correction-reason">Reason for correction</label>
                        <textarea id="correction-reason" name="reason" maxlength="500" rows="2" required></textarea>
                    </div>
                    <partial name="_InstructionDraftFields" model="Model.DraftFields" />
                    <div class="button-row">
                        <button type="submit" class="btn btn--primary">Record corrected draft</button>
                    </div>
                </form>
            }

            <form method="post" asp-page-handler="Reevaluate" asp-route-id="@Model.Receipt.Id" class="stack">
                <input type="hidden" name="expectedVersion" value="@Model.Receipt.Version" />
                <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                <div class="field">
                    <label class="req" for="reevaluation-reason">Reason for policy re-evaluation</label>
                    <textarea id="reevaluation-reason" name="reason" maxlength="500" rows="2" required></textarea>
                </div>
                <div class="button-row">
                    <button type="submit" class="btn">Re-evaluate with current policy</button>
                </div>
            </form>

            <form method="post" asp-page-handler="Block" asp-route-id="@Model.Receipt.Id" class="stack">
                <input type="hidden" name="expectedVersion" value="@Model.Receipt.Version" />
                <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                <div class="field">
                    <label class="req" for="block-reason">Reason for blocking</label>
                    <textarea id="block-reason" name="reason" maxlength="500" rows="2" required></textarea>
                </div>
                <div class="button-row">
                    <button type="submit" class="btn btn--danger">Block</button>
                </div>
            </form>
        </div>
    </section>
}

<section class="panel section-gap" aria-labelledby="case-association-title">
    <div class="panel-head"><h2 id="case-association-title">Current case association</h2></div>
    <div class="panel-body stack">
        <div class="definition-list">
            <dl class="definition">
                <dt>Case/PO</dt>
                <dd>
                    @if (Model.Receipt.CurrentCaseId is { } currentCaseId)
                    {
                        <a asp-page="/Cases/Details" asp-route-id="@currentCaseId">@Model.Receipt.CurrentCaseReference</a>
                    }
                    else
                    {
                        @:None
                    }
                </dd>
            </dl>
        </div>

        @if (Model.AssociationCandidates.Count > 0 && Model.Receipt.CurrentCaseId is null)
        {
            <ul class="stack">
                @foreach (var candidate in Model.AssociationCandidates)
                {
                    <li>@candidate.CaseReference · case @candidate.CaseId · version @candidate.CaseVersion</li>
                }
            </ul>
        }

        @if (Model.LeasedCaseId is null)
        {
            <form method="post" asp-page-handler="ClaimCaseLease" asp-route-id="@Model.Receipt.Id" class="stack">
                @if (Model.Receipt.CurrentCaseId is { } associatedCaseId)
                {
                    <input type="hidden" name="caseId" value="@associatedCaseId" />
                }
                else
                {
                    <div class="field">
                        <label class="req" for="association-case-id">Case identifier</label>
                        <input id="association-case-id" name="caseId" required autocomplete="off" />
                    </div>
                }
                <div class="field">
                    <label class="req" for="association-case-version">Expected case version</label>
                    <input id="association-case-version" name="expectedCaseVersion" type="number" min="0" required />
                </div>
                <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                <div class="button-row">
                    <button type="submit" class="btn">Enter case edit mode</button>
                </div>
            </form>
        }
        else if (Model.LeasedCaseVersion is { } leasedCaseVersion
            && Model.CaseEditLeaseToken is { } editLeaseToken)
        {
            if (Model.Receipt.CurrentCaseId == Model.LeasedCaseId)
            {
                <form method="post" asp-page-handler="ReverseCaseLink" asp-route-id="@Model.Receipt.Id" class="stack">
                    <input type="hidden" name="caseId" value="@Model.LeasedCaseId" />
                    <input type="hidden" name="expectedIntakeVersion" value="@Model.Receipt.Version" />
                    <input type="hidden" name="expectedCaseVersion" value="@leasedCaseVersion" />
                    <input type="hidden" name="editLeaseToken" value="@editLeaseToken" />
                    <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                    <div class="field">
                        <label class="req" for="reverse-link-reason">Reason for reversing this association</label>
                        <textarea id="reverse-link-reason" name="reason" maxlength="500" rows="2" required></textarea>
                    </div>
                    <div class="button-row">
                        <button type="submit" class="btn">Reverse current association</button>
                    </div>
                </form>
            }
            else if (Model.Receipt.CurrentCaseId is null)
            {
                <form method="post" asp-page-handler="LinkCase" asp-route-id="@Model.Receipt.Id" class="stack">
                    <input type="hidden" name="caseId" value="@Model.LeasedCaseId" />
                    <input type="hidden" name="expectedIntakeVersion" value="@Model.Receipt.Version" />
                    <input type="hidden" name="expectedCaseVersion" value="@leasedCaseVersion" />
                    <input type="hidden" name="editLeaseToken" value="@editLeaseToken" />
                    <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                    <div class="field">
                        <label class="req" for="link-case-reason">Reason for linking this case</label>
                        <textarea id="link-case-reason" name="reason" maxlength="500" rows="2" required></textarea>
                    </div>
                    <div class="button-row">
                        <button type="submit" class="btn btn--primary">Link selected case</button>
                    </div>
                </form>
            }
            else
            {
                <div class="notice notice--warning" role="status">
                    <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                    <span>The claimed case does not match the current association; reload and enter edit mode for the current case.</span>
                </div>
            }
        }
    </div>
</section>

@if (Model.Receipt.InstructionDraft is not null)
{
    var draft = Model.Receipt.InstructionDraft;
    <section class="panel section-gap" aria-labelledby="typed-draft-title">
        <div class="panel-head"><h2 id="typed-draft-title">Typed review draft</h2></div>
        <div class="panel-body">
            <div class="definition-list">
                <dl class="definition"><dt>Suggested principal</dt><dd>@(draft.SuggestedPrincipalCode ?? "Not suggested")</dd></dl>
                <dl class="definition"><dt>Claimant name</dt><dd>@(draft.ClaimantName ?? "Not resolved")</dd></dl>
                <dl class="definition"><dt>Claim number</dt><dd>@(draft.ClaimNumber ?? "Not resolved")</dd></dl>
                <dl class="definition"><dt>Vehicle registration</dt><dd>@(draft.VehicleRegistration ?? "Not resolved")</dd></dl>
                <dl class="definition"><dt>Vehicle make</dt><dd>@(draft.VehicleMake ?? "Not resolved")</dd></dl>
                <dl class="definition"><dt>Vehicle model</dt><dd>@(draft.VehicleModel ?? "Not resolved")</dd></dl>
                <dl class="definition"><dt>Vehicle mileage</dt><dd>@(draft.VehicleMileage?.ToString("N0") ?? "Not resolved")</dd></dl>
                <dl class="definition"><dt>Accident circumstances</dt><dd>@(draft.AccidentCircumstances ?? "Not resolved")</dd></dl>
                <dl class="definition"><dt>Date of incident</dt><dd>@(draft.DateOfIncident?.ToString("dd MMM yyyy") ?? "Not resolved")</dd></dl>
                <dl class="definition"><dt>Instruction date</dt><dd>@(draft.InstructionDate?.ToString("dd MMM yyyy") ?? "Not resolved")</dd></dl>
                <dl class="definition"><dt>Inspection address</dt><dd>@(draft.InspectionAddress ?? "Not resolved")</dd></dl>
            </div>
        </div>
    </section>
}

<section class="panel section-gap" aria-labelledby="inspection-address-title">
    <div class="panel-head"><h2 id="inspection-address-title">Inspection-address confirmation</h2></div>
    <div class="panel-body stack">
        @if (Model.ProviderIsImageBased)
        {
            <div class="definition-list">
                <dl class="definition"><dt>Inspection address</dt><dd>Image Based Assessment</dd></dl>
            </div>
        }
        else if (Model.AddressResolution.Evaluation.Suggestion is { } addressSuggestion)
        {
            @* Read-only here. Settling the address is part of creating the
               case, so it is asked once, on the create screen, alongside
               everything else the same decision depends on. *@
            <div class="definition-list">
                <dl class="definition"><dt>Address found in the document</dt><dd>@addressSuggestion.Value</dd></dl>
                <dl class="definition"><dt>Evidence type</dt><dd>@(addressSuggestion.Kind == Pegasus.Core.Address.InspectionAddressEvidenceKind.ImageBasedAssessment ? "Image Based Assessment instruction" : "Extracted physical address")</dd></dl>
                <dl class="definition"><dt>Status</dt><dd>@Pegasus.Web.Pages.Intake.DetailsModel.AddressStateLabel(Model.AddressResolution.State)</dd></dl>
                @if (Model.AddressResolution.ResolvedValue is not null)
                {
                    <dl class="definition"><dt>Confirmed value</dt><dd>@Model.AddressResolution.ResolvedValue</dd></dl>
                    <dl class="definition"><dt>Confirmed</dt><dd>@OperatorLabels.OfficeTime(Model.AddressResolution.ResolvedAtUtc, "Not recorded")</dd></dl>
                }
            </div>
            @if (addressSuggestion.Provenance.Count > 0)
            {
                <ul class="stack">
                    @foreach (var provenance in addressSuggestion.Provenance)
                    {
                        <li>Extracted from @provenance.SourceLabel</li>
                    }
                </ul>
            }
        }
        else if (Model.AddressResolution.ResolvedValue is { } suppliedAddress)
        {
            <div class="definition-list">
                <dl class="definition"><dt>Inspection address</dt><dd>@suppliedAddress</dd></dl>
                <dl class="definition"><dt>Status</dt><dd>@Pegasus.Web.Pages.Intake.DetailsModel.AddressStateLabel(Model.AddressResolution.State)</dd></dl>
                <dl class="definition"><dt>Recorded</dt><dd>@OperatorLabels.OfficeTime(Model.AddressResolution.ResolvedAtUtc, "Not recorded")</dd></dl>
            </div>
        }
        else if (Model.AddressResolution.Evaluation.ConflictingEvidence.Count > 0)
        {
            <div class="notice notice--warning" role="status">
                <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                <span>Missing or conflicting physical-address evidence remains unresolved.</span>
            </div>
            <div class="timeline">
                @foreach (var evidence in Model.AddressResolution.Evaluation.ConflictingEvidence)
                {
                    <div class="timeline-item">
                        <div class="timeline-title">@evidence.Value</div>
                        <div class="timeline-meta">@evidence.Provenance.SourceLabel · @evidence.Provenance.PolicyKey v@evidence.Provenance.PolicyVersion</div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@* There is exactly one acceptance caller in the application, and it is not
   here. This screen is the record of what arrived and what was decided about
   it; turning it into a case is a separate screen with its own confirmation,
   reached from this link. *@
@if (Model.CanCreateCase)
{
    <section class="panel section-gap" aria-labelledby="create-case-title">
        <div class="panel-head"><h2 id="create-case-title">Create a case from this item</h2></div>
        <div class="panel-body">
            <div class="button-row">
                <a class="btn btn--primary" asp-page="/Cases/Create" asp-route-receiptId="@Model.Receipt.Id">
                    <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                    <span>Create a case</span>
                </a>
            </div>
        </div>
    </section>
}

@if (Model.Receipt.AssetRecords.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="assets-title">
        <div class="panel-head"><h2 id="assets-title">Source and extracted assets</h2></div>
        <div class="panel-body">
            <ul class="blocker-list">
                @foreach (var asset in Model.Receipt.AssetRecords)
                {
                    var duplicateCount = Model.DuplicateOccurrenceCount(asset);
                    <li class="blocker">
                        @if (asset.Kind == IntakeAssetKind.Source)
                        {
                            <strong><a asp-page="/Intake/Source" asp-route-id="@Model.Receipt.Id">@asset.FileName</a></strong>
                        }
                        else
                        {
                            <strong>@asset.FileName</strong>
                        }
                        <small>@asset.SourceLabel · @asset.Kind · @asset.MediaType</small>
                        @if (asset.PageNumber is not null)
                        {
                            <small>PDF page @asset.PageNumber</small>
                        }
                        @if (duplicateCount > 1)
                        {
                            <small>Exact content match: @duplicateCount retained occurrences</small>
                        }
                    </li>
                }
            </ul>
        </div>
    </section>
}

@if (Model.Receipt.ScannedPdfPages.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="ocr-title">
        <div class="panel-head"><h2 id="ocr-title">Scanned PDF pages</h2></div>
        <div class="panel-body">
            <ul class="stack">
                @foreach (var candidate in Model.Receipt.ScannedPdfPages)
                {
                    <li>@candidate.SourceLabel, page @candidate.PageNumber</li>
                }
            </ul>
        </div>
    </section>
}

@if (Model.ShowRetainedAnalysisPanel)
{
<section class="panel section-gap" aria-labelledby="retained-analysis-title">
    <div class="panel-head"><h2 id="retained-analysis-title">Retained instruction analysis</h2></div>
    <div class="panel-body stack">
        @if (Model.RetainedAnalysisNotComposed)
        {
            <p class="muted">The retained-instruction analysis is not available in this environment.</p>
        }
        else if (Model.RetainedAnalysis is { } analysis)
        {
            <div class="definition-list">
                <dl class="definition">
                    <dt>Outcome</dt>
                    <dd>@OperatorLabels.RetainedInstructionAnalysisOutcome(analysis.Outcome)</dd>
                </dl>
                <dl class="definition">
                    <dt>Analysed</dt>
                    <dd>@OperatorLabels.OfficeTime(analysis.CompletedAtUtc)</dd>
                </dl>
            </div>
            @if (analysis.Candidates.Count > 0)
            {
                <ul class="blocker-list">
                    @foreach (var candidate in analysis.Candidates)
                    {
                        <li class="blocker">
                            <strong>@candidate.Field: @(candidate.RawValue ?? "Not stated")</strong>
                            <small>@OperatorLabels.SourceCandidateDisposition(candidate.Disposition)</small>
                            <small>
                                @candidate.SourceLabel@(candidate.Page is { } page ? $", page {page}" : string.Empty)
                            </small>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="muted">The analysis recorded no fields from this document.</p>
            }
        }
        else
        {
            <p class="muted">This retained instruction has not been analysed.</p>
        }

        @if (Model.CanAnalyzeRetainedInstruction)
        {
            <form method="post" asp-page-handler="Analyze" asp-route-id="@Model.Receipt.Id" class="stack">
                <input type="hidden" name="expectedVersion" value="@Model.Receipt.Version" />
                <input type="hidden" name="operationKey" value="@StaffPageModel.NewOperationKey()" />
                <div class="actions">
                    <button type="submit" class="btn">
                        @(Model.RetainedAnalysis is null ? "Analyse the retained instruction" : "Analyse again")
                    </button>
                </div>
            </form>
        }
    </div>
</section>
}

@if (Model.Receipt.Fields.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="fields-title">
        <div class="panel-head"><h2 id="fields-title">Suggested fields</h2></div>
        <div class="panel-body">
            <ul class="blocker-list">
                @foreach (var field in Model.Receipt.Fields)
                {
                    <li class="blocker">
                        <strong>@field.Name: @(field.SuggestedValue ?? (field.HasConflict ? "Conflicting suggestions" : "Not found"))</strong>
                        @if (field.IsDefaulted)
                        {
                            <small>Defaulted from processing date</small>
                        }
                        @foreach (var candidate in field.Candidates)
                        {
                            <small>@candidate.SourceLabel: @candidate.Value</small>
                        }
                    </li>
                }
            </ul>
        </div>
    </section>
}

@if (Model.Receipt.Evidence.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="evidence-title">
        <div class="panel-head"><h2 id="evidence-title">Decision evidence</h2></div>
        <div class="panel-body">
            <div class="timeline">
                @foreach (var item in Model.Receipt.Evidence)
                {
                    <div class="timeline-item">
                        <div class="timeline-title">@item.Source</div>
                        <div class="timeline-text">@item.Detail</div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<partial name="Shared/_EvidenceViewer" />
