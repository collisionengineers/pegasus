@* The folder is the internal domain name; the route is the operator's. *@
@page "/Received/{id:guid}"
@model Pegasus.Web.Pages.Intake.DetailsModel
@using Pegasus.Core.ImageIntake
@using Pegasus.Core.Intake
@{
    ViewData["Title"] = "Received review";

    @* Allocation runs after the decision is persisted and is deliberately
       non-blocking, so a definitive receipt can exist with no case behind it —
       an unknown Principal or an exhausted reference sequence both land here.
       The stored decision and reason are written before that is known, so on
       their own they claim a case that may not exist. Say what is true. *@
    var allocationIncomplete = Model.Receipt.Decision == IntakeDecision.CaseCreated
        && Model.Receipt.CurrentCaseId is null;
    var allocationSucceeded = Model.Receipt.CurrentCaseId is not null;
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Received review</p>
        @if (allocationSucceeded)
        {
            <h1>Case created</h1>
        }
        else if (allocationIncomplete)
        {
            <h1>Case not created</h1>
        }
        else
        {
            <h1>@DetailsModel.DecisionLabel(Model.Receipt.Decision)</h1>
        }
    </div>
    <a class="secondary-action" asp-page="/Operations">Back to Operations</a>
</header>

@if (allocationIncomplete)
{
    @* The create-case form renders for Unidentified material only (below), and
       the handler refuses anything else, so this copy describes what exists
       today rather than pointing at a control that is not on the page. The
       recovery action belongs to the upload/inbox claim. *@
    <div class="status-card status-card--attention" role="status">No case reference was allocated; ask an Administrator to check that its Principal exists and is active.</div>
}
@if (!allocationSucceeded && !allocationIncomplete && !string.IsNullOrEmpty(Model.Receipt.DecisionReason))
{
    <div class="status-card" role="status">@Model.Receipt.DecisionReason</div>
}

@if (Model.IsDuplicate)
{
    <div class="status-card" role="status">This file was already received. The existing record is shown.</div>
}
@if (TempData["InspectionAddressStatus"] is string inspectionAddressStatus)
{
    <div class="status-card" role="status">@inspectionAddressStatus</div>
}
@if (TempData["IntakeDetailsStatus"] is string intakeDetailsStatus)
{
    <div class="status-card" role="status">@intakeDetailsStatus</div>
}
@if (TempData["IntakeDetailsError"] is string intakeDetailsError)
{
    <div class="validation-summary" role="alert">@intakeDetailsError</div>
}

@if (Model.Receipt.AllocationState is { } allocation
    && allocation.Status is IntakeAllocationProjectionStatus.FailedRecoverable
        or IntakeAllocationProjectionStatus.FailedBlocked)
{
    <section class="panel form-panel section-gap" aria-labelledby="allocation-failure-title">
        <h2 id="allocation-failure-title" class="section-label">Case not created</h2>
        <p class="failure-detail">@(allocation.SafeReason ?? "No case reference was allocated.")</p>
        <dl class="detail-list">
            <div><dt>Attempted case type</dt><dd>@DetailsModel.CaseTypeLabel(allocation.AttemptedCaseType)</dd></div>
            <div><dt>Recorded</dt><dd>@OperatorLabels.OfficeTime(allocation.OccurredAtUtc)</dd></div>
        </dl>
        @if (allocation.FailureKind == IntakeAllocationFailureKind.PrincipalUnavailable)
        {
            <p><a asp-page="/Administration/Principals/Index">Open Principal administration</a> to correct the Principal before retrying.</p>
        }
        @if (Model.CanRetryAllocation)
        {
            <form method="post" asp-page-handler="RetryAllocation" asp-route-id="@Model.Receipt.Id">
                <input type="hidden" name="expectedVersion" value="@Model.Receipt.Version" />
                <input type="hidden" name="expectedAttemptId" value="@allocation.AttemptId" />
                <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                <label for="allocation-retry-reason">Reason for retrying case creation</label>
                <textarea id="allocation-retry-reason" name="reason" maxlength="500" rows="3" required></textarea>
                <button type="submit" class="primary-action">Retry case creation</button>
            </form>
        }
    </section>
}


<div class="review-grid">
    <section class="panel" aria-labelledby="result-title">
        <h2 id="result-title" class="section-label">Result</h2>
        <dl class="detail-list">
            <div><dt>Decision</dt><dd>@DetailsModel.DecisionLabel(Model.Receipt.Decision)</dd></div>
            <div><dt>Source</dt><dd>@Model.Receipt.SourceFileName</dd></div>
            <div><dt>Channel</dt><dd>@DetailsModel.SourceChannelLabel(Model.Receipt.SourceIdentity.Channel)</dd></div>
            @* The source-receipt token was printed here in full: a Graph
               message identifier the operator can neither read, act on, nor
               quote to anyone. It is the transport's handle on the message,
               not the business's, and the register names it by name. The
               channel above already says where the message came from. *@
            <div><dt>Received</dt><dd>@OperatorLabels.OfficeTime(Model.Receipt.ReceivedAtUtc)</dd></div>
        </dl>
        @if (Model.Receipt.FailureReason is not null)
        {
            @* The failure code led this block in its persisted snake_case
               form. The distinction it carries is the point of the screen —
               an operator has to know whether the document was unreadable or
               simply too large — so it stays, in words. Only the spelling
               changes. *@
            <div class="failure-detail">
                <strong>@OperatorLabels.IntakeFailure(Model.Receipt.FailureCode)</strong>
                <span>@Model.Receipt.FailureReason</span>
            </div>
        }
    </section>

    <section class="panel" aria-labelledby="missing-title">
        <h2 id="missing-title" class="section-label">Missing fields</h2>
        @if (Model.Receipt.MissingFields.Count == 0)
        {
            <p class="empty-state">No missing field suggestions were identified.</p>
        }
        else
        {
            <ul class="plain-list">
                @foreach (var field in Model.Receipt.MissingFields)
                {
                    <li>@field</li>
                }
            </ul>
        }
    </section>
</div>
@if (Model.ImageIntake is { } imageIntake)
{
    <section class="panel section-gap" aria-labelledby="image-intake-title">
        <h2 id="image-intake-title" class="section-label">Image intake</h2>
        <dl class="detail-list">
            <div><dt>Image Intake Reference</dt><dd><a asp-page="/ImageIntake/Details" asp-route-id="@imageIntake.Record.Id">@imageIntake.Record.ImageIntakeReference</a></dd></div>
            <div><dt>Vehicle registration</dt><dd>@imageIntake.Record.NormalizedVehicleRegistration</dd></div>
            <div><dt>Registered</dt><dd>@OperatorLabels.OfficeTime(imageIntake.RegisteredAtUtc)</dd></div>
            <div>
                <dt>Status</dt>
                <dd>
                    @if (imageIntake.AssociatedCaseId is { } associatedCase)
                    {
                        <text>Associated with Case </text><a asp-page="/Cases/Details" asp-route-id="@associatedCase">@(imageIntake.AssociatedCaseReference ?? associatedCase.ToString())</a>
                    }
                    else
                    {
                        <text>Image intake registered</text>
                    }
                </dd>
            </div>
        </dl>
    </section>
}

@if (Model.CanRegisterImageIntake)
{
    <section class="panel form-panel section-gap" aria-labelledby="register-image-intake-title">
        <h2 id="register-image-intake-title" class="section-label">Register Image intake</h2>
        <p>Image-only material with a usable registration becomes an Image-initiated Case with a permanent reference; it never becomes a formal Case by itself.</p>
        <form method="post" asp-page-handler="RegisterImageIntake" asp-route-id="@Model.Receipt.Id">
            <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
            <label for="register-vrm">Vehicle registration</label>
            <input id="register-vrm" name="vehicleRegistration" value="@Model.RegistrationPrefill" maxlength="20" required autocomplete="off" />
            <label for="register-reason">Reason for registering</label>
            <textarea id="register-reason" name="reason" maxlength="500" rows="2" required></textarea>
            <button type="submit" class="primary-action">Register Image intake</button>
        </form>
    </section>
}

@if (Model.VrmSuggestions.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="vrm-suggestions-title">
        <h2 id="vrm-suggestions-title" class="section-label">Registration reading results</h2>
        <p>A suggestion never registers, links or identifies anything on its own; an unreadable image, an unavailable engine and a technical failure remain distinct recorded outcomes.</p>
        <ul class="evidence-list">
            @foreach (var suggestion in Model.VrmSuggestions)
            {
                <li>
                    <strong>@DetailsModel.SuggestionOutcomeLabel(suggestion)</strong>
                    <span>@suggestion.EngineKey v@(suggestion.EngineVersion) · @OperatorLabels.OfficeTime(suggestion.OccurredAtUtc) · @suggestion.Disposition.ToString().ToLowerInvariant()</span>
                    @if (suggestion.FailureReason is not null)
                    {
                        <span>@suggestion.FailureReason</span>
                    }
                    @if (suggestion.Disposition == ImageVrmSuggestionDisposition.Pending
                        && suggestion.Outcome == VrmRecognitionOutcomeKind.Suggested)
                    {
                        <form method="post" asp-page-handler="DismissSuggestion" asp-route-id="@Model.Receipt.Id">
                            <input type="hidden" name="suggestionId" value="@suggestion.Id" />
                            <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                            <label for="dismiss-reason-@suggestion.Id">Reason for dismissing this suggestion</label>
                            <textarea id="dismiss-reason-@suggestion.Id" name="reason" maxlength="500" rows="2" required></textarea>
                            <button type="submit" class="secondary-action">Dismiss suggestion</button>
                        </form>
                    }
                </li>
            }
        </ul>
    </section>
}

@if (Model.Receipt.AcceptedCaseId is null)
{
    <section class="panel form-panel section-gap" aria-labelledby="intake-resolution-title">
        <h2 id="intake-resolution-title" class="section-label">Resolution</h2>
        <p>Every correction, block and re-evaluation is versioned and retained in permanent history.</p>

        @* Correcting the detail belongs on the create screen now, where the
           same values are confirmed on the way to a case. It survives here for
           one reason: a blocked item has no other route forward, and deleting
           this form would strand it. The field markup itself lives once, in the
           shared partial both screens render. *@
        @if (Model.Receipt.Decision == IntakeDecision.BlockedIntake)
        {
            <form method="post" asp-page-handler="CorrectDraft" asp-route-id="@Model.Receipt.Id">
                <input type="hidden" name="expectedVersion" value="@Model.Receipt.Version" />
                <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                <label for="correction-reason">Reason for correction</label>
                <textarea id="correction-reason" name="reason" maxlength="500" rows="2" required></textarea>
                <partial name="_InstructionDraftFields" model="Model.DraftFields" />
                <button type="submit" class="primary-action">Record corrected draft</button>
            </form>
        }

        <form method="post" asp-page-handler="Reevaluate" asp-route-id="@Model.Receipt.Id">
            <input type="hidden" name="expectedVersion" value="@Model.Receipt.Version" />
            <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
            <label for="reevaluation-reason">Reason for policy re-evaluation</label>
            <textarea id="reevaluation-reason" name="reason" maxlength="500" rows="2" required></textarea>
            <button type="submit" class="secondary-action">Re-evaluate with current policy</button>
        </form>

        <form method="post" asp-page-handler="Block" asp-route-id="@Model.Receipt.Id">
            <input type="hidden" name="expectedVersion" value="@Model.Receipt.Version" />
            <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
            <label for="block-reason">Reason for blocking</label>
            <textarea id="block-reason" name="reason" maxlength="500" rows="2" required></textarea>
            <button type="submit" class="secondary-action">Block</button>
        </form>
    </section>
}

<section class="panel form-panel section-gap" aria-labelledby="case-association-title">
    <h2 id="case-association-title" class="section-label">Current case association</h2>
    @if (Model.Receipt.CurrentCaseId is { } currentCaseId)
    {
        <p>Currently linked to Case/PO <a asp-page="/Cases/Details" asp-route-id="@currentCaseId">@Model.Receipt.CurrentCaseReference</a>.</p>
    }
    else
    {
        <p>This received item is not currently linked to a case.</p>
    }

    @if (Model.AssociationCandidates.Count > 0 && Model.Receipt.CurrentCaseId is null)
    {
        <p>Eligible pre-report cases with this Image intake's confirmed registration:</p>
        <ul class="plain-list">
            @foreach (var candidate in Model.AssociationCandidates)
            {
                <li>@candidate.CaseReference · case @candidate.CaseId · version @candidate.CaseVersion</li>
            }
        </ul>
    }

    @if (Model.LeasedCaseId is null)
    {
        <form method="post" asp-page-handler="ClaimCaseLease" asp-route-id="@Model.Receipt.Id">
            @if (Model.Receipt.CurrentCaseId is { } associatedCaseId)
            {
                <input type="hidden" name="caseId" value="@associatedCaseId" />
                <p>Enter the current version of Case/PO @Model.Receipt.CurrentCaseReference to enter case edit mode.</p>
            }
            else
            {
                <label for="association-case-id">Case identifier</label>
                <input id="association-case-id" name="caseId" type="text" required />
            }
            <label for="association-case-version">Expected case version</label>
            <input id="association-case-version" name="expectedCaseVersion" type="number" min="0" required />
            <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
            <button type="submit" class="secondary-action">Enter case edit mode</button>
        </form>
    }
    else if (Model.LeasedCaseVersion is { } leasedCaseVersion
        && Model.CaseEditLeaseToken is { } editLeaseToken)
    {
        if (Model.Receipt.CurrentCaseId == Model.LeasedCaseId)
        {
            <form method="post" asp-page-handler="ReverseCaseLink" asp-route-id="@Model.Receipt.Id">
                <input type="hidden" name="caseId" value="@Model.LeasedCaseId" />
                <input type="hidden" name="expectedIntakeVersion" value="@Model.Receipt.Version" />
                <input type="hidden" name="expectedCaseVersion" value="@leasedCaseVersion" />
                <input type="hidden" name="editLeaseToken" value="@editLeaseToken" />
                <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                <label for="reverse-link-reason">Reason for reversing this association</label>
                <textarea id="reverse-link-reason" name="reason" maxlength="500" rows="2" required></textarea>
                <button type="submit" class="secondary-action">Reverse current association</button>
            </form>
        }
        else if (Model.Receipt.CurrentCaseId is null)
        {
            <form method="post" asp-page-handler="LinkCase" asp-route-id="@Model.Receipt.Id">
                <input type="hidden" name="caseId" value="@Model.LeasedCaseId" />
                <input type="hidden" name="expectedIntakeVersion" value="@Model.Receipt.Version" />
                <input type="hidden" name="expectedCaseVersion" value="@leasedCaseVersion" />
                <input type="hidden" name="editLeaseToken" value="@editLeaseToken" />
                <input type="hidden" name="operationKey" value="@Guid.NewGuid().ToString("N")" />
                <label for="link-case-reason">Reason for linking this case</label>
                <textarea id="link-case-reason" name="reason" maxlength="500" rows="2" required></textarea>
                <button type="submit" class="primary-action">Link selected case</button>
            </form>
        }
        else
        {
            <p class="failure-detail">The claimed case does not match the current association; reload and enter edit mode for the current case.</p>
        }
    }
</section>

@if (Model.Receipt.InstructionDraft is not null)
{
    var draft = Model.Receipt.InstructionDraft;
    <section class="panel section-gap" aria-labelledby="typed-draft-title">
        <h2 id="typed-draft-title" class="section-label">Typed review draft</h2>
        <dl class="detail-list">
            <div><dt>Suggested principal</dt><dd>@(draft.SuggestedPrincipalCode ?? "Not suggested")</dd></div>
            <div><dt>Claimant name</dt><dd>@(draft.ClaimantName ?? "Not resolved")</dd></div>
            <div><dt>Claim number</dt><dd>@(draft.ClaimNumber ?? "Not resolved")</dd></div>
            <div><dt>Vehicle registration</dt><dd>@(draft.VehicleRegistration ?? "Not resolved")</dd></div>
            <div><dt>Vehicle make</dt><dd>@(draft.VehicleMake ?? "Not resolved")</dd></div>
            <div><dt>Vehicle model</dt><dd>@(draft.VehicleModel ?? "Not resolved")</dd></div>
            <div><dt>Vehicle mileage</dt><dd>@(draft.VehicleMileage?.ToString("N0") ?? "Not resolved")</dd></div>
            <div><dt>Accident circumstances</dt><dd>@(draft.AccidentCircumstances ?? "Not resolved")</dd></div>
            <div><dt>Date of incident</dt><dd>@(draft.DateOfIncident?.ToString("dd MMM yyyy") ?? "Not resolved")</dd></div>
            <div><dt>Instruction date</dt><dd>@(draft.InstructionDate?.ToString("dd MMM yyyy") ?? "Not resolved")</dd></div>
            <div><dt>Inspection address</dt><dd>@(draft.InspectionAddress ?? "Not resolved")</dd></div>
        </dl>
    </section>
}
<section class="panel form-panel section-gap" aria-labelledby="inspection-address-title">
    <h2 id="inspection-address-title" class="section-label">Inspection-address confirmation</h2>
    @if (Model.ProviderIsImageBased)
    {
        <p>The inspection address is recorded as &ldquo;Image Based Assessment&rdquo; automatically, even if the instruction mentions a physical location; a physical address can still be added afterwards with a reason.</p>
    }
    else if (Model.AddressResolution.Evaluation.Suggestion is { } addressSuggestion)
    {
        @* Read-only here. Settling the address is part of creating the case,
           so it is asked once, on the create screen, alongside everything else
           the same decision depends on. *@
        <dl class="detail-list">
            <div><dt>Address found in the document</dt><dd>@addressSuggestion.Value</dd></div>
            <div><dt>Evidence type</dt><dd>@(addressSuggestion.Kind == Pegasus.Core.Address.InspectionAddressEvidenceKind.ImageBasedAssessment ? "Image Based Assessment instruction" : "Extracted physical address")</dd></div>
            <div><dt>Status</dt><dd>@Pegasus.Web.Pages.Intake.DetailsModel.AddressStateLabel(Model.AddressResolution.State)</dd></div>
            @if (Model.AddressResolution.ResolvedValue is not null)
            {
                <div><dt>Confirmed value</dt><dd>@Model.AddressResolution.ResolvedValue</dd></div>
                <div><dt>Confirmed</dt><dd>@OperatorLabels.OfficeTime(Model.AddressResolution.ResolvedAtUtc, "Not recorded")</dd></div>
            }
        </dl>
        <h3 class="section-label">Source provenance</h3>
        <ul class="plain-list">
            @foreach (var provenance in addressSuggestion.Provenance)
            {
                <li>Extracted from @provenance.SourceLabel</li>
            }
        </ul>
    }
    else if (Model.AddressResolution.ResolvedValue is { } suppliedAddress)
    {
        <dl class="detail-list">
            <div><dt>Inspection address</dt><dd>@suppliedAddress</dd></div>
            <div><dt>Status</dt><dd>@Pegasus.Web.Pages.Intake.DetailsModel.AddressStateLabel(Model.AddressResolution.State)</dd></div>
            <div><dt>Recorded</dt><dd>@OperatorLabels.OfficeTime(Model.AddressResolution.ResolvedAtUtc, "Not recorded")</dd></div>
        </dl>
        <p>Nothing in the file said where the vehicle is, so a member of staff entered this address.</p>
    }
    else
    {
        <p class="failure-detail">Missing or conflicting physical-address evidence remains unresolved; a member of staff can enter the location when the case is created.</p>
        @if (Model.AddressResolution.Evaluation.ConflictingEvidence.Count > 0)
        {
            <ul class="evidence-list">
                @foreach (var evidence in Model.AddressResolution.Evaluation.ConflictingEvidence)
                {
                    <li>
                        <strong>@evidence.Value</strong>
                        <span>@evidence.Provenance.SourceLabel · @evidence.Provenance.Source · @evidence.Provenance.PolicyKey v@evidence.Provenance.PolicyVersion</span>
                    </li>
                }
            </ul>
        }
    }
</section>


@* There is exactly one acceptance caller in the application, and it is not
   here. This screen is the record of what arrived and what was decided about
   it; turning it into a case is a separate screen with its own confirmation,
   reached from this link. *@
@if (Model.CanCreateCase)
{
    <section class="panel section-gap" aria-labelledby="create-case-title">
        <h2 id="create-case-title" class="section-label">Create a case from this item</h2>
        <p>Review the detail that was read from the file, then create the Case/PO when its route and principal are definitive.</p>
        <a class="primary-action" asp-page="/Cases/Create" asp-route-receiptId="@Model.Receipt.Id">Create a case</a>
    </section>
}

@if (Model.Receipt.AssetRecords.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="assets-title">
        <h2 id="assets-title" class="section-label">Source and extracted assets</h2>
        <p>Each attachment, inline image and discrete embedded image remains a separate review occurrence; matching hashes are grouped, not removed.</p>
        <div class="field-grid">
            @foreach (var asset in Model.Receipt.AssetRecords)
            {
                var duplicateCount = Model.DuplicateOccurrenceCount(asset);
                <article class="field-card">
                    <h3>@asset.FileName</h3>
                    @if (asset.Kind == IntakeAssetKind.Source)
                    {
                        <a asp-page="/Intake/Source" asp-route-id="@Model.Receipt.Id">Download retained source</a>
                    }
                    else
                    {
                        <span>Retained evidence occurrence</span>
                    }
                    <small>@asset.SourceLabel · @asset.Kind · @asset.MediaType</small>
                    @if (asset.PageNumber is not null)
                    {
                        <small>PDF page @asset.PageNumber</small>
                    }
                    @if (duplicateCount > 1)
                    {
                        <small>Exact content match: @duplicateCount retained occurrences</small>
                    }
                </article>
            }
        </div>
    </section>
}

@if (Model.Receipt.ScannedPdfPages.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="ocr-title">
        <h2 id="ocr-title" class="section-label">Scanned PDF pages</h2>
        <p>Text review is required only for these scan-like PDF pages:</p>
        <ul class="plain-list">
            @foreach (var candidate in Model.Receipt.ScannedPdfPages)
            {
                <li>@candidate.SourceLabel, page @candidate.PageNumber</li>
            }
        </ul>
    </section>
}

@if (Model.Receipt.Fields.Count > 0)
{
    <section class="panel section-gap" aria-labelledby="fields-title">
        <h2 id="fields-title" class="section-label">Suggested fields</h2>
        <div class="field-grid">
            @foreach (var field in Model.Receipt.Fields)
            {
                <article class="field-card @(field.HasConflict ? "field-card--conflict" : string.Empty)">
                    <h3>@field.Name</h3>
                    <strong>@(field.SuggestedValue ?? (field.HasConflict ? "Conflicting suggestions" : "Not found"))</strong>
                    @if (field.IsDefaulted)
                    {
                        <small>Defaulted from processing date</small>
                    }
                    @foreach (var candidate in field.Candidates)
                    {
                        <small>@candidate.SourceLabel: @candidate.Value</small>
                    }
                </article>
            }
        </div>
    </section>
}

<section class="panel section-gap" aria-labelledby="evidence-title">
    <h2 id="evidence-title" class="section-label">Decision evidence</h2>
    <ul class="evidence-list">
        @foreach (var item in Model.Receipt.Evidence)
        {
            <li><strong>@item.Source</strong><span>@item.Detail</span></li>
        }
    </ul>
</section>
