@page "/Triage/{id:guid}"
@using Pegasus.Core.Triage
@using Pegasus.Web.Presentation
@model Pegasus.Web.Pages.Triage.DetailsModel
@{
    var record = Model.Triage.Record;
    // The Triage now has a permanent reference of its own, so the page is
    // titled by it rather than by the vehicle registration.
    var reference = record.Reference ?? record.NormalizedVehicleRegistration;
    ViewData["Title"] = $"Triage {reference}";

    var mutable = record.State is not (TriageState.Completed or TriageState.Cancelled);
    // The one condition that gates completion, stated once so the control and
    // its wording cannot drift apart.
    var canComplete = record.State == TriageState.FindingRecorded;
    var activeFindings = Model.ActiveFindings;
    var currentFinding = activeFindings.Count == 1 ? activeFindings[0] : null;
    // A finding the determinations form supersedes: the current one while
    // mutable, and — for the post-send correction (FRD-03) — the current one
    // on a Completed record. Cancelled triage must be reopened first (Core).
    var correction = !mutable && record.State == TriageState.Completed && currentFinding is not null;
    var formFinding = mutable || correction ? currentFinding : null;
    var hiddenBase = new Dictionary<string, string?>
    {
        ["expectedVersion"] = record.Version.ToString(System.Globalization.CultureInfo.InvariantCulture),
        ["operationKey"] = Model.OperationKey
    };
}

<header class="page-header">
    <div class="page-title">
        <p class="eyebrow">Triage</p>
        <h1>@reference</h1>
    </div>
    <div class="page-actions">
        <a class="btn" asp-page="/Cases/Index" asp-route-tab="triage">
            <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
            <span>Back to Cases</span>
        </a>
        <form method="get" data-refresh-form>
            <button type="submit" class="btn btn--small" title="Refresh">
                <svg class="icon icon--spin" aria-hidden="true"><use href="#icon-refresh-cw" /></svg>
                <span>Refresh</span>
            </button>
        </form>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="notice mb-2" role="status" aria-live="polite">
        <svg class="icon" aria-hidden="true"><use href="#icon-info" /></svg>
        <span>@Model.Message</span>
    </div>
}

<article class="record">
    <header class="record-head">
        <strong>@reference</strong>
        <span class="record-identity">
            <span>@DetailsModel.SourceChannelLabel(record.Origin.SourceIdentity.Channel)</span>
            <span>Opened @OperatorLabels.OfficeDate(Model.Triage.CreatedAtUtc)</span>
        </span>
        <span class="record-head-end">
            <partial name="Shared/_StatusChip" model="@DetailsModel.StateLabel(record.State)" />
        </span>
    </header>
    <div class="record-accent"></div>

    @* The contract's action bar: what the record is and who holds it. The
       assignment controls sit beside the assignee they change. *@
    <div class="record-bar">
        <span class="eyebrow">Triage</span>
        <span class="muted">@(record.AssigneeId is null ? "Unassigned" : "Assigned")</span>
        @if (mutable)
        {
            <span class="record-bar-end">
                @* The engineer is chosen from the eligible roster, never
                   defaulted to whoever is signed in. The control is drawn only
                   when that roster is available, because an empty picker would
                   offer an assignment it cannot make. *@
                @if (Model.EngineerChoices.Count > 0)
                {
                    <form method="post" asp-page-handler="Action" asp-route-id="@record.Id">
                        <input type="hidden" name="actionName" value="assign" />
                        <input type="hidden" name="expectedVersion" value="@record.Version" />
                        <input type="hidden" name="operationKey" value="@Model.OperationKey" />
                        <label class="req" for="triage-assignee">Engineer</label>
                        <select id="triage-assignee" name="assigneeId" required>
                            <option value=""></option>
                            @foreach (var engineer in Model.EngineerChoices)
                            {
                                <option value="@engineer.StaffId" selected="@(record.AssigneeId == engineer.StaffId ? "selected" : null)">@engineer.DisplayName</option>
                            }
                        </select>
                        <label class="req" for="triage-assign-reason">Reason for action</label>
                        <input id="triage-assign-reason" name="reason" required maxlength="500" />
                        <button type="submit" class="btn">
                            <svg class="icon" aria-hidden="true"><use href="#icon-user" /></svg>
                            <span>@(record.AssigneeId is null ? "Assign" : "Reassign")</span>
                        </button>
                    </form>
                }
                @if (record.AssigneeId is not null)
                {
                    <button type="button" class="btn" data-dialog-open="triage-unassign-dialog">
                        <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                        <span>Unassign</span>
                    </button>
                }
            </span>
        }
    </div>

    <div class="record-body">
        <div class="grid grid-2">
            <section class="panel" aria-labelledby="triage-determinations-title">
                @* On a Completed record the same panel is the post-send
                   correction (FRD-03), so it is named for what it does there
                   rather than splitting a second panel off the §1.5 contract. *@
                <div class="panel-head">
                    <h2 id="triage-determinations-title">@(correction ? "Post-send correction" : "Determinations")</h2>
                </div>
                <div class="panel-body stack">
                    @* One form, three postings: with no active finding it
                       records a new one; with the single active finding — while
                       mutable, or as the post-send correction from Completed
                       (FRD-03) — it supersedes that finding through the same
                       controls refilled, so a correction never overwrites
                       history. Multiple active findings need reconciliation
                       first (Core). *@
                    @if (formFinding is not null || (mutable && activeFindings.Count == 0))
                    {
                        <form method="post" asp-page-handler="Action" asp-route-id="@record.Id" class="stack">
                            <input type="hidden" name="expectedVersion" value="@record.Version" />
                            <input type="hidden" name="operationKey" value="@Model.OperationKey" />
                            @if (formFinding is not null)
                            {
                                <input type="hidden" name="supersedesFindingId" value="@formFinding.Id" />
                            }
                            <div class="field">
                                <label for="triage-roadworthiness">Roadworthiness</label>
                                <select id="triage-roadworthiness" name="roadworthiness">
                                    <option value="" selected="@(formFinding?.Roadworthiness is null ? "selected" : null)">Not recorded</option>
                                    <option value="Roadworthy" selected="@(formFinding?.Roadworthiness == RoadworthinessFinding.Roadworthy ? "selected" : null)">Roadworthy</option>
                                    <option value="Unroadworthy" selected="@(formFinding?.Roadworthiness == RoadworthinessFinding.Unroadworthy ? "selected" : null)">Unroadworthy</option>
                                </select>
                            </div>
                            <div class="field">
                                <label for="triage-repair-outcome">Repair outcome</label>
                                <select id="triage-repair-outcome" name="assessment">
                                    <option value="" selected="@(formFinding?.Assessment is null ? "selected" : null)">Not recorded</option>
                                    <option value="Repairable" selected="@(formFinding?.Assessment == AssessmentFinding.Repairable ? "selected" : null)">Repairable</option>
                                    <option value="TotalLoss" selected="@(formFinding?.Assessment == AssessmentFinding.TotalLoss ? "selected" : null)">Total loss</option>
                                </select>
                            </div>
                            <div class="field">
                                <label class="req" for="triage-finding-reason">Reason</label>
                                <textarea id="triage-finding-reason" name="reason" rows="3" required maxlength="500"></textarea>
                            </div>
                            <div class="button-row">
                                <button type="submit" name="actionName"
                                        value="@(formFinding is null ? "record_finding" : "supersede_finding")"
                                        class="btn btn--primary">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-save" /></svg>
                                    <span>@(correction ? "Record correction" : "Save determinations")</span>
                                </button>
                            </div>
                        </form>
                    }
                    else if (mutable)
                    {
                        <div class="notice notice--warning" role="alert">
                            <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                            <span>Multiple active findings require reconciliation before another finding can be recorded.</span>
                        </div>
                    }
                    else if (currentFinding is not null)
                    {
                        @* A terminal record with no correction offered shows
                           the accepted finding as facts. *@
                        <div class="definition-list">
                            <dl class="definition">
                                <dt>Roadworthiness</dt>
                                <dd>@(currentFinding.Roadworthiness is { } roadworthiness
                                    ? DetailsModel.RoadworthinessLabel(roadworthiness) : "Not recorded")</dd>
                            </dl>
                            <dl class="definition">
                                <dt>Repair outcome</dt>
                                <dd>@(currentFinding.Assessment is { } assessment
                                    ? DetailsModel.AssessmentLabel(assessment) : "Not recorded")</dd>
                            </dl>
                        </div>
                    }

                    @if (mutable)
                    {
                        @* The workflow transitions, each a reason dialog over
                           the same handler the old action bar posted. Only the
                           ones Core permits from this state render. *@
                        <div class="button-row">
                            @if (record.State is TriageState.Open or TriageState.FindingRecorded)
                            {
                                <button type="button" class="btn" data-dialog-open="triage-await-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-clock" /></svg>
                                    <span>Await information</span>
                                </button>
                            }
                            @* Complete keeps its place, disabled, with its
                               condition named on the control: QdosTriage-
                               IntegrationTests.cs:216-221 pins that shape, and
                               the merged Cases/Details.cshtml:269 and
                               Assessment/Index.cshtml:765 gate the same way. It
                               posts the same `complete` action either way, so
                               it is not an inert control. D7's stricter clause
                               (a disabled control is permitted only for a
                               named, ticketed integration seam) reads against
                               that merged convention — raised for the epic
                               owner as UIIMP-012, not settled here. *@
                            <span class="gated" data-condition="@(canComplete ? null : "Available once a finding is recorded")">
                                <button type="button"
                                        class="btn @(canComplete ? string.Empty : "is-disabled")"
                                        data-dialog-open="@(canComplete ? "triage-complete-dialog" : null)"
                                        disabled="@(canComplete ? null : "disabled")">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-check" /></svg>
                                    <span>Complete Triage</span>
                                </button>
                            </span>
                            <button type="button" class="btn btn--danger" data-dialog-open="triage-cancel-dialog">
                                <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                                <span>Cancel Triage</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="button-row">
                            <button type="button" class="btn" data-dialog-open="triage-reopen-dialog">
                                <svg class="icon" aria-hidden="true"><use href="#icon-play" /></svg>
                                <span>Reopen</span>
                            </button>
                        </div>
                    }
                </div>
            </section>

            <section class="panel" aria-labelledby="triage-source-title">
                <div class="panel-head"><h2 id="triage-source-title">Source</h2></div>
                <div class="panel-body stack">
                    <div class="definition-list">
                        <dl class="definition">
                            <dt>@OperatorLabels.TriageReference</dt>
                            <dd>@reference</dd>
                        </dl>
                        <dl class="definition">
                            <dt>Registration</dt>
                            <dd>@record.NormalizedVehicleRegistration</dd>
                        </dl>
                        <dl class="definition">
                            <dt>@OperatorLabels.Principal</dt>
                            <dd>@(Model.Triage.PrincipalCode ?? OperatorLabels.PrincipalNotKnown)</dd>
                        </dl>
                        <dl class="definition">
                            <dt>Material</dt>
                            <dd>@DetailsModel.SourceChannelLabel(record.Origin.SourceIdentity.Channel)</dd>
                        </dl>
                        <dl class="definition">
                            <dt>Received</dt>
                            <dd>@OperatorLabels.OfficeTime(Model.Triage.CreatedAtUtc)</dd>
                        </dl>
                        <dl class="definition">
                            <dt>Case link</dt>
                            <dd>
                                @if (record.LinkedCaseId is { } linkedCaseId)
                                {
                                    <a asp-page="/Cases/Details" asp-route-id="@linkedCaseId">Open the case</a>
                                }
                                else
                                {
                                    @:None
                                }
                            </dd>
                        </dl>
                    </div>
                    @if (Model.CaseAssociationUnavailableReason is { } unavailableReason)
                    {
                        <div class="notice notice--warning" role="status">
                            <svg class="icon" aria-hidden="true"><use href="#icon-alert-triangle" /></svg>
                            <span>@unavailableReason</span>
                        </div>
                    }
                    else if (mutable)
                    {
                        <div class="button-row">
                            @if (record.LinkedCaseId is null)
                            {
                                <button type="button" class="btn" data-dialog-open="triage-link-case-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-link" /></svg>
                                    <span>Link case</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn" data-dialog-open="triage-unlink-case-dialog">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                                    <span>Unlink case</span>
                                </button>
                            }
                        </div>
                    }
                    <div class="button-row">
                        <a class="btn" asp-page="/Intake/Details" asp-route-id="@record.Origin.ReceiptId">
                            <svg class="icon" aria-hidden="true"><use href="#icon-eye" /></svg>
                            <span>View retained source</span>
                        </a>
                    </div>
                </div>
            </section>
        </div>

        @if (Model.EvidenceImages.Count > 0)
        {
            <section class="section-gap" aria-labelledby="triage-images-title">
                <div class="blockhead"><h2 id="triage-images-title">Vehicle images</h2></div>
                @{
                    var triageGallery = Model.EvidenceImages
                        .Select(asset =>
                        {
                            // A retained receipt asset is already served inline, so
                            // preview and download are the same authorised URL --
                            // the coincidence GalleryImage documents (DOCS-011).
                            var href = Url.Page(
                                "/Intake/Asset",
                                new { id = record.Origin.ReceiptId, assetId = asset.Id })!;
                            return new Pegasus.Web.Presentation.GalleryImage(
                                href,
                                href,
                                asset.FileName,
                                asset.MediaType);
                        })
                        .ToArray();
                }
                <partial name="Shared/_ImageGallery" model="triageGallery" />
            </section>
        }

        @* Exact response evidence keeps its handlers; the panel renders only
           when there is something linked or something to link — both can be
           true at once. *@
        @if (Model.Triage.ResponseEvidence.Count > 0 || (mutable && Model.Triage.ResponseEvidenceCandidates.Count > 0))
        {
            <section class="panel section-gap" aria-labelledby="triage-response-title">
                <div class="panel-head"><h2 id="triage-response-title">Exact response evidence</h2></div>
                <div class="panel-body stack">
                    @if (Model.Triage.ResponseEvidence.Count > 0)
                    {
                        <div class="timeline">
                            @foreach (var evidence in Model.Triage.ResponseEvidence)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-title">@OperatorLabels.OfficeTime(evidence.LinkedAtUtc)</div>
                                    <div class="timeline-text">@evidence.Reason</div>
                                </div>
                            }
                        </div>
                        @if (mutable)
                        {
                            var linkedResponse = Model.Triage.ResponseEvidence[0];
                            <form method="post" asp-page-handler="Action" asp-route-id="@record.Id" class="stack">
                                <input type="hidden" name="expectedVersion" value="@record.Version" />
                                <input type="hidden" name="operationKey" value="@Model.OperationKey" />
                                <input type="hidden" name="sentEvidenceId" value="@linkedResponse.SentEvidenceId" />
                                <div class="field">
                                    <label class="req" for="triage-unlink-response-reason">Reason</label>
                                    <textarea id="triage-unlink-response-reason" name="reason" rows="3" required maxlength="500"></textarea>
                                </div>
                                <div class="button-row">
                                    <button type="submit" name="actionName" value="unlink_response" class="btn">
                                        <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                                        <span>Unlink response</span>
                                    </button>
                                </div>
                            </form>
                        }
                    }
                    @if (mutable && Model.Triage.ResponseEvidenceCandidates.Count > 0)
                    {
                        <form method="post" asp-page-handler="Action" asp-route-id="@record.Id" class="stack">
                            <input type="hidden" name="expectedVersion" value="@record.Version" />
                            <input type="hidden" name="operationKey" value="@Model.OperationKey" />
                            <div class="field">
                                <label class="req" for="triage-response-candidate">Approved-mailbox reply</label>
                                <select id="triage-response-candidate" name="responseCandidate" required>
                                    <option value="">Select exact response evidence</option>
                                    @foreach (var candidate in Model.Triage.ResponseEvidenceCandidates)
                                    {
                                        <option value="@candidate.PollOutcomeId|@candidate.SentEvidenceId">
                                            @OperatorLabels.OfficeTime(candidate.SentAtUtc) —
                                            @candidate.MailboxAddress —
                                            message @candidate.InternetMessageIdentity —
                                            Sent evidence @candidate.SentEvidenceId
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label class="req" for="triage-response-reason">Reason</label>
                                <textarea id="triage-response-reason" name="reason" rows="3" required maxlength="500"></textarea>
                            </div>
                            <div class="button-row">
                                <button type="submit" name="actionName" value="link_response" class="btn btn--dark">
                                    <svg class="icon" aria-hidden="true"><use href="#icon-link" /></svg>
                                    <span>Record and link exact response</span>
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </section>
        }

        @* The panel is "Notes" (EPIC-011 §1.5). Its entries are still the one
           permanent, attributed, versioned history: an operator note is an
           entry in that stream, not a second, editable record beside it. The
           entry shape (Date/Time/ID + text) is unchanged. *@
        <section class="panel section-gap" aria-labelledby="triage-history-title">
            <div class="panel-head"><h2 id="triage-history-title">Notes</h2></div>
            <div class="panel-body">
                @if (mutable)
                {
                    <form method="post" asp-page-handler="Action" asp-route-id="@record.Id" class="stack">
                        <input type="hidden" name="actionName" value="note" />
                        <input type="hidden" name="expectedVersion" value="@record.Version" />
                        <input type="hidden" name="operationKey" value="@Model.OperationKey" />
                        <input type="hidden" name="reason" value="Operator note" />
                        <div class="field">
                            <label class="req" for="triage-note">Note</label>
                            @* The bound is Core's, so the form cannot offer
                               more than the history entry accepts. *@
                            <textarea id="triage-note" name="note" rows="3" required maxlength="@TriageNotes.MaximumLength"></textarea>
                        </div>
                        <div class="button-row">
                            <button type="submit" class="btn btn--dark">
                                <svg class="icon" aria-hidden="true"><use href="#icon-plus" /></svg>
                                <span>Add note</span>
                            </button>
                        </div>
                    </form>
                }
                <div class="notes-list">
                    @foreach (var entry in Model.Triage.History.OrderByDescending(history => history.OccurredAtUtc))
                    {
                        <div class="note-entry">
                            <div class="note-meta">
                                <span>Date @OperatorLabels.OfficeDate(entry.OccurredAtUtc)</span>
                                <span>Time @OperatorLabels.OfficeClock(entry.OccurredAtUtc)</span>
                                <span>ID @entry.ActorDisplayName</span>
                            </div>
                            <div>@DetailsModel.EventLabel(entry.EventType): @entry.Reason</div>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
</article>

<partial name="Shared/_EvidenceViewer" />

@if (mutable)
{
    @* Assignment is an inline choice from the eligible roster, so it has no
       dialog. Unassignment removes a person's hold on the record and keeps
       its reasoned confirmation. *@
    @if (record.AssigneeId is not null)
    {
        <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["DialogId"] = "triage-unassign-dialog",
            ["DialogTitle"] = "Unassign",
            ["DialogActionUrl"] = Url.Page("/Triage/Details", "Action", new { id = record.Id }),
            ["DialogHiddenFields"] = new Dictionary<string, string?>(hiddenBase) { ["actionName"] = "unassign" }
        })" />
    }

    @if (record.State is TriageState.Open or TriageState.FindingRecorded)
    {
        <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["DialogId"] = "triage-await-dialog",
            ["DialogTitle"] = "Await information",
            ["DialogActionUrl"] = Url.Page("/Triage/Details", "Action", new { id = record.Id }),
            ["DialogHiddenFields"] = new Dictionary<string, string?>(hiddenBase) { ["actionName"] = "await_information" }
        })" />
    }
    @if (canComplete)
    {
        <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["DialogId"] = "triage-complete-dialog",
            ["DialogTitle"] = "Complete Triage",
            ["DialogActionUrl"] = Url.Page("/Triage/Details", "Action", new { id = record.Id }),
            ["DialogHiddenFields"] = new Dictionary<string, string?>(hiddenBase) { ["actionName"] = "complete" }
        })" />
    }
    <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
    {
        ["DialogId"] = "triage-cancel-dialog",
        ["DialogTitle"] = "Cancel Triage",
        ["DialogConsequence"] = "Cancelled Triage can be reopened with a reason.",
        ["DialogActionUrl"] = Url.Page("/Triage/Details", "Action", new { id = record.Id }),
        ["DialogHiddenFields"] = new Dictionary<string, string?>(hiddenBase) { ["actionName"] = "cancel" }
    })" />

    @if (Model.CaseAssociationUnavailableCaseId is null && record.LinkedCaseId is null)
    {
        <div class="dialog-backdrop" data-dialog="triage-link-case-dialog" hidden>
            <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="triage-link-case-dialog-title">
                <div class="dialog-head">
                    <h2 id="triage-link-case-dialog-title" tabindex="-1">Link case</h2>
                    <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">
                        <svg class="icon" aria-hidden="true"><use href="#icon-x" /></svg>
                    </button>
                </div>
                <form method="post" asp-page-handler="Action" asp-route-id="@record.Id">
                    <input type="hidden" name="expectedVersion" value="@record.Version" />
                    <input type="hidden" name="operationKey" value="@Model.OperationKey" />
                    <input type="hidden" name="actionName" value="link_case" />
                    <div class="dialog-body stack">
                        <div class="field">
                            <label class="req" for="triage-link-case-id">Case ID</label>
                            <input id="triage-link-case-id" name="caseId" required maxlength="100" data-dialog-initial-focus />
                        </div>
                        <div class="field">
                            <label class="req" for="triage-link-case-reason">Reason for action</label>
                            <textarea id="triage-link-case-reason" name="reason" rows="3" required maxlength="500"></textarea>
                        </div>
                    </div>
                    <div class="dialog-foot">
                        <button type="button" class="btn" data-dialog-close>Cancel</button>
                        <button type="submit" class="btn btn--primary">Link case</button>
                    </div>
                </form>
            </section>
        </div>
    }
    else if (Model.CaseAssociationUnavailableCaseId is null && record.LinkedCaseId is { } linkedCaseForUnlink)
    {
        <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["DialogId"] = "triage-unlink-case-dialog",
            ["DialogTitle"] = "Unlink case",
            ["DialogActionUrl"] = Url.Page("/Triage/Details", "Action", new { id = record.Id }),
            ["DialogHiddenFields"] = new Dictionary<string, string?>(hiddenBase)
            {
                ["actionName"] = "unlink_case",
                ["caseId"] = linkedCaseForUnlink.ToString()
            }
        })" />
    }
}
else
{
    <partial name="Shared/_ReasonDialog" view-data="@(new ViewDataDictionary(ViewData)
    {
        ["DialogId"] = "triage-reopen-dialog",
        ["DialogTitle"] = "Reopen",
        ["DialogActionUrl"] = Url.Page("/Triage/Details", "Action", new { id = record.Id }),
        ["DialogHiddenFields"] = new Dictionary<string, string?>(hiddenBase) { ["actionName"] = "reopen" }
    })" />
}
