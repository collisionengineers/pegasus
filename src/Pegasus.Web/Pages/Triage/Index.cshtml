@page "/Triage"
@model Pegasus.Web.Pages.Triage.IndexModel
@{
    ViewData["Title"] = "Triage queue";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Triage</p>
        <h1>@(Model.State is null ? "Triage queue" : IndexModel.StateLabel(Model.State.Value))</h1>
        <p class="lede">Intake-backed vehicle assessments requiring review or follow-up.</p>
    </div>
</header>

<nav class="queue-filters" aria-label="Triage filters">
    <a asp-page="/Triage/Index">All</a>
    <a asp-page="/Triage/Index" asp-route-state="open">Open</a>
    <a asp-page="/Triage/Index" asp-route-state="awaiting_information">Awaiting information</a>
    <a asp-page="/Triage/Index" asp-route-state="finding_recorded">Finding recorded</a>
    <a asp-page="/Triage/Index" asp-route-state="completed">Completed</a>
    <a asp-page="/Triage/Index" asp-route-state="cancelled">Cancelled</a>
</nav>

<section class="panel">
    @if (Model.Results.Items.Count == 0)
    {
        <p class="empty-state">No triage records match this view.</p>
    }
    else
    {
        <div class="queue-list">
            @foreach (var item in Model.Results.Items)
            {
                <a asp-page="/Triage/Details" asp-route-id="@item.Id">
                    <span>
                        <strong>@item.NormalizedVehicleRegistration</strong>
                        <small>Opened @item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>
                    </span>
                    <span>
                        <strong>@IndexModel.StateLabel(item.State)</strong>
                        <small>@(item.AssigneeId is null ? "Unassigned" : $"Assigned: {item.AssigneeId}")</small>
                    </span>
                </a>
            }
        </div>
    }
</section>

@if (Model.Results.TotalPages > 1)
{
    <nav class="queue-filters" aria-label="Triage pages">
        @if (Model.Results.Page > 1)
        {
            <a asp-page="/Triage/Index" asp-route-state="@Model.StateFilter" asp-route-page="@(Model.Results.Page - 1)">Previous</a>
        }
        <span>Page @Model.Results.Page of @Model.Results.TotalPages</span>
        @if (Model.Results.Page < Model.Results.TotalPages)
        {
            <a asp-page="/Triage/Index" asp-route-state="@Model.StateFilter" asp-route-page="@(Model.Results.Page + 1)">Next</a>
        }
    </nav>
}
