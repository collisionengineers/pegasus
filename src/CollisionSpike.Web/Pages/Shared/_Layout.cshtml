<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Collision Engineers</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-nav">
        <div class="nav-inner">
            <a class="navbar-brand" asp-area="" asp-page="/Index"><span class="brand-mark">CE</span><span>Collision Engineers</span></a>
            <nav class="nav-links" aria-label="Primary">
                <a class="nav-link" asp-area="" asp-page="/Index">Case intake</a>
                <a class="nav-link" asp-area="" asp-page="/Privacy">Privacy</a>
            </nav>
        </div>
    </header>
    <div class="app-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="footer-inner">
            Collision Engineers case management
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
