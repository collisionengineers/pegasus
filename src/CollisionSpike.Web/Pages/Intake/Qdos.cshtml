@page
@model CollisionSpike.Web.Pages.Intake.QdosModel
@{
    ViewData["Title"] = "Upload QDOS instruction";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Manual intake</p>
        <h1>Upload QDOS instruction</h1>
        <p class="lede">Choose an Outlook email or PDF instruction, up to 10 MB.</p>
    </div>
    <a class="secondary-action" asp-page="/Intake/Queue">View intake queue</a>
</header>

<section class="panel form-panel" aria-labelledby="upload-title">
    <h2 id="upload-title" class="section-label">Instruction source</h2>
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Upload">Email or PDF</label>
        <input asp-for="Upload" type="file" accept=".eml,.pdf,message/rfc822,application/pdf" />
        <span asp-validation-for="Upload" class="field-validation"></span>
        <label>
            <input asp-for="CaseCreationAuthorized" type="checkbox" />
            I confirm this is a new QDOS instruction and authorise creation of its case and QDOS reference.
        </label>
        <span asp-validation-for="CaseCreationAuthorized" class="field-validation"></span>
        <button type="submit" class="primary-action">Process confirmed instruction</button>
    </form>
</section>
