@page
@model CollisionSpike.Web.Pages.Intake.QueueModel
@{
    ViewData["Title"] = "Intake queue";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Intake</p>
        <h1>@(Model.Decision is null ? "Intake queue" : ReviewModel.DecisionLabel(Model.Decision.Value))</h1>
        <p class="lede">Recent manual QDOS intake receipts requiring review or follow-up.</p>
    </div>
    <a class="primary-action" asp-page="/Intake/Qdos">Upload QDOS instruction</a>
</header>

<nav class="queue-filters" aria-label="Intake filters">
    <a asp-page="/Intake/Queue">All</a>
    <a asp-page="/Intake/Queue" asp-route-decision="ConfirmedQdos">Review</a>
    <a asp-page="/Intake/Queue" asp-route-decision="NeedsSorting">Needs sorting</a>
</nav>

<section class="panel">
    @if (Model.Items.Count == 0)
    {
        <p class="empty-state">No intake receipts match this view.</p>
    }
    else
    {
        <div class="queue-list">
            @foreach (var item in Model.Items)
            {
                <a asp-page="/Intake/Review" asp-route-id="@item.Id">
                    <span><strong>@item.SourceFileName</strong><small>@item.ReceivedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small></span>
                    <span><strong>@ReviewModel.DecisionLabel(item.Decision)</strong><small>@item.FailureReason</small></span>
                </a>
            }
        </div>
    }
</section>
