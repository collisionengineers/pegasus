@page
@model IndexModel
@{
    ViewData["Title"] = "Case intake";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Overview</p>
        <h1>Case intake</h1>
        <p class="lede">The operator workspace is ready for the first QDOS workflow.</p>
    </div>
    <div class="updated">Updated <time datetime="@Model.LoadedAtUtc.ToString("O")">@Model.LoadedAtUtc.ToLocalTime().ToString("HH:mm")</time></div>
</header>

<section aria-labelledby="case-queues-title">
    <h2 id="case-queues-title" class="section-label">Case queues</h2>
    <div class="queue-grid">
        <article class="queue-card queue-card--amber">
            <span class="queue-icon" aria-hidden="true">!</span>
            <div><strong>0</strong><span>Not ready</span></div>
            <span class="arrow" aria-hidden="true">›</span>
        </article>
        <article class="queue-card queue-card--blue">
            <span class="queue-icon" aria-hidden="true">◉</span>
            <div><strong>0</strong><span>Review</span></div>
            <span class="arrow" aria-hidden="true">›</span>
        </article>
        <article class="queue-card queue-card--red">
            <span class="queue-icon" aria-hidden="true">!</span>
            <div><strong>0</strong><span>Held</span></div>
            <span class="arrow" aria-hidden="true">›</span>
        </article>
    </div>
</section>

<div class="dashboard-grid">
    <section class="panel" aria-labelledby="inbox-title">
        <h2 id="inbox-title" class="section-label">Inbox</h2>
        <div class="tile-grid">
            <article class="metric-tile"><span>▣</span><div><strong>0</strong><small>Receiving work</small></div></article>
            <article class="metric-tile"><span>✉</span><div><strong>0</strong><small>Queries</small></div></article>
            <article class="metric-tile"><span>□</span><div><strong>0</strong><small>Other</small></div></article>
            @if (Model.LocalQdosIntakeEnabled)
            {
                <a class="metric-tile" asp-page="/Intake/Queue" asp-route-decision="DraftReady"><span>▤</span><div><strong>@Model.Counts.DraftReady</strong><small>QDOS drafts</small></div></a>
                <a class="metric-tile metric-tile--attention" asp-page="/Intake/Queue" asp-route-decision="NeedsSorting"><span>!</span><div><strong>@Model.Counts.NeedsSorting</strong><small>Needs sorting</small></div></a>
            }
            else
            {
                <article class="metric-tile metric-tile--attention"><span>!</span><div><strong>0</strong><small>Needs sorting</small></div></article>
            }
        </div>
    </section>
    <section class="panel" aria-labelledby="today-title">
        <h2 id="today-title" class="section-label">Today / this week</h2>
        <div class="tile-grid tile-grid--wide">
            <article class="metric-tile"><span>▱</span><div><strong>0</strong><small>Due today</small></div></article>
            <article class="metric-tile"><span>↗</span><div><strong>0</strong><small>Submitted today</small></div></article>
            <article class="metric-tile metric-tile--span"><span>▦</span><div><strong>0</strong><small>Cleared this week</small></div></article>
        </div>
    </section>
</div>
