# Local runs: copy to .env (ignored). In Azure these are app settings.
# The Anthropic key is Infisical pegasus_anthropic_api_key; in Azure it is the
# Key Vault secret anthropic-api-key.
ANTHROPIC_API_KEY=your_api_key_here

PEGASUS_MCP_URL=https://<pegasus web origin>/mcp
PEGASUS_TOKEN_URL=https://<pegasus web origin>/connect/token
PEGASUS_CLIENT_ID=pegasus-automation
PEGASUS_CLIENT_SECRET=

CLASSIFIER_MODEL=claude-sonnet-5-5
# true reads and decides but writes nothing to Pegasus or the reviewed table.
CLASSIFIER_DRY_RUN=true
CLASSIFIER_CRON=0 */15 * * * *
CLASSIFIER_BATCH=20
CLASSIFIER_SCAN_PAGES=10
CLASSIFIER_MAX_BUDGET_USD=2

# Unset locally: the reviewed record is kept in memory for the run.
CLASSIFIER_STORAGE_ACCOUNT=
AZURE_CLIENT_ID=
