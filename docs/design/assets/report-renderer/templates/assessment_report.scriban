<!doctype html><html lang="en"><head><meta charset="utf-8"><title>{{ title }}</title><style>{{ css }}</style></head>
<body><header class="document-header"><img class="logo" src="{{ logo }}" alt="Collision Engineers Ltd"><table class="reference-table"><tbody><tr><th>Date:</th><td>{{ date }}</td></tr><tr><th>Our Ref:</th><td>{{ our_ref }}</td></tr><tr><th>Your Ref:</th><td>{{ your_ref }}</td></tr></tbody></table></header>
<h1 class="title red report-title">{{ title }}</h1><div class="red-rule"></div><div class="report-for"><strong>Report For:</strong><br>{{ report_for }}</div><p><strong>Matter:</strong> Road Traffic Accident: {{ claimant }}: {{ incident_date }}</p>
<div class="badges"><span class="badge">{{ badge }}</span><span class="badge legal">{{ legal_badge }}</span></div><div class="tiles">{{ tiles }}</div>
<p>{{ introduction }}</p><section class="section"><h2>Vehicle Details</h2><table class="data-table"><tbody>{{ vehicle_rows }}</tbody></table></section>
{{ desktop_assessment }}<section class="section"><h2>Nature of Incident</h2><p>{{ nature }}</p></section><section class="section"><h2>Damage</h2><table><thead><tr><th>Zone</th><th>Severity</th><th>Note</th></tr></thead><tbody>{{ impact_rows }}</tbody></table><table class="data-table"><tbody>{{ damage_rows }}</tbody></table></section><section class="section"><h2>Tyres and Seat Belts</h2><table class="data-table"><tbody>{{ restraint_rows }}</tbody></table></section><section class="section"><h2>Engineer's Comments</h2>{{ engineer_comments }}</section>
<section class="section"><h2>Vehicle History Check</h2><p>{{ history }}</p></section><section class="section"><h2>Pre-Incident Condition</h2><p>{{ condition_text }}</p></section>
<section class="section"><h2>{{ settlement_heading }}</h2><p>{{ settlement_text }}</p><table class="value-box"><tbody><tr><td>{{ settlement_label }}</td><td class="value">{{ settlement_value }}</td></tr></tbody></table><table class="data-table"><tbody>{{ settlement_rows }}</tbody></table></section>{{ salvage }}
<div class="page-break"></div><section class="section"><h2>Vehicle Data</h2><table class="data-table"><tbody>{{ vehicle_data_rows }}</tbody></table>{{ valuation_commentary }}</section>
<section class="section"><h2>Repair Cost Calculation</h2><table><thead><tr><th>Item</th><th class="price">Amount</th></tr></thead><tbody>{{ cost_rows }}</tbody></table></section>
<div class="page-break"></div>{{ worklists }}
<div class="page-break"></div><section class="section"><h2>Vehicle Images</h2><div class="photo-grid">{{ photos }}</div></section>
<div class="page-break"></div><section class="section"><h2>Statement of Truth</h2>{{ statement_of_truth }}</section>
<section class="sig-block"><p class="sig-closing">Yours faithfully,</p><img class="sig-img" src="{{ signature }}" alt="Signature"><p class="sig-name">{{ engineer }}{{ if qualifications }} — {{ qualifications }}{{ end }}</p><p class="sig-role">Independent Automotive Engineer, Collision Engineers Ltd</p><p>Engineers@CollisionEngineers.co.uk</p></section>
</body></html>
