<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Fee Note</title><style>{{ css }}</style></head>
<body><header class="document-header"><img class="logo" src="{{ logo }}" alt="Collision Engineers Ltd"><div><strong>Collision Engineers Ltd</strong><br>Independent Automotive Experts<br>VAT No: {{ vat_number }}<br>Engineers@CollisionEngineers.co.uk<br>www.CollisionEngineers.co.uk</div></header>
<h1 class="title red">FEE NOTE</h1><div class="red-rule"></div><div class="fee-meta"><div class="billto"><div class="lab">Bill To:</div>{{ report_for }}</div><div class="fee-rows"><span class="k">Date:</span><span>{{ date }}</span><span class="k">Our Ref:</span><span>{{ our_ref }}</span><span class="k">Your Ref:</span><span>{{ your_ref }}</span><span class="k">Matter:</span><span>Road Traffic Accident: {{ claimant }}: {{ incident_date }}</span></div></div>
<table class="fee-table"><thead><tr><th>Description</th><th class="amt">Amount (£)</th></tr></thead><tbody><tr><td><strong>Vehicle Damage Assessment Report — {{ registration }}</strong>{{ fee_rows }}</td><td class="amt">{{ fee_net_number }}</td></tr></tbody></table>
<div class="fee-totals"><div class="r"><span>Subtotal (Net)</span><span>{{ fee_net_number }}</span></div><div class="r"><span>VAT @ 20%</span><span>{{ fee_vat_number }}</span></div><div class="r total"><span>TOTAL DUE</span><span>{{ fee_total }}</span></div></div>
<section class="section"><h2>Payment Details</h2><div class="pay-grid"><span class="k">Account Name</span><span>{{ account_name }}</span><span class="k">Bank</span><span>{{ bank }}</span><span class="k">Sort Code</span><span>{{ sort_code }}</span><span class="k">Account Number</span><span>{{ account_number }}</span><span class="k">Payment Reference</span><span>{{ our_ref }}</span><span class="k">Remittance Email</span><span>{{ remittance_email }}</span></div></section>
<section class="section"><h2>Terms</h2><p class="fee-notes">{{ fee_terms }}</p><p class="fee-notes">{{ additional_fee_terms }}</p></section><p><strong>Thank you for your business.</strong></p>
</body></html>
