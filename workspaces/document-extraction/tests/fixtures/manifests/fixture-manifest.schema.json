{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collisiondocnet.local/schemas/fixture-manifest.schema.json",
  "title": "CollisionDocNet fixture manifest",
  "type": "object",
  "required": ["manifestId", "fixtures"],
  "properties": {
    "manifestId": { "type": "string", "minLength": 1 },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "relativePath",
          "sha256",
          "byteLength",
          "provenance",
          "licence",
          "piiClass",
          "detectedFormat",
          "features",
          "expectedOutcome",
          "portUnits",
          "lanes"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "relativePath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "byteLength": { "type": "integer", "minimum": 0 },
          "provenance": { "type": "string", "minLength": 1 },
          "upstreamRevision": { "type": "string" },
          "licence": { "type": "string", "minLength": 1 },
          "piiClass": { "enum": ["none", "synthetic", "de-identified", "private-local"] },
          "publicationAllowed": { "type": "boolean" },
          "detectedFormat": { "type": "string", "minLength": 1 },
          "features": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "expectedOutcome": {
            "enum": [
              "complete",
              "partial",
              "encrypted",
              "corrupt",
              "unsupported-format",
              "unsupported-feature",
              "resource-limit-exceeded",
              "cancelled",
              "timed-out",
              "technical-failure"
            ]
          },
          "portUnits": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^EXT-[A-Z0-9]+-[0-9]{3}$" }
          },
          "lanes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^T[0-9]+$" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
