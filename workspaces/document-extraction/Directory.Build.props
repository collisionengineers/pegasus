<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">alpha.1</VersionSuffix>
    <Authors Condition="'$(Authors)' == ''">CollisionDocNetExtractor contributors</Authors>
    <Product Condition="'$(Product)' == ''">CollisionDocNetExtractor</Product>
    <PackageDescription Condition="'$(PackageDescription)' == ''">Custom managed, server-safe evidence extraction component for the CollisionDocNetExtractor product.</PackageDescription>
    <PackageTags Condition="'$(PackageTags)' == ''">document;extraction;pdf;doc;docx;msg;eml;headless</PackageTags>
    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == ''">PACKAGE.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <CollisionDocNetRepositoryRoot Condition="'$(CollisionDocNetRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)</CollisionDocNetRepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(CollisionDocNetRepositoryRoot)PACKAGE.md"
          Pack="true"
          PackagePath="/"
          Visible="false" />
  </ItemGroup>
</Project>
