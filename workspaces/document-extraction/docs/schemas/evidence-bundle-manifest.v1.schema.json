{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.collisiondocnet.local/evidence-bundle-manifest.v1.schema.json",
  "title": "CollisionDocNetExtractor evidence bundle manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "result", "assetFiles"],
  "properties": {
    "schemaVersion": { "const": "collisiondocnet-bundle/1" },
    "result": { "$ref": "extraction-result.v1.schema.json" },
    "assetFiles": {
      "description": "Materialised image files only; the legacy property name is retained by schema version 1.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stableId", "path", "sha256", "length"],
        "properties": {
          "stableId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "path": { "type": "string", "pattern": "^assets/[A-Za-z0-9._-]+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "length": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
