{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collisiondocnet.local/schemas/provenance-manifest.schema.json",
  "title": "CollisionDocNet extraction port-unit provenance manifest",
  "type": "object",
  "required": [
    "portUnit",
    "managedPaths",
    "upstreamInputs",
    "specificationInputs",
    "implementationDecision",
    "licenceReviewStatus"
  ],
  "properties": {
    "portUnit": {
      "type": "string",
      "pattern": "^EXT-[A-Z0-9]+-[0-9]{3}$"
    },
    "managedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "upstreamInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository", "revision", "path", "notice"],
        "properties": {
          "repository": { "type": "string", "format": "uri" },
          "revision": { "type": "string", "minLength": 7 },
          "path": { "type": "string" },
          "notice": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "specificationInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "revisionOrDate"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "revisionOrDate": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "implementationDecision": {
      "enum": ["specification-led", "source-led", "behavioural-clean-room", "mixed"]
    },
    "licenceReviewStatus": {
      "enum": ["open", "approved", "rejected"]
    },
    "internalImplementationApprovalStatus": {
      "enum": ["open", "approved", "rejected"]
    },
    "releaseLicenceReviewStatus": {
      "enum": ["open", "approved", "rejected"]
    },
    "approvalBasis": { "type": "string" },
    "notes": { "type": "string" },
    "reviewer": { "type": "string" },
    "reviewedAtUtc": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
