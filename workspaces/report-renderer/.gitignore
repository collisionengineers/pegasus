# ---- .NET build output ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/
TestResults/

# ---- Generated outputs / render artifacts ----
artifacts/
**/output/
*.pdf.tmp

# ---- Packaged bundles (build-mcpb.ps1 output) ----
dist/
*.mcpb

# ---- Playwright browser binaries (downloaded on demand) ----
.playwright/
ms-playwright/
**/.local-browsers/

# ---- OS / editor / tooling noise ----
.DS_Store
Thumbs.db
*.swp
.claude/

# ---- Python prior-art caches (reference only) ----
__pycache__/
*.pyc

# ============================================================
# Reference material — NOT part of the build, kept local only.
#
# documentexamples/ and stylexamples/ contain real customer reports
# (vehicle plates, claim details = PII) and must never be committed.
#
# collision-engineers-design-dev/ and report-renderer/ are prior-art/design
# references only. The product source and required brand assets already live
# under src/.
# See docs/adr/0009-reference-material-handling.md
# ============================================================
documentexamples/
stylexamples/
collision-engineers-design-dev/
report-renderer/
