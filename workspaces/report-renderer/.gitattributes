# Normalise line endings; keep binaries intact.
* text=auto eol=lf

*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.scriban   text eol=lf
*.md        text eol=lf
*.xaml      text eol=lf

# Windows-only scripts stay CRLF
*.ps1       text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.otf   binary
*.ttf   binary
*.ico   binary
