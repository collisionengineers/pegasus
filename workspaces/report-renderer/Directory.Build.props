<Project>
  <!--
    Common build settings for every project in the Collision Renderer solution.
    Every project targets net10.0; the per-project TargetFramework still lives in
    each .csproj. Keep this file framework-agnostic.

    This workspace is an independently buildable source import, so MSBuild stops
    here and the projects inherit nothing from the repository-root
    Directory.Build.props. Anything the root sets and this workspace wants must be
    repeated here deliberately.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Reproducible compiler output: a prerequisite for a deterministic renderer,
         not a stylistic alignment. Matches the repository root and the
         document-extraction workspace. -->
    <Deterministic>true</Deterministic>
    <!--
      CS1591: XML doc comments not required.

      No package-advisory codes are suppressed. The NU1901-NU1904 suppression that
      ADR-0010 accepted for Scriban 5.12.1 was resolved by upgrading to Scriban
      7.2.6, which carries no advisories; see docs/adr/0013. Restore must be free
      to report the next real advisory, so do not re-add NU19xx here.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Product metadata -->
    <Version>0.2.6</Version>
    <Company>Collision Engineers Ltd</Company>
    <Product>Collision Renderer</Product>
    <Authors>Collision Engineers</Authors>
    <Copyright>Copyright © Collision Engineers Ltd</Copyright>
    <RepositoryUrl>https://github.com/collision-engineers/collisionrenderer</RepositoryUrl>
  </PropertyGroup>
</Project>
