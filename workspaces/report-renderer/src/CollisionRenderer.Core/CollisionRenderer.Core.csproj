<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CollisionRenderer.Core</RootNamespace>
    <AssemblyName>CollisionRenderer.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="Scriban" Version="7.2.6" />
    <!-- 1.61.0: 1.49.x hangs launching the headless shell on Windows (playwright#34306). -->
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
  </ItemGroup>

  <!-- The top-level design system owns templates, stylesheet, logo and signatures.
       Link and embed them so Core remains self-contained at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\design\assets\report-renderer\templates\**\*">
      <Link>Assets\templates\%(Filename)%(Extension)</Link>
      <LogicalName>CollisionRenderer.Core.Assets.templates.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\..\design\brand\logos\logo_no_margin.png">
      <Link>Assets\brand\logo.png</Link>
      <LogicalName>CollisionRenderer.Core.Assets.brand.logo.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\..\design\brand\signatures\**\*">
      <Link>Assets\brand\signatures\%(Filename)%(Extension)</Link>
      <LogicalName>CollisionRenderer.Core.Assets.brand.signatures.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
