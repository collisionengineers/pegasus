<?xml version="1.0" encoding="utf-8" ?>
<!--
    Collision Engineers brand styling.

    Palette: documents-red #C80A32 (primary accent), warm charcoal #2C2A27 (text/ink),
    white grounds, hairline borders #E6E4E1, sharp 2px corners. Calm, factual,
    engineering-precise. No gradients-as-decoration, no glow, no AI theming.

    The app runs Light-only (white grounds are core to the brand), but theme
    dictionaries are provided so brushes resolve correctly and a HighContrast
    dictionary keeps the accessibility path intact.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ===================================== LIGHT ===================================== -->
        <ResourceDictionary x:Key="Light">
            <!-- Brand colors -->
            <Color x:Key="BrandRedColor">#C80A32</Color>
            <Color x:Key="BrandRedHoverColor">#A8082A</Color>
            <Color x:Key="BrandRedPressedColor">#8C0623</Color>
            <Color x:Key="BrandCharcoalColor">#2C2A27</Color>
            <Color x:Key="BrandHairlineColor">#E6E4E1</Color>
            <Color x:Key="BrandGroundColor">#FFFFFF</Color>
            <Color x:Key="BrandGroundSubtleColor">#F7F6F4</Color>
            <Color x:Key="BrandMutedColor">#6E6A64</Color>

            <!-- Brand brushes -->
            <SolidColorBrush x:Key="BrandRedBrush" Color="{StaticResource BrandRedColor}" />
            <SolidColorBrush x:Key="BrandRedHoverBrush" Color="{StaticResource BrandRedHoverColor}" />
            <SolidColorBrush x:Key="BrandRedPressedBrush" Color="{StaticResource BrandRedPressedColor}" />
            <SolidColorBrush x:Key="BrandCharcoalBrush" Color="{StaticResource BrandCharcoalColor}" />
            <SolidColorBrush x:Key="BrandHairlineBrush" Color="{StaticResource BrandHairlineColor}" />
            <SolidColorBrush x:Key="BrandGroundBrush" Color="{StaticResource BrandGroundColor}" />
            <SolidColorBrush x:Key="BrandGroundSubtleBrush" Color="{StaticResource BrandGroundSubtleColor}" />
            <SolidColorBrush x:Key="BrandMutedBrush" Color="{StaticResource BrandMutedColor}" />

            <!-- Redirect the accent so framework controls (SelectorBar, ComboBox,
                 selection states, focus) inherit documents-red instead of the OS accent. -->
            <Color x:Key="SystemAccentColor">#C80A32</Color>
            <Color x:Key="SystemAccentColorLight1">#A8082A</Color>
            <Color x:Key="SystemAccentColorLight2">#C80A32</Color>
            <Color x:Key="SystemAccentColorLight3">#E84D6E</Color>
            <Color x:Key="SystemAccentColorDark1">#A8082A</Color>
            <Color x:Key="SystemAccentColorDark2">#8C0623</Color>
            <Color x:Key="SystemAccentColorDark3">#700019</Color>
            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource BrandRedColor}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource BrandRedColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource BrandRedHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource BrandRedPressedColor}" />
        </ResourceDictionary>

        <!-- ===================================== DARK ===================================== -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BrandRedColor">#E84D6E</Color>
            <Color x:Key="BrandRedHoverColor">#F06B86</Color>
            <Color x:Key="BrandRedPressedColor">#C83A57</Color>
            <Color x:Key="BrandCharcoalColor">#F2F1EF</Color>
            <Color x:Key="BrandHairlineColor">#3A3835</Color>
            <Color x:Key="BrandGroundColor">#1E1C1A</Color>
            <Color x:Key="BrandGroundSubtleColor">#262320</Color>
            <Color x:Key="BrandMutedColor">#A8A39C</Color>

            <SolidColorBrush x:Key="BrandRedBrush" Color="{StaticResource BrandRedColor}" />
            <SolidColorBrush x:Key="BrandRedHoverBrush" Color="{StaticResource BrandRedHoverColor}" />
            <SolidColorBrush x:Key="BrandRedPressedBrush" Color="{StaticResource BrandRedPressedColor}" />
            <SolidColorBrush x:Key="BrandCharcoalBrush" Color="{StaticResource BrandCharcoalColor}" />
            <SolidColorBrush x:Key="BrandHairlineBrush" Color="{StaticResource BrandHairlineColor}" />
            <SolidColorBrush x:Key="BrandGroundBrush" Color="{StaticResource BrandGroundColor}" />
            <SolidColorBrush x:Key="BrandGroundSubtleBrush" Color="{StaticResource BrandGroundSubtleColor}" />
            <SolidColorBrush x:Key="BrandMutedBrush" Color="{StaticResource BrandMutedColor}" />

            <Color x:Key="SystemAccentColor">#E84D6E</Color>
            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource BrandRedColor}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource BrandRedColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource BrandRedHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource BrandRedPressedColor}" />
        </ResourceDictionary>

        <!-- ================================ HIGH CONTRAST ================================ -->
        <ResourceDictionary x:Key="HighContrast">
            <!-- Only the 8 permitted system color brushes in HC. -->
            <SolidColorBrush x:Key="BrandRedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandRedHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandRedPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandCharcoalBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BrandHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BrandGroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BrandGroundSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BrandMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ============================ Shared non-themed resources ============================ -->

    <!-- Sharp 2px corners across the app (brand requirement). -->
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="BrandCorner">2</CornerRadius>
    <Thickness x:Key="BrandHairlineThickness">1</Thickness>

    <!-- Monospace family for the JSON editor. -->
    <x:String x:Key="BrandMonoFontFamily">Cascadia Mono, Consolas, Courier New</x:String>

    <!-- ================================= Control styles ================================= -->

    <!-- Primary call-to-action: documents-red, sharp, flat. -->
    <Style x:Key="BrandPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource BrandRedBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource BrandRedHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource BrandRedPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorDisabledBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary / neutral button: white ground, hairline border. -->
    <Style x:Key="BrandSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource BrandGroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BrandCharcoalBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BrandHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- Section heading inside the rail / panels. -->
    <Style x:Key="BrandSectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BrandMutedBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

</ResourceDictionary>
