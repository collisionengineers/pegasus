<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CollisionRenderer.Gui.Pages.TemplateGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CollisionRenderer.Gui.Models"
    xmlns:services="using:CollisionRenderer.Gui.Services"
    xmlns:vm="using:CollisionRenderer.Gui.ViewModels"
    Background="{ThemeResource BrandGroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedTemplates" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid Padding="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="6">
                <Image
                    Source="ms-appx:///Assets/brand/logo.png"
                    Height="40"
                    HorizontalAlignment="Left"
                    Stretch="Uniform"
                    AutomationProperties.Name="Collision Engineers logo" />
                <TextBlock
                    Text="Choose a document"
                    Foreground="{ThemeResource BrandCharcoalBrush}"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Pick a template to start a new branded document, or reopen a recent one."
                    Foreground="{ThemeResource BrandMutedBrush}"
                    Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="1"
                Width="280"
                VerticalAlignment="Bottom"
                PlaceholderText="Search templates"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.AutomationId="TemplateSearch"
                AutomationProperties.Name="Search templates" />
        </Grid>

        <!-- Recent documents -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,16"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasRecents, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="RECENT" Style="{StaticResource BrandSectionLabelStyle}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Recents}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:RecentDocument">
                        <Button
                            Click="OnRecentClick"
                            Tag="{x:Bind}"
                            Style="{StaticResource BrandSecondaryButtonStyle}"
                            AutomationProperties.Name="{x:Bind TemplateName}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource BrandMutedBrush}" />
                                <TextBlock Text="{x:Bind TemplateName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Gallery -->
        <Grid Grid.Row="2">
            <TextBlock
                Text="No templates match your search."
                Margin="2,8,0,0"
                VerticalAlignment="Top"
                Foreground="{ThemeResource BrandMutedBrush}"
                Visibility="{x:Bind ViewModel.NoResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,16">
                <GridView
                    x:Name="TemplateGrid"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnTemplateClick"
                    AutomationProperties.AutomationId="TemplateGallery"
                    AutomationProperties.Name="Document templates">
                    <GridView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:TemplateGroup">
                                    <TextBlock
                                        Text="{x:Bind Key}"
                                        Margin="0,12,0,8"
                                        Style="{StaticResource BrandSectionLabelStyle}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </GridView.GroupStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:TemplateItem">
                            <Border
                                Width="264"
                                Height="128"
                                Margin="0,0,12,12"
                                Padding="16,14"
                                CornerRadius="2"
                                Background="{ThemeResource BrandGroundSubtleBrush}"
                                BorderBrush="{ThemeResource BrandHairlineBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Text="{x:Bind Name}"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource BrandCharcoalBrush}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{x:Bind Description}"
                                        Margin="0,4,0,0"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{ThemeResource BrandMutedBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="{x:Bind AttachmentHint}"
                                        Foreground="{ThemeResource BrandRedBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Visibility="{x:Bind HasAttachmentHint, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
