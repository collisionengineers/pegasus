<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CollisionRenderer.Gui.Pages.DesignPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource BrandGroundBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="OnRenderAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSaveDraftAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnBackAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="1.15*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- ============================= LEFT RAIL ============================= -->
        <Grid
            Grid.Column="0"
            Padding="20"
            Background="{ThemeResource BrandGroundSubtleBrush}"
            BorderBrush="{ThemeResource BrandHairlineBrush}"
            BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="12" Margin="0,4,0,0">
                <Image
                    Source="ms-appx:///Assets/brand/logo.png"
                    Height="34"
                    HorizontalAlignment="Left"
                    Stretch="Uniform"
                    AutomationProperties.Name="Collision Engineers logo" />
                <Button
                    x:Name="BackButton"
                    AutomationProperties.AutomationId="BackButton"
                    Content="&#x2190;  Change template"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource BrandSecondaryButtonStyle}"
                    Click="OnBackClick" />
            </StackPanel>

            <!-- Density + primary actions -->
            <StackPanel Grid.Row="2" Spacing="8">
                <TextBlock Text="DENSITY" Style="{StaticResource BrandSectionLabelStyle}" />
                <ComboBox
                    x:Name="DensityCombo"
                    AutomationProperties.AutomationId="DensityCombo"
                    AutomationProperties.Name="Density"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.DensityOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedDensity, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button
                    x:Name="RenderButton"
                    AutomationProperties.AutomationId="RenderButton"
                    Content="Render PDF"
                    Style="{StaticResource BrandPrimaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                    Click="OnRenderClick" />

                <Grid ColumnSpacing="8" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="SaveButton"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="SaveButton"
                        Content="Save as…"
                        Style="{StaticResource BrandSecondaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.HasRendered, Mode=OneWay}"
                        Click="OnSaveClick" />
                    <Button
                        x:Name="OpenPdfButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="OpenPdfButton"
                        Content="Open PDF"
                        Style="{StaticResource BrandSecondaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.HasRendered, Mode=OneWay}"
                        Click="OnOpenPdfClick" />
                </Grid>

                <Border
                    Margin="0,12,0,0"
                    Padding="0,12,0,0"
                    BorderBrush="{ThemeResource BrandHairlineBrush}"
                    BorderThickness="0,1,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="StatusLine"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource BrandMutedBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel
                            x:Name="ResultBadges"
                            Orientation="Horizontal"
                            Spacing="14"
                            Visibility="Collapsed">
                            <TextBlock x:Name="PagesBadge" Foreground="{ThemeResource BrandCharcoalBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="DensityBadge" Foreground="{ThemeResource BrandCharcoalBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ============================= EDITOR ============================= -->
        <Grid Grid.Column="1" Padding="24,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="DocumentTitle"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.SelectedTemplate.Name, Mode=OneWay}"
                    Foreground="{ThemeResource BrandCharcoalBrush}"
                    Style="{StaticResource TitleTextBlockStyle}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        x:Name="NewStarterButton"
                        AutomationProperties.AutomationId="NewStarterButton"
                        Content="Reset to template"
                        Style="{StaticResource BrandSecondaryButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                        Click="OnNewStarterClick" />
                    <Button
                        x:Name="MoreActionsButton"
                        AutomationProperties.AutomationId="MoreActionsButton"
                        Content="&#xE712;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Style="{StaticResource BrandSecondaryButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="OpenDraftItem" Text="Open draft…" Click="OnOpenFileClick" />
                                <MenuFlyoutItem x:Name="SaveDraftItem" Text="Save draft…" Click="OnSaveDraftClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="LoadBlankItem" Text="Clear to blank" Click="OnNewBlankClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="BatchItem" Text="Batch render…" Click="OnBatchRenderClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <controls:SelectorBar
                x:Name="ViewSwitcher"
                Grid.Row="1"
                Margin="0,0,0,12"
                SelectionChanged="OnViewSwitcherSelectionChanged">
                <controls:SelectorBarItem x:Name="FormTab" AutomationProperties.AutomationId="FormTab" Text="Form" IsSelected="True" />
                <controls:SelectorBarItem x:Name="JsonTab" AutomationProperties.AutomationId="JsonTab" Text="JSON" />
            </controls:SelectorBar>

            <InfoBar
                x:Name="AutosaveBar"
                Grid.Row="2"
                Margin="0,0,0,8"
                Severity="Informational"
                Title="Unsaved draft found"
                Message="An autosaved draft from a previous session is available."
                IsClosable="True"
                IsOpen="False">
                <InfoBar.ActionButton>
                    <Button Content="Restore" Click="OnRestoreAutosaveClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="ValidationBar"
                Grid.Row="3"
                Margin="0,0,0,12"
                Severity="Error"
                Title="Payload validation failed"
                IsClosable="True"
                IsOpen="False" />

            <Grid Grid.Row="4">
                <!-- FORM view -->
                <ScrollViewer
                    x:Name="FormView"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GeneratedForm" Spacing="14" />
                </ScrollViewer>

                <!-- JSON view -->
                <Grid x:Name="JsonView" Visibility="Collapsed">
                    <Border
                        Background="{ThemeResource BrandGroundBrush}"
                        BorderBrush="{ThemeResource BrandHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="2">
                        <TextBox
                            x:Name="JsonEditor"
                            AutomationProperties.AutomationId="JsonEditor"
                            AutomationProperties.Name="JSON payload editor"
                            Text="{x:Bind ViewModel.PayloadJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="The document payload as JSON."
                            FontFamily="{StaticResource BrandMonoFontFamily}"
                            FontSize="13"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            IsSpellCheckEnabled="False"
                            BorderThickness="0"
                            Background="Transparent"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            ScrollViewer.VerticalScrollMode="Enabled" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================= PREVIEW ============================= -->
        <Grid Grid.Column="2" Padding="20,16,24,16" Background="{ThemeResource BrandGroundSubtleBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="PREVIEW"
                    VerticalAlignment="Center"
                    Style="{StaticResource BrandSectionLabelStyle}" />
                <controls:SelectorBar
                    x:Name="PreviewModeSwitcher"
                    Grid.Column="1"
                    SelectionChanged="OnPreviewModeChanged">
                    <controls:SelectorBarItem x:Name="LiveTab" AutomationProperties.AutomationId="LiveTab" Text="Live" IsSelected="True" />
                    <controls:SelectorBarItem x:Name="PdfTab" AutomationProperties.AutomationId="PdfTab" Text="PDF" />
                </controls:SelectorBar>
            </Grid>

            <Border
                Grid.Row="1"
                Background="{ThemeResource BrandGroundBrush}"
                BorderBrush="{ThemeResource BrandHairlineBrush}"
                BorderThickness="1"
                CornerRadius="2">
                <Grid>
                    <WebView2
                        x:Name="HtmlPreview"
                        AutomationProperties.AutomationId="HtmlPreview"
                        AutomationProperties.Name="Live document preview" />

                    <Grid x:Name="PdfPreviewHost" Visibility="Collapsed">
                        <StackPanel
                            x:Name="PreviewPlaceholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            MaxWidth="320">
                            <FontIcon Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource BrandMutedBrush}" />
                            <TextBlock
                                Text="No rendered PDF yet"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource BrandCharcoalBrush}"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="Click Render PDF to produce the final paginated document."
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource BrandMutedBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <WebView2
                            x:Name="PdfPreview"
                            AutomationProperties.AutomationId="PdfPreview"
                            AutomationProperties.Name="Rendered PDF preview"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Busy overlay -->
        <Grid
            x:Name="BusyOverlay"
            Grid.ColumnSpan="3"
            Background="#B3FFFFFF"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Width="40"
                    Height="40"
                    Foreground="{ThemeResource BrandRedBrush}" />
                <TextBlock
                    Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}"
                    Foreground="{ThemeResource BrandCharcoalBrush}"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
