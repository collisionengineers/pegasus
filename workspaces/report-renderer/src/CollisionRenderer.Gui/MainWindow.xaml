<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CollisionRenderer.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CollisionRenderer.Gui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Collision Renderer"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource BrandGroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Collision Renderer"
            Subtitle="Document rendering">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/brand/mark-32.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
