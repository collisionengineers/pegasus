{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collisionengineers.local/schemas/total-loss-assessment/assessment-payload.schema.json",
  "title": "Total-loss assessment operations payload",
  "description": "Payload shape consumed by scripts/audatex_gen_v4.py. Business policy validation remains in validate_assessment_payload.py.",
  "type": "object",
  "required": [
    "assessment_number",
    "version",
    "printed",
    "calc_date",
    "price_valid",
    "claim_ref",
    "inspection_date",
    "rates",
    "vehicle",
    "operations"
  ],
  "properties": {
    "assessment_number": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "printed": { "type": "string", "minLength": 1 },
    "calc_date": { "type": "string", "minLength": 1 },
    "price_valid": { "type": "string", "minLength": 1 },
    "claim_ref": { "type": "string" },
    "inspection_date": { "type": "string", "minLength": 1 },
    "coat_type": { "type": "string", "default": "BASECOAT CLEAR" },
    "notes": { "type": "string" },
    "rates": {
      "type": "object",
      "required": [
        "labour_rate",
        "paint_rate",
        "sundry_parts_pct",
        "sundry_paint",
        "pre_sundry"
      ],
      "properties": {
        "labour_rate": { "type": "number", "minimum": 0 },
        "paint_rate": { "type": "number", "minimum": 0 },
        "sundry_parts_pct": { "type": "number", "minimum": 0 },
        "sundry_paint": { "type": "number", "minimum": 0 },
        "pre_sundry": { "type": "number", "minimum": 0 },
        "paint_material_base": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "vehicle": {
      "type": "object",
      "required": [
        "manufacturer",
        "model",
        "model_sheet",
        "engine",
        "reg",
        "vin",
        "reg_month",
        "reg_year",
        "colour",
        "paint_code",
        "build_date",
        "fuel",
        "specs"
      ],
      "properties": {
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "model_sheet": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "reg": { "type": "string", "minLength": 1 },
        "vin": { "type": "string", "minLength": 1 },
        "reg_month": { "type": "string", "minLength": 1 },
        "reg_year": { "type": "string", "minLength": 1 },
        "odometer": { "type": "string" },
        "colour": { "type": "string", "minLength": 1 },
        "paint_code": { "type": "string", "minLength": 1 },
        "build_date": { "type": "string", "minLength": 1 },
        "selection": { "type": "string", "default": "AudaVIN+" },
        "fuel": { "type": "string", "minLength": 1 },
        "imported": { "type": "string", "default": "No" },
        "specs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "new_part",
            "repair",
            "rnr",
            "check_labour",
            "paint_new",
            "paint_repair",
            "paint_blend",
            "paint_prep",
            "specialist_fixed",
            "specialist_wu"
          ]
        },
        "desc": { "type": "string" },
        "guide": { "type": "string" },
        "wu": { "type": "number", "exclusiveMinimum": 0 },
        "price": { "type": "number", "minimum": 0 },
        "part_num": { "type": "string" },
        "unpriced": { "type": "boolean" },
        "bet": { "type": "string" },
        "continuations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "text": { "type": "string" },
        "justification": {
          "type": "string",
          "description": "One-line justification rendered in the pack and CE-branded report; ignored by audatex_gen_v4.py and never rendered in the Audatex/EVA PDF."
        },
        "evidence_label": {
          "type": "string",
          "enum": ["official/live source", "maintained reference", "case evidence", "inference"]
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "estimated", "provisional"],
          "description": "Pack-table status flag (C/E/P)."
        }
      },
      "additionalProperties": true
    }
  }
}
