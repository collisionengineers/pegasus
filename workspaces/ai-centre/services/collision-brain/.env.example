NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://rag:rag@localhost:5432/rag
REPOSITORY_DRIVER=postgres
OBJECT_STORE_DRIVER=filesystem
OBJECT_STORE_PATH=.data/objects
# S3-compatible storage (MinIO, R2, Backblaze, AWS, or another implementation)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
EMBEDDING_DRIVER=local-hash
EMBEDDING_DIMENSIONS=384
AUTH_MODE=none
# Required when AUTH_MODE=shared-secret
MCP_SHARED_SECRET=
# Required when AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Required in production; a development-only fallback is used locally.
UPLOAD_TOKEN_SECRET=
UPLOAD_TTL_SECONDS=900
MAX_UPLOAD_BYTES=26214400
WORKER_POLL_MS=1000
RAG_HTTP_URL=http://localhost:3000/mcp
RAG_HTTP_BEARER_TOKEN=
