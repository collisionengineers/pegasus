{
  "name": "@collisionengineers/rag-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-agnostic RAG ingestion and retrieval service exposed through MCP.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:stdio": "node dist/stdio.js",
    "db:migrate": "tsx src/admin/migrate.ts",
    "data:export": "tsx src/admin/export-data.ts",
    "data:import": "tsx src/admin/import-data.ts",
    "benchmark": "tsx src/admin/benchmark.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pgvector": "^0.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
